###############################################################################
# JMRP.IO - MAIN GITIGNORE
# Grouped and documented ignores for build, development, and CI environments.
###############################################################################

# --- 1. CORE & BUILD ---
# Main Astro build output. No trailing slash: `dist` is now a symlink
# (scripts/deploy-swap.mjs), and a `dist/`-style pattern only matches
# real directories, not symlinks.
dist
dist_new/
# Blue/green build output dirs (scripts/deploy-swap.mjs) + its atomic-swap temp symlink
builds/
.dist.tmp-*
# Astro generated types and runtime cache
.astro/
# Optimized images cache (speeds up builds)
.cache/
# Package manager dependencies
node_modules/

# --- 2. IDE & OS SPECIFIC ---
# macOS system files
.DS_Store
# VS Code workspace-specific settings
.vscode/mcp.json
# AI/Editor Specific
.claude/settings.local.json
.claude/agent-memory/
CLAUDE.local.md
.qodo/
nanobanana-output/
# Non-project files (generated by external tools)
tools.yaml
demo-output/

# --- 3. LOGS ---
# Standard package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Project custom logs
logs/*.log
html-errors.log

# --- 4. SECURITY & ENVIRONMENT ---
# Local environment variables (NEVER COMMIT)
.env
.env.production
.env.local
.env.*.local

# --- 5. CI, REPORTS & ARTIFACTS ---
# Deployment artifacts and dashboard data
dist-reports/
# Deployment staging directories (a11y-deploy, lh-deploy, etc. created during CI)
*-deploy/
.lighthouseci/
lighthouse-results/
lighthouse-report/
.scannerwork/
.lycheecache

# Generated CI workflow data
workflow-graph.png
workflow-data.json

# Static Analysis & Validation reports (JSON/HTML)
html-validation.json
html-report.html
accessibility-summary.json
accessibility-summary-*.json
bundle-analysis.json
schema-report.json
schema-report.html
rss-validation.json
image-report.html
jsdoc-coverage/
.jsdoc-coverage

# --- 6. TESTING ---
# Playwright test results and reports
test-results/
playwright-report/
.playwright-mcp/
accessibility-report/
test-report.html
test-report.json
test_output.txt
test.html
validation_*.txt

# --- 7. LATEX ARTIFACTS (CV Generation) ---
# Global LaTeX temporary files
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.bbl
*.bcf
*.blg
*.run.xml
*.toc
*.xdv

# Project-specific LaTeX paths
cv_latex/*.pdf
# Auto-generated ATS .tex sources (produced from the CV YAML by scripts/cv/generate-ats.mjs)
cv_latex/generated/

# --- 8. PROJECT SPECIFIC & MISC ---
# Agentic workflows and local knowledge
.agent/
PROJECT_KNOWLEDGE.md
# Implementation plans and audit docs (local only)
plan/
AI_CONFIG_TASKS.md
AI_CONTEXT_ROADMAP.md
SEO_AUDIT.md
docs/I18N_PLAN.md
# Vendored scripts (downloaded during build)
public/scripts/cf-beacon.js
temp_lh/
temp_workflow/
# Backup files
*.backup
accessibility-report.json

# Local design-audit screenshots (not for the repo)
design-audit/
