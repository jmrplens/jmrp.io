###############################################################################
# JMRP.IO - MAIN GITIGNORE
# Grouped and documented ignores for build, development, and CI environments.
###############################################################################

# --- 1. CORE & BUILD ---
# Main Astro build output. No trailing slash: `dist` is now a symlink
# (scripts/deploy-swap.mjs), and a `dist/`-style pattern only matches
# real directories, not symlinks.
dist
dist_new/
# Blue/green build output dirs (scripts/deploy-swap.mjs) + its atomic-swap temp symlink
builds/
.dist.tmp-*
# Staging area for the six generated nginx snippets (security_headers.conf,
# security_headers_assets.conf and maps/*.conf). The post-build integrations
# write them here — outside dist/, so `fixPermissions` never hands them to
# www-data, and on the same filesystem as /etc/nginx, so deploy-live.mjs can
# rename(2) them into /etc/nginx/snippets/jmrp/ as a true atomic move after
# the blue/green swap. Nothing generated is meant to survive in the worktree.
# No trailing slash, for the same reason as `dist` above: a `dir/` pattern
# matches only a real directory, so a staging path pointed elsewhere with a
# symlink would fall out of the ignore and become committable.
# The four http-level maps that USED to be generated straight into nginx/.
# Named one by one on purpose: a `nginx/` or `nginx/*.conf` pattern would also
# swallow nginx/handmade_redirects.conf — hand-written, tracked, and the only
# thing the live vhost still includes from this directory (jmrp.io.conf:267).
# The leading slash anchors each name to the repo root.
/nginx/blog_redirects.conf
/nginx/docs_redirects.conf
/nginx/tag_redirects.conf
/nginx/md_twin_alternates.conf
# Astro generated types and runtime cache
.astro/
# Optimized images cache (speeds up builds)
.cache/
# Live download counters, refreshed at pre-build from the GitHub and Docker Hub
# APIs. Pure derived data — the hand-read MATLAB counts that cannot be fetched
# live in `scripts/download-sources.mjs`, not here — so tracking it only bought
# a fallback for a failed fetch, at the cost of dirtying the tree on EVERY
# build and riding along in 24 unrelated commits. The build host keeps its own
# last-known-good copy on disk between builds; a fresh clone whose fetch fails
# gets a zeroed file from the integration, and both pages already render a dash
# rather than a figure when the total is 0.
src/data/downloads.json
# Package manager dependencies
node_modules/

# --- 2. IDE & OS SPECIFIC ---
# macOS system files
.DS_Store
# VS Code workspace-specific settings
.vscode/mcp.json
# AI/Editor Specific
.claude/settings.local.json
.claude/agent-memory/
CLAUDE.local.md
.qodo/
nanobanana-output/
# Non-project files (generated by external tools)
tools.yaml
demo-output/

# --- 3. LOGS ---
# Standard package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Project custom logs. The glob must cover ROTATED files too: `logs/*.log`
# missed `csp-violations.log.1`, which reached a public commit carrying 543
# visitor IP addresses from the CSP violation receiver.
logs/
# Trailing `*` for the same reason: rotation appends a suffix.
html-errors.log*

# --- 4. SECURITY & ENVIRONMENT ---
# Local environment variables (NEVER COMMIT)
.env
.env.production
.env.local
.env.*.local

# --- 5. CI, REPORTS & ARTIFACTS ---
# Deployment artifacts and dashboard data
dist-reports/
# Deployment staging directories (a11y-deploy, lh-deploy, etc. created during CI)
*-deploy/
.lighthouseci/
lighthouse-results/
lighthouse-report/
.scannerwork/
.lycheecache

# Generated CI workflow data
workflow-graph.png
workflow-data.json

# Static Analysis & Validation reports (JSON/HTML)
html-validation.json
html-report.html
accessibility-summary.json
accessibility-summary-*.json
bundle-analysis.json
schema-report.json
schema-report.html
rss-validation.json
image-report.html
jsdoc-coverage/
.jsdoc-coverage

# --- 6. TESTING ---
# Playwright test results and reports
test-results/
playwright-report/
.playwright-mcp/
accessibility-report/
test-report.html
test-report.json
test_output.txt
test.html
validation_*.txt

# --- 7. LATEX ARTIFACTS (CV Generation) ---
# Global LaTeX temporary files
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.bbl
*.bcf
*.blg
*.run.xml
*.toc
*.xdv

# Project-specific LaTeX paths
cv_latex/*.pdf
# Auto-generated ATS .tex sources (produced from the CV YAML by scripts/cv/generate-ats.mjs)
cv_latex/generated/
# Private CV build: the same six PDFs plus the phone number from CV_PHONE in
# .env. Never publish these - public/pdf/ is served by nginx and linked from
# the site; this directory is the hand-upload copy for job portals.
/cv_private/

# --- 8. PROJECT SPECIFIC & MISC ---
