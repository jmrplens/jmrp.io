# ============================================================================
# Environment Configuration Template
# ============================================================================
# Copy this file to `.env` and fill in the values for your environment.
#
# Instructions:
# 1. Copy: cp .env.example .env
# 2. Edit: Fill in the values below
# 3. Never commit .env to version control!
#
# Optional variables are commented with placeholder values.
# Required variables for specific features should be uncommented and filled.
# ============================================================================

# General Site Configuration
# --------------------------
# The canonical URL of the site (used for sitemap, canonical links, etc.)
PUBLIC_SITE_URL=https://example.com

# Cloudflare Analytics (Frontend)
# -------------------------------
# Get from: Cloudflare Dashboard > Analytics > Web Analytics > Add site
PUBLIC_CF_BEACON_TOKEN=

# Cloudflare Cache Purge (Build-time)
# -----------------------------------
# Get from: Cloudflare Dashboard > My Profile > API Tokens > Create Token
# Required permissions: Zone.Cache Purge
PRIVATE_CF_API_TOKEN=
# Get from: Cloudflare Dashboard > Your Site > Overview (Zone ID in right sidebar)
PRIVATE_CF_ZONE_ID=

# Nginx Integration (Post-Build)
# ------------------------------
# Absolute path to where security_headers.conf should be deployed
# Production: /etc/nginx/snippets/security_headers.conf (requires sudo)
# Local/Dev: Use a relative path or set to empty to skip deployment
POSTBUILD_NGINX_SNIPPETS_PATH=

# Optional: Custom Nginx configuration path for verification (-t -c ...)
# POSTBUILD_NGINX_CONFIG_PATH=/etc/nginx/nginx.conf

# Optional: Custom Nginx cache path to clear after reload
# POSTBUILD_NGINX_CACHE_PATH=/var/cache/nginx

# Environment-specific timeouts (ms)
# POSTBUILD_NGINX_TEST_TIMEOUT=10000
# POSTBUILD_NGINX_RELOAD_TIMEOUT=30000

# Security Violation Reporter (Telegram)
# -------------------------------------
# Create a bot via @BotFather on Telegram, then add it to a group/channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Custom port for CSP reporter service
# CSP_REPORTER_PORT=58291

# CI/CD External Tools
# --------------------
# Get from: https://app.snyk.io/account
SNYK_TOKEN=
# Get from: https://sonarcloud.io/account/security
SONAR_PROJECT_KEY=
SONAR_TOKEN=
