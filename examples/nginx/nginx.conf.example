# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    server_name example.com;

    # TIP: For automated post-build validation, set this environment variable:
    # POSTBUILD_NGINX_CONFIG_PATH=/etc/nginx/nginx.conf

    # Listen on standard HTTPS ports + QUIC/HTTP3
    listen 443 ssl;
    listen [::]:443 ssl;
    listen 443 quic;
    listen [::]:443 quic;

    # Root directory
    root /var/www/example.com/dist;
    index index.html;

    # SSL Settings (e.g., Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Alt-Svc 'h3=":443"' always;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # CSP Nonce Generation
    # Uses the unique request ID as a nonce for this request
    set $cspNonce $request_id;
    sub_filter_once off;
    sub_filter_types *;
    sub_filter NGINX_CSP_NONCE $cspNonce;

    # Routes & Caching
    
    # XML/RSS feeds
    location ~* \.(xml)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=300, must-revalidate";
        add_header Content-Type "text/xml; charset=utf-8";
        # Include security headers in each location to ensure they aren't overridden
        include /etc/nginx/snippets/security_headers.conf;
    }

    # Static assets (Astro generated)
    location /_astro/ {
        alias /var/www/example.com/dist/_astro/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        # security_headers.conf is automatically generated and deployed by 'pnpm run build'
        # when POSTBUILD_NGINX_SNIPPETS_PATH is set.
        include /etc/nginx/snippets/security_headers.conf;
    }

    # Public assets
    location /assets/ {
        alias /var/www/example.com/dist/assets/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        include /etc/nginx/snippets/security_headers.conf;
    }

    # Security: Well-known location for security.txt, etc.
    location ^~ /.well-known/ {
        try_files $uri $uri/ =404;
        include /etc/nginx/snippets/security_headers.conf;
    }

    # Main application
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "public, max-age=3600, must-revalidate";
        include /etc/nginx/snippets/security_headers.conf;
    }

    # API Proxy for Services (Examples)
    # Allows the frontend to fetch stats without exposing external domains/CORS
    
    # Mastodon (Proxies to external server)
    location = /api/proxy/mastodon/peers { 
        proxy_pass https://mstdn.example.com/api/v1/instance/peers; 
        proxy_ssl_server_name on; 
        include /etc/nginx/snippets/security_headers.conf;
    }

    # PotatoMesh (Optimized Local Proxy)
    # Bypasses Cloudflare WAF by hitting localhost port directly and enforcing pagination
    location = /api/proxy/potato/nodes { 
        proxy_pass http://127.0.0.1:41447/api/nodes?limit=1000;
        proxy_set_header Host $host;
        include /etc/nginx/snippets/security_headers.conf;
    }

    # MeshMonitor (Protected with Token)
    location = /api/proxy/mesh/lf { 
        proxy_pass http://127.0.0.1:3001/meshmonitor/api/v1/network;
        proxy_set_header Authorization "Bearer YOUR_TOKEN_HERE";
        proxy_set_header Host $host;
        include /etc/nginx/snippets/security_headers.conf;
    }

    # WebMCP Analyzer Proxy (Fetches external URLs for client-side analysis)
    # Uses relaxed security headers to allow reading response data in JS
    location /api/proxy/fetch {
        proxy_pass http://127.0.0.1:58292/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Relaxed headers: no COEP/CORP to allow reading proxy responses
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # CSP Violation Reporting Endpoint
    location /csp-report {
        access_log off;
        proxy_pass http://127.0.0.1:58291/; # Proxy to your reporting script
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Block access to hidden files and sensitive extensions
    location ~ /\. { deny all; access_log off; log_not_found off; }
    location ~ \.(htaccess|htpasswd|ini|log|sh|sql)$ { deny all; }
}