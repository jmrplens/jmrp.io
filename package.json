{
  "name": "jmrp.io",
  "type": "module",
  "version": "1.0.0",
  "description": "Personal portfolio and technical blog of José Manuel Requena Plens - R&D Engineer",
  "author": "José Manuel Requena Plens <jmrplens@gmail.com> (https://jmrp.io)",
  "license": "MIT",
  "homepage": "https://jmrp.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmrplens/jmrp.io.git"
  },
  "bugs": {
    "url": "https://github.com/jmrplens/jmrp.io/issues"
  },
  "keywords": [
    "astro",
    "portfolio",
    "blog",
    "cv",
    "engineer",
    "embedded-systems",
    "acoustics",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "@astrojs/internal-helpers": "^0.7.5",
      "axios": ">=1.13.2",
      "form-data": ">=4.0.0",
      "qs": ">=6.14.1",
      "tough-cookie": ">=6.0.0",
      "tmp": ">=0.2.5",
      "glob": ">=13.0.0",
      "rimraf": ">=6.1.2",
      "request>uuid": "^3.4.0",
      "uuid": ">=9.0.0",
      "boolean": ">=3.2.0",
      "fstream": ">=1.0.12",
      "har-validator": ">=5.1.5",
      "mathjax-full": ">=3.2.2",
      "request": ">=2.88.2",
      "whatwg-encoding": ">=3.1.1",
      "vite": ">=7.3.1"
    }
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "astro dev",
    "build": "export DIST_DIR=dist_new && rm -rf $DIST_DIR && astro build --outDir $DIST_DIR && rm -rf dist_old && (mv dist dist_old || true) && mv $DIST_DIR dist && rm -rf dist_old && pnpm exec prettier --check .",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.{astro,css}\"",
    "lint:html": "html-validate -c .htmlvalidate.json dist",
    "typecheck": "astro check",
    "typecheck:tsc": "tsc --noEmit",
    "test:e2e": "playwright test",
    "verify-icons": "node scripts/verify-icons.mjs",
    "verify": "node scripts/run-verify.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "5.0.0-beta.6",
    "@astrojs/preact": "5.0.0-beta.3",
    "@astrojs/sitemap": "3.7.0",
    "@iconify-json/carbon": "^1.2.18",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/marketeq": "^1.2.2",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.70",
    "@iconify-json/vscode-icons": "^1.2.42",
    "@unocss/astro": "^66.6.0",
    "astro": "6.0.0-beta.10",
    "citation-js": "^0.7.22",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "preact": "^10.28.3",
    "rehype-external-links": "^3.0.0",
    "rehype-mathjax": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.0",
    "shiki": "^3.22.0",
    "unocss": "^66.6.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@axe-core/playwright": "^4.11.1",
    "@gorazdo/eslint-plugin-preact": "^1.0.7",
    "@iconify-json/devicon": "^1.2.58",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@types/he": "^1.2.3",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.2",
    "@types/sanitize-html": "^2.16.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@unocss/eslint-plugin": "^66.6.0",
    "astro-eslint-parser": "^1.2.2",
    "axe-core": "^4.11.1",
    "axe-html-reporter": "^2.2.11",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-jsdoc": "^62.5.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "^2.2.1",
    "eslint-plugin-playwright": "^2.5.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.6",
    "eslint-plugin-unicorn": "^62.0.0",
    "glob": "^13.0.1",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "he": "^1.2.0",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^10.7.0",
    "js-yaml": "^4.1.1",
    "lighthouse": "^13.0.2",
    "mermaid-isomorphic": "^3.0.4",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "puppeteer": "^24.37.2",
    "rehype-mermaid": "^3.0.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "sonar-scanner": "^3.1.0",
    "stylelint": "^17.2.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.6.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^7.0.1",
    "svgo": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "unist-util-visit": "^5.1.0",
    "vercel": "^50.14.0",
