{
  "name": "jmrp.io",
  "type": "module",
  "version": "1.0.0",
  "description": "Personal portfolio and technical blog of José Manuel Requena Plens - R&D Engineer",
  "author": "José Manuel Requena Plens <jmrplens@gmail.com> (https://jmrp.io)",
  "license": "MIT",
  "homepage": "https://jmrp.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmrplens/jmrp.io.git"
  },
  "bugs": {
    "url": "https://github.com/jmrplens/jmrp.io/issues"
  },
  "keywords": [
    "astro",
    "portfolio",
    "blog",
    "cv",
    "engineer",
    "embedded-systems",
    "acoustics",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run build:cv && DIST_DIR=$(node scripts/deploy-swap.mjs prepare) && astro build --outDir \"$DIST_DIR\" && node scripts/deploy-swap.mjs swap \"$DIST_DIR\" && node scripts/deploy-live.mjs",
    "build:cv": "node scripts/cv/build-cvs.mjs",
    "verify:ats": "node scripts/cv/verify-ats.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "astro sync && eslint .",
    "lint:css": "stylelint \"src/**/*.{astro,css}\"",
    "lint:html": "html-validate -c .htmlvalidate.json dist",
    "typecheck": "astro check",
    "typecheck:tsc": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "node --test \"scripts/**/*.test.mjs\"",
    "csp:replay": "node scripts/csp-replay.mjs",
    "identity:build": "node scripts/ci/build-identity.mjs",
    "check:software-drift": "node scripts/ci/check-software-drift.mjs",
    "verify-icons": "node scripts/verify-icons.mjs",
    "verify": "node scripts/run-verify.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/preact": "6.0.2",
    "@astrojs/sitemap": "3.7.3",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/logos": "^1.2.12",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.93",
    "@unocss/astro": "^66.7.5",
    "astro": "7.2.1",
    "citation-js": "^0.8.2",
    "mermaid": "^11.16.1",
    "preact": "^10.29.8",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "sanitize-html": "^2.17.6",
    "shiki": "^4.4.3",
    "unocss": "^66.7.5",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@cspell/dict-es-es": "^3.0.8",
    "@gorazdo/eslint-plugin-preact": "^1.0.7",
    "@iconify-json/devicon": "^1.2.62",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify-json/vscode-icons": "^1.2.71",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@pranavraut033/ats-checker": "^2.0.0",
    "@types/he": "^1.2.3",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@unocss/eslint-plugin": "^66.7.5",
    "astro-eslint-parser": "^3.0.0",
    "axe-core": "^4.13.0",
    "axe-html-reporter": "^2.2.11",
    "cheerio": "^1.2.0",
    "cspell": "^10.0.1",
    "domhandler": "^6.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "glob": "^13.0.6",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "he": "^1.2.0",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^11.6.2",
    "js-yaml": "^5.2.3",
    "lighthouse": "^13.4.1",
    "mermaid-isomorphic": "^3.1.0",
    "opentype.js": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "puppeteer": "^25.6.0",
    "rehype-mermaid": "^3.0.0",
    "rss-parser": "^3.13.0",
    "satori": "^0.29.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.3",
    "sonar-scanner": "^3.1.0",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "svgo": "^4.0.2",
    "tinify": "^1.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "unist-util-visit": "^5.1.0",
    "vercel": "^59.1.4",
    "vite-plugin-image-optimizer": "^2.0.3",
    "xml2js": "^0.6.2"
  }
}
