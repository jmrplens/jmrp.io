  "scripts": {
    "dev": "astro dev",
    "build": "export DIST_DIR=dist_new && rm -rf $DIST_DIR && astro build --outDir $DIST_DIR && rm -rf dist_old && (mv dist dist_old || true) && mv $DIST_DIR dist && rm -rf dist_old && pnpm exec prettier --check .",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.{astro,css}\"",
    "lint:html": "html-validate -c .htmlvalidate.json dist",
    "typecheck": "astro check",
    "typecheck:tsc": "tsc --noEmit",
    "test:e2e": "playwright test",
    "verify-icons": "node scripts/verify-icons.mjs",
    "verify": "node scripts/run-verify.mjs"
  },
