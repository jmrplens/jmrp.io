  "license": "MIT",
  "homepage": "https://jmrp.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmrplens/jmrp.io.git"
  },
  "bugs": {
    "url": "https://github.com/jmrplens/jmrp.io/issues"
  },
  "keywords": [
    "astro",
    "portfolio",
    "blog",
    "cv",
    "engineer",
    "embedded-systems",
    "acoustics",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run build:cv && export DIST_DIR=$(node scripts/deploy-swap.mjs prepare) && astro build --outDir $DIST_DIR && node scripts/deploy-swap.mjs swap $DIST_DIR && node scripts/deploy-live.mjs",
    "build:cv": "node scripts/cv/build-cvs.mjs",
    "verify:ats": "node scripts/cv/verify-ats.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.{astro,css}\"",
    "lint:html": "html-validate -c .htmlvalidate.json dist",
    "typecheck": "astro check",
    "typecheck:tsc": "tsc --noEmit",
    "test:e2e": "playwright test",
    "verify-icons": "node scripts/verify-icons.mjs",
    "verify": "node scripts/run-verify.mjs"
  },
  "dependencies": {
