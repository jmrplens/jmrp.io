{
  "name": "jmrp.io",
  "type": "module",
  "version": "1.0.0",
  "description": "Personal portfolio and technical blog of José Manuel Requena Plens - R&D Engineer",
  "author": "José Manuel Requena Plens <jmrplens@gmail.com> (https://jmrp.io)",
  "license": "MIT",
  "homepage": "https://jmrp.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmrplens/jmrp.io.git"
  },
  "bugs": {
    "url": "https://github.com/jmrplens/jmrp.io/issues"
  },
  "keywords": [
    "astro",
    "portfolio",
    "blog",
    "cv",
    "engineer",
    "embedded-systems",
    "acoustics",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run build:cv && DIST_DIR=$(node scripts/deploy-swap.mjs prepare) && astro build --outDir \"$DIST_DIR\" && node scripts/deploy-swap.mjs swap \"$DIST_DIR\" && node scripts/deploy-live.mjs",
    "build:cv": "node scripts/cv/build-cvs.mjs",
    "verify:ats": "node scripts/cv/verify-ats.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "astro sync && eslint .",
    "lint:css": "stylelint \"src/**/*.{astro,css}\"",
    "lint:html": "html-validate -c .htmlvalidate.json dist",
    "typecheck": "astro check",
    "typecheck:tsc": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "node --test \"scripts/**/*.test.mjs\" \"workers/**/*.test.mjs\"",
    "csp:replay": "node scripts/csp-replay.mjs",
    "identity:build": "node scripts/ci/build-identity.mjs",
    "projects:build": "node scripts/ci/build-projects.mjs",
    "check:software-drift": "node scripts/ci/check-software-drift.mjs",
    "verify-icons": "node scripts/verify-icons.mjs",
    "verify:assets": "node scripts/ci/check-public-asset-fidelity.mjs",
    "verify": "node scripts/run-verify.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/preact": "6.1.6",
    "@astrojs/sitemap": "3.7.6",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/logos": "^1.2.20",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.103",
    "@unocss/astro": "^66.13.0",
    "astro": "7.4.13",
    "citation-js": "^0.9.0",
    "mermaid": "^11.17.2",
    "preact": "^11.2.0",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "sanitize-html": "^2.18.2",
    "shiki": "^4.6.0",
    "unocss": "^66.13.0",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cspell/dict-es-es": "^3.0.9",
    "@gorazdo/eslint-plugin-preact": "^1.0.7",
    "@iconify-json/devicon": "^1.2.84",
    "@iconify-json/tabler": "^1.2.46",
    "@iconify-json/vscode-icons": "^1.2.100",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@pranavraut033/ats-checker": "^2.0.0",
    "@sonar/scan": "^5.1.0",
    "@types/he": "^1.2.3",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@unocss/eslint-plugin": "^66.13.0",
    "astro-eslint-parser": "^3.2.0",
    "axe-core": "^4.14.1",
    "axe-html-reporter": "^2.2.11",
    "cheerio": "^1.2.0",
    "cspell": "^10.5.2",
    "domhandler": "^6.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsdoc": "^65.5.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^80.0.0",
    "glob": "^14.0.6",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "he": "^2.0.0",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^11.21.1",
    "js-yaml": "^5.5.0",
    "lighthouse": "^13.6.0",
    "mermaid-isomorphic": "^3.1.0",
    "opentype.js": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "puppeteer": "^25.18.1",
    "rehype-mermaid": "^3.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "rss-parser": "^3.13.0",
    "satori": "^0.63.2",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "stylelint": "^18.1.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.10.1",
    "stylelint-config-standard": "^41.1.0",
    "stylelint-order": "^8.1.3",
    "svgo": "^4.1.0",
    "tinify": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vercel": "^66.6.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "xml2js": "^0.6.2"
  }
}
