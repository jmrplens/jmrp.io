---
/**
 * Spanish Blog Tags — wrapper page.
 * Generates `/es/blog/tags/[tag]/` routes with Spanish translations.
 */
import "@styles/blog.css";

import PostGrid from "@components/blog/PostGrid.astro";
import TagCloud from "@components/blog/TagCloud.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getUniqueTags } from "@utils/blog";
import { getSiteUrl } from "@utils/site";
import { getCollection } from "astro:content";

import { defaultLocale, type Locale } from "@i18n/config";
import { pluralize, useTranslatedPath, useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).filter(
    (post) => !post.data.draft,
  );
  const tags = getUniqueTags(posts);

  return tags.map(({ tag }) => {
    const filteredPosts = posts
      .filter((post) =>
        post.data.tags?.some((t) => t.toLowerCase() === tag.toLowerCase()),
      )
      .sort(
        (a, b) =>
          b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
      );

    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const postWord = pluralize(
  posts.length,
  {
    one: t("pages.blogTags.postSingular"),
    other: t("pages.blogTags.postPlural"),
  },
  locale,
);
const articleWord = pluralize(
  posts.length,
  {
    one: t("pages.blogTags.articleSingular"),
    other: t("pages.blogTags.articlePlural"),
  },
  locale,
);

const schema = {
  "@type": "CollectionPage",
  "@id": new URL(
    "#collection",
    new URL(Astro.url.pathname, getSiteUrl()),
  ).toString(),
  name: t("pages.blogTags.schemaName", { tag: tag! }),
  description: t("pages.blogTags.schemaDescription", {
    count: posts.length,
    tag: tag!,
  }),
  url: new URL(Astro.url.pathname, getSiteUrl()).toString(),
  mainEntity: {
    "@type": "ItemList",
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/blog/${post.data.slug}/`, getSiteUrl()).toString(),
      name: post.data.title,
    })),
  },
};
---

<BaseLayout
  title={`${t("pages.blogTags.titlePrefix")}${tag}`}
  description={t("pages.blogTags.metaDescription", {
    count: posts.length,
    articleWord,
    tag: tag!,
  })}
  schema={schema}
>
  <div class="content-wrapper">
    <header class="page-header">
      <h1 class="text-primary">#{tag}</h1>
      <p class="subtitle">
        {posts.length}
        {postWord}
        {t("pages.blogTags.aboutTopic")}
      </p>
      <div class="back-link">
        <a href={translatePath("/blog/")}
          >{t("pages.blogTags.backToAllPosts")}</a
        >
      </div>
    </header>

    <div class="blog-layout">
      <div class="posts-container">
        <PostGrid posts={posts} />
      </div>
      <aside>
        <TagCloud />
      </aside>
    </div>
  </div>
</BaseLayout>
