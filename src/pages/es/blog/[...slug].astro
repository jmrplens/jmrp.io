---
/**
 * Spanish Blog Post — wrapper page.
 * Generates `/es/blog/[slug]/` routes with Spanish translations.
 */
import "@styles/blog.css";

import TableOfContentsDrawer from "@components/layout/TableOfContentsDrawer.astro";
import Callout from "@components/ui/Callout.astro";
import Code from "@components/ui/Code.astro";
import References from "@components/ui/References.astro";
import TabPanel from "@components/ui/TabPanel.astro";
import Tabs from "@components/ui/Tabs.astro";
import YouTube from "@components/ui/YouTube.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { SiteConfig } from "@src/types";
import { getSiteUrl } from "@utils/site";
import { getImage, Image } from "astro:assets";
import {
  type CollectionEntry,
  getCollection,
  getEntry,
  render,
} from "astro:content";
import * as cheerio from "cheerio";

import { defaultLocale, type Locale } from "@i18n/config";
import { formatDate, useTranslatedPath, useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"posts">;

const post = Astro.props;
const { Content, headings } = await render(post);

// --- Reference Collection Logic ---
const bodyWithoutCode = (post.body || "")
  .replaceAll(/```[\s\S]*?```/g, "")
  .replaceAll(/`[^`]*?`/g, "");

const linkRegex = /\[([^\]]+)\]\(([^)]+(?:\([^)]+\)[^)]*)*)\)/g;
const collectedRefsFromMarkdown = [];
let match;
while ((match = linkRegex.exec(bodyWithoutCode)) !== null) {
  const url = match[2];
  if (url.startsWith("#")) continue;
  collectedRefsFromMarkdown.push({ text: match[1], url });
}

const $ = cheerio.load(bodyWithoutCode);
$('a[href^="http"], a[href^="//"]').each((_, el) => {
  const $el = $(el);
  const url = $el.attr("href");
  const text = $el.text().replaceAll(/\s+/g, " ").trim();
  if (url && text) {
    collectedRefsFromMarkdown.push({ text, url });
  }
});

const uniqueUrls = new Set<string>();
const finalReferences = collectedRefsFromMarkdown.filter((ref) => {
  if (!uniqueUrls.has(ref.url)) {
    uniqueUrls.add(ref.url);
    return true;
  }
  return false;
});

// --- Image Optimization (JSON-LD) ---
let jsonLdImage = "/default-blog-cover.webp";
const coverImageWidths = [400, 450, 540, 600, 720, 800, 1080, 1200];
const coverImageSizes =
  "(max-width: 768px) calc(100vw - 2.5rem), (max-width: 1024px) 600px, 460px";

if (post.data.coverImage) {
  const coverImage = post.data.coverImage;
  const schemaImage = await getImage({
    src: coverImage,
    format: "webp",
    width: 1200,
    height: 675,
    quality: 60,
  });
  jsonLdImage = schemaImage.src;
}

const articleSchema = [
  {
    "@type": "BlogPosting",
    "@id": new URL(
      "#article",
      new URL(`/blog/${post.id}`, getSiteUrl()),
    ).toString(),
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishedDate.toISOString(),
    dateModified: (
      post.data.updatedDate || post.data.publishedDate
    ).toISOString(),
    publisher: {
      "@type": "Person",
      "@id": new URL("#person", getSiteUrl()).toString(),
      name: siteData.author,
      url: getSiteUrl(),
    },
    author: {
      "@type": "Person",
      "@id": new URL("#person", getSiteUrl()).toString(),
      name: siteData.author,
      url: getSiteUrl(),
    },
    image: new URL(jsonLdImage, getSiteUrl()).toString(),
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": new URL(`/blog/${post.id}`, getSiteUrl()).toString(),
    },
  },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  image={post.data.coverImage?.src}
  publishDate={post.data.publishedDate}
  modifiedDate={post.data.updatedDate}
  tags={post.data.tags}
  schema={articleSchema}
>
  <article class="post-content">
    <header class="post-header">
      <div class="content-wrapper">
        <div class="header-meta">
          <a
            href={translatePath("/blog/")}
            class="back-link"
          >
            <span class="i-mdi:arrow-left h-5 w-5"></span>
            {t("pages.blogPost.backToBlog")}
          </a>
          <div class="meta">
            <span class="author">
              {post.data.author || siteData.author}
            </span>
            <span class="separator">•</span>
            <time datetime={post.data.publishedDate.toISOString()}>
              {formatDate(post.data.publishedDate, locale)}
            </time>
            <span class="separator">•</span>
            {
              post.data.tags && (
                <div class="tags">
                  {post.data.tags.map((tag) => (
                    <a
                      href={translatePath(
                        `/blog/tags/${encodeURIComponent(tag.toLowerCase())}/`,
                      )}
                      class="tag"
                      aria-label={t("aria.viewTaggedPosts", { tag })}
                    >
                      #{tag}
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        </div>

        <div class="header-grid">
          <div class="header-content">
            <h1>{post.data.title}</h1>
            <p class="lead">{post.data.description}</p>
          </div>
          {
            post.data.coverImage && (
              <div class="cover-image-container">
                <Image
                  src={post.data.coverImage}
                  alt={t("pages.blogPost.coverImageAlt", {
                    title: post.data.title,
                  })}
                  class="cover-image"
                  width={1200}
                  height={675}
                  format="webp"
                  loading="eager"
                  decoding="sync"
                  fetchpriority="high"
                  widths={coverImageWidths}
                  sizes={coverImageSizes}
                  quality={70}
                  style="width: 100%; height: auto; aspect-ratio: 16/9;"
                />
              </div>
            )
          }
        </div>
      </div>
    </header>

    <div class="layout-grid content-wrapper">
      <div class="prose">
        <Content components={{ Callout, Tabs, TabPanel, YouTube, Code }} />
        <References references={finalReferences} />
      </div>
    </div>
  </article>

  <TableOfContentsDrawer headings={headings} />
</BaseLayout>

<script>
  const observedElements = new WeakSet<Element>();
  const observerMap = new Map<Element, MutationObserver>();

  const cleanupObservers = () => {
    observerMap.forEach((observer) => observer.disconnect());
    observerMap.clear();
  };

  const setupPostInteractions = () => {
    cleanupObservers();

    const rIC: (callback: IdleRequestCallback) => number =
      window.requestIdleCallback?.bind(window) ??
      ((cb) =>
        window.setTimeout(
          () =>
            cb({ didTimeout: false, timeRemaining: () => 50 } as IdleDeadline),
          50,
        ));

    const applyLabels = () => {
      rIC(() => {
        const codeBlocks = document.querySelectorAll(
          'pre[role="region"]:not([aria-label])',
        );
        codeBlocks.forEach((block, index) => {
          const lang = block.getAttribute("data-language") || "Code";
          block.setAttribute("aria-label", `${lang} example ${index + 1}`);
        });
      });
    };

    setTimeout(applyLabels, 100);

    const prose = document.querySelector(".prose");
    if (prose && !observedElements.has(prose)) {
      observedElements.add(prose);
      let timeout: ReturnType<typeof setTimeout>;
      const observer = new MutationObserver(() => {
        clearTimeout(timeout);
        timeout = setTimeout(applyLabels, 300);
      });
      observer.observe(prose, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ["role"],
      });
      observerMap.set(prose, observer);
    }
  };

  setupPostInteractions();
  if (!document.documentElement.hasAttribute("data-blog-listener-init")) {
    document.documentElement.setAttribute("data-blog-listener-init", "true");
    document.addEventListener("astro:after-swap", setupPostInteractions);
  }
</script>
