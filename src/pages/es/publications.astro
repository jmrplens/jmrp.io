---
/**
 * Spanish Publications Page.
 * Generates `/es/publications/` route with Spanish translations.
 */
import PublicationItem from "@components/publications/PublicationItem.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { stripHtml } from "@utils/html";
import { getPublications } from "@utils/publications";
import { getSiteUrl } from "@utils/site";

import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const publicationGroups = await getPublications();

const allPublications = publicationGroups.flatMap((group) => group.items);

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": new URL(
    "#collection",
    new URL(Astro.url.pathname, getSiteUrl()),
  ).toString(),
  name: t("pages.publications.title"),
  description: t("pages.publications.schemaDescription"),
  url: new URL(Astro.url.pathname, getSiteUrl()).toString(),
  mainEntity: {
    "@type": "ItemList",
    itemListElement: allPublications.map((pub, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "ScholarlyArticle",
        headline: pub.title,
        name: pub.title,
        datePublished: pub.issued?.["date-parts"]?.[0]?.[0]
          ? String(pub.issued["date-parts"][0][0])
          : undefined,
        author:
          pub.author?.map((a: { family: string; given?: string }) => ({
            "@type": "Person",
            ...(a.given && { givenName: a.given }),
            familyName: a.family,
            name: a.given ? `${a.given} ${a.family}` : a.family,
          })) || [],
        publication:
          pub["container-title"] ||
          pub.publisher ||
          pub.school ||
          pub.institution
            ? {
                "@type": "Periodical",
                name:
                  pub["container-title"] ||
                  pub.publisher ||
                  pub.school ||
                  pub.institution,
              }
            : undefined,
        abstract:
          typeof pub.abstract === "string"
            ? stripHtml(pub.abstract)
            : undefined,
        ...(() => {
          const doi = typeof pub.doi === "string" ? pub.doi : undefined;
          let doiUrl: string | undefined;
          if (doi) {
            doiUrl = doi.startsWith("http") ? doi : `https://doi.org/${doi}`;
          }
          return {
            url: pub.url || doiUrl || undefined,
            ...(doiUrl && { sameAs: [doiUrl] }),
          };
        })(),
      },
    })),
  },
};
---

<BaseLayout
  title={t("pages.publications.title")}
  description={t("pages.publications.description")}
  schema={collectionSchema}
>
  <div class="container">
    <h1 class="page-title">{t("pages.publications.title")}</h1>

    {
      publicationGroups.map((group) => (
        <section
          class="pub-section"
          aria-label={group.title}
        >
          <div class="section-header">
            <h2>{group.title}</h2>
          </div>
          <div class="publications-list">
            {group.items.map((pub) => (
              <PublicationItem pub={pub} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  let publicationsInitialized = false;

  function initPublications() {
    if (publicationsInitialized) return;
    publicationsInitialized = true;

    const handleAbstracts = (selector: string, idPrefix: string) => {
      document.querySelectorAll(selector).forEach((btn) => {
        (btn as HTMLElement).onclick = (e) => {
          e.preventDefault();
          const target = e.currentTarget as HTMLElement;
          const id = target.dataset.id;
          const element = document.getElementById(`${idPrefix}-${id}`);
          if (element) {
            const isHidden = element.classList.toggle("hidden");
            target.setAttribute("aria-expanded", String(!isHidden));
          }
        };
      });
    };

    handleAbstracts(".btn-abstract", "abstract");
    handleAbstracts(".btn-bibtex-toggle", "bibtex");
  }

  document.addEventListener("astro:before-swap", () => {
    publicationsInitialized = false;
  });

  document.addEventListener("astro:page-load", initPublications);
  document.addEventListener("DOMContentLoaded", initPublications);
</script>

<style>
  .pub-section {
    margin-bottom: var(--space-3xl);
  }

  .publications-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .section-header {
    margin-bottom: var(--space-lg);
    border-bottom: 2px solid var(--color-border);
  }

  .pub-section h2 {
    display: inline-block;
    padding-bottom: var(--space-sm);
    margin-bottom: -2px;
    font-size: 1.5rem;
    font-weight: bold;
    border-bottom: 2px solid var(--color-primary);
  }
</style>
