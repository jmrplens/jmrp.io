---
/**
 * Spanish CV Page.
 * Generates `/es/cv/` route with Spanish translations.
 */
import "@styles/skills.css";

import CertificateGroup from "@components/cv/CertificateGroup.astro";
import CVMenu, { type MenuSection } from "@components/cv/CVMenu.astro";
import SkillGroup from "@components/cv/SkillGroup.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { CVSection } from "@src/types";
import { getCVData } from "@utils/cv";
import { sanitize, stripHtml } from "@utils/html";
import { getSiteUrl } from "@utils/site";

import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const cvData = await getCVData();

// Define the section order
const sectionOrder = [
  "General Information",
  "Experience",
  "Technical Skills",
  "Formal education",
  "Certificates",
];

// Build a lookup Map from cvData to avoid multiple .find() calls
const sectionLookup = new Map<string, CVSection>(
  cvData.map((s) => [s.title, s]),
);

// Get sorted sections in defined order
const sortedSections = sectionOrder
  .map((title) => sectionLookup.get(title))
  .filter((s): s is CVSection => !!s);

// Helper to generate slugs
const generateSlug = (text: string) =>
  text
    .toLowerCase()
    .replaceAll(/[^a-z0-9\s-]/g, "")
    .trim()
    .replaceAll(/\s+/g, "-");

// Prepare menu structure with subsections
const menuSections: MenuSection[] = sortedSections.map((section) => {
  const sectionSlug = generateSlug(section.title);
  let items: { title: string; slug: string }[] = [];

  switch (section.type) {
    case "time_table": {
      // Experience & Education: Use job title and year
      items = section.contents.map((item, index) => ({
        title: item.year ? `${item.title} (${item.year})` : item.title,
        slug: generateSlug(`${section.title}-${item.title}-${index}`),
      }));
      break;
    }
    case "list_groups":
    case "certificate_list": {
      // Skills & Certificates: Use group/category name
      items = section.contents.map((group, index) => ({
        title: group.category,
        slug: generateSlug(`${section.title}-${group.category}-${index}`),
      }));
      break;
    }
  }

  return {
    title: section.title,
    slug: sectionSlug,
    items,
  };
});

// Extract specific sections from the lookup (single pass, no redundant .find())
const technicalSkills = sectionLookup.get("Technical Skills");
const formalEducation = sectionLookup.get("Formal education");
const experience = sectionLookup.get("Experience");
const certificates = sectionLookup.get("Certificates");

const personSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": new URL(
    "#profile",
    new URL(Astro.url.pathname, getSiteUrl()),
  ).toString(),
  mainEntity: {
    "@type": "Person",
    name: "José Manuel Requena Plens",
    jobTitle: "R&D Engineer",
    description:
      "R&D Engineer specializing in software development, cloud infrastructure, and security.",
    url: "https://jmrp.io",
    image: "https://jmrp.io/assets/mehome.webp",
    sameAs: [
      "https://github.com/jmrplens",
      "https://mstdn.jmrp.io/@jmrplens",
      "https://www.linkedin.com/in/jmrplens",
    ],
    worksFor: {
      "@type": "Organization",
      name: "Power Electronics",
    },
    knowsAbout:
      technicalSkills?.type === "list_groups"
        ? technicalSkills.contents.flatMap((g) => g.items.map((i) => i.name))
        : [],
    alumniOf:
      formalEducation?.type === "time_table"
        ? formalEducation.contents.map((edu) => ({
            "@type": "EducationalOrganization",
            name: edu.institution ? stripHtml(edu.institution) : undefined,
            department: edu.department ? stripHtml(edu.department) : undefined,
          }))
        : [],
    hasOccupation:
      experience?.type === "time_table"
        ? experience.contents.map((job) => ({
            "@type": "Occupation",
            name: job.title,
            description: job.summary ? stripHtml(job.summary) : undefined,
          }))
        : [],
    hasCredential:
      certificates?.type === "certificate_list"
        ? certificates.contents.flatMap((group) =>
            group.items.map((cert) => ({
              "@type": "EducationalOccupationalCredential",
              name: cert.name,
              credentialCategory: group.category,
              recognizedBy: {
                "@type": "Organization",
                name: cert.school,
              },
              url: cert.link,
            })),
          )
        : [],
  },
};
---

<BaseLayout
  title={t("pages.cv.title")}
  description={t("pages.cv.description")}
  type="profile"
  schema={personSchema}
>
  <div class="container">
    <h1 class="page-title cv-title">{t("pages.cv.heading")}</h1>

    {
      sortedSections.map((section) => (
        <section
          class="cv-section"
          id={generateSlug(section.title)}
          aria-label={section.title}
        >
          <div class="section-header">
            <h2>{section.title}</h2>
          </div>

          {section.type === "map" && (
            <div class="cv-map">
              {section.contents.map((item) => (
                <div class="map-item">
                  <span class="map-key">{item.name}:</span>
                  {item.value && <span class="map-value">{item.value}</span>}
                  {item.links && (
                    <div class="map-links">
                      {item.links.map((link) => (
                        <a
                          href={link.link}
                          class="btn btn-sm btn-outline"
                          download={link.download || undefined}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.name}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}

          {section.type === "time_table" && (
            <div class="timeline">
              {section.contents.map((item, index) => (
                <article
                  class="timeline-item"
                  id={generateSlug(`${section.title}-${item.title}-${index}`)}
                >
                  <div
                    class="timeline-marker"
                    aria-hidden="true"
                  />
                  <div class="timeline-content">
                    <header class="timeline-header">
                      <h3 class="item-title">{item.title}</h3>
                      <span class="item-year">{item.year}</span>
                    </header>

                    {item.institution && (
                      <div
                        class="item-institution"
                        set:html={sanitize(item.institution)}
                      />
                    )}
                    {item.department && (
                      <div
                        class="item-department"
                        set:html={sanitize(item.department)}
                      />
                    )}
                    {item.location && (
                      <div class="item-location">
                        <span
                          class="i-fa-solid:map-marker-alt"
                          aria-hidden="true"
                        />{" "}
                        {item.location}
                      </div>
                    )}

                    {item.summary && (
                      <div
                        class="item-summary"
                        set:html={sanitize(item.summary)}
                      />
                    )}

                    {item.description && Array.isArray(item.description) && (
                      <ul class="item-description-list">
                        {item.description.map((desc) => {
                          if (typeof desc === "string")
                            return (
                              <li>
                                <div set:html={sanitize(desc)} />
                              </li>
                            );
                          if (
                            typeof desc === "object" &&
                            desc.title &&
                            Array.isArray(desc.contents)
                          ) {
                            // Nested contents in description
                            return (
                              <li>
                                <strong>{desc.title}</strong>
                                <ul>
                                  {desc.contents.map((sub: string) => (
                                    <li>
                                      <div set:html={sanitize(sub)} />
                                    </li>
                                  ))}
                                </ul>
                              </li>
                            );
                          }
                          return null;
                        })}
                      </ul>
                    )}

                    {item.linkitems && (
                      <div class="item-links">
                        {item.linkitems.map((link) => (
                          <a
                            href={link.link}
                            class="btn btn-sm"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={link.ariaLabel}
                          >
                            <span
                              class="i-fa-solid:file-pdf"
                              aria-hidden="true"
                            />
                            {link.linkname}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
          )}

          {section.type === "list_groups" && (
            <div class="grid-layout">
              {section.contents.map((group, index) => (
                <div
                  class="skill-group-wrapper"
                  id={generateSlug(
                    `${section.title}-${group.category}-${index}`,
                  )}
                >
                  <SkillGroup group={group} />
                </div>
              ))}
            </div>
          )}

          {section.type === "certificate_list" && (
            <div class="grid-layout">
              {section.contents.map((group, index) => (
                <div
                  class="cert-group-wrapper"
                  id={generateSlug(
                    `${section.title}-${group.category}-${index}`,
                  )}
                >
                  <CertificateGroup group={group} />
                </div>
              ))}
            </div>
          )}
        </section>
      ))
    }
  </div>

  <CVMenu sections={menuSections} />

  {/* ICON_DETECTION_START */}
  <div
    class="hidden"
    aria-hidden="true"
  >
    <span class="i-fa-solid:microchip"></span>
    <span class="i-logos:c"></span>
    <span class="i-simple-icons:arm"></span>
    <span class="i-fa-solid:project-diagram"></span>
    <span class="i-fa-solid:wave-square"></span>
    <span class="i-logos:arduino"></span>
    <span class="i-fa-solid:code"></span>
    <span class="i-logos:python"></span>
    <span class="i-logos:c-plusplus"></span>
    <span class="i-logos:git-icon"></span>
    <span class="i-vscode-icons:file-type-matlab"></span>
    <span class="i-vscode-icons:file-type-cmake"></span>
    <span class="i-logos:jetbrains"></span>
    <span class="i-simple-icons:comsol"></span>
    <span class="i-simple-icons:labview"></span>
    <span class="i-fa-solid:volume-up"></span>
    <span class="i-fa-solid:desktop"></span>
    <span class="i-logos:linux-tux"></span>
    <span class="i-simple-icons:apple"></span>
    <span class="i-logos:microsoft-windows-icon"></span>
    <span class="i-vscode-icons:file-type-tex"></span>
    <span class="i-vscode-icons:file-type-html"></span>
    <span class="i-fa-solid:medkit"></span>
    <span class="i-fa-solid:users"></span>
    <span class="i-fa-solid:industry"></span>
    <span class="i-fa-solid:laptop-code"></span>
  </div>
  {/* ICON_DETECTION_END */}
</BaseLayout>

<style>
  .cv-title {
    margin-bottom: var(--space-md);
  }

  /* Section Styling */
  .cv-section {
    margin-bottom: var(--space-lg-xl);
    scroll-margin-top: var(--header-height);
  }

  .section-header {
    margin-bottom: var(--space-lg);
    border-bottom: 2px solid var(--color-border);
  }

  .cv-section h2 {
    display: inline-block;
    padding-bottom: var(--space-sm);
    margin-bottom: -2px; /* Overlap border */
    border-bottom: 2px solid var(--color-primary);
  }

  /* Scroll margin for inner items to clear header */
  .timeline-item,
  .skill-group-wrapper,
  .cert-group-wrapper {
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }

  /* Map Type */
  .cv-map {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .map-item {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    align-items: baseline;
    font-size: 1.05rem;
  }

  .map-key {
    font-weight: var(--fw-bold);
    color: var(--color-text);
  }

  .map-value {
    color: var(--color-text-offset);
  }

  .map-links {
    display: inline-flex;
    gap: var(--space-sm);
  }

  /* Time Table (Timeline) */
  .timeline {
    position: relative;
    padding-left: var(--space-lg);
    border-left: 2px solid var(--color-border);
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-xl);
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    top: 24px;
    left: calc(-1 * var(--space-lg) - 7px);
    z-index: 10;
    width: 12px;
    height: 12px;
    background-color: var(--color-bg);
    border: 2px solid var(--color-primary);
    border-radius: 50%;
  }

  .timeline-content {
    position: relative;
    padding: var(--space-lg);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      transform 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .timeline-content:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .timeline-content::before {
    position: absolute;
    top: 22px;
    left: -6px;
    width: 12px;
    height: 12px;
    content: "";
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    transform: rotate(45deg);
    transition: border-color 0.2s;
  }

  .timeline-content:hover::before {
    border-bottom-color: var(--color-primary);
    border-left-color: var(--color-primary);
  }

  .timeline-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .item-title {
    margin: 0;
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .item-year {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: var(--fw-medium);
    color: var(--color-primary);
  }

  .item-institution,
  .item-department {
    font-size: 1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
  }

  .item-location {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin-top: var(--space-xs);
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .item-summary {
    margin-top: var(--space-md);
    line-height: 1.6;
    color: var(--color-text-offset);
  }

  .item-description-list {
    padding-left: var(--space-lg);
    margin-top: var(--space-sm);
    color: var(--color-text-offset);
  }

  .item-description-list li {
    margin-bottom: var(--space-xs);
  }

  .item-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  /* Grid Layouts for Skills/Certs */
  .grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
    align-items: start;
  }

  /* Responsive */
  @media (width <= 768px) {
    .timeline-header {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
