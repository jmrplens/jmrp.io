---
/**
 * Services Page.
 * Displays self-hosted services status and details.
 * Uses <ServiceStats> (React) to fetch and display live status.
 */
import ServiceCard from "@components/services/ServiceCard.astro";
import ServiceStats from "@components/services/ServiceStats";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";

const servicesSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": new URL(
    "#collection",
    new URL(Astro.url.pathname, getSiteUrl()),
  ).toString(),
  name: "Self-Hosted Services",
  hasPart: [
    {
      "@type": "Service",
      name: "Mastodon Instance",
      description:
        "A decentralized social network server. Part of the Fediverse.",
      url: "https://mstdn.jmrp.io/",
      provider: {
        "@type": "Person",
        name: "José Manuel Requena Plens",
      },
    },
    {
      "@type": "Service",
      name: "Matrix Homeserver",
      description: "Secure, decentralized communication.",
      url: "https://matrix.to/#/@jmrplens:matrix.jmrp.io",
      provider: {
        "@type": "Person",
        name: "José Manuel Requena Plens",
      },
    },
    {
      "@type": "Service",
      name: "Meshtastic Infrastructure",
      description:
        "Infrastructure for the Meshtastic mesh network. Includes Map, Node Database, and Network Monitors.",
      url: "https://mesh.jmrp.io",
      provider: {
        "@type": "Person",
        name: "José Manuel Requena Plens",
      },
    },
  ],
};
---

<BaseLayout
  title="Services"
  description="Self-hosted Services"
  schema={servicesSchema}
>
  <section aria-label="Self-hosted services">
    <div class="container">
      <h1 class="page-title">Self-Hosted Services</h1>
      <p class="intro">
        I maintain several self-hosted services to support decentralized
        networks and personal infrastructure. Below are some of the public
        services I provide.
      </p>

      <div class="services-grid">
        <ServiceCard
          title="Mastodon"
          icon="fa-brands:mastodon"
          description="A decentralized social network server. Part of the Fediverse."
          link="https://mstdn.jmrp.io/"
          linkText="Visit mstdn.jmrp.io"
        >
          <div
            id="mastodon-stats"
            class="stats-container"
          >
            <ServiceStats
              client:visible
              type="mastodon"
            />
          </div>
        </ServiceCard>

        <ServiceCard
          title="Matrix"
          icon="simple-icons:matrix"
          description="Secure, decentralized communication. My Server: matrix.jmrp.io"
          link="https://matrix.to/#/@jmrplens:matrix.jmrp.io"
          linkText="Chat on Matrix"
        >
          <div
            slot="extra"
            class="user-info"
          >
            User: <code>@jmrplens:matrix.jmrp.io</code>
          </div>
          <div
            id="matrix-stats"
            class="stats-container"
          >
            <ServiceStats
              client:visible
              type="matrix"
            />
          </div>
        </ServiceCard>

        <ServiceCard
          title="Meshtastic"
          icon="fa-solid:broadcast-tower"
          description="Infrastructure for the Meshtastic mesh network. Includes Map, Node Database, and Network Monitors."
          link="https://mesh.jmrp.io"
          linkText="Open Mesh Hub"
        >
          <div
            id="meshtastic-stats"
            class="stats-container"
          >
            <ServiceStats
              client:visible
              type="meshtastic-combined"
            />
          </div>
        </ServiceCard>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 800px;
    margin-bottom: var(--space-xl);
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-lg);
  }

  /* Content Styling for Slots */
  .user-info {
    padding: var(--space-sm);
    margin-bottom: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-accent);
    overflow-wrap: break-word;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
  }

  code {
    padding: 2px 4px;
    color: var(--color-accent);
    background: var(--color-bg);
    border-radius: 4px;
  }

  .stats-container {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    font-size: 0.85rem;
    word-break: break-all;
    overflow-wrap: break-word;
    background: transparent;
    border-radius: var(--radius-sm);
  }

  #mastodon-stats.stats-container,
  #matrix-stats.stats-container,
  #meshtastic-stats.stats-container {
    padding: 0;
    margin-top: 0;
    background: transparent;
    border: none;
  }
</style>

<style is:global>
  /* Styling for React ServiceStats component */
  .stats-wrapper-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stats-wrapper-small-gap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Status Header */
  .status-header {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.9em;
  }

  .status-badge {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    padding: 2px 8px;
    color: #10b981;
    background: rgb(16 185 129 / 10%);
    border-radius: 12px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
  }

  .status-text-muted {
    color: var(--color-text-muted);
  }

  .status-text {
    color: var(--color-text);
  }

  /* Grids */
  .server-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.5rem;
    width: 100%;
  }

  .component-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.4rem 0.6rem;
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: 6px;
  }

  .component-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  .brand-mastodon {
    color: #6364ff;
  }

  .brand-matrix {
    padding: 2px;
    color: #000;
    background: white;
    border-radius: 50%;
  }

  .component-info {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .component-name {
    font-size: 0.75em;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .component-version {
    font-size: 0.85em;
    font-weight: bold;
    color: var(--color-text);
  }

  /* Trends */
  .trending-header {
    margin: 0 0 0.5rem;
    font-size: 0.8em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .trending-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stat-btn-filled {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    padding: 0.25rem 0.5rem;
    font-size: 0.8em;
    color: var(--color-text);
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .stat-btn-filled:hover {
    text-decoration: none;
    background: var(--color-border);
  }

  .opacity-60 {
    opacity: 60%;
  }

  /* Meshtastic Rows */
  .meshtastic-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .meshtastic-left {
    display: flex;
    align-items: center;
  }

  .status-dot-inline {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 6px;
    background: #10b981;
    border-radius: 50%;
  }

  .meshtastic-title {
    display: block;
    font-size: 0.95em;
    line-height: 1.2;
  }

  .meshtastic-sub {
    font-size: 0.85em;
    color: var(--color-text-muted);
  }

  .meshtastic-ver {
    margin-left: 4px;
    opacity: 70%;
  }

  .stats-error,
  .stats-loading {
    width: 100%;
    padding: 1rem;
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    width: 100%;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.5rem;
    text-align: center;
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: 4px;
  }

  .stat-value {
    font-size: 1.1em;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stat-label {
    font-size: 0.75em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
</style>
