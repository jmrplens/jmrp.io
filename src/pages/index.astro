---
/**
 * Home Page (Index).
 * Displays the hero section, biography, and quick links.
 * Content is configured via `src/content/site_config/site.yaml`.
 */
import mehomeImg from "@assets/mehome.webp";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { SiteConfig } from "@src/types";
import { sanitize } from "@utils/html";
import { getSiteUrl } from "@utils/site";
import { Image } from "astro:assets";
// Config
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

const { hero } = siteData;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": new URL("#person", getSiteUrl()).toString(),
  name: "José Manuel Requena Plens",
  url: getSiteUrl(),
  image: new URL("/assets/mehome.webp", getSiteUrl()).toString(),
  sameAs: [
    "https://github.com/jmrplens",
    "https://mstdn.jmrp.io/@jmrplens",
    "https://www.linkedin.com/in/jmrplens",
  ],
  jobTitle: "R&D Engineer",
  worksFor: {
    "@type": "Organization",
    name: "Power Electronics",
  },
};
---

<BaseLayout
  title="Home"
  description="Personal website and academic portfolio."
  schema={personSchema}
>
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <h1>{hero.title}</h1>
          <p
            class="subtitle"
            set:html={sanitize(hero.subtitle)}
          />
          <div class="bio">
            {
              hero.bio.map((paragraph: string) => (
                <p set:html={sanitize(paragraph)} />
              ))
            }
          </div>
        </div>

        <div class="profile-image centered">
          <div class="hero-image">
            <Image
              src={mehomeImg}
              alt="José Manuel Requena Plens"
              width={350}
              height={350}
              widths={[200, 350, 400, 700]}
              sizes="(max-width: 768px) 200px, 350px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>

      <div class="social-links-row">
        <a
          href="/cv"
          class="btn btn-primary"
          >View CV</a
        >
        <a
          href="https://github.com/jmrplens"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
          ><Icon name="fa-brands:github" /> GitHub</a
        >
        <a
          href="https://mstdn.jmrp.io/@jmrplens"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
          ><Icon name="fa-brands:mastodon" /> Mastodon</a
        >
        <a
          href="/services"
          class="btn btn-outline"
          ><Icon name="fa-solid:server" /> Services</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-xl) 0;
    background-color: var(--color-bg-secondary);
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-xl);
    align-items: start;
    margin-bottom: var(--space-xl);
  }

  .social-links-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: flex-start;
    min-height: 44px; /* Stabilize row height */
    margin-top: var(--space-lg);
  }

  .social-links-row svg {
    width: 1em;
    height: 1em;
  }

  .hero-text {
    display: flex;
    flex-direction: column;

    /* Stabilize height against font swaps to prevent footer shift */
    min-height: 380px;
    contain-intrinsic-size: 1px 380px;
  }

  .hero-text h1 {
    margin-bottom: var(--space-md);
    font-size: 3rem;
    line-height: 1.2;
  }

  .subtitle {
    min-height: 2.8em; /* Reserve space for exactly two lines if needed */
    margin-bottom: var(--space-md);
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .bio {
    contain-intrinsic-size: 1px 200px;

    /* Performance: help browser with rendering hints */
    content-visibility: auto;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .bio p {
    margin-bottom: var(--space-md);
  }

  .profile-image.centered {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .profile-image img {
    width: 100%;
    max-width: 350px;
    height: auto;
    aspect-ratio: 1/1;
    object-fit: cover;
    border: 4px solid var(--color-bg-secondary);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 40px rgb(0 0 0 / 30%);
  }

  .hero-image {
    display: flex;
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
  }

  /* Sections */
  section {
    padding: var(--space-lg) 0;
  }

  h2 {
    position: relative;
    display: inline-block;
    margin-bottom: var(--space-lg);
    font-size: 2rem;
  }

  h2::after {
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 40px;
    height: 4px;
    content: "";
    background-color: var(--color-primary);
    border-radius: 2px;
  }

  @media (width <= 768px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .profile-image {
      order: -1;
      width: 200px;
      max-width: 200px;
      min-height: 200px;
      aspect-ratio: 1 / 1;
      margin: 0 auto var(--space-lg) auto;
    }

    .social-links-row {
      justify-content: center;
      min-height: 100px; /* Account for wrapping buttons in mobile */
    }

    .bio {
      text-align: left;
    }

    .hero-text {
      min-height: 450px; /* Reserve enough space for wrapped text in mobile */
      text-align: center;
    }
  }

  /* Projects */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .project-card {
    overflow: hidden;
    background-color: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .project-card:hover {
    text-decoration: none;
    border-color: var(--color-primary);
    box-shadow: 0 10px 20px rgb(0 0 0 / 20%);
    transform: translateY(-4px);
  }

  .project-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .card-content {
    padding: var(--space-md);
  }

  .card-content h3 {
    margin: 0 0 var(--space-sm) 0;
    color: var(--color-text);
  }

  .card-content p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
</style>
