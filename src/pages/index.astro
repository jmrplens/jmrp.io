---
/**
 * Home Page (Index).
 * Displays the hero section, biography, and quick links.
 * Content is configured via `src/content/site_config/site.yaml`.
 */
import mehomeImg from "@assets/mehome.webp";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { SiteConfig } from "@src/types";
import { sanitize } from "@utils/html";
import { getSiteUrl } from "@utils/site";
import { Image } from "astro:assets";
// Config
import { getEntry, getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import PostCard from "@components/blog/PostCard.astro";
import RepoCard from "@components/github/RepoCard.astro";
import { fetchRepositoriesByName } from "@utils/github";

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

const { hero = { title: "", subtitle: "", bio: [] } } = siteData;

// Use centralized person config with fallbacks
const person = siteData.person || {
  name: siteData.author || "José Manuel Requena Plens",
  jobTitle: "R&D Engineer",
  worksFor: { name: "Power Electronics" },
};

// Fetch latest posts
const latestPosts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort(
    (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
  )
  .slice(0, 3);

// Fetch featured projects
const featuredProjects = await fetchRepositoriesByName(
  siteData.featured_projects || [],
);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": new URL("#person", getSiteUrl()).toString(),
  name: person.name,
  url: getSiteUrl(),
  image: new URL(mehomeImg.src, getSiteUrl()).toString(),
  sameAs: siteData.social_links?.map((s) => s.url) || [],
  jobTitle: person.jobTitle,
  worksFor: {
    "@type": "Organization",
    name: person.worksFor.name,
    ...(person.worksFor.url && { url: person.worksFor.url }),
  },
};

// Filter social links for hero section (GitHub and Mastodon)
const heroSocialLinks =
  siteData.social_links?.filter(
    (link) => link.name === "GitHub" || link.name === "Mastodon",
  ) || [];
---

<BaseLayout
  title="Home"
  description="Personal website and academic portfolio."
  schema={personSchema}
>
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <h1>{hero.title}</h1>
          <p
            class="subtitle"
            set:html={sanitize(hero.subtitle)}
          />
          <div class="bio">
            {
              hero.bio.map((paragraph: string) => (
                <p set:html={sanitize(paragraph)} />
              ))
            }
          </div>
        </div>

        <div class="profile-image centered">
          <div class="hero-image">
            <Image
              src={mehomeImg}
              alt={person.name}
              width={350}
              height={350}
              widths={[200, 350, 400, 700]}
              sizes="(max-width: 768px) 200px, 350px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>

      <div class="social-links-row">
        <a
          href="/cv/"
          class="btn btn-primary"
          aria-label="View my professional curriculum vitae"
          >View CV</a
        >
        {
          heroSocialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel={link.rel || "noopener noreferrer"}
              class="btn btn-outline"
              aria-label={`View my ${link.name} profile`}
            >
              {link.icon && <Icon name={link.icon} />}
              {link.name}
            </a>
          ))
        }
        <a
          href="/services/"
          class="btn btn-outline"
          aria-label="View the services I offer"
          ><Icon name="fa-solid:server" /> Services</a
        >
      </div>
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="latest-posts">
        <div class="container">
          <div class="section-header">
            <h2>Latest from the Blog</h2>
            <a
              href="/blog/"
              class="btn btn-link"
            >
              View all posts &rarr;
            </a>
          </div>
          <div class="grid-layout">
            {latestPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    featuredProjects.length > 0 && (
      <section class="featured-projects">
        <div class="container">
          <div class="section-header">
            <h2>Featured Projects</h2>
            <a
              href="/github/"
              class="btn btn-link"
            >
              View all repositories &rarr;
            </a>
          </div>
          <div class="grid-layout">
            {featuredProjects.map((repo) => (
              <RepoCard repo={repo} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding: var(--space-xl) 0;
    background-color: var(--color-bg-secondary);
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-xl);
    align-items: start;
    margin-bottom: var(--space-xl);
  }

  .social-links-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
    justify-content: flex-start;
    min-height: 44px; /* Stabilize row height for single line */
    margin-top: var(--space-lg);
  }

  .social-links-row svg {
    width: 1em;
    height: 1em;
  }

  .hero-text {
    display: flex;
    flex-direction: column;

    /* Stabilize height against font swaps to prevent footer shift */
    min-height: fit-content;
  }

  .hero-text h1 {
    margin-bottom: var(--space-md);
    font-size: 3rem;
    line-height: 1.2;
  }

  .subtitle {
    min-height: 2.8em; /* Reserve space for exactly two lines if needed */
    margin-bottom: var(--space-md);
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .bio {
    contain-intrinsic-size: 1px 200px;

    /* Performance: help browser with rendering hints */
    content-visibility: auto;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .bio p {
    margin-bottom: var(--space-md);
  }

  .profile-image.centered {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .profile-image img {
    width: 100%;
    max-width: 350px;
    height: auto;
    aspect-ratio: 1/1;
    object-fit: cover;
    border: 4px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 40px rgb(0 0 0 / 30%);
  }

  .hero-image {
    display: flex;
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
  }

  /* Sections */
  section {
    padding: var(--space-lg) 0;
  }

  h2 {
    position: relative;
    display: inline-block;
    margin-bottom: var(--space-lg);
    font-size: 2rem;
  }

  h2::after {
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 40px;
    height: 4px;
    content: "";
    background-color: var(--color-primary);
    border-radius: 2px;
  }

  /* Latest Posts Section */
  .latest-posts {
    padding: var(--space-xl) 0;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xl);
  }

  .section-header h2 {
    margin-bottom: 0;
  }

  .grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .btn-link {
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .btn-link:hover {
    text-decoration: underline;
  }

  @media (width <= 768px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .profile-image {
      order: -1;
      width: 200px;
      max-width: 200px;
      min-height: 200px;
      aspect-ratio: 1 / 1;
      margin: 0 auto var(--space-lg) auto;
    }

    .social-links-row {
      justify-content: center;
      min-height: auto; /* Let content determine height */
    }

    .bio {
      text-align: left;
    }

    .hero-text {
      min-height: auto; /* Let content determine height */
      text-align: center;
    }
  }
</style>
