---
/**
 * Tools Index Page.
 * Displays available interactive tools and utilities.
 * Style matches CV, Publications, and Homelab pages.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";

interface Tool {
  id: string;
  name: string;
  description: string;
  icon: string;
  href: string;
  features: string[];
  isNew?: boolean;
}

const tools: Tool[] = [
  {
    id: "csp-builder",
    name: "CSP Policy Builder",
    description:
      "Build Content Security Policy headers interactively with real-time security ratings.",
    icon: "i-mdi:shield-lock-outline",
    href: "/tools/csp-builder/",
    features: [
      "Visual directive selector",
      "Live policy preview",
      "Security score",
    ],
  },
  {
    id: "hash-calculator",
    name: "Script Hash Generator",
    description:
      "Generate SHA-256, SHA-384, and SHA-512 hashes for CSP inline scripts.",
    icon: "i-mdi:function-variant",
    href: "/tools/hash-calculator/",
    features: [
      "Multiple algorithms",
      "Ready-to-use directives",
      "Live calculation",
    ],
  },
];

const baseUrl = new URL(Astro.url.pathname, getSiteUrl());
const collectionUrl = new URL("#collection", baseUrl).toString();

const toolsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": collectionUrl,
  name: "Developer Tools",
  description: "Interactive tools for web security and development",
  hasPart: tools.map((tool) => {
    const toolUrl = new URL(tool.href, getSiteUrl()).toString();
    return {
      "@type": "SoftwareApplication",
      name: tool.name,
      description: tool.description,
      url: toolUrl,
      applicationCategory: "WebApplication",
      operatingSystem: "Web Browser",
    };
  }),
};
---

<BaseLayout
  title="Tools"
  description="Free interactive developer tools for web security. Build CSP policies, generate script hashes, and more."
  schema={toolsSchema}
>
  <div class="container">
    <h1 class="page-title">Developer Tools</h1>
    <p class="intro">
      Browser-based utilities for web security and development. All calculations
      happen locally—no data is sent to any server.
    </p>

    <section
      class="tools-section"
      aria-label="Security Tools"
    >
      <div class="section-header">
        <h2>Security Tools</h2>
      </div>

      <div class="tools-grid">
        {
          tools.map((tool) => (
            <a
              href={tool.href}
              class="tool-card"
            >
              {tool.isNew && <span class="tool-badge-new">New</span>}
              <div class="tool-icon-wrapper">
                <span
                  class={`tool-icon ${tool.icon}`}
                  aria-hidden="true"
                />
              </div>
              <div class="tool-content">
                <h3 class="tool-name">{tool.name}</h3>
                <p class="tool-description">{tool.description}</p>
                <ul class="tool-features">
                  {tool.features.map((feature) => (
                    <li>
                      <span
                        class="i-mdi:check feature-icon"
                        aria-hidden="true"
                      />
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="tool-arrow">
                <span
                  class="i-mdi:arrow-right"
                  aria-hidden="true"
                />
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section
      class="info-section"
      aria-label="About these tools"
    >
      <div class="section-header">
        <h2>About These Tools</h2>
      </div>

      <div class="info-grid">
        <div class="info-item">
          <span
            class="i-mdi:shield-account info-icon"
            aria-hidden="true"
          ></span>
          <div class="info-content">
            <strong>Privacy First</strong>
            <p>
              All calculations happen in your browser. Your code never leaves
              your device.
            </p>
          </div>
        </div>
        <div class="info-item">
          <span
            class="i-mdi:lightning-bolt info-icon"
            aria-hidden="true"
          ></span>
          <div class="info-content">
            <strong>Instant Results</strong>
            <p>
              No server round-trips. Results update as you type with zero
              latency.
            </p>
          </div>
        </div>
        <div class="info-item">
          <span
            class="i-mdi:open-source-initiative info-icon"
            aria-hidden="true"
          ></span>
          <div class="info-content">
            <strong>Open Source</strong>
            <p>
              View the source code on <a
                href="https://github.com/jmrplens/jmrp.io"
                target="_blank"
                rel="noopener noreferrer"
                >GitHub</a
              >. Contributions welcome.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    max-width: 600px;
    margin-bottom: var(--space-xl);
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* Section Styling (matches CV/Publications) */
  .tools-section,
  .info-section {
    margin-bottom: var(--space-2xl);
  }

  .section-header {
    margin-bottom: var(--space-lg);
    border-bottom: 2px solid var(--color-border);
  }

  .section-header h2 {
    display: inline-block;
    padding-bottom: var(--space-sm);
    margin-bottom: -2px;
    font-size: 1.5rem;
    font-weight: var(--fw-bold);
    border-bottom: 2px solid var(--color-primary);
  }

  /* Tools Grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--space-lg);
  }

  /* Tool Card */
  .tool-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-md);
    align-items: start;
    padding: var(--space-lg);
    text-decoration: none;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .tool-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .tool-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .tool-badge-new {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    padding: 0.25rem 0.5rem;
    font-size: 0.65rem;
    font-weight: var(--fw-bold);
    color: var(--color-on-primary, #fff);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-primary);
    border-radius: var(--radius-sm);
  }

  .tool-icon-wrapper {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    color: var(--color-on-primary, #fff);
    background: linear-gradient(
      135deg,
      var(--color-primary),
      var(--color-primary-dark, #059669)
    );
    border-radius: var(--radius-md);
  }

  .tool-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .tool-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 0;
  }

  .tool-name {
    margin: 0;
    font-size: 1.1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-description {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .tool-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0;
    margin: var(--space-xs) 0 0;
    list-style: none;
  }

  .tool-features li {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
  }

  .feature-icon {
    width: 0.75rem;
    height: 0.75rem;
    color: var(--color-primary);
  }

  .tool-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-top: 0.25rem;
    color: var(--color-text-muted);
    background: var(--color-bg-subtle);
    border-radius: 50%;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .tool-arrow span {
    width: 1.25rem;
    height: 1.25rem;
  }

  .tool-card:hover .tool-arrow {
    color: var(--color-on-primary, #fff);
    background: var(--color-primary);
    transform: translateX(4px);
  }

  /* Info Section */
  .info-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .info-item {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    padding: var(--space-md);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .info-icon {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 2px;
    color: var(--color-primary);
  }

  .info-content {
    min-width: 0;
  }

  .info-content strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.95rem;
    color: var(--color-text-heading);
  }

  .info-content p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .info-content a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .info-content a:hover {
    text-decoration: none;
  }

  /* Responsive */
  @media (width <= 640px) {
    .tool-card {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .tool-icon-wrapper {
      width: 2.5rem;
      height: 2.5rem;
    }

    .tool-icon {
      width: 1.25rem;
      height: 1.25rem;
    }

    .tool-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-card,
    .tool-arrow {
      transition: none;
    }
  }
</style>
