---
/**
 * Tools Index Page.
 * Displays available interactive tools and utilities.
 * Style matches CV, Publications, and Homelab pages.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";

interface Tool {
  id: string;
  name: string;
  description: string;
  icon: string;
  href: string;
  features: string[];
  isNew?: boolean;
}

interface ToolCategory {
  id: string;
  name: string;
  tools: Tool[];
}

const categories: ToolCategory[] = [
  {
    id: "security",
    name: "Security Tools",
    tools: [
      {
        id: "csp-builder",
        name: "CSP Policy Builder",
        description:
          "Build Content Security Policy headers interactively with real-time security ratings.",
        icon: "i-mdi:shield-lock-outline",
        href: "/tools/csp-builder/",
        features: [
          "Visual directive selector",
          "Live policy preview",
          "Security score",
        ],
      },
      {
        id: "hash-calculator",
        name: "Script Hash Generator",
        description:
          "Generate SHA-256, SHA-384, and SHA-512 hashes for CSP inline scripts.",
        icon: "i-mdi:function-variant",
        href: "/tools/hash-calculator/",
        features: [
          "Multiple algorithms",
          "Ready-to-use directives",
          "Live calculation",
        ],
      },
      {
        id: "jwt-decoder",
        name: "JWT Decoder",
        description:
          "Decode and inspect JSON Web Tokens. View header, payload, and signature with security warnings.",
        icon: "i-mdi:key-variant",
        href: "/tools/jwt-decoder/",
        features: ["Header & payload", "Expiration check", "Security alerts"],
        isNew: true,
      },
      {
        id: "password-generator",
        name: "Password Generator",
        description:
          "Generate cryptographically secure passwords and passphrases with entropy estimation.",
        icon: "i-mdi:lock-outline",
        href: "/tools/password-generator/",
        features: [
          "Crypto-secure",
          "Entropy estimation",
          "Diceware passphrases",
        ],
        isNew: true,
      },
      {
        id: "http-headers-analyzer",
        name: "HTTP Headers Analyzer",
        description:
          "Analyze HTTP security headers and get a security score with detailed recommendations.",
        icon: "i-mdi:web",
        href: "/tools/http-headers-analyzer/",
        features: [
          "Security scoring",
          "10+ headers checked",
          "Recommendations",
        ],
        isNew: true,
      },
      {
        id: "cert-inspector",
        name: "Certificate Inspector",
        description:
          "Decode and inspect PEM-encoded X.509 certificates. View subject, issuer, validity, and key details.",
        icon: "i-mdi:certificate",
        href: "/tools/cert-inspector/",
        features: ["PEM decoding", "Validity check", "Key info"],
        isNew: true,
      },
    ],
  },
  {
    id: "developer",
    name: "Developer Tools",
    tools: [
      {
        id: "base64-encoder",
        name: "Base64 Encoder / Decoder",
        description:
          "Encode and decode between Base64, Base64URL, URL encoding, hex, and HTML entities.",
        icon: "i-mdi:swap-horizontal",
        href: "/tools/base64-encoder/",
        features: ["5 formats", "Auto-detect", "Bidirectional"],
        isNew: true,
      },
      {
        id: "regex-tester",
        name: "Regex Tester",
        description:
          "Test regular expressions with real-time match highlighting and capture group extraction.",
        icon: "i-mdi:regex",
        href: "/tools/regex-tester/",
        features: ["Live highlighting", "Capture groups", "Pattern presets"],
        isNew: true,
      },
      {
        id: "uuid-generator",
        name: "UUID Generator",
        description:
          "Generate UUID v4, UUID v7, ULID, and Nano ID identifiers with batch generation.",
        icon: "i-mdi:identifier",
        href: "/tools/uuid-generator/",
        features: ["4 ID formats", "Batch generation", "Format details"],
        isNew: true,
      },
      {
        id: "cron-builder",
        name: "Cron Expression Builder",
        description:
          "Build cron expressions visually with field selectors and next execution preview.",
        icon: "i-mdi:clock-outline",
        href: "/tools/cron-builder/",
        features: ["Visual builder", "Execution preview", "Common presets"],
        isNew: true,
      },
      {
        id: "timestamp-converter",
        name: "Timestamp Converter",
        description:
          "Convert between Unix timestamps, ISO 8601, and human-readable dates with timezone support.",
        icon: "i-mdi:clock-time-four-outline",
        href: "/tools/timestamp-converter/",
        features: ["Unix ↔ Date", "Live clock", "Relative time"],
        isNew: true,
      },
      {
        id: "color-contrast-checker",
        name: "Color Contrast Checker",
        description:
          "Check WCAG 2.2 color contrast ratios for AA and AAA accessibility compliance.",
        icon: "i-mdi:palette-outline",
        href: "/tools/color-contrast-checker/",
        features: ["WCAG 2.2", "AA & AAA levels", "Live preview"],
        isNew: true,
      },
    ],
  },
  {
    id: "network",
    name: "Network & Server Tools",
    tools: [
      {
        id: "subnet-calculator",
        name: "Subnet Calculator",
        description:
          "Calculate IPv4 and IPv6 subnets with CIDR notation, network ranges, and binary visualization.",
        icon: "i-mdi:lan",
        href: "/tools/subnet-calculator/",
        features: ["IPv4 & IPv6", "CIDR notation", "Binary view"],
        isNew: true,
      },
      {
        id: "nginx-config-generator",
        name: "Nginx Config Generator",
        description:
          "Generate Nginx server block configurations with SSL, reverse proxy, security headers, and caching.",
        icon: "i-devicon:nginx",
        href: "/tools/nginx-config-generator/",
        features: ["Quick presets", "SSL/proxy", "Security headers"],
        isNew: true,
      },
    ],
  },
  {
    id: "embedded",
    name: "Embedded & Industrial Tools",
    tools: [
      {
        id: "modbus-frame-builder",
        name: "Modbus Frame Builder",
        description:
          "Build and decode Modbus RTU/TCP frames with CRC-16 calculation and byte visualization.",
        icon: "i-mdi:chip",
        href: "/tools/modbus-frame-builder/",
        features: ["RTU & TCP", "Auto CRC-16", "Frame decoder"],
        isNew: true,
      },
      {
        id: "byte-order-converter",
        name: "Byte Order Converter",
        description:
          "Convert between big-endian, little-endian, and mixed-endian byte orders with IEEE 754 support.",
        icon: "i-mdi:swap-horizontal-bold",
        href: "/tools/byte-order-converter/",
        features: ["4 byte orders", "IEEE 754", "8–64 bit types"],
        isNew: true,
      },
      {
        id: "crc-calculator",
        name: "CRC Calculator",
        description:
          "Calculate CRC-8, CRC-16, and CRC-32 checksums with presets for Modbus, Ethernet, and USB.",
        icon: "i-mdi:check-decagram",
        href: "/tools/crc-calculator/",
        features: ["12+ algorithms", "Hex & ASCII", "Protocol presets"],
        isNew: true,
      },
    ],
  },
];

const tools = categories.flatMap((cat) => cat.tools);

const baseUrl = new URL(Astro.url.pathname, getSiteUrl());
const collectionUrl = new URL("#collection", baseUrl).toString();

const toolsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": collectionUrl,
  name: "Developer Tools",
  description: "Interactive tools for web security and development",
  hasPart: tools.map((tool) => {
    const toolUrl = new URL(tool.href, getSiteUrl()).toString();
    return {
      "@type": "SoftwareApplication",
      name: tool.name,
      description: tool.description,
      url: toolUrl,
      applicationCategory: "WebApplication",
      operatingSystem: "Web Browser",
    };
  }),
};
---

<BaseLayout
  title="Tools"
  description="Free interactive developer tools for security, encoding, networking, and embedded systems. All tools run entirely in your browser — privacy first."
  schema={toolsSchema}
>
  <div class="container">
    <h1 class="page-title">Developer Tools</h1>
    <p class="intro">
      Browser-based utilities for web security and development. All calculations
      happen locally—no data is sent to any server.
    </p>

    {
      categories.map((category) => (
        <section
          class="tools-section"
          aria-label={category.name}
        >
          <div class="section-header">
            <h2>{category.name}</h2>
          </div>

          <div class="tools-grid">
            {category.tools.map((tool) => (
              <a
                href={tool.href}
                class="tool-card"
              >
                {tool.isNew && <span class="tool-badge-new">New</span>}
                <div class="tool-icon-wrapper">
                  <span
                    class={`tool-icon ${tool.icon}`}
                    aria-hidden="true"
                  />
                </div>
                <div class="tool-content">
                  <h3 class="tool-name">{tool.name}</h3>
                  <p class="tool-description">{tool.description}</p>
                  <ul class="tool-features">
                    {tool.features.map((feature) => (
                      <li>
                        <span
                          class="i-mdi:check feature-icon"
                          aria-hidden="true"
                        />
                        {feature}
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="tool-arrow">
                  <span
                    class="i-mdi:arrow-right"
                    aria-hidden="true"
                  />
                </div>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <section
      class="info-section"
      aria-label="About these tools"
    >
      <div class="section-header">
        <h2>About These Tools</h2>
      </div>

      <div class="info-grid">
        <div class="info-item">
          <span
            class="i-mdi:shield-account info-icon"
            aria-hidden="true"
          ></span>
          <div class="info-content">
            <strong>Privacy First</strong>
            <p>
              All calculations happen in your browser. Your code never leaves
              your device.
            </p>
          </div>
        </div>
        <div class="info-item">
          <span
            class="i-mdi:lightning-bolt info-icon"
            aria-hidden="true"
          ></span>
          <div class="info-content">
            <strong>Instant Results</strong>
            <p>
              No server round-trips. Results update as you type with zero
              latency.
            </p>
          </div>
        </div>
        <div class="info-item">
          <span
            class="i-mdi:open-source-initiative info-icon"
            aria-hidden="true"
          ></span>
          <div class="info-content">
            <strong>Open Source</strong>
            <p>
              View the source code on <a
                href="https://github.com/jmrplens/jmrp.io"
                target="_blank"
                rel="noopener noreferrer"
                >GitHub</a
              >. Contributions welcome.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    max-width: 600px;
    margin-bottom: var(--space-xl);
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* Section Styling (matches CV/Publications) */
  .tools-section,
  .info-section {
    margin-bottom: var(--space-2xl);
  }

  .section-header {
    margin-bottom: var(--space-lg);
    border-bottom: 2px solid var(--color-border);
  }

  .section-header h2 {
    display: inline-block;
    padding-bottom: var(--space-sm);
    margin-bottom: -2px;
    font-size: 1.5rem;
    font-weight: var(--fw-bold);
    border-bottom: 2px solid var(--color-primary);
  }

  /* Tools Grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--space-lg);
  }

  /* Tool Card */
  .tool-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-md);
    align-items: start;
    padding: var(--space-lg);
    text-decoration: none;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .tool-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .tool-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .tool-badge-new {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    padding: 0.25rem 0.5rem;
    font-size: 0.65rem;
    font-weight: var(--fw-bold);
    color: var(--color-on-primary, #fff);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-primary);
    border-radius: var(--radius-sm);
  }

  .tool-icon-wrapper {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    color: var(--color-on-primary, #fff);
    background: linear-gradient(
      135deg,
      var(--color-primary),
      var(--color-primary-dark, #059669)
    );
    border-radius: var(--radius-md);
  }

  .tool-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .tool-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 0;
  }

  .tool-name {
    margin: 0;
    font-size: 1.1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-description {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .tool-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0;
    margin: var(--space-xs) 0 0;
    list-style: none;
  }

  .tool-features li {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
  }

  .feature-icon {
    width: 0.75rem;
    height: 0.75rem;
    color: var(--color-primary);
  }

  .tool-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-top: 0.25rem;
    color: var(--color-text-muted);
    background: var(--color-bg-subtle);
    border-radius: 50%;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .tool-arrow span {
    width: 1.25rem;
    height: 1.25rem;
  }

  .tool-card:hover .tool-arrow {
    color: var(--color-on-primary, #fff);
    background: var(--color-primary);
    transform: translateX(4px);
  }

  /* Info Section */
  .info-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .info-item {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    padding: var(--space-md);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .info-icon {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 2px;
    color: var(--color-primary);
  }

  .info-content {
    min-width: 0;
  }

  .info-content strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.95rem;
    color: var(--color-text-heading);
  }

  .info-content p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .info-content a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .info-content a:hover {
    text-decoration: none;
  }

  /* Responsive */
  @media (width <= 640px) {
    .tool-card {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .tool-icon-wrapper {
      width: 2.5rem;
      height: 2.5rem;
    }

    .tool-icon {
      width: 1.25rem;
      height: 1.25rem;
    }

    .tool-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-card,
    .tool-arrow {
      transition: none;
    }
  }
</style>
