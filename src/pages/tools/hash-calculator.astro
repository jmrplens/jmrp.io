---
/**
 * Hash Calculator Tool Page.
 * SHA-256 hash calculator for CSP inline scripts.
 */
import HashCalculatorComponent from "@components/apps/HashCalculator.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "CSP Hash Calculator",
  description:
    "Generate SHA-256 hashes for inline scripts. Get ready-to-use CSP directives for your script content.",
  url: new URL("/tools/hash-calculator/", getSiteUrl()).toString(),
  applicationCategory: "WebApplication",
  operatingSystem: "Web Browser",
  offers: {
    "@type": "Offer",
    price: 0,
    priceCurrency: "USD",
  },
};
---

<BaseLayout
  title="CSP Hash Calculator"
  description="Generate SHA-256 hashes for inline scripts. Get ready-to-use CSP directives for your Content Security Policy."
  schema={toolSchema}
>
  <div class="tool-page">
    <div class="content-wrapper">
      <nav
        class="breadcrumb"
        aria-label="Breadcrumb"
      >
        <a href="/tools/">Tools</a>
        <span
          class="i-mdi:chevron-right"
          aria-hidden="true"
        ></span>
        <span aria-current="page">Hash Calculator</span>
      </nav>

      <header class="page-header">
        <div class="header-icon">
          <span
            class="i-mdi:calculator-variant-outline"
            aria-hidden="true"
          ></span>
        </div>
        <div class="header-content">
          <h1>CSP Hash Calculator</h1>
          <p class="subtitle">
            Generate SHA-256 hashes for inline scripts. Copy the hash directly
            into your Content Security Policy.
          </p>
        </div>
      </header>

      <div class="tool-container">
        <HashCalculatorComponent
          title=""
          showExplanation={true}
        />
      </div>

      <section class="tool-info">
        <h2>About This Tool</h2>
        <p>
          When you need to allow specific inline scripts in your CSP without
          using <code>'unsafe-inline'</code>, you can use hashes. This tool
          calculates the SHA-256 hash of your script content in the format CSP
          expects.
        </p>
        <h3>How to Use</h3>
        <ol>
          <li>
            Paste your inline script content (excluding <code
              >&lt;script&gt;</code
            > tags)
          </li>
          <li>Copy the generated hash or full CSP directive</li>
          <li>
            Add the hash to your <code>script-src</code> directive
          </li>
        </ol>
        <h3>Important Notes</h3>
        <ul>
          <li>
            Any change to the script (even whitespace) will change the hash
          </li>
          <li>
            For dynamic scripts, consider using <a
              href="/blog/003-implementing-content-security-policy-nginx/#solution-3-use-nonces"
              >nonces</a
            > instead
          </li>
          <li>
            See <a href="/blog/003-implementing-content-security-policy-nginx/"
              >the complete CSP guide</a
            > for best practices
          </li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .tool-page {
    min-height: calc(100vh - var(--header-height, 4rem) - 4rem);
    padding: var(--space-xl) 0;
  }

  .content-wrapper {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--max-width-container);
    padding: 0 var(--space-lg);
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin-bottom: var(--space-lg);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .breadcrumb span[class*="i-"] {
    width: 1rem;
    height: 1rem;
  }

  .page-header {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    margin-bottom: var(--space-xl);
  }

  .header-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background: linear-gradient(
      135deg,
      var(--color-success, #10b981),
      var(--color-success-dark, #059669)
    );
    border-radius: var(--radius-lg);
  }

  .header-icon span {
    width: 2rem;
    height: 2rem;
    color: #fff;
  }

  .header-content {
    flex: 1;
    min-width: 0;
  }

  .page-header h1 {
    margin-bottom: var(--space-xs);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .tool-container {
    margin-bottom: var(--space-xl);
  }

  .tool-info {
    max-width: 720px;
    padding: var(--space-lg);
    margin: 0 auto;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-lg);
  }

  .tool-info h2 {
    margin-bottom: var(--space-md);
    font-size: 1.25rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info h3 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    font-size: 1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info p {
    margin-bottom: var(--space-md);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .tool-info ol,
  .tool-info ul {
    padding-left: 1.25rem;
    margin: 0;
  }

  .tool-info li {
    margin-bottom: var(--space-sm);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .tool-info code {
    padding: 0.125rem 0.375rem;
    font-size: 0.85rem;
    background: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
  }

  .tool-info a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tool-info a:hover {
    text-decoration: none;
  }

  @media (width <= 640px) {
    .page-header {
      flex-direction: column;
      text-align: center;
    }

    .page-header h1 {
      font-size: 1.5rem;
    }

    .subtitle {
      font-size: 0.9rem;
    }

    .tool-info {
      padding: var(--space-md);
    }
  }
</style>
