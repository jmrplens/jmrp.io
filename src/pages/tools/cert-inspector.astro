---
/**
 * Certificate Inspector Tool Page.
 */
import CertInspectorApp from "@components/apps/CertInspector.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Certificate Inspector",
  description:
    "Decode and inspect PEM-encoded X.509 certificates. View subject, issuer, validity, key info, and extensions.",
  url: new URL("/tools/cert-inspector/", getSiteUrl()).toString(),
  applicationCategory: "WebApplication",
  operatingSystem: "Web Browser",
  offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
};
---

<BaseLayout
  title="Certificate Inspector"
  description="Decode PEM-encoded SSL/TLS certificates entirely client-side. Inspect subject, issuer, validity period, key algorithm, serial number, and more."
  schema={toolSchema}
>
  <div class="tool-page">
    <div class="content-wrapper">
      <nav
        class="breadcrumb"
        aria-label="Breadcrumb"
      >
        <a href="/tools/">Tools</a>
        <span
          class="i-mdi:chevron-right"
          aria-hidden="true"
        ></span>
        <span aria-current="page">Cert Inspector</span>
      </nav>

      <header class="page-header">
        <div class="header-icon">
          <span
            class="i-mdi:certificate"
            aria-hidden="true"
          ></span>
        </div>
        <div class="header-content">
          <h1>Certificate Inspector</h1>
          <p class="subtitle">
            Decode and inspect PEM-encoded X.509 certificates. View subject,
            issuer, validity, and key details — all client-side.
          </p>
        </div>
      </header>

      <div class="tool-container">
        <CertInspectorApp title="" />
      </div>

      <section class="tool-info">
        <h2>About This Tool</h2>
        <p>
          Inspect SSL/TLS certificates by pasting a PEM-encoded certificate. The
          tool decodes the ASN.1 DER structure entirely in your browser and
          displays certificate details including subject, issuer, validity, and
          key information.
        </p>
        <h3>Information Displayed</h3>
        <ul>
          <li>
            <strong>Validity status</strong> — valid, expiring soon, or expired
          </li>
          <li>
            <strong>Subject &amp; Issuer</strong> — distinguished names with common
            name, organization
          </li>
          <li>
            <strong>Validity period</strong> — not before, not after, days remaining
          </li>
          <li>
            <strong>Public key</strong> — algorithm, key size or curve, signature
            algorithm
          </li>
          <li><strong>Details</strong> — version, serial number</li>
        </ul>
        <h3>How to Use</h3>
        <ol>
          <li>
            Paste a PEM-encoded certificate (BEGIN CERTIFICATE...END
            CERTIFICATE)
          </li>
          <li>Click Inspect Certificate</li>
          <li>Review the decoded certificate details</li>
        </ol>
        <h3>Related</h3>
        <p>
          See <a href="/blog/001-secure-nginx-client-certificates/"
            >Secure Nginx with Client Certificates</a
          > for a guide on mutual TLS.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .tool-page {
    min-height: calc(100vh - var(--header-height, 4rem) - 4rem);
    padding: var(--space-xl) 0;
  }

  .content-wrapper {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--max-width-container);
    padding: 0 var(--space-lg);
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin-bottom: var(--space-lg);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .breadcrumb span[class*="i-"] {
    width: 1rem;
    height: 1rem;
  }

  .page-header {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    margin-bottom: var(--space-xl);
  }

  .header-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background: linear-gradient(
      135deg,
      var(--color-success, #10b981),
      var(--color-success-dark, #059669)
    );
    border-radius: var(--radius-lg);
  }

  .header-icon span {
    width: 2rem;
    height: 2rem;
    color: var(--header-icon-color, #fff);
  }

  .header-content {
    flex: 1;
    min-width: 0;
  }

  .page-header h1 {
    margin-bottom: var(--space-xs);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .tool-container {
    margin-bottom: var(--space-xl);
  }

  .tool-info {
    max-width: 720px;
    padding: var(--space-lg);
    margin: 0 auto;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-lg);
  }

  .tool-info h2 {
    margin-bottom: var(--space-md);
    font-size: 1.25rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info h3 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    font-size: 1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info p {
    margin-bottom: var(--space-md);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .tool-info ul,
  .tool-info ol {
    padding-left: 1.25rem;
    margin: 0;
  }

  .tool-info li {
    margin-bottom: var(--space-sm);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .tool-info a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tool-info a:hover {
    text-decoration: none;
  }

  @media (width <= 640px) {
    .page-header {
      flex-direction: column;
      text-align: center;
    }

    .page-header h1 {
      font-size: 1.5rem;
    }

    .subtitle {
      font-size: 0.9rem;
    }

    .tool-info {
      padding: var(--space-md);
    }
  }
</style>
