---
/**
 * Tool Page — EN route `/tools/[slug]/`.
 * Keeps getStaticPaths for route generation, delegates rendering to ToolPage.
 */
import ToolPage from "@components/pages/ToolPage.astro";
import { getToolsForLocale, type LocalizedTool } from "@utils/tools";

export async function getStaticPaths() {
  const entries = await getToolsForLocale("en");
  return entries.map(({ tool, isFallback }) => ({
    params: { slug: tool.data.slug },
    props: { tool, isFallback },
  }));
}

type Props = LocalizedTool;
const { tool } = Astro.props;
---

<ToolPage tool={tool} />
