---
/**
 * CSP Builder Tool Page.
 * Interactive Content Security Policy builder.
 */
import CSPBuilder from "@components/apps/CSPBuilder.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "CSP Policy Builder",
  description:
    "Interactive Content Security Policy builder. Toggle directives, see real-time policy generation, and get security ratings.",
  url: new URL("/tools/csp-builder/", getSiteUrl()).toString(),
  applicationCategory: "WebApplication",
  operatingSystem: "Web Browser",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<BaseLayout
  title="CSP Policy Builder"
  description="Build Content Security Policy headers interactively. Toggle directives, see real-time policy generation, and get security ratings for your CSP."
  schema={toolSchema}
>
  <div class="tool-page">
    <div class="content-wrapper">
      <nav
        class="breadcrumb"
        aria-label="Breadcrumb"
      >
        <a href="/tools/">Tools</a>
        <span
          class="i-mdi:chevron-right"
          aria-hidden="true"
        ></span>
        <span aria-current="page">CSP Builder</span>
      </nav>

      <header class="page-header">
        <div class="header-icon">
          <span
            class="i-mdi:shield-lock-outline"
            aria-hidden="true"
          ></span>
        </div>
        <div class="header-content">
          <h1>CSP Policy Builder</h1>
          <p class="subtitle">
            Build Content Security Policy headers interactively. Toggle
            directives to see your policy update in real-time.
          </p>
        </div>
      </header>

      <div class="tool-container">
        <CSPBuilder title="" />
      </div>

      <section class="tool-info">
        <h2>About This Tool</h2>
        <p>
          Content Security Policy (CSP) is a security standard that helps
          prevent cross-site scripting (XSS), clickjacking, and other code
          injection attacks. This builder helps you create a policy by selecting
          the directives you need.
        </p>

        <h3>Features</h3>
        <ul>
          <li><strong>20+ directives</strong> organized by category</li>
          <li>
            <strong>Quick presets</strong> for Google Fonts, Analytics, YouTube, and
            CDNs
          </li>
          <li>
            <strong>Custom domains</strong> — add your own URLs to any directive
          </li>
          <li>
            <strong>7 export formats</strong> — HTTP header, Nginx, Apache, Cloudflare,
            Netlify, Vercel, and meta tag
          </li>
          <li>
            <strong>Report-Only mode</strong> — test your policy before enforcing
          </li>
          <li>
            <strong>Security warnings</strong> — get recommendations for a stronger
            policy
          </li>
        </ul>

        <h3>How to Use</h3>
        <ol>
          <li>Enable the directives you need for your website</li>
          <li>Use quick presets to add common third-party services</li>
          <li>
            Add custom domains by clicking the <strong>+</strong> button on editable
            directives
          </li>
          <li>Select your server format (Nginx, Apache, Cloudflare, etc.)</li>
          <li>
            Enable <strong>Report-Only mode</strong> to test before enforcing
          </li>
          <li>Copy and add to your server configuration</li>
        </ol>

        <h3>Learn More</h3>
        <p>
          For a complete guide on implementing CSP, see <a
            href="/blog/003-implementing-content-security-policy-nginx/"
            >Implementing Content Security Policy in Nginx</a
          >.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .tool-page {
    min-height: calc(100vh - var(--header-height, 4rem) - 4rem);
    padding: var(--space-xl) 0;
  }

  .content-wrapper {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--max-width-container);
    padding: 0 var(--space-lg);
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin-bottom: var(--space-lg);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .breadcrumb span[class*="i-"] {
    width: 1rem;
    height: 1rem;
  }

  .page-header {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    margin-bottom: var(--space-xl);
  }

  .header-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background: linear-gradient(135deg, #10b981, #059669);
    border-radius: var(--radius-lg);
  }

  .header-icon span {
    width: 2rem;
    height: 2rem;
    color: #fff;
  }

  .header-content {
    flex: 1;
    min-width: 0;
  }

  .page-header h1 {
    margin-bottom: var(--space-xs);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .tool-container {
    margin-bottom: var(--space-xl);
  }

  .tool-info {
    max-width: 720px;
    padding: var(--space-lg);
    margin: 0 auto;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-lg);
  }

  .tool-info h2 {
    margin-bottom: var(--space-md);
    font-size: 1.25rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info h3 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    font-size: 1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info p {
    margin-bottom: var(--space-md);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .tool-info ol {
    padding-left: 1.25rem;
    margin: 0;
  }

  .tool-info ul {
    padding-left: 1.25rem;
    margin: 0;
  }

  .tool-info li {
    margin-bottom: var(--space-sm);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .tool-info a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tool-info a:hover {
    text-decoration: none;
  }

  @media (width <= 640px) {
    .page-header {
      flex-direction: column;
      text-align: center;
    }

    .page-header h1 {
      font-size: 1.5rem;
    }

    .subtitle {
      font-size: 0.9rem;
    }

    .tool-info {
      padding: var(--space-md);
    }
  }
</style>
