---
/**
 * HTTP Headers Analyzer Tool Page.
 */
import HTTPHeadersAnalyzer from "@components/apps/HTTPHeadersAnalyzer.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "HTTP Security Headers Analyzer",
  description:
    "Analyze HTTP security headers and get recommendations for improving your site's security posture.",
  url: new URL("/tools/http-headers-analyzer/", getSiteUrl()).toString(),
  applicationCategory: "WebApplication",
  operatingSystem: "Web Browser",
  offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
};
---

<BaseLayout
  title="HTTP Security Headers Analyzer"
  description="Analyze HTTP response headers for security best practices. Get a security score, recommendations, and detailed analysis for each header."
  schema={toolSchema}
>
  <div class="tool-page">
    <div class="content-wrapper">
      <nav
        class="breadcrumb"
        aria-label="Breadcrumb"
      >
        <a href="/tools/">Tools</a>
        <span
          class="i-mdi:chevron-right"
          aria-hidden="true"
        ></span>
        <span aria-current="page">Headers Analyzer</span>
      </nav>

      <header class="page-header">
        <div class="header-icon">
          <span
            class="i-mdi:web"
            aria-hidden="true"
          ></span>
        </div>
        <div class="header-content">
          <h1>HTTP Security Headers Analyzer</h1>
          <p class="subtitle">
            Analyze HTTP security headers and get a security score with detailed
            recommendations.
          </p>
        </div>
      </header>

      <div class="tool-container">
        <HTTPHeadersAnalyzer title="" />
      </div>

      <section class="tool-info">
        <h2>About This Tool</h2>
        <p>
          Paste your HTTP response headers to get a comprehensive security
          analysis. The tool checks for the presence and configuration of
          critical security headers and provides a score with recommendations.
        </p>
        <h3>Headers Analyzed</h3>
        <ul>
          <li>
            <strong>Content-Security-Policy</strong> — XSS and injection prevention
          </li>
          <li>
            <strong>Strict-Transport-Security</strong> — HTTPS enforcement
          </li>
          <li>
            <strong>X-Content-Type-Options</strong> — MIME sniffing prevention
          </li>
          <li><strong>X-Frame-Options</strong> — clickjacking protection</li>
          <li>
            <strong>Referrer-Policy</strong> — referrer information control
          </li>
          <li>
            <strong>Permissions-Policy</strong> — browser feature restrictions
          </li>
          <li><strong>Cross-Origin policies</strong> — COOP, CORP, COEP</li>
        </ul>
        <h3>How to Use</h3>
        <ol>
          <li>
            Copy your HTTP response headers (from browser DevTools or curl)
          </li>
          <li>Paste them in the input field</li>
          <li>Click Analyze to see the security score and recommendations</li>
        </ol>
        <h3>Learn More</h3>
        <p>
          See <a href="/blog/003-implementing-content-security-policy-nginx/"
            >Implementing CSP in Nginx</a
          > for a detailed guide on security headers.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .tool-page {
    min-height: calc(100vh - var(--header-height, 4rem) - 4rem);
    padding: var(--space-xl) 0;
  }

  .content-wrapper {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--max-width-container);
    padding: 0 var(--space-lg);
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin-bottom: var(--space-lg);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .breadcrumb span[class*="i-"] {
    width: 1rem;
    height: 1rem;
  }

  .page-header {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    margin-bottom: var(--space-xl);
  }

  .header-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background: linear-gradient(
      135deg,
      var(--color-success, #10b981),
      var(--color-success-dark, #059669)
    );
    border-radius: var(--radius-lg);
  }

  .header-icon span {
    width: 2rem;
    height: 2rem;
    color: var(--header-icon-color, #fff);
  }

  .header-content {
    flex: 1;
    min-width: 0;
  }

  .page-header h1 {
    margin-bottom: var(--space-xs);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .tool-container {
    margin-bottom: var(--space-xl);
  }

  .tool-info {
    max-width: 720px;
    padding: var(--space-lg);
    margin: 0 auto;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-lg);
  }

  .tool-info h2 {
    margin-bottom: var(--space-md);
    font-size: 1.25rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info h3 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    font-size: 1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info p {
    margin-bottom: var(--space-md);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .tool-info ul,
  .tool-info ol {
    padding-left: 1.25rem;
    margin: 0;
  }

  .tool-info li {
    margin-bottom: var(--space-sm);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .tool-info a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tool-info a:hover {
    text-decoration: none;
  }

  @media (width <= 640px) {
    .page-header {
      flex-direction: column;
      text-align: center;
    }

    .page-header h1 {
      font-size: 1.5rem;
    }

    .subtitle {
      font-size: 0.9rem;
    }

    .tool-info {
      padding: var(--space-md);
    }
  }
</style>
