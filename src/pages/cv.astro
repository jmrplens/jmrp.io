---
/**
 * CV Page.
 * Displays curriculum vitae data loaded from `src/content/cv/main.yaml`.
 * Renders sections dynamically using specific components (SkillGroup, CertificateGroup) or generic map/timeline layouts.
 */
import "@styles/skills.css";

import CertificateGroup from "@components/cv/CertificateGroup.astro";
import SkillGroup from "@components/cv/SkillGroup.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { CVSection } from "@src/types";
import { getCVData } from "@utils/cv";
import { sanitize, stripHtml } from "@utils/html";
import { getSiteUrl } from "@utils/site";
import { Icon } from "astro-icon/components";

const cvData = await getCVData();

// Define the section order
const sectionOrder = [
  "General Information",
  "Experience",
  "Technical Skills",
  "Formal education",
  "Certificates",
];

// Build a lookup Map from cvData to avoid multiple .find() calls
const sectionLookup = new Map<string, CVSection>(
  cvData.map((s) => [s.title, s]),
);

// Get sorted sections in defined order
const sortedSections = sectionOrder
  .map((title) => sectionLookup.get(title))
  .filter((s): s is CVSection => !!s);

// Extract specific sections from the lookup (single pass, no redundant .find())
const technicalSkills = sectionLookup.get("Technical Skills");
const formalEducation = sectionLookup.get("Formal education");
const experience = sectionLookup.get("Experience");
const certificates = sectionLookup.get("Certificates");

const personSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": new URL(
    "#profile",
    new URL(Astro.url.pathname, getSiteUrl()),
  ).toString(),
  mainEntity: {
    "@type": "Person",
    name: "José Manuel Requena Plens",
    jobTitle: "R&D Engineer",
    description:
      "R&D Engineer specializing in software development, cloud infrastructure, and security.",
    url: "https://jmrp.io",
    image: "https://jmrp.io/assets/mehome.webp",
    sameAs: [
      "https://github.com/jmrplens",
      "https://mstdn.jmrp.io/@jmrplens",
      "https://www.linkedin.com/in/jmrplens",
    ],
    worksFor: {
      "@type": "Organization",
      name: "Power Electronics",
    },
    knowsAbout:
      technicalSkills?.type === "list_groups"
        ? technicalSkills.contents.flatMap((g) => g.items.map((i) => i.name))
        : [],
    alumniOf:
      formalEducation?.type === "time_table"
        ? formalEducation.contents.map((edu) => ({
            "@type": "EducationalOrganization",
            name: edu.institution ? stripHtml(edu.institution) : undefined,
            department: edu.department ? stripHtml(edu.department) : undefined,
          }))
        : [],
    hasOccupation:
      experience?.type === "time_table"
        ? experience.contents.map((job) => ({
            "@type": "Occupation",
            name: job.title,
            description: job.summary ? stripHtml(job.summary) : undefined,
          }))
        : [],
    hasCredential:
      certificates?.type === "certificate_list"
        ? certificates.contents.flatMap((group) =>
            group.items.map((cert) => ({
              "@type": "EducationalOccupationalCredential",
              name: cert.name,
              credentialCategory: group.category,
              recognizedBy: {
                "@type": "Organization",
                name: cert.school,
              },
              url: cert.link,
            })),
          )
        : [],
  },
};
---

<BaseLayout
  title="CV"
  description="Curriculum Vitae"
  type="profile"
  schema={personSchema}
>
  <div class="container">
    <h1 class="page-title cv-title">Curriculum Vitae</h1>

    <nav
      class="cv-toc"
      aria-label="Table of Contents"
    >
      <ul>
        <li><a href="#general-information">General</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#technical-skills">Skills</a></li>
        <li><a href="#formal-education">Education</a></li>
        <li><a href="#certificates">Certificates</a></li>
      </ul>
    </nav>

    {
      sortedSections.map((section) => (
        <section
          class="cv-section"
          id={section.title
            .toLowerCase()
            .replaceAll(/[^a-z0-9\s-]/g, "")
            .trim()
            .replaceAll(/\s+/g, "-")}
          aria-label={section.title}
        >
          <div class="section-header">
            <h2>{section.title}</h2>
          </div>

          {section.type === "map" && (
            <div class="cv-map">
              {section.contents.map((item) => (
                <div class="map-item">
                  <span class="map-key">{item.name}:</span>
                  {item.value && <span class="map-value">{item.value}</span>}
                  {item.links && (
                    <div class="map-links">
                      {item.links.map((link) => (
                        <a
                          href={link.link}
                          class="btn btn-sm btn-outline"
                          download={link.download || undefined}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.name}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}

          {section.type === "time_table" && (
            <div class="timeline">
              {section.contents.map((item) => (
                <article class="timeline-item">
                  <div
                    class="timeline-marker"
                    aria-hidden="true"
                  />
                  <div class="timeline-content">
                    <header class="timeline-header">
                      <h3 class="item-title">{item.title}</h3>
                      <span class="item-year">{item.year}</span>
                    </header>

                    {item.institution && (
                      <div
                        class="item-institution"
                        set:html={sanitize(item.institution)}
                      />
                    )}
                    {item.department && (
                      <div
                        class="item-department"
                        set:html={sanitize(item.department)}
                      />
                    )}
                    {item.location && (
                      <div class="item-location">
                        <Icon name="fa-solid:map-marker-alt" /> {item.location}
                      </div>
                    )}

                    {item.summary && (
                      <div
                        class="item-summary"
                        set:html={sanitize(item.summary)}
                      />
                    )}

                    {item.description && Array.isArray(item.description) && (
                      <ul class="item-description-list">
                        {item.description.map((desc) => {
                          if (typeof desc === "string")
                            return (
                              <li>
                                <div set:html={sanitize(desc)} />
                              </li>
                            );
                          if (desc.title && Array.isArray(desc.contents)) {
                            // Nested contents in description
                            return (
                              <li>
                                <strong>{desc.title}</strong>
                                <ul>
                                  {desc.contents.map((sub: string) => (
                                    <li>
                                      <div set:html={sanitize(sub)} />
                                    </li>
                                  ))}
                                </ul>
                              </li>
                            );
                          }
                          return null;
                        })}
                      </ul>
                    )}

                    {item.linkitems && (
                      <div class="item-links">
                        {item.linkitems.map((link) => (
                          <a
                            href={link.link}
                            class="btn btn-sm"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={link.ariaLabel}
                          >
                            <Icon name="fa-solid:file-pdf" />
                            {link.linkname}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
          )}

          {section.type === "list_groups" && (
            <div class="grid-layout">
              {section.contents.map((group) => (
                <SkillGroup group={group} />
              ))}
            </div>
          )}

          {section.type === "certificate_list" && (
            <div class="grid-layout">
              {section.contents.map((group) => (
                <CertificateGroup group={group} />
              ))}
            </div>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .cv-title {
    margin-bottom: var(--space-md);
  }

  /* Table of Contents */
  .cv-toc {
    /* Safari support */
    position: sticky;
    top: calc(var(--header-height) + 1rem);
    z-index: 100;
    width: fit-content;
    padding: var(--space-sm) var(--space-md);
    margin-bottom: var(--space-2xl);
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
  }

  .cv-toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cv-toc a {
    font-size: 0.9rem;
    font-weight: var(--fw-medium);
    color: var(--color-text);
    text-decoration: none;
  }

  .cv-toc a:hover {
    color: var(--color-primary);
  }

  /* Section Styling */
  .cv-section {
    margin-bottom: var(--space-3xl);
    scroll-margin-top: 140px; /* Offset for sticky header/toc */
  }

  .section-header {
    margin-bottom: var(--space-lg);
    border-bottom: 2px solid var(--color-border);
  }

  .cv-section h2 {
    display: inline-block;
    padding-bottom: var(--space-sm);
    margin-bottom: -2px; /* Overlap border */
    border-bottom: 2px solid var(--color-primary);
  }

  /* Map Type */
  .cv-map {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .map-item {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    align-items: baseline;
    font-size: 1.05rem;
  }

  .map-key {
    font-weight: var(--fw-bold);
    color: var(--color-text);
  }

  .map-value {
    color: var(--color-text-offset);
  }

  .map-links {
    display: inline-flex;
    gap: var(--space-sm);
  }

  /* Time Table (Timeline) */
  .timeline {
    position: relative;
    padding-left: var(--space-lg);
    border-left: 2px solid var(--color-border);
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-xl);
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    top: 24px; /* Align with card top content */
    left: calc(-1 * var(--space-lg) - 7px);
    z-index: 10;
    width: 12px;
    height: 12px;
    background-color: var(--color-bg);
    border: 2px solid var(--color-primary);
    border-radius: 50%;
  }

  .timeline-content {
    position: relative;
    padding: var(--space-lg);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      transform 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .timeline-content:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  /* Arrow logic */
  .timeline-content::before {
    position: absolute;
    top: 22px;
    left: -6px;
    width: 12px;
    height: 12px;
    content: "";
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    transform: rotate(45deg);
    transition: border-color 0.2s;
  }

  .timeline-content:hover::before {
    border-bottom-color: var(--color-primary);
    border-left-color: var(--color-primary);
  }

  .timeline-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .item-title {
    margin: 0;
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .item-year {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: var(--fw-medium);
    color: var(--color-primary);
  }

  .item-institution,
  .item-department {
    font-size: 1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
  }

  .item-location {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-top: var(--space-xs);
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .item-summary {
    margin-top: var(--space-md);
    line-height: 1.6;
    color: var(--color-text-offset);
  }

  .item-description-list {
    padding-left: var(--space-lg);
    margin-top: var(--space-sm);
    color: var(--color-text-offset);
  }

  .item-description-list li {
    margin-bottom: var(--space-xs);
  }

  .item-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  /* Grid Layouts for Skills/Certs */
  .grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
    align-items: start;
  }

  /* Responsive */
  @media (width <= 768px) {
    .cv-toc {
      width: 100%;
      overflow-x: auto;
    }

    .cv-toc ul {
      flex-wrap: nowrap;
    }

    .timeline-header {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
