---
/**
 * GitHub Repositories Page.
 * Displays GitHub repositories using SSG + Islands architecture.
 * Profile and top 12 repos are fetched at build time for optimal performance.
 * Search functionality is client-side only (no API calls).
 */
import githubAvatar from "@assets/github-avatar.png";
import GitHubSearch from "@components/github/GitHubSearch.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { fetchGitHubProfile, fetchTopRepositories } from "@utils/github";
import { getImage, Image } from "astro:assets";

const profile = await fetchGitHubProfile();
const repos = await fetchTopRepositories(12); // Top 12 most recently updated

const avatarSrcSetResolves = await Promise.all(
  [60, 120, 240].map(async (w) => {
    const img = await getImage({
      src: githubAvatar,
      format: "webp",
      width: w,
      height: w,
    });
    return `${img.src} ${w}w`;
  }),
);

const avatarSrcSetString = avatarSrcSetResolves.join(", ");
---

<BaseLayout
  title="GitHub Repositories"
  description="My Open Source Contributions"
>
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset={avatarSrcSetString}
    imagesizes="(max-width: 768px) 120px, 240px"
    fetchpriority="high"
  />
  <div class="github-page container">
    <h1 class="page-title">GitHub Repositories</h1>

    <div class="profile-header">
      <div class="profile-avatar">
        <Image
          src={githubAvatar}
          alt={profile.name ?? "GitHub avatar"}
          width="120"
          height="120"
          widths={[60, 120, 240]}
          sizes="(max-width: 768px) 120px, 240px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="profile-info">
        <h2>{profile.name ?? profile.login ?? "GitHub user"}</h2>
        <a
          href={profile.html_url}
          class="username"
          target="_blank"
          rel="noopener noreferrer"
        >
          @{profile.login}
        </a>
        <p class="bio">{profile.bio || "Open Source Enthusiast"}</p>
        <div class="profile-stats">
          <div class="stat">
            <strong>{(profile.public_repos ?? 0).toLocaleString()}</strong>
            <span> Repositories</span>
          </div>
          <div class="stat">
            <strong>{(profile.followers ?? 0).toLocaleString()}</strong>
            <span> Followers</span>
          </div>
          <div class="stat">
            <strong>{(profile.following ?? 0).toLocaleString()}</strong>
            <span> Following</span>
          </div>
        </div>
        {
          profile.location && (
            <p class="location">
              <span
                class="i-fa-solid:map-marker-alt"
                aria-hidden="true"
              />{" "}
              {profile.location}
            </p>
          )
        }
      </div>
    </div>

    <GitHubSearch initialRepos={repos} />
  </div>
</BaseLayout>

<style>
  .page-title {
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-lg);
    border-bottom: var(--border-2);
  }

  /* Profile Header */
  .profile-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: center;
    max-width: 100%;
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
    overflow: hidden;
    text-align: center;
    background-color: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-lg);
  }

  /* Responsive Profile: Grid on Desktop */
  @media (width >= 768px) {
    .profile-header {
      flex-direction: row;
      gap: var(--space-xl);
      align-items: flex-start;
      text-align: left;
    }

    .profile-stats {
      justify-content: flex-start;
    }

    .location {
      justify-content: flex-start;
    }
  }

  /* Profile Elements */
  .profile-avatar img {
    width: 120px;
    max-width: 100%;
    height: 120px;
    object-fit: cover;
    border: 3px solid var(--color-primary);
    border-radius: 50%;
  }

  .profile-info {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .profile-info h2 {
    margin: 0;
    font-size: 1.8rem;
    overflow-wrap: anywhere;
  }

  .profile-info .username {
    display: block;
    margin-bottom: 8px;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .profile-info .bio {
    max-width: 100%;
    min-height: 1.5em; /* Stabilize for CLS */
    margin-bottom: 16px;
    overflow-wrap: anywhere;
  }

  .profile-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
    max-width: 100%;
    min-height: 1.5em; /* Stabilize for CLS */
    margin-top: var(--space-md);
    overflow-wrap: anywhere;
  }

  .stat strong {
    font-weight: var(--fw-bold);
    color: var(--color-text);
  }

  .stat span {
    color: var(--color-text-muted);
  }

  .stat {
    display: flex;
    gap: 4px;
    align-items: center;
    min-height: 1.5em; /* Stabilize for micro-CLS */
  }

  .location {
    display: flex;
    gap: var(--space-xs); /* 6px */
    align-items: center;
    justify-content: center;
    margin-top: 12px;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
