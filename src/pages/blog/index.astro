---
/**
 * Blog Index Page.
 * Lists all published blog posts, sorted by date (newest first).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import PostGrid from "@components/blog/PostGrid.astro";
import TagCloud from "@components/blog/TagCloud.astro";

const posts = (await getCollection("posts"))
    .filter((post) => !post.data.draft)
    .sort(
        (a, b) =>
            b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
    );

// Optimize LCP image for preload
const lcpPost = posts[0];
let lcpImagePreload = null;

if (lcpPost && lcpPost.data.coverImage) {
    const optimizedLcp = await getImage({
        src: lcpPost.data.coverImage,
        format: "webp",
        width: 400,
        height: 225,
        widths: [360, 480, 640, 720, 960, 1200],
        quality: 60,
    });
    lcpImagePreload = {
        href: optimizedLcp.src,
        imagesrcset: optimizedLcp.attributes.srcset,
        imagesizes: "(max-width: 640px) 100vw, 400px",
    };
}
---

<BaseLayout
    title="Blog"
    description="Writing about software development, home lab, and engineering."
>
    {
        lcpImagePreload && (
            <link
                slot="head"
                rel="preload"
                as="image"
                href={lcpImagePreload.href}
                imagesrcset={lcpImagePreload.imagesrcset}
                imagesizes={lcpImagePreload.imagesizes}
                fetchpriority="high"
            />
        )
    }
    <div class="content-wrapper">
        <header class="page-header">
            <h1 class="gradient-text">Blog</h1>
            <p class="subtitle">Thoughts, tutorials, and engineering notes.</p>
        </header>

        <div class="blog-layout">
            <main>
                <PostGrid posts={posts} />
            </main>
            <aside>
                <TagCloud />
            </aside>
        </div>
    </div>
</BaseLayout>

<style>
    .content-wrapper {
        max-width: var(--max-width-container);
        margin: 0 auto;
        padding: 4rem 2rem;
        width: 100%;
    }

    .page-header {
        margin-bottom: 4rem;
        text-align: center;
    }

    .page-header h1 {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
    }

    .gradient-text {
        color: var(--color-primary);
    }

    .subtitle {
        font-size: 1.25rem;
        color: var(--color-text-muted);
    }

    .blog-layout {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 3rem;
        align-items: start;
    }

    @media (max-width: 900px) {
        .page-header {
            margin-bottom: 1rem;
        }
        .blog-layout {
            grid-template-columns: 1fr;
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        aside {
            order: -1;
            width: 100%;
            position: sticky;
            top: 0;
            z-index: 10;
        }
    }

    @media (max-width: 640px) {
        .content-wrapper {
            padding: 2rem 1rem;
        }

        .page-header h1 {
            font-size: 2.5rem;
        }
    }
</style>
