---
/**
 * Blog Index Page.
 * Lists all published blog posts, sorted by date (newest first).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import PostGrid from "@components/blog/PostGrid.astro";
import TagCloud from "@components/blog/TagCloud.astro";

import "@styles/blog.css";

const posts = (await getCollection("posts"))
    .filter((post) => !post.data.draft)
    .sort(
        (a, b) =>
            b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
    );

// Optimize LCP image for preload
const lcpPost = posts[0];
let lcpImagePreload = null;

if (lcpPost && lcpPost.data.coverImage) {
    const optimizedLcp = await getImage({
        src: lcpPost.data.coverImage,
        format: "webp",
        width: 400,
        height: 225,
        widths: [360, 480, 640, 720, 960, 1200],
        quality: 60,
    });
    lcpImagePreload = {
        href: optimizedLcp.src,
        imagesrcset: optimizedLcp.attributes.srcset,
        imagesizes: "(max-width: 640px) 100vw, 400px",
    };
}

// Schema.org: CollectionPage with ItemList for Blog Index
const schema = {
  "@type": "CollectionPage",
  name: "Blog - José Manuel Requena Plens",
  description: "Thoughts, tutorials, and engineering notes on software development and home lab.",
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  mainEntity: {
    "@type": "ItemList",
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/blog/${post.slug}/`, Astro.site).toString(),
      name: post.data.title,
    })),
  },
};
---

<BaseLayout
    title="Blog"
    description="Writing about software development, home lab, and engineering."
    schema={schema}
>
    {
        lcpImagePreload && (
            <link
                slot="head"
                rel="preload"
                as="image"
                href={lcpImagePreload.href}
                imagesrcset={lcpImagePreload.imagesrcset}
                imagesizes={lcpImagePreload.imagesizes}
                fetchpriority="high"
            />
        )
    }
    <div class="content-wrapper">
        <header class="page-header">
            <h1 class="gradient-text">Blog</h1>
            <p class="subtitle">Thoughts, tutorials, and engineering notes.</p>
        </header>

        <div class="blog-layout">
            <div class="posts-container">
                <PostGrid posts={posts} />
            </div>
            <aside>
                <TagCloud />
            </aside>
        </div>
    </div>
</BaseLayout>
