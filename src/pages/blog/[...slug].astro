---
/**
 * Blog Post Page ([...slug].astro).
 * Renders individual blog posts dynamically based on their slug.
 * Includes support for:
 * - Custom components (Callout, CodeTabs, YouTube) in MDX
 * - Automated Table of Contents generation
 * - SEO Schema for blog postings
 */
import { type CollectionEntry, getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import Callout from "@components/ui/Callout.astro";
import Tabs from "@components/ui/Tabs.astro";
import TabPanel from "@components/ui/TabPanel.astro";
import YouTube from "@components/ui/YouTube.astro";
import Code from "@components/ui/Code.astro";
import TableOfContentsDrawer from "@components/layout/TableOfContentsDrawer.astro";
import References from "@components/ui/References.astro";
import "@styles/blog.css";

import { getEntry } from "astro:content";
import type { SiteConfig } from "@src/types";

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

export async function getStaticPaths() {
    const posts = await getCollection("posts");
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: post,
    }));
}

type Props = CollectionEntry<"posts">;

const post = Astro.props;
const { Content, headings } = await post.render();

// --- Reference Collection Logic ---
// Regex to find all markdown links: [text](url)
const linkRegex = /\[([^\]]+)\]\((https?:\/\/[^\)]+)\)/g;
const collectedRefsFromMarkdown = [];
let match;
while ((match = linkRegex.exec(post.body)) !== null) {
    collectedRefsFromMarkdown.push({ text: match[1], url: match[2] });
}

// Also find raw <a> tags in the body, as MDX allows HTML
const htmlLinkRegex =
    /<a\s+(?:[^>]*?\s+)?href="(https?:\/\/[^"]*)"[^>]*>([\s\S]*?)<\/a>/gi;
while ((match = htmlLinkRegex.exec(post.body)) !== null) {
    const url = match[1];
    // Sanitize inner HTML to get a readable text version
    const rawText = match[2];
    const text = rawText
        .replace(/<[^>]+>/g, " ")
        .replace(/\s+/g, " ")
        .trim();
    if (text) {
        collectedRefsFromMarkdown.push({ text, url });
    }
}

// Combine frontmatter references with collected ones and deduplicate
// Combine collected references and deduplicate
const allPostReferences = [...collectedRefsFromMarkdown];
const uniqueUrls = new Set<string>();
const finalReferences = allPostReferences.filter((ref) => {
    if (!uniqueUrls.has(ref.url)) {
        uniqueUrls.add(ref.url);
        return true;
    }
    return false;
});
// --- End of Reference Logic ---

// --- Image Optimization (JSON-LD) ---
import { getImage } from "astro:assets";

let jsonLdImage = "/default-blog-cover.webp";

if (post.data.coverImage) {
    // Optimize for JSON-LD schema
    const optimizedImage = await getImage({
        src: post.data.coverImage,
        format: "webp",
        width: 1200,
        height: 675,
        quality: 60,
    });

    jsonLdImage = optimizedImage.src;
}

const articleSchema = [
    {
        "@type": "BlogPosting",
        "@id":
            new URL(`/blog/${post.slug}`, Astro.site).toString() + "#article",
        headline: post.data.title,
        description: post.data.description,
        datePublished: post.data.publishedDate.toISOString(),
        dateModified: (
            post.data.updatedDate || post.data.publishedDate
        ).toISOString(),
        author: {
            "@type": "Person",
            "@id": `${Astro.site}/#person`,
            name: siteData.author,
            url: Astro.site,
        },
        publisher: {
            "@type": "Person",
            "@id": `${Astro.site}/#person`,
            name: siteData.author,
            url: Astro.site,
        },
        image: new URL(jsonLdImage, Astro.site).toString(),
        mainEntityOfPage: {
            "@type": "WebPage",
            "@id": new URL(`/blog/${post.slug}`, Astro.site).toString(),
        },
    },
];
---

<BaseLayout
    title={post.data.title}
    description={post.data.description}
    type="article"
    image={post.data.coverImage?.src}
    publishDate={post.data.publishedDate}
    modifiedDate={post.data.updatedDate}
    tags={post.data.tags}
    schema={articleSchema}
>
    <article class="post-content">
        <header class="post-header">
            <div class="content-wrapper">
                <div class="header-meta">
                    <a href="/blog" class="back-link">
                        <Icon name="mdi:arrow-left" /> Back to Blog
                    </a>
                    <div class="meta">
                        <span class="author">
                            {post.data.author || siteData.author}
                        </span>
                        <span class="separator">•</span>
                        <time datetime={post.data.publishedDate.toISOString()}>
                            {
                                post.data.publishedDate.toLocaleDateString(
                                    "en-US",
                                    {
                                        year: "numeric",
                                        month: "long",
                                        day: "numeric",
                                    },
                                )
                            }
                        </time>
                        <span class="separator">•</span>
                        {
                            post.data.tags && (
                                <div class="tags">
                                    {post.data.tags.map((tag) => (
                                        <a
                                            href={`/blog/tags/${encodeURIComponent(tag)}`}
                                            class="tag"
                                        >
                                            #{tag}
                                        </a>
                                    ))}
                                </div>
                            )
                        }
                    </div>
                </div>

                <div class="header-grid">
                    <div class="header-content">
                        <h1>{post.data.title}</h1>
                        <p class="lead">{post.data.description}</p>
                    </div>
                    {
                        post.data.coverImage && (
                            <div class="cover-image-container">
                                <Image
                                    src={post.data.coverImage}
                                    alt={`Cover image for ${post.data.title}`}
                                    class="cover-image"
                                    width={1200}
                                    height={675}
                                    format="webp"
                                    loading="eager"
                                    fetchpriority="high"
                                    widths={[
                                        360, 480, 540, 600, 720, 840, 960, 1080,
                                        1200,
                                    ]}
                                    sizes="(max-width: 768px) calc(100vw - 2.5rem), (max-width: 1024px) 600px, 600px"
                                    quality={70}
                                    style="width: 100%; height: auto; aspect-ratio: 16/9;"
                                />
                            </div>
                        )
                    }
                </div>
            </div>
        </header>

        <div class="layout-grid content-wrapper">
            <div class="prose">
                <Content
                    components={{ Callout, Tabs, TabPanel, YouTube, Code }}
                />
                <References references={finalReferences} />
            </div>
        </div>
    </article>

    <TableOfContentsDrawer headings={headings} />
</BaseLayout>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        // Accessibility: Fix duplicate role="region" on code blocks
        // We use requestIdleCallback to avoid forced reflows during initial layout
        // caused by reading/writing DOM concurrently with scripts.
        const rIC = window.requestIdleCallback || ((cb) => setTimeout(cb, 50));

        const applyLabels = () => {
            rIC(() => {
                const codeBlocks = document.querySelectorAll(
                    'pre[role="region"]:not([aria-label])',
                );
                codeBlocks.forEach((block, index) => {
                    const lang = block.getAttribute("data-language") || "Code";
                    block.setAttribute(
                        "aria-label",
                        `${lang} example ${index + 1}`,
                    );
                });
            });
        };

        // Run once initially, but slightly deferred
        setTimeout(applyLabels, 100);

        // Debounced observer for hydration changes
        const prose = document.querySelector(".prose");
        if (prose) {
            let timeout;
            const observer = new MutationObserver(() => {
                clearTimeout(timeout);
                timeout = setTimeout(applyLabels, 300);
            });
            observer.observe(prose, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ["role"],
            });
        }
    });

    // Add copy buttons to standalone code blocks
    // Only for blocks not inside FileContent, Tabs, or CompareCode components
    document.addEventListener("DOMContentLoaded", () => {
        const proseContent = document.querySelector(".prose");
        if (!proseContent) return;

        // Find all Shiki code blocks
        const codeBlocks = proseContent.querySelectorAll(".astro-code");

        codeBlocks.forEach((block) => {
            // Skip if already inside a special component
            if (
                block.closest(".file-content-wrapper") ||
                block.closest(".tab-panel") ||
                block.closest(".compare-block")
            ) {
                return; // Already handled by component
            }

            // Check if we already added our button
            if (block.querySelector(".custom-code-copy-btn")) {
                return; // Already processed
            }

            // Create our custom copy button
            const copyButton = document.createElement("button");
            copyButton.className = "custom-code-copy-btn";
            copyButton.setAttribute("aria-label", "Copy to clipboard");

            const svgNS = "http://www.w3.org/2000/svg";

            // Create copy icon
            const copyIcon = document.createElementNS(svgNS, "svg");
            copyIcon.setAttribute("class", "copy-icon");
            copyIcon.setAttribute("width", "20");
            copyIcon.setAttribute("height", "20");
            copyIcon.setAttribute("viewBox", "0 0 24 24");
            const copyPath = document.createElementNS(svgNS, "path");
            copyPath.setAttribute("fill", "currentColor");
            copyPath.setAttribute(
                "d",
                "M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z",
            );
            copyIcon.appendChild(copyPath);

            // Create success icon
            const successIcon = document.createElementNS(svgNS, "svg");
            successIcon.setAttribute("class", "success-icon hidden");
            successIcon.setAttribute("width", "20");
            successIcon.setAttribute("height", "20");
            successIcon.setAttribute("viewBox", "0 0 24 24");
            const successPath = document.createElementNS(svgNS, "path");
            successPath.setAttribute("fill", "currentColor");
            successPath.setAttribute(
                "d",
                "M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z",
            );
            successIcon.appendChild(successPath);

            copyButton.appendChild(copyIcon);
            copyButton.appendChild(successIcon);

            // Add click handler
            copyButton.addEventListener("click", () => {
                // Usually pre > code.
                let codeElement = block.querySelector("code");
                if (!codeElement && block.tagName === "PRE") {
                    codeElement = block.querySelector("code");
                }

                // For Shiki, sometimes the text is inside span lines. textContent usually works fine on the whole code block.
                const text = codeElement
                    ? codeElement.textContent
                    : block.textContent;

                if (!text) {
                    console.warn("No code element found in block.");
                    return;
                }

                navigator.clipboard.writeText(text).then(
                    () => {
                        copyIcon.classList.add("hidden");
                        successIcon.classList.remove("hidden");

                        setTimeout(() => {
                            copyIcon.classList.remove("hidden");
                            successIcon.classList.add("hidden");
                        }, 2000);
                    },
                    (err) => {
                        console.error("Failed to copy:", err);
                    },
                );
            });

            // Make the block relative for positioning
            if (block instanceof HTMLElement) {
                // If it's a pre tag (Shiki), make it relative.
                block.style.position = "relative";
            }

            // Add the button to the block
            block.appendChild(copyButton);
        });
    });
</script>

<style>
    .post-header {
        padding: var(--space-lg) 0;
        background-color: var(--color-bg-secondary);
        margin-bottom: var(--space-md-lg);
        border-bottom: var(--border-1);
    }

    .content-wrapper {
        max-width: var(--max-width-container);
        margin: 0 auto;
        padding: 0 var(--space-lg);
        width: 100%;
    }

    .header-grid {
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
    }

    /* New container for top metadata */
    .header-meta {
        margin-bottom: var(--space-lg);
    }

    .header-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .meta {
        display: flex;
        align-items: center;
        gap: var(--space-md);
        color: var(--color-text-muted);
        font-size: 0.9rem;
        /* margin-bottom removed, handled by container */
        flex-wrap: wrap;
        min-height: 1.5em;
    }

    .author {
        font-weight: var(--fw-semibold);
        color: var(--color-text-body);
    }

    .separator {
        opacity: 0.5;
    }

    h1 {
        font-size: 2.5rem;
        line-height: 1.1;
        font-weight: 800;
        color: var(--color-text-heading);
        margin-bottom: 1.25rem;
        letter-spacing: -0.02em;
    }

    .lead {
        font-size: 1.25rem;
        color: var(--color-text-body);
        line-height: 1.6;
        opacity: 0.9;
    }

    .cover-image-container {
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-lg);
        background-color: var(--color-bg-secondary);
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
    }

    .cover-image {
        width: 100%;
        height: auto;
        object-fit: cover;
        display: block;
        aspect-ratio: 16 / 9;
    }

    /* Desktop Split Layout */
    @media (min-width: 1024px) {
        .post-header {
            padding: var(--space-lg-xl) 0;
        }

        .header-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: var(--space-xl);
            align-items: center;
        }

        h1 {
            font-size: 3.5rem;
        }

        .cover-image-container {
            /* Reset any margins */
            margin: 0;
            /* Allow image to take natural height based on aspect ratio */
            height: auto;
            max-height: none;
            max-width: none;
        }
    }

    /* Tablet/Mobile Adjustments */
    @media (max-width: 1024px) {
        .cover-image-container {
            margin-top: var(--space-md-lg);
            order: 2;
            /* Constrain width so it doesn't become huge when stacked */
            max-width: 600px;
            /* Center the image */
            margin-left: auto;
            margin-right: auto;
        }
    }

    @media (max-width: 768px) {
        .post-header {
            padding: var(--space-lg) 0;
            text-align: left;
        }

        h1 {
            font-size: 2rem;
        }

        .lead {
            font-size: 1.125rem;
        }

        .content-wrapper {
            padding: 0 1.25rem;
        }

        .cover-image-container {
            /* On very small screens, let it be full width again if needed,
               but 600px max-width usually covers it nicely. */
            width: 100%;
        }
    }

    /* Custom copy button for standalone code blocks */
    :global(.custom-code-copy-btn) {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        background-color: var(--color-bg-subtle, rgba(255, 255, 255, 0.1));
        border: var(--border-1, 1px solid rgba(255, 255, 255, 0.1));
        border-radius: 4px;
        padding: 0.3rem 0.5rem;
        cursor: pointer;
        opacity: 0.8;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        min-height: 32px;
        z-index: 10;
    }

    :global(.custom-code-copy-btn:hover) {
        opacity: 1;
        background-color: var(--color-bg-secondary, #222);
    }

    :global(.custom-code-copy-btn:active) {
        transform: scale(0.95);
    }

    :global(.custom-code-copy-btn .copy-icon),
    :global(.custom-code-copy-btn .success-icon) {
        width: 1.2rem;
        height: 1.2rem;
        color: var(--color-text-muted, #888);
        display: block;
    }

    :global(.custom-code-copy-btn .success-icon) {
        color: var(--color-success, #2ea043);
    }

    :global(.custom-code-copy-btn .hidden) {
        display: none;
    }
</style>
