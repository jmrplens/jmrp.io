---
/**
 * Blog Post Page — EN route `/blog/[slug]/`.
 * Keeps getStaticPaths for route generation, delegates rendering to BlogPost.
 */
import BlogPost from "@components/pages/BlogPost.astro";
import { getPostsForLocale, type LocalizedPost } from "@utils/blog";

export async function getStaticPaths() {
  const entries = await getPostsForLocale("en");
  return entries.map(({ post, isFallback }) => ({
    params: { slug: post.data.slug },
    props: { post, isFallback },
  }));
}

type Props = LocalizedPost;
const { post, isFallback } = Astro.props;
---

<BlogPost
  post={post}
  isFallback={isFallback}
/>
