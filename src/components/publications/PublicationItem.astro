---
import CopyButton from "@components/ui/CopyButton.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import { sanitize } from "@utils/html";
import {
  getPublicationKind,
  PUBLICATION_KIND_LABEL_KEY,
} from "@utils/publications";

const { pub } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Coarse display kind (journal / conference / thesis / other) → coloured chip.
const kind = getPublicationKind(pub.type);
const chipLabel = t(PUBLICATION_KIND_LABEL_KEY[kind]);

// Function to clean BibTeX
const cleanBibtex = (bibtex: string) => {
  if (!bibtex) return "";
  const lines = bibtex.split("\n");
  const cleaned = lines.filter((line: string) => {
    const l = line.trim().toLowerCase();
    return (
      !l.startsWith("file") &&
      !l.startsWith("abstract") &&
      !l.startsWith("keywords") &&
      !l.startsWith("doi") &&
      !l.startsWith("url") &&
      !l.startsWith("pdf") &&
      !l.startsWith("slides") &&
      !l.startsWith("poster") &&
      !l.startsWith("bibtex_show")
    );
  });
  return cleaned.join("\n");
};

// Data Formatting
const authors = pub.author || [];

const venue =
  pub["container-title"] ||
  pub.publisher ||
  pub.school ||
  pub.institution ||
  "";
const venue_short = pub["container-title-short"] || "";

const url = pub.url || pub.URL || "";
const rawDoi = pub.doi || pub.DOI || "";
const doi =
  rawDoi && !rawDoi.startsWith("http")
    ? `https://doi.org/${rawDoi.replace(/^(doi:|\/)+/, "")}`
    : rawDoi;
const pdf = pub.pdf || pub.PDF || "";
const slides = pub.slides || "";
const poster = pub.poster || "";

// Generate IDs for toggles
const abstractId = `abstract-${pub.id}`;
const bibtexId = `bibtex-${pub.id}`;

// Clean BibTeX once
const cleanedBibtex = cleanBibtex(pub.bibtex);
---

<article
  class="publication-item group"
  data-pub-type={kind}
>
  <div class="pub-content">
    <div class="pub-venue">
      <span class={`pub-chip pub-chip--${kind}`}>{chipLabel}</span>
      {
        venue && (
          <span class="pub-venue-name">
            {venue}
            {venue_short && <span class="venue-short">({venue_short})</span>}
          </span>
        )
      }
    </div>
    <h3 class="pub-title">{pub.title}</h3>
    <div class="pub-authors">
      {
        authors.map((author: any, index: number) => {
          const isSelf = /requena[\s-]?plens/i.test(author.family || "");
          const authorClass = isSelf ? "pub-author-self" : undefined;
          return (
            <>
              {author.url ? (
                <a
                  class={authorClass}
                  href={author.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-astro-prefetch="false"
                  aria-label={t("aria.viewPublicationsBy", {
                    author: `${author.given} ${author.family}`,
                    title: pub.title,
                  })}
                >
                  {author.given} {author.family}
                </a>
              ) : (
                <span class={authorClass}>
                  {author.given} {author.family}
                </span>
              )}
              {index < authors.length - 1 && ", "}
            </>
          );
        })
      }
    </div>

    <div class="pub-actions">
      {
        pub.abstract && (
          <button
            class="btn-sm btn-abstract"
            type="button"
            data-id={pub.id}
            aria-label={t("aria.toggleAbstract", { title: pub.title })}
            aria-expanded="false"
            aria-controls={abstractId}
          >
            <span class="i-fa-solid:align-left" />{" "}
            {t("pages.publications.abstract")}
          </button>
        )
      }
      {
        cleanedBibtex && (
          <button
            class="btn-sm btn-bibtex-toggle"
            type="button"
            data-id={pub.id}
            aria-label={t("aria.toggleBibtex", { title: pub.title })}
            aria-expanded="false"
            aria-controls={bibtexId}
          >
            <span class="i-fa-solid:code" /> {t("pages.publications.bibtex")}
          </button>
        )
      }
      {
        pdf && (
          <a
            href={pdf}
            class="btn-sm"
            target="_blank"
            rel="noopener noreferrer"
            data-astro-prefetch="false"
            aria-label={t("aria.downloadPdf", { title: pub.title })}
          >
            <span class="i-fa-solid:file-pdf" /> PDF
          </a>
        )
      }
      {
        doi && (
          <a
            href={doi}
            class="btn-sm"
            target="_blank"
            rel="noopener noreferrer"
            data-astro-prefetch="false"
            aria-label={t("aria.viewDoi", { title: pub.title })}
          >
            <span class="i-fa-solid:external-link-alt" /> DOI
          </a>
        )
      }
      {
        url && !doi && (
          <a
            href={url}
            class="btn-sm"
            target="_blank"
            rel="noopener noreferrer"
            data-astro-prefetch="false"
            aria-label={t("aria.viewUrl", { title: pub.title })}
          >
            <span class="i-fa-solid:link" /> URL
          </a>
        )
      }
      {
        slides && (
          <a
            href={slides}
            class="btn-sm"
            target="_blank"
            rel="noopener noreferrer"
            data-astro-prefetch="false"
            aria-label={t("aria.viewSlides", { title: pub.title })}
          >
            <span class="i-fa-solid:chalkboard-teacher" /> Slides
          </a>
        )
      }
      {
        poster && (
          <a
            href={poster}
            class="btn-sm"
            target="_blank"
            rel="noopener noreferrer"
            data-astro-prefetch="false"
            aria-label={t("aria.viewPoster", { title: pub.title })}
          >
            <span class="i-fa-solid:image" /> Poster
          </a>
        )
      }
    </div>

    {
      pub.abstract && (
        <div
          id={abstractId}
          class="pub-abstract hidden"
        >
          <div class="pub-card-wrapper copy-container">
            <div class="pub-card-header">
              <div class="pub-card-title">
                {t("pages.publications.abstract")}
              </div>
              <CopyButton
                class="pub-copy-btn"
                content={sanitize(pub.abstract)}
                ariaLabel={t("aria.copyAbstract", { title: pub.title })}
              />
            </div>
            <div
              class="pub-card-content copy-content"
              set:html={sanitize(pub.abstract)}
            />
          </div>
        </div>
      )
    }

    {
      cleanedBibtex && (
        <div
          id={bibtexId}
          class="pub-bibtex hidden"
        >
          <div class="pub-card-wrapper copy-container">
            <div class="pub-card-header">
              <div class="pub-card-title">{t("pages.publications.bibtex")}</div>
              <CopyButton
                class="pub-copy-btn"
                content={cleanedBibtex}
                ariaLabel={t("aria.copyBibtex", { title: pub.title })}
              />
            </div>
            <div class="pub-card-content">
              <pre
                class="bibtex-raw"
                set:html={sanitize(cleanedBibtex)}
              />
            </div>
          </div>
        </div>
      )
    }
  </div>
</article>

<style>
  .publication-item {
    /* Hairline-separated row. The per-item citations column is intentionally
       omitted until a citation data source exists (a lone "—" reads as broken). */
    padding: var(--space-md-lg) 0;
    border-bottom: 1px solid var(--color-hair);
  }

  .pub-content {
    display: flex;
    flex-direction: column;
    min-width: 0; /* Critical constraint */
  }

  /* Type chip + venue kicker line. */
  .pub-venue {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    align-items: center;
    min-height: 1.2em; /* Stabilize for CLS */
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .pub-chip {
    padding: 3px 9px;
    border-radius: var(--radius-sm);
  }

  .pub-chip--journal {
    color: var(--teal-text);
    background: color-mix(in srgb, var(--teal) 14%, transparent);
  }

  .pub-chip--conference {
    color: var(--violet);
    background: color-mix(in srgb, var(--violet) 14%, transparent);
  }

  .pub-chip--thesis,
  .pub-chip--other {
    color: var(--color-accent);
    background: var(--accent-dim);
  }

  .venue-short {
    color: var(--color-text-muted);
  }

  .pub-title {
    min-height: 1.4em; /* Stabilize for CLS */
    margin: 0 0 var(--space-sm) 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: var(--fw-medium);
    line-height: 1.3;
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .pub-authors {
    min-height: 1.25em; /* Stabilize for CLS */
    margin-bottom: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.8438rem; /* 13.5px — matches mockup */
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .pub-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
  }

  /* Mono tokenized action chips (DOI, PDF, BibTeX…). */
  .pub-actions :global(.btn-sm) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  /* Abstract & Bibtex Containers (Outer wrapper for toggle) */
  .pub-abstract,
  .pub-bibtex {
    min-width: 0;

    /* Layout containment */
    max-width: 100%;
    margin-top: var(--space-md);
  }

  /* 
     * UNIFIED CARD STYLING
     * Shared by Abstract and BibTeX boxes
     */
  .pub-card-wrapper {
    display: grid;

    /* minmax(0, 1fr) is the key to forcing children to shrink */
    grid-template-columns: minmax(0, 1fr);
    max-width: 100%;
    overflow: hidden; /* Ensure header radius works */
    background-color: var(--color-bg);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-sm);
  }

  .pub-card-header {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    justify-content: flex-start;
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-surface-2);
    border-bottom: 1px solid var(--color-hair);
  }

  .pub-card-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .pub-card-content {
    width: 100%;
    overflow-x: auto; /* Scroll inside this container */
  }

  /* Specific styles */
  .pub-card-content.copy-content {
    padding: var(--space-md);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    overflow-wrap: break-word;
    white-space: normal;
  }

  /* Custom Copy Button Styling */
  .pub-card-wrapper :global(.pub-copy-btn) {
    position: static;
    width: 28px;
    min-width: 28px;
    height: 28px;
    min-height: 28px;
    padding: 0;
    color: var(--color-text-muted);
    background: transparent;
    border: none;
  }

  .pub-card-wrapper :global(.pub-copy-btn:hover) {
    color: var(--color-text);
    background-color: var(--color-bg-subtle);
  }

  /* Hide copy button */
  .pub-card-wrapper :global(.copy) {
    display: none !important;
  }

  /* Coautores en color de cuerpo, subrayado revelado al hover — baja el ruido
     cromático de la fila. El enlace sigue siendo accesible: subrayado al hover
     + anillo de :focus-visible heredado. El énfasis se reserva al autor propio
     y a las acciones (BibTeX/PDF/DOI). (P5) */
  .pub-authors a {
    color: var(--color-text);
    text-decoration-color: transparent;
    transition: text-decoration-color 0.15s ease;
  }

  .pub-authors a:hover {
    text-decoration-color: currentColor;
  }

  /* Autor propio destacado: color de título + semibold (pista no-cromática). */
  .pub-authors .pub-author-self {
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
    text-decoration: none;
  }

  a.pub-author-self {
    text-decoration-color: var(--color-primary);
  }

  /* Code component overrides (Zero-JS Theme Switching) */
  .pub-card-content :global(pre),
  .bibtex-raw {
    padding: var(--space-md) !important;
    margin: 0 !important;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-text);
    background-color: var(--color-bg-secondary) !important;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm) !important;
  }
</style>
