---
import CopyButton from "@components/ui/CopyButton.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import { sanitize } from "@utils/html";

const { pub } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Function to clean BibTeX
const cleanBibtex = (bibtex: string) => {
  if (!bibtex) return "";
  const lines = bibtex.split("\n");
  const cleaned = lines.filter((line: string) => {
    const l = line.trim().toLowerCase();
    return (
      !l.startsWith("file") &&
      !l.startsWith("abstract") &&
      !l.startsWith("keywords") &&
      !l.startsWith("doi") &&
      !l.startsWith("url") &&
      !l.startsWith("pdf") &&
      !l.startsWith("slides") &&
      !l.startsWith("poster") &&
      !l.startsWith("bibtex_show")
    );
  });
  return cleaned.join("\n");
};

// Data Formatting
const year = pub.issued?.["date-parts"]?.[0]?.[0] || "N/A";
const authors = pub.author || [];

const venue =
  pub["container-title"] ||
  pub.publisher ||
  pub.school ||
  pub.institution ||
  "";
const venue_short = pub["container-title-short"] || "";

const url = pub.url || pub.URL || "";
const rawDoi = pub.doi || pub.DOI || "";
const doi =
  rawDoi && !rawDoi.startsWith("http")
    ? `https://doi.org/${rawDoi.replace(/^(doi:|\/)+/, "")}`
    : rawDoi;
const pdf = pub.pdf || pub.PDF || "";
const slides = pub.slides || "";
const poster = pub.poster || "";

// Generate IDs for toggles
const abstractId = `abstract-${pub.id}`;
const bibtexId = `bibtex-${pub.id}`;

// Clean BibTeX once
const cleanedBibtex = cleanBibtex(pub.bibtex);
---

<div class="publication-item group">
  <div class="pub-main">
    <div class="pub-year">{year}</div>
    <div class="pub-content">
      <div class="pub-venue">
        {
          venue && (
            <>
              <span
                class="i-fa-solid:book-open pub-venue-icon"
                aria-hidden="true"
              />
              {venue}
              {venue_short && <span class="venue-short">({venue_short})</span>}
            </>
          )
        }
      </div>
      <h3 class="pub-title">{pub.title}</h3>
      <div class="pub-authors">
        {
          authors.map((author: any, index: number) => {
            const isSelf = /requena[\s-]?plens/i.test(author.family || "");
            const authorClass = isSelf ? "pub-author-self" : undefined;
            return (
              <>
                {author.url ? (
                  <a
                    class={authorClass}
                    href={author.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-astro-prefetch="false"
                    aria-label={t("aria.viewPublicationsBy", {
                      author: `${author.given} ${author.family}`,
                      title: pub.title,
                    })}
                  >
                    {author.given} {author.family}
                  </a>
                ) : (
                  <span class={authorClass}>
                    {author.given} {author.family}
                  </span>
                )}
                {index < authors.length - 1 && ", "}
              </>
            );
          })
        }
      </div>

      <div class="pub-actions">
        {
          pub.abstract && (
            <button
              class="btn-sm btn-abstract"
              type="button"
              data-id={pub.id}
              aria-label={t("aria.toggleAbstract", { title: pub.title })}
              aria-expanded="false"
              aria-controls={abstractId}
            >
              <span class="i-fa-solid:align-left" />{" "}
              {t("pages.publications.abstract")}
            </button>
          )
        }
        {
          cleanedBibtex && (
            <button
              class="btn-sm btn-bibtex-toggle"
              type="button"
              data-id={pub.id}
              aria-label={t("aria.toggleBibtex", { title: pub.title })}
              aria-expanded="false"
              aria-controls={bibtexId}
            >
              <span class="i-fa-solid:code" /> {t("pages.publications.bibtex")}
            </button>
          )
        }
        {
          pdf && (
            <a
              href={pdf}
              class="btn-sm"
              target="_blank"
              rel="noopener noreferrer"
              data-astro-prefetch="false"
              aria-label={t("aria.downloadPdf", { title: pub.title })}
            >
              <span class="i-fa-solid:file-pdf" /> PDF
            </a>
          )
        }
        {
          doi && (
            <a
              href={doi}
              class="btn-sm"
              target="_blank"
              rel="noopener noreferrer"
              data-astro-prefetch="false"
              aria-label={t("aria.viewDoi", { title: pub.title })}
            >
              <span class="i-fa-solid:external-link-alt" /> DOI
            </a>
          )
        }
        {
          url && !doi && (
            <a
              href={url}
              class="btn-sm"
              target="_blank"
              rel="noopener noreferrer"
              data-astro-prefetch="false"
              aria-label={t("aria.viewUrl", { title: pub.title })}
            >
              <span class="i-fa-solid:link" /> URL
            </a>
          )
        }
        {
          slides && (
            <a
              href={slides}
              class="btn-sm"
              target="_blank"
              rel="noopener noreferrer"
              data-astro-prefetch="false"
              aria-label={t("aria.viewSlides", { title: pub.title })}
            >
              <span class="i-fa-solid:chalkboard-teacher" /> Slides
            </a>
          )
        }
        {
          poster && (
            <a
              href={poster}
              class="btn-sm"
              target="_blank"
              rel="noopener noreferrer"
              data-astro-prefetch="false"
              aria-label={t("aria.viewPoster", { title: pub.title })}
            >
              <span class="i-fa-solid:image" /> Poster
            </a>
          )
        }
      </div>

      {
        pub.abstract && (
          <div
            id={abstractId}
            class="pub-abstract hidden"
          >
            <div class="pub-card-wrapper copy-container">
              <div class="pub-card-header">
                <div class="pub-card-title">
                  {t("pages.publications.abstract")}
                </div>
                <CopyButton
                  class="pub-copy-btn"
                  content={sanitize(pub.abstract)}
                  ariaLabel={t("aria.copyAbstract", { title: pub.title })}
                />
              </div>
              <div
                class="pub-card-content copy-content"
                set:html={sanitize(pub.abstract)}
              />
            </div>
          </div>
        )
      }

      {
        cleanedBibtex && (
          <div
            id={bibtexId}
            class="pub-bibtex hidden"
          >
            <div class="pub-card-wrapper copy-container">
              <div class="pub-card-header">
                <div class="pub-card-title">
                  {t("pages.publications.bibtex")}
                </div>
                <CopyButton
                  class="pub-copy-btn"
                  content={cleanedBibtex}
                  ariaLabel={t("aria.copyBibtex", { title: pub.title })}
                />
              </div>
              <div class="pub-card-content">
                <pre
                  class="bibtex-raw"
                  set:html={sanitize(cleanedBibtex)}
                />
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</div>

<style>
  .publication-item {
    /* Use Grid for robust layout containment */
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    padding: var(--space-lg);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-md);
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .publication-item:hover {
    border-color: var(--color-primary);
  }

  .pub-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    min-width: 0; /* Critical for grid item containment */
  }

  /* Desktop layout: Year on the left */
  @media (width >= 768px) {
    .pub-main {
      grid-template-columns: auto 1fr;
      gap: var(--space-lg);
    }
  }

  .pub-year {
    padding-top: 0.15rem; /* Align with venue kicker baseline */
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
    letter-spacing: 0.02em;
  }

  .pub-content {
    display: flex;
    flex-direction: column;
    min-width: 0; /* Critical constraint */
  }

  /* Mono venue metadata as the card's "// label" kicker line. */
  .pub-venue {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    min-height: 1.2em; /* Stabilize for CLS */
    margin-bottom: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }

  .pub-venue-icon {
    font-size: 0.8em;
    color: var(--color-primary);
  }

  .venue-short {
    color: var(--color-text-muted);
  }

  .pub-title {
    min-height: 1.4em; /* Stabilize for CLS */
    margin: 0 0 var(--space-sm) 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: var(--fw-medium);
    line-height: 1.3;
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .pub-authors {
    min-height: 1.25em; /* Stabilize for CLS */
    margin-bottom: var(--space-md);
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .pub-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
  }

  /* Mono tokenized action chips (DOI, PDF, BibTeX…). */
  .pub-actions :global(.btn-sm) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  /* Abstract & Bibtex Containers (Outer wrapper for toggle) */
  .pub-abstract,
  .pub-bibtex {
    min-width: 0;

    /* Layout containment */
    max-width: 100%;
    margin-top: var(--space-md);
  }

  /* 
     * UNIFIED CARD STYLING
     * Shared by Abstract and BibTeX boxes
     */
  .pub-card-wrapper {
    display: grid;

    /* minmax(0, 1fr) is the key to forcing children to shrink */
    grid-template-columns: minmax(0, 1fr);
    max-width: 100%;
    overflow: hidden; /* Ensure header radius works */
    background-color: var(--color-bg);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-sm);
  }

  .pub-card-header {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    justify-content: flex-start;
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-surface-2);
    border-bottom: 1px solid var(--color-hair);
  }

  .pub-card-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .pub-card-content {
    width: 100%;
    overflow-x: auto; /* Scroll inside this container */
  }

  /* Specific styles */
  .pub-card-content.copy-content {
    padding: var(--space-md);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    overflow-wrap: break-word;
    white-space: normal;
  }

  /* Custom Copy Button Styling */
  .pub-card-wrapper :global(.pub-copy-btn) {
    position: static;
    width: 28px;
    min-width: 28px;
    height: 28px;
    min-height: 28px;
    padding: 0;
    color: var(--color-text-muted);
    background: transparent;
    border: none;
  }

  .pub-card-wrapper :global(.pub-copy-btn:hover) {
    color: var(--color-text);
    background-color: var(--color-bg-subtle);
  }

  /* Hide copy button */
  .pub-card-wrapper :global(.copy) {
    display: none !important;
  }

  /* Accessibility: Distinguish author links by weight
       Similar to CV page solution for link visibility */
  .pub-authors a {
    font-weight: var(--fw-semibold);
  }

  /* Highlight the site owner among the author list. Emphasis via high-contrast
       heading color + weight (non-color cue), never small amber body text. */
  .pub-authors .pub-author-self {
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  a.pub-author-self {
    text-decoration-color: var(--color-primary);
  }

  /* Code component overrides (Zero-JS Theme Switching) */
  .pub-card-content :global(pre),
  .bibtex-raw {
    padding: var(--space-md) !important;
    margin: 0 !important;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-text);
    background-color: var(--color-bg-secondary) !important;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm) !important;
  }
</style>
