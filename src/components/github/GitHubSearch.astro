---
import RepoCard from "./RepoCard.astro";
import type { GitHubRepo } from "@utils/github";

interface Props {
  initialRepos: GitHubRepo[];
}

const { initialRepos } = Astro.props;
---

<div class="github-repos-wrapper">
  <!-- Search Bar -->
  <div class="search-container">
    <input
      type="search"
      id="repo-search"
      placeholder="Find a repository..."
      aria-label="Search repositories"
    />
  </div>

  <!-- Repos Grid - STATIC INITIAL CONTENT -->
  <div
    id="repos-container"
    class="repos-grid"
  >
    {initialRepos.map((repo) => <RepoCard repo={repo} />)}
    <p
      class="no-results"
      style="display: none;"
    >
      No repositories found.
    </p>
  </div>
</div>

<script>
  // Lightweight client-side search - NO API calls, NO hydration needed
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("repo-search");
    const container = document.getElementById("repos-container");
    let debounceTimer: ReturnType<typeof setTimeout> | undefined;

    if (searchInput && container) {
      searchInput.addEventListener("input", (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          const term = (e.target as HTMLInputElement).value.toLowerCase();

          const cards = container.querySelectorAll(".repo-card");
          const noResults = container.querySelector(".no-results");
          let matchCount = 0;

          cards.forEach((card) => {
            const name = card.getAttribute("data-name") || "";
            const desc = card.getAttribute("data-desc") || "";
            const matches = name.includes(term) || desc.includes(term);

            (card as HTMLElement).style.display = matches ? "" : "none";
            if (matches) matchCount++;
          });

          if (noResults) {
            (noResults as HTMLElement).style.display =
              matchCount === 0 && term.length > 0 ? "" : "none";
          }
        }, 150);
      });
    }
  });
</script>

<style>
  .search-container {
    margin-bottom: var(--space-lg);
  }

  #repo-search {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    font-size: 1rem;
    color: var(--color-text);
    background-color: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-md);
    transition: border-color 0.2s;
  }

  #repo-search:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px rgb(var(--color-primary-rgb, 37 99 235) / 20%);
  }

  .repos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .no-results {
    grid-column: 1 / -1;
    padding: var(--space-lg);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>