---
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import type { GitHubRepo } from "@utils/github";
import { langColors } from "@utils/github";

interface Props {
  repo: GitHubRepo;
}

const { repo } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
---

<div
  class="repo-card"
  data-name={repo.name.toLowerCase()}
  data-desc={(repo.description || "").toLowerCase()}
>
  <div class="repo-header">
    <h3>
      <a
        href={repo.html_url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t("aria.viewRepo", { name: repo.name })}
      >
        {repo.name}
      </a>
    </h3>
  </div>
  <p class="repo-desc">
    {repo.description || t("pages.github.noDescription")}
  </p>
  <div class="repo-meta">
    {
      repo.language && (
        <div class="meta-item">
          <span
            class="lang-dot"
            style={`--lang-color: ${langColors[repo.language] || "var(--color-text-muted)"}`}
            aria-hidden="true"
          />
          <span class="lang-name">{repo.language}</span>
        </div>
      )
    }
    {
      repo.stargazers_count > 0 && (
        <div class="meta-item">
          <span class="sr-only">
            {repo.stargazers_count}{" "}
            {repo.stargazers_count === 1
              ? t("pages.github.starSingular")
              : t("pages.github.starPlural")}
          </span>
          <span
            class="i-fa-solid:star"
            aria-hidden="true"
          />
          <span aria-hidden="true">{repo.stargazers_count}</span>
        </div>
      )
    }
    {
      repo.forks_count > 0 && (
        <div class="meta-item">
          <span class="sr-only">
            {repo.forks_count}{" "}
            {repo.forks_count === 1
              ? t("pages.github.forkSingular")
              : t("pages.github.forkPlural")}
          </span>
          <span
            class="i-fa-solid:code-branch"
            aria-hidden="true"
          />
          <span aria-hidden="true">{repo.forks_count}</span>
        </div>
      )
    }
  </div>
</div>

<style>
  /* Accessibility: Screen reader only class with focus override */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border-width: 0;
    clip-path: inset(50%);
  }

  .sr-only:focus,
  .sr-only:active {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    white-space: normal;
    clip-path: none;
  }

  .repo-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    padding: var(--space-md);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-md);
    transition:
      transform var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .repo-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--sh-card);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .repo-card {
      transition: border-color var(--dur-2) var(--ease-out);
    }

    .repo-card:hover {
      transform: none;
    }
  }

  .repo-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-sm);
  }

  .repo-header h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--fw-medium);
    letter-spacing: -0.01em;
  }

  .repo-header a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .repo-header a:hover {
    text-decoration: underline;
  }

  .repo-header a:focus-visible {
    text-decoration: underline;
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .repo-desc {
    flex-grow: 1;
    min-height: 3em; /* Reserve 2 lines approx */
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  .repo-card * {
    max-width: 100%;
  }

  .repo-meta {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    padding-top: var(--space-sm);
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-hair);
  }

  .meta-item {
    display: flex;
    gap: 5px;
    align-items: center;
  }

  .lang-dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    background-color: var(--lang-color, var(--color-text-muted));
    border: 1px solid var(--color-hair);
    border-radius: 50%;
  }
</style>
