---
/**
 * SelectionTree: a GraphQL selection drawn as a tree, with a verdict per
 * position and one path, the answer spine, drawn heavier.
 *
 * Built to show how one undeclared type decides an answer: a position whose
 * null lands on the spine takes the whole answer with it, while the same null
 * off the spine only empties that field. Each node is a field name, an
 * optional GraphQL type, a state badge (text, never colour alone) and an
 * optional note. Rendered as nested lists, so a screen reader reads it as the
 * tree it is; zero-JS.
 *
 * @example
 * <SelectionTree
 *   title="group.epic_get"
 *   root={{
 *     name: "namespace", type: "Namespace", state: "null", spine: true,
 *     children: [{ name: "workItem", type: "WorkItem", state: "unreached", spine: true }],
 *   }}
 *   verdict="The whole answer is null"
 *   verdictTone="bad"
 * />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

import SelectionTreeNode, { type TreeNode } from "./SelectionTreeNode.astro";

interface Props {
  /** Title above the tree, e.g. the action ID. */
  title?: string;
  /** Operation line shown above the root, e.g. `query`. */
  operation?: string;
  /** Root position(s). */
  root: TreeNode | TreeNode[];
  /** One-line outcome under the tree. */
  verdict?: string;
  /** Outcome tone: `bad` (no answer), `warn` (partly empty), `good`. */
  verdictTone?: "bad" | "warn" | "good";
  /** Caption below the figure. */
  caption?: string;
}

const {
  title,
  operation,
  root,
  verdict,
  verdictTone = "warn",
  caption,
} = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const roots = Array.isArray(root) ? root : [root];

const VERDICT_ICONS = {
  bad: "i-tabler:circle-x",
  warn: "i-tabler:alert-circle",
  good: "i-tabler:circle-check",
} as const;

/**
 * Whether any position of a tree is on the answer spine (drives the legend).
 *
 * @param nodes - The positions to walk.
 * @returns True when one of them, or a descendant, is a spine position.
 */
function anySpine(nodes: TreeNode[]): boolean {
  return nodes.some((node) => node.spine || anySpine(node.children ?? []));
}
const hasSpine = anySpine(roots);
---

<figure class="st">
  {title && (
    <figcaption class="st__title">
      <code>{title}</code>
    </figcaption>
  )}
  {operation && (
    <p class="st__op">
      <code>{operation}</code>
    </p>
  )}

  <ul class="st__tree">
    {roots.map((node) => (
      <SelectionTreeNode
        node={node}
        root
      />
    ))}
  </ul>

  {verdict && (
    <p class:list={["st__verdict", `st__verdict--${verdictTone}`]}>
      <span
        class={VERDICT_ICONS[verdictTone]}
        aria-hidden="true"
      />
      <span>{verdict}</span>
    </p>
  )}

  {hasSpine && (
    <p class="st__legend">
      <span class="sr-only">{t("components.selectionTree.legend")}: </span>
      <span class="st__legend-spine">
        <span
          class="st__swatch"
          aria-hidden="true"
        />
        {t("components.selectionTree.spine")}
      </span>
    </p>
  )}

  {caption && <p class="st__caption">{caption}</p>}
</figure>

<style>
  /* Off-spine connectors in the muted text color (5.5:1 dark, 5.8:1 light,
     the same token as ForkJoin's lines), so they clear 3:1 and differ from
     the amber spine in color as well as weight. */
  .st {
    --st-line: var(--color-text-muted);
    --st-spine: var(--color-accent);

    padding: 0.9rem 1rem;
    margin: 1.5rem 0;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md, 8px);
  }

  .st__title {
    margin-bottom: 0.6rem;
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold, 600);
    color: var(--color-text-heading);
  }

  .st__title code,
  .st__op code {
    padding: 0;
    background: none;
  }

  .st__op {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .st__tree {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .st__verdict {
    display: flex;
    gap: 0.45rem;
    align-items: baseline;
    padding-top: 0.65rem;
    margin: 0.75rem 0 0;
    font-size: var(--text-sm);
    font-weight: var(--fw-medium, 500);
    color: var(--color-text-heading);
    border-top: var(--border-1);
  }

  /* The icon is an empty span: without this, the flex row shrinks it to a
     sliver beside a long verdict. */
  .st__verdict > span:first-child {
    flex-shrink: 0;
  }

  .st__verdict--bad > span:first-child {
    color: var(--dg-danger-text);
  }

  .st__verdict--warn > span:first-child {
    color: var(--dg-warning-text);
  }

  .st__verdict--good > span:first-child {
    color: var(--dg-success-text);
  }

  .st__legend {
    margin: 0.5rem 0 0;
    font-size: var(--text-micro);
    color: var(--color-text-muted);
  }

  .st__legend-spine {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
  }

  .st__swatch {
    display: inline-block;
    width: 1.4rem;
    border-top: 3px solid var(--st-spine);
  }

  .st__caption {
    margin-top: 0.75rem;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
