---
/**
 * Pipeline Component
 *
 * A linear sequence of numbered stages. Each stage is a card with a color
 * accent, the step name and an optional tool/detail note; the arrow into a
 * stage can carry the artifact handed over from the previous one (`via`). This
 * encodes order + tool + data-flow, not just a row of boxes. Horizontal on
 * desktop, vertical on narrow screens.
 *
 * @example
 * <Pipeline
 *   stages={[
 *     { name: "strings.json", note: "EN · ES" },
 *     { name: "gen_i18n.py", note: "pack + tail-merge", via: "raw strings" },
 *     { name: "firmware.elf", note: "13.4 KB .rodata", via: ".o" },
 *   ]}
 * />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Stage {
  /** Stage name. */
  name: string;
  /** Optional tool / detail note under the name. */
  note?: string;
  /** Optional label on the arrow leading into this stage (the artifact in). */
  via?: string;
  /** Optional CSS color override for the accent. */
  color?: string;
}

interface Props {
  /** Optional title. */
  title?: string;
  /** Stages in order. */
  stages: Stage[];
  /** Caption below the figure. */
  caption?: string;
  /** Accessibility label. */
  ariaLabel?: string;
}

const { title, stages, caption, ariaLabel } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const PALETTE = 6;
const resolved = stages.map((s, i) => ({
  ...s,
  accent: s.color ?? `var(--pl-${(i % PALETTE) + 1})`,
}));

const summary =
  ariaLabel ??
  (title
    ? t("components.pipeline.ariaWithTitle", {
        title,
        count: String(stages.length),
      })
    : t("components.pipeline.ariaWithoutTitle", {
        count: String(stages.length),
      }));
---

<div
  class="pipeline"
  role="img"
  aria-label={summary}
>
  {title && <div class="pipeline__title">{title}</div>}

  <ol class="pipeline__flow">
    {
      resolved.map((s, i) => (
        <li
          class="pipeline__stage"
          style={`--pl-accent:${s.accent}`}
        >
          <span class="pipeline__meta">
            <span class="pipeline__num">{String(i + 1).padStart(2, "0")}</span>
            {s.via && <span class="pipeline__via">· ← {s.via}</span>}
          </span>
          <span class="pipeline__name">{s.name}</span>
          {s.note && <span class="pipeline__note">{s.note}</span>}
        </li>
      ))
    }
  </ol>

  {caption && <p class="pipeline__caption">{caption}</p>}
</div>

<style>
  .pipeline {
    /* Per-stage accent (top border), categorical hues from central tokens:
       blue · accent · green · gold · red · teal. All themed — no light overrides
       needed. */
    --pl-1: var(--dg-cat-2);
    --pl-2: var(--color-accent);
    --pl-3: var(--dg-cat-6);
    --pl-4: var(--color-warning);
    --pl-5: var(--color-danger);
    --pl-6: var(--teal);

    margin: 1.5rem 0;
  }

  .pipeline__title {
    margin-bottom: 1rem;
    font-size: var(--text-md);
    font-weight: var(--fw-semibold, 600);
    color: var(--color-text-heading);
  }

  .pipeline__flow {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 12px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .pipeline__stage {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 15px;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-top: 3px solid var(--pl-accent, var(--color-border));
    border-radius: var(--radius-md, 8px);
  }

  .pipeline__meta {
    display: flex;
    column-gap: 0.4rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }

  .pipeline__via {
    color: var(--color-text-muted);
  }

  .pipeline__name {
    font-size: var(--text-sm);
    font-weight: var(--fw-medium, 500);
    color: var(--color-text-heading);
    overflow-wrap: break-word;
  }

  .pipeline__note {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
  }

  .pipeline__caption {
    margin-top: 1rem;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
