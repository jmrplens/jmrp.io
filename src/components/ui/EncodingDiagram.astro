---
/**
 * EncodingDiagram Component
 *
 * Shows how inputs map to bytes: each row is a source token (a character,
 * codepoint, value…) → its encoded bytes. For UTF-8, base64, varint, etc.
 *
 * @example
 * <EncodingDiagram
 *   title="UTF-8"
 *   rows={[
 *     { label: "A (U+0041)", bytes: ["41"] },
 *     { label: "é (U+00E9)", bytes: ["C3", "A9"] },
 *     { label: "€ (U+20AC)", bytes: ["E2", "82", "AC"] },
 *   ]}
 * />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Row {
  /** Source token. */
  label: string;
  /** Encoded byte strings (e.g. hex). */
  bytes: string[];
  /** Optional note shown after the bytes. */
  note?: string;
}

interface Props {
  /** Optional title. */
  title?: string;
  /** Rows to render. */
  rows: Row[];
  /** Caption below the figure. */
  caption?: string;
  /** Accessibility label. */
  ariaLabel?: string;
}

const { title, rows, caption, ariaLabel } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Assign each byte a categorical colour from a rotating palette (running
// counter across all rows) so adjacent bytes read as distinct chips.
const CAT = 6;
let byteIndex = 0;
const rendered = rows.map((row) => ({
  ...row,
  bytes: row.bytes.map((byte) => ({
    value: byte,
    cat: (byteIndex++ % CAT) + 1,
  })),
}));

const summary =
  ariaLabel ??
  (title
    ? t("components.encodingDiagram.ariaWithTitle", { title })
    : t("components.encodingDiagram.ariaWithoutTitle"));
---

<figure
  class="enc"
  role="img"
  aria-label={summary}
>
  {title && <figcaption class="enc__title">{title}</figcaption>}

  <ul class="enc__rows">
    {
      rendered.map((row) => (
        <li class="enc__row">
          <span class="enc__src">{row.label}</span>
          <span class="enc__bytes">
            {row.bytes.map((byte) => (
              <span
                class="enc__byte"
                style={`--enc-byte:var(--cat-${byte.cat})`}
              >
                {byte.value}
              </span>
            ))}
          </span>
          {row.note && <span class="enc__note">{row.note}</span>}
        </li>
      ))
    }
  </ul>

  {caption && <p class="enc__caption">{caption}</p>}
</figure>

<style>
  .enc {
    /* Categorical chip palette from central tokens (--dg-cat-* fill hues +
       semantic warning/danger). Ink (--enc-on) flips with the theme via
       --color-on-primary so chips stay AA in both modes. */
    --cat-1: var(--color-accent);
    --cat-2: var(--dg-cat-2);
    --cat-3: var(--teal);
    --cat-4: var(--dg-cat-6);
    --cat-5: var(--color-warning);
    --cat-6: var(--color-danger);
    --enc-on: var(--color-on-primary);

    margin: 1.5rem 0;
  }

  .enc__title {
    margin-bottom: 1rem;
    font-size: var(--text-md);
    font-weight: var(--fw-semibold, 600);
    color: var(--color-text-heading);
  }

  .enc__rows {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 18px;
    margin: 0;
    list-style: none;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .enc__row {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 0.3rem 0.9rem;
    align-items: center;
  }

  .enc__src {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-heading);
  }

  .enc__bytes {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .enc__byte {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.2rem;
    padding: 0.25rem 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: var(--fw-medium, 500);
    color: var(--enc-on);
    background: var(--enc-byte, var(--cat-1));
    border-radius: var(--radius-sm, 4px);
  }

  .enc__note {
    grid-column: 2;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .enc__caption {
    margin-top: 1rem;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (width <= 480px) {
    .enc__row {
      grid-template-columns: 1fr;
    }

    .enc__note {
      grid-column: 1;
    }
  }
</style>
