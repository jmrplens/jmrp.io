  /* Screen reader only - visually hidden but accessible */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border-width: 0;
    clip-path: inset(50%);
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .bar-chart-container {
      --bar-chart-track-bg: rgb(0 0 0 / 8%);
      --bar-chart-text: #1f2937;
      --bar-chart-text-muted: #4b5563;
      --bar-text-shadow: none;
      --bar-value-color: #fff;

      /* Okabe-Ito palette (light mode) */
      --bar-okabe-1: rgb(204 121 0);
      --bar-okabe-2: rgb(0 114 178);
      --bar-okabe-3: rgb(0 128 92);
