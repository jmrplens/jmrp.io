---
/**
 * BarChart Component
 *
 * A reusable horizontal bar chart component for displaying statistical data.
 * Supports theming (light/dark), custom colors, and various display options.
 *
 * @example
 * <BarChart
 *   title="Top Attacked Ports"
 *   data={[
 *     { label: "Telnet (23)", value: 459 },
 *     { label: "SSH (22)", value: 198 },
 *   ]}
 *   showPercentage={true}
 *   showValue={true}
 * />
 */

import { createHash } from "node:crypto";

import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface BarData {
  /** Label for the bar (displayed on the left) */
  label: string;
  /** Numeric value for the bar */
  value: number;
  /** Optional custom color for this specific bar */
  color?: string;
}

interface Props {
  /** Chart title (optional) */
  title?: string;
  /** Array of data items to display as bars */
  data: BarData[];
  /** Show percentage on each bar (default: true) */
  showPercentage?: boolean;
  /** Show raw value on each bar (default: true) */
  showValue?: boolean;
  /** Unit suffix for values (e.g., "requests", "connections") */
  valueUnit?: string;
  /** Maximum value for scaling (auto-calculated if not provided) */
  maxValue?: number;
  /** Color scheme: qualitative (okabe-ito, tol, colorbrewer), sequential gradients (gradient-*), monochrome, primary, semantic, or custom hex */
  colorScheme?:
    | "okabe-ito"
    | "tol"
    | "colorbrewer"
    | "gradient-temperature"
    | "gradient-viridis"
    | "gradient-blue"
    | "gradient-red"
    | "gradient-green"
    | "gradient-purple"
    | "primary"
    | "semantic"
    | "monochrome"
    | string;
  /** For semantic colors, map of label patterns to colors */
  semanticColors?: Record<string, string>;
  /** Aria label for accessibility */
  ariaLabel?: string;
  /** Caption text below the chart */
  caption?: string;
}

const {
  title,
  data,
  showPercentage = true,
  showValue = true,
  valueUnit = "",
  maxValue: providedMax,
  colorScheme = "okabe-ito",
  semanticColors = {},
  ariaLabel,
  caption,
} = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
// Locale-aware value (grouped) and percentage (decimal separator) formatting.
const nf = new Intl.NumberFormat(locale, { useGrouping: "always" });
const pf = new Intl.NumberFormat(locale, { maximumFractionDigits: 1 });

// Generate unique ID for this chart instance based on content hash
const chartId = createHash("sha256")
  .update(`${title || ""}-${JSON.stringify(data)}`)
  .digest("hex")
  .slice(0, 8);

// Calculate max value for percentage scaling
const maxValue = providedMax ?? Math.max(...data.map((d) => d.value));
const totalValue = data.reduce((sum, d) => sum + d.value, 0);

/**
 * Determines the color for a bar based on the current color scheme.
 * Supports qualitative palettes (for unordered categories), sequential gradients
 * (for ordered data), and custom colors.
 *
 * @param {number} index - Zero-based index of the bar in the data array
 * @param {BarData} item - The bar data item containing label, value, and optional color
 * @returns {string} CSS color value (either a CSS variable reference or hex color)
 *
 * @example
 * getBarColor(0, { label: "SSH", value: 100 })
 * // Returns: "var(--bar-okabe-1)" (if using default okabe-ito scheme)
 */
function getBarColor(index: number, item: BarData): string {
  if (item.color) return item.color;

  // Check semantic colors using find for better performance and readability
  const semanticMatch = Object.entries(semanticColors).find(([pattern]) =>
    item.label.toLowerCase().includes(pattern.toLowerCase()),
  );

  if (semanticMatch) {
    return semanticMatch[1];
  }

  switch (colorScheme) {
    case "primary": {
      return "var(--bar-chart-primary)";
    }
    case "okabe-ito": {
      // Okabe-Ito: Scientific standard for colorblind accessibility
      return `var(--bar-okabe-${(index % 10) + 1})`;
    }
    case "tol": {
      // Paul Tol's Bright: Perceptually uniform alternative
      return `var(--bar-tol-${(index % 10) + 1})`;
    }
    case "colorbrewer": {
      // ColorBrewer Set1: Cartographic quality
      return `var(--bar-brewer-${(index % 10) + 1})`;
    }
    case "gradient-temperature": {
      // Temperature: Blue (cool/low) to Red (warm/high)
      return `var(--bar-temp-${(index % 10) + 1})`;
    }
    case "gradient-viridis": {
      // Viridis: Perceptually uniform sequential, colorblind-safe
      return `var(--bar-viridis-${(index % 10) + 1})`;
    }
    case "gradient-blue": {
      // Blue: Light to deep blue saturation
      return `var(--bar-grad-blue-${(index % 10) + 1})`;
    }
    case "gradient-red": {
      // Red: Light to deep red saturation
      return `var(--bar-grad-red-${(index % 10) + 1})`;
    }
    case "gradient-green": {
      // Green: Light to deep green saturation
      return `var(--bar-grad-green-${(index % 10) + 1})`;
    }
    case "gradient-purple": {
      // Purple: Light to deep purple saturation
      return `var(--bar-grad-purple-${(index % 10) + 1})`;
    }
    case "monochrome": {
      // Grayscale gradient: High values (low index) are intense, fading out
      return `var(--bar-mono-${(index % 10) + 1})`;
    }
    case "semantic": {
      return "var(--bar-chart-primary)";
    }
    default: {
      // Custom hex color provided
      return colorScheme.startsWith("#")
        ? colorScheme
        : "var(--bar-chart-primary)";
    }
  }
}
---

<figure
  class="bar-chart-container"
  role="img"
  aria-label={ariaLabel ||
    (title
      ? t("components.barChart.ariaWithTitle", {
          title,
          count: String(data.length),
        })
      : t("components.barChart.ariaWithoutTitle", {
          count: String(data.length),
        }))}
  data-animated="false"
>
  {title && <figcaption class="bar-chart-title">{title}</figcaption>}

  <ul class="bar-chart">
    {
      data.map((item, index) => {
        const percentage = maxValue > 0 ? (item.value / maxValue) * 100 : 0;
        const totalPercentage =
          totalValue > 0 ? (item.value / totalValue) * 100 : 0;
        const barColor = getBarColor(index, item);
        const labelId = `bar-label-${chartId}-${index}`;
        const barStyle = `--bar-width: ${percentage}%; --bar-index: ${index}; background-color: ${barColor};`;

        return (
          <li class="bar-row">
            <span
              class="bar-label"
              id={labelId}
            >
              {item.label}
            </span>
            <div class="bar-track">
              <div
                class={`bar-fill ${percentage < 20 ? "bar-small" : ""}`}
                style={barStyle}
                role="meter"
                aria-labelledby={labelId}
                aria-valuenow={item.value}
                aria-valuemin={0}
                aria-valuemax={maxValue}
                aria-valuetext={`${nf.format(item.value)}${valueUnit ? ` ${valueUnit}` : ""} (${pf.format(totalPercentage)}% ${t("components.barChart.ofTotal")})`}
                data-value={item.value}
                data-max={maxValue}
                title={`${item.label}: ${item.value}${valueUnit ? ` ${valueUnit}` : ""}`}
              >
                <span class="bar-value-inside">
                  {showValue && (
                    <span
                      class="value"
                      aria-hidden="true"
                    >
                      {nf.format(item.value)}
                      {valueUnit && <span class="unit"> {valueUnit}</span>}
                    </span>
                  )}
                  {showPercentage && showValue && (
                    <span
                      class="separator"
                      aria-hidden="true"
                    >
                      ·{" "}
                    </span>
                  )}
                  {showPercentage && (
                    <span
                      class="percentage"
                      aria-hidden="true"
                    >
                      {pf.format(totalPercentage)}%
                    </span>
                  )}
                </span>
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>

  <!-- Visually-hidden data table for screen readers -->
  <table class="sr-only">
    <caption>{title || "Chart data"}</caption>
    <thead>
      <tr>
        <th scope="col">Category</th>
        <th scope="col">Value{valueUnit && ` (${valueUnit})`}</th>
        <th scope="col">Percentage</th>
      </tr>
    </thead>
    <tbody>
      {
        data.map((item) => {
          const totalPercentage =
            totalValue > 0 ? (item.value / totalValue) * 100 : 0;
          return (
            <tr>
              <td>{item.label}</td>
              <td>{nf.format(item.value)}</td>
              <td>{pf.format(totalPercentage)}%</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>

  {caption && <p class="bar-chart-caption">{caption}</p>}
</figure>

<script>
  // Animate bars only when they become visible in the viewport
  function initBarChartAnimations() {
    const charts = document.querySelectorAll<HTMLElement>(
      ".bar-chart-container[data-animated='false']",
    );

    if (!charts.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const chart = entry.target as HTMLElement;
            // Mark as animated to prevent re-animation
            chart.dataset.animated = "true";
            // Trigger the animation by adding the class
            chart.classList.add("animate");
            // Stop observing this chart
            observer.unobserve(chart);
          }
        });
      },
      {
        // Trigger when 20% of the chart is visible
        threshold: 0.2,
        // Start observing slightly before it enters viewport
        rootMargin: "50px",
      },
    );

    charts.forEach((chart) => observer.observe(chart));
  }

  // Run on initial page load
  initBarChartAnimations();

  // Re-run after view transitions (for Astro's View Transitions API)
  document.addEventListener("astro:page-load", initBarChartAnimations);
</script>

