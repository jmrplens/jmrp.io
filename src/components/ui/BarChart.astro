---
/**
 * BarChart Component
 *
 * A reusable horizontal bar chart component for displaying statistical data.
 * Supports theming (light/dark), custom colors, and various display options.
 *
 * @example
 * <BarChart
 *   title="Top Attacked Ports"
 *   data={[
 *     { label: "Telnet (23)", value: 459 },
 *     { label: "SSH (22)", value: 198 },
 *   ]}
 *   showPercentage={true}
 *   showValue={true}
 * />
 */

interface BarData {
  /** Label for the bar (displayed on the left) */
  label: string;
  /** Numeric value for the bar */
  value: number;
  /** Optional custom color for this specific bar */
  color?: string;
}

interface Props {
  /** Chart title (optional) */
  title?: string;
  /** Array of data items to display as bars */
  data: BarData[];
  /** Show percentage on each bar (default: true) */
  showPercentage?: boolean;
  /** Show raw value on each bar (default: true) */
  showValue?: boolean;
  /** Unit suffix for values (e.g., "requests", "connections") */
  valueUnit?: string;
  /** Maximum value for scaling (auto-calculated if not provided) */
  maxValue?: number;
  /** Color scheme: 'primary', 'gradient', 'semantic', 'monochrome', or custom hex color */
  colorScheme?: "primary" | "gradient" | "semantic" | "monochrome" | string;
  /** For semantic colors, map of label patterns to colors */
  semanticColors?: Record<string, string>;
  /** Aria label for accessibility */
  ariaLabel?: string;
  /** Caption text below the chart */
  caption?: string;
}

const {
  title,
  data,
  showPercentage = true,
  showValue = true,
  valueUnit = "",
  maxValue: providedMax,
  colorScheme = "gradient",
  semanticColors = {},
  ariaLabel,
  caption,
} = Astro.props;

// Calculate max value for percentage scaling
const maxValue = providedMax ?? Math.max(...data.map((d) => d.value));
const totalValue = data.reduce((sum, d) => sum + d.value, 0);

// Generate bar colors based on scheme - uses CSS variable index
function getBarColor(index: number, item: BarData): string {
  if (item.color) return item.color;

  // Check semantic colors
  for (const [pattern, color] of Object.entries(semanticColors)) {
    if (item.label.toLowerCase().includes(pattern.toLowerCase())) {
      return color;
    }
  }

  switch (colorScheme) {
    case "primary": {
      return "var(--bar-chart-primary)";
    }
    case "gradient": {
      // Use CSS variables for theme-aware colors (cycles through 10 colors)
      return `var(--bar-color-${(index % 10) + 1})`;
    }
    case "monochrome": {
      // Grayscale gradient: High values (low index) are intense, fading out
      return `var(--bar-mono-${(index % 10) + 1})`;
    }
    case "semantic": {
      return "var(--bar-chart-primary)";
    }
    default: {
      // Custom hex color provided
      return colorScheme.startsWith("#")
        ? colorScheme
        : "var(--bar-chart-primary)";
    }
  }
}
---

<figure
  class="bar-chart-container"
  aria-label={ariaLabel || title || "Bar chart"}
>
  {title && <figcaption class="bar-chart-title">{title}</figcaption>}

  <ul class="bar-chart">
    {
      data.map((item, index) => {
        const percentage = maxValue > 0 ? (item.value / maxValue) * 100 : 0;
        const totalPercentage =
          totalValue > 0 ? (item.value / totalValue) * 100 : 0;
        const barColor = getBarColor(index, item);

        return (
          <li class="bar-row">
            <span class="bar-label">{item.label}</span>
            <div class="bar-track">
              <div
                class={`bar-fill ${percentage < 20 ? "bar-small" : ""}`}
                style={`width: ${percentage}%; background-color: ${barColor};`}
                data-value={item.value}
                data-max={maxValue}
                title={`${item.label}: ${item.value}${valueUnit ? ` ${valueUnit}` : ""}`}
              >
                <span class="bar-value-inside">
                  {showValue && (
                    <span class="value">
                      {item.value.toLocaleString()}
                      {valueUnit && <span class="unit"> {valueUnit}</span>}
                    </span>
                  )}
                  {showPercentage && showValue && (
                    <span class="separator"> · </span>
                  )}
                  {showPercentage && (
                    <span class="percentage">
                      {totalPercentage.toFixed(1)}%
                    </span>
                  )}
                </span>
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>

  {caption && <p class="bar-chart-caption">{caption}</p>}
</figure>

<style>
  /* CSS Variables for theming */
  .bar-chart-container {
    --bar-chart-primary: var(--color-primary, #3b82f6);
    --bar-chart-track-bg: var(--color-border, rgb(255 255 255 / 10%));
    --bar-chart-text: var(--color-text-primary, #e5e7eb);
    --bar-chart-text-muted: var(--color-text-secondary, #9ca3af);
    --bar-height: 2rem;
    --bar-gap: 0.75rem;
    --bar-radius: 0.375rem;
    --label-width: 8rem;

    /* 10 unique colors for dark mode (with transparency) */
    --bar-color-1: rgb(59 130 246 / 85%); /* Blue */
    --bar-color-2: rgb(139 92 246 / 85%); /* Violet */
    --bar-color-3: rgb(236 72 153 / 85%); /* Pink */
    --bar-color-4: rgb(249 115 22 / 85%); /* Orange */
    --bar-color-5: rgb(234 179 8 / 85%); /* Yellow */
    --bar-color-6: rgb(34 197 94 / 85%); /* Green */
    --bar-color-7: rgb(20 184 166 / 85%); /* Teal */
    --bar-color-8: rgb(6 182 212 / 85%); /* Cyan */
    --bar-color-9: rgb(168 85 247 / 85%); /* Purple */
    --bar-color-10: rgb(244 63 94 / 85%); /* Rose */

    /* Monochrome scale for dark mode (Bright -> Darker) */
    --bar-mono-1: rgb(249 250 251); /* Gray 50 */
    --bar-mono-2: rgb(243 244 246); /* Gray 100 */
    --bar-mono-3: rgb(229 231 235); /* Gray 200 */
    --bar-mono-4: rgb(209 213 219); /* Gray 300 */
    --bar-mono-5: rgb(156 163 175); /* Gray 400 */
    --bar-mono-6: rgb(107 114 128); /* Gray 500 */
    --bar-mono-7: rgb(75 85 99); /* Gray 600 */
    --bar-mono-8: rgb(55 65 81); /* Gray 700 */
    --bar-mono-9: rgb(31 41 55); /* Gray 800 */
    --bar-mono-10: rgb(17 24 39); /* Gray 900 */

    padding: 0;

    --bar-text-shadow: 0 1px 2px rgb(0 0 0 / 30%);
    --bar-value-color: white;

    margin: 1.5rem 0;
  }

  /* Light mode adjustments */
  :global([data-theme="light"]) .bar-chart-container {
    --bar-chart-track-bg: rgb(0 0 0 / 8%);
    --bar-chart-text: #1f2937;
    --bar-chart-text-muted: #4b5563;
    --bar-text-shadow: none;
    --bar-value-color: white;

    /* 10 unique colors for light mode (deeper, more saturated for visibility) */
    --bar-color-1: rgb(29 78 216); /* Blue-700 */
    --bar-color-2: rgb(109 40 217); /* Violet-700 */
    --bar-color-3: rgb(190 24 93); /* Pink-700 */
    --bar-color-4: rgb(194 65 12); /* Orange-700 */
    --bar-color-5: rgb(161 98 7); /* Yellow-700 */
    --bar-color-6: rgb(21 128 61); /* Green-700 */
    --bar-color-7: rgb(15 118 110); /* Teal-700 */
    --bar-color-8: rgb(14 116 144); /* Cyan-700 */
    --bar-color-9: rgb(126 34 206); /* Purple-700 */
    --bar-color-10: rgb(190 18 60); /* Rose-700 */

    /* Monochrome scale for light mode (Dark -> Lighter) */
    --bar-mono-1: rgb(3 7 18); /* Gray 950 */
    --bar-mono-2: rgb(17 24 39); /* Gray 900 */
    --bar-mono-3: rgb(31 41 55); /* Gray 800 */
    --bar-mono-4: rgb(55 65 81); /* Gray 700 */
    --bar-mono-5: rgb(75 85 99); /* Gray 600 */
    --bar-mono-6: rgb(107 114 128); /* Gray 500 */
    --bar-mono-7: rgb(156 163 175); /* Gray 400 */
    --bar-mono-8: rgb(209 213 219); /* Gray 300 */
    --bar-mono-9: rgb(229 231 235); /* Gray 200 */
    --bar-mono-10: rgb(243 244 246); /* Gray 100 */
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .bar-chart-container {
      --bar-chart-track-bg: rgb(0 0 0 / 8%);
      --bar-chart-text: #1f2937;
      --bar-chart-text-muted: #4b5563;
      --bar-text-shadow: none;
      --bar-value-color: white;

      /* 10 unique colors for light mode */
      --bar-color-1: rgb(29 78 216);
      --bar-color-2: rgb(109 40 217);
      --bar-color-3: rgb(190 24 93);
      --bar-color-4: rgb(194 65 12);
      --bar-color-5: rgb(161 98 7);
      --bar-color-6: rgb(21 128 61);
      --bar-color-7: rgb(15 118 110);
      --bar-color-8: rgb(14 116 144);
      --bar-color-9: rgb(126 34 206);
      --bar-color-10: rgb(190 18 60);

      /* Monochrome scale for light mode */
      --bar-mono-1: rgb(3 7 18);
      --bar-mono-2: rgb(17 24 39);
      --bar-mono-3: rgb(31 41 55);
      --bar-mono-4: rgb(55 65 81);
      --bar-mono-5: rgb(75 85 99);
      --bar-mono-6: rgb(107 114 128);
      --bar-mono-7: rgb(156 163 175);
      --bar-mono-8: rgb(209 213 219);
      --bar-mono-9: rgb(229 231 235);
      --bar-mono-10: rgb(243 244 246);
    }
  }

  .bar-chart-title {
    margin-bottom: 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--bar-chart-text);
    text-align: left;
  }

  .bar-chart {
    display: flex;
    flex-direction: column;
    gap: var(--bar-gap);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .bar-row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0;
    margin: 0;
  }

  .bar-label {
    flex-shrink: 0;
    width: var(--label-width);
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--bar-chart-text);
    text-align: right;
    white-space: nowrap;
  }

  .bar-track {
    position: relative;
    flex: 1;
    height: var(--bar-height);
    overflow: hidden;
    background: var(--bar-chart-track-bg);
    border-radius: var(--bar-radius);
  }

  .bar-fill {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    height: 100%;
    padding-right: 0.5rem;
    border-radius: var(--bar-radius);
    transition: width 0.5s ease-out;
    animation: bar-grow 0.8s ease-out forwards;
  }

  .bar-value-inside {
    display: inline-flex;
    align-items: center;
    height: calc(var(--bar-height) - 0.75rem); /* Less tall than the bar */
    padding: 0 0.5rem;
    padding: 0.15rem 0.5rem;
    margin-right: -0.25rem; /* Offset padding to align visually */
    font-size: 0.875rem; /* Slightly smaller font */
    font-weight: 600;
    color: var(--bar-value-color);
    white-space: nowrap;
    text-shadow: var(--bar-text-shadow);

    /* Ensure contrast with a semi-transparent dark background box */
    background-color: rgb(0 0 0 / 85%);
    border-radius: 4px;
  }

  /* For small bars (under 20%), show value outside the bar */
  .bar-fill.bar-small {
    justify-content: flex-start;
    padding-right: 0;
    padding-left: 0.25rem;
  }

  .bar-fill.bar-small .bar-value-inside {
    position: absolute;
    left: 100%;
    padding: 0;
    margin-left: 0.625rem; /* Space between bar and text */
    color: var(--bar-chart-text-muted);
    text-shadow: none;

    /* Remove background box when text is outside */
    background-color: transparent;
  }

  .bar-value-inside .value {
    color: inherit;
  }

  .bar-value-inside .unit {
    font-weight: 500;
  }

  .bar-value-inside .separator {
    margin: 0 0.35rem;
  }

  .bar-value-inside .percentage {
    font-weight: 500;
  }

  .bar-chart-caption {
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--bar-chart-text-muted);
    text-align: center;
  }

  /* Responsive adjustments */
  @media (width <= 640px) {
    .bar-chart-container {
      --label-width: 5rem;
      --bar-height: 1.75rem;
    }

    .bar-label {
      font-size: 0.75rem;
    }

    .bar-value-inside {
      height: calc(var(--bar-height) - 0.5rem);
      font-size: 0.6875rem;
    }
  }

  /* Animation on load */
  @keyframes bar-grow {
    from {
      width: 0;
    }
  }

  /* Stagger animation for each bar */
  .bar-row:nth-child(1) .bar-fill {
    animation-delay: 0ms;
  }

  .bar-row:nth-child(2) .bar-fill {
    animation-delay: 50ms;
  }

  .bar-row:nth-child(3) .bar-fill {
    animation-delay: 100ms;
  }

  .bar-row:nth-child(4) .bar-fill {
    animation-delay: 150ms;
  }

  .bar-row:nth-child(5) .bar-fill {
    animation-delay: 200ms;
  }

  .bar-row:nth-child(6) .bar-fill {
    animation-delay: 250ms;
  }

  .bar-row:nth-child(7) .bar-fill {
    animation-delay: 300ms;
  }

  .bar-row:nth-child(8) .bar-fill {
    animation-delay: 350ms;
  }

  .bar-row:nth-child(9) .bar-fill {
    animation-delay: 400ms;
  }

  .bar-row:nth-child(10) .bar-fill {
    animation-delay: 450ms;
  }
</style>
