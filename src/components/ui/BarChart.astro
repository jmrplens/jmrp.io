    --bar-okabe-3: rgb(0 128 92); /* Bluish Green (darker) */
    --bar-okabe-4: rgb(190 173 0); /* Yellow (darker) */
    --bar-okabe-5: rgb(0 92 142); /* Blue (darker) */
    --bar-okabe-6: rgb(178 68 0); /* Vermilion (darker) */
    --bar-okabe-7: rgb(170 51 119); /* Reddish Purple (darker) */
    --bar-okabe-8: rgb(93 82 143); /* Purple (darker) */
    --bar-okabe-9: rgb(51 160 122); /* Teal (darker) */
