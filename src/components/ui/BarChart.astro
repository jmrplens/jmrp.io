    --bar-tol-3: rgb(161 135 34); /* Yellow (darker) */
    --bar-tol-4: rgb(17 102 26); /* Green (darker) */
    --bar-tol-5: rgb(136 26 85); /* Purple (darker) */
    --bar-tol-6: rgb(51 136 205); /* Cyan (darker) */
    --bar-tol-7: rgb(205 92 119); /* Pink (darker) */
