    --bar-tol-2: rgb(238 102 119); /* Red */
    --bar-tol-3: rgb(204 187 68); /* Yellow */
    --bar-tol-4: rgb(34 136 51); /* Green */
    --bar-tol-5: rgb(170 51 119); /* Purple */
    --bar-tol-6: rgb(102 170 238); /* Cyan */
    --bar-tol-7: rgb(238 153 170); /* Pink */
