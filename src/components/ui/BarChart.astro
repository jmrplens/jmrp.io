    --bar-brewer-3: rgb(77 175 74); /* Green */
    --bar-brewer-4: rgb(152 78 163); /* Purple */
    --bar-brewer-5: rgb(255 127 0); /* Orange */
    --bar-brewer-6: rgb(255 255 51); /* Yellow */
