---
/**
 * Wrapper for a tool page's documentation section.
 *
 * Markup and styles moved verbatim from ToolLayout's `info` slot branch — see
 * ToolApp.astro for why the layout no longer owns these. The `640px` media
 * override travels with it.
 */
---

<section class="tool-info">
  <slot />
</section>

<style>
  /* Info section (full width) */
  .tool-info {
    /* La documentación queda siempre bajo la herramienta (bajo el pliegue):
       aquí sí funciona a nivel de contenedor — se salta su layout entero
       hasta que el usuario baja. */
    contain-intrinsic-size: auto 2000px;
    padding: var(--space-lg);
    content-visibility: auto;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-lg);
  }

  /* Typography inside tool-info */
  .tool-info :global(h2) {
    margin-bottom: var(--space-md);
    font-size: var(--text-xl);
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info :global(h3) {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    font-size: var(--text-md);
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info :global(h4) {
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
    font-size: var(--text-base);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
  }

  .tool-info :global(p) {
    margin-bottom: var(--space-md);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text);
  }

  .tool-info :global(ul),
  .tool-info :global(ol) {
    padding-left: 1.25rem;
    margin: 0;
  }

  .tool-info :global(li) {
    margin-bottom: var(--space-sm);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-text);
  }

  .tool-info :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tool-info :global(a:hover) {
    text-decoration: none;
  }

  .tool-info :global(code) {
    padding: 0.125rem 0.375rem;
    font-size: var(--text-sm);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
  }

  @media (width <= 640px) {
    .tool-info {
      padding: var(--space-md);
    }
  }
</style>
