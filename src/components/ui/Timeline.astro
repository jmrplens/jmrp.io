---
/**
 * Timeline Component
 * Compact vertical timeline with minimal markers and clean typography.
 *
 * Features:
 * - Minimal dot markers with type-based colors
 * - Clean layout without heavy cards
 * - Date as inline badge
 * - Dark mode optimized
 * - Markdown links in descriptions
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import { escapeHtml } from "@utils/html";

interface TimelineEvent {
  date: string;
  title: string;
  description?: string;
  icon?: string;
  type?: "default" | "success" | "warning" | "milestone";
}

interface Props {
  events: TimelineEvent[];
}

const { events } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

type EventType = NonNullable<TimelineEvent["type"]>;
const typeConfig: Record<EventType, string> = {
  default: "tl-default",
  success: "tl-success",
  warning: "tl-warning",
  milestone: "tl-milestone",
};

const typeLabel: Record<EventType, string> = {
  default: "",
  success: t("components.timeline.standard"),
  warning: t("components.timeline.deprecated"),
  milestone: t("components.timeline.milestone"),
};

/**
 * Parse markdown links [text](url) to HTML anchors
 */
function parseMarkdownLinks(text: string): string {
  return text.replaceAll(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    (_match, label: string, href: string) =>
      // The label goes first and verbatim inside the accessible name: an
      // `aria-label` REPLACES it, so announcing the new tab without it would
      // break WCAG 2.5.3 Label in Name (level A) while chasing 3.2.5 (AAA).
      //
      // Every interpolated value is escaped because the result is handed to
      // `set:html`: a quote inside a label would otherwise close `aria-label`
      // early and emit malformed markup.
      `<a href="${escapeHtml(href)}" target="_blank" rel="external noopener noreferrer" class="external-link" aria-label="${escapeHtml(
        t("aria.opensNewTab", { text: label }),
      )}">${escapeHtml(label)}</a>`,
  );
}
---

<ol class="timeline">
  {
    events.map((event) => {
      const eventType = event.type || "default";
      const typeClass = typeConfig[eventType];
      const label = typeLabel[eventType];
      return (
        <li class={`tl-event ${typeClass}`}>
          <span
            class="tl-dot"
            aria-hidden="true"
          />
          <time
            class="tl-date"
            datetime={event.date}
          >
            {event.date}
          </time>
          <div class="tl-content">
            <div class="tl-title-row">
              <span class="tl-title">{event.title}</span>
              {label && <span class="tl-type">{label}</span>}
            </div>
            {event.description && (
              <p
                class="tl-description"
                set:html={parseMarkdownLinks(event.description)}
              />
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .timeline {
    --tl-dot-size: 9px;
    --tl-dot-top: 0.25rem;

    display: flex;
    flex-direction: column;
    padding: 1.375rem 1.125rem 0.5rem;
    margin: 1.5rem 0;
    list-style: none;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  /* Each row carries the continuous rail (border-left) and hangs its dot over
     that edge; the date sits in its own column, content in the next. */
  .tl-event {
    position: relative;
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.125rem;
    padding-bottom: 1.25rem;
    padding-left: 1.5rem;
    margin-left: 0.5rem;
    border-left: 1px solid var(--color-hair);
  }

  .tl-event:last-child {
    padding-bottom: 0.25rem;
  }

  /* Dot: default is a small grey marker; typed events get a larger dot with a
     coloured halo. Position is graphical (≥3:1) and pairs with the type label
     so state is never colour-only. */
  .tl-dot {
    position: absolute;
    top: var(--tl-dot-top);
    left: calc(var(--tl-dot-size) / -2);
    z-index: 1;
    width: var(--tl-dot-size);
    height: var(--tl-dot-size);
    background: var(--tl-accent, var(--color-border));
    border-radius: 50%;
  }

  .tl-date {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .tl-content {
    min-width: 0;
  }

  .tl-title-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.625rem;
    align-items: baseline;
    line-height: 1.4;
  }

  .tl-type {
    flex-shrink: 0;
    padding: 0.0625rem 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--tl-bg-muted, var(--color-bg-subtle));
    border-radius: 0.1875rem;
  }

  .tl-title {
    font-size: var(--text-base);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
  }

  .tl-description {
    margin: 0.125rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text);
  }

  .tl-description a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: color-mix(
      in srgb,
      var(--color-primary) 40%,
      transparent
    );
    text-underline-offset: 2px;
  }

  .tl-description a:hover {
    text-decoration-color: var(--color-primary);
  }

  /*
   * Type variants — semantic hues. The dot colour + halo (graphical, ≥3:1) and
   * the `tl-type` label text both carry the state; chip text uses the heading
   * token so it stays AA on every tint in both themes. Typed dots grow to 11px
   * and gain a 3px halo so they read as emphasized against the plain default.
   */
  .tl-default {
    --tl-accent: var(--color-text-muted);
    --tl-bg-muted: var(--color-bg-subtle);
  }

  .tl-success {
    --tl-accent: var(--color-success);
    --tl-bg-muted: color-mix(in srgb, var(--color-success) 16%, transparent);
  }

  .tl-warning {
    --tl-accent: var(--color-warning);
    --tl-bg-muted: color-mix(in srgb, var(--color-warning) 16%, transparent);
  }

  .tl-milestone {
    --tl-accent: var(--color-info);
    --tl-bg-muted: color-mix(in srgb, var(--color-info) 16%, transparent);
  }

  .tl-success .tl-dot,
  .tl-warning .tl-dot,
  .tl-milestone .tl-dot {
    --tl-dot-size: 11px;

    box-shadow: 0 0 0 3px color-mix(in srgb, var(--tl-accent) 25%, transparent);
  }

  /* Responsive */
  @media (width <= 480px) {
    .tl-event {
      grid-template-columns: 3.25rem 1fr;
      gap: 0.75rem;
    }

    .tl-title-row {
      flex-direction: column;
      gap: 0.125rem;
      align-items: flex-start;
    }
  }
</style>
