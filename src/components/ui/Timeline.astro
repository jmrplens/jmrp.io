---
/**
 * Timeline Component
 * Compact vertical timeline with minimal markers and clean typography.
 *
 * Features:
 * - Minimal dot markers with type-based colors
 * - Clean layout without heavy cards
 * - Date as inline badge
 * - Dark mode optimized
 * - Markdown links in descriptions
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface TimelineEvent {
  date: string;
  title: string;
  description?: string;
  icon?: string;
  type?: "default" | "success" | "warning" | "milestone";
}

interface Props {
  events: TimelineEvent[];
}

const { events } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

type EventType = NonNullable<TimelineEvent["type"]>;
const typeConfig: Record<EventType, string> = {
  default: "tl-default",
  success: "tl-success",
  warning: "tl-warning",
  milestone: "tl-milestone",
};

const typeLabel: Record<EventType, string> = {
  default: "",
  success: t("components.timeline.standard"),
  warning: t("components.timeline.deprecated"),
  milestone: t("components.timeline.milestone"),
};

/**
 * Parse markdown links [text](url) to HTML anchors
 */
function parseMarkdownLinks(text: string): string {
  return text.replaceAll(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>',
  );
}
---

<ol class="timeline">
  {
    events.map((event) => {
      const eventType = event.type || "default";
      const typeClass = typeConfig[eventType];
      const label = typeLabel[eventType];
      return (
        <li class={`tl-event ${typeClass}`}>
          <div class="tl-marker">
            <span
              class="tl-dot"
              aria-hidden="true"
            />
          </div>
          <div class="tl-content">
            <div class="tl-header">
              <time
                class="tl-date"
                datetime={event.date}
              >
                {event.date}
              </time>
              {label && <span class="tl-type">{label}</span>}
              <span class="tl-title">{event.title}</span>
            </div>
            {event.description && (
              <p
                class="tl-description"
                set:html={parseMarkdownLinks(event.description)}
              />
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .timeline {
    --tl-dot-size: 10px;
    --tl-line-width: 2px;
    --tl-marker-col: 1rem;
    --tl-dot-offset: 0.35rem;

    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
    margin: 1rem 0;
    list-style: none;
  }

  .tl-event {
    display: grid;
    grid-template-columns: var(--tl-marker-col) 1fr;
    gap: 0.75rem;
    padding: 0 0 1rem;
    margin: 0;
  }

  .tl-event:last-child {
    padding-bottom: 0;
  }

  /* Marker column */
  .tl-marker {
    position: relative;
    display: flex;
    justify-content: center;
    padding-top: var(--tl-dot-offset);
  }

  /* Connecting line, drawn per-row on the marker cell (a sibling of the
     content) rather than as a ::before on the .timeline container. Keeping it
     off the text's ancestor chain lets axe-core resolve the background of the
     text/links inside and verify their contrast (it was reported as
     `color-contrast` incomplete otherwise). Each segment runs from this dot's
     centre to the next dot's centre; hidden on the last row. */
  .tl-marker::before {
    position: absolute;
    top: calc(var(--tl-dot-offset) + var(--tl-dot-size) / 2);
    bottom: calc(-1rem - var(--tl-dot-offset) - var(--tl-dot-size) / 2);
    left: calc(50% - var(--tl-line-width) / 2);
    width: var(--tl-line-width);
    content: "";
    background: var(--color-border);
  }

  .tl-event:last-child .tl-marker::before {
    display: none;
  }

  /* Small colored dot */
  .tl-dot {
    z-index: 1;
    width: var(--tl-dot-size);
    height: var(--tl-dot-size);
    background: var(--tl-accent, var(--color-text-muted));
    border-radius: 50%;
  }

  /* Content */
  .tl-content {
    min-width: 0;
  }

  .tl-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.625rem;
    align-items: baseline;
    line-height: 1.4;
  }

  .tl-date {
    flex-shrink: 0;
    padding: 0.0625rem 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: var(--fw-medium);
    color: var(--color-text);
    background: var(--tl-bg-muted, var(--color-bg-subtle));
    border-radius: 0.1875rem;
  }

  .tl-type {
    flex-shrink: 0;
    padding: 0.0625rem 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--tl-bg-muted, var(--color-bg-subtle));
    border-radius: 0.1875rem;
  }

  .tl-title {
    font-size: 0.9rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tl-description {
    margin: 0.25rem 0 0;
    font-size: 0.825rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .tl-description a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: color-mix(
      in srgb,
      var(--color-primary) 40%,
      transparent
    );
    text-underline-offset: 2px;
  }

  .tl-description a:hover {
    text-decoration-color: var(--color-primary);
  }

  /*
   * Type variants — Lab amber + teal only. The dot (graphical, ≥3:1) and the
   * `tl-type` label text carry the semantic; chip text uses the heading/body
   * tokens so it stays AA on every tint in both themes. `warning` and
   * `milestone` share amber but are told apart by their label text and the
   * milestone dot's ring.
   */
  .tl-default {
    --tl-accent: var(--color-text-muted);
    --tl-bg-muted: var(--color-bg-subtle);
  }

  .tl-success {
    --tl-accent: var(--teal);
    --tl-bg-muted: color-mix(in srgb, var(--teal) 14%, transparent);
  }

  .tl-warning {
    --tl-accent: var(--color-primary);
    --tl-bg-muted: var(--accent-dim);
  }

  .tl-milestone {
    --tl-accent: var(--color-primary);
    --tl-bg-muted: var(--accent-dim);
  }

  .tl-milestone .tl-dot {
    box-shadow: 0 0 0 3px var(--accent-line);
  }

  /* Responsive */
  @media (width <= 480px) {
    .tl-header {
      flex-direction: column;
      gap: 0.125rem;
      align-items: flex-start;
    }
  }
</style>
