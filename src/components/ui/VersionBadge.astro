---
/**
 * VersionBadge Component
 * Inline badge for versions, levels, or status indicators.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  type?: "version" | "level" | "deprecated" | "new" | "experimental" | "stable";
  value?: string;
}

const { type = "version", value } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

type BadgeType = NonNullable<Props["type"]>;
const config: Record<BadgeType, { class: string; prefix?: string }> = {
  version: { class: "badge-version" },
  level: {
    class: "badge-level",
    prefix: t("components.versionBadge.level"),
  },
  deprecated: { class: "badge-deprecated" },
  new: { class: "badge-new" },
  experimental: { class: "badge-experimental" },
  stable: { class: "badge-stable" },
};

const { class: badgeClass, prefix } = config[type];
const displayValue = value ?? type.charAt(0).toUpperCase() + type.slice(1);
---

<span class={`version-badge ${badgeClass}`}>
  {
    type === "new" && (
      <span
        class="badge-bullet"
        aria-hidden="true"
      >
        ●
      </span>
    )
  }
  <span class="badge-text"
    >{prefix ? `${prefix} ${displayValue}` : displayValue}</span
  >
</span>

<style>
  /* Flat, borderless inline chip: mono text on a soft hue tint, small radius.
     Icon (shape cue) inherits the semantic colour; colours use tokens that are
     AA-safe as text in both themes. */
  .version-badge {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    padding: 2px 9px;
    font-family: var(--font-mono);
    font-size: 0.75rem; /* 12px */
    font-weight: var(--fw-medium);
    vertical-align: middle;
    white-space: nowrap;
    border-radius: var(--radius-sm);
  }

  .badge-bullet {
    flex-shrink: 0;
    font-size: 0.6em;
    line-height: 1;
  }

  .badge-text {
    letter-spacing: 0.02em;
  }

  /* Version / Level - accent (amber) */
  .badge-version,
  .badge-level {
    color: var(--color-accent);
    background: var(--accent-dim);
  }

  /* New / Stable - success (teal/green) */
  .badge-new,
  .badge-stable {
    color: var(--color-success);
    background: color-mix(in srgb, var(--color-success) 16%, transparent);
  }

  /* Deprecated - danger */
  .badge-deprecated {
    color: var(--color-danger);
    background: color-mix(in srgb, var(--color-danger) 16%, transparent);
  }

  /* Experimental - warning (amber) */
  .badge-experimental {
    color: var(--color-warning);
    background: color-mix(in srgb, var(--color-warning) 16%, transparent);
  }
</style>
