---
/**
 * TerminalSessionPipeline Component
 * A technical "pipeline" design with a vertical connecting line.
 * Visualizes the flow from command to output.
 *
 * Accessibility:
 * - Uses semantic markup (section, code).
 * - Focusable scrollable regions.
 * - Proper ARIA labels and live regions for output.
 * - WCAG 2.2 AA compliant.
 */

import { createHash } from "node:crypto";

import CopyButton from "./CopyButton.astro";

interface Props {
  command: string;
  outputTitle?: string;
  ariaLabel?: string;
}

const { command, outputTitle, ariaLabel } = Astro.props;
const commandLines = command.split(/\r?\n/).map((line) => line.trim());

const hashInput = command || "pipeline-session";
const contentHash = createHash("sha256")
  .update(hashInput)
  .digest("hex")
  .slice(0, 8);

const finalAriaLabel =
  ariaLabel || `Terminal pipeline: ${commandLines[0] || "interactive"}`;
---

<div
  class="pipeline-session copy-container"
  data-testid={`pipeline-session-${contentHash}`}
  role="region"
  aria-label={finalAriaLabel}
>
  {/* Command Row */}
  <div class="pipeline-row command-row">
    <div
      class="pipeline-indicator"
      aria-hidden="true"
    >
      <div class="dot solid"></div>
      <div class="line"></div>
    </div>
    <div class="pipeline-content">
      <header class="content-header">
        <span class="label">EXECUTE</span>
        <CopyButton
          content={command}
          ariaLabel={`Copy command: ${commandLines[0] || "terminal"}`}
        />
      </header>
      <section
        class="command-box"
        aria-label="Terminal Command"
      >
        {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex */}
        <div
          class="command-scroll"
          tabindex="0"
          role="region"
          aria-label="Scrollable command area"
        >
          {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
          {
            commandLines.map((line) => {
              const isComment = line.startsWith("#");
              const isEmpty = !line;
              return (
                <div class="command-line">
                  <span
                    class="prompt"
                    aria-hidden="true"
                  >
                    {!isEmpty && !isComment ? "$" : "\u00A0"}
                  </span>
                  <code class:list={["text", { "is-comment": isComment }]}>
                    {line}
                  </code>
                </div>
              );
            })
          }
        </div>
      </section>
    </div>
  </div>

  {/* Output Row */}
  <div class="pipeline-row output-row">
    <div
      class="pipeline-indicator"
      aria-hidden="true"
    >
      <div class="line"></div>
      <div class="dot hollow"></div>
    </div>
    <div class="pipeline-content">
      <header class="content-header">
        <span class="label">{outputTitle || "RESULT"}</span>
      </header>
      <section
        class="output-text"
        role="log"
        aria-live="polite"
        aria-label="Command Output"
      >
        <slot />
      </section>
    </div>
  </div>

  {/* Hidden element for CopyButton to grab clean text */}
  <div
    class="copy-content"
    style="display: none;"
    aria-hidden="true"
    set:text={command}
  />
</div>

<style>
  .pipeline-session {
    display: flex;
    flex-direction: column;
    margin: 2.5rem 0;
    font-family: var(--font-mono);
  }

  .pipeline-row {
    display: flex;
    gap: 1.5rem;
  }

  .pipeline-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 24px;
  }

  .dot {
    z-index: 1;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    border: 2px solid var(--color-primary);
    border-radius: 50%;
  }

  .dot.solid {
    background-color: var(--color-primary);
    box-shadow: 0 0 10px var(--color-primary);
  }

  .dot.hollow {
    background-color: transparent;
    border-color: var(--color-text-muted);
    opacity: 50%;
  }

  .line {
    flex-grow: 1;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--color-primary),
      var(--color-border)
    );
  }

  .output-row .line {
    background: linear-gradient(
      to bottom,
      var(--color-border),
      var(--color-text-muted)
    );
    opacity: 20%;
  }

  .pipeline-content {
    flex: 1;
    min-width: 0;
    padding-bottom: 2rem;
  }

  .output-row .pipeline-content {
    padding-bottom: 0;
  }

  .content-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .label {
    font-size: 0.65rem;
    font-weight: 900;
    color: var(--color-text-muted);
    letter-spacing: 0.15em;
    opacity: 60%;
  }

  .command-box {
    position: relative;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .command-scroll {
    padding: 1rem;
    overflow-x: auto;
  }

  .command-scroll:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .command-line {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    min-height: 1.5rem;
  }

  .prompt {
    font-weight: bold;
    color: var(--color-primary);
    user-select: none;
  }

  .text {
    padding: 0;
    font-size: 0.9rem;
    color: var(--color-text);
    white-space: pre;
    background: none;
  }

  .text.is-comment {
    font-style: italic;
    color: var(--color-text-muted);
    opacity: 70%;
  }

  .output-text {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    overflow-wrap: break-word;
    white-space: pre-wrap;
  }

  .output-text:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  :global(.pipeline-session .copy-button) {
    position: static !important;
    background: transparent !important;
    border: none !important;
    opacity: 50%;
    transform: scale(0.85);
    transition: opacity 0.2s;
  }

  :global(.pipeline-session .copy-button:hover) {
    opacity: 100%;
  }

  @media (width <= 640px) {
    .pipeline-row {
      gap: 0.75rem;
    }

    .pipeline-indicator {
      width: 16px;
    }
  }
</style>
