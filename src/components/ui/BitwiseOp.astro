---
/**
 * BitwiseOp Component
 *
 * Visualizes a bitwise operation bit-by-bit: operand rows above a highlighted
 * result row, aligned so set bits line up. Supports & | ^, shifts (<< >>) and
 * unary ~. For masks, flags and shift tricks.
 *
 * @example
 * <BitwiseOp width={8} a={0xb2} op="&" b={0x0f} aLabel="flags" bLabel="mask" />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

type Op = "&" | "|" | "^" | "<<" | ">>" | "~";

interface Props {
  /** Optional title. */
  title?: string;
  /** Bit width (default 8). */
  width?: number;
  /** Left operand. */
  a: number;
  /** Operator. */
  op: Op;
  /** Right operand (or shift amount for << >>). Ignored for ~. */
  b?: number;
  /** Label for operand A. */
  aLabel?: string;
  /** Label for operand B. */
  bLabel?: string;
  /** Caption below the figure. */
  caption?: string;
  /** Accessibility label. */
  ariaLabel?: string;
}

const {
  title,
  width = 8,
  a,
  op,
  b = 0,
  aLabel = "a",
  bLabel = "b",
  caption,
  ariaLabel,
} = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const mask = width >= 32 ? -1 >>> 0 : (1 << width) - 1;

function apply(op: Op): number {
  switch (op) {
    case "&": {
      return a & b;
    }
    case "|": {
      return a | b;
    }
    case "^": {
      return a ^ b;
    }
    case "<<": {
      return a << b;
    }
    case ">>": {
      return a >> b;
    }
    case "~": {
      return ~a;
    }
  }
}
const result = (apply(op) & mask) >>> 0;

const hex = (v: number) =>
  "0x" +
  (v >>> 0)
    .toString(16)
    .toUpperCase()
    .padStart(Math.ceil(width / 4), "0");
const bitsOf = (v: number) =>
  Array.from(
    { length: width },
    (_, i) => ((v >>> (width - 1 - i)) & 1) as 0 | 1,
  );

const isShift = op === "<<" || op === ">>";
const isUnary = op === "~";

interface Line {
  label: string;
  bits?: (0 | 1)[];
  value?: string;
}
const lines: Line[] = [{ label: aLabel, bits: bitsOf(a), value: hex(a) }];
if (isUnary) {
  // no operand row
} else if (isShift) {
  lines.push({ label: `${op} ${b}` });
} else {
  lines.push({ label: `${op} ${bLabel}`, bits: bitsOf(b), value: hex(b) });
}
const resultLabel = isUnary ? `~${aLabel}` : "=";

const summary =
  ariaLabel ??
  (title
    ? t("components.bitwiseOp.ariaWithTitle", { title })
    : t("components.bitwiseOp.ariaWithoutTitle", { bits: String(width) }));
---

<div
  class="bitop"
  role="img"
  aria-label={summary}
>
  {title && <div class="bitop__title">{title}</div>}

  <div class="bitop__scroll">
    <div class="bitop__rows">
      {
        lines.map((line) => (
          <div class="bitop__row">
            <span class="bitop__label">{line.label}</span>
            <span class="bitop__bits">
              {line.bits ? (
                line.bits.map((bit) => (
                  <span
                    class:list={["bitop__bit", bit === 1 && "bitop__bit--set"]}
                  >
                    {bit}
                  </span>
                ))
              ) : (
                <span class="bitop__nobits" />
              )}
            </span>
            <span class="bitop__value">{line.value ?? ""}</span>
          </div>
        ))
      }
      <div class="bitop__row bitop__row--result">
        <span class="bitop__label">{resultLabel}</span>
        <span class="bitop__bits">
          {
            bitsOf(result).map((bit) => (
              <span
                class:list={[
                  "bitop__bit",
                  "bitop__bit--res",
                  bit === 1 && "bitop__bit--set",
                ]}
              >
                {bit}
              </span>
            ))
          }
        </span>
        <span class="bitop__value">{hex(result)}</span>
      </div>
    </div>
  </div>

  {caption && <p class="bitop__caption">{caption}</p>}
</div>

<style>
  .bitop {
    --bo-set: var(--color-accent);
    --bo-on: var(--color-on-primary, #000);
    --bo-tip: #57c98a; /* green — result emphasis */

    margin: 1.5rem 0;
  }

  :root[data-theme="light"] .bitop {
    --bo-tip: #197a43;
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .bitop {
      --bo-tip: #197a43;
    }
  }

  .bitop__title {
    margin-bottom: 1rem;
    font-size: var(--text-md);
    font-weight: var(--fw-semibold, 600);
    color: var(--color-text-heading);
  }

  .bitop__scroll {
    overflow-x: auto;
  }

  .bitop__rows {
    display: inline-flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 100%;
  }

  .bitop__row {
    display: flex;
    column-gap: 0.6rem;
    align-items: center;
  }

  .bitop__row--result {
    padding-top: 0.3rem;
    border-top: var(--border-1);
  }

  .bitop__label {
    flex-shrink: 0;
    width: 4.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
    text-align: right;
  }

  .bitop__row--result .bitop__label {
    color: var(--bo-tip);
  }

  .bitop__bits {
    display: inline-flex;
    gap: 2px;
  }

  .bitop__bit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border-radius: 3px;
  }

  .bitop__bit--set {
    font-weight: var(--fw-bold, 700);
    color: var(--bo-on);
    background: var(--bo-set);
  }

  .bitop__bit--res {
    border: var(--border-1);
  }

  /* Result set bits carry the green "output" accent from the design system. */
  .bitop__bit--res.bitop__bit--set {
    color: var(--color-on-primary);
    background: var(--bo-tip);
    border-color: transparent;
  }

  .bitop__value {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-heading);
    white-space: nowrap;
  }

  .bitop__row--result .bitop__value {
    color: var(--bo-tip);
  }

  .bitop__caption {
    margin-top: 1rem;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
