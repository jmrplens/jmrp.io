---
/**
 * StateNotice Component (formerly DeprecatedNotice)
 * Banner for state notices with multiple types: deprecated, mandatory, experimental, preview, etc.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  type?:
    | "deprecated"
    | "mandatory"
    | "experimental"
    | "preview"
    | "breaking"
    | "security";
  feature?: string;
  alternative?: string;
  alternativeUrl?: string;
  removalDate?: string;
  title?: string;
}

const {
  type = "deprecated",
  feature,
  alternative,
  alternativeUrl,
  removalDate,
  title,
} = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

type NoticeType = NonNullable<Props["type"]>;
const config: Record<
  NoticeType,
  {
    icon: string;
    label: string;
    color: string;
    bgColor: string;
    textColor: string;
  }
> = {
  deprecated: {
    icon: "mdi:alert-octagon",
    label: t("components.stateNotice.deprecated"),
    color: "#ef4444",
    bgColor: "239 68 68",
    textColor: "#991b1b", // red-800 for WCAG AA (~5.8:1)
  },
  mandatory: {
    icon: "mdi:check-decagram",
    label: t("components.stateNotice.mandatory"),
    color: "#10b981",
    bgColor: "16 185 129",
    textColor: "#065f46", // emerald-800 for WCAG AA (~6.5:1)
  },
  experimental: {
    icon: "mdi:flask",
    label: t("components.stateNotice.experimental"),
    color: "#f59e0b",
    bgColor: "245 158 11",
    textColor: "#92400e", // amber-800 for WCAG AA (~6.3:1)
  },
  preview: {
    icon: "mdi:eye",
    label: t("components.stateNotice.preview"),
    color: "#3b82f6",
    bgColor: "59 130 246",
    textColor: "#1e40af", // blue-800 for WCAG AA (~6.1:1)
  },
  breaking: {
    icon: "mdi:alert-box",
    label: t("components.stateNotice.breakingChange"),
    color: "#dc2626",
    bgColor: "220 38 38",
    textColor: "#7f1d1d", // red-900 for WCAG AA (~7.8:1)
  },
  security: {
    icon: "mdi:shield-alert",
    label: t("components.stateNotice.security"),
    color: "#f97316",
    bgColor: "249 115 22",
    textColor: "#9a3412", // orange-800 for WCAG AA (~5.9:1)
  },
};

const current = config[type];
const displayTitle = title || current.label;

/** Map type to the corresponding state message translation key */
const stateMessages: Record<NoticeType, string> = {
  deprecated: t("components.stateNotice.isDeprecated"),
  mandatory: t("components.stateNotice.isRequired"),
  experimental: t("components.stateNotice.isExperimental"),
  preview: t("components.stateNotice.isInPreview"),
  breaking: t("components.stateNotice.introducesBreaking"),
  security: t("components.stateNotice.hasSecurityImplications"),
};

/** Map type to the corresponding removal date message */
const removalMessages: Record<NoticeType, string | null> = {
  deprecated: removalDate
    ? t("components.stateNotice.willBeRemoved", { date: removalDate })
    : null,
  mandatory: removalDate
    ? t("components.stateNotice.effectiveFrom", { date: removalDate })
    : null,
  breaking: removalDate
    ? t("components.stateNotice.effectiveFrom", { date: removalDate })
    : null,
  security: removalDate
    ? t("components.stateNotice.mitigationRequired", { date: removalDate })
    : null,
  experimental: removalDate
    ? t("components.stateNotice.target", { date: removalDate })
    : null,
  preview: removalDate
    ? t("components.stateNotice.target", { date: removalDate })
    : null,
};
---

<div
  class={`state-notice state-notice--${type}`}
  role="note"
  aria-label={displayTitle}
  style={`--sn-color: ${current.color}; --sn-bg-color: ${current.bgColor};`}
>
  <div class="sn-header">
    <span
      class={`i-${current.icon} sn-icon`}
      aria-hidden="true"
    ></span>
    <span class="sn-title">{displayTitle}</span>
  </div>
  <div class="sn-content">
    {
      feature && (
        <p class="sn-message">
          <code class="sn-feature">{feature}</code>
          {stateMessages[type]}
          {removalMessages[type] && (
            <span class="sn-date">{removalMessages[type]}</span>
          )}
          .
        </p>
      )
    }
    {
      alternative && (
        <p class="sn-alternative">
          <span class="sn-label">
            {type === "deprecated"
              ? t("components.stateNotice.useInstead")
              : t("components.stateNotice.recommended")}
          </span>
          {alternativeUrl ? (
            <a
              href={alternativeUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t("aria.opensNewTab", { text: alternative })}
            >
              <code class="sn-alt-code">{alternative}</code>
            </a>
          ) : (
            <code class="sn-alt-code">{alternative}</code>
          )}
        </p>
      )
    }
    <slot />
  </div>
</div>

<style>
  .state-notice {
    margin: 1.5rem 0;
    overflow: hidden;
    background: rgb(var(--sn-bg-color) / 8%);
    border: 1px solid rgb(var(--sn-bg-color) / 30%);
    border-radius: var(--radius-md);
  }

  .sn-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.625rem 1rem;
    background: rgb(var(--sn-bg-color) / 15%);
    border-bottom: 1px solid rgb(var(--sn-bg-color) / 20%);
  }

  .sn-icon {
    width: 18px;
    height: 18px;
    color: var(--sn-color);
  }

  .sn-title {
    font-size: 0.8rem;
    font-weight: var(--fw-bold);
    color: var(--sn-text-color);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sn-content {
    padding: 0.875rem 1rem;
  }

  .sn-message {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .sn-feature {
    padding: 0.125rem 0.375rem;
    color: var(--sn-text-color);
    background: rgb(var(--sn-bg-color) / 15%);
    border-radius: var(--radius-sm);
  }

  .sn-date {
    color: var(--color-text-muted);
  }

  .sn-alternative {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .sn-label {
    font-size: 0.8rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
  }

  .sn-alt-code {
    padding: 0.125rem 0.375rem;
    color: var(--sn-text-color);
    background: rgb(var(--sn-bg-color) / 15%);
    border-radius: var(--radius-sm);
  }

  .sn-alternative a {
    text-decoration: none;
  }

  .sn-alternative a:hover .sn-alt-code {
    text-decoration: underline;
  }

  .sn-content :global(p) {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .sn-content :global(p:first-child) {
    margin-top: 0;
  }

  /* Per-variant accessible text colour for light theme. Defined here (not via
     the element's inline style) so the dark-theme overrides below win through
     the normal cascade — an inline custom property would outrank them and was
     leaving dark-mode text at ~2:1 contrast. These mirror the (now light-only)
     config values. */
  .state-notice--deprecated {
    --sn-text-color: #991b1b; /* red-800, ~5.8:1 */
  }

  .state-notice--mandatory {
    --sn-text-color: #065f46; /* emerald-800, ~6.5:1 */
  }

  .state-notice--experimental {
    --sn-text-color: #92400e; /* amber-800, ~6.3:1 */
  }

  .state-notice--preview {
    --sn-text-color: #1e40af; /* blue-800, ~6.1:1 */
  }

  .state-notice--breaking {
    --sn-text-color: #7f1d1d; /* red-900, ~7.8:1 */
  }

  .state-notice--security {
    --sn-text-color: #9a3412; /* orange-800, ~5.9:1 */
  }

  /* Dark mode: use lighter text colors for WCAG AA contrast (≥4.5:1) */
  :root[data-theme="dark"] .state-notice--deprecated {
    --sn-text-color: #f87171; /* red-400, ~5.5:1 contrast */
  }

  :root[data-theme="dark"] .state-notice--mandatory {
    --sn-text-color: #34d399; /* emerald-400, ~7.2:1 contrast */
  }

  :root[data-theme="dark"] .state-notice--experimental {
    --sn-text-color: #fb6d16; /* Custom contrast-adjusted orange, ~5.28:1 contrast */
  }

  :root[data-theme="dark"] .state-notice--preview {
    --sn-text-color: #60a5fa; /* blue-400, ~5.1:1 contrast */
  }

  :root[data-theme="dark"] .state-notice--breaking {
    --sn-text-color: #f87171; /* red-400, ~5.5:1 contrast */
  }

  :root[data-theme="dark"] .state-notice--security {
    --sn-text-color: #fb923c; /* orange-400, ~6.4:1 contrast */
  }

  /* System dark mode fallback - matches [data-theme="dark"] values */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .state-notice--deprecated {
      --sn-text-color: #f87171;
    }

    :root:not([data-theme]) .state-notice--mandatory {
      --sn-text-color: #34d399;
    }

    :root:not([data-theme]) .state-notice--experimental {
      --sn-text-color: #fb6d16;
    }

    :root:not([data-theme]) .state-notice--preview {
      --sn-text-color: #60a5fa;
    }

    :root:not([data-theme]) .state-notice--breaking {
      --sn-text-color: #f87171;
    }

    :root:not([data-theme]) .state-notice--security {
      --sn-text-color: #fb923c;
    }
  }
</style>
