---
/**
 * Callout Component
 * Renders a colored alert box with an icon to highlight information.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  type?:
    | "info"
    | "warning"
    | "error"
    | "success"
    | "tip"
    | "note"
    | "keypoint"
    | "important";
  title?: string;
  icon?: string;
}

const { type = "info", title, icon } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const typeLabels: Record<NonNullable<Props["type"]>, string> = {
  info: t("components.callout.info"),
  warning: t("components.callout.warning"),
  error: t("components.callout.error"),
  success: t("components.callout.success"),
  tip: t("components.callout.tip"),
  note: t("components.callout.note"),
  keypoint: t("components.callout.keypoint"),
  important: t("components.callout.important"),
};

const translatedType = typeLabels[type];

/* Map icons but handle colors in CSS */
const icons = {
  info: "mdi:information-outline",
  warning: "mdi:alert-outline",
  error: "mdi:alert-circle-outline",
  success: "mdi:check-circle-outline",
  tip: "mdi:lightbulb-outline",
  note: "mdi:information-variant-circle-outline",
  keypoint: "mdi:lightbulb-on-outline",
  important: "mdi:alert-decagram-outline",
};

const iconName = icon || icons[type];
---

<aside
  class={`callout callout-${type}`}
  role="note"
  aria-label={title || t("aria.calloutType", { type: translatedType })}
>
  <span class="sr-only">{translatedType}:</span>
  <span
    class="callout-icon-box"
    aria-hidden="true"
  >
    <span class={`i-${iconName} icon-wrapper`}></span>
  </span>
  <div class="callout-content-wrapper">
    {title && <strong class="callout-title">{title}</strong>}
    <div class="content">
      <slot />
    </div>
  </div>
</aside>

<style>
  .callout {
    position: relative;
    display: flex;
    gap: var(--space-md);
    padding: var(--space-md);
    margin: var(--space-md-lg) 0;
    overflow: hidden;
    background: var(--callout-bg);
    border: 1px solid color-mix(in srgb, var(--callout-color) 22%, transparent);
    border-left: 4px solid var(--callout-color);
    border-radius: var(--radius-md);
    box-shadow: var(--sh-card);
  }

  /*
     * Theme Definitions
     * Uses 700 scale for text in Light Mode (Contrast > 4.5:1)
     * Uses 400/500 scale for text in Dark Mode
     */

  /* Non-semantic Callout hues (tip/note/keypoint/important) — the four
     state types (info/warning/error/success) consume the formal semantic
     tokens from global.css instead of redefining colliding globals. */

  /* Default (Dark Mode) */
  :root {
    --color-tip-text: #a78bfa; /* Violet 400 */
    --color-tip-bg: rgb(139 92 246 / 10%);
    --color-note-text: #9ca3af; /* Gray 400 */
    --color-note-bg: rgb(107 114 128 / 10%);
    --color-keypoint-text: var(--color-primary);
    --color-keypoint-bg: var(--color-bg-subtle);
    --color-important-text: #a78bfa; /* Purple 400 */
    --color-important-bg: rgb(167 139 250 / 10%);
  }

  /* Light Mode Overrides */
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) {
      --color-tip-text: #6d28d9; /* Violet 700 */
      --color-tip-bg: rgb(139 92 246 / 10%);
      --color-note-text: #374151; /* Gray 700 */
      --color-note-bg: rgb(107 114 128 / 10%);
      --color-keypoint-text: #1d4ed8; /* Blue 700 */
      --color-keypoint-bg: var(--color-bg-subtle);
      --color-important-text: #7c3aed; /* Purple 600 */
      --color-important-bg: rgb(124 58 237 / 10%);
    }
  }

  /* Explicit Light Mode Force */
  :root[data-theme="light"] {
    --color-tip-text: #6d28d9;
    --color-tip-bg: rgb(139 92 246 / 10%);
    --color-note-text: #374151;
    --color-note-bg: rgb(107 114 128 / 10%);
    --color-keypoint-text: #1d4ed8;
    --color-keypoint-bg: var(--color-bg-subtle);
    --color-important-text: #7c3aed;
    --color-important-bg: rgb(124 58 237 / 10%);
  }

  /* Assignments — state types map to the formal semantic tokens. */
  .callout-info {
    --callout-color: var(--color-info);
    --callout-bg: var(--info-dim);
  }

  .callout-warning {
    --callout-color: var(--color-warning);
    --callout-bg: var(--warning-dim);
  }

  .callout-error {
    --callout-color: var(--color-danger);
    --callout-bg: var(--danger-dim);
  }

  .callout-success {
    --callout-color: var(--color-success);
    --callout-bg: var(--success-dim);
  }

  .callout-tip {
    --callout-color: var(--color-tip-text);
    --callout-bg: var(--color-tip-bg);
  }

  .callout-note {
    --callout-color: var(--color-note-text);
    --callout-bg: var(--color-note-bg);
  }

  .callout-important {
    --callout-color: var(--color-important-text);
    --callout-bg: var(--color-important-bg);
  }

  .callout-keypoint {
    --callout-color: var(--color-keypoint-text);
    --callout-bg: var(--color-keypoint-bg);

    padding: var(--space-md-lg);
  }

  /* Tinted square that frames the state icon (Lab pattern). */
  .callout-icon-box {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--callout-color);
    background: color-mix(in srgb, var(--callout-color) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--callout-color) 28%, transparent);
    border-radius: var(--radius-sm);
  }

  .icon-wrapper {
    display: block;
    width: 18px;
    height: 18px;
    color: var(--callout-color);
  }

  .callout-content-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    align-self: center;
    width: 100%;
    min-width: 0; /* Prevent flex blowout */
  }

  /* Mono uppercase kicker — the title doubles as the Lab "// label" cue. */
  .callout-title {
    display: block;
    margin-bottom: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: var(--fw-semibold);
    color: var(--callout-color);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .content {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  /* When a title is present the content sits below it, top-aligned. */
  .callout-content-wrapper:has(.callout-title) {
    align-self: flex-start;
  }

  .content :global(p:last-child) {
    margin-bottom: 0;
  }

  .content :global(p:first-child) {
    margin-top: 0;
  }

  /* Links inside callout */
  .content :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--callout-color);
    text-underline-offset: 2px;
  }

  .content :global(a:hover) {
    color: var(--callout-color);
  }
</style>
