---
/**
 * CallStack Component
 *
 * A vertical stack of call frames (function + optional detail) with a side rail
 * showing the growth direction. For recursion, stack overflow, calling
 * conventions. Frames are listed outermost first (top).
 *
 * @example
 * <CallStack
 *   frames={[
 *     { name: "main()" },
 *     { name: "parse(buf, len)", detail: "locals: 24 B" },
 *     { name: "decode()", detail: "recursion depth 3" },
 *   ]}
 * />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Frame {
  /** Function signature / frame name. */
  name: string;
  /** Optional detail (locals, return address, size…). */
  detail?: string;
  /** Optional CSS color override for the accent. */
  color?: string;
}

interface Props {
  /** Optional title. */
  title?: string;
  /** Frames, outermost first. */
  frames: Frame[];
  /** Growth direction label shown on the rail (default "deeper ↓"). */
  growthLabel?: string;
  /** Caption below the figure. */
  caption?: string;
  /** Accessibility label. */
  ariaLabel?: string;
}

const { title, frames, growthLabel, caption, ariaLabel } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Fall back to the localized default when the caller doesn't override it.
const growth = growthLabel ?? t("components.callStack.growthLabel");

// Neutral mono frames; the deepest frame (or any frame given an explicit
// `color`) is accented, echoing the highlighted innermost frame in the mockup.
const resolved = frames.map((f, i) => ({
  ...f,
  accent: i === frames.length - 1 || f.color != null,
  accentColor: f.color ?? "var(--color-accent)",
}));

const summary =
  ariaLabel ??
  (title
    ? t("components.callStack.ariaWithTitle", {
        title,
        count: String(frames.length),
      })
    : t("components.callStack.ariaWithoutTitle", {
        count: String(frames.length),
      }));
---

<figure
  class="cstack"
  role="img"
  aria-label={summary}
>
  {title && <figcaption class="cstack__title">{title}</figcaption>}

  <ol class="cstack__frames">
    {
      resolved.map((f) => (
        <li
          class:list={["cstack__frame", f.accent && "cstack__frame--accent"]}
          style={f.accent ? `--cs-accent:${f.accentColor}` : undefined}
        >
          <span class="cstack__name">{f.name}</span>
          {f.detail && <span class="cstack__detail">{f.detail}</span>}
        </li>
      ))
    }
  </ol>

  <p
    class="cstack__growth"
    aria-hidden="true"
  >
    <span class="cstack__growth-arrow">↓</span>
    {growth}
  </p>

  {caption && <p class="cstack__caption">{caption}</p>}
</figure>

<style>
  .cstack {
    margin: 1.5rem 0;
  }

  .cstack__title {
    margin-bottom: 1rem;
    font-size: 1rem;
    font-weight: var(--fw-semibold, 600);
    color: var(--color-text-heading);
  }

  .cstack__frames {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 34rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cstack__growth {
    display: flex;
    column-gap: 0.45rem;
    align-items: center;
    max-width: 34rem;
    margin: 0.6rem 0 0;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .cstack__growth-arrow {
    font-size: 1.05rem;
    font-weight: var(--fw-bold, 700);
    line-height: 1;
    color: var(--color-accent);
  }

  .cstack__frame {
    display: flex;
    column-gap: 0.6rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 1rem;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md, 8px);
  }

  .cstack__frame--accent {
    background: color-mix(
      in srgb,
      var(--cs-accent, var(--color-accent)) 13%,
      transparent
    );
    border-color: var(--cs-accent, var(--color-accent));
  }

  .cstack__name {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text-heading);
  }

  .cstack__detail {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    text-align: right;
  }

  .cstack__frame--accent .cstack__detail {
    color: var(--cs-accent, var(--color-accent));
  }

  .cstack__caption {
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
