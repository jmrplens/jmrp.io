---
/**
 * KeyValue Component
 * Renders a compact key-value table with styled key badges.
 * Uses is:global to ensure styles work in .prose context.
 */
interface Props {
  title?: string;
  items?: Array<{ key: string; value: string; description?: string }>;
  headingLevel?: 2 | 3 | 4 | 5 | 6;
}

const { title, items = [], headingLevel = 3 } = Astro.props;
const HeadingTag = `h${headingLevel}` as "h2" | "h3" | "h4" | "h5" | "h6";
---

<div class="key-value">
  {title && <HeadingTag class="kv-title">{title}</HeadingTag>}
  <dl class="kv-list">
    {
      items.map((item) => (
        <div class="kv-item">
          <dt class="kv-key">
            <span class="kv-key-badge">{item.key}</span>
          </dt>
          <dd class="kv-value">
            <code>{item.value}</code>
            {item.description && (
              <span class="kv-desc">{item.description}</span>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</div>

<style is:global>
  /* Lab KeyValue — flat mono ledger: muted keys left, heading values right. */
  .key-value {
    margin: 1.5rem 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .key-value .kv-title {
    padding: 0.625rem 1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-hair);
  }

  .key-value .kv-list {
    padding: 0;
    margin: 0;
  }

  .key-value .kv-item {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.6875rem 1rem;
    border-bottom: 1px solid var(--color-hair);
  }

  .key-value .kv-item:last-child {
    border-bottom: none;
  }

  .key-value .kv-key {
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    font-weight: var(--fw-normal);
  }

  /* Key rendered as plain muted mono text (the badge element carries no chrome). */
  .key-value .kv-key-badge {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: var(--fw-normal);
    color: var(--color-text-muted);
  }

  .key-value .kv-value {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    justify-content: flex-end;
    min-width: 0;
    margin: 0 0 0 auto;
    text-align: right;
  }

  .key-value .kv-value code {
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-heading);
    overflow-wrap: anywhere;
    background: transparent;
  }

  .key-value .kv-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (width <= 480px) {
    .key-value .kv-item {
      flex-direction: column;
      gap: 0.375rem;
      align-items: flex-start;
      justify-content: flex-start;
    }

    .key-value .kv-value {
      flex-direction: column;
      gap: 0.25rem;
      margin-left: 0;
      text-align: left;
    }
  }
</style>
