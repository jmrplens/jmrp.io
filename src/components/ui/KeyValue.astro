---
/**
 * KeyValue Component
 * Renders a compact key-value table with styled key badges.
 * Uses is:global to ensure styles work in .prose context.
 */
interface Props {
  title?: string;
  items: Array<{ key: string; value: string; description?: string }>;
}

const { title, items } = Astro.props;
---

<div class="key-value">
  {title && <div class="kv-title">{title}</div>}
  <dl class="kv-list">
    {
      items.map((item) => (
        <div class="kv-item">
          <dt class="kv-key">
            <span class="kv-key-badge">{item.key}</span>
          </dt>
          <dd class="kv-value">
            <code>{item.value}</code>
            {item.description && (
              <span class="kv-desc">{item.description}</span>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</div>

<style is:global>
  .key-value {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .key-value .kv-title {
    padding: 0.625rem 1rem;
    font-size: 0.8rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-bg-subtle);
    border-bottom: var(--border-1);
  }

  .key-value .kv-list {
    padding: 0;
    margin: 0;
  }

  .key-value .kv-item {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .key-value .kv-item:last-child {
    border-bottom: none;
  }

  .key-value .kv-key {
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    font-weight: normal;
  }

  .key-value .kv-key-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: var(--fw-medium);
    color: var(--color-primary);
    background: linear-gradient(
      135deg,
      rgb(179 137 245 / 12%),
      rgb(179 137 245 / 6%)
    );
    border: 1px solid rgb(179 137 245 / 25%);
    border-radius: var(--radius-sm);
  }

  .key-value .kv-value {
    display: flex;
    flex: 1;
    gap: 0.75rem;
    align-items: baseline;
    min-width: 0;
    margin: 0;
  }

  .key-value .kv-value code {
    padding: 0.125rem 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text);
    overflow-wrap: anywhere;
    background: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
  }

  .key-value .kv-desc {
    flex: 1;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  /* Light mode adjustments */
  :root[data-theme="light"] .key-value .kv-key-badge {
    color: #7c3aed;
    background: linear-gradient(
      135deg,
      rgb(124 58 237 / 10%),
      rgb(124 58 237 / 5%)
    );
    border-color: rgb(124 58 237 / 20%);
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .key-value .kv-key-badge {
      color: #7c3aed;
      background: linear-gradient(
        135deg,
        rgb(124 58 237 / 10%),
        rgb(124 58 237 / 5%)
      );
      border-color: rgb(124 58 237 / 20%);
    }
  }

  @media (width <= 480px) {
    .key-value .kv-item {
      flex-direction: column;
      gap: 0.5rem;
    }

    .key-value .kv-value {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
