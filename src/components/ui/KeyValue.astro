---
/**
 * KeyValue Component
 * Renders a compact key-value table with styled key badges.
 * Uses is:global to ensure styles work in .prose context.
 */
interface Props {
  title?: string;
  items?: Array<{ key: string; value: string; description?: string }>;
  headingLevel?: 2 | 3 | 4 | 5 | 6;
}

const { title, items = [], headingLevel = 3 } = Astro.props;
const HeadingTag = `h${headingLevel}` as "h2" | "h3" | "h4" | "h5" | "h6";
---

<div class="key-value">
  {title && <HeadingTag class="kv-title">{title}</HeadingTag>}
  <dl class="kv-list">
    {
      items.map((item) => (
        <div class="kv-item">
          <dt class="kv-key">
            <span class="kv-key-badge">{item.key}</span>
          </dt>
          <dd class="kv-value">
            <code>{item.value}</code>
            {item.description && (
              <span class="kv-desc">{item.description}</span>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</div>

<style is:global>
  .key-value {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-lg);
  }

  .key-value .kv-title {
    padding: 0.625rem 1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-bg-subtle);
    border-bottom: var(--border-1);
  }

  .key-value .kv-list {
    padding: 0;
    margin: 0;
  }

  .key-value .kv-item {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-hair);
  }

  .key-value .kv-item:last-child {
    border-bottom: none;
  }

  .key-value .kv-key {
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    font-weight: normal;
  }

  .key-value .kv-key-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: var(--fw-medium);
    color: var(--color-primary);
    background: var(--accent-dim);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-sm);
  }

  .key-value .kv-value {
    display: flex;
    flex: 1;
    gap: 0.75rem;
    align-items: baseline;
    min-width: 0;
    margin: 0;
  }

  .key-value .kv-value code {
    padding: 0.125rem 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text);
    overflow-wrap: anywhere;
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
  }

  .key-value .kv-desc {
    flex: 1;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  @media (width <= 480px) {
    .key-value .kv-item {
      flex-direction: column;
      gap: 0.5rem;
    }

    .key-value .kv-value {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
