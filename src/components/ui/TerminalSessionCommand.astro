---
/**
 * TerminalSessionCommand — a command line inside <TerminalSession>.
 * Emits the raw text in a hidden .ts-command-raw for the parent's "copy
 * commands" button, plus the visible prompt + command lines.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import { decodeHtml } from "@utils/html";
import * as cheerio from "cheerio";

interface Props {
  prompt?: string;
  ariaLabel?: string;
}

const { prompt = "❯", ariaLabel } = Astro.props;

let lines: string[] = [];
let rawContent = "";

if (Astro.slots.has("default")) {
  const htmlContent = await Astro.slots.render("default");
  const $ = cheerio.load(htmlContent);
  $("br").replaceWith("\n");
  $("p, div, li, h1, h2, h3, h4, h5, h6").each((_, el) => {
    $(el).append("\n");
  });
  const processed = decodeHtml($.text()).trim();
  if (processed) lines = processed.split(/\r?\n/);
  rawContent = lines.join("\n");
}

const renderedLines = lines.map((line) => {
  const trimmedLine = line.trim();
  return {
    text: trimmedLine || " ",
    isComment: trimmedLine.startsWith("#"),
    isEmpty: !trimmedLine,
  };
});

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const trimmedRaw = rawContent.trim();
let groupLabel: string;
if (ariaLabel) {
  groupLabel = ariaLabel;
} else if (trimmedRaw) {
  const suffix = trimmedRaw.length > 120 ? "..." : "";
  groupLabel = t("components.terminal.commandAria", {
    command: `${trimmedRaw.slice(0, 120)}${suffix}`,
  });
} else {
  groupLabel = t("components.terminal.noCommand");
}
---

<div
  class="ts-command"
  role="group"
  aria-label={groupLabel}
>
  {/* Hidden raw text for the parent TerminalSession to extract. */}
  <div
    class="ts-command-raw"
    hidden
    aria-hidden="true"
    set:text={rawContent}
  />
  {
    renderedLines.map((line) =>
      line.isComment || line.isEmpty ? (
        <div class="jmrp-term__line">
          <span class="term-out">{line.text}</span>
        </div>
      ) : (
        <div class="jmrp-term__line">
          <span
            class="term-prompt"
            aria-hidden="true"
          >
            {prompt}
          </span>
          <span class="term-cmd">{line.text}</span>
        </div>
      ),
    )
  }
</div>
