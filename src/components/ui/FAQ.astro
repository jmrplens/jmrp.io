---
/**
 * FAQ — accessible, fully-collapsible frequently-asked-questions section.
 *
 * The whole block collapses under its title (an outer `<details>`), and each
 * Q&A is itself a nested `<details>`/`<summary>` disclosure. All native: zero-JS,
 * keyboard accessible, and screen-reader friendly (open/closed announced
 * natively; the title keeps its `<h2>` heading semantics inside the summary).
 * Answer content stays in the DOM even when collapsed, so it remains fully
 * crawlable/indexable. The `FAQPage` JSON-LD is emitted separately from the same
 * `faq` frontmatter (in BlogPost), so structured data never depends on visibility.
 */
import { getLangFromUrl, useTranslations } from "@i18n/utils";

interface Props {
  /** Question/answer pairs. */
  items: { question: string; answer: string }[];
  /** Whether the outer block starts expanded. Defaults to collapsed. */
  open?: boolean;
}

const { items, open = false } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
const headingId = `faq-${crypto.getRandomValues(new Uint32Array(1))[0]}`;
---

{
  items.length > 0 && (
    <section
      class="faq"
      aria-labelledby={headingId}
    >
      <details
        class="faq__group"
        open={open}
      >
        <summary class="faq__group-summary">
          <h2
            id={headingId}
            class="faq__heading"
          >
            <span
              class="i-mdi:comment-question-outline faq__heading-icon"
              aria-hidden="true"
            />
            {t("components.faqHeading")}
          </h2>
          <span
            class="i-mdi:chevron-down faq__group-chevron"
            aria-hidden="true"
          />
        </summary>
        <div class="faq__list">
          {items.map((item) => (
            <details class="faq__item">
              <summary class="faq__question">
                <span class="faq__question-text">{item.question}</span>
                <span
                  class="faq__toggle"
                  aria-hidden="true"
                >
                  <span class="i-mdi:plus faq__toggle-icon faq__toggle-icon--closed" />
                  <span class="i-mdi:minus faq__toggle-icon faq__toggle-icon--open" />
                </span>
              </summary>
              <div class="faq__answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </details>
    </section>
  )
}

<style>
  .faq {
    padding-block-start: var(--space-md);
    margin-block-start: var(--space-lg);
    border-block-start: 1px solid var(--color-hair);
  }

  /* --- Outer collapsible group --- */
  .faq__group {
    margin: 0;
  }

  .faq__group-summary {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }

  .faq__group-summary::-webkit-details-marker {
    display: none;
  }

  .faq__group-summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .faq__heading {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    margin: 0;
  }

  .faq__heading-icon {
    width: 1.1em;
    height: 1.1em;
    color: var(--color-primary);
  }

  .faq__group-chevron {
    flex-shrink: 0;
    width: 1.5em;
    height: 1.5em;
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
  }

  .faq__group[open] .faq__group-chevron {
    transform: rotate(180deg);
  }

  /* --- Inner per-question disclosures ---
     Mockup: flat rows separated by hairlines inside ONE bordered
     container (not individual cards). */
  .faq__list {
    display: flex;
    flex-direction: column;
    margin-block-start: var(--space-md);
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .faq__item {
    border-bottom: 1px solid var(--color-hair);
  }

  .faq__item:last-child {
    border-bottom: none;
  }

  .faq__question {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    padding: 15px 18px;
    font-size: 0.9375rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    background: var(--color-bg-subtle);
  }

  .faq__question:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  /* Mono +/- toggle: "+" (muted) when collapsed, "−" (accent) when open. */
  .faq__toggle {
    display: inline-flex;
    flex-shrink: 0;
    font-family: var(--font-mono);
  }

  .faq__toggle-icon {
    width: 1.125em;
    height: 1.125em;
  }

  .faq__toggle-icon--closed {
    color: var(--color-text-muted);
  }

  .faq__toggle-icon--open {
    display: none;
    color: var(--color-accent);
  }

  .faq__item[open] .faq__toggle-icon--closed {
    display: none;
  }

  .faq__item[open] .faq__toggle-icon--open {
    display: inline-block;
  }

  .faq__answer {
    padding: 0 18px 16px;
    font-size: 0.9063rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .faq__answer p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__group-chevron {
      transition: none;
    }
  }
</style>
