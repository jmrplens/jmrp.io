---
/**
 * FAQ — accessible frequently-asked-questions section.
 *
 * The block is a normal `<section>` with an `<h2>` heading (NOT collapsible):
 * only each individual question is a native `<details>`/`<summary>` disclosure.
 * All native: zero-JS, keyboard accessible, and screen-reader friendly
 * (open/closed announced natively). Answer content stays in the DOM even when
 * a question is collapsed, so it remains fully crawlable/indexable. The
 * `FAQPage` JSON-LD is emitted separately from the same `faq` frontmatter (in
 * BlogPost), so structured data never depends on visibility.
 */
import { getLangFromUrl, useTranslations } from "@i18n/utils";

interface Props {
  /** Question/answer pairs. */
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
const headingId = `faq-${crypto.getRandomValues(new Uint32Array(1))[0]}`;
---

{
  items.length > 0 && (
    <section
      class="faq"
      aria-labelledby={headingId}
    >
      <h2
        id={headingId}
        class="faq__heading"
      >
        <span
          class="i-mdi:comment-question-outline faq__heading-icon"
          aria-hidden="true"
        />
        {t("components.faqHeading")}
      </h2>
      <div class="faq__list">
        {items.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">
              <span class="faq__question-text">{item.question}</span>
              <span
                class="faq__toggle"
                aria-hidden="true"
              >
                <span class="i-mdi:plus faq__toggle-icon faq__toggle-icon--closed" />
                <span class="i-mdi:minus faq__toggle-icon faq__toggle-icon--open" />
              </span>
            </summary>
            <div class="faq__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}

<style>
  /* Section rhythm mirrors References.astro (.references-section/.header):
     same top separation and the same 1.5rem gap under the heading. */
  .faq {
    padding-block-start: var(--space-lg);
    margin-block-start: var(--space-xl);
    border-block-start: var(--border-hair);
  }

  .faq__heading {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    margin: 0 0 var(--space-md-lg);
    color: var(--color-text-heading);
  }

  .faq__heading-icon {
    width: 1.1em;
    height: 1.1em;
    color: var(--color-primary);
  }

  /* Flat rows separated by hairlines inside ONE bordered container
     (not individual cards). */
  .faq__list {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-lg);
  }

  .faq__item {
    border-block-end: var(--border-hair);
  }

  .faq__item:last-child {
    border-block-end: none;
  }

  .faq__question {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md) var(--space-md-lg);
    font-size: var(--text-base);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    background: var(--color-bg-subtle);
  }

  .faq__question:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  /* Mono +/- toggle: "+" (muted) when collapsed, "−" (accent) when open. */
  .faq__toggle {
    display: inline-flex;
    flex-shrink: 0;
    font-family: var(--font-mono);
  }

  .faq__toggle-icon {
    width: 1.125em;
    height: 1.125em;
  }

  .faq__toggle-icon--closed {
    color: var(--color-text-muted);
  }

  .faq__toggle-icon--open {
    display: none;
    color: var(--color-accent);
  }

  .faq__item[open] .faq__toggle-icon--closed {
    display: none;
  }

  .faq__item[open] .faq__toggle-icon--open {
    display: inline-block;
  }

  /* Answer sits under the question with a clear gap and a hairline separator
     so it never reads as stuck to the question. */
  .faq__answer {
    padding: var(--space-md) var(--space-md-lg) var(--space-md-lg);
    margin-block-start: 0;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text);
    border-block-start: var(--border-hair);
  }

  .faq__answer p {
    margin: 0;
  }
</style>
