---
/* SRI Incident Reporter - Captures integrity failures and sends them to /csp-report */
---

<script is:inline nonce="NGINX_CSP_NONCE">
  /**
   * SRI Incident Reporter
   * Captures resource loading errors (like SRI failures) and reports them.
   */
  (function () {
    window.addEventListener(
      "error",
      function (e) {
        const target = e.target;
        // Only interested in elements with 'integrity' attribute (signed by us)
        if (
          target &&
          (target.tagName === "SCRIPT" || target.tagName === "LINK")
        ) {
          if (target.integrity) {
            const resourceUrl = target.src || target.href;

            // Avoid spam: do not report the same resource more than once per session
            const storageKey = "sri_fail_" + btoa(resourceUrl).substring(0, 16);
            if (sessionStorage.getItem(storageKey)) return;
            sessionStorage.setItem(storageKey, "1");

            console.error("[SRI] Integrity validation failed:", resourceUrl);

            // Send report mimicking CSP format for maximum compatibility
            const report = {
              "csp-report": {
                "document-uri": window.location.href,
                referrer: document.referrer,
                "violated-directive": "sri-integrity",
                "effective-directive": "sri",
                "original-policy": "SRI Validation",
                disposition: "enforce",
                "blocked-uri": resourceUrl,
                "status-code": 0,
                "script-sample": "SRI check failed",
              },
            };

            fetch("/csp-report", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(report),
              keepalive: true, // Ensures the request is sent even if the page is closed
            }).catch(function () {});
          }
        }
      },
      true,
    ); // 'true' (capture phase) is required to detect resource loading errors
  })();
</script>
