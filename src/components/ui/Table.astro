---
/**
 * Table Component
 * A reusable, styled table component for displaying structured data.
 *
 * ## Semantic Cell Attributes
 * Use `data-status` on `<td>` elements for colored status cells:
 *
 * ```html
 * <td data-status="success">Active</td>
 * <td data-status="error">Inactive</td>
 * <td data-status="warning">Pending</td>
 * <td data-status="info">Note</td>
 * ```
 *
 * ## Row Status
 * Use `data-status` on `<tr>` elements to highlight entire rows:
 *
 * ```html
 * <tr data-status="success">...</tr>
 * ```
 *
 * ## Usage Examples
 * ```astro
 * <Table title="Comparison">
 *   <thead>
 *     <tr><th>Feature</th><th>Support</th></tr>
 *   </thead>
 *   <tbody>
 *     <tr>
 *       <td>Feature A</td>
 *       <td data-status="success">Yes</td>
 *     </tr>
 *     <tr>
 *       <td>Feature B</td>
 *       <td data-status="error">No</td>
 *     </tr>
 *   </tbody>
 * </Table>
 * ```
 */
import { createHash } from "node:crypto";

import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  title?: string;
  id?: string; // Optional id for stable data-testid
  striped?: boolean;
  compact?: boolean;
  highlight?: boolean;
  bordered?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  title,
  id,
  striped = true,
  compact = false,
  highlight = true,
  bordered = false,
  ariaLabel: propAriaLabel,
  class: className,
} = Astro.props;

const slotContent = await Astro.slots.render("default");

// Wrap status cell content in pill spans (mockup pattern: pill inside td, no td background)
const processedContent = slotContent.replaceAll(
  /(<td\b[^>]*\bdata-status="[^"]*"[^>]*>)([\s\S]*?)(<\/td>)/gi,
  (_match, open, inner, close) =>
    `${open}<span data-pill>${inner}</span>${close}`,
);

// Use id prop if provided, otherwise generate from content hash
const uuid =
  id ||
  createHash("sha256")
    .update(`table-${title || ""}-${slotContent.slice(0, 100)}`)
    .digest("hex")
    .slice(0, 8);

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// When title is present, caption provides accessible name - don't duplicate with aria-label
// Only use aria-label when there's no caption (title)
const finalAriaLabel = title
  ? undefined
  : propAriaLabel || t("components.table.defaultAria");

const wrapperClasses = [
  "table-wrapper",
  striped && "striped",
  compact && "compact",
  highlight && "highlight",
  bordered && "bordered",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div
  class={wrapperClasses}
  data-testid={uuid}
>
  {
    /* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- Focusable so keyboard users can scroll wide tables (axe scrollable-region-focusable) */
  }
  <div
    class="table-container"
    role="group"
    tabindex="0"
    aria-label={finalAriaLabel}
  >
    {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
    <table aria-label={finalAriaLabel}>
      {title && <caption class="table-title">{title}</caption>}
      <Fragment set:html={processedContent} />
    </table>
  </div>
</div>

<style>
  /* ===========================================
     CSS CUSTOM PROPERTIES (Tokens)
     =========================================== */
  .table-wrapper {
    /* Surface tokens — theme-aware via the global Lab tokens. */
    --table-bg: var(--color-bg-secondary);
    --table-header-bg: var(--color-surface-2);
    --table-header-text: var(--color-text-heading);
    --table-row-odd: transparent;
    --table-row-even: var(--color-surface-2);
    --table-row-hover: var(--accent-dim);
    --table-border: var(--color-border);
    --table-hair: var(--color-hair);
    --table-text: var(--color-text);

    /* Base styles */
    margin: 1.5rem 0;
    overflow: hidden;
    background-color: var(--table-bg);
    border: 1px solid var(--table-border);
    border-radius: var(--radius-md);
  }

  /* Table caption (semantic title inside table element) */
  :global(.table-wrapper caption.table-title) {
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--table-header-text);
    text-align: left;
    letter-spacing: 0.02em;
    caption-side: top;
    background-color: var(--table-header-bg);
    border-bottom: 1px solid var(--table-border);
  }

  .table-container {
    overflow-x: auto;
  }

  /* ===========================================
     TABLE BASE STYLES
     =========================================== */
  table {
    width: 100%;
    min-width: 400px;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--table-text);
    border-collapse: collapse;
  }

  :global(.table-wrapper th),
  :global(.table-wrapper td) {
    padding: 0.75rem 1rem;
    vertical-align: middle;
    text-align: left;
  }

  .compact :global(th),
  .compact :global(td) {
    padding: 0.5rem 0.75rem;
  }

  /* ===========================================
     HEADER STYLES
     =========================================== */
  :global(.table-wrapper thead th) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background-color: var(--table-header-bg);
    border-bottom: 1px solid var(--table-hair);
  }

  /* ===========================================
     ROW STYLES - Better differentiation
     =========================================== */
  :global(.table-wrapper tbody tr) {
    background-color: var(--table-row-odd);
    border-bottom: 1px solid var(--table-hair);
    transition: background-color var(--dur-1) var(--ease-out);
  }

  :global(.table-wrapper tbody tr:last-child) {
    border-bottom: none;
  }

  /* Striped rows - Alternating backgrounds */
  .striped :global(tbody tr:nth-child(even)) {
    background-color: var(--table-row-even);
  }

  /* Row highlight on hover */
  .highlight :global(tbody tr:hover) {
    background-color: var(--table-row-hover);
  }

  /* Bordered variant */
  .bordered :global(th),
  .bordered :global(td) {
    border: 1px solid var(--table-border);
  }

  /* ===========================================
     SEMANTIC STATUS CELLS (data-status)
     Pill inside the cell; td itself has no background wash
     =========================================== */

  /* Pill base */
  :global(.table-wrapper td[data-status] span[data-pill]) {
    display: inline-block;
    padding: 3px 9px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    border-radius: var(--radius-sm);
  }

  /* Success pill */
  :global(.table-wrapper td[data-status="success"] span[data-pill]),
  :global(.table-wrapper td[data-status="ok"] span[data-pill]),
  :global(.table-wrapper td[data-status="yes"] span[data-pill]) {
    color: var(--color-success);
    background: color-mix(in srgb, var(--color-success) 14%, transparent);
  }

  /* Error pill */
  :global(.table-wrapper td[data-status="error"] span[data-pill]),
  :global(.table-wrapper td[data-status="no"] span[data-pill]),
  :global(.table-wrapper td[data-status="bad"] span[data-pill]) {
    color: var(--color-danger);
    background: color-mix(in srgb, var(--color-danger) 14%, transparent);
  }

  /* Warning pill */
  :global(.table-wrapper td[data-status="warning"] span[data-pill]),
  :global(.table-wrapper td[data-status="caution"] span[data-pill]),
  :global(.table-wrapper td[data-status="partial"] span[data-pill]) {
    color: var(--color-warning);
    background: color-mix(in srgb, var(--color-warning) 14%, transparent);
  }

  /* Info pill */
  :global(.table-wrapper td[data-status="info"] span[data-pill]),
  :global(.table-wrapper td[data-status="note"] span[data-pill]) {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
  }

  /* Row-level status (entire row tint) */
  :global(.table-wrapper tbody tr[data-status="success"]) {
    background-color: color-mix(
      in srgb,
      var(--color-success) 10%,
      transparent
    ) !important;
  }

  :global(.table-wrapper tbody tr[data-status="error"]) {
    background-color: color-mix(
      in srgb,
      var(--color-danger) 10%,
      transparent
    ) !important;
  }

  :global(.table-wrapper tbody tr[data-status="warning"]) {
    background-color: color-mix(
      in srgb,
      var(--color-warning) 10%,
      transparent
    ) !important;
  }

  /* ===========================================
     CONTENT STYLING
     =========================================== */

  /* First column emphasis */
  :global(.table-wrapper tbody td:first-child) {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--table-header-text);
  }

  /* Code in tables */
  :global(.table-wrapper code) {
    padding: 0.15rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-text);
    background-color: var(--color-surface-2);
    border-radius: var(--radius-sm);
  }

  /* Strong text in tables */
  :global(.table-wrapper strong) {
    font-weight: 600;
    color: var(--table-header-text);
  }

  /* ===========================================
     RESPONSIVE
     =========================================== */
  @media (width <= 600px) {
    table {
      font-size: 0.8rem;
    }

    :global(.table-wrapper th),
    :global(.table-wrapper td) {
      padding: 0.6rem 0.75rem;
    }

    :global(.table-wrapper thead th) {
      font-size: 0.7rem;
    }
  }
</style>
