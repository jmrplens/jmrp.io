---
/**
 * DecisionTree Component
 * Interactive expandable decision tree for guiding readers.
 */
import { randomBytes } from "node:crypto";

interface Props {
  question: string;
}

const { question } = Astro.props;
const uniqueId = randomBytes(4).toString("hex");
---

<div class="decision-tree">
  <div
    class="dt-question"
    id={`dt-question-${uniqueId}`}
  >
    <span class="dt-question-text">{question}</span>
  </div>
  <div
    class="dt-options"
    role="group"
    aria-labelledby={`dt-question-${uniqueId}`}
  >
    <slot />
  </div>
</div>

<style>
  .decision-tree {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .dt-question {
    padding: 0.875rem 1.125rem;
    border-bottom: 1px solid var(--color-hair);
  }

  .dt-question-text {
    font-size: var(--text-base);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    color: var(--color-text-heading);
  }

  .dt-options {
    display: flex;
    flex-direction: column;
  }

  /* Style for child elements - expected to be details/summary pairs.
     Options sit flush inside the card, separated by hairlines. */
  .dt-options :global(details) {
    border-bottom: 1px solid var(--color-hair);
  }

  .dt-options :global(details:last-child) {
    border-bottom: none;
  }

  .dt-options :global(summary) {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    padding: 0.8rem 1.125rem;
    font-size: var(--text-sm);
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    transition: background-color 0.2s;
  }

  .dt-options :global(summary::-webkit-details-marker) {
    display: none;
  }

  .dt-options :global(summary:hover) {
    background: var(--color-bg-subtle);
  }

  .dt-options :global(summary:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    background: var(--color-bg-subtle);
  }

  /* Triangle marker rotates on open — a non-colour cue for expanded state
     that complements the native aria-expanded on <details>. */
  .dt-options :global(summary::before) {
    display: inline-block;
    font-size: 0.7em;
    line-height: 1.5;
    color: var(--color-accent);
    content: "▸";
    transition: transform 0.2s;
  }

  .dt-options :global(details[open] summary::before) {
    transform: rotate(90deg);
  }

  .dt-options :global(details > div),
  .dt-options :global(details > p) {
    padding: 0 1.125rem 0.875rem 2.5rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text);
  }

  .dt-options :global(details > p:first-of-type) {
    margin-top: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .dt-options :global(summary::before) {
      transition: none;
    }
  }
</style>
