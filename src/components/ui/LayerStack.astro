---
/**
 * LayerStack Component
 *
 * A vertical stack of labelled bands for hardware/software layers, abstraction
 * levels, an OSI model, a boot sequence, etc. Each layer is a colored band
 * with a name and an optional side note. Top layer first.
 *
 * @example
 * <LayerStack
 *   title="Firmware stack"
 *   layers={[
 *     { name: "Application", note: "your code" },
 *     { name: "HAL", note: "vendor drivers" },
 *     { name: "Registers / silicon" },
 *   ]}
 * />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Layer {
  /** Layer name. */
  name: string;
  /** Optional note shown beside the band. */
  note?: string;
  /** Optional CSS color override; otherwise cycles a palette. */
  color?: string;
}

interface Props {
  /** Optional title. */
  title?: string;
  /** Layers, top to bottom. */
  layers: Layer[];
  /** Caption below the figure. */
  caption?: string;
  /** Accessibility label. */
  ariaLabel?: string;
}

const { title, layers, caption, ariaLabel } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Neutral surface bands by default; the top layer (or any layer given an
// explicit `color`) is accented — an accent-tinted band with a coloured border,
// matching the emphasized top layer in the design mockup.
const resolved = layers.map((l, i) => ({
  ...l,
  accent: i === 0 || l.color != null,
  accentColor: l.color ?? "var(--color-accent)",
}));

const summary =
  ariaLabel ??
  (title
    ? t("components.layerStack.ariaWithTitle", {
        title,
        count: String(layers.length),
      })
    : t("components.layerStack.ariaWithoutTitle", {
        count: String(layers.length),
      }));
---

<div
  class="layers"
  role="img"
  aria-label={summary}
>
  {title && <div class="layers__title">{title}</div>}

  <ol class="layers__stack">
    {
      resolved.map((l) => (
        <li
          class:list={["layers__band", l.accent && "layers__band--accent"]}
          style={l.accent ? `--ls-accent:${l.accentColor}` : undefined}
        >
          <span class="layers__name">{l.name}</span>
          {l.note && <span class="layers__note">{l.note}</span>}
        </li>
      ))
    }
  </ol>

  {caption && <p class="layers__caption">{caption}</p>}
</div>

<style>
  .layers {
    margin: 1.5rem 0;
  }

  .layers__title {
    margin-bottom: 1rem;
    font-size: var(--text-md);
    font-weight: var(--fw-semibold, 600);
    color: var(--color-text-heading);
  }

  .layers__stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 32rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .layers__band {
    display: flex;
    column-gap: 1rem;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    padding: 0.75rem 1rem;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .layers__band--accent {
    background: color-mix(
      in srgb,
      var(--ls-accent, var(--color-accent)) 13%,
      transparent
    );
    border-color: var(--ls-accent, var(--color-accent));
  }

  .layers__name {
    font-size: var(--text-sm);
    font-weight: var(--fw-medium, 500);
    color: var(--color-text-heading);
  }

  .layers__note {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
    text-align: right;
  }

  .layers__band--accent .layers__note {
    color: var(--ls-accent, var(--color-accent));
  }

  .layers__caption {
    margin-top: 1rem;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
