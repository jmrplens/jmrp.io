---
/**
 * DeprecatedNotice Component
 * Banner for deprecation notices with alternative recommendations.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  feature: string;
  alternative?: string;
  alternativeUrl?: string;
  removalDate?: string;
}

const { feature, alternative, alternativeUrl, removalDate } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Warn if alternativeUrl is provided without alternative (the URL would be ignored)
if (import.meta.env.DEV && alternativeUrl && !alternative) {
  console.warn(
    `[DeprecatedNotice] alternativeUrl provided without alternative for "${feature}". The URL will be ignored.`,
  );
}
---

<aside
  class="deprecated-notice"
  role="note"
  aria-label={t("components.deprecated.isDeprecated", { feature })}
>
  <div class="dn-header">
    <span class="dn-title">{t("components.deprecated.label")}</span>
  </div>
  <div class="dn-content">
    <p class="dn-message">
      <code>{feature}</code>
      {t("components.stateNotice.isDeprecated").trim()}{
        removalDate && (
          <span class="dn-removal">
            {t("components.deprecated.willBeRemoved", { date: removalDate })}
          </span>
        )
      }.
    </p>
    {
      alternative && (
        <p class="dn-alternative">
          <span class="dn-label">{t("components.deprecated.useInstead")}</span>
          {alternativeUrl ? (
            <a
              href={alternativeUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <code>{alternative}</code>
            </a>
          ) : (
            <code>{alternative}</code>
          )}
        </p>
      )
    }
    <slot />
  </div>
</aside>

<style>
  /* Flat, horizontal deprecation notice: solid danger pill on the left, message
     filling the rest. Border + fill are danger-tinted; the danger token is
     AA-safe in both themes (light/dark handled centrally in global.css). */
  .deprecated-notice {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 14px 18px;
    margin: var(--space-md-lg) 0;
    background: color-mix(
      in srgb,
      var(--color-danger) 7%,
      var(--color-bg-secondary)
    );
    border: 1px solid
      color-mix(in srgb, var(--color-danger) 35%, var(--color-border));
    border-radius: var(--radius-md);
  }

  /* Solid status pill: mono uppercase label on danger. */
  .dn-header {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    padding: 4px 9px;
    background: var(--color-danger);
    border-radius: var(--radius-sm);
  }

  .dn-title {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--fw-medium);
    color: var(--color-on-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .dn-content {
    flex: 1;
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-text);
  }

  .dn-message {
    margin: 0;
  }

  .dn-message code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-text-heading);
  }

  .dn-removal {
    color: var(--color-text-muted);
  }

  .dn-alternative {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin: 0.375rem 0 0;
  }

  .dn-label {
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
  }

  .dn-alternative code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-success);
  }

  .dn-alternative a {
    text-decoration: none;
  }

  .dn-alternative a:hover code,
  .dn-alternative a:focus code,
  .dn-alternative a:focus-visible code {
    text-decoration: underline;
  }

  .dn-alternative a:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>
