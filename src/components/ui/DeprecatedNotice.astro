---
/**
 * DeprecatedNotice Component
 * Banner for deprecation notices with alternative recommendations.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  feature: string;
  alternative?: string;
  alternativeUrl?: string;
  removalDate?: string;
}

const { feature, alternative, alternativeUrl, removalDate } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Warn if alternativeUrl is provided without alternative (the URL would be ignored)
if (import.meta.env.DEV && alternativeUrl && !alternative) {
  console.warn(
    `[DeprecatedNotice] alternativeUrl provided without alternative for "${feature}". The URL will be ignored.`,
  );
}
---

<aside
  class="deprecated-notice"
  role="note"
  aria-label={t("components.deprecated.isDeprecated", { feature })}
>
  <div class="dn-header">
    <span
      class="i-mdi:alert-octagon dn-icon"
      aria-hidden="true"
    ></span>
    <span class="dn-title">{t("components.deprecated.label")}</span>
  </div>
  <div class="dn-content">
    <p class="dn-message">
      <code>{feature}</code>
      {t("components.stateNotice.isDeprecated").trim()}{
        removalDate && (
          <span class="dn-removal">
            {t("components.deprecated.willBeRemoved", { date: removalDate })}
          </span>
        )
      }.
    </p>
    {
      alternative && (
        <p class="dn-alternative">
          <span class="dn-label">{t("components.deprecated.useInstead")}</span>
          {alternativeUrl ? (
            <a
              href={alternativeUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <code>{alternative}</code>
            </a>
          ) : (
            <code>{alternative}</code>
          )}
        </p>
      )
    }
    <slot />
  </div>
</aside>

<style>
  .deprecated-notice {
    padding: var(--space-md);
    margin: var(--space-md-lg) 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-hair);
    border-left: 4px solid #ef4444;
    border-radius: var(--radius-md);
    box-shadow: var(--sh-card);
  }

  /* Header collapses into a Lab status pill: icon (shape cue) + mono label. */
  .dn-header {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    padding: 0.1875rem 0.5rem;
    margin-bottom: var(--space-sm);
    background: rgb(239 68 68 / 15%);
    border: 1px solid rgb(239 68 68 / 32%);
    border-radius: var(--radius-sm);
  }

  .dn-icon {
    width: 15px;
    height: 15px;
    color: #b91c1c;
  }

  .dn-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    color: #b91c1c;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .dn-content {
    padding: 0;
  }

  .dn-message {
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .dn-message code {
    padding: 0.125rem 0.375rem;
    color: #ef4444;
    background: rgb(239 68 68 / 15%);
    border-radius: var(--radius-sm);
  }

  .dn-removal {
    color: var(--color-text-muted);
  }

  .dn-alternative {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin: 0;
    color: var(--color-text);
  }

  .dn-label {
    font-size: 0.85rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
  }

  .dn-alternative code {
    padding: 0.125rem 0.375rem;
    color: #047857;
    background: rgb(16 185 129 / 15%);
    border-radius: var(--radius-sm);
  }

  .dn-alternative a {
    text-decoration: none;
  }

  .dn-alternative a:hover code,
  .dn-alternative a:focus code,
  .dn-alternative a:focus-visible code {
    text-decoration: underline;
  }

  .dn-alternative a:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Dark mode: lift reds/greens to the 400 scale for WCAG AA (≥4.5:1) on the
     neutral surface. Mirrors StateNotice's dark-first override pattern. */
  :root[data-theme="dark"] .dn-icon,
  :root[data-theme="dark"] .dn-title,
  :root[data-theme="dark"] .dn-message code {
    color: #f87171; /* red-400, ~5.5:1 */
  }

  :root[data-theme="dark"] .dn-alternative code {
    color: #34d399; /* emerald-400, ~7.2:1 */
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .dn-icon,
    :root:not([data-theme]) .dn-title,
    :root:not([data-theme]) .dn-message code {
      color: #f87171;
    }

    :root:not([data-theme]) .dn-alternative code {
      color: #34d399;
    }
  }
</style>
