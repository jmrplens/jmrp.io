---
/**
 * DeprecatedNotice Component
 * Banner for deprecation notices with alternative recommendations.
 */
interface Props {
  feature: string;
  alternative?: string;
  alternativeUrl?: string;
  removalDate?: string;
}

const { feature, alternative, alternativeUrl, removalDate } = Astro.props;
---

<aside
  class="deprecated-notice"
  role="alert"
  aria-label={`${feature} is deprecated`}
>
  <div class="dn-header">
    <span
      class="i-mdi:alert-octagon dn-icon"
      aria-hidden="true"
    ></span>
    <span class="dn-title">Deprecated</span>
  </div>
  <div class="dn-content">
    <p class="dn-message">
      <code>{feature}</code> is deprecated
      {
        removalDate && (
          <span class="dn-removal">and will be removed in {removalDate}</span>
        )
      }.
    </p>
    {
      alternative && (
        <p class="dn-alternative">
          <span class="dn-label">Use instead:</span>
          {alternativeUrl ? (
            <a
              href={alternativeUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <code>{alternative}</code>
            </a>
          ) : (
            <code>{alternative}</code>
          )}
        </p>
      )
    }
    <slot />
  </div>
</aside>

<style>
  .deprecated-notice {
    margin: 1.5rem 0;
    overflow: hidden;
    background: rgb(239 68 68 / 8%);
    border: 1px solid rgb(239 68 68 / 30%);
    border-radius: var(--radius-md);
  }

  .dn-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.625rem 1rem;
    background: rgb(239 68 68 / 15%);
    border-bottom: 1px solid rgb(239 68 68 / 20%);
  }

  .dn-icon {
    width: 20px;
    height: 20px;
    color: #ef4444;
  }

  .dn-title {
    font-size: 0.85rem;
    font-weight: var(--fw-bold);
    color: #ef4444;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .dn-content {
    padding: 0.875rem 1rem;
  }

  .dn-message {
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .dn-message code {
    padding: 0.125rem 0.375rem;
    color: #ef4444;
    background: rgb(239 68 68 / 15%);
    border-radius: var(--radius-sm);
  }

  .dn-removal {
    color: var(--color-text-muted);
  }

  .dn-alternative {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin: 0;
    color: var(--color-text);
  }

  .dn-label {
    font-size: 0.85rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
  }

  .dn-alternative code {
    padding: 0.125rem 0.375rem;
    color: #10b981;
    background: rgb(16 185 129 / 15%);
    border-radius: var(--radius-sm);
  }

  .dn-alternative a {
    text-decoration: none;
  }

  .dn-alternative a:hover code {
    text-decoration: underline;
  }
</style>
