---
/**
 * DeprecatedNotice Component
 * Banner for deprecation notices with alternative recommendations.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  feature: string;
  alternative?: string;
  alternativeUrl?: string;
  removalDate?: string;
}

const { feature, alternative, alternativeUrl, removalDate } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Warn if alternativeUrl is provided without alternative (the URL would be ignored)
if (import.meta.env.DEV && alternativeUrl && !alternative) {
  console.warn(
    `[DeprecatedNotice] alternativeUrl provided without alternative for "${feature}". The URL will be ignored.`,
  );
}
---

<aside
  class="deprecated-notice"
  role="note"
  aria-label={t("components.deprecated.isDeprecated", { feature })}
>
  <div class="dn-header">
    <span
      class="i-mdi:alert-octagon dn-icon"
      aria-hidden="true"
    ></span>
    <span class="dn-title">{t("components.deprecated.label")}</span>
  </div>
  <div class="dn-content">
    <p class="dn-message">
      <code>{feature}</code>
      {t("components.stateNotice.isDeprecated").trim()}{
        removalDate && (
          <span class="dn-removal">
            {t("components.deprecated.willBeRemoved", { date: removalDate })}
          </span>
        )
      }.
    </p>
    {
      alternative && (
        <p class="dn-alternative">
          <span class="dn-label">{t("components.deprecated.useInstead")}</span>
          {alternativeUrl ? (
            <a
              href={alternativeUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <code>{alternative}</code>
            </a>
          ) : (
            <code>{alternative}</code>
          )}
        </p>
      )
    }
    <slot />
  </div>
</aside>

<style>
  .deprecated-notice {
    margin: 1.5rem 0;
    overflow: hidden;
    background: rgb(239 68 68 / 8%);
    border: 1px solid rgb(239 68 68 / 30%);
    border-radius: var(--radius-md);
  }

  .dn-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.625rem 1rem;
    background: rgb(239 68 68 / 15%);
    border-bottom: 1px solid rgb(239 68 68 / 20%);
  }

  .dn-icon {
    width: 20px;
    height: 20px;
    color: #b91c1c;
  }

  .dn-title {
    font-size: 0.85rem;
    font-weight: var(--fw-bold);
    color: #b91c1c;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .dn-content {
    padding: 0.875rem 1rem;
  }

  .dn-message {
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .dn-message code {
    padding: 0.125rem 0.375rem;
    color: #ef4444;
    background: rgb(239 68 68 / 15%);
    border-radius: var(--radius-sm);
  }

  .dn-removal {
    color: var(--color-text-muted);
  }

  .dn-alternative {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin: 0;
    color: var(--color-text);
  }

  .dn-label {
    font-size: 0.85rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
  }

  .dn-alternative code {
    padding: 0.125rem 0.375rem;
    color: #047857;
    background: rgb(16 185 129 / 15%);
    border-radius: var(--radius-sm);
  }

  .dn-alternative a {
    text-decoration: none;
  }

  .dn-alternative a:hover code,
  .dn-alternative a:focus code,
  .dn-alternative a:focus-visible code {
    text-decoration: underline;
  }

  .dn-alternative a:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>
