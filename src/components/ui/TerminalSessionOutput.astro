---
/**
 * TerminalSessionOutput — the output of a command inside <TerminalSession>.
 * Indented under the command and NOT included in "copy commands". Mark
 * success/error lines with <span class="jmrp-term__ok|__err"> if desired.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import { decodeHtml } from "@utils/html";
import * as cheerio from "cheerio";

interface Props {
  title?: string;
  ariaLabel?: string;
}

const { title, ariaLabel } = Astro.props;

let lines: string[] = [];
if (Astro.slots.has("default")) {
  const htmlContent = await Astro.slots.render("default");
  const $ = cheerio.load(htmlContent);
  $("br").replaceWith("\n");
  $("p, div, li, h1, h2, h3, h4, h5, h6").each((_, el) => {
    $(el).append("\n");
  });
  const processed = decodeHtml($.text()).trim();
  if (processed) lines = processed.split(/\r?\n/);
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const finalAriaLabel =
  ariaLabel ||
  (title
    ? t("components.terminal.outputTitle", { title })
    : t("components.terminal.outputFallback"));
---

<section
  class="ts-output"
  role="log"
  aria-live="polite"
  aria-label={finalAriaLabel}
>
  {
    title && (
      <div
        class="ts-output__title"
        aria-hidden="true"
      >
        {title}
      </div>
    )
  }
  <div class="term-line-out">
    {
      /* One block per line so line breaks survive HTML minification. */
      lines.map((line) => (
        <span class="ts-output__line">{line || "\u{A0}"}</span>
      ))
    }
  </div>
</section>

<style>
  .ts-output__title {
    padding: 6px 0 2px 20px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--term-dim);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .ts-output__line {
    display: block;
    min-height: 1.4em;
  }
</style>
