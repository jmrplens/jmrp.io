---
/**
 * FileContent — a real file's contents inside a file-like frame (icon + path +
 * copy). `collapsible` turns the header into a native <details>/<summary>.
 *
 * Syntax highlighting is Shiki (project config); this only provides the chrome.
 * The header GROWS if the path is long (wrap), never truncates with "…".
 *
 * Usage:
 *   <FileContent filename="/etc/nginx/security.conf" language="nginx">…</FileContent>
 *   <FileContent filename="docker-compose.yml" collapsible>…</FileContent>
 */
import { createHash } from "node:crypto";

import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import { decodeHtml } from "@utils/html";
import { highlightCode, resolveShikiLanguage } from "@utils/shiki";
import type { BuiltinLanguage, SpecialLanguage } from "shiki";

import CopyButton from "./CopyButton.astro";

interface Props {
  filename: string;
  language?: BuiltinLanguage | SpecialLanguage | string;
  collapsible?: boolean;
  open?: boolean;
  ariaLabel?: string;
}

const {
  filename,
  language,
  collapsible = false,
  open = false,
  ariaLabel,
} = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Zero-width space after "/" so long paths wrap cleanly (never truncated).
const filenameFormatted = filename.replaceAll("/", "/&#8203;");

const slotContent = await Astro.slots.render("default");
// Strip wrapper-level tabindex to avoid double focus (the scroll region owns it).
const trimmedContent = slotContent
  .trim()
  .replaceAll(/(<[^>]+)\s+tabindex=(["'])0\2/g, "$1");

// Plain code text (for copy + line count), unwrapping any <pre><code> fence.
const preCodeMatch = trimmedContent.match(
  /<pre[^>]*><code[^>]*>([\s\S]*?)<\/code><\/pre>/,
);
const codeText = decodeHtml(
  (preCodeMatch ? preCodeMatch[1] : trimmedContent).replaceAll(/<[^>]*>/g, ""),
).trim();
const lineCount = codeText ? codeText.split(/\r?\n/).length : 0;

const uuid = createHash("sha256")
  .update(`${filename}-${trimmedContent}`)
  .digest("hex")
  .slice(0, 8);
const uuidShort = uuid.slice(0, 4);

let plainText = "";
if (!ariaLabel) {
  plainText = codeText.length > 50 ? codeText.slice(0, 50) + "..." : codeText;
}
const finalAriaLabel =
  ariaLabel ||
  `${filename} - ${plainText}${plainText ? " " : ""}(id ${uuidShort})`;

const highlightedHtml = language
  ? await highlightCode(codeText, resolveShikiLanguage(language))
  : "";
const copyAria = t("components.fileContent.copyContent", { filename });
const linesText = `${lineCount} ${t("ui.lines")}`;
---

{
  collapsible ? (
    <div
      class="jmrp-file file-content-wrapper jmrp-file--collapsible copy-container"
      data-testid={uuid}
    >
      {/* Copy button OUTSIDE <details> to avoid a nested-interactive control. */}
      <CopyButton
        class="jmrp-file__copy"
        content={codeText}
        ariaLabel={copyAria}
      />
      <details
        class="jmrp-file__details"
        open={open}
        aria-label={finalAriaLabel}
      >
        <summary class="jmrp-file__head">
          <span class="jmrp-file__id">
            <svg
              class="jmrp-file__chev"
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              aria-hidden="true"
            >
              <path d="m9 6 6 6-6 6" />
            </svg>
            <svg
              class="jmrp-file__icon"
              viewBox="0 0 24 24"
              width="15"
              height="15"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M14 3v5h5M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            </svg>
            <span
              class="jmrp-file__name"
              set:html={filenameFormatted}
            />
          </span>
          <span class="jmrp-file__meta">
            <span class="jmrp-file__lines">{linesText}</span>
          </span>
        </summary>
        <div class="jmrp-file__body">
          {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- focusable scroll region */}
          <div
            role="region"
            tabindex="0"
            aria-label={t("aria.codeContent", {
              filename: `${filename} (${uuid})`,
            })}
            class="jmrp-file__scroll file-code-container"
          >
            {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
            {language ? (
              <Fragment set:html={highlightedHtml} />
            ) : (
              <div set:html={trimmedContent} />
            )}
          </div>
        </div>
      </details>
    </div>
  ) : (
    <section
      class="jmrp-file file-content-wrapper copy-container"
      aria-label={finalAriaLabel}
      data-testid={uuid}
    >
      <div class="jmrp-file__head">
        <span class="jmrp-file__id">
          <svg
            class="jmrp-file__icon jmrp-file__icon--accent"
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d="M14 3v5h5M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          </svg>
          <span
            class="jmrp-file__name"
            set:html={filenameFormatted}
          />
        </span>
        <CopyButton
          content={codeText}
          ariaLabel={copyAria}
        />
      </div>
      <div class="jmrp-file__body">
        {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- focusable scroll region */}
        <div
          role="region"
          tabindex="0"
          aria-label={t("aria.codeContent", {
            filename: `${filename} (${uuid})`,
          })}
          class="jmrp-file__scroll file-code-container"
        >
          {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
          {language ? (
            <Fragment set:html={highlightedHtml} />
          ) : (
            <div set:html={trimmedContent} />
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .jmrp-file {
    position: relative;
    margin: var(--space-md-lg) 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-lg);
  }

  .jmrp-file__details {
    display: block;
    width: 100%;
  }

  .jmrp-file__head {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    padding: var(--code-header-py) 12px var(--code-header-py) 16px;
    background: var(--color-surface-2);
    border-bottom: var(--border-hair);
  }

  .jmrp-file__id {
    display: flex;
    flex: 1;
    gap: 9px;
    align-items: center;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--code-filename-size);
    line-height: 1.5;
    color: var(--color-text-heading);
  }

  .jmrp-file__icon {
    flex: none;
    font-size: 15px;
    color: var(--color-text-muted);
  }

  .jmrp-file__icon--accent {
    color: var(--color-accent);
  }

  .jmrp-file__name {
    font-weight: var(--fw-medium);
    overflow-wrap: anywhere; /* long paths wrap, never truncated */
  }

  .jmrp-file__meta {
    display: flex;
    flex: none;
    gap: 8px;
    align-items: center;
  }

  .jmrp-file__lines {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-meta);
  }

  .jmrp-file__body {
    padding: 0;
  }

  .jmrp-file__scroll {
    overflow-x: auto;
    outline: none;
  }

  .jmrp-file__scroll:focus-visible {
    outline: 2px solid transparent;
    box-shadow: inset 0 0 0 2px var(--color-primary);
  }

  /* Non-highlighted slot (no `language`) needs its own padding/typography since
     it isn't a Shiki <pre> (which code-terminal.css pads). */
  .jmrp-file__scroll > div:not(.astro-code) {
    padding: var(--code-pad);
    font-family: var(--font-mono);
    font-size: var(--code-font-size);
    line-height: var(--code-line-height);
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  /* ---- collapsible ---- */
  .jmrp-file--collapsible > .jmrp-file__details > summary {
    cursor: pointer;
    list-style: none;
  }

  .jmrp-file--collapsible summary::-webkit-details-marker {
    display: none;
  }

  .jmrp-file--collapsible summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .jmrp-file__chev {
    flex: none;
    color: var(--color-accent);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .jmrp-file__details[open] > summary .jmrp-file__chev {
    transform: rotate(90deg);
  }

  /* Copy button pinned top-right of the collapsible variant, OUTSIDE <details>
     (avoids a nested interactive control inside <summary>). :global because the
     class lands on the child CopyButton's own element. Vertically aligned with
     the header's first line. */
  :global(.jmrp-file__copy) {
    position: absolute;
    top: 5px;
    right: 10px;
    z-index: 1;
  }

  /* Reserve room on the WHOLE summary row so the line count never slides under
     the absolute copy button (they used to overlap). */
  .jmrp-file--collapsible .jmrp-file__head {
    padding-right: 46px;
  }

  @media (prefers-reduced-motion: reduce) {
    .jmrp-file__chev {
      transition: none;
    }
  }
</style>
