---
/**
 * FileContent Component
 * Displays code content inside a file-like window frame with a filename header.
 *
 * Usage:
 * <FileContent filename="nginx.conf">
 *   ...code...
 * </FileContent>
 *
 * With explicit language for syntax highlighting:
 * <FileContent filename="config.txt" language="nginx">
 *   ...nginx config...
 * </FileContent>
 */
import { createHash } from "node:crypto";

import { decodeHtml } from "@utils/html";
import { getIconForFile } from "@utils/icons";
import { resolveShikiLanguage } from "@utils/shiki";
import { Code as AstroCode } from "astro/components";
import type { BuiltinLanguage, SpecialLanguage } from "shiki";

import CopyButton from "./CopyButton.astro";

interface Props {
  filename: string;
  icon?: string; // e.g., 'mdi-file-document-outline' (prepends 'i-' internally)
  language?: BuiltinLanguage | SpecialLanguage | string; // Override syntax highlighting language
  collapsible?: boolean;
  ariaLabel?: string;
}

const {
  filename,
  icon,
  language,
  collapsible = false,
  ariaLabel,
} = Astro.props;

// Infer icon from filename
const finalIcon = icon || getIconForFile(filename);

// Format filename to allow line breaks after path separators
// Insert zero-width space (&#8203;) after slashes for smart wrapping
const filenameFormatted = filename.replaceAll("/", "/&#8203;");

const slotContent = await Astro.slots.render("default");
const trimmedContent = slotContent.trim();
const uuid = createHash("sha256")
  .update(`${filename}-${trimmedContent}`)
  .digest("hex")
  .slice(0, 8);

// Extract plain text for accessibility label if no custom label provided
let plainText = "";
if (!ariaLabel) {
  // FAST PATH: Use regex for simple content to avoid Cheerio overhead
  const fullText =
    !slotContent.includes("<") && !slotContent.includes(">")
      ? slotContent.trim()
      : decodeHtml(slotContent.replaceAll(/<[^>]+>/g, "").trim());
  // Only truncate and add ellipsis if content exceeds 50 characters
  plainText = fullText.length > 50 ? fullText.slice(0, 50) + "..." : fullText;
}

const finalAriaLabel = ariaLabel || `${filename} - ${plainText}`;

// If language is specified, extract raw code for Shiki re-rendering
let rawCode = "";
let useCustomHighlighting = false;

if (language) {
  useCustomHighlighting = true;
  // Extract raw code from the rendered content
  // Content may be wrapped in <pre><code>...</code></pre> from markdown
  const preCodeMatch = trimmedContent.match(
    /<pre[^>]*><code[^>]*>([\s\S]*?)<\/code><\/pre>/,
  );
  if (preCodeMatch) {
    // Remove any remaining HTML tags and decode entities
    const stripped = preCodeMatch[1].replaceAll(/<[^>]*>/g, "");
    rawCode = decodeHtml(stripped);
  } else {
    // Fallback: strip all tags and decode
    const stripped = trimmedContent.replaceAll(/<[^>]*>/g, "");
    rawCode = decodeHtml(stripped);
  }
}
---

{
  collapsible ? (
    <div
      class="file-content-wrapper copy-container collapsible"
      data-testid={uuid}
    >
      {/* Copy Button outside details to be always visible and avoid nested interactive violation */}
      <CopyButton
        class="file-header-copy-btn absolute-header"
        ariaLabel={`Copy content of ${filename}`}
      />
      <details class="file-details">
        {/* ARIA label moved to summary for better support */}
        <summary
          class="file-header"
          aria-label={finalAriaLabel}
        >
          <span class="file-info">
            <span
              class={`${finalIcon.startsWith("i-") ? finalIcon : `i-${finalIcon}`} file-icon`}
            />
            <span
              class="file-name"
              set:html={filenameFormatted}
            />
          </span>
          <span class="header-actions">
            <span
              class="chevron-wrapper"
              aria-hidden="true"
            >
              <svg
                class="chevron-icon"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </span>
          </span>
        </summary>
        <div class="file-body">
          {useCustomHighlighting ? (
            <AstroCode
              code={rawCode}
              lang={resolveShikiLanguage(language as string)}
              themes={{
                light: "github-light-high-contrast",
                dark: "github-dark-high-contrast",
              }}
            />
          ) : (
            <div
              tabindex="0"
              aria-label={`Code content for ${filename}`}
              set:html={trimmedContent}
            />
          )}
        </div>
      </details>
    </div>
  ) : (
    <section
      class="file-content-wrapper copy-container"
      aria-label={finalAriaLabel}
      data-testid={uuid}
    >
      <div class="file-header">
        <div class="file-info">
          <span
            class={`${finalIcon.startsWith("i-") ? finalIcon : `i-${finalIcon}`} file-icon`}
          />
          <span
            class="file-name"
            set:html={filenameFormatted}
          />
        </div>
        <div class="header-actions">
          <CopyButton
            class="file-header-copy-btn"
            ariaLabel={`Copy content of ${filename}`}
          />
        </div>
      </div>
      <div class="file-body">
        {useCustomHighlighting ? (
          <AstroCode
            code={rawCode}
            lang={resolveShikiLanguage(language as string)}
            themes={{
              light: "github-light-high-contrast",
              dark: "github-dark-high-contrast",
            }}
          />
        ) : (
          <div
            tabindex="0"
            aria-label={`Code content for ${filename}`}
            set:html={trimmedContent}
          />
        )}
      </div>
    </section>
  )
}

<style>
  .file-content-wrapper {
    position: relative;
    margin: 1.5rem 0;
    overflow: hidden; /* Keep children within rounded corners */
    background-color: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .file-details {
    display: block;
    width: 100%;
  }

  .file-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between; /* Push actions to the right */
    min-height: 48px;
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg-header);
    border-bottom: var(--border-1);
    transition: background-color 0.2s;
  }

  .file-content-wrapper.collapsible .file-header {
    cursor: pointer;
    list-style: none; /* Remove default marker */
  }

  .file-content-wrapper.collapsible .file-header::-webkit-details-marker {
    display: none; /* Remove default marker for Safari */
  }

  .file-content-wrapper.collapsible .file-header:hover {
    color: var(--color-text);
    background-color: var(--color-bg-secondary);
  }

  .file-details[open] .file-header {
    color: var(--color-text);
    background-color: var(--color-bg-secondary);
  }

  .file-info {
    display: flex;
    flex: 1;
    gap: 0.5rem;
    align-items: center;
    min-width: 0; /* Enable text truncation for flex children */
  }

  /* Reserve space for copy button + chevron in collapsible mode */
  .file-content-wrapper.collapsible .file-info {
    padding-right: 2.5rem; /* Space for copy button positioned absolutely */
  }

  .file-name {
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .header-actions {
    display: flex;
    flex-shrink: 0;
    gap: 0.75rem;
    align-items: center;
  }

  .file-icon {
    flex-shrink: 0;
    font-size: 1.3rem;
  }

  .chevron-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .file-details[open] .chevron-wrapper {
    transform: rotate(180deg);
  }

  .file-body {
    padding: 0;

    /* Removed overflow: hidden to allow child scrollbars to be fully visible/interactive */
  }

  .file-body > div {
    /* Removed padding to let pre element fill the space naturally */
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    line-height: 1.6;

    /* Removed white-space: pre-wrap; as it conflicts with pre's own handling */
    outline: none;
  }

  /* Style the <pre> element that comes from the slot */
  .file-body :global(pre),
  .file-body :global(.astro-code) {
    display: block;
    width: 100%;
    padding: 1rem 1.25rem !important;
    margin: 0 !important;
    overflow-x: auto;

    /* Typography */
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;

    /* Mobile Fix: Prevent font inflation */
    text-size-adjust: none;
  }

  /* Accessibility: Boost contrast in light mode */
  :root:not([data-theme="dark"]) .file-content-wrapper {
    background-color: var(--color-bg-secondary);
    border-color: var(--color-border);
  }

  :root:not([data-theme="dark"]) .file-body :global(pre),
  :root:not([data-theme="dark"]) .file-body :global(.astro-code) {
    background-color: var(--color-bg-secondary) !important;
  }

  /* Dark mode adjustments */
  :root[data-theme="dark"] .file-content-wrapper {
    background-color: var(--color-bg-secondary);
  }

  :root[data-theme="dark"] .file-body :global(pre) {
    background-color: transparent !important;
  }

  /* Override copy button positioning for header integration */
  :global(.file-header-copy-btn) {
    position: static !important;
  }

  :global(.file-header-copy-btn.absolute-header) {
    --file-header-copy-offset: 2.8rem;

    position: absolute !important;
    top: 0.5rem;
    right: var(--file-header-copy-offset);
    z-index: 10;
  }
</style>
