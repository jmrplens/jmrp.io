---
/**
 * StructPacking Component
 *
 * A zero-JS diagram of a C/C++ struct's in-memory layout, computing and showing
 * the alignment padding holes between members and any trailing padding. Great
 * for explaining why `sizeof` is bigger than the sum of the members. Theme-aware,
 * responsive, and accessible (role="img" + sr-only table).
 *
 * Alignment defaults to each member's size, capped by the architecture's max
 * alignment (4 bytes on 32-bit, 8 on 64-bit); override per member with `align`.
 *
 * @example
 * <StructPacking
 *   title="struct Packet"
 *   arch="32-bit"
 *   members={[
 *     { type: "uint8_t", name: "flag", size: 1 },
 *     { type: "uint32_t", name: "id", size: 4 },
 *     { type: "uint16_t", name: "len", size: 2 },
 *   ]}
 * />
 */

import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Member {
  /** C/C++ type (e.g. "uint32_t"). */
  type: string;
  /** Member name. */
  name: string;
  /** Size in bytes. */
  size: number;
  /** Alignment requirement (defaults to size, capped by the architecture). */
  align?: number;
  /** Optional CSS color override; otherwise cycles a palette. */
  color?: string;
}

interface Props {
  /** Optional title shown above the diagram. */
  title?: string;
  /** Target architecture — caps the maximum alignment. Default "32-bit". */
  arch?: "32-bit" | "64-bit";
  /** Struct members in declaration order. */
  members: Member[];
  /** Caption below the diagram. */
  caption?: string;
  /** Accessibility label for the whole figure. */
  ariaLabel?: string;
}

const { title, arch = "32-bit", members, caption, ariaLabel } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const PALETTE = 6;
const maxAlign = arch === "64-bit" ? 8 : 4;
const alignOf = (m: Member) => Math.min(m.align ?? m.size, maxAlign);

interface Seg {
  label: string;
  detail: string;
  bytes: number;
  offset: number;
  padding: boolean;
  color: string | null;
}

const segments: Seg[] = [];
let offset = 0;
for (const [i, m] of members.entries()) {
  const a = alignOf(m);
  const pad = (a - (offset % a)) % a;
  if (pad > 0) {
    segments.push({
      label: t("components.structPacking.padding"),
      detail: `${pad} B`,
      bytes: pad,
      offset,
      padding: true,
      color: null,
    });
    offset += pad;
  }
  segments.push({
    label: m.name,
    detail: `${m.type} · ${m.size} B`,
    bytes: m.size,
    offset,
    padding: false,
    color: m.color ?? `var(--sp-${(i % PALETTE) + 1})`,
  });
  offset += m.size;
}

// Trailing padding to the struct's own alignment.
const structAlign =
  members.length > 0 ? Math.max(...members.map((m) => alignOf(m))) : 1;
const tailPad = (structAlign - (offset % structAlign)) % structAlign;
if (tailPad > 0) {
  segments.push({
    label: t("components.structPacking.padding"),
    detail: `${tailPad} B`,
    bytes: tailPad,
    offset,
    padding: true,
    color: null,
  });
  offset += tailPad;
}

const totalSize = offset || 1;
const paddingBytes = segments
  .filter((s) => s.padding)
  .reduce((sum, s) => sum + s.bytes, 0);

const summary =
  ariaLabel ??
  (title
    ? t("components.structPacking.ariaWithTitle", {
        title,
        count: String(members.length),
      })
    : t("components.structPacking.ariaWithoutTitle", {
        count: String(members.length),
      }));
---

<figure
  class="struct-packing"
  role="img"
  aria-label={summary}
>
  {title && <figcaption class="struct-packing__title">{title}</figcaption>}

  <div class="struct-packing__track">
    {
      segments.map((seg) => {
        const widthPct = (seg.bytes / totalSize) * 100;
        return (
          <span
            class="struct-packing__seg"
            style={`flex-grow:${widthPct.toFixed(3)}`}
            title={`${seg.label}: ${seg.detail} (@${seg.offset})`}
          >
            <span
              class:list={[
                "struct-packing__bar",
                seg.padding && "struct-packing__bar--pad",
              ]}
              style={seg.padding ? undefined : `background-color:${seg.color}`}
            >
              {widthPct >= 12 && (
                <span class="struct-packing__name">{seg.label}</span>
              )}
            </span>
            <span class="struct-packing__offset">@{seg.offset}</span>
          </span>
        );
      })
    }
  </div>

  <ul class="struct-packing__legend">
    {
      segments.map((seg) => (
        <li class="struct-packing__legend-item">
          <span
            class:list={[
              "struct-packing__swatch",
              seg.padding && "struct-packing__swatch--pad",
            ]}
            style={seg.padding ? undefined : `background-color:${seg.color}`}
            aria-hidden="true"
          />
          <span class="struct-packing__legend-text">
            <b>{seg.label}</b> · {seg.detail} · @{seg.offset}
          </span>
        </li>
      ))
    }
  </ul>

  <p class="struct-packing__summary">
    <b>sizeof = {totalSize} B</b>
    {
      paddingBytes > 0 && (
        <>
          {" "}
          · {paddingBytes} B {t("components.structPacking.padding")}
        </>
      )
    }
  </p>

  <table class="sr-only">
    <caption>{title ?? "Struct layout"}</caption>
    <thead>
      <tr>
        <th scope="col">Member</th>
        <th scope="col">Offset</th>
        <th scope="col">Detail</th>
      </tr>
    </thead>
    <tbody>
      {
        segments.map((seg) => (
          <tr>
            <td>{seg.label}</td>
            <td>{seg.offset}</td>
            <td>{seg.detail}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  {caption && <p class="struct-packing__caption">{caption}</p>}
</figure>

<style>
  .struct-packing {
    /* Categorical data-viz palette (dark-first); light values overridden below. */
    --sp-1: #f5a623; /* amber */
    --sp-2: #6e8fd6; /* blue */
    --sp-3: #46b8a6; /* teal */
    --sp-4: #b389f5; /* violet */
    --sp-5: #e0739f; /* pink */
    --sp-6: #57c98a; /* green */
    --sp-on: var(--color-on-primary);

    /* Diagonal hatch marks alignment padding (not colour alone). */
    --sp-pad-bg: var(--color-surface-2);
    --sp-stripe: repeating-linear-gradient(
      45deg,
      var(--color-border) 0 6px,
      var(--color-hair) 6px 12px
    );

    margin: 1.5rem 0;
  }

  :root[data-theme="light"] .struct-packing {
    --sp-1: #8f5300; /* darkened amber: AA for white on-fill name text */
    --sp-2: #3f6fc4;
    --sp-3: #1f7e6e;
    --sp-4: #6d45c4;
    --sp-5: #bc3f76;
    --sp-6: #197a43;
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .struct-packing {
      --sp-1: #8f5300; /* darkened amber: AA for white on-fill name text */
      --sp-2: #3f6fc4;
      --sp-3: #1f7e6e;
      --sp-4: #6d45c4;
      --sp-5: #bc3f76;
      --sp-6: #197a43;
    }
  }

  .struct-packing__title {
    margin-bottom: 1rem;
    font-size: 1rem;
    font-weight: var(--fw-semibold, 600);
    color: var(--color-text-heading);
  }

  .struct-packing__track {
    display: flex;
    overflow: hidden;
    font-family: var(--font-mono);
    border-radius: 6px;
  }

  /* Wrapper column: contiguous coloured bar on top, offset label below. */
  .struct-packing__seg {
    display: flex;
    flex-basis: 0;
    flex-direction: column;
    align-items: stretch;
    min-width: 2.2rem;
    text-align: center;
  }

  .struct-packing__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    padding: 0.3rem 0.25rem;
    overflow: hidden;
    color: var(--sp-on);
  }

  .struct-packing__seg + .struct-packing__seg .struct-packing__bar {
    border-left: 1px solid var(--color-bg-secondary);
  }

  .struct-packing__bar--pad {
    color: var(--color-text-muted);
    background-color: var(--sp-pad-bg);
    background-image: var(--sp-stripe);
  }

  /* Offset meta sits below the fill, muted on the card surface (AA-safe). */
  .struct-packing__offset {
    margin-top: 5px;
    font-size: 0.65rem;
    font-weight: var(--fw-medium, 500);
    color: var(--color-text-muted);
  }

  .struct-packing__name {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.656rem;
    font-weight: var(--fw-medium, 500);
    white-space: nowrap;
  }

  .struct-packing__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    padding: 0;
    margin: 0.85rem 0 0;
    list-style: none;
  }

  .struct-packing__legend-item {
    display: inline-flex;
    column-gap: 0.4rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .struct-packing__swatch {
    flex-shrink: 0;
    align-self: center;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
  }

  .struct-packing__swatch--pad {
    background-color: var(--sp-pad-bg);
    background-image: var(--sp-stripe);
    border: 1px solid var(--color-border);
  }

  .struct-packing__legend-text b {
    font-weight: var(--fw-semibold, 600);
    color: var(--color-text);
  }

  .struct-packing__summary {
    margin: 0.7rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .struct-packing__summary b {
    color: var(--color-text);
  }

  .struct-packing__caption {
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    clip-path: inset(50%);
  }

  @media (width <= 640px) {
    .struct-packing__name {
      display: none;
    }
  }
</style>
