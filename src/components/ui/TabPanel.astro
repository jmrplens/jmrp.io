---
/**
 * TabPanel Component
 * Represents a single panel within a <Tabs> container.
 *
 * Usage:
 * <TabPanel label="My Tab">
 *   <p>Tab content goes here.</p>
 * </TabPanel>
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

import CopyButton from "./CopyButton.astro";

interface Props {
  label: string; // The text to display in the tab button
  noPadding?: boolean; // Set to true for code blocks that don't need padding
}

const { label, noPadding = false } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
---

<div
  class:list={["tab-panel", "copy-container", { "no-padding": noPadding }]}
  data-label={label}
>
  <div class="panel-content">
    <slot />
  </div>
  {
    noPadding && (
      <CopyButton
        class="panel-copy-button"
        ariaLabel={t("components.tabPanel.copyContent", { label })}
      />
    )
  }
</div>

<style>
  /* Position copy button in the panel */
  .tab-panel {
    position: relative;
  }

  /* Floating over code: give the (otherwise chrome-less) button a surface so it
     stays legible above syntax-highlighted content. */
  .tab-panel :global(.panel-copy-button) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 10;
    padding: 4px 6px;
    background: var(--color-surface-2);
    border: var(--border-1);
  }
</style>
