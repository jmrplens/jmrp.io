---
/**
 * TerminalOutput Component
 * Displays the output of a shell command in a distinct visual style.
 *
 * NOTE: We use a <section> wrapper with 'white-space: pre-wrap' instead of a <pre> tag
 * to avoid nested <pre> tags when the slot contains code blocks.
 *
 * Usage:
 * <TerminalOutput title="Output">
 *   Package installed successfully.
 * </TerminalOutput>
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  title?: string;
  ariaLabel?: string;
}

const { title, ariaLabel } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const slotContent = await Astro.slots.render("default");
const trimmedContent = slotContent.trim();

// Use descriptive fallback (avoid non-meaningful IDs for screen readers)
const finalAriaLabel =
  ariaLabel ||
  (title
    ? t("components.terminal.outputTitle", { title })
    : t("components.terminal.outputFallback"));
---

<section
  class="terminal-output-wrapper"
  role="log"
  aria-live="polite"
  aria-label={finalAriaLabel}
>
  {
    title && (
      <div
        class="output-header"
        aria-hidden="true"
      >
        <span class="i-mdi:chevron-right-box-outline output-icon" />
        <span class="output-title">{title}</span>
      </div>
    )
  }
  {
    /* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- Focusable region for keyboard scrolling */
  }
  <div
    class="output-body"
    role="group"
    tabindex="0"
    aria-label={title
      ? t("components.terminal.scrollableOutput", { title })
      : t("components.terminal.scrollableFallback")}
  >
    {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
    <div
      class="terminal-content"
      set:html={trimmedContent}
    />
  </div>
</section>

<style>
  .terminal-content {
    word-break: normal;
    overflow-wrap: break-word;
    white-space: pre-wrap;
  }

  .terminal-output-wrapper {
    margin: 1.5rem 0;
    overflow: hidden;
    background-color: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .output-body:focus-visible {
    outline: 2px solid transparent;
    box-shadow: inset 0 0 0 2px var(--color-primary);
  }

  .output-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.6rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-hair);
  }

  .output-icon {
    font-size: 1.1rem;
  }

  .output-body {
    padding: 0.9375rem 1rem; /* 15px 16px */
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem; /* 12px */
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .output-body :global(.custom-code-copy-btn) {
    display: none !important;
  }

  .output-body :global(pre) {
    padding: 0 !important;
    margin: 0 !important;
    font-size: inherit !important;
    color: inherit !important;
    background: none !important;
    border: none !important;
  }

  .output-body :global(code) {
    font-size: inherit !important;
    color: inherit !important;
    background-color: transparent !important;
  }
</style>
