---
/**
 * TerminalOutput — the output of a command (no prompt) in a dark terminal card
 * (both themes), with a copy button.
 *
 * Usage:
 *   <TerminalOutput title="Test results">All tests passed (43/43)</TerminalOutput>
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import { decodeHtml } from "@utils/html";
import * as cheerio from "cheerio";

import CopyButton from "./CopyButton.astro";

interface Props {
  title?: string;
  ariaLabel?: string;
}

const { title, ariaLabel } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const slotContent = await Astro.slots.render("default");
const trimmedContent = slotContent.trim();

// Plain text (for the copy button).
const $ = cheerio.load(slotContent);
$("br").replaceWith("\n");
$("p, div, li").each((_, el) => {
  $(el).append("\n");
});
const outputText = decodeHtml($.text()).trim();

const label = title ?? t("ui.output");
const finalAriaLabel =
  ariaLabel ||
  (title
    ? t("components.terminal.outputTitle", { title })
    : t("components.terminal.outputFallback"));
const scrollAria = title
  ? t("components.terminal.scrollableOutput", { title })
  : t("components.terminal.scrollableFallback");
---

<section
  class="jmrp-term"
  role="log"
  aria-live="polite"
  aria-label={finalAriaLabel}
>
  <div class="jmrp-term__head">
    <span class="jmrp-term__label">{label}</span>
    <CopyButton
      variant="terminal"
      content={outputText}
      ariaLabel={t("components.terminal.copyCommand", { command: label })}
    />
  </div>
  <div class="jmrp-term__body">
    {
      /* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- focusable scroll region */
    }
    <div
      class="jmrp-term__scroll"
      role="group"
      tabindex="0"
      aria-label={scrollAria}
    >
      {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
      {
        /* <div>, not <pre>: the output slot may contain block content (<p>,
          <ul>, code fences) which is invalid inside <pre>. Pre-wrap comes from
          the global .jmrp-term__out rule. */
      }
      <div
        class="jmrp-term__out"
        set:html={trimmedContent}
      />
    </div>
  </div>
</section>

<style>
  .jmrp-term__scroll {
    overflow-x: auto;
    outline: none;
  }

  .jmrp-term__scroll:focus-visible {
    outline: 2px solid transparent;
    box-shadow: inset 0 0 0 2px var(--term-prompt);
  }
</style>
