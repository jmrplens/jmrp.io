---
/**
 * BeforeAfter Component
 * Side-by-side comparison view with pastel color scheme.
 * Can replace CompareCode for all before/after, bad/good comparisons.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  beforeLabel?: string;
  afterLabel?: string;
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const {
  beforeLabel = t("components.beforeAfter.before"),
  afterLabel = t("components.beforeAfter.after"),
} = Astro.props;
---

<div
  class="before-after-wrapper"
  role="group"
  aria-label={t("aria.comparison", { before: beforeLabel, after: afterLabel })}
>
  <section
    class="ba-block ba-before"
    aria-label={beforeLabel}
  >
    <div class="ba-header">
      <span
        class="i-mdi:close-circle-outline ba-icon"
        aria-hidden="true"
      ></span>
      <span>{beforeLabel}</span>
    </div>
    <div class="ba-content">
      <slot name="before" />
    </div>
  </section>
  <section
    class="ba-block ba-after"
    aria-label={afterLabel}
  >
    <div class="ba-header">
      <span
        class="i-mdi:check-circle-outline ba-icon"
        aria-hidden="true"
      ></span>
      <span>{afterLabel}</span>
    </div>
    <div class="ba-content">
      <slot name="after" />
    </div>
  </section>
</div>

<style>
  .before-after-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 2rem 0;
  }

  @media (width >= 768px) {
    .before-after-wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ba-block {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--ba-line);
    border-radius: var(--radius-md);
  }

  /*
   * Lab two-accent scheme: "before" = amber (attention/old), "after" = teal
   * (resolved/OK). Status is never colour-only — each block carries an icon
   * (✗ / ✓), an uppercase label, and a fixed position. Header text uses the
   * heading token so it stays AA in both themes; the accent rides on the icon,
   * tint and hairline (graphical, ≥3:1). All derived from tokens via color-mix.
   */
  .ba-before {
    --ba-accent: var(--color-primary);
    --ba-tint: var(--accent-dim);
    --ba-line: var(--accent-line);
  }

  .ba-after {
    --ba-accent: var(--teal);
    --ba-tint: color-mix(in srgb, var(--teal) 12%, transparent);
    --ba-line: color-mix(in srgb, var(--teal) 40%, transparent);
  }

  .ba-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background-color: var(--ba-tint);
    border-bottom: 1px solid var(--ba-line);
  }

  .ba-icon {
    font-size: 1.1rem;
    color: var(--ba-accent);
  }

  .ba-content {
    flex: 1;
    padding: 1rem;
  }

  .ba-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .ba-content :global(pre) {
    display: block;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    padding: 1rem !important;
    margin: 0 !important;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    /* stylelint-disable-next-line property-no-vendor-prefix -- Safari compatibility */
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  .ba-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
    white-space: pre;
    background-color: transparent !important;
    /* stylelint-disable-next-line property-no-vendor-prefix -- Safari compatibility */
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  .ba-content :global(p:first-child) {
    margin-top: 0;
  }

  .ba-content :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
