---
/**
 * BeforeAfter Component
 * Side-by-side comparison view with pastel color scheme.
 * Can replace CompareCode for all before/after, bad/good comparisons.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  beforeLabel?: string;
  afterLabel?: string;
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const {
  beforeLabel = t("components.beforeAfter.before"),
  afterLabel = t("components.beforeAfter.after"),
} = Astro.props;
---

<div
  class="before-after-wrapper"
  role="group"
  aria-label={t("aria.comparison", { before: beforeLabel, after: afterLabel })}
>
  <section
    class="ba-block ba-before"
    aria-label={beforeLabel}
  >
    <div class="ba-header">
      <span
        class="i-mdi:close-circle-outline ba-icon"
        aria-hidden="true"
      ></span>
      <span>{beforeLabel}</span>
    </div>
    <div class="ba-content">
      <slot name="before" />
    </div>
  </section>
  <section
    class="ba-block ba-after"
    aria-label={afterLabel}
  >
    <div class="ba-header">
      <span
        class="i-mdi:check-circle-outline ba-icon"
        aria-hidden="true"
      ></span>
      <span>{afterLabel}</span>
    </div>
    <div class="ba-content">
      <slot name="after" />
    </div>
  </section>
</div>

<style>
  .before-after-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 2rem 0;
  }

  @media (width >= 768px) {
    .before-after-wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ba-block {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    background-color: color-mix(
      in srgb,
      var(--ba-accent) 5%,
      var(--color-bg-secondary)
    );
    border: 1px solid var(--ba-line);
    border-radius: var(--radius-md);
  }

  /*
   * Semantic before/after scheme: "before" = danger (the flawed/old state),
   * "after" = success/teal (the resolved state). Status is never colour-only —
   * each block carries an icon (✗ / ✓), a mono label and a fixed column. The
   * accent tints the border, the 5% surface wash and the header text; the
   * header text keeps ≥4.5:1 in both themes (both tokens are AA-safe as text).
   */
  .ba-before {
    --ba-accent: var(--color-danger);
    --ba-line: color-mix(in srgb, var(--color-danger) 25%, var(--color-border));
  }

  .ba-after {
    --ba-accent: var(--color-success);
    --ba-line: color-mix(
      in srgb,
      var(--color-success) 25%,
      var(--color-border)
    );
  }

  .ba-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.625rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: var(--fw-semibold);
    color: var(--ba-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--color-hair);
  }

  .ba-icon {
    font-size: 1.1rem;
    color: var(--ba-accent);
  }

  .ba-content {
    flex: 1;
    padding: 1rem;
  }

  .ba-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .ba-content :global(pre) {
    display: block;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    padding: 1rem !important;
    margin: 0 !important;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    /* stylelint-disable-next-line property-no-vendor-prefix -- Safari compatibility */
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  .ba-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
    white-space: pre;
    background-color: transparent !important;
    /* stylelint-disable-next-line property-no-vendor-prefix -- Safari compatibility */
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  .ba-content :global(p:first-child) {
    margin-top: 0;
  }

  .ba-content :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
