---
/**
 * TLDRSummary Component
 * Renders a collapsible/expandible executive summary with key points.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  title?: string;
  collapsed?: boolean;
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const { title = t("components.tldr.title"), collapsed = false } = Astro.props;
---

<details
  class="tldr-summary"
  open={!collapsed}
>
  <summary class="tldr-header">
    <h2 class="tldr-title">{title}</h2>
    <span
      class="i-mdi:chevron-down tldr-chevron"
      aria-hidden="true"
    ></span>
  </summary>
  <div class="tldr-content">
    <slot />
  </div>
</details>

<style>
  .tldr-summary {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-lg);
  }

  .tldr-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.8125rem 1.125rem;
    color: var(--color-accent);
    cursor: pointer;
    user-select: none;
    list-style: none;
    background: var(--accent-dim);
    border-bottom: 1px solid var(--accent-line);
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .tldr-header::-webkit-details-marker {
    display: none;
  }

  .tldr-header:hover {
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  .tldr-header:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .tldr-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  /* Mono "kicker" treatment — the Lab answer-target eyebrow. */
  .tldr-title {
    flex: 1;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    line-height: 1.3;
    color: inherit;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .tldr-chevron {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    transition: transform 0.2s ease;
  }

  .tldr-summary[open] .tldr-chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .tldr-chevron,
    .tldr-header {
      transition: none;
    }
  }

  .tldr-content {
    padding: 1rem 1.125rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text);
  }

  /* Mockup uses an amber em-dash marker instead of default bullets. */
  .tldr-content :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tldr-content :global(ol) {
    padding-left: 1.25rem;
    margin: 0;
  }

  /* Hanging em-dash marker. NOT flex: a flex <li> turns every inline text node
     and <strong> into its own flex item (narrow columns), breaking the text. */
  .tldr-content :global(ul > li) {
    position: relative;
    padding-left: 1.4em;
    margin: 0;
  }

  .tldr-content :global(ul > li)::before {
    position: absolute;
    left: 0;
    color: var(--color-accent);
    content: "—";
  }

  .tldr-content :global(ol > li) {
    margin-bottom: 0.5rem;
  }

  .tldr-content :global(ol > li::marker) {
    color: var(--color-accent);
  }

  .tldr-content :global(p:last-child),
  .tldr-content :global(ul:last-child),
  .tldr-content :global(ol:last-child) {
    margin-bottom: 0;
  }
</style>
