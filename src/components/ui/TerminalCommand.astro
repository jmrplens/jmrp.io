---
/**
 * TerminalCommand — a CLI command to run, in a dark terminal card (both themes),
 * with a copy button that copies the raw command (no prompt).
 *
 * `title` is an optional caption in the card header, rendered exactly like
 * <TerminalSession>'s: visible chrome, aria-hidden, with the accessible name
 * still derived from the command itself. Alternative considered and rejected:
 * folding the title into the aria-label the way <TerminalOutput> does. An
 * output has no self-describing content so its title has to carry the name,
 * whereas a command block already announces the command — doing it there would
 * have hidden the caption from sighted readers for no accessibility gain.
 *
 * Usage:
 *   <TerminalCommand>sudo nginx -t && sudo systemctl reload nginx</TerminalCommand>
 *   <TerminalCommand title="Generate Client Keys">wg genkey</TerminalCommand>
 */
import { createHash } from "node:crypto";

import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import { decodeHtml } from "@utils/html";
import * as cheerio from "cheerio";

import CopyButton from "./CopyButton.astro";

interface Props {
  title?: string;
  prompt?: string;
  ariaLabel?: string;
}

const { title, prompt = "❯", ariaLabel } = Astro.props;

let lines: string[] = [];
let rawContent = "";

if (Astro.slots.has("default")) {
  const htmlContent = await Astro.slots.render("default");
  const $ = cheerio.load(htmlContent);
  $("br").replaceWith("\n");
  $("p, div, li, h1, h2, h3, h4, h5, h6").each((_, el) => {
    $(el).append("\n");
  });
  const processed = decodeHtml($.text()).trim();
  if (processed) lines = processed.split(/\r?\n/);
  rawContent = lines.join("\n");
}

const renderedLines = lines.map((line) => {
  const trimmedLine = line.trim();
  return {
    text: trimmedLine || " ",
    isComment: trimmedLine.startsWith("#"),
    isEmpty: !trimmedLine,
  };
});

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const contentHash = createHash("sha256")
  .update(rawContent || "empty-terminal-content")
  .digest("hex")
  .slice(0, 8);

const trimmedRaw = rawContent.trim();
let finalAriaLabel: string;
if (ariaLabel) {
  finalAriaLabel = ariaLabel;
} else if (trimmedRaw) {
  const suffix = trimmedRaw.length > 50 ? "..." : "";
  finalAriaLabel = t("components.terminal.commandAria", {
    command: `${trimmedRaw.slice(0, 50)}${suffix}`,
  });
} else {
  finalAriaLabel = t("components.terminal.noCommand");
}
---

<div
  class="jmrp-term terminal-command-wrapper copy-container"
  data-testid={`terminal-${contentHash}`}
>
  <div class="jmrp-term__head">
    <span class="jmrp-term__head-left">
      <span
        class="jmrp-term__dots"
        aria-hidden="true"
      >
        <i></i><i></i><i></i>
      </span>
      {
        title && (
          <span
            class="jmrp-term__label jmrp-term__label--title"
            aria-hidden="true"
          >
            {title}
          </span>
        )
      }
    </span>
    <CopyButton
      variant="terminal"
      content={rawContent}
      ariaLabel={t("components.terminal.copyCommand", {
        command: finalAriaLabel,
      })}
    />
  </div>
  <div class="jmrp-term__body">
    {
      /* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- focusable scroll region */
    }
    <div
      class="jmrp-term__scroll"
      role="region"
      tabindex="0"
      aria-label={finalAriaLabel}
    >
      {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
      {
        renderedLines.map((line) =>
          line.isComment || line.isEmpty ? (
            <div class="jmrp-term__line">
              <span class="term-out">{line.text}</span>
            </div>
          ) : (
            <div class="jmrp-term__line">
              <span
                class="term-prompt"
                aria-hidden="true"
              >
                {prompt}
              </span>
              <span class="term-cmd">{line.text}</span>
            </div>
          ),
        )
      }
    </div>
  </div>
</div>

<style>
  .jmrp-term__head-left {
    display: flex;
    gap: 9px;
    align-items: center;
    min-width: 0;
  }

  .jmrp-term__label--title {
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: none;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .jmrp-term__scroll {
    overflow-x: auto;
    outline: none;
  }

  .jmrp-term__scroll:focus-visible {
    outline: 2px solid transparent;
    box-shadow: inset 0 0 0 2px var(--term-prompt);
  }
</style>
