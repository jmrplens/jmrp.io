---
/**
 * TerminalCommand Component
 * Displays a shell command in a simulated terminal window.
 */

import { createHash } from "node:crypto";

import { decodeHtml } from "@utils/html";
import * as cheerio from "cheerio";

import CopyButton from "./CopyButton.astro";

interface Props {
  ariaLabel?: string;
}

let lines: string[] = [];
let rawContent = "";

/**
 * Slot Rendering Pipeline:
 * MDX content is rendered to HTML by Astro, so we need to extract
 * pure text from the HTML output for display and copy functionality.
 *
 * Steps:
 * 1. Render the slot to get HTML output from MDX.
 * 2. Use cheerio to parse the HTML DOM.
 * 3. Convert block elements (br, p, div, etc.) to newlines.
 * 4. Extract pure text content.
 * 5. Decode HTML entities (e.g., &amp; -> &).
 * 6. Split into lines for rendering with prompts.
 */
if (Astro.slots.has("default")) {
  const htmlContent = await Astro.slots.render("default");

  // Parse rendered HTML using cheerio for robust text extraction
  const $ = cheerio.load(htmlContent);

  // Convert common block elements and breaks to newlines
  // This ensures multi-line commands are properly separated
  $("br").replaceWith("\n");
  $("p, div, li, h1, h2, h3, h4, h5, h6").each((_, el) => {
    $(el).append("\n");
  });

  let processed = $.text();

  // Decode HTML entities that MDX may have escaped (e.g., &amp;, &lt;)
  processed = decodeHtml(processed);

  const trimmed = processed.trim();
  if (trimmed) {
    lines = trimmed.split(/\r?\n/);
  }

  // Store the clean text for the copy button
  rawContent = lines.join("\n");
}

// Pre-calculate line properties
const renderedLines = lines.map((line) => {
  const trimmedLine = line.trim();
  return {
    text: trimmedLine || " ",
    isComment: trimmedLine.startsWith("#"),
    isEmpty: !trimmedLine,
  };
});

const { ariaLabel } = Astro.props;

// Generate a content-based test ID for uniqueness
// Use a fixed fallback hash for empty content to ensure deterministic output
const hashInput = rawContent || "empty-terminal-content";
const contentHash = createHash("sha256")
  .update(hashInput)
  .digest("hex")
  .slice(0, 8);

// Fallback to meaningful label when rawContent is empty or whitespace-only
const trimmedRaw = rawContent.trim();

let finalAriaLabel: string;
if (ariaLabel) {
  finalAriaLabel = ariaLabel;
} else if (trimmedRaw) {
  const snippet = trimmedRaw.slice(0, 50);
  const suffix = trimmedRaw.length > 50 ? "..." : "";
  finalAriaLabel = `Terminal command: ${snippet}${suffix}`;
} else {
  finalAriaLabel = "Terminal: no command";
}
---

<div
  class="terminal-command-wrapper copy-container"
  data-testid={`terminal-${contentHash}`}
>
  <div class="terminal-header">
    <div class="terminal-controls">
      <span class="dot red"></span>
      <span class="dot yellow"></span>
      <span class="dot green"></span>
    </div>
    <div class="action-area">
      <CopyButton
        content={rawContent}
        ariaLabel={`Copy ${finalAriaLabel}`}
      />
    </div>
  </div>

  {
    /* Accessible scrollable container: Using <pre> implies preformatted text/code, which is semantically correct and allows tabindex */
  }
  <section class="terminal-window-container">
    {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex */}
    <div
      class="terminal-window"
      role="region"
      tabindex="0"
      aria-label={finalAriaLabel}
    >
      {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
      {
        renderedLines.map((line) => (
          <span class="command-line">
            <span
              class="prompt"
              aria-hidden="true"
            >
              {!line.isEmpty && !line.isComment ? "$" : "\u00A0"}
            </span>
            <span
              class:list={["line-content", { "is-comment": line.isComment }]}
            >
              {line.text}
            </span>
          </span>
        ))
      }
    </div>
  </section>

  {/* Hidden element for CopyButton to grab clean text without prompts */}
  <div
    class="copy-content"
    style="display: none;"
    aria-hidden="true"
    set:text={rawContent}
  />
</div>

<style>
  .terminal-command-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    margin: 1.5rem 0;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 36px;
    padding: 0.5rem 0.75rem;
    background-color: var(--color-bg-header);
    border-bottom: var(--border-1);
  }

  .terminal-controls {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    background-color: var(--color-border);
    border-radius: 50%;
  }

  .dot.red {
    background-color: #ff5f56;
  }

  .dot.yellow {
    background-color: #ffbd2e;
  }

  .dot.green {
    background-color: #27c93f;
  }

  /*
   * Use display: contents to remove the section from layout flow while
   * keeping it in the accessibility tree. Wrap in @supports for older browsers.
   */
  .terminal-window-container {
    display: block; /* Fallback for unsupported browsers */
  }

  @supports (display: contents) {
    .terminal-window-container {
      display: contents;
    }
  }

  .terminal-window {
    display: block; /* Simpler block layout to avoid flex-related boosting */
    width: 100%; /* Explicit width constraint */
    min-width: 0;
    max-width: 100%; /* Ensure it doesn't overflow parent calculation */
    padding: 0.75rem 1rem;
    margin: 0; /* Reset pre default margin */
    overflow-x: auto;

    /* Typography */
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;

    /* Mobile Fix: Prevent font inflation */
    text-size-adjust: none;
  }

  .terminal-window:focus-visible {
    outline: 2px solid transparent;
    box-shadow: inset 0 0 0 2px var(--color-primary);
  }

  .command-line {
    display: flex;
    align-items: baseline;
    min-height: 1.6em;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
    white-space: pre;

    /* Mobile Fix: Prevent font inflation */
    text-size-adjust: none;
  }

  .prompt {
    flex-shrink: 0;
    margin-right: 0.75rem;
    font-family: inherit;
    font-weight: bold;
    color: var(--color-primary);
    user-select: none;
    opacity: 80%;
  }

  .line-content {
    flex-grow: 1;
    font-family: inherit;
    color: var(--color-text);
  }

  .line-content.is-comment {
    font-style: italic;
    color: var(--color-text-muted);
  }

  :global(.terminal-command-wrapper .copy-button) {
    position: static !important;
  }
</style>
