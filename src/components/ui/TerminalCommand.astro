--- 
/**
 * TerminalCommand Component
 * Displays a shell command in a simulated terminal window.
 *
 * Usage using a slot for content (Plain text or Code Fence):
 *
 * <TerminalCommand>
 *   # This is a comment (aligned with command text)
 *   npm install
 * </TerminalCommand>
 *
 * <TerminalCommand>
 * ```bash
 * # With code fence (preserves whitespace better)
 * npm install
 * npm run build
 * ```
 * </TerminalCommand>
 *
 * Renders each non-empty line with a prompt ($).
 * Comments and empty lines use a spacer to maintain horizontal alignment.
 */import CopyButton from "./CopyButton.astro";
import { decodeHtml } from "@utils/html";

let lines: string[] = [];
let rawContent = "";

if (Astro.slots.has("default")) {
    const htmlContent = await Astro.slots.render("default");

    // Handle MDX/HTML output
    let processed = htmlContent
        .replace(/<\/p>/g, "\n")
        .replace(/<\/div>/g, "\n")
        .replace(/<br\s*\/?>/gi, "\n");

    processed = processed.replace(/<[^>]+>/g, "");

    processed = decodeHtml(processed);

    const trimmed = processed.trim();
    if (trimmed) {
        lines = trimmed.split(/\r?\n/);
    }

    rawContent = lines.join("\n");
}

// Pre-calculate line properties
const renderedLines = lines.map((line) => {
    const trimmedLine = line.trim();
    return {
        text: trimmedLine || " ",
        isComment: trimmedLine.startsWith("#"),
        isEmpty: !trimmedLine,
    };
});
---

<div class="terminal-command-wrapper copy-container">
    <div class="terminal-header">
        <div class="terminal-controls">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
        </div>
        <div class="action-area">
            <CopyButton />
        </div>
    </div>

    {/* Accessible scrollable container: Using <pre> implies preformatted text/code, which is semantically correct and allows tabindex */}
    <pre class="terminal-window" tabindex="0" role="region" aria-label="Terminal command">
        {
            renderedLines.map((line) => (
                <span class="command-line">
                    <span class="prompt" aria-hidden="true">
                        {!line.isEmpty && !line.isComment ? "$" : "\u00A0"}
                    </span>
                    <span
                        class:list={
                            [
                                "line-content",
                                {"is-comment": line.isComment},
                            ]
                        }
                    >
                        {line.text}
                    </span>
                </span>
            ))
        }
    </pre>

    {/* Hidden element for CopyButton to grab clean text without prompts */}
    <div
        class="copy-content"
        style="display: none;"
        aria-hidden="true"
        set:text={rawContent}
    >
    </div>
</div>

<style>
    .terminal-command-wrapper {
        position: relative;
        background-color: var(--color-bg-secondary);
        border-radius: var(--radius-md);
        margin: 1.5rem 0;
        border: var(--border-1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .terminal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem 0.75rem;
        background-color: var(--color-bg-subtle);
        border-bottom: var(--border-1);
        min-height: 36px;
    }

    .terminal-controls {
        display: flex;
        gap: 6px;
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: var(--color-border);
    }
    .dot.red {
        background-color: #ff5f56;
    }
    .dot.yellow {
        background-color: #ffbd2e;
    }
    .dot.green {
        background-color: #27c93f;
    }

    .terminal-window {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        overflow-x: auto;
        -ms-overflow-style: none;
        scrollbar-width: none;
        min-width: 0;
        padding: 0.75rem 1rem;
        margin: 0; /* Reset pre default margin */
    }
    .terminal-window::-webkit-scrollbar {
        display: none;
    }

    .command-line {
        display: flex;
        align-items: baseline;
        font-family: var(--font-mono);
        font-size: 0.85em;
        line-height: 1.6;
        white-space: pre;
        min-height: 1.6em;
    }

    .prompt {
        color: var(--color-primary);
        margin-right: 0;
        user-select: none;
        flex-shrink: 0;
        font-family: inherit;
        font-weight: bold;
        opacity: 0.8;
    }

    .line-content {
        color: var(--color-text);
        flex-grow: 1;
        font-family: inherit;
    }

    .line-content.is-comment {
        color: var(--color-text-muted);
        font-style: italic;
    }

    :global(.terminal-command-wrapper .copy-button) {
        position: static !important;
        background-color: transparent !important;
        border: none !important;
        padding: 4px !important;
        min-width: 24px !important;
        min-height: 24px !important;
        opacity: 0.7;
    }
    :global(.terminal-command-wrapper .copy-button:hover) {
        background-color: rgba(255, 255, 255, 0.1) !important;
        opacity: 1;
    }
</style>
