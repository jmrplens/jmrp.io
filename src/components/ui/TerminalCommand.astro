---
/**
 * TerminalCommand Component
 * Displays a shell command in a simulated terminal window.
 */

import { randomUUID } from "node:crypto";

import { decodeHtml } from "@utils/html";
import * as cheerio from "cheerio";

import CopyButton from "./CopyButton.astro";

let lines: string[] = [];
let rawContent = "";

if (Astro.slots.has("default")) {
    const htmlContent = await Astro.slots.render("default");

    // Handle MDX/HTML output using cheerio for robust text extraction
    const $ = cheerio.load(htmlContent);

    // Convert common block elements and breaks to newlines
    $("br").replaceWith("\n");
    $("p, div, li, h1, h2, h3, h4, h5, h6").each((_, el) => {
        $(el).append("\n");
    });

    let processed = $.text();

    processed = decodeHtml(processed);

    const trimmed = processed.trim();
    if (trimmed) {
        lines = trimmed.split(/\r?\n/);
    }

    rawContent = lines.join("\n");
}

// Pre-calculate line properties
const renderedLines = lines.map((line) => {
    const trimmedLine = line.trim();
    return {
        text: trimmedLine || " ",
        isComment: trimmedLine.startsWith("#"),
        isEmpty: !trimmedLine,
    };
});

const uuid = randomUUID().substring(0, 8);
---

<div class="terminal-command-wrapper copy-container">
    <div class="terminal-header">
        <div class="terminal-controls">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
        </div>
        <div class="action-area">
            <CopyButton content={rawContent} />
        </div>
    </div>

    {
        /* Accessible scrollable container: Using <pre> implies preformatted text/code, which is semantically correct and allows tabindex */
    }
    {/* eslint-disable jsx-a11y/no-noninteractive-tabindex */}
    <pre
        class="terminal-window"
        tabindex="0"
        role="group"
        aria-label={`Terminal command ${uuid}`}>{renderedLines.map((line) => (<span class="command-line"><span class="prompt" aria-hidden="true">{!line.isEmpty && !line.isComment ? "$" : "\u00A0"}</span><span class:list={["line-content", {"is-comment": line.isComment}]}>{line.text}</span></span>))}</pre>
    {/* eslint-enable jsx-a11y/no-noninteractive-tabindex */}

    {/* Hidden element for CopyButton to grab clean text without prompts */}
    <div
        class="copy-content"
        style="display: none;"
        aria-hidden="true"
        set:text={rawContent}
    />
</div>

<style>
    .terminal-command-wrapper {
        position: relative;
        background-color: var(--color-bg-secondary);
        border-radius: var(--radius-md);
        margin: 1.5rem 0;
        border: var(--border-1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .terminal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem 0.75rem;
        background-color: var(--color-bg-subtle);
        border-bottom: var(--border-1);
        min-height: 36px;
    }

    .terminal-controls {
        display: flex;
        gap: 6px;
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: var(--color-border);
    }
    .dot.red {
        background-color: #ff5f56;
    }
    .dot.yellow {
        background-color: #ffbd2e;
    }
    .dot.green {
        background-color: #27c93f;
    }

    .terminal-window {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        overflow-x: auto;
        -ms-overflow-style: none;
        scrollbar-width: none;
        min-width: 0;
        padding: 0.75rem 1rem;
        margin: 0; /* Reset pre default margin */
    }
    .terminal-window::-webkit-scrollbar {
        display: none;
    }

    .command-line {
        display: flex;
        align-items: baseline;
        font-family: var(--font-mono);
        font-size: 0.85em;
        line-height: 1.6;
        white-space: pre;
        min-height: 1.6em;
    }

    .prompt {
        color: var(--color-primary);
        margin-right: 0.75rem;
        user-select: none;
        flex-shrink: 0;
        font-family: inherit;
        font-weight: bold;
        opacity: 0.8;
    }

    .line-content {
        color: var(--color-text);
        flex-grow: 1;
        font-family: inherit;
    }

    .line-content.is-comment {
        color: var(--color-text-muted);
        font-style: italic;
    }

    :global(.terminal-command-wrapper .copy-button) {
        position: static !important;
        background-color: transparent !important;
        border: 1px solid var(--color-border) !important;
        opacity: 0.8;
    }
    :global(.terminal-command-wrapper .copy-button:hover) {
        opacity: 1;
        background-color: var(--color-bg-secondary) !important;
        border-color: var(--color-text-muted) !important;
    }
</style>
