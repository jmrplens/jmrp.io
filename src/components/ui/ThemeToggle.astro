---
/**
 * ThemeToggle Component
 * A button that toggles between light and dark themes using `data-theme`.
 *
 * Usage:
 * <ThemeToggle />
 */
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="Toggle theme"
>
  <span
    class="i-fa-solid:sun icon-sun"
    aria-hidden="true"
  ></span>
  <span
    class="i-fa-solid:moon icon-moon"
    aria-hidden="true"
  ></span>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    font-size: 1.2rem;
    color: var(--color-text);
    cursor: pointer;
    background: none;
    border: none;
    transition: color 0.2s;
  }

  .theme-toggle:hover {
    color: var(--color-primary);
  }

  /* Icon display logic based on data-theme */

  /* Default: dark theme shows sun icon (to switch to light) */
  .icon-sun {
    display: block;
  }

  .icon-moon {
    display: none;
  }

  /* Light theme: show moon icon (to switch to dark) */
  :global(html[data-theme="light"]) .icon-sun {
    display: none;
  }

  :global(html[data-theme="light"]) .icon-moon {
    display: block;
  }
</style>

<script>
  const setup = () => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;

    const update = () => {
      const theme = document.documentElement.dataset.theme || "dark";
      btn.setAttribute(
        "aria-label",
        `Switch to ${theme === "dark" ? "light" : "dark"} mode`,
      );
    };

    update();

    btn.onclick = (e) => {
      e.preventDefault();
      if (typeof (window as any).toggleTheme === "function") {
        (window as any).toggleTheme();
      }
    };

    // React to changes from any source (including navigation fixes)
    window.addEventListener("theme-changed", update);
  };

  setup();
  document.addEventListener("astro:after-swap", setup);
</script>
