---
/**
 * ThemeToggle Component
 * A button that toggles between light and dark themes using `data-theme`.
 *
 * Usage:
 * <ThemeToggle />
 */
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="Toggle theme"
>
  <span
    class="i-fa-solid:sun icon-sun"
    aria-hidden="true"
  ></span>
  <span
    class="i-fa-solid:moon icon-moon"
    aria-hidden="true"
  ></span>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    font-size: 1.2rem;
    color: var(--color-text);
    cursor: pointer;
    background: none;
    border: none;
    transition: color 0.2s;
  }

  .theme-toggle:hover {
    color: var(--color-primary);
  }

  /* Icon display logic based on data-theme */

  /* Default: dark theme shows sun icon (to switch to light) */
  .icon-sun {
    display: block;
  }

  .icon-moon {
    display: none;
  }

  /* Light theme: show moon icon (to switch to dark) */
  :global(html[data-theme="light"]) .icon-sun {
    display: none;
  }

  :global(html[data-theme="light"]) .icon-moon {
    display: block;
  }
</style>

<script>
  /**
   * Normalizes a theme value to a valid theme ("light" or "dark").
   * Returns null if the value is not a valid theme.
   */
  const normalizeTheme = (value: unknown): "light" | "dark" | null => {
    if (value === "light" || value === "dark") {
      return value;
    }
    return null;
  };

  // Note: Theme is read from localStorage by BaseLayout's inline script (FOUC prevention)
  // This component only handles the toggle interaction, not initial theme detection

  /**
   * Sets the theme on the document and persists to localStorage.
   * Only writes if the theme is a valid normalized value.
   * @param theme - Theme value (must be "light" or "dark")
   */
  const setTheme = (theme: "light" | "dark"): void => {
    const normalized = normalizeTheme(theme);
    if (!normalized) {
      return; // Invalid theme, do nothing
    }

    document.documentElement.dataset.theme = normalized;

    try {
      localStorage.setItem("theme", normalized);
    } catch {
      // localStorage may be blocked; silently ignore
    }

    // Update aria-label on toggle button
    const toggle = document.getElementById("theme-toggle");
    if (toggle) {
      const label =
        normalized === "dark" ? "Switch to Light Mode" : "Switch to Dark Mode";
      toggle.setAttribute("aria-label", label);
    }
  };

  /** Initializes the theme toggle component */
  const initThemeToggle = () => {
    const toggle = document.getElementById("theme-toggle");
    if (!toggle) return;

    // Read current theme from data-theme attribute (already set by BaseLayout inline script)
    // Do NOT call setTheme(getTheme()) here - that would re-read from storage/system
    // and could overwrite the user's selection due to timing issues
    const currentTheme = document.documentElement.dataset.theme || "dark";

    // Update aria-label to match current theme
    toggle.setAttribute(
      "aria-label",
      currentTheme === "dark" ? "Switch to Light Mode" : "Switch to Dark Mode",
    );

    // Set up click handler
    toggle.onclick = () => {
      const current = document.documentElement.dataset.theme || "dark";
      const newTheme = current === "dark" ? "light" : "dark";
      setTheme(newTheme);
    };
  };

  // Run immediately if DOM is ready, otherwise wait for DOMContentLoaded
  if (document.readyState !== "loading") {
    initThemeToggle();
  } else {
    document.addEventListener("DOMContentLoaded", initThemeToggle);
  }

  // Register astro:after-swap listener only once
  if (!document.documentElement.hasAttribute("data-theme-listener-init")) {
    document.documentElement.setAttribute("data-theme-listener-init", "true");
    document.addEventListener("astro:after-swap", initThemeToggle);
  }
</script>
