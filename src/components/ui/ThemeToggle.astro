---
/**
 * ThemeToggle Component
 * A button that toggles between light and dark themes using `data-theme`.
 *
 * Usage:
 * <ThemeToggle />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  /** Element id — must be unique per instance (header vs drawer). */
  id?: string;
}

const { id = "theme-toggle" } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
---

<button
  id={id}
  type="button"
  class="theme-toggle"
  aria-label={t("aria.toggleTheme")}
  data-label-light={t("aria.switchToLight")}
  data-label-dark={t("aria.switchToDark")}
>
  <span
    class="i-fa-solid:sun icon-sun"
    aria-hidden="true"
  ></span>
  <span
    class="i-fa-solid:moon icon-moon"
    aria-hidden="true"
  ></span>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    font-size: var(--text-xl);
    color: var(--color-text);
    cursor: pointer;
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    transition: color 0.2s;
  }

  .theme-toggle:hover {
    color: var(--color-primary);
  }

  .theme-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--color-accent) 55%, transparent);
  }

  /* Icon display logic based on data-theme */

  /* Default: dark theme shows sun icon (to switch to light) */
  .icon-sun {
    display: block;
  }

  .icon-moon {
    display: none;
  }

  /* Light theme: show moon icon (to switch to dark) */
  :global(html[data-theme="light"]) .icon-sun {
    display: none;
  }

  :global(html[data-theme="light"]) .icon-moon {
    display: block;
  }
</style>

<script>
  // Class-based (not id) so multiple instances work — header + mobile drawer
  // both call the global window.toggleTheme().
  const setup = () => {
    const btns = document.querySelectorAll<HTMLButtonElement>(".theme-toggle");
    if (!btns.length) return;

    const update = () => {
      const theme = document.documentElement.dataset.theme || "dark";
      for (const btn of btns) {
        const label =
          theme === "dark"
            ? btn.getAttribute("data-label-light")
            : btn.getAttribute("data-label-dark");
        btn.setAttribute("aria-label", label || "Toggle theme");
      }
    };

    update();

    for (const btn of btns) {
      btn.onclick = (e) => {
        e.preventDefault();
        if (typeof (window as any).toggleTheme === "function") {
          (window as any).toggleTheme();
        }
      };
    }

    // React to changes from any source (including navigation fixes)
    window.addEventListener("theme-changed", update);
  };

  setup();
  document.addEventListener("astro:after-swap", setup);
</script>
