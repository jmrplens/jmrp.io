---
/**
 * ThemeToggle Component
 * A button that toggles between light and dark themes using `data-theme`.
 *
 * Usage:
 * <ThemeToggle />
 */
import { Icon } from "astro-icon/components";
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="Toggle theme"
>
  <span
    class="icon-sun"
    aria-hidden="true"
    ><Icon name="fa-solid:sun" /></span
  >
  <span
    class="icon-moon"
    aria-hidden="true"
    ><Icon name="fa-solid:moon" /></span
  >
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    font-size: 1.2rem;
    color: var(--color-text);
    cursor: pointer;
    background: none;
    border: none;
    transition: color 0.2s;
  }

  .theme-toggle:hover {
    color: var(--color-primary);
  }

  /* Icon display logic based on data-theme */

  /* Default: dark theme shows sun icon (to switch to light) */
  .icon-sun {
    display: block;
  }

  .icon-moon {
    display: none;
  }

  /* Light theme: show moon icon (to switch to dark) */
  :global(html[data-theme="light"]) .icon-sun {
    display: none;
  }

  :global(html[data-theme="light"]) .icon-moon {
    display: block;
  }
</style>

<script>
  /**
   * Normalizes a theme value to a valid theme ("light" or "dark").
   * Returns null if the value is not a valid theme.
   */
  const normalizeTheme = (value: unknown): "light" | "dark" | null => {
    if (value === "light" || value === "dark") {
      return value;
    }
    return null;
  };

  /**
   * Gets the current theme from localStorage or system preference.
   * Falls back to "dark" if no valid theme is found.
   */
  const getTheme = (): "light" | "dark" => {
    try {
      if (typeof localStorage !== "undefined") {
        const stored = localStorage.getItem("theme");
        const normalized = normalizeTheme(stored);
        if (normalized) {
          return normalized;
        }
      }
    } catch {
      // localStorage may be blocked; ignore
    }

    // Respect system preference
    if (globalThis.matchMedia("(prefers-color-scheme: light)").matches) {
      return "light";
    }
    if (globalThis.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }

    // Fallback if no preference is indicated or supported
    return "dark";
  };

  /**
   * Sets the theme on the document and persists to localStorage.
   * Only writes if the theme is a valid normalized value.
   * @param theme - Theme value (must be "light" or "dark")
   */
  const setTheme = (theme: "light" | "dark"): void => {
    const normalized = normalizeTheme(theme);
    if (!normalized) {
      return; // Invalid theme, do nothing
    }

    document.documentElement.dataset.theme = normalized;

    try {
      localStorage.setItem("theme", normalized);
    } catch {
      // localStorage may be blocked; silently ignore
    }

    // Update aria-label on toggle button
    const toggle = document.getElementById("theme-toggle");
    if (toggle) {
      const label =
        normalized === "dark" ? "Switch to Light Mode" : "Switch to Dark Mode";
      toggle.setAttribute("aria-label", label);
    }
  };

  /** Initializes the theme toggle component */
  const initThemeToggle = () => {
    const toggle = document.getElementById("theme-toggle");

    // Initialize state based on current theme
    if (toggle) {
      const currentTheme = getTheme();
      setTheme(currentTheme);

      toggle.onclick = () => {
        // Read from dataset first (set by setTheme), fall back to getTheme()
        const current = document.documentElement.dataset.theme || getTheme();
        const newTheme = current === "dark" ? "light" : "dark";
        setTheme(newTheme);
      };
    }
  };

  // Run immediately if DOM is ready, otherwise wait for DOMContentLoaded
  if (document.readyState !== "loading") {
    initThemeToggle();
  } else {
    document.addEventListener("DOMContentLoaded", initThemeToggle);
  }

  // Register astro:after-swap listener only once
  if (!document.documentElement.hasAttribute("data-theme-listener-init")) {
    document.documentElement.setAttribute("data-theme-listener-init", "true");
    document.addEventListener("astro:after-swap", initThemeToggle);
  }
</script>
