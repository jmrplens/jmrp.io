---
/**
 * BrowserSupport Component
 * Renders a browser compatibility table with icons and status badges.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface BrowserInfo {
  browser: "chrome" | "firefox" | "safari" | "edge" | "opera";
  version?: string;
  support: "full" | "partial" | "none" | "unknown";
  note?: string;
}

interface Props {
  title?: string;
  browsers: BrowserInfo[];
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const { title = t("components.browserSupport.title"), browsers } = Astro.props;

const browserIcons: Record<string, string> = {
  chrome: "logos:chrome",
  firefox: "logos:firefox",
  safari: "logos:safari",
  edge: "logos:microsoft-edge",
  opera: "logos:opera",
};

const browserNames: Record<string, string> = {
  chrome: "Chrome",
  firefox: "Firefox",
  safari: "Safari",
  edge: "Edge",
  opera: "Opera",
};

const supportConfig: Record<
  string,
  { icon: string; class: string; label: string }
> = {
  full: {
    icon: "mdi:check-circle",
    class: "support-full",
    label: t("components.browserSupport.fullSupport"),
  },
  partial: {
    icon: "mdi:alert-circle",
    class: "support-partial",
    label: t("components.browserSupport.partialSupport"),
  },
  none: {
    icon: "mdi:close-circle",
    class: "support-none",
    label: t("components.browserSupport.noSupport"),
  },
  unknown: {
    icon: "mdi:help-circle",
    class: "support-unknown",
    label: t("components.browserSupport.unknown"),
  },
};

// Generate unique ID for accessibility
const uniqueId = `bs-${crypto.randomUUID().slice(0, 8)}`;
---

<section
  class="browser-support"
  aria-labelledby={uniqueId}
>
  <h3
    class="bs-title"
    id={uniqueId}
  >
    {title}
  </h3>
  <div class="bs-grid">
    {
      browsers.map((b) => (
        <div class={`bs-item ${supportConfig[b.support].class}`}>
          <span
            class={`i-${browserIcons[b.browser]} bs-browser-icon`}
            aria-hidden="true"
          />
          <div class="bs-info">
            <span class="bs-name">{browserNames[b.browser]}</span>
            {b.version && <span class="bs-version">{b.version}+</span>}
          </div>
          <span
            class={`i-${supportConfig[b.support].icon} bs-status-icon`}
            role="img"
            aria-label={supportConfig[b.support].label}
          />
          {b.note && <span class="bs-note">{b.note}</span>}
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Lab BrowserSupport — grid of flat per-browser cards; the wrapper is bare. */
  .browser-support {
    margin: 1.5rem 0;
    background: transparent;
    border: none;
  }

  .bs-title {
    padding: 0;
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    background: transparent;
    border: none;
  }

  .bs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.625rem;
    background: transparent;
  }

  .bs-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    padding: 0.875rem;
    text-align: center;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .bs-browser-icon {
    width: 28px;
    height: 28px;
  }

  .bs-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .bs-name {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
  }

  .bs-version {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .bs-status-icon {
    width: 20px;
    height: 20px;
  }

  /* Support state — carried by icon SHAPE (check/alert/close/help) + aria-label,
     colour only reinforces it. */
  .support-full .bs-status-icon {
    color: var(--color-success);
  }

  .support-partial .bs-status-icon {
    color: var(--color-warning);
  }

  .support-none .bs-status-icon {
    color: var(--color-danger);
  }

  .support-unknown .bs-status-icon {
    color: var(--color-text-muted);
  }

  .bs-note {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  /* Mobile responsive - switch to 2 columns on small screens */
  @media (width <= 640px) {
    .bs-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .bs-item {
      padding: 0.75rem 0.5rem;
    }

    .bs-browser-icon {
      width: 26px;
      height: 26px;
    }
  }
</style>
