---
/**
 * BrowserSupport Component
 * Renders a browser compatibility table with icons and status badges.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface BrowserInfo {
  browser: "chrome" | "firefox" | "safari" | "edge" | "opera";
  version?: string;
  support: "full" | "partial" | "none" | "unknown";
  note?: string;
}

interface Props {
  title?: string;
  browsers: BrowserInfo[];
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const { title = t("components.browserSupport.title"), browsers } = Astro.props;

const browserNames: Record<string, string> = {
  chrome: "Chrome",
  firefox: "Firefox",
  safari: "Safari",
  edge: "Edge",
  opera: "Opera",
};

const supportConfig: Record<
  string,
  { glyph: string; class: string; label: string }
> = {
  full: {
    glyph: "✓",
    class: "support-full",
    label: t("components.browserSupport.fullSupport"),
  },
  partial: {
    glyph: "⚠",
    class: "support-partial",
    label: t("components.browserSupport.partialSupport"),
  },
  none: {
    glyph: "✕",
    class: "support-none",
    label: t("components.browserSupport.noSupport"),
  },
  unknown: {
    glyph: "?",
    class: "support-unknown",
    label: t("components.browserSupport.unknown"),
  },
};
---

<section
  class="browser-support"
  aria-label={title}
>
  <div class="bs-grid">
    {
      browsers.map((b) => (
        <div class={`bs-item ${supportConfig[b.support].class}`}>
          <span class="bs-name">{browserNames[b.browser]}</span>
          <span
            class="bs-glyph"
            aria-hidden="true"
          >
            {supportConfig[b.support].glyph}
          </span>
          <span class="sr-only">{supportConfig[b.support].label}</span>
          {b.version && <span class="bs-version">{b.version}+</span>}
          {b.note && <span class="bs-note">{b.note}</span>}
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Lab BrowserSupport — 4-col grid of flat per-browser cards; no internal title. */
  .browser-support {
    margin: 1.5rem 0;
    background: transparent;
    border: none;
  }

  .bs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.625rem;
    background: transparent;
  }

  .bs-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    padding: 0.875rem;
    text-align: center;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .bs-name {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
  }

  .bs-glyph {
    font-size: var(--text-lg);
    line-height: 1;
  }

  /* Support state — conveyed by glyph shape (✓/⚠/✕/?) + sr-only label;
     colour only reinforces it. */
  .support-full .bs-glyph {
    color: var(--color-success);
  }

  .support-partial .bs-glyph {
    color: var(--color-warning);
  }

  .support-none .bs-glyph {
    color: var(--color-danger);
  }

  .support-unknown .bs-glyph {
    color: var(--color-text-muted);
  }

  .bs-version {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }

  .bs-note {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }

  /* Visually hidden but available to assistive technology */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border-width: 0;
  }

  /* Mobile — relax to 2 columns below 600px to prevent card overflow */
  @media (width <= 600px) {
    .bs-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .bs-item {
      padding: 0.75rem 0.5rem;
    }
  }
</style>
