---
/**
 * BrowserSupport Component
 * Renders a browser compatibility table with icons and status badges.
 */
interface BrowserInfo {
  browser: "chrome" | "firefox" | "safari" | "edge" | "opera";
  version?: string;
  support: "full" | "partial" | "none" | "unknown";
  note?: string;
}

interface Props {
  title?: string;
  browsers: BrowserInfo[];
}

const { title = "Browser Support", browsers } = Astro.props;

const browserIcons: Record<string, string> = {
  chrome: "logos:chrome",
  firefox: "logos:firefox",
  safari: "logos:safari",
  edge: "logos:microsoft-edge",
  opera: "logos:opera",
};

const browserNames: Record<string, string> = {
  chrome: "Chrome",
  firefox: "Firefox",
  safari: "Safari",
  edge: "Edge",
  opera: "Opera",
};

const supportConfig: Record<
  string,
  { icon: string; class: string; label: string }
> = {
  full: {
    icon: "mdi:check-circle",
    class: "support-full",
    label: "Full Support",
  },
  partial: {
    icon: "mdi:alert-circle",
    class: "support-partial",
    label: "Partial Support",
  },
  none: {
    icon: "mdi:close-circle",
    class: "support-none",
    label: "No Support",
  },
  unknown: {
    icon: "mdi:help-circle",
    class: "support-unknown",
    label: "Unknown",
  },
};
---

<section class="browser-support">
  <div
    class="bs-title"
    id="bs-title"
  >
    {title}
  </div>
  <div class="bs-grid">
    {
      browsers.map((b) => (
        <div class={`bs-item ${supportConfig[b.support].class}`}>
          <span
            class={`i-${browserIcons[b.browser]} bs-browser-icon`}
            aria-hidden="true"
          />
          <div class="bs-info">
            <span class="bs-name">{browserNames[b.browser]}</span>
            {b.version && <span class="bs-version">{b.version}+</span>}
          </div>
          <span
            class={`i-${supportConfig[b.support].icon} bs-status-icon`}
            role="img"
            aria-label={supportConfig[b.support].label}
          />
          {b.note && <span class="bs-note">{b.note}</span>}
        </div>
      ))
    }
  </div>
</section>

<style>
  .browser-support {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .bs-title {
    padding: 0.625rem 1rem;
    font-size: 0.85rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-bg-subtle);
    border-bottom: var(--border-1);
  }

  .bs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    background: var(--color-border);
  }

  .bs-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    padding: 1rem;
    text-align: center;
    background: var(--color-bg-secondary);
  }

  .bs-browser-icon {
    width: 32px;
    height: 32px;
  }

  .bs-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .bs-name {
    font-size: 0.9rem;
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .bs-version {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .bs-status-icon {
    width: 20px;
    height: 20px;
  }

  .support-full .bs-status-icon {
    color: #10b981;
  }

  .support-partial .bs-status-icon {
    color: #f59e0b;
  }

  .support-none .bs-status-icon {
    color: #ef4444;
  }

  .support-unknown .bs-status-icon {
    color: var(--color-text-muted);
  }

  .bs-note {
    font-size: 0.75rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  /* Mobile responsive - switch to 2 columns on small screens */
  @media (width <= 640px) {
    .bs-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .bs-item {
      padding: 0.75rem 0.5rem;
    }

    .bs-browser-icon {
      width: 28px;
      height: 28px;
    }

    .bs-name {
      font-size: 0.8rem;
    }

    .bs-version {
      font-size: 0.7rem;
    }
  }
</style>
