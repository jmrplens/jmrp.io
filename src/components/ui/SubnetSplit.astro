---
/**
 * SubnetSplit Component
 *
 * Shows an IPv4 address as four octets of bits, split into the network portion
 * (first /prefix bits) and the host portion, with a summary (mask, network,
 * broadcast, usable hosts).
 *
 * @example
 * <SubnetSplit ip="192.168.1.10" prefix={26} />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  /** Optional title. */
  title?: string;
  /** Dotted IPv4 address. */
  ip: string;
  /** CIDR prefix length (0–32). */
  prefix: number;
  /** Caption below the figure. */
  ariaLabel?: string;
  caption?: string;
}

const { title, ip, prefix, caption, ariaLabel } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const octets = ip.split(".").map((o) => Number.parseInt(o, 10) & 255);
const u32 =
  ((octets[0] << 24) | (octets[1] << 16) | (octets[2] << 8) | octets[3]) >>> 0;
const mask = prefix === 0 ? 0 : (-1 << (32 - prefix)) >>> 0;
const network = (u32 & mask) >>> 0;
const broadcast = (network | (~mask >>> 0)) >>> 0;
const dotted = (v: number) =>
  [24, 16, 8, 0].map((s) => (v >>> s) & 255).join(".");
let hosts = 2 ** (32 - prefix) - 2;
if (prefix === 32) hosts = 1;
else if (prefix === 31) hosts = 2;

// 32 bits, grouped into 4 octets. Within an octet the network bits are always
// the leading run (CIDR prefixes are contiguous), so each octet renders as up
// to two blocks: a network run then a host run (mockup style).
const octetBlocks = [0, 1, 2, 3].map((oi) => {
  const bits = Array.from({ length: 8 }, (_, bi) => {
    const bitIndex = oi * 8 + bi; // 0 = MSB
    return {
      value: (u32 >>> (31 - bitIndex)) & 1,
      network: bitIndex < prefix,
    };
  });
  const net = bits.filter((b) => b.network);
  const host = bits.filter((b) => !b.network);
  return {
    net: net.map((b) => b.value).join(""),
    host: host.map((b) => b.value).join(""),
  };
});

const summary =
  ariaLabel ??
  (title
    ? t("components.subnetSplit.ariaWithTitle", { title })
    : t("components.subnetSplit.ariaWithoutTitle"));
---

<div
  class="subnet"
  role="img"
  aria-label={summary}
>
  {title && <div class="subnet__title">{title}</div>}

  <div class="subnet__octets">
    {
      octetBlocks.map((oct) => (
        <span class="subnet__octet">
          {oct.net && (
            <b
              class:list={[
                "subnet__run subnet__run--net",
                oct.host ? "subnet__run--split-l" : "",
              ]}
            >
              {oct.net}
            </b>
          )}
          {oct.host && (
            <b
              class:list={[
                "subnet__run subnet__run--host",
                oct.net ? "subnet__run--split-r" : "",
              ]}
            >
              {oct.host}
            </b>
          )}
        </span>
      ))
    }
  </div>

  <ul class="subnet__legend">
    <li class="subnet__legend-item">
      <span
        class="subnet__swatch subnet__swatch--net"
        aria-hidden="true"
      ></span>
      <span>network /{prefix}</span>
    </li>
    <li class="subnet__legend-item">
      <span
        class="subnet__swatch subnet__swatch--host"
        aria-hidden="true"
      ></span>
      <span>host ({32 - prefix} bits)</span>
    </li>
  </ul>

  <dl class="subnet__facts">
    <div><dt>Mask</dt><dd>{dotted(mask)}</dd></div>
    <div>
      <dt>Network</dt>
      <dd class="subnet__fact--net">{dotted(network)}</dd>
    </div>
    <div><dt>Broadcast</dt><dd>{dotted(broadcast)}</dd></div>
    <div>
      <dt>Usable hosts</dt>
      <dd class="subnet__fact--hosts">
        {hosts.toLocaleString(locale, { useGrouping: "always" })}
      </dd>
    </div>
  </dl>

  {caption && <p class="subnet__caption">{caption}</p>}
</div>

<style>
  /* Flat bordered card (mockup). Net = accent, host = teal; ink text flips
     with the theme so both fills stay AA in light and dark. */
  .subnet {
    padding: 18px;
    margin: 1.5rem 0;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .subnet__title {
    margin-bottom: 1rem;
    font-size: var(--text-md);
    font-weight: var(--fw-semibold, 600);
    color: var(--color-text-heading);
  }

  .subnet__octets {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .subnet__octet {
    display: flex;
    gap: 2px;
  }

  .subnet__run {
    padding: 4px 5px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--fw-medium);
    color: var(--color-on-primary);
    border-radius: 3px;
  }

  .subnet__run--net {
    background: var(--color-primary);
  }

  .subnet__run--host {
    background: var(--teal);
  }

  .subnet__run--split-l {
    border-radius: 3px 0 0 3px;
  }

  .subnet__run--split-r {
    border-radius: 0 3px 3px 0;
  }

  .subnet__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    padding: 0;
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    list-style: none;
  }

  .subnet__legend-item {
    display: inline-flex;
    column-gap: 0.4rem;
    align-items: center;
  }

  .subnet__swatch {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
  }

  .subnet__swatch--net {
    background: var(--color-primary);
  }

  .subnet__swatch--host {
    background: var(--teal);
  }

  .subnet__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
  }

  .subnet__facts div {
    display: inline-flex;
    gap: 0.4em;
  }

  .subnet__facts dt {
    color: var(--color-text-muted);
  }

  .subnet__facts dd {
    margin: 0;
    color: var(--color-text-heading);
  }

  .subnet__facts .subnet__fact--net {
    color: var(--color-accent);
  }

  .subnet__facts .subnet__fact--hosts {
    color: var(--teal-text);
  }

  .subnet__caption {
    margin-top: 1rem;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
