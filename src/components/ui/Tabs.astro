---
/**
 * Tabs Component - Zero JavaScript, Auto-Label Extraction
 *
 * Labels are automatically extracted from TabPanel children at build time.
 * No need to duplicate labels in props - just add TabPanels!
 *
 * Usage (simplified):
 * <Tabs>
 *   <TabPanel label="Tab 1">Content 1</TabPanel>
 *   <TabPanel label="Tab 2">Content 2</TabPanel>
 * </Tabs>
 */

import * as cheerio from "cheerio";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Render slot content to extract labels from TabPanel children
const slotContent = await Astro.slots.render("default");

// Use Cheerio to parse the HTML content for robust attribute extraction
const $ = cheerio.load(slotContent, { xmlMode: false });

const labels: string[] = [];

// Select elements that have the tab-panel class
$(".tab-panel").each((_, el) => {
  const label = $(el).attr("data-label");

  if (label) {
    labels.push(label);
  }
});

// Fallback if no labels found (shouldn't happen with proper TabPanel usage)
if (labels.length === 0) {
  console.warn(
    `[Tabs] No TabPanel labels found in slot content. Ensure <TabPanel> components are used with a "label" prop.\nPreview: ${slotContent.slice(0, 100)}...`,
  );
}

// Generate deterministic unique ID with entropy
const entropy = crypto.getRandomValues(new Uint32Array(1))[0].toString(36);

const labelSlug =
  labels
    .join("-")
    .replaceAll(/[^a-zA-Z0-9]/g, "")
    .slice(0, 12) || "tabs";

const uniqueId = `${labelSlug}-${entropy}`;

// Inject IDs and ARIA attributes into each tab-panel for accessibility
$(".tab-panel").each((index, el) => {
  const $el = $(el);
  const id = `panel-${uniqueId}-${index}`;
  const labelId = `label-${uniqueId}-${index}`;

  // Only set ID if not already present
  if (!$el.attr("id")) {
    $el.attr("id", id);
  }

  $el.attr("role", "tabpanel");
  $el.attr("aria-labelledby", labelId);
});

const processedSlotContent = $.html();

// Generate consolidated CSS for this instance
const instanceCss = labels
  .map(
    (_, index) => `
        .tabs-container[data-tabs-id="${uniqueId}"] #tab-${uniqueId}-${index}:checked ~ .tab-content > .tab-panel:nth-child(${index + 1}) {
          display: block;
        }

        .tabs-container[data-tabs-id="${uniqueId}"] #tab-${uniqueId}-${index}:checked ~ .tab-content > .tab-panel:not(:nth-child(${index + 1})) {
          display: none;
        }

        .tabs-container[data-tabs-id="${uniqueId}"] #tab-${uniqueId}-${index}:checked ~ .tab-headers > .tab-label:nth-child(${index + 1}) {
          color: var(--color-primary);
          background: var(--color-bg-secondary);
          border-bottom-color: var(--color-primary);
          margin-bottom: -1px;
        }

        /* Focus styles for accessibility - highlight label when hidden radio is focused */
        .tabs-container[data-tabs-id="${uniqueId}"] #tab-${uniqueId}-${index}:focus ~ .tab-headers > .tab-label:nth-child(${index + 1}) {
          outline: 2px solid var(--color-primary);
          outline-offset: -2px;
          background: rgb(255 255 255 / 2%);
        }
      `,
  )
  .join("\n");
---

<div
  class:list={["tabs-container", className]}
  data-tabs-id={uniqueId}
  role="radiogroup"
  aria-label="Tabbed Content"
>
  {/* Hidden radio inputs for CSS state management */}
  {
    labels.map((_, index) => (
      <input
        type="radio"
        name={`tabs-${uniqueId}`}
        id={`tab-${uniqueId}-${index}`}
        class="tab-radio"
        checked={index === 0}
        aria-controls={`panel-${uniqueId}-${index}`}
      />
    ))
  }

  {/* Tab headers as labels - auto-generated from TabPanel children */}
  <div class="tab-headers">
    {
      labels.map((label, index) => (
        <label
          for={`tab-${uniqueId}-${index}`}
          id={`label-${uniqueId}-${index}`}
          class="tab-label"
        >
          {label}
        </label>
      ))
    }
  </div>

  {/* Tab panels from slot - already contains rendered TabPanel components */}
  <div
    class="tab-content"
    set:html={processedSlotContent}
  />
</div>

{/* Generate unique selectors for each panel (consolidated) */}
{
  instanceCss && (
    <style
      is:inline
      set:html={instanceCss}
    />
  )
}

<style is:global>
  .tabs-container {
    position: relative;
    display: block;
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  /* Hide radio inputs visually */
  .tabs-container .tab-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip-path: inset(100%);
  }

  .tabs-container .tab-headers {
    display: flex;
    overflow: auto hidden;
    scrollbar-width: thin;
    background: var(--color-bg-header);
    border-bottom: var(--border-1);
  }

  .tabs-container .tab-headers::-webkit-scrollbar {
    height: 4px;
  }

  .tabs-container .tab-label {
    flex-shrink: 0;
    padding: 0.75rem 1.25rem;
    font-size: 0.9rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    white-space: nowrap;
    cursor: pointer;
    background: transparent;
    border-right: var(--border-1);
    border-bottom: 2px solid transparent;
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s;
  }

  .tabs-container .tab-label:hover {
    background: rgb(255 255 255 / 2%);
  }

  .tabs-container .tab-content {
    position: relative;
    max-width: 100%;
    padding: 0;
  }

  /* Default: hide all panels, show first */
  .tabs-container .tab-panel {
    display: none;
    padding: 1.5rem;
  }

  .tabs-container .tab-panel:first-child {
    display: block;
  }

  /* Auto-remove padding when tab contains only a code block */
  .tabs-container .tab-panel:has(> .panel-content > pre:only-child),
  .tabs-container
    .tab-panel:has(> .panel-content > .code-section-wrapper:only-child),
  .tabs-container
    .tab-panel:has(> .panel-content > section:only-child > pre:only-child) {
    padding: 0;
  }

  /* Code blocks inside tab panels - Increased specificity to avoid !important */
  .tabs-container .tab-panel pre,
  .tabs-container .tab-panel pre.astro-code {
    padding: 1rem 1.25rem;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
    background-color: transparent;
    border: none;
    border-radius: 0;
    text-size-adjust: none;
  }

  .tabs-container .tab-panel code {
    font-family: var(--font-mono);
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    white-space: pre;
    background: none;
  }

  .tabs-container .tab-panel.no-padding {
    padding: 0;
  }

  .tabs-container pre,
  .tabs-container .mermaid {
    max-width: 100% !important;
    overflow-x: auto !important;
  }

  .tabs-container img,
  .tabs-container svg {
    max-width: 100%;
    height: auto;
  }

  .tabs-container .tab-label:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }
</style>
