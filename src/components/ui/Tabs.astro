---
/**
 * Tabs Component
 * A versatile client-side web component for switching between content panels.
 * Works in conjunction with <TabPanel> children.
 *
 * Usage:
 * <Tabs>
 *   <TabPanel label="Tab 1">Content 1</TabPanel>
 *   <TabPanel label="Tab 2">Content 2</TabPanel>
 * </Tabs>
 */

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<script>
  class TabsComponent extends HTMLElement {
    _tabListeners: {
      button: HTMLButtonElement;
      clickHandler: () => void;
      keydownHandler: (e: KeyboardEvent) => void;
    }[] = [];

    connectedCallback() {
      // Use requestAnimationFrame to ensure the children are fully parsed
      // connectedCallback fires before child elements are available
      requestAnimationFrame(() => {
        this.initializeTabs();
      });
    }

    disconnectedCallback() {
      // Cleanup listeners to avoid memory leaks
      this._tabListeners.forEach(({ button, clickHandler, keydownHandler }) => {
        button.removeEventListener("click", clickHandler);
        button.removeEventListener("keydown", keydownHandler);
      });
      this._tabListeners = [];

      // Clear initialized marker to allow re-initialization on reconnect
      const headers = this.querySelector(".tab-headers");
      if (headers) {
        headers.removeAttribute("data-initialized");
      }
    }

    initializeTabs() {
      const headers = this.querySelector(".tab-headers");
      const panels = this.querySelectorAll(".tab-panel");

      if (!headers || panels.length === 0) return;

      // Guard against duplicate initialization
      if (headers.hasAttribute("data-initialized")) return;
      headers.setAttribute("data-initialized", "true");

      // Generate unique IDs for ARIA
      const uniqueId = Math.random().toString(36).substring(2, 9);

      panels.forEach((panel, index) => {
        const title = panel.getAttribute("data-label") || `Tab ${index + 1}`;
        const panelId = `panel-${uniqueId}-${index}`;
        const tabId = `tab-${uniqueId}-${index}`;

        // Setup Panel ARIA
        panel.setAttribute("id", panelId);
        panel.setAttribute("role", "tabpanel");
        panel.setAttribute("aria-labelledby", tabId);

        // Create Tab Button
        const button = document.createElement("button");
        button.textContent = title;
        button.id = tabId;
        button.role = "tab";
        button.setAttribute("aria-controls", panelId);
        button.setAttribute("aria-selected", index === 0 ? "true" : "false");
        button.setAttribute("tabindex", index === 0 ? "0" : "-1");

        const clickHandler = () => {
          // Deactivate all
          headers.querySelectorAll("button").forEach((b) => {
            b.setAttribute("aria-selected", "false");
            b.setAttribute("tabindex", "-1");
          });
          panels.forEach((p) => {
            if (p instanceof HTMLElement) {
              p.hidden = true;
            }
          });

          // Activate clicked
          button.setAttribute("aria-selected", "true");
          button.setAttribute("tabindex", "0");

          // Show corresponding panel
          if (panel instanceof HTMLElement) {
            panel.hidden = false;
          }
        };

        const keydownHandler = (e: KeyboardEvent) => {
          const allButtons = Array.from(headers.querySelectorAll("button"));
          const firstButton = allButtons[0];
          const lastButton = allButtons[allButtons.length - 1];

          if (e.key === "ArrowRight") {
            e.preventDefault();
            const next =
              (button.nextElementSibling as HTMLElement) || firstButton;
            if (next) {
              next.click();
              next.focus();
            }
          } else if (e.key === "ArrowLeft") {
            e.preventDefault();
            const prev =
              (button.previousElementSibling as HTMLElement) || lastButton;
            if (prev) {
              prev.click();
              prev.focus();
            }
          } else if (e.key === "Home") {
            e.preventDefault();
            if (firstButton instanceof HTMLElement) {
              firstButton.click();
              firstButton.focus();
            }
          } else if (e.key === "End") {
            e.preventDefault();
            if (lastButton instanceof HTMLElement) {
              lastButton.click();
              lastButton.focus();
            }
          }
        };

        button.addEventListener("click", clickHandler);
        button.addEventListener("keydown", keydownHandler);

        // Store references for cleanup
        this._tabListeners.push({ button, clickHandler, keydownHandler });

        headers.appendChild(button);

        // Initial state - hide all except first
        if (panel instanceof HTMLElement) {
          panel.hidden = index !== 0;
        }
      });
    }
  }

  if (!customElements.get("ui-tabs")) {
    customElements.define("ui-tabs", TabsComponent);
  }
</script>

<ui-tabs class:list={[className]}>
  <div
    class="tab-headers"
    role="tablist"
    aria-label="Tabbed Content"
  >
  </div>
  <div class="tab-content">
    <slot />
  </div>
</ui-tabs>

<style is:global>
  ui-tabs {
    position: relative;
    display: block;
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  ui-tabs .tab-headers {
    display: flex;
    overflow: auto hidden;
    scrollbar-width: thin;
    background: var(--color-bg-header);
    border-bottom: var(--border-1);
  }

  ui-tabs .tab-headers::-webkit-scrollbar {
    height: 4px;
  }

  ui-tabs .tab-headers button {
    flex-shrink: 0;
    padding: 0.75rem 1.25rem;
    font-size: 0.9rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    white-space: nowrap;
    appearance: none;
    cursor: pointer;
    background: transparent;
    border: none;
    border-right: var(--border-1);
    border-bottom: 2px solid transparent;
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s;
  }

  ui-tabs .tab-headers button:hover {
    color: var(--color-text-body);
    background: rgb(255 255 255 / 2%);
  }

  ui-tabs .tab-headers button[aria-selected="true"] {
    margin-bottom: -1px;
    color: var(--color-primary);
    background: var(--color-bg-secondary);
    border-bottom-color: var(--color-primary);
  }

  ui-tabs .tab-content {
    position: relative;
    max-width: 100%;
    padding: 0;
  }

  ui-tabs .tab-panel {
    padding: 1.5rem;

    /* No animation - content should appear instantly */
  }

  /* For code-only tabs (no padding needed) */
  ui-tabs .tab-panel.no-padding {
    padding: 0;
  }

  /* Responsive overflow handling */
  ui-tabs pre,
  ui-tabs .mermaid {
    max-width: 100% !important;
    overflow-x: auto !important;
  }

  ui-tabs img,
  ui-tabs svg {
    max-width: 100%;
    height: auto;
  }

  /* Fix for code blocks inside tabs having mismatched background in light mode */

  /* REMOVED to fix accessibility contrast issues. Code blocks will now have their own background (card style) */

  /* ui-tabs .astro-code,
    ui-tabs .astro-code span {
        background-color: transparent !important;
    } */
</style>
