---
/**
 * KeyspaceThreat Component
 *
 * A zero-JS "secret keyspace vs attacker throughput" infographic. Shows how big
 * a secret's keyspace is (e.g. a 4-digit PIN = 10^4) against how many guesses an
 * offline attacker grinds per second through the KDF, and prints the resulting
 * time-to-exhaust. The keyspace bar is drawn on a logarithmic scale against the
 * throughput so the visual gap reads honestly even when one number dwarfs the
 * other. Theme-aware, responsive, accessible (role="img" + sr-only table).
 *
 * Content copy is passed in as props (so it can live in MDX); generic chrome
 * (sr-only table headers, scale note) and numeric grouping are localised from
 * the active page locale via components.keyspaceThreat.* keys.
 *
 * @example
 * <KeyspaceThreat
 *   ariaLabel="A 4-digit PIN has 10,000 combinations; one GPU runs 11.16 million KDF guesses per second, exhausting the keyspace in under a millisecond."
 *   secretLabel="4-digit PIN"
 *   keyspace={10000}
 *   keyspaceNote="10^4 = 10,000 combinations"
 *   throughputLabel="1× RTX 5090, PBKDF2-HMAC-SHA256"
 *   throughput={11160000}
 *   throughputNote="11.16 MH/s (hashcat mode 10900)"
 *   verdict="< 1 ms to try every PIN"
 *   verdictTone="bad"
 * />
 */

import { getLangFromUrl, useTranslations } from "@i18n/utils";

interface Props {
  /** Name of the secret being attacked (e.g. "4-digit PIN"). */
  secretLabel: string;
  /** Number of possible values in the keyspace (e.g. 10000). */
  keyspace: number;
  /** Short note under the keyspace figure. */
  keyspaceNote?: string;
  /** Label for the attacker throughput row. */
  throughputLabel: string;
  /** Guesses per second the attacker sustains through the KDF. */
  throughput: number;
  /** Short note under the throughput figure. */
  throughputNote?: string;
  /** Verdict line (the time-to-exhaust takeaway). */
  verdict: string;
  /** Verdict tone: "bad" (attacker wins) or "good" (defender wins). */
  verdictTone?: "bad" | "good";
  /** Optional title above the figure. */
  title?: string;
  /** Caption below the figure. */
  caption?: string;
  /** Accessibility label for the whole figure (required). */
  ariaLabel: string;
}

const {
  secretLabel,
  keyspace,
  keyspaceNote,
  throughputLabel,
  throughput,
  throughputNote,
  verdict,
  verdictTone = "bad",
  title,
  caption,
  ariaLabel,
} = Astro.props as Props;

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
const nf = new Intl.NumberFormat(locale, { useGrouping: "always" });

// Log scale: both magnitudes share one axis so the gap between a tiny keyspace
// and a huge throughput is legible. Guard against <= 0.
const safeKeyspace = Math.max(1, keyspace);
const safeThroughput = Math.max(1, throughput);
const logMax = Math.log10(Math.max(safeKeyspace, safeThroughput, 10));
const keyspacePct = (Math.log10(safeKeyspace) / logMax) * 100;
const throughputPct = (Math.log10(safeThroughput) / logMax) * 100;

const rows = [
  {
    kind: "keyspace",
    label: secretLabel,
    value: nf.format(keyspace),
    note: keyspaceNote,
    pct: keyspacePct,
  },
  {
    kind: "throughput",
    label: throughputLabel,
    value: `${nf.format(throughput)} /s`,
    note: throughputNote,
    pct: throughputPct,
  },
];
---

<figure
  class="kst"
  role="img"
  aria-label={ariaLabel}
>
  {title && <figcaption class="kst__title">{title}</figcaption>}

  <div class="kst__rows">
    {
      rows.map((r) => (
        <div class={`kst__row kst__row--${r.kind}`}>
          <div class="kst__head">
            <span class="kst__label">{r.label}</span>
            <span class="kst__value">{r.value}</span>
          </div>
          <div class="kst__track">
            <div
              class={`kst__bar kst__bar--${r.kind}`}
              style={`width:${r.pct.toFixed(2)}%`}
            />
          </div>
          {r.note && <span class="kst__note">{r.note}</span>}
        </div>
      ))
    }
  </div>

  <p class={`kst__verdict kst__verdict--${verdictTone}`}>
    <span
      class={`kst__verdict-icon ${verdictTone === "good" ? "i-mdi:shield-check" : "i-mdi:skull-outline"}`}
      aria-hidden="true"
    ></span>
    {verdict}
  </p>

  <p
    class="kst__scale-note"
    aria-hidden="true"
  >
    {t("components.keyspaceThreat.scaleNote")}
  </p>

  <table class="sr-only">
    <caption
      >{
        title ??
          t("components.keyspaceThreat.tableCaption", { secret: secretLabel })
      }</caption
    >
    <thead>
      <tr>
        <th scope="col">{t("components.keyspaceThreat.quantity")}</th>
        <th scope="col">{t("components.keyspaceThreat.value")}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td
          >{
            t("components.keyspaceThreat.keyspaceRow", { secret: secretLabel })
          }</td
        >
        <td>{nf.format(keyspace)}</td>
      </tr>
      <tr>
        <td>{throughputLabel}</td>
        <td
          >{nf.format(throughput)}
          {t("components.keyspaceThreat.guessesPerSec")}</td
        >
      </tr>
      <tr>
        <td>{t("components.keyspaceThreat.verdict")}</td>
        <td>{verdict}</td>
      </tr>
    </tbody>
  </table>

  {caption && <p class="kst__caption">{caption}</p>}
</figure>

<style>
  .kst {
    --kst-keyspace: #fbbf24;
    --kst-throughput: #f0789b;
    --kst-good: #6ee7a8;
    --kst-bad: #f0789b;

    margin: 1.5rem 0;
  }

  @media (prefers-color-scheme: light) {
    .kst {
      --kst-keyspace: #92400e;
      --kst-throughput: #be123c;
      --kst-good: #15803d;
      --kst-bad: #be123c;
    }
  }

  :root[data-theme="dark"] .kst {
    --kst-keyspace: #fbbf24;
    --kst-throughput: #f0789b;
    --kst-good: #6ee7a8;
    --kst-bad: #f0789b;
  }

  :root[data-theme="light"] .kst {
    --kst-keyspace: #92400e;
    --kst-throughput: #be123c;
    --kst-good: #15803d;
    --kst-bad: #be123c;
  }

  .kst__title {
    margin-bottom: 1rem;
    font-size: 1rem;
    font-weight: var(--fw-semibold, 600);
    color: var(--color-text-heading);
  }

  .kst__rows {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .kst__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }

  .kst__label {
    font-size: 0.85rem;
    font-weight: var(--fw-semibold, 600);
    color: var(--color-text-heading);
  }

  .kst__value {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text);
  }

  .kst__track {
    width: 100%;
    height: 1.1rem;
    background: var(--color-bg-subtle);
    border: var(--border-1);
    border-radius: var(--radius-sm, 4px);
  }

  .kst__bar {
    min-width: 3px;
    height: 100%;
    border-radius: var(--radius-sm, 4px);
  }

  .kst__bar--keyspace {
    background: var(--kst-keyspace);
  }

  .kst__bar--throughput {
    background: var(--kst-throughput);
  }

  .kst__note {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .kst__verdict {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.6rem 0.85rem;
    margin: 1.1rem 0 0;
    font-size: 0.9rem;
    font-weight: var(--fw-semibold, 600);
    background: var(--color-bg-subtle);
    border-left: 4px solid var(--color-border);
    border-radius: var(--radius-sm, 4px);
  }

  .kst__verdict--bad {
    color: var(--kst-bad);
    border-left-color: var(--kst-bad);
  }

  .kst__verdict--good {
    color: var(--kst-good);
    border-left-color: var(--kst-good);
  }

  .kst__verdict-icon {
    flex-shrink: 0;
    width: 1.15rem;
    height: 1.15rem;
  }

  .kst__scale-note {
    margin: 0.5rem 0 0;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .kst__caption {
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    clip-path: inset(50%);
  }
</style>
