---
/**
 * Code Component
 * Displays a code block with support for syntax highlighting and a copy button.
 *
 * NOTE: We use a <span> with 'display: block' instead of a <code> tag because
 * MDX often injects <p> tags inside code slots, which is invalid inside <code>.
 *
 * Usage:
 * <Code lang="javascript">
 *   console.log('Hello');
 * </Code>
 */
import CopyButton from "./CopyButton.astro";

interface Props {
  lang?: string; // Language for syntax highlighting (e.g., 'nginx', 'javascript')
  class?: string;
}

const { lang = "text", class: className } = Astro.props;
---

<div class:list={["code-wrapper", "copy-container", className]}>
  <pre><span class={`code-content language-${lang}`}><slot /></span></pre>
  <CopyButton class="code-copy-button" />
</div>

<style>
  @import url("@styles/components/code-shared.css");

  .code-content {
    /* Inherit shared content styles */
    @apply shared-code-content;

    display: block; /* Ensure it behaves like a block for multi-line */
  }

  .code-wrapper {
    position: relative;
    margin: 1.5rem 0;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .code-wrapper :global(.code-copy-button) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 10;
  }

  pre {
    /* Inherit shared container styles */
    @apply shared-code-container;

    padding: 0.75rem 1rem; /* Reduced vertical padding from 1rem */
    padding-right: 3rem; /* Space for copy button */
    margin: 0;
    background-color: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  code {
    /* Inherit shared content styles */
    @apply shared-code-content;
  }

  code :global(p) {
    display: inline;
    margin: 0;
  }

  code.language-nginx,
  code.language-bash,
  code.language-shell {
    color: var(--color-text);
  }
</style>
