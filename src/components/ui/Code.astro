---
/**
 * Code Component
 * Displays a code block with support for syntax highlighting and a copy button.
 *
 * NOTE: We use a <span> with 'display: block' instead of a <code> tag because
 * MDX often injects <p> tags inside code slots, which is invalid inside <code>.
 *
 * Usage:
 * <Code lang="javascript">
 *   console.log('Hello');
 * </Code>
 */
import { randomUUID } from "node:crypto";

import CopyButton from "./CopyButton.astro";

interface Props {
  lang?: string; // Language for syntax highlighting (e.g., 'nginx', 'javascript')
  class?: string;
}

const { lang = "text", class: className } = Astro.props;
const uuid = randomUUID().slice(0, 8);
---

<section
  class:list={["code-wrapper", "copy-container", className]}
  aria-label={`${lang} code snippet ${uuid}`}
>
  <pre><span class={`code-content language-${lang}`}><slot /></span></pre>
  <CopyButton class="code-copy-button" />
</section>

<style>
  .code-content {
    display: block; /* Ensure it behaves like a block for multi-line */
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
    white-space: pre;

    /* Mobile Fix: Prevent font inflation */
    /* stylelint-disable-next-line property-no-vendor-prefix */
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
  }

  .code-wrapper {
    position: relative;
    margin: 1.5rem 0;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .code-wrapper :global(.code-copy-button) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 10;
  }

  pre {
    display: block; /* Simpler block layout to avoid flex-related boosting */
    width: 100%; /* Explicit width constraint */
    min-width: 0;
    max-width: 100%; /* Ensure it doesn't overflow parent calculation */
    padding: 0.75rem 1rem; /* Reduced vertical padding from 1rem */
    padding-right: 3rem; /* Space for copy button */
    margin: 0;
    overflow-x: auto;

    /* Typography */
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    background-color: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);

    /* Mobile Fix: Prevent font inflation */
    /* stylelint-disable-next-line property-no-vendor-prefix */
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
    white-space: pre;

    /* Mobile Fix: Prevent font inflation */
    /* stylelint-disable-next-line property-no-vendor-prefix */
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
  }

  code :global(p) {
    display: inline;
    margin: 0;
  }

  code.language-nginx,
  code.language-bash,
  code.language-shell {
    color: var(--color-text);
  }
</style>
