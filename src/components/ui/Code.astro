---
/**
 * Code Component
 * Displays a code block with support for syntax highlighting and a copy button.
 *
 * NOTE: We use a <span> with 'display: block' instead of a <code> tag because
 * MDX often injects <p> tags inside code slots, which is invalid inside <code>.
 *
 * Usage:
 * <Code lang="javascript">
 *   console.log('Hello');
 * </Code>
 */
import { createHash } from "node:crypto";

import { decodeHtml } from "@utils/html";
import * as cheerio from "cheerio";

import CopyButton from "./CopyButton.astro";

interface Props {
  lang?: string; // Language for syntax highlighting (e.g., 'nginx', 'javascript')
  class?: string;
  ariaLabel?: string;
}

const { lang = "text", class: className, ariaLabel } = Astro.props;

const slotContent = await Astro.slots.render("default");
const trimmedContent = slotContent.trim();
const uuid = createHash("sha256")
  .update(trimmedContent)
  .digest("hex")
  .slice(0, 8);

// Extract plain text for accessibility label if no custom label provided
let plainText = "";
if (!ariaLabel) {
  const $ = cheerio.load(slotContent);
  plainText = decodeHtml($.text().trim()).slice(0, 50);
  if (plainText.length === 50) plainText += "...";
}

const finalAriaLabel = ariaLabel || `Code snippet: ${lang} - ${plainText}`;
---

<section
  class:list={["code-wrapper", "copy-container", className]}
  aria-label={finalAriaLabel}
  data-testid={uuid}
>
  <pre><span class={`code-content language-${lang}`} set:html={trimmedContent} /></pre>
  <CopyButton class="code-copy-button" />
</section>

<style>
  .code-content {
    display: block; /* Ensure it behaves like a block for multi-line */
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
    white-space: pre;

    /* Mobile Fix: Prevent font inflation */
    /* stylelint-disable-next-line property-no-vendor-prefix */
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
  }

  .code-wrapper {
    position: relative;
    margin: 1.5rem 0;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .code-wrapper :global(.code-copy-button) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 10;
  }

  pre {
    display: block; /* Simpler block layout to avoid flex-related boosting */
    width: 100%; /* Explicit width constraint */
    min-width: 0;
    max-width: 100%; /* Ensure it doesn't overflow parent calculation */
    padding: 0.4rem 1rem;
    padding-right: 3rem; /* Space for copy button */
    margin: 0;
    overflow-x: auto;

    /* Typography */
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    background-color: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);

    /* Mobile Fix: Prevent font inflation */
    /* stylelint-disable-next-line property-no-vendor-prefix */
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
    white-space: pre;

    /* Mobile Fix: Prevent font inflation */
    /* stylelint-disable-next-line property-no-vendor-prefix */
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
  }

  code :global(p) {
    display: inline;
    margin: 0;
  }

  .code-content.language-nginx,
  .code-content.language-bash,
  .code-content.language-shell {
    color: var(--color-text);
  }
</style>
