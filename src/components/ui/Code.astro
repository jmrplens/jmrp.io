---
/**
 * Code — syntax-highlighted snippet with a header (language LED + title + copy).
 *
 * Syntax highlighting is Shiki with the project config (see @utils/shiki); this
 * component only provides the chrome. For code without a header use <CodeBlock>.
 *
 * Usage:
 *   <Code lang="nginx" title="nginx.conf">server { listen 80; }</Code>
 *   <Code lang="bash" lineNumbers>npm install</Code>
 */
import { createHash } from "node:crypto";

import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import { decodeHtml } from "@utils/html";
import { highlightCode, resolveShikiLanguage } from "@utils/shiki";
import type { BuiltinLanguage, SpecialLanguage } from "shiki";

import CopyButton from "./CopyButton.astro";

interface Props {
  lang?: BuiltinLanguage | SpecialLanguage | string;
  "aria-label"?: string;
  title?: string;
  lineNumbers?: boolean;
  class?: string;
}

const {
  lang = "text",
  "aria-label": ariaLabel,
  title,
  lineNumbers = false,
  class: className,
} = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Render slot content (may be raw text or already-rendered <pre><code> HTML).
const slotContent = await Astro.slots.render("default");
const trimmedContent = slotContent.trim();
const isHtml = /^<(?:pre|code)\b/i.test(trimmedContent);
const isEmpty = !trimmedContent;

// Extract raw code for highlighting.
let rawCode = trimmedContent;
if (isHtml) {
  const match = trimmedContent.match(
    /^<pre[^>]*><code[^>]*>([\s\S]*?)<\/code><\/pre>$/,
  );
  const inner = match ? match[1] : trimmedContent;
  rawCode = decodeHtml(inner.replaceAll(/<[^>]*>/g, ""));
} else {
  rawCode = decodeHtml(trimmedContent);
}

// Stable id for tests.
const uuid = createHash("sha256")
  .update(`${lang}-${rawCode}`)
  .digest("hex")
  .slice(0, 8);

// Auto aria-label: custom > title-based > snippet preview.
let plainText = "";
if (!ariaLabel) {
  plainText = rawCode.slice(0, 50).replaceAll(/\s+/g, " ").trim();
  if (rawCode.length > 50) plainText += "...";
}
const finalAriaLabel =
  ariaLabel ||
  (title
    ? t("components.code.codeAria", { lang, title })
    : t("components.code.snippetAria", {
        lang,
        text: plainText || t("components.code.fallbackAria"),
      }));

const langDisplay = lang.toLowerCase();

// Language LED colour as a CSS class (no inline styles → CSP-safe).
const KNOWN_LANG_DOTS = new Set([
  "python",
  "py",
  "javascript",
  "js",
  "mjs",
  "typescript",
  "ts",
  "bash",
  "shell",
  "sh",
  "zsh",
  "nginx",
  "yaml",
  "yml",
  "json",
  "routeros",
  "ini",
  "toml",
  "c",
  "cpp",
  "rust",
  "rs",
  "go",
  "html",
  "css",
  "sql",
  "docker",
  "dockerfile",
  "diff",
]);
const langDotClass = KNOWN_LANG_DOTS.has(langDisplay) ? langDisplay : "default";

const highlightedHtml = isEmpty
  ? ""
  : await highlightCode(rawCode, resolveShikiLanguage(lang));
---

{
  isEmpty ? (
    <Fragment set:html="<!-- Empty code block skipped -->" />
  ) : (
    <figure
      class:list={[
        "jmrp-code",
        "copy-container",
        lineNumbers && "jmrp-code--ln",
        className,
      ]}
      aria-label={finalAriaLabel}
      data-testid={uuid}
    >
      <figcaption class="jmrp-code__head">
        <span class="jmrp-code__id">
          <span
            class:list={["jmrp-code__dot", `lang-${langDotClass}`]}
            aria-hidden="true"
          />
          <span class="jmrp-code__name">{title ?? langDisplay}</span>
        </span>
        <span class="jmrp-code__meta">
          {title && <span class="jmrp-code__lang">{langDisplay}</span>}
          <CopyButton
            content={rawCode}
            ariaLabel={t("components.code.copyAria", { label: finalAriaLabel })}
          />
        </span>
      </figcaption>
      {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- focusable scroll region for keyboard access to wide code */}
      <div
        class="jmrp-code__scroll"
        tabindex="0"
        aria-label={finalAriaLabel}
      >
        {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
        <Fragment set:html={highlightedHtml} />
      </div>
    </figure>
  )
}

<style>
  .jmrp-code__scroll {
    overflow-x: auto;
    outline: none;
  }

  .jmrp-code__scroll:focus-visible {
    outline: 2px solid transparent;
    box-shadow: inset 0 0 0 2px var(--color-primary);
  }

  .jmrp-code {
    margin: var(--space-md-lg) 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-lg);
  }

  .jmrp-code__head {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    justify-content: space-between;
    padding: var(--code-header-py) 12px var(--code-header-py) 16px;
    background: var(--color-surface-2);
    border-bottom: var(--border-hair);
  }

  .jmrp-code__id {
    display: flex;
    gap: 9px;
    align-items: center;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--code-filename-size);
    line-height: 1.5;
    color: var(--color-text-heading);
  }

  .jmrp-code__dot {
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  .jmrp-code__name {
    overflow-wrap: anywhere;
  }

  .jmrp-code__meta {
    display: flex;
    flex: none;
    gap: 8px;
    align-items: center;
  }

  .jmrp-code__lang {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-accent);
  }

  /* Language LED colours (GitHub-linguist-ish). */
  .lang-python,
  .lang-py {
    background: #3572a5;
  }

  .lang-javascript,
  .lang-js,
  .lang-mjs {
    background: #f1e05a;
  }

  .lang-typescript,
  .lang-ts {
    background: #3178c6;
  }

  .lang-bash,
  .lang-shell,
  .lang-sh,
  .lang-zsh {
    background: #4eaa25;
  }

  .lang-nginx {
    background: #009639;
  }

  .lang-yaml,
  .lang-yml {
    background: #cb171e;
  }

  .lang-json {
    background: #cbcb41;
  }

  .lang-routeros {
    background: #e3b23c;
  }

  .lang-ini {
    background: #6e6d64;
  }

  .lang-toml {
    background: #9c4221;
  }

  .lang-c {
    background: #a8b9cc;
  }

  .lang-cpp {
    background: #f34b7d;
  }

  .lang-rust,
  .lang-rs {
    background: #dea584;
  }

  .lang-go {
    background: #00add8;
  }

  .lang-html {
    background: #e34c26;
  }

  .lang-css {
    background: #563d7c;
  }

  .lang-sql {
    background: #e38c00;
  }

  .lang-docker,
  .lang-dockerfile {
    background: #2496ed;
  }

  .lang-diff {
    background: #8c8a82;
  }
</style>
