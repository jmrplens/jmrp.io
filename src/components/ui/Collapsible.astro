---
/**
 * Collapsible Component
 * A native HTML details/summary component for toggleable content.
 *
 * Usage:
 * <Collapsible summary="Click to expand">
 *   Hidden content here.
 * </Collapsible>
 *
 * Note: `title` is accepted as an alias for `summary` for compatibility.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  /** The visible text for the collapsible toggle */
  summary?: string;
  /** Alias for summary (backward compatibility) */
  title?: string;
  /** Start expanded. */
  open?: boolean;
  class?: string;
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const { summary, title, open = false, class: className } = Astro.props;
const summaryText =
  summary ?? title ?? t("components.collapsible.defaultSummary");
---

<details
  class:list={["collapsible-wrapper", className]}
  open={open}
>
  <summary>
    <span
      class="i-mdi:menu-right chevron"
      aria-hidden="true"
    ></span>
    <span class="summary-text">{summaryText}</span>
  </summary>
  <div class="collapsible-content">
    <slot />
  </div>
</details>

<style>
  .collapsible-wrapper {
    margin: 1.5rem 0;
    overflow: clip; /* Use clip instead of hidden to allow focus ring */
    overflow-clip-margin: 4px; /* Allow focus ring to render outside */
    background-color: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-lg);
  }

  summary {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 15px 18px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text-heading);
    cursor: pointer;
    list-style: none; /* Remove default marker */
    transition: background-color var(--dur-2) var(--ease-out);
  }

  summary:focus-visible {
    /* Use inset box-shadow for focus ring that respects border-radius */
    outline: none;
    border-radius: var(--radius-lg);
    box-shadow:
      inset 0 0 0 2px var(--color-primary),
      0 0 0 2px var(--color-primary);
  }

  summary::-webkit-details-marker {
    display: none; /* Remove default marker for Safari */
  }

  .summary-text {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  /* Accent ▸ marker on the left; rotates down when open (Lab mockup). */
  .chevron {
    flex-shrink: 0;
    width: 0.95em;
    height: 0.95em;
    color: var(--color-accent);
    transition: transform var(--dur-2) var(--ease-in-out);
  }

  .collapsible-wrapper[open] > summary .chevron {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    summary,
    .chevron {
      transition: none;
    }
  }

  .collapsible-content {
    padding: 0 18px 18px 42px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-text);
  }

  /* Handle nested margins gracefully */
  .collapsible-content > :first-child {
    margin-top: 0 !important;
  }

  .collapsible-content > :last-child {
    margin-bottom: 0 !important;
  }
</style>
