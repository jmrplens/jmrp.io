---
/**
 * Collapsible Component
 * A native HTML details/summary component for toggleable content.
 *
 * Usage:
 * <Collapsible summary="Click to expand">
 *   Hidden content here.
 * </Collapsible>
 *
 * Note: `title` is accepted as an alias for `summary` for compatibility.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  /** The visible text for the collapsible toggle */
  summary?: string;
  /** Alias for summary (backward compatibility) */
  title?: string;
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const { summary, title } = Astro.props;
const summaryText =
  summary ?? title ?? t("components.collapsible.defaultSummary");
---

<details class="collapsible-wrapper">
  <summary>
    <span class="summary-text">{summaryText}</span>
    <span
      class="icon-wrapper"
      aria-hidden="true"
    >
      <svg
        class="chevron"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </span>
  </summary>
  <div class="collapsible-content">
    <slot />
  </div>
</details>

<style>
  .collapsible-wrapper {
    margin: 1.5rem 0;
    overflow: clip; /* Use clip instead of hidden to allow focus ring */
    overflow-clip-margin: 4px; /* Allow focus ring to render outside */
    background-color: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .collapsible-wrapper[open] {
    border-color: var(--color-primary);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 1rem;
    font-weight: 500;
    color: var(--color-text);
    cursor: pointer;
    list-style: none; /* Remove default marker */
    transition: background-color 0.2s;
  }

  summary:focus-visible {
    /* Use inset box-shadow for focus ring that respects border-radius */
    outline: none;
    border-radius: var(--radius-md);
    box-shadow:
      inset 0 0 0 2px var(--color-primary),
      0 0 0 2px var(--color-primary);
  }

  summary::-webkit-details-marker {
    display: none; /* Remove default marker for Safari */
  }

  .collapsible-wrapper[open] > summary {
    background-color: var(--color-bg-header);
    border-bottom: var(--border-1);
  }

  .summary-text {
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .icon-wrapper {
    transition: transform 0.2s ease-in-out;
  }

  .collapsible-wrapper[open] > summary .icon-wrapper {
    transform: rotate(180deg);
  }

  .collapsible-content {
    padding: 1rem;
  }

  /* Handle nested margins gracefully */
  .collapsible-content > :first-child {
    margin-top: 0 !important;
  }

  .collapsible-content > :last-child {
    margin-bottom: 0 !important;
  }
</style>
