---
/**
 * Prerequisite Component
 * Box with structured prerequisites for tutorials.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  title?: string;
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const { title = t("components.prerequisite.title") } = Astro.props;

// Generate unique ID for aria-labelledby
const titleId = `prereq-${crypto.randomUUID().slice(0, 8)}`;
---

<aside
  class="prerequisite"
  aria-labelledby={titleId}
>
  <div class="prereq-header">
    <span
      class="i-mdi:clipboard-check-outline prereq-icon"
      aria-hidden="true"
    ></span>
    <span
      class="prereq-title"
      id={titleId}
      >{title}</span
    >
  </div>
  <div class="prereq-content">
    <slot />
  </div>
</aside>

<style>
  .prerequisite {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .prereq-header {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 13px 18px;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-hair);
  }

  .prereq-icon {
    width: 15px;
    height: 15px;
    color: var(--color-accent);
  }

  .prereq-title {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
    letter-spacing: 0.05em;
  }

  .prereq-content {
    padding: 1rem 1.125rem;
  }

  /*
   * Style for skill/tool lists.
   *
   * ACCESSIBILITY NOTE: Safari/VoiceOver may drop list semantics when
   * list-style:none is applied. If you pass a <ul> or <ol> to this component
   * and need proper list semantics announced, add role="list" to the list
   * element and role="listitem" to its <li> children.
   */
  .prereq-content :global(ul),
  .prereq-content :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 0 0 0 1.125rem;
    margin: 0;
    list-style: none;
  }

  .prereq-content :global(ol) {
    counter-reset: prereq-counter;
  }

  .prereq-content :global(li) {
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-text);
  }

  /* Ordered lists keep a numbered marker; unordered lists are clean indented. */
  .prereq-content :global(ol li) {
    position: relative;
    padding-left: 1.5rem;
  }

  .prereq-content :global(ol li::before) {
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    color: var(--color-accent);
    content: counter(prereq-counter) ".";
    counter-increment: prereq-counter;
  }

  .prereq-content :global(li strong) {
    color: var(--color-text-heading);
  }

  .prereq-content :global(code) {
    padding: 0.0625rem 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    background: var(--color-surface-2);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-sm);
  }

  /* Sections within prerequisites — mono "// label" Lab kicker. */
  .prereq-content :global(h4),
  .prereq-content :global(h5) {
    margin: 0.75rem 0 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .prereq-content :global(h4:first-child),
  .prereq-content :global(h5:first-child) {
    margin-top: 0;
  }

  .prereq-content :global(p) {
    margin: 0.5rem 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .prereq-content :global(p:first-child) {
    margin-top: 0;
  }
</style>
