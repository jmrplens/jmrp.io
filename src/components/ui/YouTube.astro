---
/**
 * YouTube Component
 * Embeds a responsive YouTube video with optimized loading.
 *
 * Usage:
 * <YouTube id="dQw4w9WgXcQ" title="Video Title" />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  id: string; // Video ID
  title?: string;
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const { id, title = t("components.youtube.defaultTitle") } = Astro.props;
---

<div class="youtube-embed">
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${id}`}
    title={title}
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
    loading="lazy"
    sandbox="allow-scripts allow-same-origin allow-presentation"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
  ></iframe>
</div>

<style>
  .youtube-embed {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 2rem 0;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-md);
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 10%),
      0 2px 4px -1px rgb(0 0 0 / 6%);
  }

  iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
