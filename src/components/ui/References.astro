---
/**
 * References component (Simple).
 * Renders a flat, bordered list of external reference links (Lab mockup):
 * an accent ↗ marker + the reference title. No favicon cards / hover lift.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Reference {
  text: string;
  url: string;
}

interface Props {
  references?: Reference[];
}

const { references = [] } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
---

{
  references.length > 0 && (
    <div class="references-section">
      <div class="header">
        <span
          class="i-mdi:book-open-page-variant-outline header-icon"
          aria-hidden="true"
        />
        <h3>{t("components.references.title")}</h3>
      </div>
      <div class="references-list">
        {references.map((ref) => {
          let urlObj: URL | null = null;

          try {
            urlObj = new URL(ref.url);
            const allowedProtocols = ["http:", "https:"];
            if (
              !allowedProtocols.includes(urlObj.protocol) &&
              urlObj.protocol !== "mailto:" &&
              urlObj.protocol !== "tel:"
            ) {
              throw new Error(`Invalid protocol: ${urlObj.protocol}`);
            }
          } catch {
            console.warn(
              `[References] Invalid URL for reference "${ref.text}": ${ref.url}`,
            );
            return null;
          }

          // Determine if this is an external link (http/https)
          const isExternalLink =
            urlObj?.protocol === "http:" || urlObj?.protocol === "https:";

          // Always give the anchor an accessible name: fall back to the
          // hostname (then the raw URL) when a reference has empty text.
          const label = ref.text?.trim() || urlObj?.hostname || ref.url;

          return (
            <a
              href={ref.url}
              {...(isExternalLink
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
              data-astro-prefetch="false"
              class="reference-link"
            >
              <span
                class="i-mdi:arrow-top-right ref-marker"
                aria-hidden="true"
              />
              <span class="ref-text">{label}</span>
            </a>
          );
        })}
      </div>
    </div>
  )
}

<style>
  .references-section {
    padding-top: 2rem;
    margin-top: 4rem;
    border-top: 1px dashed var(--color-border);
  }

  .header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1.5rem;
    color: var(--color-text-heading);
  }

  .header-icon {
    font-size: var(--text-2xl);
    color: var(--color-primary);
  }

  .header h3 {
    margin: 0;
    font-size: var(--text-xl);
  }

  /* Flat bordered container holding a simple vertical link list (mockup). */
  .references-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 18px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .reference-link {
    display: flex;
    gap: 11px;
    align-items: baseline;
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-out);
  }

  .ref-marker {
    flex-shrink: 0;
    width: 0.95em;
    height: 0.95em;
    color: var(--color-accent);
    transform: translateY(0.12em);
  }

  .ref-text {
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--color-text-heading);
  }

  .reference-link:hover .ref-text,
  .reference-link:focus-visible .ref-text {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .reference-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .reference-link {
      transition: none;
    }
  }
</style>
