---
/**
 * References component (Simple).
 * Renders a grid of external reference cards from a given prop.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Reference {
  text: string;
  url: string;
}

interface Props {
  references?: Reference[];
}

const { references = [] } = Astro.props;

const iconFiles = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/icons/*.webp",
  {
    eager: true,
  },
);
---

{
  references.length > 0 && (
    <div class="references-section">
      <div class="header">
        <Icon
          name="mdi:book-open-page-variant-outline"
          class="header-icon"
        />
        <h3>Further Reading &amp; Resources</h3>
      </div>
      <div class="references-grid">
        {references.map((ref) => {
          let urlObj: URL | null = null;
          let hostname = "";
          let iconModule: { default: ImageMetadata } | undefined;

          try {
            urlObj = new URL(ref.url);
            const allowedProtocols = ["http:", "https:"];
            if (
              !allowedProtocols.includes(urlObj.protocol) &&
              urlObj.protocol !== "mailto:" &&
              urlObj.protocol !== "tel:"
            ) {
              throw new Error(`Invalid protocol: ${urlObj.protocol}`);
            }
            hostname = urlObj.hostname;
            const iconName = hostname.replaceAll(/[^a-z0-9]/gi, "_");
            const iconPath = `/src/assets/icons/${iconName}.webp`;
            iconModule = iconFiles[iconPath];
          } catch {
            console.warn(
              `[References] Invalid URL for reference "${ref.text}": ${ref.url}`,
            );
            return null;
          }

          return (
            <a
              href={ref.url}
              target="_blank"
              rel="noopener noreferrer"
              class="reference-card"
              aria-label={`${ref.text} (${hostname}${urlObj.pathname === "/" ? "" : urlObj.pathname})`}
            >
              <div class="card-icon">
                {iconModule ? (
                  <Image
                    src={iconModule.default}
                    alt={`${hostname} icon`}
                    width={40}
                    height={40}
                    format="webp"
                    widths={[40, 80, 120]}
                    class="ref-favicon"
                    loading="lazy"
                  />
                ) : (
                  <div class="fallback-icon">
                    <Icon name="mdi:web" />
                  </div>
                )}
              </div>
              <div class="card-content">
                <span class="ref-text">{ref.text}</span>
                <span class="ref-url">{hostname}</span>
              </div>
              <div class="card-arrow">
                <Icon name="mdi:arrow-top-right" />
              </div>
            </a>
          );
        })}
      </div>
    </div>
  )
}

<style>
  .references-section {
    padding-top: 2rem;
    margin-top: 4rem;
    border-top: 1px dashed var(--color-border);
  }

  .header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1.5rem;
    color: var(--color-heading);
  }

  .header-icon {
    font-size: 1.5rem;
    color: var(--color-primary);
  }

  .header h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .references-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }

  .reference-card {
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    overflow: hidden;
    color: var(--color-text-body);
    text-decoration: none;
    background: var(--color-subtle-bg, rgb(125 125 125 / 5%));
    border: var(--border-1);
    border-radius: 12px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reference-card:hover {
    background: var(--color-card-bg, rgb(125 125 125 / 10%));
    border-color: var(--color-primary);
    box-shadow: 0 4px 12px rgb(0 0 0 / 5%);
    transform: translateY(-3px);
  }

  .card-icon {
    position: relative;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    overflow: hidden;
    border-radius: 10px;
  }

  .ref-favicon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .fallback-icon {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 1.5rem;
    color: var(--color-text-muted);
  }

  .card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.15rem;
  }

  .ref-text {
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .ref-url {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    opacity: 70%;
  }

  .card-arrow {
    color: var(--color-primary);
    opacity: 0%;
    transform: translateX(-10px);
    transition: all 0.3s ease;
  }

  .reference-card:hover .card-arrow {
    opacity: 100%;
    transform: translateX(0);
  }
</style>
