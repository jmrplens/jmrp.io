---
/**
 * CopyButton — shared copy-to-clipboard button (Code, CodeBlock, FileContent,
 * Terminal family, tabs, publications…).
 *
 * Discreet chrome: no background box — icon + colour change + a green check and
 * "Copied" confirmation for ~1.6 s. `variant="terminal"` tunes the colours for
 * the dark terminal surface.
 *
 * Text to copy (in order):
 *   1. `content` / `code` prop → data-content (URL-encoded)
 *   2. otherwise the nearest `.copy-container`'s <code> or .copy-content
 *
 * Accessible: real <button>, aria-label updates to the copied message, an
 * aria-live status announces the copy, focus-visible ring, reduced-motion.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  class?: string;
  /** Explicit text to copy. `code` is an alias kept for the code family. */
  content?: string;
  code?: string;
  /** ARIA label (idle). `label` is an alias. */
  ariaLabel?: string;
  label?: string;
  /** Confirmation text/label. Defaults to t("ui.copied"). */
  copiedLabel?: string;
  variant?: "default" | "terminal";
  /** Optional visible label next to the icon (e.g. "Copy", "Commands"). */
  text?: string;
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const {
  class: className,
  content,
  code,
  ariaLabel,
  label,
  copiedLabel,
  variant = "default",
  text,
} = Astro.props;

const copyText = content ?? code;
const encodedContent = copyText ? encodeURIComponent(copyText) : undefined;
const idleLabel = ariaLabel ?? label ?? t("aria.copyToClipboard");
const doneLabel = copiedLabel ?? t("ui.copied");
---

<button
  class:list={[
    "copy-button",
    variant === "terminal" && "copy-button--term",
    className,
  ]}
  type="button"
  aria-label={idleLabel}
  data-content={encodedContent}
  data-msg-copied={doneLabel}
  data-msg-unavailable={t("components.copyButton.clipboardUnavailable")}
  data-msg-failed={t("components.copyButton.failedToCopy")}
>
  <span
    class="copy-status sr-only"
    aria-live="polite"
  ></span>
  <span class="copy-button__idle">
    <span
      class="i-mdi:clipboard-outline copy-icon"
      aria-hidden="true"
    ></span>
    {text && <span class="copy-button__text">{text}</span>}
  </span>
  <span
    class="copy-button__done"
    aria-hidden="true"
  >
    <span
      class="i-mdi:check success-icon"
      aria-hidden="true"
    ></span>
    {text && <span class="copy-button__text">{doneLabel}</span>}
  </span>
</button>

<style>
  .copy-button {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    min-width: 24px; /* WCAG 2.2 target size (icon-only would be 22px otherwise) */
    height: var(--copy-size);
    padding: 0 4px;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: var(--fw-medium);
    line-height: 1;
    color: var(--color-text-muted);
    cursor: pointer;
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    transition: color var(--dur-1) var(--ease-out);
  }

  .copy-button:hover {
    color: var(--color-text-heading);
  }

  .copy-button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .copy-button__idle,
  .copy-button__done {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }

  .copy-button__done {
    display: none;
    color: var(--color-success);
  }

  .copy-button.is-copied .copy-button__idle {
    display: none;
  }

  .copy-button.is-copied .copy-button__done {
    display: inline-flex;
  }

  .copy-icon,
  .success-icon {
    display: block;
    width: var(--copy-icon);
    height: var(--copy-icon);
    font-size: var(--copy-icon);
  }

  /* Variant over the dark terminal surface */
  .copy-button--term {
    color: var(--term-dim);
  }

  .copy-button--term:hover {
    color: var(--term-fg);
  }

  .copy-button--term.is-copied .copy-button__done {
    color: var(--term-ok);
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-button {
      transition: none;
    }
  }
</style>

<script>
  // Single delegated listener for every CopyButton (survives view transitions:
  // `document` persists across astro:after-swap, so no re-init is needed).
  interface CopyWin extends Window {
    __jmrpCopyInit?: boolean;
  }
  const w = window as CopyWin;
  if (!w.__jmrpCopyInit) {
    w.__jmrpCopyInit = true;

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      const button = target?.closest<HTMLButtonElement>(".copy-button");
      if (!button) return;

      // 1) explicit content, 2) nearest .copy-container's <code>/.copy-content
      let text = "";
      const raw = button.dataset.content;
      if (raw) {
        try {
          text = decodeURIComponent(raw);
        } catch {
          text = "";
        }
      }
      if (!text) {
        const wrapper =
          button.closest<HTMLElement>(".copy-container") ??
          button.parentElement;
        const source = wrapper?.querySelector<HTMLElement>(
          "code, .copy-content",
        );
        if (source) text = source.textContent?.trim() || source.innerText;
      }
      text = text.replace(/\n+$/, "");
      if (!text) return;

      if (!navigator.clipboard) {
        button.setAttribute(
          "title",
          button.dataset.msgUnavailable || "Clipboard unavailable",
        );
        return;
      }

      navigator.clipboard.writeText(text).then(
        () => {
          button.removeAttribute("title");
          button.classList.add("is-copied");
          const prevLabel = button.getAttribute("aria-label");
          const copied = button.dataset.msgCopied || "Copied";
          button.setAttribute("aria-label", copied);

          const status = button.querySelector<HTMLElement>(".copy-status");
          if (status) status.textContent = copied;

          window.clearTimeout(Number(button.dataset.copyTimeout));
          button.dataset.copyTimeout = String(
            window.setTimeout(() => {
              button.classList.remove("is-copied");
              if (prevLabel) button.setAttribute("aria-label", prevLabel);
              if (status) status.textContent = "";
              delete button.dataset.copyTimeout;
            }, 1600),
          );
        },
        () => {
          button.setAttribute(
            "title",
            button.dataset.msgFailed || "Failed to copy",
          );
        },
      );
    });
  }
</script>
