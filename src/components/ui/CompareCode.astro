---
/**
 * CompareCode Component
 * Displays two code blocks side by side for comparison (e.g., Bad vs Good).
 *
 * Usage:
 * <CompareCode badTitle="Vulnerable" goodTitle="Secure">
 *   <div slot="bad">...code...</div>
 *   <div slot="good">...code...</div>
 * </CompareCode>
 */
import { Icon } from "astro-icon/components";

import CopyButton from "./CopyButton.astro";

interface Props {
  badTitle?: string;
  goodTitle?: string;
}

const { badTitle = "Blocked / Insecure", goodTitle = "Allowed / Secure" } =
  Astro.props;
---

<div class="compare-code-wrapper">
  <div class="compare-block bad copy-container">
    <div class="header">
      <Icon
        name="mdi:close-circle-outline"
        class="icon"
      />
      <span>{badTitle}</span>
      <CopyButton class="compare-copy-button" />
    </div>
    <div class="content">
      <slot name="bad" />
    </div>
  </div>
  <div class="compare-block good copy-container">
    <div class="header">
      <Icon
        name="mdi:check-circle-outline"
        class="icon"
      />
      <span>{goodTitle}</span>
      <CopyButton class="compare-copy-button" />
    </div>
    <div class="content">
      <slot name="good" />
    </div>
  </div>
</div>

<style>
  .compare-code-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 2rem 0;
  }

  @media (width >= 768px) {
    .compare-code-wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .compare-block {
    display: flex;
    flex-direction: column;
    overflow: hidden; /* Clear clip */
    background-color: var(--color-bg-secondary); /* Standard solid background */
    border: 1px solid var(--compare-border-color);
    border-radius: var(--radius-md);
  }

  .compare-block.bad {
    --compare-border-color: var(--color-border-bad);
    --compare-header-bg: var(--color-bg-bad-header);
    --compare-header-text: #fff;
  }

  .compare-block.good {
    --compare-border-color: var(--color-border-good);
    --compare-header-bg: var(--color-bg-good-header);
    --compare-header-text: #fff;
  }

  /* Theme Tokens */
  :root {
    /* Safe Colors (WCAG AA) */
    --color-bg-bad-header: #b91c1c; /* Red 700 */
    --color-border-bad: #b91c1c;
    --color-bg-good-header: #15803d; /* Green 700 */
    --color-border-good: #15803d;
  }

  :root[data-theme="dark"] {
    --color-bg-bad-header: #991b1b; /* Red 800 */
    --color-border-bad: #7f1d1d;
    --color-bg-good-header: #166534; /* Green 800 */
    --color-border-good: #14532d;
  }

  .header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    font-weight: bold;
    color: var(--compare-header-text);
    background-color: var(--compare-header-bg);
  }

  .icon {
    font-size: 1.25rem;
    color: currentcolor;
  }

  /* Header Copy Button */
  .header :global(.compare-copy-button) {
    position: static;
    width: 28px;
    min-width: 0;
    height: 28px;
    min-height: 0;
    margin-left: auto;
    color: #fff;
    background-color: rgb(0 0 0 / 20%);
    border-color: rgb(255 255 255 / 30%);
  }

  .content {
    /* No relative positioning needed if copy button is in header */
    padding: 0;
  }

  /* Force Code Block Styles */
  .content :global(pre) {
    padding: 1rem !important;
    margin: 0 !important;
    overflow-x: auto;
    background: transparent !important; /* Let container bg show through */
    border: none !important;
    border-radius: 0 !important;
  }

  /* Ensure code text is visible */
  .content :global(code) {
    background-color: transparent !important;
  }
</style>
