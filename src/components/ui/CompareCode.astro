---
/**
 * CompareCode Component
 * Displays two code blocks side by side for comparison (e.g., Bad vs Good).
 *
 * Usage:
 * <CompareCode badTitle="Vulnerable" goodTitle="Secure">
 *   <div slot="bad">...code...</div>
 *   <div slot="good">...code...</div>
 * </CompareCode>
 */
import { Icon } from "astro-icon/components";
import CopyButton from "./CopyButton.astro";

interface Props {
  badTitle?: string;
  goodTitle?: string;
}

const { badTitle = "Blocked / Insecure", goodTitle = "Allowed / Secure" } =
  Astro.props;
---

<div class="compare-code-wrapper">
  <div class="compare-block bad copy-container">
    <div class="header">
      <Icon name="mdi:close-circle-outline" class="icon" />
      <span>{badTitle}</span>
      <CopyButton class="compare-copy-button" />
    </div>
    <div class="content">
      <slot name="bad" />
    </div>
  </div>
  <div class="compare-block good copy-container">
    <div class="header">
      <Icon name="mdi:check-circle-outline" class="icon" />
      <span>{goodTitle}</span>
      <CopyButton class="compare-copy-button" />
    </div>
    <div class="content">
      <slot name="good" />
    </div>
  </div>
</div>

<style>
  .compare-code-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 2rem 0;
  }

  @media (min-width: 768px) {
    .compare-code-wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .compare-block {
    border-radius: var(--radius-md);
    border: var(--border-1);
    min-width: 0; /* Fix for grid blowout on overflow */
    display: flex;
    flex-direction: column;
    position: relative; /* Context for sticky */
    background-color: var(--compare-bg);
    border-color: var(--compare-border);

    /* Override global theme vars for the CopyButton within this block */
    --color-text-muted: rgba(255, 255, 255, 0.9);
    --color-bg-subtle: rgba(255, 255, 255, 0.2);
    --color-bg-secondary: rgba(255, 255, 255, 0.3); /* Hover state */
  }

  .compare-block.bad {
    --compare-bg: var(--color-bg-bad);
    --compare-border: var(--color-border-bad);
    --compare-header-bg: var(--color-header-bad);
    --compare-header-text: #ffffff;
    --compare-icon-color: #ffffff;
  }

  .compare-block.good {
    --compare-bg: var(--color-bg-good);
    --compare-border: var(--color-border-good);
    --compare-header-bg: var(--color-header-good);
    --compare-header-text: #ffffff;
    --compare-icon-color: #ffffff;
  }

  /* Theme Tokens */
  :root {
    /* Light Mode Defaults */
    --color-bg-bad: rgba(
      220,
      38,
      38,
      0.02
    ); /* Reduced opacity for contrast (was 0.05) */
    --color-border-bad: rgba(220, 38, 38, 0.2);
    --color-header-bad: #b91c1c; /* Red 700 for better contrast safety */

    --color-bg-good: rgba(22, 163, 74, 0.05);
    --color-border-good: rgba(22, 163, 74, 0.2);
    --color-header-good: #15803d; /* Green 700 for accessible contrast */
  }

  :root[data-theme="dark"] {
    /* Dark Mode Defaults - Softer borders, darker headers */
    --color-bg-bad: rgba(127, 29, 29, 0.1); /* Red 900 base */
    --color-border-bad: rgba(185, 28, 28, 0.4);
    --color-header-bad: #991b1b; /* Red 800 */

    --color-bg-good: rgba(20, 83, 45, 0.1); /* Green 900 base */
    --color-border-good: rgba(21, 128, 61, 0.4);
    --color-header-good: #166534; /* Green 800 */
  }

  .header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-weight: bold;
    font-size: 0.9rem;
    background-color: var(--compare-header-bg);
    color: var(--compare-header-text);

    /* Sticky Positioning Restored */
    position: sticky;
    top: 0;
    z-index: 20;

    /* Manual Radius to match parent since overflow is visible */
    border-top-left-radius: calc(var(--radius-md) - 1px);
    border-top-right-radius: calc(var(--radius-md) - 1px);
  }

  .icon {
    font-size: 1.25rem;
    color: var(--compare-icon-color);
  }

  /* Style CopyButton in Header */
  .header :global(.compare-copy-button) {
    position: static; /* No longer absolute */
    margin-left: auto; /* Push to right */
    border-color: rgba(255, 255, 255, 0.3);
  }

  .content {
    position: relative;
    padding: 0;
    font-size: 0.9rem;
    flex: 1;
  }

  /* Adjust internal code blocks to fit better */
  .content :global(pre) {
    margin: 0 !important;
    padding: 0.75rem 1rem !important;
    /* padding-right removed, button is gone */
    border: none !important;

    /* Use standard background (same as Code component) instead of tint */
    background: var(--color-bg-secondary) !important;

    border-radius: 0 !important;

    /* Manual Radius for bottom */
    border-bottom-left-radius: calc(var(--radius-md) - 1px) !important;
    border-bottom-right-radius: calc(var(--radius-md) - 1px) !important;
  }

  /* Ensure text contrast is standard */
  .content :global(code) {
    background-color: transparent !important;
  }
</style>
