---
/**
 * CompareCode Component
 * Displays two code blocks side by side for comparison (e.g., Bad vs Good).
 *
 * Usage:
 * <CompareCode badTitle="Vulnerable" goodTitle="Secure">
 *   <div slot="bad">...code...</div>
 *   <div slot="good">...code...</div>
 * </CompareCode>
 */
import { decodeHtml } from "@utils/html";
import { Icon } from "astro-icon/components";
import * as cheerio from "cheerio";

import CopyButton from "./CopyButton.astro";

interface Props {
  badTitle?: string;
  goodTitle?: string;
  ariaLabelBad?: string;
  ariaLabelGood?: string;
  /** Optional stable test ID for the "bad" block (defaults to "compare-block-bad") */
  testIdBad?: string;
  /** Optional stable test ID for the "good" block (defaults to "compare-block-good") */
  testIdGood?: string;
}

const {
  badTitle = "Blocked / Insecure",
  goodTitle = "Allowed / Secure",
  ariaLabelBad,
  ariaLabelGood,
  testIdBad = "compare-block-bad",
  testIdGood = "compare-block-good",
} = Astro.props;

const badContent = (await Astro.slots.render("bad")).trim();
const goodContent = (await Astro.slots.render("good")).trim();

// Helper to extract text snippet
const getSnippet = (html: string) => {
  const $ = cheerio.load(html);
  const fullText = decodeHtml($.text().trim());
  let text = fullText.slice(0, 50);
  if (fullText.length > 50) text += "...";
  return text;
};

const finalAriaLabelBad =
  ariaLabelBad || `Comparison: ${badTitle} - ${getSnippet(badContent)}`;
const finalAriaLabelGood =
  ariaLabelGood || `Comparison: ${goodTitle} - ${getSnippet(goodContent)}`;
---

<div class="compare-code-wrapper">
  <section
    class="compare-block bad copy-container"
    aria-label={finalAriaLabelBad}
    data-testid={testIdBad}
  >
    <div class="header">
      <Icon
        name="mdi:close-circle-outline"
        class="icon"
      />
      <span>{badTitle}</span>
      <CopyButton class="compare-copy-button" />
    </div>
    <div
      class="content"
      set:html={badContent}
    />
  </section>
  <section
    class="compare-block good copy-container"
    aria-label={finalAriaLabelGood}
    data-testid={testIdGood}
  >
    <div class="header">
      <Icon
        name="mdi:check-circle-outline"
        class="icon"
      />
      <span>{goodTitle}</span>
      <CopyButton class="compare-copy-button" />
    </div>
    <div
      class="content"
      set:html={goodContent}
    />
  </section>
</div>

<style>
  .compare-code-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 2rem 0;
  }

  @media (width >= 768px) {
    .compare-code-wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .compare-block {
    display: flex;
    flex-direction: column;
    overflow: hidden; /* Clear clip */
    background-color: var(--color-bg-secondary); /* Standard solid background */
    border: 1px solid var(--compare-border-color);
    border-radius: var(--radius-md);
  }

  .compare-block.bad {
    --compare-border-color: var(--color-border-bad);
    --compare-header-bg: var(--color-bg-bad-header);
    --compare-header-text: var(--color-on-primary, #fff);
  }

  .compare-block.good {
    --compare-border-color: var(--color-border-good);
    --compare-header-bg: var(--color-bg-good-header);
    --compare-header-text: var(--color-on-primary, #fff);
  }

  /* Theme Tokens */
  :root {
    /* Safe Colors (WCAG AA) */
    --color-bg-bad-header: #b91c1c; /* Red 700 */
    --color-border-bad: #b91c1c;
    --color-bg-good-header: #15803d; /* Green 700 */
    --color-border-good: #15803d;
  }

  :root[data-theme="dark"] {
    --color-bg-bad-header: #991b1b; /* Red 800 */
    --color-border-bad: #7f1d1d;
    --color-bg-good-header: #166534; /* Green 800 */
    --color-border-good: #14532d;
  }

  .header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    font-weight: bold;
    color: var(--compare-header-text);
    background-color: var(--compare-header-bg);
  }

  .icon {
    font-size: 1.25rem;
    color: currentcolor;
  }

  /* Header Copy Button */
  .header :global(.compare-copy-button) {
    position: static;
    margin-left: auto;
  }

  .content {
    /* No relative positioning needed if copy button is in header */
    padding: 0;
  }

  /* Force Code Block Styles */
  .content :global(pre) {
    display: block; /* Simpler block layout to avoid flex-related boosting */
    width: 100%; /* Explicit width constraint */
    min-width: 0;
    max-width: 100%; /* Ensure it doesn't overflow parent calculation */
    padding: 1rem !important;
    margin: 0 !important;
    overflow-x: auto;

    /* Typography */
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    background: transparent !important; /* Let container bg show through */
    border: none !important;
    border-radius: 0 !important;

    /* Mobile Fix: Prevent font inflation */
    /* stylelint-disable-next-line property-no-vendor-prefix */
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
  }

  /* Ensure code text is visible */
  .content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
    white-space: pre;
    background-color: transparent !important;

    /* Mobile Fix: Prevent font inflation */
    /* stylelint-disable-next-line property-no-vendor-prefix */
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
  }
</style>
