---
/**
 * DirectiveCard Component
 * Card for documenting a directive/option with syntax, description, and MDN link.
 */
interface Props {
  name: string;
  syntax?: string;
  description?: string;
  mdnUrl?: string;
  defaultValue?: string;
  since?: string;
}

const { name, syntax, description, mdnUrl, defaultValue, since } = Astro.props;
const hasContent = Astro.slots.has("default");
---

<div class="directive-card">
  <div class="dc-header">
    <code class="dc-name">{name}</code>
    {since && <span class="dc-since">{since}</span>}
    {
      mdnUrl && (
        <a
          href={mdnUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="dc-mdn"
          aria-label={`MDN documentation for ${name}`}
        >
          <span
            class="i-simple-icons:mdnwebdocs dc-mdn-icon"
            aria-hidden="true"
          />
          MDN
        </a>
      )
    }
  </div>

  <div class="dc-body">
    {
      syntax && (
        <div class="dc-row">
          <span class="dc-label">Syntax</span>
          <code class="dc-code">{syntax}</code>
        </div>
      )
    }

    {
      defaultValue && (
        <div class="dc-row">
          <span class="dc-label">Default</span>
          <code class="dc-code">{defaultValue}</code>
        </div>
      )
    }

    {description && <p class="dc-description">{description}</p>}
  </div>

  {
    hasContent && (
      <div class="dc-content">
        <slot />
      </div>
    )
  }
</div>

<style>
  .directive-card {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .dc-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem 1rem;
    background: linear-gradient(135deg, var(--color-bg-subtle), transparent);
    border-bottom: var(--border-1);
  }

  .dc-name {
    padding: 0;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
    background: transparent;
  }

  .dc-since {
    padding: 0.125rem 0.5rem;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
  }

  .dc-mdn {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .dc-mdn:hover,
  .dc-mdn:focus,
  .dc-mdn:focus-visible {
    color: var(--color-primary);
  }

  .dc-mdn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .dc-mdn-icon {
    width: 14px;
    height: 14px;
  }

  .dc-body {
    padding: 0.875rem 1rem;
  }

  .dc-row {
    display: flex;
    gap: 0.625rem;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .dc-row:last-child {
    margin-bottom: 0;
  }

  .dc-label {
    min-width: 50px;
    font-size: 0.7rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .dc-code {
    padding: 0.125rem 0.375rem;
    font-size: 0.825rem;
    color: var(--color-text);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
  }

  .dc-description {
    margin: 0.625rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .dc-content {
    padding: 0.875rem 1rem;
    border-top: var(--border-1);
  }

  /* Mobile responsive - stack label above value */
  @media (width <= 640px) {
    .dc-header {
      gap: 0.5rem;
    }

    .dc-name {
      font-size: 0.95rem;
    }

    .dc-row {
      flex-direction: column;
      gap: 0.25rem;
      align-items: flex-start;
    }

    .dc-label {
      min-width: unset;
    }

    .dc-code {
      font-size: 0.8rem;
      word-break: break-all;
    }
  }
</style>
