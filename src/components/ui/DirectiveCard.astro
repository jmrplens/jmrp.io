---
/**
 * DirectiveCard Component
 * Card for documenting a directive/option with syntax, description, and MDN link.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  name: string;
  syntax?: string;
  description?: string;
  mdnUrl?: string;
  defaultValue?: string;
  since?: string;
}

const { name, syntax, description, mdnUrl, defaultValue, since } = Astro.props;
const hasContent = Astro.slots.has("default");

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Sanitize MDN URL - only allow safe protocols
let safeMdnUrl: string | null = null;
if (mdnUrl) {
  try {
    const url = new URL(mdnUrl, "https://developer.mozilla.org");
    if (url.protocol === "https:" || url.protocol === "http:") {
      safeMdnUrl = url.href;
    }
  } catch {
    // Invalid URL - leave as null
  }
}
---

<div class="directive-card">
  <div class="dc-header">
    <code class="dc-name">{name}</code>
    {since && <span class="dc-since">{since}</span>}
    {
      safeMdnUrl && (
        <a
          href={safeMdnUrl}
          target="_blank"
          rel="external noopener noreferrer"
          class="dc-mdn external-link"
          aria-label={t("aria.opensNewTab", {
            text: t("aria.mdnDocs", { name }),
          })}
        >
          MDN
        </a>
      )
    }
  </div>

  {
    (syntax || defaultValue || description) && (
      <div class="dc-body">
        {syntax && <p class="dc-mono-line">{syntax}</p>}

        {defaultValue && (
          <p class="dc-mono-line">
            <span class="dc-default-key">
              {t("components.directiveCard.default")}:
            </span>{" "}
            <span class="dc-default-val">{defaultValue}</span>
          </p>
        )}

        {description && <p class="dc-description">{description}</p>}
      </div>
    )
  }

  {
    hasContent && (
      <div class="dc-content">
        <slot />
      </div>
    )
  }
</div>

<style>
  .directive-card {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .dc-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding: 0.9rem 1.125rem;
    border-bottom: 1px solid var(--color-hair);
  }

  .dc-name {
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    background: transparent;
  }

  /* Level/version pill — flat rectangular outline, muted mono. */
  .dc-since {
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .dc-mdn {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-info);
    text-decoration: none;
    transition: color 0.2s;
  }

  .dc-mdn:hover,
  .dc-mdn:focus,
  .dc-mdn:focus-visible {
    color: var(--color-text-heading);
  }

  .dc-mdn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .dc-body {
    padding: 1rem 1.125rem;
  }

  /* Plain mono lines for syntax and default rows */
  .dc-mono-line {
    margin: 0 0 0.625rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text);
  }

  .dc-mono-line:last-child {
    margin-bottom: 0;
  }

  .dc-default-key {
    color: var(--color-text-muted);
  }

  .dc-default-val {
    color: var(--color-text-heading);
  }

  .dc-description {
    margin: 0.75rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text);
  }

  .dc-content {
    padding: 1rem 1.125rem;
    border-top: 1px solid var(--color-hair);
  }

  /* Mobile responsive */
  @media (width <= 640px) {
    .dc-header {
      gap: 0.5rem;
    }

    .dc-name {
      font-size: var(--text-base);
    }

    .dc-mono-line {
      font-size: var(--text-micro);
      word-break: break-all;
    }
  }
</style>
