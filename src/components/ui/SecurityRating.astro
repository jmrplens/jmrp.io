---
/**
 * SecurityRating Component
 * Visual indicator of security level (A+ to F) like Mozilla Observatory.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  rating: "A+" | "A" | "B" | "C" | "D" | "E" | "F";
  title?: string;
  description?: string;
}

const { rating, title, description } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const ratingConfig: Record<Props["rating"], { class: string; label: string }> =
  {
    "A+": {
      class: "rating-aplus",
      label: t("components.securityRating.excellent"),
    },
    A: { class: "rating-a", label: t("components.securityRating.veryGood") },
    B: { class: "rating-b", label: t("components.securityRating.good") },
    C: { class: "rating-c", label: t("components.securityRating.acceptable") },
    D: {
      class: "rating-d",
      label: t("components.securityRating.needsImprovement"),
    },
    E: { class: "rating-e", label: t("components.securityRating.poor") },
    F: { class: "rating-f", label: t("components.securityRating.critical") },
  };

const config = ratingConfig[rating];
---

<div
  class={`security-rating ${config.class}`}
  role="region"
  aria-label={t("components.securityRating.ratingAria", {
    rating,
    label: config.label,
  }) + (title ? `. ${title}` : "")}
>
  <div
    class="sr-badge"
    aria-hidden="true"
  >
    <span class="sr-grade">{rating}</span>
  </div>
  <div class="sr-content">
    <strong class="sr-title">{title ?? config.label}</strong>
    {description && <p class="sr-description">{description}</p>}
    <slot />
  </div>
</div>

<style>
  .security-rating {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    padding: 1.125rem;
    margin: var(--space-md-lg) 0;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  /* Flat tinted badge: the grade rides the semantic colour on a 16% wash with a
     matching 1px ring. The grade is large (≥18px bold ⇒ ≥3:1 suffices) and the
     tokens clear that in both themes. */
  .sr-badge {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 52px;
    height: 52px;
    background: color-mix(in srgb, var(--sr-color) 16%, transparent);
    border: 1px solid var(--sr-color);
    border-radius: var(--radius-lg);
  }

  .sr-grade {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--fw-bold);
    line-height: 1;
    color: var(--sr-color);
    letter-spacing: -0.02em;
  }

  .sr-content {
    flex: 1;
    align-self: center;
  }

  .sr-title {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .sr-description {
    margin: 0.1875rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /*
   * Rating → semantic token: good (A+/A) = success, mid (B/C) = warning,
   * bad (D/E/F) = danger. The colour is a redundant cue — the letter grade and
   * its label text carry the meaning too. All tokens are AA-safe as text and
   * are theme-aware, so no per-theme overrides are needed.
   */
  .rating-aplus,
  .rating-a {
    --sr-color: var(--color-success);
  }

  .rating-b,
  .rating-c {
    --sr-color: var(--color-warning);
  }

  .rating-d,
  .rating-e,
  .rating-f {
    --sr-color: var(--color-danger);
  }
</style>
