---
/**
 * StepByStep Component
 * Renders a step-by-step guide with numbered steps and visual connectors.
 * Uses padding-based layout with absolute positioned circle to avoid grid issues.
 */
import { randomBytes } from "node:crypto";

import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  title?: string;
}

const { title } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Generate unique ID with random entropy to avoid collisions when same title appears multiple times
const uniqueId = randomBytes(4).toString("hex");
---

<section
  class="step-by-step"
  aria-labelledby={title ? `sbs-title-${uniqueId}` : undefined}
  aria-label={title ? undefined : t("aria.stepByStep")}
>
  {
    title && (
      <div
        class="sbs-title"
        id={`sbs-title-${uniqueId}`}
      >
        {title}
      </div>
    )
  }
  <ol class="sbs-steps">
    <slot />
  </ol>
</section>

<style is:global>
  .step-by-step {
    margin: 1.5rem 0;
  }

  .step-by-step .sbs-title {
    margin-bottom: 1rem;
    font-size: 1.1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .step-by-step .sbs-steps {
    position: relative;
    padding: 0;
    margin: 0;
    list-style: none;
    counter-reset: step;
  }

  /* Continuous timeline line */
  .step-by-step .sbs-steps::before {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 5px;
    width: 2px;
    content: "";
    background: var(--color-border);
  }

  /* Only direct children get step styling */
  .step-by-step .sbs-steps > li {
    position: relative;
    display: block !important;
    padding: 0 0 1.25rem 32px !important;
    margin: 0 !important;
    counter-increment: step;
  }

  .step-by-step .sbs-steps > li:last-child {
    padding-bottom: 0 !important;
  }

  /* Timeline dot - small and subtle */
  .step-by-step .sbs-steps > li::before {
    position: absolute;
    top: 6px;
    left: 0;
    z-index: 1;
    width: 12px;
    height: 12px;
    content: "";
    background: var(--color-bg);
    border: 2px solid var(--color-primary);
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--color-bg);
  }

  /* No separate connector line - using parent's continuous line */
  .step-by-step .sbs-steps > li::after {
    display: none;
  }

  /* First paragraph - title styling with step number */
  .step-by-step .sbs-steps > li > p:first-of-type {
    margin: 0 !important;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* Title styling - works for both p>strong and direct strong */
  .step-by-step .sbs-steps > li > p:first-of-type strong:first-child,
  .step-by-step .sbs-steps > li > strong:first-child {
    display: inline;
    font-size: 0.95rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  /* Step number badge before title - both selector patterns */
  .step-by-step .sbs-steps > li > p:first-of-type strong:first-child::before,
  .step-by-step .sbs-steps > li > strong:first-child::before {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.35rem;
    margin-right: 0.5rem;
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    vertical-align: baseline;
    color: var(--color-primary);
    content: counter(step);
    background: var(
      --color-primary-bg,
      color-mix(in srgb, var(--color-primary) 12%, transparent)
    );
    border-radius: var(--radius-sm);
  }

  /* Subsequent paragraphs - aligned with title text */
  .step-by-step .sbs-steps > li > p:not(:first-of-type) {
    padding-left: 1.75rem; /* aligns with title (badge width + margin) */
    margin: 0.25rem 0 0 !important;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  /* Code blocks inside steps */
  .step-by-step .sbs-steps > li code {
    padding: 0.125rem 0.375rem;
    font-size: 0.85rem;
    background: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
  }

  /* Nested lists inside steps - restore normal list styling */
  .step-by-step .sbs-steps > li ul,
  .step-by-step .sbs-steps > li ol {
    padding-left: calc(1.75rem + 1.25rem); /* badge offset + list indent */
    margin: 0.5rem 0 0;
  }

  .step-by-step .sbs-steps > li ul li {
    padding: 0.125rem 0 !important;
    margin: 0 !important;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text);
    list-style-type: disc;
  }

  .step-by-step .sbs-steps > li ol li {
    padding: 0.125rem 0 !important;
    margin: 0 !important;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text);
    list-style-type: decimal;
  }

  .step-by-step .sbs-steps > li ul li::before,
  .step-by-step .sbs-steps > li ul li::after,
  .step-by-step .sbs-steps > li ol li::before,
  .step-by-step .sbs-steps > li ol li::after {
    display: none;
    content: none;
  }
</style>
