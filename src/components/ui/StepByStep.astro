---
/**
 * StepByStep Component
 * Renders a step-by-step guide with numbered steps and visual connectors.
 * Uses padding-based layout with absolute positioned circle to avoid grid issues.
 */
import { randomBytes } from "node:crypto";

import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  title?: string;
}

const { title } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Generate unique ID with random entropy to avoid collisions when same title appears multiple times
const uniqueId = randomBytes(4).toString("hex");
---

<section
  class="step-by-step"
  aria-labelledby={title ? `sbs-title-${uniqueId}` : undefined}
  aria-label={title ? undefined : t("aria.stepByStep")}
>
  {
    title && (
      <div
        class="sbs-title"
        id={`sbs-title-${uniqueId}`}
      >
        {title}
      </div>
    )
  }
  <ol class="sbs-steps">
    <slot />
  </ol>
</section>

<style is:global>
  /* Flat bordered card holding a numbered step list (Lab mockup):
     each step gets a 26px accent circle badge on the left. */
  .step-by-step {
    padding: 18px;
    margin: 1.5rem 0;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .step-by-step .sbs-title {
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--fw-bold);
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .step-by-step .sbs-steps {
    padding: 0;
    margin: 0;
    list-style: none;
    counter-reset: step;
  }

  /* Only direct children get step styling */
  .step-by-step .sbs-steps > li {
    position: relative;
    display: block !important;
    padding: 3px 0 16px 40px !important;
    margin: 0 !important;
    counter-increment: step;
  }

  .step-by-step .sbs-steps > li:last-child {
    padding-bottom: 0 !important;
  }

  /* Numbered accent circle badge */
  .step-by-step .sbs-steps > li::before {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-accent);
    content: counter(step);
    background: var(--accent-dim);
    border: 1px solid var(--color-accent);
    border-radius: 50%;
  }

  .step-by-step .sbs-steps > li::after {
    display: none;
  }

  /* First paragraph */
  .step-by-step .sbs-steps > li > p:first-of-type {
    margin: 0 !important;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text);
  }

  /* Optional bold lead-in title */
  .step-by-step .sbs-steps > li > p:first-of-type strong:first-child,
  .step-by-step .sbs-steps > li > strong:first-child {
    display: inline;
    font-size: var(--text-base);
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  /* Subsequent paragraphs */
  .step-by-step .sbs-steps > li > p:not(:first-of-type) {
    margin: 0.25rem 0 0 !important;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text);
  }

  /* Code blocks inside steps */
  .step-by-step .sbs-steps > li code {
    padding: 0.125rem 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--color-surface-2);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-sm);
  }

  /* Nested lists inside steps - restore normal list styling */
  .step-by-step .sbs-steps > li ul,
  .step-by-step .sbs-steps > li ol {
    padding-left: 1.25rem;
    margin: 0.5rem 0 0;
  }

  .step-by-step .sbs-steps > li ul li {
    padding: 0.125rem 0 !important;
    margin: 0 !important;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text);
    list-style-type: disc;
  }

  .step-by-step .sbs-steps > li ol li {
    padding: 0.125rem 0 !important;
    margin: 0 !important;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text);
    list-style-type: decimal;
  }

  .step-by-step .sbs-steps > li ul li::before,
  .step-by-step .sbs-steps > li ul li::after,
  .step-by-step .sbs-steps > li ol li::before,
  .step-by-step .sbs-steps > li ol li::after {
    display: none;
    content: none;
  }
</style>
