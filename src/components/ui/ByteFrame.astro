---
/**
 * ByteFrame Component
 *
 * A zero-JS byte-layout diagram for a binary frame or struct: a single bar of
 * proportional, color-coded fields with byte offsets and sizes — the classic
 * "packet diagram". Supports a trailing variable-length field. Theme-aware,
 * responsive (inline labels collapse to the legend on small screens), and
 * accessible (role="img" + sr-only table).
 *
 * @example
 * <ByteFrame
 *   title="Encrypted record"
 *   fields={[
 *     { label: "ver", bytes: 1 },
 *     { label: "IV", bytes: 12 },
 *     { label: "tag", bytes: 16, note: "HMAC" },
 *     { label: "ciphertext", bytes: 32, variable: true },
 *   ]}
 * />
 */

import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Field {
  /** Field name. */
  label: string;
  /** Size in bytes (for a variable field, a representative size for proportions). */
  bytes: number;
  /** Mark a trailing variable-length field (shows "…" for its size). */
  variable?: boolean;
  /** Optional note shown in the legend. */
  note?: string;
  /** Optional CSS color override; otherwise cycles a palette. */
  color?: string;
}

interface Props {
  /** Optional title shown above the diagram. */
  title?: string;
  /** Fields in byte order. */
  fields: Field[];
  /** Caption below the diagram. */
  caption?: string;
  /** Accessibility label for the whole figure. */
  ariaLabel?: string;
}

const { title, fields, caption, ariaLabel } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const PALETTE = 6;
const total = fields.reduce((sum, f) => sum + Math.max(0, f.bytes), 0) || 1;

let offset = 0;
let approximate = false;
const segments = fields.map((f, i) => {
  const start = offset;
  offset += Math.max(0, f.bytes);
  const prefix = approximate ? "~" : "";
  const offsetLabel = f.variable ? `@${start}+` : `@${prefix}${start}`;
  const seg = {
    label: f.label,
    note: f.note,
    bytes: f.bytes,
    variable: Boolean(f.variable),
    color: f.color ?? `var(--bf-${(i % PALETTE) + 1})`,
    widthPct: (Math.max(0, f.bytes) / total) * 100,
    offsetLabel,
    sizeLabel: f.variable ? "…" : `${f.bytes} B`,
  };
  if (f.variable) approximate = true;
  return seg;
});

const summary =
  ariaLabel ??
  (title
    ? t("components.byteFrame.ariaWithTitle", {
        title,
        count: String(fields.length),
      })
    : t("components.byteFrame.ariaWithoutTitle", {
        count: String(fields.length),
      }));
---

<div
  class="byte-frame"
  role="img"
  aria-label={summary}
>
  {title && <div class="byte-frame__title">{title}</div>}

  <div class="byte-frame__track">
    {
      segments.map((seg) => (
        <span
          class="byte-frame__seg"
          style={`flex-grow:${seg.widthPct.toFixed(3)}`}
          title={`${seg.label}: ${seg.sizeLabel} (${seg.offsetLabel})`}
        >
          <span
            class:list={[
              "byte-frame__bar",
              seg.variable && "byte-frame__bar--var",
            ]}
            style={`background-color:${seg.color}`}
          >
            {seg.widthPct >= 14 && (
              <span class="byte-frame__name">{seg.label}</span>
            )}
          </span>
          <span class="byte-frame__offset">{seg.offsetLabel}</span>
        </span>
      ))
    }
  </div>

  <ul class="byte-frame__legend">
    {
      segments.map((seg) => (
        <li class="byte-frame__legend-item">
          <span
            class="byte-frame__swatch"
            style={`background-color:${seg.color}`}
            aria-hidden="true"
          />
          <span class="byte-frame__legend-text">
            <b>{seg.label}</b> · {seg.sizeLabel} · {seg.offsetLabel}
            {seg.note && <span class="byte-frame__note"> — {seg.note}</span>}
          </span>
        </li>
      ))
    }
  </ul>

  <table class="sr-only">
    <caption>{title ?? t("components.byteFrame.srCaption")}</caption>
    <thead>
      <tr>
        <th scope="col">{t("components.byteFrame.srField")}</th>
        <th scope="col">{t("components.byteFrame.srOffset")}</th>
        <th scope="col">{t("components.byteFrame.srSize")}</th>
      </tr>
    </thead>
    <tbody>
      {
        segments.map((seg) => (
          <tr>
            <td>{seg.label}</td>
            <td>{seg.offsetLabel}</td>
            <td>{seg.sizeLabel}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  {caption && <p class="byte-frame__caption">{caption}</p>}
</div>

<style>
  .byte-frame {
    /* Categorical palette from the central --dg-cat-* ramp (tokens.css). */
    --bf-1: var(--dg-cat-1);
    --bf-2: var(--dg-cat-2);
    --bf-3: var(--dg-cat-3);
    --bf-4: var(--dg-cat-4);
    --bf-5: var(--dg-cat-5);
    --bf-6: var(--dg-cat-6);
    --bf-on: var(--color-on-primary);

    /* Diagonal hatch marks the variable-length field (not colour alone). */
    --bf-stripe: repeating-linear-gradient(
      45deg,
      var(--color-border) 0 7px,
      var(--color-hair) 7px 14px
    );

    margin: 1.5rem 0;
  }

  .byte-frame__title {
    margin-bottom: 1rem;
    font-size: var(--text-md);
    font-weight: var(--fw-semibold, 600);
    color: var(--color-text-heading);
  }

  .byte-frame__track {
    display: flex;
    gap: 4px;
    overflow: hidden;
    font-family: var(--font-mono);
  }

  /* Wrapper column: coloured bar on top, offset label below (on the surface). */
  .byte-frame__seg {
    display: flex;
    flex-basis: 0;
    flex-direction: column;
    align-items: stretch;
    min-width: 2.2rem;
    text-align: center;
  }

  .byte-frame__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.6rem;
    padding: 0.3rem 0.25rem;
    overflow: hidden;
    color: var(--bf-on);
    border-radius: 5px;
  }

  /* Variable-length field: a hatched pattern to signal "and so on". */
  .byte-frame__bar--var {
    color: var(--color-text-heading);
    background-image: var(--bf-stripe);
  }

  .byte-frame__name {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--text-micro);
    font-weight: var(--fw-medium, 500);
    white-space: nowrap;
  }

  /* Offset meta sits below the fill, muted on the card surface (AA-safe). */
  .byte-frame__offset {
    margin-top: 5px;
    font-size: var(--text-2xs);
    font-weight: var(--fw-medium, 500);
    color: var(--color-text-muted);
  }

  .byte-frame__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    padding: 0;
    margin: 0.85rem 0 0;
    list-style: none;
  }

  .byte-frame__legend-item {
    display: inline-flex;
    column-gap: 0.4rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
  }

  .byte-frame__swatch {
    flex-shrink: 0;
    align-self: center;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
  }

  .byte-frame__legend-text b {
    font-weight: var(--fw-semibold, 600);
    color: var(--color-text);
  }

  .byte-frame__caption {
    margin-top: 1rem;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    clip-path: inset(50%);
  }

  @media (width <= 640px) {
    .byte-frame__name {
      display: none;
    }
  }
</style>
