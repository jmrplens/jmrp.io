---
/**
 * TerminalSession — several commands + outputs in one dark terminal card (both
 * themes). The copy button copies ONLY the commands (the .ts-command-raw text
 * extracted from child TerminalSessionCommand), never the output.
 *
 * Usage:
 *   import { TerminalSession, TerminalSessionCommand, TerminalSessionOutput }
 *     from "@components/ui/terminal-session";
 *   <TerminalSession title="zsh · edge-01">
 *     <TerminalSessionCommand>cscli decisions list</TerminalSessionCommand>
 *     <TerminalSessionOutput>…</TerminalSessionOutput>
 *   </TerminalSession>
 */
import { createHash } from "node:crypto";

import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import * as cheerio from "cheerio";

import CopyButton from "./CopyButton.astro";

interface Props {
  title?: string;
  ariaLabel?: string;
}

const { title, ariaLabel } = Astro.props;

const slotContent = (await Astro.slots.render("default")) || "";

// Extract raw command text from child TerminalSessionCommand (.ts-command-raw).
const $ = cheerio.load(slotContent, { xmlMode: false });
const rawCommands: string[] = [];
$(".ts-command-raw").each((_, el) => {
  const text = $(el).text().trim();
  if (text) rawCommands.push(text);
});
const commandText = rawCommands.join("\n");
const firstCommand = commandText.split(/\r?\n/).find(Boolean);

const contentHash = createHash("sha256")
  .update(commandText || "empty-session")
  .digest("hex")
  .slice(0, 8);

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const finalAriaLabel =
  ariaLabel ||
  t("components.terminal.sessionAria", {
    command: firstCommand || t("components.terminal.sessionFallback"),
  });
---

<div
  class="jmrp-term terminal-session copy-container"
  data-testid={`terminal-session-${contentHash}`}
>
  <div class="jmrp-term__head">
    <span class="jmrp-term__head-left">
      <span
        class="jmrp-term__dots"
        aria-hidden="true"
      >
        <i></i><i></i><i></i>
      </span>
      {
        title && (
          <span
            class="jmrp-term__label jmrp-term__label--title"
            aria-hidden="true"
          >
            {title}
          </span>
        )
      }
    </span>
    <CopyButton
      variant="terminal"
      content={commandText}
      text={t("ui.commands")}
      ariaLabel={t("components.terminal.copyCommand", {
        command: firstCommand || t("components.terminal.terminalFallback"),
      })}
    />
  </div>

  <div
    class="jmrp-term__body"
    role="group"
    aria-label={finalAriaLabel}
    set:html={slotContent}
  />

  {/* Hidden fallback text for the copy button. */}
  <div
    class="copy-content"
    hidden
    aria-hidden="true"
    set:text={commandText}
  />
</div>

<style>
  .jmrp-term__head-left {
    display: flex;
    gap: 9px;
    align-items: center;
    min-width: 0;
  }

  .jmrp-term__label--title {
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: none;
    letter-spacing: 0;
    white-space: nowrap;
  }
</style>
