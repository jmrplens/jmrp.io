---
/**
 * Mermaid Diagram Component
 * Wraps the diagram in a figure with optional caption and size controls.
 */

import { createHash } from "node:crypto";

interface Props {
  caption?: string;
  title?: string;
  ariaLabel?: string;
  maxWidth?: string;
  maxHeight?: string;
}

const { caption, title, ariaLabel, maxWidth, maxHeight } = Astro.props;

const fallbackAriaLabel = ariaLabel || title || "Mermaid Diagram";

// Generate a deterministic ID based on the caption content
const captionId = caption
  ? `mermaid-caption-${createHash("sha256").update(caption).digest("hex").slice(0, 8)}`
  : undefined;

// Compute ARIA attributes based on priority:
// 1. If ariaLabel provided: use it as aria-label, and if caption exists, reference it via aria-describedby
// 2. If only caption: use aria-labelledby to reference caption
// 3. If neither: use fallback auto-generated label
const computedAriaLabelledby = caption && !ariaLabel ? captionId : undefined;
const computedAriaDescribedby = caption && ariaLabel ? captionId : undefined;
const computedAriaLabel =
  ariaLabel || (caption ? undefined : fallbackAriaLabel);
---

<figure
  class="mermaid-figure"
  aria-labelledby={computedAriaLabelledby}
  aria-describedby={computedAriaDescribedby}
  aria-label={computedAriaLabel}
  style={{ maxWidth }}
>
  <div
    class="mermaid-content"
    style={{ maxHeight }}
  >
    <slot />
  </div>
  {
    caption && (
      <figcaption
        id={captionId}
        class="mermaid-caption"
      >
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  /* stylelint-disable selector-class-pattern -- Mermaid library uses camelCase class names */

  /* --- Mermaid CSS Variables (Theme-Aware) --- */
  :global(:root) {
    /* GitHub Light Palette */
    --mermaid-text: #000;
    --mermaid-bg: #f6f8fa; /* Subtle gray fill for visible nodes in light mode */
    --mermaid-border: #d0d7de;
    --mermaid-line: #000;
    --mermaid-secondary-bg: #f6f8fa; /* Cluster/Loop backgrounds */
    --mermaid-tertiary-bg: #eaeef2; /* Actor backgrounds */
    --mermaid-note-bg: #fff9c4;
    --mermaid-note-border: #d4a72c;
    --mermaid-note-text: #000;

    /* Semantic Colors (Light) */
    --mermaid-warning-fill: #fbbf24;
    --mermaid-warning-stroke: #d97706;
    --mermaid-warning-text: #1f2937;
    --mermaid-danger-fill: #ef4444;
    --mermaid-danger-stroke: #b91c1c;
    --mermaid-danger-text: #fff;
    --mermaid-success-fill: #22c55e;
    --mermaid-success-stroke: #15803d;
    --mermaid-success-text: #fff;
    --mermaid-info-fill: #38bdf8;
    --mermaid-info-stroke: #0284c7;
    --mermaid-info-text: #fff;
    --mermaid-highlight-fill: #a78bfa;
    --mermaid-highlight-stroke: #7c3aed;
    --mermaid-highlight-text: #fff;
    --mermaid-muted-fill: #d1d5db;
    --mermaid-muted-stroke: #9ca3af;
    --mermaid-muted-text: #374151;

    /* Attacker Node Colors */
    --mermaid-attacker-fill: #450a0a;
    --mermaid-attacker-stroke: #ef4444;
    --mermaid-attacker-text: #fca5a5;

    /* Pie Chart Colors */
    --mermaid-pie-1: #0969da;
    --mermaid-pie-2: #1a7f37;
    --mermaid-pie-3: #8250df;
    --mermaid-pie-4: #cf222e;
    --mermaid-pie-5: #bf8700;
    --mermaid-pie-6: #6e7781;
  }

  :global(:root[data-theme="dark"]) {
    /* GitHub Dark Palette */
    --mermaid-text: #fff;
    --mermaid-bg: #0d1117;
    --mermaid-border: #30363d;
    --mermaid-line: #fff;
    --mermaid-secondary-bg: #161b22;
    --mermaid-tertiary-bg: #1f2937;
    --mermaid-note-bg: #2d2606;
    --mermaid-note-border: #d4a72c;
    --mermaid-note-text: #fff;

    /* Semantic Colors (Dark) */
    --mermaid-warning-fill: #9a6700;
    --mermaid-warning-stroke: #d29922;
    --mermaid-warning-text: #fff;
    --mermaid-danger-fill: #8b1a1a;
    --mermaid-danger-stroke: #da3633;
    --mermaid-danger-text: #fff;
    --mermaid-success-fill: #1a5d1a;
    --mermaid-success-stroke: #2ea043;
    --mermaid-success-text: #fff;
    --mermaid-info-fill: #0c4a6e;
    --mermaid-info-stroke: #1d8ad8;
    --mermaid-info-text: #fff;
    --mermaid-highlight-fill: #5b21b6;
    --mermaid-highlight-stroke: #a78bfa;
    --mermaid-highlight-text: #fff;
    --mermaid-muted-fill: #484f58;
    --mermaid-muted-stroke: #6e7681;
    --mermaid-muted-text: #c9d1d9;

    /* Attacker Node Colors (Dark) */
    --mermaid-attacker-fill: #7f1d1d;
    --mermaid-attacker-stroke: #f87171;
    --mermaid-attacker-text: #fee2e2;

    /* Pie Chart Colors */
    --mermaid-pie-1: #2f81f7;
    --mermaid-pie-2: #3fb950;
    --mermaid-pie-3: #a371f7;
    --mermaid-pie-4: #d2a8ff;
    --mermaid-pie-5: #e3b341;
    --mermaid-pie-6: #8b949e;
  }

  .mermaid-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin: 2rem auto;
  }

  .mermaid-content {
    display: flex;
    justify-content: center;
    width: 100%;
    overflow-x: auto;
  }

  /* Target the SVG directly */
  .mermaid-content :global(svg) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    background-color: transparent !important;
  }

  .mermaid-caption {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }

  /* --- Global Mermaid Text & Visibility Fixes --- */

  /* Only override colors, NOT font-family - Mermaid calculates node sizes based on its default fonts */
  .mermaid-content :global(svg text),
  .mermaid-content :global(g.actor text),
  .mermaid-content :global(text.actor),
  .mermaid-content :global(#actor text),
  .mermaid-content :global(span.label),
  .mermaid-content :global(.nodeLabel) {
    color: var(--mermaid-text) !important; /* For HTML labels */
    fill: var(--mermaid-text) !important;
    stroke: none !important; /* Remove unwanted text outlines */
  }

  /* General Node Styling (Flowchart) */
  .mermaid-content :global(.node rect),
  .mermaid-content :global(.node circle),
  .mermaid-content :global(.node polygon),
  .mermaid-content :global(.node path) {
    fill: var(--mermaid-bg) !important;
    stroke: var(--mermaid-border) !important;
  }

  /* Flowchart Edges/Lines */
  .mermaid-content :global(.edgePath path),
  .mermaid-content :global(.flowchart-link) {
    stroke: var(--mermaid-line) !important;
  }

  /* Flowchart Edge Labels - Fix for dark mode visibility */
  .mermaid-content :global(.edgeLabel) {
    color: var(--mermaid-text) !important;
    background-color: var(--mermaid-bg) !important;
  }

  .mermaid-content :global(.edgeLabel span) {
    color: var(--mermaid-text) !important;
    background-color: var(--mermaid-bg) !important;
  }

  .mermaid-content :global(.edgeLabel rect) {
    fill: var(--mermaid-bg) !important;
  }

  /* --- Flowchart Subgraphs/Clusters --- */

  /* Cluster/Subgraph backgrounds - need high specificity to override Mermaid defaults */
  .mermaid-content :global(svg .cluster rect),
  .mermaid-content :global(svg .cluster-alt rect),
  .mermaid-content :global(svg g.cluster > rect),
  .mermaid-content :global(svg [class*="cluster"] > rect) {
    fill: var(--mermaid-secondary-bg) !important;
    stroke: var(--mermaid-border) !important;
  }

  /* Subgraph title text elements */
  .mermaid-content :global(svg .cluster-label text),
  .mermaid-content :global(svg .cluster-label tspan),
  .mermaid-content :global(svg g.cluster-label text) {
    fill: var(--mermaid-text) !important;
  }

  /* Subgraph title foreignObject (HTML labels) */
  .mermaid-content :global(.cluster-label foreignObject) {
    overflow: visible;
  }

  .mermaid-content :global(.cluster-label foreignObject div),
  .mermaid-content :global(.cluster-label foreignObject span),
  .mermaid-content :global(.cluster-label foreignObject p),
  .mermaid-content :global(.cluster-label .nodeLabel) {
    color: var(--mermaid-text) !important;
    background-color: transparent !important;
  }

  /* Fix foreignObject labels (HTML-based) which Mermaid uses for edge labels */
  .mermaid-content :global(.edgeLabel foreignObject) {
    overflow: visible;
  }

  .mermaid-content :global(.edgeLabel foreignObject div) {
    padding: 3px 8px !important;
    font-size: 0.9em !important;
    color: var(--mermaid-text) !important;
    background-color: var(--mermaid-bg) !important;

    /* Floating label style - distinct from nodes */
    border: none !important;
    border-radius: 12px !important;
    box-shadow: 0 1px 4px rgb(0 0 0 / 15%) !important;
  }

  /* Fix p tags inside edgeLabel - Mermaid adds inline styles with white bg/text */
  .mermaid-content :global(.edgeLabel p),
  .mermaid-content :global(.edgeLabel foreignObject p),
  .mermaid-content :global(.edgeLabel foreignObject div p) {
    margin: 0 !important;
    color: var(--mermaid-text) !important;
    background-color: var(--mermaid-bg) !important;
  }

  /* Catch-all for any nested text elements in edge labels */
  .mermaid-content :global(.edgeLabel *) {
    color: var(--mermaid-text) !important;
    background-color: var(--mermaid-bg) !important;
  }

  /* --- Sequence Diagram Specifics --- */

  /* Actors */
  .mermaid-content :global(rect.actor) {
    fill: var(--mermaid-tertiary-bg) !important;
    stroke: var(--mermaid-border) !important;
  }

  .mermaid-content :global(line.actor-line) {
    stroke: var(--mermaid-line) !important;
  }

  /* Notes */
  .mermaid-content :global(g.note rect),
  .mermaid-content :global(rect.note) {
    fill: var(--mermaid-note-bg) !important;
    stroke: var(--mermaid-note-border) !important;
  }

  .mermaid-content :global(g.note text),
  .mermaid-content :global(text.noteText) {
    fill: var(--mermaid-note-text) !important;
    stroke: var(--mermaid-note-bg) !important;
    stroke-width: 3px !important;
    stroke-linejoin: round !important;
    paint-order: stroke !important;
  }

  /* Messages/Signals */
  .mermaid-content :global(.messageLine0),
  .mermaid-content :global(.messageLine1) {
    stroke: var(--mermaid-line) !important;
  }

  .mermaid-content :global(.messageText) {
    fill: var(--mermaid-text) !important;
    stroke: var(--color-bg) !important;
    stroke-width: 4px !important;
    stroke-linecap: round !important;
    stroke-linejoin: round !important;
    paint-order: stroke fill !important;
  }

  /* Loop Labels */
  .mermaid-content :global(.labelBox) {
    fill: var(--mermaid-secondary-bg) !important;
    stroke: var(--mermaid-border) !important;
  }

  .mermaid-content :global(.labelText) {
    fill: var(--mermaid-text) !important;
    stroke: var(--mermaid-secondary-bg) !important;
    stroke-width: 3px !important;
    stroke-linejoin: round !important;
    paint-order: stroke !important;
  }

  .mermaid-content :global(.loopLine) {
    stroke: var(--mermaid-border) !important;
  }

  /* Mermaid Arrowhead/Marker Visibility Fix */

  /* Ensure markers adapt to theme colors */
  .mermaid-content :global(marker path),
  .mermaid-content :global(marker circle) {
    fill: var(--mermaid-line) !important;
    stroke: var(--mermaid-line) !important;
  }

  /* --- Mermaid Semantic Node Classes (Theme-Aware) --- */

  /* Overrides for custom classDefs in Markdown */

  /* Default Node */
  .mermaid-content :global(.node.default > rect),
  .mermaid-content :global(.node.default > polygon),
  .mermaid-content :global(.node.default > circle) {
    fill: var(--mermaid-bg) !important;
    stroke: var(--mermaid-border) !important;
  }

  .mermaid-content :global(.node.default .nodeLabel) {
    color: var(--mermaid-text) !important;
  }

  /* Warning Node */
  .mermaid-content :global(.node.warning > rect),
  .mermaid-content :global(.node.warning > polygon),
  .mermaid-content :global(.node.warning > circle) {
    fill: var(--mermaid-warning-fill) !important;
    stroke: var(--mermaid-warning-stroke) !important;
  }

  .mermaid-content :global(.node.warning .nodeLabel) {
    color: var(--mermaid-warning-text) !important;
  }

  /* Danger Node */
  .mermaid-content :global(.node.danger > rect),
  .mermaid-content :global(.node.danger > polygon),
  .mermaid-content :global(.node.danger > circle) {
    fill: var(--mermaid-danger-fill) !important;
    stroke: var(--mermaid-danger-stroke) !important;
  }

  .mermaid-content :global(.node.danger .nodeLabel) {
    color: var(--mermaid-danger-text) !important;
  }

  /* Success Node */
  .mermaid-content :global(.node.success > rect),
  .mermaid-content :global(.node.success > polygon),
  .mermaid-content :global(.node.success > circle) {
    fill: var(--mermaid-success-fill) !important;
    stroke: var(--mermaid-success-stroke) !important;
  }

  .mermaid-content :global(.node.success .nodeLabel) {
    color: var(--mermaid-success-text) !important;
  }

  /* Info Node */
  .mermaid-content :global(.node.info > rect),
  .mermaid-content :global(.node.info > polygon),
  .mermaid-content :global(.node.info > circle) {
    fill: var(--mermaid-info-fill) !important;
    stroke: var(--mermaid-info-stroke) !important;
  }

  .mermaid-content :global(.node.info .nodeLabel) {
    color: var(--mermaid-info-text) !important;
  }

  /* Highlight Node */
  .mermaid-content :global(.node.highlight > rect),
  .mermaid-content :global(.node.highlight > polygon),
  .mermaid-content :global(.node.highlight > circle) {
    fill: var(--mermaid-highlight-fill) !important;
    stroke: var(--mermaid-highlight-stroke) !important;
  }

  .mermaid-content :global(.node.highlight .nodeLabel) {
    color: var(--mermaid-highlight-text) !important;
  }

  /* Muted Node */
  .mermaid-content :global(.node.muted > rect),
  .mermaid-content :global(.node.muted > polygon),
  .mermaid-content :global(.node.muted > circle) {
    fill: var(--mermaid-muted-fill) !important;
    stroke: var(--mermaid-muted-stroke) !important;
  }

  .mermaid-content :global(.node.muted .nodeLabel) {
    color: var(--mermaid-muted-text) !important;
  }

  /* Primary Node (brand/accent color) */
  .mermaid-content :global(.node.primary > rect),
  .mermaid-content :global(.node.primary > polygon),
  .mermaid-content :global(.node.primary > circle) {
    fill: var(--mermaid-highlight-fill) !important;
    stroke: var(--mermaid-highlight-stroke) !important;
  }

  .mermaid-content :global(.node.primary .nodeLabel) {
    color: var(--mermaid-highlight-text) !important;
  }

  /* Secondary Node (subtle/muted) */
  .mermaid-content :global(.node.secondary > rect),
  .mermaid-content :global(.node.secondary > polygon),
  .mermaid-content :global(.node.secondary > circle) {
    fill: var(--mermaid-tertiary-bg) !important;
    stroke: var(--mermaid-border) !important;
  }

  .mermaid-content :global(.node.secondary .nodeLabel) {
    color: var(--mermaid-text) !important;
  }

  /* CSP Policy Node (represents the CSP header/rules) */
  .mermaid-content :global(.node.cspPolicy > rect),
  .mermaid-content :global(.node.cspPolicy > polygon),
  .mermaid-content :global(.node.cspPolicy > circle) {
    fill: var(--mermaid-info-fill) !important;
    stroke: var(--mermaid-info-stroke) !important;
    stroke-width: 2px !important;
  }

  .mermaid-content :global(.node.cspPolicy .nodeLabel) {
    color: var(--mermaid-info-text) !important;
  }

  /* CSP Trusted Node (for allowed/trusted scripts) - uses success */
  .mermaid-content :global(.node.cspTrusted > rect),
  .mermaid-content :global(.node.cspTrusted > polygon),
  .mermaid-content :global(.node.cspTrusted > circle) {
    fill: var(--mermaid-success-fill) !important;
    stroke: var(--mermaid-success-stroke) !important;
  }

  .mermaid-content :global(.node.cspTrusted .nodeLabel) {
    color: var(--mermaid-success-text) !important;
  }

  /* CSP Blocked Node (for blocked/rejected scripts) - uses danger */
  .mermaid-content :global(.node.cspBlocked > rect),
  .mermaid-content :global(.node.cspBlocked > polygon),
  .mermaid-content :global(.node.cspBlocked > circle) {
    fill: var(--mermaid-danger-fill) !important;
    stroke: var(--mermaid-danger-stroke) !important;
  }

  .mermaid-content :global(.node.cspBlocked .nodeLabel) {
    color: var(--mermaid-danger-text) !important;
  }

  /* Attacker Node (special styling for malicious actors) */
  .mermaid-content :global(.node.attacker > rect),
  .mermaid-content :global(.node.attacker > polygon),
  .mermaid-content :global(.node.attacker > circle) {
    fill: var(--mermaid-attacker-fill) !important;
    stroke: var(--mermaid-attacker-stroke) !important;
    stroke-width: 2px !important;
    stroke-dasharray: 5 3 !important;
  }

  .mermaid-content :global(.node.attacker .nodeLabel) {
    color: var(--mermaid-attacker-text) !important;
  }

  /* Nonce Node (special styling for nonce values) */
  .mermaid-content :global(.node.nonce > rect),
  .mermaid-content :global(.node.nonce > polygon),
  .mermaid-content :global(.node.nonce > circle) {
    fill: var(--mermaid-secondary-bg) !important;
    stroke: var(--mermaid-highlight-stroke) !important;
    stroke-width: 2px !important;
    stroke-dasharray: 8 4 !important;
  }

  .mermaid-content :global(.node.nonce .nodeLabel) {
    color: var(--mermaid-highlight-stroke) !important;
  }
</style>
