---
/**
 * Mermaid Diagram Component
 * Wraps the diagram in a figure with optional caption and size controls.
 */

import { getNextIndex } from "@utils/counters";

interface Props {
  caption?: string;
  title?: string;
  ariaLabel?: string;
  maxWidth?: string;
  maxHeight?: string;
}

const { caption, title, ariaLabel, maxWidth, maxHeight } = Astro.props;

const index = getNextIndex("mermaid");
const fallbackAriaLabel = ariaLabel || title || `Mermaid Diagram ${index}`;

const captionId = caption ? `mermaid-caption-${index}` : undefined;

// Compute ARIA attributes based on priority:
// 1. If ariaLabel provided: use it as aria-label, and if caption exists, reference it via aria-describedby
// 2. If only caption: use aria-labelledby to reference caption
// 3. If neither: use fallback auto-generated label
const computedAriaLabelledby = caption && !ariaLabel ? captionId : undefined;
const computedAriaDescribedby = caption && ariaLabel ? captionId : undefined;
const computedAriaLabel =
  ariaLabel || (caption ? undefined : fallbackAriaLabel);
---

<figure
  class="mermaid-figure"
  aria-labelledby={computedAriaLabelledby}
  aria-describedby={computedAriaDescribedby}
  aria-label={computedAriaLabel}
>
  <div
    class="mermaid-content"
    style={{ maxWidth, maxHeight }}
  >
    <slot />
  </div>
  {
    caption && (
      <figcaption
        id={captionId}
        class="mermaid-caption"
      >
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .mermaid-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin: 2rem auto;
  }

  .mermaid-content {
    display: flex;
    justify-content: center;
    width: 100%;
    overflow-x: auto;
  }

  /* Structural wrappers width control */
  .mermaid-content :global(.mermaid-split-wrap),
  .mermaid-content :global(.mermaid-light-wrap),
  .mermaid-content :global(.mermaid-dark-wrap),
  .mermaid-content :global(svg) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .mermaid-caption {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }

  /* --- Global Mermaid Text & Visibility Fixes --- */

  /* Ensure sharp text and theme-compliant colors without overriding typography */
  .mermaid-content :global(svg text),
  .mermaid-content :global(g.actor text),
  .mermaid-content :global(text.actor),
  .mermaid-content :global(#actor text) {
    fill: var(--color-text-heading) !important;
    stroke: none !important;
  }

  /* Specific: Loop/Group Labels color */
  .mermaid-content :global(span.label) {
    color: var(--color-text-heading) !important;
  }
</style>

<style is:global>
  /* Mermaid Semantic Node Colors (Dark Mode Defaults) */
  :root {
    --mermaid-default-fill: #21262d;
    --mermaid-default-stroke: #484f58;
    --mermaid-default-text: #c9d1d9;
    --mermaid-warning-fill: #9a6700;
    --mermaid-warning-stroke: #d29922;
    --mermaid-warning-text: #fff;
    --mermaid-danger-fill: #8b1a1a;
    --mermaid-danger-stroke: #da3633;
    --mermaid-danger-text: #fff;
    --mermaid-success-fill: #1a5d1a;
    --mermaid-success-stroke: #2ea043;
    --mermaid-success-text: #fff;
    --mermaid-info-fill: #0c4a6e;
    --mermaid-info-stroke: #1d8ad8;
    --mermaid-info-text: #fff;
    --mermaid-highlight-fill: #5b21b6;
    --mermaid-highlight-stroke: #a78bfa;
    --mermaid-highlight-text: #fff;
    --mermaid-muted-fill: #484f58;
    --mermaid-muted-stroke: #6e7681;
    --mermaid-muted-text: #c9d1d9;
  }

  /* Light Mode Variables (Apply to both system preference and explicit theme) */
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) {
      /* Mermaid Semantic Node Colors (Light Mode via system preference) */
      --mermaid-default-fill: #f3f4f6;
      --mermaid-default-stroke: #9ca3af;
      --mermaid-default-text: #1f2937;
      --mermaid-warning-fill: #fbbf24;
      --mermaid-warning-stroke: #d97706;
      --mermaid-warning-text: #1f2937;
      --mermaid-danger-fill: #ef4444;
      --mermaid-danger-stroke: #b91c1c;
      --mermaid-danger-text: #fff;
      --mermaid-success-fill: #22c55e;
      --mermaid-success-stroke: #15803d;
      --mermaid-success-text: #fff;
      --mermaid-info-fill: #38bdf8;
      --mermaid-info-stroke: #0284c7;
      --mermaid-info-text: #fff;
      --mermaid-highlight-fill: #a78bfa;
      --mermaid-highlight-stroke: #7c3aed;
      --mermaid-highlight-text: #fff;
      --mermaid-muted-fill: #d1d5db;
      --mermaid-muted-stroke: #9ca3af;
      --mermaid-muted-text: #374151;
    }
  }

  /* Explicit light mode inherits from media query above */
  :root[data-theme="light"] {
    /* Mermaid Semantic Node Colors (Light Mode) */
    --mermaid-default-fill: #f3f4f6;
    --mermaid-default-stroke: #9ca3af;
    --mermaid-default-text: #1f2937;
    --mermaid-warning-fill: #fbbf24;
    --mermaid-warning-stroke: #d97706;
    --mermaid-warning-text: #1f2937;
    --mermaid-danger-fill: #ef4444;
    --mermaid-danger-stroke: #b91c1c;
    --mermaid-danger-text: #fff;
    --mermaid-success-fill: #22c55e;
    --mermaid-success-stroke: #15803d;
    --mermaid-success-text: #fff;
    --mermaid-info-fill: #38bdf8;
    --mermaid-info-stroke: #0284c7;
    --mermaid-info-text: #fff;
    --mermaid-highlight-fill: #a78bfa;
    --mermaid-highlight-stroke: #7c3aed;
    --mermaid-highlight-text: #fff;
    --mermaid-muted-fill: #d1d5db;
    --mermaid-muted-stroke: #9ca3af;
    --mermaid-muted-text: #374151;
  }

  /* Dual Theme Mermaid Handling */

  /*
   * IMPORTANT: We use opacity:0 instead of display:none or visibility:hidden.
   * Reason: SVG markers inside display:none or visibility:hidden elements cannot
   * be referenced by url(#id) from visible elements. Using opacity:0 keeps the
   * markers fully rendered (just transparent), allowing other SVGs to use them.
   */

  /* Base: hide dark wrap, show light wrap */
  .mermaid-dark-wrap {
    position: absolute !important;
    width: 0 !important;
    height: 0 !important;
    overflow: hidden !important;
    pointer-events: none !important;
    opacity: 0% !important;
  }

  .mermaid-light-wrap {
    display: block !important;
    opacity: 100% !important;
  }

  /* Dark mode: show dark wrap, hide light wrap */
  [data-theme="dark"] .mermaid-dark-wrap {
    position: static !important;
    width: auto !important;
    height: auto !important;
    overflow: visible !important;
    pointer-events: auto !important;
    opacity: 100% !important;
  }

  [data-theme="dark"] .mermaid-light-wrap {
    position: absolute !important;
    width: 0 !important;
    height: 0 !important;
    overflow: hidden !important;
    pointer-events: none !important;
    opacity: 0% !important;
  }

  /* Mermaid Diagram Theme Alignment */
  .mermaid,
  svg[id^="mermaid-"] {
    display: block;
    margin: 0 auto;
    overflow-x: auto;
    background-color: transparent !important;
  }

  .mermaid svg,
  svg[id^="mermaid-"] {
    max-width: 100% !important;
    height: auto !important;
  }

  /* Mermaid Arrowhead/Marker Visibility Fix */

  /*
   * IMPORTANT: Sequence diagrams use generic marker IDs (#arrowhead, #crosshead, etc.)
   * Since both light-wrap and dark-wrap SVGs exist in the DOM, url(#arrowhead) may
   * reference the WRONG one due to duplicate IDs. The browser uses the first match.
   *
   * Solution: In dark mode, color ALL markers white (both wraps).
   *           In light mode, color ALL markers black (both wraps).
   */

  /* Default/Light mode: ALL markers black */
  .mermaid-light-wrap marker path,
  .mermaid-light-wrap marker circle,
  .mermaid-dark-wrap marker path,
  .mermaid-dark-wrap marker circle {
    fill: #000 !important;
    stroke: #000 !important;
  }

  /* Dark mode: ALL markers white (override for both wraps) */
  [data-theme="dark"] .mermaid-light-wrap marker path,
  [data-theme="dark"] .mermaid-light-wrap marker circle,
  [data-theme="dark"] .mermaid-dark-wrap marker path,
  [data-theme="dark"] .mermaid-dark-wrap marker circle {
    fill: #fff !important;
    stroke: #fff !important;
  }

  /* stylelint-disable selector-class-pattern -- Mermaid library class names */

  /* Edge paths for flowcharts */
  .mermaid-light-wrap .edgePath path.path {
    stroke: #000 !important;
  }

  .mermaid-dark-wrap .edgePath path.path {
    stroke: #fff !important;
  }

  /* Sequence Diagram Message Lines - override inline stroke:none */
  .mermaid-light-wrap line[class*="messageLine"] {
    stroke: #000 !important;
  }

  .mermaid-dark-wrap line[class*="messageLine"] {
    stroke: #fff !important;
  }

  /* ========================================================
     Mermaid Semantic Node Classes (Theme-Aware)
     ========================================================
     Usage in diagrams:
     classDef default fill:#f3f4f6,stroke:#9ca3af
     classDef warning fill:#fbbf24,stroke:#d97706
     classDef danger fill:#ef4444,stroke:#b91c1c
     classDef success fill:#22c55e,stroke:#15803d
     classDef info fill:#38bdf8,stroke:#0284c7
     classDef highlight fill:#a78bfa,stroke:#7c3aed
     classDef muted fill:#d1d5db,stroke:#9ca3af
     
     D["Honeypot Triggered"]:::warning
     H["DROP instantly"]:::danger
     C["Allow"]:::success
     
     CSS below overrides classDef with theme-appropriate colors.
     ======================================================== */

  /* Shared styling for all semantic nodes */
  .mermaid-light-wrap .node > rect,
  .mermaid-light-wrap .node > polygon,
  .mermaid-light-wrap .node > circle,
  .mermaid-dark-wrap .node > rect,
  .mermaid-dark-wrap .node > polygon,
  .mermaid-dark-wrap .node > circle {
    stroke-width: 2px !important;
  }

  /* Default: Standard nodes with subtle styling */
  .mermaid-light-wrap .node.default > rect,
  .mermaid-light-wrap .node.default > polygon,
  .mermaid-light-wrap .node.default > circle {
    fill: var(--mermaid-default-fill) !important;
    stroke: var(--mermaid-default-stroke) !important;
  }

  .mermaid-light-wrap .node.default .nodeLabel {
    color: var(--mermaid-default-text) !important;
  }

  .mermaid-dark-wrap .node.default > rect,
  .mermaid-dark-wrap .node.default > polygon,
  .mermaid-dark-wrap .node.default > circle {
    fill: var(--mermaid-default-fill) !important;
    stroke: var(--mermaid-default-stroke) !important;
  }

  .mermaid-dark-wrap .node.default .nodeLabel {
    color: var(--mermaid-default-text) !important;
  }

  /* Warning: Caution states, honeypot triggers, attention needed */
  .mermaid-light-wrap .node.warning > rect,
  .mermaid-light-wrap .node.warning > polygon,
  .mermaid-light-wrap .node.warning > circle {
    fill: var(--mermaid-warning-fill) !important;
    stroke: var(--mermaid-warning-stroke) !important;
  }

  .mermaid-light-wrap .node.warning .nodeLabel {
    color: var(--mermaid-warning-text) !important;
  }

  .mermaid-dark-wrap .node.warning > rect,
  .mermaid-dark-wrap .node.warning > polygon,
  .mermaid-dark-wrap .node.warning > circle {
    fill: var(--mermaid-warning-fill) !important;
    stroke: var(--mermaid-warning-stroke) !important;
  }

  .mermaid-dark-wrap .node.warning .nodeLabel {
    color: var(--mermaid-warning-text) !important;
  }

  /* Danger: Errors, drops, blocks, failures, critical */
  .mermaid-light-wrap .node.danger > rect,
  .mermaid-light-wrap .node.danger > polygon,
  .mermaid-light-wrap .node.danger > circle {
    fill: var(--mermaid-danger-fill) !important;
    stroke: var(--mermaid-danger-stroke) !important;
  }

  .mermaid-light-wrap .node.danger .nodeLabel {
    color: var(--mermaid-danger-text) !important;
  }

  .mermaid-dark-wrap .node.danger > rect,
  .mermaid-dark-wrap .node.danger > polygon,
  .mermaid-dark-wrap .node.danger > circle {
    fill: var(--mermaid-danger-fill) !important;
    stroke: var(--mermaid-danger-stroke) !important;
  }

  .mermaid-dark-wrap .node.danger .nodeLabel {
    color: var(--mermaid-danger-text) !important;
  }

  /* Success: Allowed, completed, passed, approved */
  .mermaid-light-wrap .node.success > rect,
  .mermaid-light-wrap .node.success > polygon,
  .mermaid-light-wrap .node.success > circle {
    fill: var(--mermaid-success-fill) !important;
    stroke: var(--mermaid-success-stroke) !important;
  }

  .mermaid-light-wrap .node.success .nodeLabel {
    color: var(--mermaid-success-text) !important;
  }

  .mermaid-dark-wrap .node.success > rect,
  .mermaid-dark-wrap .node.success > polygon,
  .mermaid-dark-wrap .node.success > circle {
    fill: var(--mermaid-success-fill) !important;
    stroke: var(--mermaid-success-stroke) !important;
  }

  .mermaid-dark-wrap .node.success .nodeLabel {
    color: var(--mermaid-success-text) !important;
  }

  /* Info: Informational, neutral emphasis, process steps */
  .mermaid-light-wrap .node.info > rect,
  .mermaid-light-wrap .node.info > polygon,
  .mermaid-light-wrap .node.info > circle {
    fill: var(--mermaid-info-fill) !important;
    stroke: var(--mermaid-info-stroke) !important;
  }

  .mermaid-light-wrap .node.info .nodeLabel {
    color: var(--mermaid-info-text) !important;
  }

  .mermaid-dark-wrap .node.info > rect,
  .mermaid-dark-wrap .node.info > polygon,
  .mermaid-dark-wrap .node.info > circle {
    fill: var(--mermaid-info-fill) !important;
    stroke: var(--mermaid-info-stroke) !important;
  }

  .mermaid-dark-wrap .node.info .nodeLabel {
    color: var(--mermaid-info-text) !important;
  }

  /* Highlight: Key focus, important nodes, emphasis */
  .mermaid-light-wrap .node.highlight > rect,
  .mermaid-light-wrap .node.highlight > polygon,
  .mermaid-light-wrap .node.highlight > circle {
    fill: var(--mermaid-highlight-fill) !important;
    stroke: var(--mermaid-highlight-stroke) !important;
  }

  .mermaid-light-wrap .node.highlight .nodeLabel {
    color: var(--mermaid-highlight-text) !important;
  }

  .mermaid-dark-wrap .node.highlight > rect,
  .mermaid-dark-wrap .node.highlight > polygon,
  .mermaid-dark-wrap .node.highlight > circle {
    fill: var(--mermaid-highlight-fill) !important;
    stroke: var(--mermaid-highlight-stroke) !important;
  }

  .mermaid-dark-wrap .node.highlight .nodeLabel {
    color: var(--mermaid-highlight-text) !important;
  }

  /* Muted: Background, inactive, secondary, disabled */
  .mermaid-light-wrap .node.muted > rect,
  .mermaid-light-wrap .node.muted > polygon,
  .mermaid-light-wrap .node.muted > circle {
    fill: var(--mermaid-muted-fill) !important;
    stroke: var(--mermaid-muted-stroke) !important;
  }

  .mermaid-light-wrap .node.muted .nodeLabel {
    color: var(--mermaid-muted-text) !important;
  }

  .mermaid-dark-wrap .node.muted > rect,
  .mermaid-dark-wrap .node.muted > polygon,
  .mermaid-dark-wrap .node.muted > circle {
    fill: var(--mermaid-muted-fill) !important;
    stroke: var(--mermaid-muted-stroke) !important;
  }

  .mermaid-dark-wrap .node.muted .nodeLabel {
    color: var(--mermaid-muted-text) !important;
  }
  /* stylelint-enable selector-class-pattern */
</style>
