---
/**
 * Mermaid Diagram Component
 * Wraps the mermaid diagram (generated via markdown code block) in a figure with optional caption and size controls.
 *
 * Usage:
 * <Mermaid caption="Diagram Caption" maxWidth="500px">
 *   ```mermaid-render
 *   graph TD; A-->B;
 *   ```
 * </Mermaid>
 */

interface Props {
  caption?: string; // Optional caption text
  title?: string; // Optional title for accessibility/figcaption
  maxWidth?: string; // Max width (e.g., "600px", "100%")
  maxHeight?: string; // Max height (e.g., "400px")
}

const { caption, title, maxWidth, maxHeight } = Astro.props;

// Generate a stable ID for aria-labelledby when caption exists
const captionId = caption
  ? `mermaid-caption-${Math.random().toString(36).slice(2, 10)}`
  : undefined;
---

{
  /* When caption exists, use aria-labelledby pointing to figcaption; otherwise use aria-label */
}
<figure
  class="mermaid-figure"
  aria-labelledby={captionId}
  aria-label={caption ? undefined : title || "Mermaid Diagram"}
>
  <div
    class="mermaid-content"
    style={{ maxWidth, maxHeight }}
  >
    <slot />
  </div>
  {
    caption && (
      <figcaption
        id={captionId}
        class="mermaid-caption"
      >
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .mermaid-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin: 2rem auto;
  }

  .mermaid-content {
    display: flex;
    justify-content: center;
    width: 100%;
    overflow-x: auto;
  }

  /* Target the internal mermaid wrapper generated by rehypeMermaidSplitter */

  /* We must ensure all levels of the wrapper hierarchy take full width if requested */
  .mermaid-content :global(.mermaid-split-wrap),
  .mermaid-content :global(.mermaid-light-wrap),
  .mermaid-content :global(.mermaid-dark-wrap),
  .mermaid-content :global(svg) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .mermaid-caption {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
