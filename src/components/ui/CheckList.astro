---
/**
 * CheckList Component
 * Renders a styled checklist with icons based on item type.
 * Usage: Pass items as children with data-check attribute (check, cross, warning, optional)
 */
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<div
  class="checklist"
  role="group"
  aria-label={title || "Checklist"}
>
  {title && <div class="checklist-title">{title}</div>}
  <ul class="checklist-items">
    <slot />
  </ul>
</div>

<style>
  .checklist {
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--color-bg-subtle);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .checklist-title {
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .checklist-items {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .checklist-items :global(li) {
    position: relative;
    padding: 0.25rem 0 0.25rem 1.875rem; /* Left padding for icon space */
  }

  .checklist-items :global(li::before) {
    position: absolute;
    top: 0.25rem;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    font-size: 14px;
    border-radius: 50%;
  }

  /* Required / Check items */
  .checklist-items :global(li[data-check="check"]::before),
  .checklist-items :global(li:not([data-check])::before) {
    color: #10b981;
    content: "✓";
    background: rgb(16 185 129 / 15%);
  }

  /* Cross / Not allowed items */
  .checklist-items :global(li[data-check="cross"]::before) {
    color: #ef4444;
    content: "✗";
    background: rgb(239 68 68 / 15%);
  }

  /* Warning items */
  .checklist-items :global(li[data-check="warning"]::before) {
    font-weight: var(--fw-bold);
    color: #f59e0b;
    content: "!";
    background: rgb(245 158 11 / 15%);
  }

  /* Optional items */
  .checklist-items :global(li[data-check="optional"]::before) {
    color: var(--color-text-muted);
    content: "○";
    background: var(--color-bg-secondary);
  }

  /* Light mode adjustments for WCAG AA contrast */
  :root[data-theme="light"]
    .checklist-items
    :global(li[data-check="check"]::before),
  :root[data-theme="light"]
    .checklist-items
    :global(li:not([data-check])::before) {
    color: #065f46; /* emerald-800 */
  }

  :root[data-theme="light"]
    .checklist-items
    :global(li[data-check="cross"]::before) {
    color: #991b1b; /* red-800 */
  }

  :root[data-theme="light"]
    .checklist-items
    :global(li[data-check="warning"]::before) {
    color: #92400e; /* amber-800 */
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"])
      .checklist-items
      :global(li[data-check="check"]::before),
    :root:not([data-theme="dark"])
      .checklist-items
      :global(li:not([data-check])::before) {
      color: #065f46;
    }

    :root:not([data-theme="dark"])
      .checklist-items
      :global(li[data-check="cross"]::before) {
      color: #991b1b;
    }

    :root:not([data-theme="dark"])
      .checklist-items
      :global(li[data-check="warning"]::before) {
      color: #92400e;
    }
  }
</style>
