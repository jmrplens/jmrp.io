---
/**
 * CheckList Component
 * Renders a styled checklist with icons based on item type.
 * Usage: Pass items as children with data-check attribute (check, cross, warning, optional)
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  title?: string;
}

const { title } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
---

<div
  class="checklist"
  role="group"
  aria-label={title || t("aria.checklist")}
>
  {title && <div class="checklist-title">{title}</div>}
  <ul class="checklist-items">
    <slot />
  </ul>
</div>

<style>
  .checklist {
    padding: 18px;
    margin: 1.5rem 0;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .checklist-title {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .checklist-items {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0;
    margin: 0;
    font-size: 0.9063rem; /* 14.5px */
    color: var(--color-text);
    list-style: none;
  }

  /* Plain, inline status glyph (distinct shape per state) + label, no chrome.
     The glyph is absolutely positioned so the label stays normal inline flow —
     otherwise `display:flex` turns every inline child (bold term, <code> chip,
     text run) into its own squeezed flex column and the item breaks apart. */
  .checklist-items :global(li) {
    position: relative;
    padding: 0 0 0 24px;
  }

  .checklist-items :global(li::before) {
    position: absolute;
    top: 0;
    left: 0;
    width: 1em;
    font-size: 1em;
    line-height: inherit;
  }

  /* Required / Check items - success */
  .checklist-items :global(li[data-check="check"]::before),
  .checklist-items :global(li:not([data-check])::before) {
    color: var(--color-success);
    content: "✓";
  }

  /* Cross / Not allowed items - danger, struck-through label */
  .checklist-items :global(li[data-check="cross"]) {
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .checklist-items :global(li[data-check="cross"]::before) {
    color: var(--color-danger);
    text-decoration: none;
    content: "✕";
  }

  /* Warning items - warning */
  .checklist-items :global(li[data-check="warning"]::before) {
    color: var(--color-warning);
    content: "⚠";
  }

  /* Optional items - muted */
  .checklist-items :global(li[data-check="optional"]) {
    color: var(--color-text-muted);
  }

  .checklist-items :global(li[data-check="optional"]::before) {
    color: var(--color-text-muted);
    content: "○";
  }
</style>
