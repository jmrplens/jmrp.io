---
/**
 * APIEndpoint Component
 * Renders documentation for a REST API endpoint.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  method: "GET" | "POST" | "PUT" | "PATCH" | "DELETE";
  path: string;
  description?: string;
  auth?: boolean;
}

const { method, path, description, auth = false } = Astro.props;
const hasContent = Astro.slots.has("default");

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const methodColors: Record<Props["method"], string> = {
  GET: "method-get",
  POST: "method-post",
  PUT: "method-put",
  PATCH: "method-patch",
  DELETE: "method-delete",
};
---

<div class="api-endpoint">
  <div class="ae-header">
    <span class={`ae-method ${methodColors[method]}`}>{method}</span>
    <code class="ae-path">{path}</code>
    {
      auth && (
        <span
          class="ae-auth"
          role="note"
          aria-label={t("aria.authRequired")}
        >
          <span
            class="i-mdi:lock ae-auth-icon"
            aria-hidden="true"
          />
          {t("components.apiEndpoint.auth")}
        </span>
      )
    }
  </div>

  {description && <p class="ae-description">{description}</p>}

  {
    hasContent && (
      <div class="ae-content">
        <slot />
      </div>
    )
  }
</div>

<style>
  .api-endpoint {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .ae-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    align-items: center;
    padding: 1rem 1.125rem;
  }

  .api-endpoint:has(.ae-description) .ae-header,
  .api-endpoint:has(.ae-content) .ae-header {
    padding-bottom: 0.625rem;
  }

  /*
   * Lab method badges — filled semantic chip; the HTTP verb (text) always
   * names the action, so meaning never rides on colour alone. Colour maps to
   * REST intent: GET read, POST create, PUT/PATCH update, DELETE destructive.
   */
  .ae-method {
    padding: 0.25rem 0.5625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    color: var(--color-on-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-text-muted);
    border-radius: var(--radius-sm);
  }

  .method-get {
    background: var(--color-success);
  }

  .method-post {
    background: var(--color-info);
  }

  .method-put,
  .method-patch {
    background: var(--color-warning);
  }

  .method-delete {
    background: var(--color-danger);
  }

  .ae-path {
    flex: 1;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-heading);
    background: transparent;
  }

  /* Auth marker — outlined accent chip (icon + word, never colour alone). */
  .ae-auth {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    padding: 0.125rem 0.4375rem;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-accent);
    background: transparent;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-sm);
  }

  .ae-auth-icon {
    width: 12px;
    height: 12px;
    color: var(--color-accent);
  }

  .ae-description {
    padding: 0 1.125rem 1rem;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  /* Only add border when content follows */
  .api-endpoint:has(.ae-content) .ae-description {
    padding-bottom: 1rem;
    border-bottom: var(--border-1);
  }

  .ae-content {
    padding: 1rem 1.125rem;
  }

  .ae-content :global(h4),
  .ae-content :global(h5) {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ae-content :global(h4:first-child),
  .ae-content :global(h5:first-child) {
    margin-top: 0;
  }
</style>
