---
/**
 * APIEndpoint Component
 * Renders documentation for a REST API endpoint.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  method: "GET" | "POST" | "PUT" | "PATCH" | "DELETE";
  path: string;
  description?: string;
  auth?: boolean;
}

const { method, path, description, auth = false } = Astro.props;
const hasContent = Astro.slots.has("default");

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const methodColors: Record<Props["method"], string> = {
  GET: "method-get",
  POST: "method-post",
  PUT: "method-put",
  PATCH: "method-patch",
  DELETE: "method-delete",
};
---

<div class="api-endpoint">
  <div class="ae-header">
    <span class={`ae-method ${methodColors[method]}`}>{method}</span>
    <code class="ae-path">{path}</code>
    {
      auth && (
        <span
          class="ae-auth"
          role="note"
          aria-label={t("aria.authRequired")}
        >
          <span
            class="i-mdi:lock ae-auth-icon"
            aria-hidden="true"
          />
          {t("components.apiEndpoint.auth")}
        </span>
      )
    }
  </div>

  {description && <p class="ae-description">{description}</p>}

  {
    hasContent && (
      <div class="ae-content">
        <slot />
      </div>
    )
  }
</div>

<style>
  .api-endpoint {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .ae-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-hair);
  }

  /*
   * Lab method badges — mono + uppercase + bordered, so the HTTP verb (text)
   * and the badge shape carry the meaning, never colour alone:
   *   GET    → teal outline   (safe / read)
   *   DELETE → filled amber   (destructive — distinct fill shape)
   *   others → neutral outline (the verb word disambiguates POST/PUT/PATCH)
   */
  .ae-method {
    padding: 0.25rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    color: var(--color-text-heading);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .method-get {
    border-color: color-mix(in srgb, var(--teal) 55%, var(--color-border));
  }

  .method-delete {
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .ae-path {
    flex: 1;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text);
    background: transparent;
  }

  .ae-auth {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-heading);
    background: var(--color-bg);
    border: 1px solid var(--color-hair);
    border-radius: 9999px;
  }

  .ae-auth-icon {
    width: 12px;
    height: 12px;
    color: var(--color-primary);
  }

  .ae-description {
    padding: 0.875rem 1rem;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* Only add border when content follows */
  .api-endpoint:has(.ae-content) .ae-description {
    border-bottom: var(--border-1);
  }

  .ae-content {
    padding: 1rem;
  }

  .ae-content :global(h4),
  .ae-content :global(h5) {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ae-content :global(h4:first-child),
  .ae-content :global(h5:first-child) {
    margin-top: 0;
  }
</style>
