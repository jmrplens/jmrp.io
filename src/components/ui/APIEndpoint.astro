---
/**
 * APIEndpoint Component
 * Renders documentation for a REST API endpoint.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  method: "GET" | "POST" | "PUT" | "PATCH" | "DELETE";
  path: string;
  description?: string;
  auth?: boolean;
}

const { method, path, description, auth = false } = Astro.props;
const hasContent = Astro.slots.has("default");

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const methodColors: Record<Props["method"], string> = {
  GET: "method-get",
  POST: "method-post",
  PUT: "method-put",
  PATCH: "method-patch",
  DELETE: "method-delete",
};
---

<div class="api-endpoint">
  <div class="ae-header">
    <span class={`ae-method ${methodColors[method]}`}>{method}</span>
    <code class="ae-path">{path}</code>
    {
      auth && (
        <span
          class="ae-auth"
          role="note"
          aria-label={t("aria.authRequired")}
        >
          <span
            class="i-mdi:lock ae-auth-icon"
            aria-hidden="true"
          />
          {t("components.apiEndpoint.auth")}
        </span>
      )
    }
  </div>

  {description && <p class="ae-description">{description}</p>}

  {
    hasContent && (
      <div class="ae-content">
        <slot />
      </div>
    )
  }
</div>

<style>
  .api-endpoint {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .ae-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--color-bg-subtle);
    border-bottom: var(--border-1);
  }

  .ae-method {
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    border-radius: var(--radius-sm);
  }

  .method-get {
    color: #10b981;
    background: rgb(16 185 129 / 15%);
  }

  .method-post {
    color: #3b82f6;
    background: rgb(59 130 246 / 15%);
  }

  .method-put {
    color: #f59e0b;
    background: rgb(245 158 11 / 15%);
  }

  .method-patch {
    color: #8b5cf6;
    background: rgb(139 92 246 / 15%);
  }

  .method-delete {
    color: #ef4444;
    background: rgb(239 68 68 / 15%);
  }

  .ae-path {
    flex: 1;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text);
    background: transparent;
  }

  .ae-auth {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    color: #f59e0b;
    background: rgb(245 158 11 / 15%);
    border-radius: 9999px;
  }

  .ae-auth-icon {
    width: 12px;
    height: 12px;
  }

  .ae-description {
    padding: 0.875rem 1rem;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* Only add border when content follows */
  .api-endpoint:has(.ae-content) .ae-description {
    border-bottom: var(--border-1);
  }

  .ae-content {
    padding: 1rem;
  }

  .ae-content :global(h4),
  .ae-content :global(h5) {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ae-content :global(h4:first-child),
  .ae-content :global(h5:first-child) {
    margin-top: 0;
  }

  /* Light mode adjustments for WCAG AA contrast - define variables */
  :root[data-theme="light"] {
    --method-get-color: #065f46; /* emerald-800 */
    --method-post-color: #1e40af; /* blue-800 */
    --method-put-color: #92400e; /* amber-800 */
    --method-patch-color: #5b21b6; /* violet-800 */
    --method-delete-color: #991b1b; /* red-800 */
    --ae-auth-color: #92400e; /* amber-800 */
  }

  /* System preference fallback when no explicit theme is set */
  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) {
      --method-get-color: #065f46;
      --method-post-color: #1e40af;
      --method-put-color: #92400e;
      --method-patch-color: #5b21b6;
      --method-delete-color: #991b1b;
      --ae-auth-color: #92400e;
    }
  }

  :root[data-theme="light"] .method-get,
  :root:not([data-theme]) .method-get {
    color: var(--method-get-color, #10b981);
  }

  :root[data-theme="light"] .method-post,
  :root:not([data-theme]) .method-post {
    color: var(--method-post-color, #3b82f6);
  }

  :root[data-theme="light"] .method-put,
  :root:not([data-theme]) .method-put {
    color: var(--method-put-color, #f59e0b);
  }

  :root[data-theme="light"] .method-patch,
  :root:not([data-theme]) .method-patch {
    color: var(--method-patch-color, #8b5cf6);
  }

  :root[data-theme="light"] .method-delete,
  :root:not([data-theme]) .method-delete {
    color: var(--method-delete-color, #ef4444);
  }

  :root[data-theme="light"] .ae-auth,
  :root:not([data-theme]) .ae-auth {
    color: var(--ae-auth-color, #f59e0b);
  }

  /* Dark mode contrast fixes */
  :root[data-theme="dark"] .method-get {
    color: #6ee7b7;
  }

  :root[data-theme="dark"] .method-post {
    color: #93c5fd;
  }

  :root[data-theme="dark"] .method-put {
    color: #fcd34d;
  }

  :root[data-theme="dark"] .method-patch {
    color: #c4b5fd;
  }

  :root[data-theme="dark"] .method-delete {
    color: #fca5a5;
  }

  :root[data-theme="dark"] .ae-auth {
    color: #fcd34d;
  }
</style>
