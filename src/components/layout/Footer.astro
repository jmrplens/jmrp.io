---
/**
 * Footer component.
 * Displays copyright info and social media links loaded from `src/content/site_config/socials.yaml`.
 * Includes logic to map FontAwesome classes to Iconify names.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import type { SiteConfig, SocialsConfig } from "@src/types";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const footerNav = [
  { label: t("nav.about"), href: translatePath("/about/") },
  { label: t("nav.uses"), href: translatePath("/uses/") },
  { label: t("nav.now"), href: translatePath("/now/") },
];

const today = new Date();
const socialsEntry = await getEntry("site_config", "socials");
const socials = (socialsEntry?.data || {}) as SocialsConfig;

const siteEntry = await getEntry("site_config", "site");
const siteConfig = (siteEntry?.data || {}) as SiteConfig;

interface SocialLink {
  url: string;
  label: string;
  icon?: string;
  icon_name?: string;
  img_light?: string;
  img_dark?: string;
  rel?: string;
}

/**
 * Normalizes the rel attribute for external links.
 * Ensures required tokens (external, noopener, noreferrer) are always present
 * while preserving any extra tokens (e.g. "me" for identity verification).
 *
 * @param rel - Optional rel string from config.
 * @returns Normalized rel string with all required tokens.
 */
function normalizeExternalRel(rel?: string): string {
  const parts = new Set((rel ?? "").split(/\s+/).filter(Boolean));
  parts.add("external");
  parts.add("noopener");
  parts.add("noreferrer");
  return [...parts].join(" ");
}

const socialLinks: SocialLink[] = [];

if (socials.github_username) {
  socialLinks.push({
    url: `https://github.com/${socials.github_username}`,
    icon: "fa-brands:github",
    label: "GitHub",
  });
}

if (socials.linkedin_username) {
  socialLinks.push({
    url: `https://linkedin.com/in/${socials.linkedin_username}`,
    icon: "fa-brands:linkedin",
    label: "LinkedIn",
  });
}

if (socials.mastodon_username) {
  let url = socials.mastodon_username;
  if (!url.startsWith("http://") && !url.startsWith("https://")) {
    url = `https://${url}`;
  }
  socialLinks.push({
    url: url,
    icon: "fa-brands:mastodon",
    label: "Mastodon",
    rel: "me noopener noreferrer",
  });
}

if (socials.scholar_userid) {
  socialLinks.push({
    url: `https://scholar.google.com/citations?user=${socials.scholar_userid}`,
    icon: "mdi:school",
    label: "Google Scholar",
  });
}

if (socials.matrix_id) {
  socialLinks.push({
    url: `https://matrix.to/#/${socials.matrix_id}`,
    icon_name: "simple-icons:matrix",
    label: "Matrix",
  });
}

if (socials.custom_social) {
  const customs = socials.custom_social;
  for (const item of customs) {
    if (item.icon) {
      socialLinks.push({
        url: item.url,
        icon: item.icon,
        label: item.title,
        rel: item.rel,
      });
    } else if (item.icon_name) {
      socialLinks.push({
        url: item.url,
        icon_name: item.icon_name,
        label: item.title,
        rel: item.rel,
      });
    } else if (item.icon_light && item.icon_dark) {
      socialLinks.push({
        url: item.url,
        img_light: item.icon_light,
        img_dark: item.icon_dark,
        label: item.title,
        rel: item.rel,
      });
    } else {
      // Generic fallback
      socialLinks.push({
        url: item.url,
        icon: "fa-solid:link",
        label: item.title,
        rel: item.rel,
      });
    }
  }
}

/**
 * Resolves an icon name from a potentially legacy FontAwesome class string.
 *
 * This function provides backward compatibility for 'custom_social' entries
 * that use FontAwesome classes (e.g., "fab fa-twitter"). New social links
 * should preferably use the Iconify format (e.g., "fa-brands:twitter").
 *
 * @param faClass - The class string to resolve.
 * @returns The resolved icon name in Iconify format.
 */
const getIconName = (faClass: string) => {
  if (!faClass) return "";
  const trimmed = faClass.trim();
  if (!trimmed) return "";

  // If it's already in collection:icon format, return as is
  if (trimmed.includes(":")) return trimmed;

  const parts = trimmed.split(" ");
  if (parts.length < 2) return "";

  const style = parts[0]; // fab, fas
  const iconPart = parts[1];
  const name = iconPart?.replace("fa-", "") || "";

  if (!name) return "";

  if (style === "fab") return `fa-brands:${name}`;
  // Default to solid for fas or others
  return `fa-solid:${name}`;
};

// Helper to determine icon type for each link to avoid nested ternaries
const getIconType = (
  link: SocialLink,
): "image" | "icon" | "icon_name" | null => {
  if (link.img_light && link.img_dark) return "image";
  if (link.icon) return "icon";
  if (link.icon_name) return "icon_name";
  return null;
};

// Pre-compute icon types and resolved names for all social links to avoid repeated calls
const socialLinksWithType = socialLinks.map((link) => {
  const iconType = getIconType(link);
  // Pre-resolve icon name for 'icon' type to validate it's not empty
  const resolvedIconName =
    iconType === "icon" && link.icon ? getIconName(link.icon) : null;

  // Pre-calculate full class name for icons
  let fullIconClass = "";
  if (iconType === "icon" && resolvedIconName) {
    fullIconClass = resolvedIconName.startsWith("i-")
      ? resolvedIconName
      : `i-${resolvedIconName}`;
  } else if (iconType === "icon_name" && link.icon_name) {
    fullIconClass = link.icon_name.startsWith("i-")
      ? link.icon_name
      : `i-${link.icon_name}`;
  }

  return {
    ...link,
    iconType,
    resolvedIconName,
    fullIconClass,
    imgLight: iconType === "image" ? link.img_light : null,
    imgDark: iconType === "image" ? link.img_dark : null,
  };
});
---

<footer>
  <div class="container">
    <nav
      class="footer-nav"
      aria-label={t("nav.about")}
    >
      {
        footerNav.map((item) => (
          <a
            href={item.href}
            class="footer-nav__link"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <p>
      {
        t("ui.copyright", {
          year: String(today.getFullYear()),
          author: siteConfig.author,
        })
      }
    </p>
    <div class="social-links">
      {
        socialLinksWithType.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel={normalizeExternalRel(link.rel)}
            aria-label={t("aria.visitProfile", { name: link.label })}
            title={link.label}
            class="social-btn"
          >
            {/* Render icons using pre-computed iconType */}
            {link.iconType === "image" && link.imgLight && link.imgDark && (
              <>
                <Image
                  src={link.imgLight}
                  alt={link.label}
                  width={28}
                  height={28}
                  class="social-icon light-icon"
                  loading="lazy"
                  decoding="async"
                />
                <Image
                  src={link.imgDark}
                  alt={link.label}
                  width={28}
                  height={28}
                  class="social-icon dark-icon"
                  loading="lazy"
                  decoding="async"
                />
              </>
            )}
            {link.fullIconClass && (
              <span class={`${link.fullIconClass} social-icon-svg`} />
            )}
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  footer {
    padding: var(--space-lg) 0;
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    border-top: 1px solid var(--color-hair);
  }

  .container {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
  }

  .footer-nav__link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-nav__link:hover {
    color: var(--color-accent);
  }

  .social-links {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    font-size: 1.5rem;
  }

  .social-links a {
    color: var(--color-text-muted);
  }

  .social-links a:hover {
    color: var(--color-primary);
  }

  .social-icon,
  .social-icon-svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .light-icon {
    display: block;
  }

  .dark-icon {
    display: none;
  }

  :global(html[data-theme="dark"]) .light-icon {
    display: none;
  }

  :global(html[data-theme="dark"]) .dark-icon {
    display: block;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;

    /* Ensure minimum 44x44px touch target */
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s;
  }

  .social-btn:hover,
  .social-btn:focus {
    background-color: var(--accent-dim);
  }
</style>
