---
/**
 * LanguageSwitcher Component
 *
 * A two-segment EN | ES pill. The current locale is a non-interactive active
 * segment (`aria-current`), the other locale is a link that switches the page.
 * Works without JS (no hydration); alternate URLs are computed at build time.
 *
 * @example
 * ```astro
 * <LanguageSwitcher />
 * ```
 */
import {
  defaultLocale,
  type Locale,
  localeConfig,
  locales,
} from "@i18n/config";
import { stripLocalePrefix, useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Preserve the current path when switching locales.
const cleanPath = stripLocalePrefix(Astro.url.pathname);
const pathFor = (loc: Locale): string =>
  loc === defaultLocale ? cleanPath : `/${loc}${cleanPath}`;
---

<div
  class="lang-pill"
  role="group"
  aria-label={t("aria.languageSwitcher")}
>
  {
    locales.map((loc) => {
      const active = loc === locale;
      const code = loc.toUpperCase();
      return active ? (
        <span
          class="lang-seg lang-seg--active"
          aria-current="true"
        >
          {code}
        </span>
      ) : (
        <a
          class="lang-seg"
          href={pathFor(loc)}
          hreflang={loc}
          lang={loc}
          aria-label={t("ui.switchLanguage", { lang: localeConfig[loc].label })}
          data-astro-prefetch
        >
          {code}
        </a>
      );
    })
  }
</div>

<style>
  .lang-pill {
    display: inline-flex;
    align-items: center;
    padding: 2px;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: var(--fw-medium);
    letter-spacing: 0.04em;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .lang-seg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 40px;
    padding: 0.25rem 0.5rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: calc(var(--radius-md) - 3px);
    transition:
      color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }

  a.lang-seg:hover,
  a.lang-seg:focus-visible {
    color: var(--color-text-heading);
    background-color: var(--color-bg-subtle);
  }

  a.lang-seg:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .lang-seg--active {
    color: var(--color-accent);
    background-color: var(--accent-dim);
  }
</style>

<script>
  function setupLangSwitcher() {
    const links = document.querySelectorAll<HTMLAnchorElement>("a.lang-seg");
    for (const link of links) {
      link.addEventListener("click", () => {
        if (typeof (window as any).__markLanguageChoice === "function") {
          (window as any).__markLanguageChoice();
        }
      });
    }
  }

  setupLangSwitcher();
  document.addEventListener("astro:after-swap", setupLangSwitcher);
</script>
