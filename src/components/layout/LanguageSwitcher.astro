---
/**
 * LanguageSwitcher Component
 *
 * A two-segment EN | ES pill. The current locale is a non-interactive active
 * segment (`aria-current`), the other locale is a link that switches the page.
 * Works without JS (no hydration); alternate URLs are computed at build time.
 *
 * @example
 * ```astro
 * <LanguageSwitcher />
 * ```
 */
import {
  defaultLocale,
  type Locale,
  localeConfig,
  locales,
} from "@i18n/config";
import { stripLocalePrefix, useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// Preserve the current path when switching locales.
const cleanPath = stripLocalePrefix(Astro.url.pathname);
const pathFor = (loc: Locale): string =>
  loc === defaultLocale ? cleanPath : `/${loc}${cleanPath}`;
---

<div
  class="lang-pill"
  role="group"
  aria-label={t("aria.languageSwitcher")}
>
  {locales.map((loc) => {
    const active = loc === locale;
    const code = loc.toUpperCase();
    return active ? (
      <span
        class="lang-seg lang-seg--active"
        aria-current="true"
      >
        {code}
      </span>
    ) : (
      // The name is the link's own text, not an aria-label: it carries two
      // languages (the page's "switch to" and the other language's own
      // name), and only text can mark the second.
      // `lang` sat on the whole anchor until 2026-10-30, which voiced the
      // page-language half in the other language (WCAG 3.1.2). The visible
      // code stays first in the name (WCAG 2.5.3). One line on purpose, so
      // no reflowed whitespace lands inside the link.
      // prettier-ignore
      <a class="lang-seg" href={pathFor(loc)} hreflang={loc} data-astro-prefetch>{code}<span class="sr-only">{`: ${t("ui.switchLanguageTo")} `}<span lang={loc}>{localeConfig[loc].label}</span></span></a>
    );
  })}
</div>

<style>
  .lang-pill {
    display: inline-flex;
    align-items: center;
    padding: 2px;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: var(--fw-medium);
    letter-spacing: 0.04em;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .lang-seg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 40px;
    padding: 0.25rem 0.5rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: calc(var(--radius-md) - 3px);
    transition:
      color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }

  a.lang-seg:hover,
  a.lang-seg:focus-visible {
    color: var(--color-text-heading);
    background-color: var(--color-bg-subtle);
  }

  a.lang-seg:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .lang-seg--active {
    color: var(--color-accent);
    background-color: var(--accent-dim);
  }
</style>

<script>
  function setupLangSwitcher() {
    const links = document.querySelectorAll<HTMLAnchorElement>("a.lang-seg");
    for (const link of links) {
      link.addEventListener("click", () => {
        if (typeof (window as any).__markLanguageChoice === "function") {
          // Pass the destination. Without it the detector read the CURRENT
          // path — this handler runs before the browser navigates — and
          // recorded the language being left instead of the one chosen.
          (window as any).__markLanguageChoice(link.pathname);
        }
      });
    }
  }

  setupLangSwitcher();
  document.addEventListener("astro:after-swap", setupLangSwitcher);
</script>
