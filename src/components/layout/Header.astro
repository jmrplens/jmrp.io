---
/**
 * Header component.
 * Contains the logo, navigation menu, and theme toggle.
 * Responsive design with a hamburger menu for mobile.
 */
import ThemeToggle from "@components/ui/ThemeToggle.astro";
import { getEntry } from "astro:content";

const siteEntry = await getEntry("site_config", "site");
// Type guard: siteEntry may be undefined, and data is a union type.
// We extract properties with safe fallbacks since we know "site" entry has these fields.
const siteData = siteEntry?.data;

const navItems =
  (siteData && "nav" in siteData ? siteData.nav : undefined) ?? [];
const logoText =
  (siteData && "logo_text" in siteData ? siteData.logo_text : undefined) ??
  "<JMRP />";
---

<header>
  <nav
    class="container"
    aria-label="Main Navigation"
  >
    <a
      href="/"
      class="logo"
      aria-label="Home - JMRP"
    >
      <span class="text-mono">{logoText}</span>
    </a>
    <div class="nav-right">
      <button
        id="menu-toggle"
        type="button"
        aria-label="Toggle Navigation"
        aria-controls="nav-links"
        aria-expanded="false"
        class="menu-toggle"
      >
        <span
          class="i-fa-solid:bars icon-bars"
          aria-hidden="true"
        ></span>
        <span
          class="i-fa-solid:times icon-times"
          aria-hidden="true"
        ></span>
      </button>
      <ul
        id="nav-links"
        class="nav-links"
        tabindex="-1"
      >
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                data-astro-prefetch
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script is:inline>
  /** @type {AbortController | null} */
  let mobileMenuAbortController = null;

  function setupMobileMenu() {
    // Prevent listener accumulation across transitions
    mobileMenuAbortController?.abort();
    mobileMenuAbortController = new AbortController();
    const { signal } = mobileMenuAbortController;

    const menuToggle = document.getElementById("menu-toggle");
    const navLinks = document.getElementById("nav-links");

    // Create backdrop if it doesn't exist
    let backdrop = document.querySelector(".menu-backdrop");
    if (!backdrop) {
      backdrop = document.createElement("div");
      backdrop.classList.add("menu-backdrop");
      document.body.appendChild(backdrop);
    }

    if (menuToggle && navLinks && backdrop) {
      // iOS-compatible scroll lock: save scroll position
      // Using position:fixed instead of overflow:hidden to avoid iOS Safari scroll-to-top bug
      let savedScrollY = 0;

      const lockScroll = () => {
        savedScrollY = window.scrollY;
        document.body.style.position = "fixed";
        document.body.style.top = `-${savedScrollY}px`;
        document.body.style.left = "0";
        document.body.style.right = "0";
        document.body.style.width = "100%"; // Prevent layout shift
        document.body.classList.add("menu-open");
      };

      const unlockScroll = () => {
        document.body.style.position = "";
        document.body.style.top = "";
        document.body.style.left = "";
        document.body.style.right = "";
        document.body.style.width = "";
        document.body.classList.remove("menu-open");
        window.scrollTo({ top: savedScrollY, behavior: "instant" });
      };

      const closeMenu = () => {
        menuToggle.setAttribute("aria-expanded", "false");
        navLinks.classList.remove("open");
        backdrop.classList.remove("open");
        unlockScroll();
        menuToggle.focus({ preventScroll: true }); // Restore focus
      };

      const toggleMenu = () => {
        const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
          closeMenu();
        } else {
          menuToggle.setAttribute("aria-expanded", "true");
          navLinks.classList.add("open");
          backdrop.classList.add("open");
          lockScroll();

          // Move focus to the first link for accessibility
          const firstLink = navLinks.querySelector("a");
          if (firstLink) {
            firstLink.focus({ preventScroll: true });
          }
        }
      };

      // Toggle menu
      menuToggle.addEventListener(
        "click",
        (e) => {
          e.stopPropagation(); // Prevent immediate close from document click
          toggleMenu();
        },
        { signal },
      );

      // Close when clicking the backdrop
      backdrop.addEventListener("click", closeMenu, { signal });

      // Close menu when a link is clicked
      navLinks.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMenu, { signal });
      });

      // Keydown (Escape) to close
      document.addEventListener(
        "keydown",
        (e) => {
          if (e.key === "Escape" && navLinks.classList.contains("open")) {
            closeMenu();
          }
        },
        { signal },
      );
    }
  }

  document.addEventListener("DOMContentLoaded", setupMobileMenu);
  if (!document.documentElement.hasAttribute("data-menu-listener-init")) {
    document.documentElement.setAttribute("data-menu-listener-init", "true");
    document.addEventListener("astro:after-swap", setupMobileMenu);
  }
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    height: var(--header-height); /* Fix height to prevent CLS */
    padding: var(--space-md) 0;
    background-color: var(--color-bg-secondary);
    border-bottom: var(--border-1);
  }

  nav {
    display: flex;
    flex-wrap: wrap; /* Allow wrapping for mobile menu */
    align-items: center;
    justify-content: space-between;
    width: 100%; /* Force full width for space-between */
  }

  .logo {
    z-index: calc(var(--z-header) + 1); /* Stay above mobile menu */
    padding: 0.5rem;
    font-size: 1.25rem;
    font-weight: var(--fw-extrabold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .nav-right {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }

  /* Default Mobile-First Approach or explicitly Desktop-First? 
       The current CSS is Desktop-First (styles are default, then overridden by max-width).
    */

  /* Desktop Styles (Default) */
  .menu-toggle {
    display: none; /* Hidden by default */
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    font-size: 1.5rem;
    color: var(--color-text);
    cursor: pointer;
    background: none;
    border: none;
  }

  /* Icon toggling logic */
  .menu-toggle .icon-times {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .icon-bars {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .icon-times {
    display: block;
  }

  .nav-links {
    display: flex;
    gap: var(--space-sm);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .nav-links a {
    display: block; /* Make block for better mobile hit area */
    padding: 0.5rem 0.75rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }

  .nav-links a:hover,
  .nav-links a:focus {
    color: var(--color-primary);
    background-color: rgb(179 137 245 / 10%);
  }

  /* Mobile Styles */
  @media (width <= 768px) {
    .menu-toggle {
      position: relative;
      z-index: calc(var(--z-header) + 2); /* Ensure above overlay */
      display: block; /* Visible on mobile */
    }

    .nav-links {
      position: fixed;
      top: 0;
      right: 0;
      z-index: calc(var(--z-header) + 1); /* Above backdrop */
      display: flex;
      visibility: hidden;
      flex-direction: column;
      gap: 1.5rem;
      justify-content: flex-start; /* Align items to top */
      width: 300px; /* Fixed width side drawer */
      max-width: 80vw; /* Responsive constraint */
      height: 100vh; /* Fallback for older browsers */
      height: 100dvh; /* Dynamic viewport height for mobile */
      padding: 5rem 2rem 2rem; /* Top padding for close button/logo area */
      background-color: var(--color-bg-secondary);
      border-left: var(--border-1);
      box-shadow: -5px 0 15px rgb(0 0 0 / 10%);

      /* Hidden State */
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Open state */
    .nav-links.open {
      visibility: visible;
      transform: translateX(0);
    }

    .nav-links li {
      width: 100%;
      text-align: left;
    }

    .nav-links a {
      display: flex; /* Use flex for potential icons or alignment */
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.25rem;
      font-size: 1.1rem;
      color: var(--color-text);
      background-color: rgb(255 255 255 / 3%); /* Subtle card bg */
      border: var(--border-1);
      border-radius: var(--radius-md);
      transition: all 0.2s ease;
    }

    .nav-links a:hover,
    .nav-links a:focus {
      color: var(--color-primary);
      background-color: rgb(179 137 245 / 10%); /* Primary color low opacity */
      border-color: var(--color-primary);
      transform: translateX(5px); /* Subtle slide effect */
    }

    /* Optional: Add a pseudo-element for an arrow if desired, currently plain text */
  }

  /* Backdrop Overlay */
  :global(.menu-backdrop) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: calc(var(--z-header) - 1); /* Below Header but above content */
    visibility: hidden;
    width: 100vw;
    height: 100vh;
    background-color: rgb(0 0 0 / 50%);
    opacity: 0%;
    backdrop-filter: blur(2px);
    transition: opacity 0.3s ease;
  }

  :global(.menu-backdrop.open) {
    visibility: visible;
    opacity: 100%;
  }

  /*
   * Note: Scroll locking is handled via JavaScript (position: fixed)
   * to be compatible with iOS Safari which has issues with
   * overflow: hidden causing scroll-to-top behavior.
   * The body.menu-open class is used as a marker for the JS logic.
   */
</style>
