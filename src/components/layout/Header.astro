---
/**
 * Header — Lab/Engineering navigation.
 *
 * Desktop: `~/section ❯ jmrp_` breadcrumb logo, a mono nav with an active
 * `/section` cue + amber underline, and a right cluster (segmented EN|ES,
 * theme, external GitHub). Below 880px the nav collapses to a burger that
 * opens the mobile terminal drawer (`NavDrawer`).
 *
 * The drawer open/close is the CSS checkbox hack (`#nav-open`), so it works
 * with zero JS; the inline script below is progressive enhancement (scroll
 * lock, focus trap, Esc, aria sync, `body.menu-open`).
 */
import LanguageSwitcher from "@components/layout/LanguageSwitcher.astro";
import Logo from "@components/layout/Logo.astro";
import NavDrawer from "@components/layout/NavDrawer.astro";
import ThemeToggle from "@components/ui/ThemeToggle.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import {
  stripLocalePrefix,
  type TranslationKey,
  useTranslatedPath,
  useTranslations,
} from "@i18n/utils";
import { getEntry } from "astro:content";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

// Active-nav detection by first path segment (e.g. /blog/... -> "blog").
const currentSegment =
  stripLocalePrefix(Astro.url.pathname).split("/").find(Boolean) ?? "";
/** Whether a nav href points at the current first-level section. */
const isCurrent = (href: string): boolean =>
  (stripLocalePrefix(href).split("/").find(Boolean) ?? "") === currentSegment;

const siteEntry = await getEntry("site_config", "site");
const siteData = siteEntry?.data;
const navItems =
  (siteData && "nav" in siteData ? siteData.nav : undefined) ?? [];

/**
 * Desktop nav shows the 6 section links only; the GitHub page is reachable
 * via the right-cluster brand icon, so the /github/ duplicate is excluded.
 */
const desktopNavItems = navItems.filter((item) => item.href !== "/github/");

/** Map each nav href to its i18n translation key. */
const navLabelKeyMap: Record<string, TranslationKey> = {
  "/": "nav.home",
  "/blog/": "nav.blog",
  "/homelab/": "nav.homelab",
  "/tools/": "nav.tools",
  "/cv/": "nav.cv",
  "/publications/": "nav.publications",
  "/github/": "nav.repositories",
};
---

<header>
  {/* Zero-JS drawer state: focusable checkbox toggled by the burger/scrim. */}
  <input
    type="checkbox"
    id="nav-open"
    class="nav-open-cb sr-only"
    aria-label={t("aria.toggleNav")}
    aria-controls="nav-drawer"
    aria-expanded="false"
  />

  <nav
    class="container"
    aria-label={t("aria.mainNav")}
  >
    <a
      href={translatePath("/")}
      class="logo"
    >
      <Logo />
    </a>
    <div class="nav-right">
      <ul class="nav-links">
        {
          desktopNavItems.map((item) => {
            const labelKey = navLabelKeyMap[item.href];
            const label = labelKey ? t(labelKey) : item.label;
            const active = isCurrent(item.href);
            return (
              <li>
                <a
                  href={translatePath(item.href)}
                  data-astro-prefetch
                  aria-current={active ? "page" : undefined}
                >
                  {active && (
                    <span
                      class="nav-prefix"
                      aria-hidden="true"
                    >
                      /
                    </span>
                  )}
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <LanguageSwitcher />
      <ThemeToggle />
      <a
        href="https://github.com/jmrplens"
        class="gh-link"
        target="_blank"
        rel="external noopener noreferrer"
        aria-label={t("aria.opensNewTab", { text: "GitHub" })}
      >
        <span
          class="i-fa-brands:github"
          aria-hidden="true"
        ></span>
      </a>
      <label
        for="nav-open"
        id="menu-toggle"
        class="menu-toggle"
        aria-label={t("aria.toggleNav")}
      >
        <span
          class="i-fa-solid:bars icon-bars"
          aria-hidden="true"
        ></span>
        <span
          class="i-fa-solid:times icon-times"
          aria-hidden="true"
        ></span>
      </label>
    </div>
  </nav>

  {/* Scrim (zero-JS close via label) + the terminal drawer. */}
  <label
    for="nav-open"
    class="menu-backdrop"
    aria-label={t("aria.closeMenu")}
  ></label>
  <NavDrawer />
</header>

<script is:inline>
  /** @type {AbortController | null} */
  let navMenuAbort = null;

  function setupNavMenu() {
    navMenuAbort?.abort();
    navMenuAbort = new AbortController();
    const { signal } = navMenuAbort;

    const checkbox = document.getElementById("nav-open");
    const toggle = document.getElementById("menu-toggle");
    const drawer = document.getElementById("nav-drawer");
    if (!checkbox || !toggle || !drawer) return;

    let savedScrollY = 0;

    const lockScroll = () => {
      savedScrollY = window.scrollY;
      document.body.style.position = "fixed";
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.left = "0";
      document.body.style.right = "0";
      document.body.style.width = "100%";
      document.body.classList.add("menu-open");
    };

    const unlockScroll = () => {
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.left = "";
      document.body.style.right = "";
      document.body.style.width = "";
      document.body.classList.remove("menu-open");
      window.scrollTo({ top: savedScrollY, behavior: "instant" });
    };

    // Only VISIBLE focusables — the zero-JS `.term-static` links are
    // display:none once the JS terminal takes over, but querySelectorAll would
    // still return them (offsetParent is null for display:none elements).
    const focusables = () =>
      [
        ...drawer.querySelectorAll(
          'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ].filter((el) => el.offsetParent !== null);

    // Background landmarks to inert while the modal drawer is open.
    const bgEls = () =>
      [document.querySelector("main"), document.querySelector("footer")].filter(
        Boolean,
      );

    const open = () => {
      drawer.classList.add("open");
      // aria-expanded lives on the checkbox (the focusable control); the burger
      // <label> must not carry it (aria-allowed-attr / label-role limitation).
      checkbox.setAttribute("aria-expanded", "true");
      bgEls().forEach((el) => el.setAttribute("inert", ""));
      lockScroll();
      // Move focus into the dialog container itself (tabindex="-1") rather than
      // any inner control. Focusing a nav link would paint a focus ring that
      // competes with the current-section marker; focusing the input would pop
      // the mobile keyboard. The container is the accessible, neutral target.
      drawer.focus({ preventScroll: true });
    };

    const close = ({ restoreFocus } = { restoreFocus: true }) => {
      checkbox.checked = false;
      drawer.classList.remove("open");
      checkbox.setAttribute("aria-expanded", "false");
      bgEls().forEach((el) => el.removeAttribute("inert"));
      unlockScroll();
      // Let the terminal (NavDrawer) stop any playing Nedry audio.
      document.dispatchEvent(new CustomEvent("nav-drawer-close"));
      // Focus returns to the real trigger control (the #nav-open checkbox);
      // the burger <label> is not focusable.
      if (restoreFocus) checkbox.focus({ preventScroll: true });
    };

    // The checkbox is the source of truth (also flips on label/scrim clicks).
    checkbox.addEventListener(
      "change",
      () => (checkbox.checked ? open() : close({ restoreFocus: false })),
      { signal },
    );

    // Esc closes; Tab is trapped inside the open drawer.
    document.addEventListener(
      "keydown",
      (e) => {
        if (!checkbox.checked) return;
        if (e.key === "Escape") {
          e.preventDefault();
          close();
        } else if (e.key === "Tab") {
          const items = focusables();
          if (items.length === 0) return;
          const first = items[0];
          const last = items[items.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      },
      { signal },
    );

    // Close after following an in-drawer navigation link.
    drawer.querySelectorAll("a[href]").forEach((link) => {
      link.addEventListener("click", () => close({ restoreFocus: false }), {
        signal,
      });
    });
  }

  document.addEventListener("DOMContentLoaded", setupNavMenu);
  if (!document.documentElement.hasAttribute("data-nav-listener-init")) {
    document.documentElement.setAttribute("data-nav-listener-init", "true");
    document.addEventListener("astro:after-swap", setupNavMenu);
  }
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    height: var(--header-height);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-hair);
  }

  /*
   * Frosted chrome on a ::before layer (NOT on <header>): a backdrop-filter on
   * the header would make it the containing block for the fixed drawer, pushing
   * its off-screen transform into the document scroll width.
   */
  header::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    background-color: var(--color-bg-header);
    backdrop-filter: blur(12px);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .logo {
    z-index: calc(var(--z-header) + 1);
    display: inline-flex;
    align-items: center;
    padding: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .nav-right {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
  }

  /* --- Desktop nav links --- */
  .nav-links {
    display: flex;
    gap: 2px;
    padding: 0;
    margin: 0 var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    list-style: none;
  }

  .nav-links a {
    position: relative;
    display: block;
    padding: 8px 12px;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--color-text-heading);
    background-color: var(--color-surface-2);
  }

  .nav-links a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* Active section: accent text, a `/` prefix, and a 2px amber underline. */
  .nav-links a[aria-current="page"] {
    color: var(--color-accent);
  }

  .nav-prefix {
    margin-right: 0.3em;
    color: var(--color-accent);
  }

  .nav-links a[aria-current="page"]::after {
    position: absolute;
    right: 12px;
    bottom: 2px;
    left: 12px;
    height: 2px;
    content: "";
    background: var(--color-accent);
    border-radius: 2px;
  }

  /* --- Right cluster icon controls --- */
  .gh-link {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--color-text);
    border-radius: var(--radius-sm);
    transition:
      color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .gh-link > span {
    width: 1.125rem;
    height: 1.125rem;
  }

  .gh-link:hover,
  .gh-link:focus-visible {
    color: var(--color-text-heading);
    background: var(--color-surface-2);
  }

  .gh-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* --- Burger (label toggling #nav-open) --- */
  .menu-toggle {
    z-index: calc(var(--z-header) + 2);
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    font-size: var(--text-xl);
    color: var(--color-text);
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  .menu-toggle .icon-times {
    display: none;
  }

  /* Visible focus ring on the burger when the (sr-only) checkbox is focused. */
  .nav-open-cb:focus-visible + nav .menu-toggle {
    box-shadow: var(--focus-ring);
  }

  /* --- Scrim --- */
  .menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: var(--z-backdrop);
    visibility: hidden;
    background-color: var(--scrim);
    opacity: 0%;
    transition: opacity var(--dur-3) var(--ease-out);
  }

  /* --- Open state (zero-JS via :has, and the JS body.menu-open marker) --- */
  :global(html:has(#nav-open:checked)) .menu-backdrop {
    visibility: visible;
    opacity: 100%;
  }

  :global(html:has(#nav-open:checked)) body {
    overflow: hidden;
  }

  :global(html:has(#nav-open:checked)) .menu-toggle .icon-bars {
    display: none;
  }

  :global(html:has(#nav-open:checked)) .menu-toggle .icon-times {
    display: block;
  }

  /* The drawer only exists ≤880px; keep the checkbox out of the desktop tab
     order (and prevent :has() from ever opening the drawer there). */
  @media (width > 880px) {
    .nav-open-cb {
      display: none;
    }
  }

  /* --- Collapse below 880px --- */
  @media (width <= 880px) {
    header {
      height: var(--header-height-mobile);
    }

    .nav-links {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }

    /* Mobile bar = logo · lang · theme · burger. GitHub stays in the desktop
       cluster and the drawer footer (keeps the 320px bar from overflowing). */
    .gh-link {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-backdrop {
      transition: none;
    }
  }
</style>
