---
/**
 * NavDrawer: the mobile navigation drawer.
 *
 * A plain menu in the site's own style: every section as a real link, with
 * its sub-sections (Blog → Series, Projects → Contributions) listed under it,
 * a smaller group of secondary pages, and the language, theme and GitHub
 * controls in the footer. No JavaScript of its own: it opens and closes
 * through the `#nav-open` checkbox in Header.astro, whose script adds the
 * focus trap, scroll lock and Esc handling on top.
 *
 * It replaced a simulated terminal (`tree -L 1` plus a typed command line)
 * that read as a gimmick next to the rest of the site (author's decision,
 * 2026-09-28).
 */
import LanguageSwitcher from "@components/layout/LanguageSwitcher.astro";
import Logo from "@components/layout/Logo.astro";
import ThemeToggle from "@components/ui/ThemeToggle.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import {
  stripLocalePrefix,
  type TranslationKey,
  useTranslatedPath,
  useTranslations,
} from "@i18n/utils";
import { getEntry } from "astro:content";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const cleanPath = stripLocalePrefix(Astro.url.pathname);
const withSlash = cleanPath.endsWith("/") ? cleanPath : `${cleanPath}/`;

const siteEntry = await getEntry("site_config", "site");
const siteData = siteEntry?.data;
const navItems =
  (siteData && "nav" in siteData ? siteData.nav : undefined) ?? [];

/** Each nav href's label key (mirrors Header). */
const navLabelKeyMap: Record<string, TranslationKey> = {
  "/": "nav.home",
  "/blog/": "nav.blog",
  "/homelab/": "nav.homelab",
  "/tools/": "nav.tools",
  "/cv/": "nav.cv",
  "/publications/": "nav.publications",
  "/projects/": "nav.projects",
};

// Icons as literals so UnoCSS's extractor sees every class.
const navIconMap: Record<string, string> = {
  "/": "i-mdi:home-outline",
  "/blog/": "i-mdi:note-text-outline",
  "/homelab/": "i-mdi:server-outline",
  "/tools/": "i-mdi:wrench-outline",
  "/cv/": "i-mdi:card-account-details-outline",
  "/publications/": "i-mdi:book-open-page-variant-outline",
  "/projects/": "i-mdi:source-branch",
};

/** Sub-sections shown under their parent section. */
const subItemsMap: Record<string, { href: string; key: TranslationKey }[]> = {
  "/blog/": [{ href: "/blog/series/", key: "menu.series" }],
  "/projects/": [
    { href: "/projects/contributions/", key: "menu.contributions" },
  ],
};

/** Whether `href` is the current page, or (for a section) contains it. */
const isCurrent = (href: string) => withSlash === href;
const isWithin = (href: string) =>
  href === "/" ? withSlash === "/" : withSlash.startsWith(href);

/**
 * The drawer's own order: work first (projects, writing, tools), then the
 * homelab and the profile pages. Sections missing from site.yaml's `nav`
 * are skipped; any extra one goes last, in its site.yaml order.
 */
const DRAWER_ORDER = [
  "/",
  "/projects/",
  "/blog/",
  "/tools/",
  "/homelab/",
  "/cv/",
  "/publications/",
];
const rank = (href: string) => {
  const index = DRAWER_ORDER.indexOf(href);
  return index === -1 ? DRAWER_ORDER.length : index;
};
const orderedNav = navItems.toSorted((a, b) => rank(a.href) - rank(b.href));

const sections = orderedNav.map((item) => {
  const labelKey = navLabelKeyMap[item.href];
  const subs = (subItemsMap[item.href] ?? []).map((sub) => ({
    href: translatePath(sub.href),
    label: t(sub.key),
    current: isWithin(sub.href),
  }));
  const subCurrent = subs.some((sub) => sub.current);
  return {
    href: translatePath(item.href),
    label: labelKey ? t(labelKey) : item.label,
    icon: navIconMap[item.href] ?? "i-mdi:folder-outline",
    // The section link is the current page only when no sub-section is.
    current: subCurrent ? false : isWithin(item.href),
    ancestor: subCurrent,
    subs,
  };
});

/**
 * The social profiles worth a tap from a phone: code (GitHub, GitLab), work
 * (LinkedIn) and the two social networks the author posts on. The rest of
 * the footer's list (Matrix, Keyoxide, Codeberg) stays in the page footer.
 */
const DRAWER_SOCIALS = ["GitHub", "GitLab", "LinkedIn", "Mastodon", "Bluesky"];
const socialLinks =
  (siteData && "social_links" in siteData
    ? siteData.social_links
    : undefined) ?? [];
const socials = DRAWER_SOCIALS.map((name) =>
  socialLinks.find((link) => link.name === name),
).filter((link) => link !== undefined);

/** Secondary pages: smaller, in one group at the bottom. */
const morePages: { href: string; key: TranslationKey }[] = [
  { href: "/about/", key: "nav.about" },
  { href: "/uses/", key: "nav.uses" },
  { href: "/feeds/", key: "menu.feeds" },
  { href: "/privacy/", key: "nav.privacy" },
  { href: "/license/", key: "nav.license" },
];
const more = morePages.map((page) => ({
  href: translatePath(page.href),
  label: t(page.key),
  current: isCurrent(page.href),
}));
---

<div
  id="nav-drawer"
  class="nav-drawer"
  role="dialog"
  aria-modal="true"
  aria-label={t("menu.drawerLabel")}
  tabindex="-1"
>
  <div class="drawer__head">
    <span
      class="drawer__mark"
      aria-hidden="true"
    >
      <Logo showPath={false} />
    </span>
    {/* `label` is naming-prohibited (no aria-label without a role), so the
        accessible name is sr-only text content instead. */}
    <label
      for="nav-open"
      class="drawer__close"
      aria-hidden="true"
    >
      <span class="sr-only">{t("aria.closeMenu")}</span>
      <span
        class="i-fa-solid:times"
        aria-hidden="true"
      ></span>
    </label>
    {/* JS twin of the close label: a label is not focusable, so once the
         enhancement script's focus trap is active a keyboard user could only
         close via Esc. Header.astro swaps the label for this real <button>.
         Hidden without JS on purpose: there is no trap then, and a dead
         button would be worse than none. */}
    <button
      type="button"
      class="drawer__close drawer__close--js"
      hidden
    >
      <span class="sr-only">{t("aria.closeMenu")}</span>
      <span
        class="i-fa-solid:times"
        aria-hidden="true"
      ></span>
    </button>
  </div>

  <div class="drawer__body">
    <nav
      class="menu"
      aria-label={t("menu.sectionsLabel")}
    >
      <ul class="menu__list">
        {sections.map((section) => (
          <li class="menu__item">
            <a
              href={section.href}
              class:list={[
                "menu__link",
                { "menu__link--ancestor": section.ancestor },
              ]}
              aria-current={section.current ? "page" : undefined}
            >
              <span
                class={`menu__icon ${section.icon}`}
                aria-hidden="true"
              />
              <span class="menu__label">{section.label}</span>
            </a>
            {section.subs.length > 0 && (
              <ul class="menu__sub">
                {section.subs.map((sub) => (
                  <li>
                    <a
                      href={sub.href}
                      class="menu__sub-link"
                      aria-current={sub.current ? "page" : undefined}
                    >
                      {sub.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="drawer__bottom">
    <nav
      class="more"
      aria-label={t("menu.moreLabel")}
    >
      <p
        class="more__title"
        aria-hidden="true"
      >
        {t("menu.moreLabel")}
      </p>
      <ul class="more__list">
        {more.map((page) => (
          <li>
            <a
              href={page.href}
              class="more__link"
              aria-current={page.current ? "page" : undefined}
            >
              {page.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ul
      class="socials"
      aria-label={t("menu.socialLabel")}
    >
      {socials.map((link) => (
        <li>
          <a
            href={link.url}
            class="socials__link"
            target="_blank"
            rel="external noopener noreferrer me"
            aria-label={t("aria.opensNewTab", { text: link.name })}
          >
            <span
              class={link.icon}
              aria-hidden="true"
            />
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="drawer__foot">
    <span class="drawer__status">
      <span
        class="drawer__dot"
        aria-hidden="true"
      ></span>
      {t("menu.available")}
    </span>
    <div class="drawer__foot-right">
      <LanguageSwitcher />
      <ThemeToggle id="theme-toggle-drawer" />
    </div>
  </div>
</div>

<style>
  .nav-drawer {
    /* Local token so the decorative shadow can be re-asserted verbatim in
       the :focus/:focus-visible override below. */
    --nd-shadow: -30px 0 60px -30px rgb(0 0 0 / 55%);

    position: fixed;
    top: 0;
    right: 0;
    z-index: var(--z-drawer);
    display: flex;
    visibility: hidden;
    flex-direction: column;
    width: var(--drawer-w);
    height: 100vh;
    height: 100dvh;
    background: color-mix(in srgb, var(--color-bg-secondary) 88%, transparent);
    border-left: 1px solid var(--color-border);
    box-shadow: var(--nd-shadow);
    backdrop-filter: blur(16px);
    transform: translateX(110%);
    transition: transform var(--dur-3) var(--ease-out);
  }

  /* The dialog itself takes focus on open; no ring on the container. */
  .nav-drawer:focus,
  .nav-drawer:focus-visible {
    outline: none;
    box-shadow: var(--nd-shadow);
  }

  /* Open state: zero-JS via the checkbox, plus the JS `.open` class. */
  :global(html:has(#nav-open:checked)) .nav-drawer,
  .nav-drawer.open {
    visibility: visible;
    transform: translateX(0);
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height-mobile);
    padding: 0 14px 0 18px;
    border-bottom: 1px solid var(--color-hair);
  }

  .drawer__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;

    /* Button resets, inert on the <label> variant. */
    padding: 0;
    color: var(--color-text-muted);
    cursor: pointer;
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
  }

  .drawer__close:hover {
    color: var(--color-text-heading);
    background: var(--color-surface-2);
  }

  .drawer__close > span {
    width: 1.1rem;
    height: 1.1rem;
  }

  .drawer__body {
    flex: 1;
    padding: 10px 12px;
    overflow-y: auto;
  }

  /* --- Sections --- */
  .menu__list,
  .menu__sub,
  .more__list {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .menu__list {
    display: flex;
    flex-direction: column;
  }

  .menu__link {
    display: flex;
    gap: 14px;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: var(--fw-medium);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition:
      background var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .menu__link:hover {
    color: var(--color-text-heading);
    background: var(--color-surface-2);
  }

  .menu__icon {
    flex: none;
    width: 1.2rem;
    height: 1.2rem;
    color: var(--color-text-muted);
  }

  /* Current page: amber marker, heading colour, a quiet fill. Not colour
     alone: aria-current carries it for assistive technology and the
     marker is a shape. */
  .menu__link[aria-current="page"] {
    color: var(--color-text-heading);
    background: var(--color-surface-2);
    box-shadow: inset 3px 0 0 var(--color-accent);
  }

  .menu__link[aria-current="page"] .menu__icon,
  .menu__link--ancestor .menu__icon {
    color: var(--color-accent);
  }

  .menu__link--ancestor {
    color: var(--color-text-heading);
  }

  /* Sub-sections: indented under the label, joined by a hairline. */
  .menu__sub {
    display: flex;
    flex-direction: column;
    margin: 0 0 4px calc(12px + 0.6rem - 1px);
    border-left: 1px solid var(--color-hair);
  }

  .menu__sub-link {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px 0 calc(14px + 0.6rem);
    font-size: var(--text-sm);
    font-weight: var(--fw-normal);
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .menu__sub-link:hover {
    color: var(--color-text-heading);
    background: var(--color-surface-2);
  }

  .menu__sub-link[aria-current="page"] {
    margin-left: -1px;
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
    background: var(--color-surface-2);
    border-left: 3px solid var(--color-accent);
  }

  /* --- Bottom block: secondary pages and profiles, above the footer --- */
  .drawer__bottom {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 18px 6px;
    border-top: 1px solid var(--color-hair);
  }

  .more__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .more__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-md);
  }

  .more__link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: var(--text-sm);
    font-weight: var(--fw-normal);
    color: var(--color-text);
    text-decoration: none;
  }

  .more__link:hover {
    color: var(--color-text-heading);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .more__link[aria-current="page"] {
    color: var(--color-accent);
  }

  /* --- Footer --- */
  .drawer__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 18px;
    border-top: 1px solid var(--color-hair);
  }

  .drawer__status {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text);
  }

  .drawer__dot {
    width: 7px;
    height: 7px;
    background: var(--teal);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--teal);
  }

  .drawer__foot-right {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .socials {
    display: flex;
    gap: 4px;
    padding: 0;
    margin: 0 0 0 -10px;
    list-style: none;
  }

  .socials__link {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--color-text);
    border-radius: var(--radius-sm);
  }

  .socials__link > span {
    width: 1.1rem;
    height: 1.1rem;
  }

  .socials__link:hover,
  .socials__link:focus-visible {
    color: var(--color-text-heading);
    background: var(--color-surface-2);
  }

  /* Consistent accent focus ring on every drawer control (WCAG 2.4.11). */
  .drawer__close:focus-visible,
  .socials__link:focus-visible,
  .menu__link:focus-visible,
  .menu__sub-link:focus-visible,
  .more__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-drawer,
    .menu__link {
      transition: none;
    }
  }
</style>
