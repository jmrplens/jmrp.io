---
/**
 * BaseHead component.
 * Included in all pages to handle:
 * - Global metadata (charset, viewport)
 * - SEO tags (title, description, keywords)
 * - Open Graph and Twitter cards
 * - JSON-LD Schema.org structured data (Merged Graph)
 * - Favicons and fonts
 */
import "@styles/global.css";

import appleTouchIconSrc from "@assets/apple-touch-icon.png";
import faviconSrc from "@assets/favicon.png";
import knowsAboutWikidata from "@data/knows-about-wikidata.json";
import { defaultLocale, type Locale, locales } from "@i18n/config";
import {
  getAlternateLinks,
  getOgLocale,
  type TranslationKey,
  useTranslations,
} from "@i18n/utils";
import type { SiteConfig } from "@src/types";
import { safeJsonLd } from "@utils/html";
import { CANONICAL_PERSON_IMAGE } from "@utils/person";
import { getProjects, softwareId } from "@utils/projects";
import { buildSameAs, getSiteUrl } from "@utils/site";
// Variable Fonts (managed by Astro Experimental Fonts)
import type { ImageMetadata } from "astro";
import { Font, getImage } from "astro:assets";
import { getEntry } from "astro:content";
import type {
  BreadcrumbList,
  ListItem,
  SiteNavigationElement,
  WebSite,
} from "schema-dts";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const alternateLinks = getAlternateLinks(Astro.url.pathname, getSiteUrl());

const favicon = await getImage({
  src: faviconSrc,
  format: "png",
  width: 32,
  height: 32,
});
const faviconWebp = await getImage({
  src: faviconSrc,
  format: "webp",
  width: 32,
  height: 32,
});
const appleTouchIcon = await getImage({
  src: appleTouchIconSrc,
  format: "png",
  width: 180,
  height: 180,
});

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

// The canonical Person entity's name/description come from `profile/about.yaml`
// (the richest, most current identity copy) so home/about/cv never redefine
// them locally with divergent values — see CLAUDE.md GEO audit notes.
const aboutEntry = await getEntry("profile", "about");
const aboutData =
  aboutEntry?.data.type === "about" ? aboutEntry.data : undefined;

interface Props {
  title: string;
  description?: string;
  image?: string | ImageMetadata;
  type?: string;
  noIndex?: boolean;
  // Article specific props
  publishDate?: Date;
  modifiedDate?: Date;
  authors?: string[]; // Defaults to siteData.author
  tags?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[]; // Custom JSON-LD schema to merge or override
}

const canonicalURL = new URL(Astro.url.pathname, getSiteUrl());

const {
  title,
  description = t("seo.siteDescription"),
  image,
  type = "website",
  noIndex = false,
  publishDate,
  modifiedDate,
  authors = [siteData.author],
  tags = [],
  schema,
} = Astro.props;

const siteTitle = t("seo.siteTitle");
const fullTitle = (() => {
  if (title === siteTitle) return title;
  const suffix = siteData.author;
  const shortSuffix = "JMRP";

  if (`${title} | ${suffix}`.length <= 65) {
    return `${title} | ${suffix}`;
  }
  if (`${title} | ${shortSuffix}`.length <= 65) {
    return `${title} | ${shortSuffix}`;
  }
  return title;
})();

// og:image:alt / twitter:image:alt — append the author only when the title
// doesn't already include it (e.g. the homepage title IS "Name | Job Title"),
// otherwise the alt text repeats the name twice ("Name | Job Title - Name").
const imageAlt = title.includes(siteData.author)
  ? title
  : `${title} - ${siteData.author}`;

// Image resolution logic
let resolvedImage;
if (image) {
  // If props provide an image
  if (typeof image === "string") {
    // Resolve image URL against the site URL for consistent absolute URLs
    resolvedImage = new URL(image, getSiteUrl());
  } else {
    // It's an imported Image object passed via props
    // Optimize it for OG/Twitter (Standard 1200x630, WebP for efficiency)
    const optimizedImage = await getImage({
      src: image,
      format: "webp",
      width: 1200,
      height: 630,
    });
    resolvedImage = new URL(optimizedImage.src, getSiteUrl());
  }
} else {
  // Per-route generated OG image (1200×630 branded PNG).
  // Derive the slug from the FULL pathname, locale included, so each locale
  // gets its own translated card (`/es/…` → `/og/es/…png`). Mirrors the slugs
  // enumerated in src/pages/og/[...slug].png.ts. Falls through to the Lab
  // default image only for routes not enumerated there.
  const cleanPath = Astro.url.pathname.replaceAll(/^\/|\/$/g, ""); // strip / edges
  const ogSlug = cleanPath || "home";
  resolvedImage = new URL(`/og/${ogSlug}.png`, getSiteUrl());
}

/** Derive MIME type from the resolved image URL extension. */
const ogImageMime = (() => {
  const ext = resolvedImage.pathname.split(".").pop()?.toLowerCase();
  const mimeMap: Record<string, string> = {
    webp: "image/webp",
    png: "image/png",
    jpg: "image/jpeg",
    jpeg: "image/jpeg",
    gif: "image/gif",
    avif: "image/avif",
    svg: "image/svg+xml",
  };
  return mimeMap[ext ?? ""] ?? "image/webp";
})();

// --- Schema.org Construction ---

// Canonical site root WITH trailing slash, so entity @id/url/item values match
// the page canonical form (avoids fragmenting the entity graph).
const siteRoot = new URL("/", getSiteUrl()).href;

// Machine-readable ORCID identifier for the Person, derived from sameAs.
const orcidUrl = siteData.person?.sameAs?.find((u) => u.includes("orcid.org"));
const orcidId = /orcid\.org\/([\dX-]+)/i.exec(orcidUrl ?? "")?.[1];

// --- Canonical Person entity (single source, referenced by @id everywhere) ---
// `jobTitle`/`description` are sourced from the richest, most current copy
// (profile/about.yaml) with a non-localized fallback in site.yaml. Page
// builders (Home/About/CV/GitHub) must reference `{"@id": "#person"}` or add
// ADDITIVE properties only (alumniOf, hasOccupation, hasCredential) — they
// must never redefine name/jobTitle/description/image/knowsAbout locally.
const personJobTitle =
  aboutData?.person.jobTitle[locale] ??
  siteData.person?.jobTitle ??
  siteData.jobTitle ??
  t("seo.jobTitle");
const personDescription =
  aboutData?.person.description[locale] ?? t("pages.cv.schemaDescription");

/**
 * The open-source software this Person authors, as bare `@id` references to
 * the `#software` nodes fully described on /projects/ (and, for most of them,
 * on the project's own documentation site, which publishes the SAME @id with
 * `author: { @id: #person }`).
 *
 * schema.org defines no forward "works made by" property on Person — only the
 * reverse edge from the CreativeWork — so `owns` carries the identity-side
 * half of the relation here; see `@utils/projects` for the full rationale.
 * Emitted site-wide and reference-only: every page connects the identity to
 * the body of work without repeating the project descriptions.
 */
const personProjects = (await getProjects()).map((project) => ({
  "@id": softwareId(project),
}));

const personKnowsAbout = siteData.person?.knowsAbout?.map((topic) => {
  const qid = (knowsAboutWikidata as Record<string, string>)[topic];
  // Wikidata's canonical entity concept URI uses a plain, non-secure scheme by
  // design — the standard Linked Data identifier, not a fetchable link.
  return qid
    ? {
        "@type": "Thing" as const,
        name: topic,
        // eslint-disable-next-line unicorn/prefer-https -- see comment above
        "@id": `http://www.wikidata.org/entity/${qid}`,
      }
    : topic;
});

// 1. WebSite Schema (Global)
const websiteSchema = {
  "@type": "WebSite",
  "@id": new URL("#website", getSiteUrl()).href,
  url: siteRoot,
  name: siteData.author,
  description: t("seo.siteDescription"),
  inLanguage: locale,
  publisher: {
    "@type": "Person",
    "@id": new URL("#person", getSiteUrl()).href,
    name: siteData.author,
    jobTitle: personJobTitle,
    description: personDescription,
    url: siteRoot,
    image: {
      "@type": "ImageObject",
      url: CANONICAL_PERSON_IMAGE.url,
      width: String(CANONICAL_PERSON_IMAGE.width),
      height: String(CANONICAL_PERSON_IMAGE.height),
    },
    ...(siteData.person?.worksFor && {
      worksFor: {
        "@type": "Organization",
        name: siteData.person.worksFor.name,
        ...(siteData.person.worksFor.url && {
          url: siteData.person.worksFor.url,
        }),
      },
    }),
    ...(personKnowsAbout &&
      personKnowsAbout.length > 0 && {
        knowsAbout: personKnowsAbout,
      }),
    ...(personProjects.length > 0 && { owns: personProjects }),
    ...(orcidId && {
      identifier: {
        "@type": "PropertyValue",
        propertyID: "ORCID",
        value: orcidId,
        url: orcidUrl,
      },
    }),
    sameAs: buildSameAs(siteData.social_links, siteData.person?.sameAs),
  },
} satisfies WebSite;

// 2. Navigation Schema — use translated labels
const navLabelKeyMap: Record<string, TranslationKey> = {
  "/": "nav.home",
  "/blog/": "nav.blog",
  "/homelab/": "nav.homelab",
  "/tools/": "nav.tools",
  "/cv/": "nav.cv",
  "/publications/": "nav.publications",
  "/projects/": "nav.projects",
  "/github/": "nav.repositories",
};
const navSchema = (siteData.nav || []).map((item): SiteNavigationElement => ({
  "@type": "SiteNavigationElement",
  name: navLabelKeyMap[item.href] ? t(navLabelKeyMap[item.href]) : item.label,
  url: new URL(item.href, getSiteUrl()).href,
}));

// 3. Breadcrumb Schema (Automatic)
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbList = {
  "@type": "BreadcrumbList",
  // Page-scoped @id so each page's breadcrumb trail is a distinct graph node
  // (a single site-wide id would collapse different trails into one).
  "@id": `${new URL(Astro.url.pathname, getSiteUrl()).href}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t("nav.home"),
      item: siteRoot,
    },
    ...pathSegments.map((segment, index): ListItem => {
      const path = `/${pathSegments.slice(0, index + 1).join("/")}/`;
      const isLastSegment = index === pathSegments.length - 1;
      const absoluteUrl = new URL(path, getSiteUrl()).href;

      // Prefer page title for the last segment if available
      const fallbackName = segment
        .replaceAll("-", " ")
        .replaceAll(/\b\w/g, (l) => l.toUpperCase());
      const name =
        isLastSegment && title && title !== siteData.title
          ? title
          : fallbackName;

      return {
        "@type": "ListItem",
        position: index + 2,
        name: name,
        item: absoluteUrl,
      };
    }),
  ],
} satisfies BreadcrumbList;

// 4. Merge Logic
// We use a @graph to include multiple items (Website, Page, Breadcrumbs, etc.)
let schemaGraph = [websiteSchema, ...navSchema, breadcrumbList];

if (schema) {
  // Use type assertion to bypass strict checking since schema is externally provided
  if (Array.isArray(schema)) {
    schemaGraph = [
      ...schemaGraph,
      ...(schema as unknown as (typeof schemaGraph)[number][]),
    ];
  } else {
    schemaGraph.push(schema as unknown as (typeof schemaGraph)[number]);
  }
}

const jsonLD = {
  "@context": "https://schema.org",
  "@graph": schemaGraph,
};
---

<!-- Global Metadata -->
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
/>

<!-- Font Preloads (Managed by Astro) — only the above-the-fold critical weights -->
<Font
  cssVariable="--font-ibm-plex-sans"
  preload={[{ weight: "400", style: "normal" }]}
/>
<Font
  cssVariable="--font-space-grotesk"
  preload={[{ weight: "700", style: "normal" }]}
/>
<Font
  cssVariable="--font-ibm-plex-mono"
  preload={[{ weight: "500", style: "normal" }]}
/>

<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon.svg"
/>
<link
  rel="icon"
  type="image/webp"
  href={faviconWebp.src}
/>
<link
  rel="icon"
  type="image/png"
  href={favicon.src}
/>
<link
  rel="apple-touch-icon"
  href={appleTouchIcon.src}
/>
<link
  rel="manifest"
  href={locale === defaultLocale
    ? "/site.webmanifest"
    : `/${locale}/site.webmanifest`}
/>
<link
  rel="sitemap"
  href="/sitemap-index.xml"
/>
<link
  rel="alternate"
  type="application/rss+xml"
  title={t("seo.rssFeedTitle")}
  href={locale === defaultLocale ? "/rss.xml" : `/${locale}/rss.xml`}
/>
{/* RSS feed for alternate locale */}
{
  locales
    .filter((l) => l !== locale)
    .map((l) => {
      const altT = useTranslations(l);
      return (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={altT("seo.rssFeedTitle")}
          href={l === defaultLocale ? "/rss.xml" : `/${l}/rss.xml`}
        />
      );
    })
}
<meta
  name="generator"
  content={Astro.generator}
/>
{/* Dark-first theme-color; light override follows the OS preference */}
<meta
  name="theme-color"
  content={siteData.theme_color}
  media="(prefers-color-scheme: dark)"
/>
<meta
  name="theme-color"
  content="#fafaf7"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="robots"
  content={noIndex ? "noindex, follow" : "index, follow"}
/>

<!-- SEO -->
<meta
  name="keywords"
  content={t("seo.siteKeywords")}
/>
<meta
  name="author"
  content={siteData.author}
/>
<meta
  name="fediverse:creator"
  content={siteData.fediverse_creator}
/>

<link
  rel="canonical"
  href={canonicalURL}
/>

<!-- Hreflang alternates -->
{
  alternateLinks.map((alt) => (
    <link
      rel="alternate"
      hreflang={alt.hreflang}
      href={alt.url}
    />
  ))
}

<!-- Social Verification (rel="me" for identity verification) -->
{
  siteData.social_links?.map((link) => (
    <link
      rel="me"
      href={link.url}
    />
  ))
}

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta
  name="title"
  content={title}
/>
<meta
  name="description"
  content={description}
/>

<!-- Open Graph / Facebook -->
<meta
  property="og:type"
  content={type}
/>
<meta
  property="og:url"
  content={canonicalURL}
/>
<meta
  property="og:title"
  content={title}
/>
<meta
  property="og:description"
  content={description}
/>
<meta
  property="og:image"
  content={resolvedImage}
/>
<meta
  property="og:image:type"
  content={ogImageMime}
/>
<meta
  property="og:image:width"
  content="1200"
/>
<meta
  property="og:image:height"
  content="630"
/>
<meta
  property="og:image:alt"
  content={imageAlt}
/>
<meta
  property="og:locale"
  content={getOgLocale(locale)}
/>
{
  alternateLinks
    .filter((alt) => alt.locale !== "x-default" && alt.locale !== locale)
    .map((alt) => (
      <meta
        property="og:locale:alternate"
        content={getOgLocale(alt.locale as Locale)}
      />
    ))
}
<meta
  property="og:site_name"
  content={siteData.author}
/>

<!-- Article Specific OG Tags -->
{
  type === "article" && (
    <>
      {publishDate && (
        <meta
          property="article:published_time"
          content={publishDate.toISOString()}
        />
      )}
      {modifiedDate && (
        <meta
          property="article:modified_time"
          content={modifiedDate.toISOString()}
        />
      )}
      {authors.map((author) => (
        <meta
          property="article:author"
          content={author}
        />
      ))}
      {tags.map((tag) => (
        <meta
          property="article:tag"
          content={tag}
        />
      ))}
    </>
  )
}

<!-- Twitter -->
<meta
  name="twitter:card"
  content="summary_large_image"
/>
<meta
  name="twitter:site"
  content={siteData.twitter_creator}
/>
<meta
  name="twitter:creator"
  content={siteData.twitter_creator}
/>
<meta
  name="twitter:url"
  content={canonicalURL}
/>
<meta
  name="twitter:title"
  content={title}
/>
<meta
  name="twitter:description"
  content={description}
/>
<meta
  name="twitter:image"
  content={resolvedImage}
/>
<meta
  name="twitter:image:alt"
  content={imageAlt}
/>

<!-- Cloudflare Web Analytics (Static with SRI) -->
{
  import.meta.env.PROD && import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
    <script
      is:inline
      defer
      src="/scripts/cf-beacon.js"
      data-cf-beacon={JSON.stringify({
        token: import.meta.env.PUBLIC_CF_BEACON_TOKEN,
      })}
      crossorigin="anonymous"
    />
  )
}

<!-- JSON-LD -->
<script
  is:inline
  type="application/ld+json"
  set:html={safeJsonLd(jsonLD)}
/>
