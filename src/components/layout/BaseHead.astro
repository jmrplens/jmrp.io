---
/**
 * BaseHead component.
 * Included in all pages to handle:
 * - Global metadata (charset, viewport)
 * - SEO tags (title, description, keywords)
 * - Open Graph and Twitter cards
 * - JSON-LD Schema.org structured data (Merged Graph)
 * - Favicons and fonts
 */
import "@styles/global.css";

import knowsAboutWikidata from "@data/knows-about-wikidata.json";
import { defaultLocale, type Locale, locales } from "@i18n/config";
import {
  getAlternateLinks,
  getOgLocale,
  stripLocalePrefix,
  type TranslationKey,
  useTranslatedPath,
  useTranslations,
} from "@i18n/utils";
import { pageLastmod } from "@src/integrations/sitemap-post-dates";
import type { SiteConfig } from "@src/types";
import { safeJsonLd } from "@utils/html";
import type { LanguageTaggedValue } from "@utils/person";
import {
  CANONICAL_ALUMNI_OF,
  CANONICAL_CREDENTIALS,
  CANONICAL_PERSON_IMAGE,
} from "@utils/person";
import {
  getMcpServers,
  getProjects,
  mcpApiId,
  softwareId,
} from "@utils/projects";
import { buildSameAs, getSiteUrl } from "@utils/site";
import { wikidataEntityUri, wikidataLabel } from "@utils/wikidata";
// Variable Fonts (managed by Astro Experimental Fonts)
import type { ImageMetadata } from "astro";
import { Font, getImage } from "astro:assets";
import { getEntry } from "astro:content";
import type {
  BreadcrumbList,
  ListItem,
  SiteNavigationElement,
  Text,
  WebSite,
} from "schema-dts";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);
const alternateLinks = getAlternateLinks(Astro.url.pathname, getSiteUrl());

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

// The canonical Person entity's name/description come from `profile/about.yaml`
// (the richest, most current identity copy) so home/about/cv never redefine
// them locally with divergent values — see CLAUDE.md GEO audit notes.
const aboutEntry = await getEntry("profile", "about");
const aboutData =
  aboutEntry?.data.type === "about" ? aboutEntry.data : undefined;

interface Props {
  title: string;
  description?: string;
  image?: string | ImageMetadata;
  type?: string;
  noIndex?: boolean;
  // Article specific props
  publishDate?: Date;
  modifiedDate?: Date;
  authors?: string[]; // Defaults to siteData.author
  tags?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[]; // Custom JSON-LD schema to merge or override
}

const canonicalURL = new URL(Astro.url.pathname, getSiteUrl());

const {
  title,
  description = t("seo.siteDescription"),
  image,
  type = "website",
  noIndex = false,
  publishDate,
  modifiedDate,
  authors = [siteData.author],
  tags = [],
  schema,
} = Astro.props;

const siteTitle = t("seo.siteTitle");
const fullTitle = (() => {
  if (title === siteTitle) return title;
  const suffix = siteData.author;
  const shortSuffix = "JMRP";

  if (`${title} | ${suffix}`.length <= 65) {
    return `${title} | ${suffix}`;
  }
  if (`${title} | ${shortSuffix}`.length <= 65) {
    return `${title} | ${shortSuffix}`;
  }
  return title;
})();

// og:image:alt / twitter:image:alt — append the author only when the title
// doesn't already include it (e.g. the homepage title IS "Name | Job Title"),
// otherwise the alt text repeats the name twice ("Name | Job Title - Name").
const imageAlt = title.includes(siteData.author)
  ? title
  : `${title} - ${siteData.author}`;

// Image resolution logic
let resolvedImage;
if (image) {
  // If props provide an image
  if (typeof image === "string") {
    // Resolve image URL against the site URL for consistent absolute URLs
    resolvedImage = new URL(image, getSiteUrl());
  } else {
    // It's an imported Image object passed via props
    // Optimize it for OG/Twitter (Standard 1200x630, WebP for efficiency)
    const optimizedImage = await getImage({
      src: image,
      format: "webp",
      width: 1200,
      height: 630,
    });
    resolvedImage = new URL(optimizedImage.src, getSiteUrl());
  }
} else {
  // Per-route generated OG image (1200×630 branded PNG).
  // Derive the slug from the FULL pathname, locale included, so each locale
  // gets its own translated card (`/es/…` → `/og/es/…png`). Mirrors the slugs
  // enumerated in src/pages/og/[...slug].png.ts. Falls through to the Lab
  // default image only for routes not enumerated there.
  const cleanPath = Astro.url.pathname.replaceAll(/^\/|\/$/g, ""); // strip / edges
  const ogSlug = cleanPath || "home";
  resolvedImage = new URL(`/og/${ogSlug}.png`, getSiteUrl());
}

/** Derive MIME type from the resolved image URL extension. */
const ogImageMime = (() => {
  const ext = resolvedImage.pathname.split(".").pop()?.toLowerCase();
  const mimeMap: Record<string, string> = {
    webp: "image/webp",
    png: "image/png",
    jpg: "image/jpeg",
    jpeg: "image/jpeg",
    gif: "image/gif",
    avif: "image/avif",
    svg: "image/svg+xml",
  };
  return mimeMap[ext ?? ""] ?? "image/webp";
})();

// --- Schema.org Construction ---

// Canonical site root WITH trailing slash, so entity @id/url/item values match
// the page canonical form (avoids fragmenting the entity graph).
const siteRoot = new URL("/", getSiteUrl()).href;

// Machine-readable ORCID identifier for the Person, derived from sameAs.
// Matched on the parsed hostname, not a substring: `url.includes("orcid.org")`
// would also accept `https://evil.example/?ref=orcid.org`
// (CodeQL js/incomplete-url-substring-sanitization). Kept identical to the
// same helper in scripts/ci/build-identity.mjs so both Person nodes agree.
const isOrcidUrl = (value: string): boolean => {
  try {
    const { hostname } = new URL(value);
    return hostname === "orcid.org" || hostname === "www.orcid.org";
  } catch {
    return false;
  }
};
const orcidUrl = siteData.person?.sameAs?.find(isOrcidUrl);
const orcidId = /orcid\.org\/([\dX-]+)/i.exec(orcidUrl ?? "")?.[1];

// --- Canonical Person entity (single source, referenced by @id everywhere) ---
// `jobTitle`/`description` are sourced from the richest, most current copy
// (profile/about.yaml) with a non-localized fallback in site.yaml. Page
// builders (Home/About/CV/GitHub) must reference `{"@id": "#person"}` or add
// ADDITIVE properties only (alumniOf, hasOccupation, hasCredential) — they
// must never redefine name/jobTitle/description/image/knowsAbout locally.
/**
 * Turns an `{ en, es }` pair into JSON-LD language-tagged values.
 *
 * The canonical `#person` node is locale-neutral: it carries ONE `@id`, so it
 * must not change its `jobTitle` depending on which page a consumer crawled.
 * It used to do exactly that — emitting an untagged string picked by `locale`,
 * which left the same entity holding two contradictory titles across the site.
 * Tagged values let both be true at once.
 *
 * English first so a consumer that ignores language tags and takes the first
 * entry still reads what this node published before it went bilingual.
 *
 * Mirrors `localizedValues` in `scripts/ci/build-identity.mjs`; the
 * schema-validation spec deep-compares the two, so drift fails CI.
 */
// `schema-dts` models every Text-valued property as a bare `string`, so it
// rejects language-tagged literals even though they are core JSON-LD 1.1
// (§4.2.4) and plain RDF. `Multilingual<Text>` is the named widening for
// exactly that gap; the single cast lives here rather than at each call site,
// so the three per-language properties below stay ordinarily typed.
const localizedValues = (pair: { en: string; es: string }) =>
  [
    { "@value": pair.en, "@language": "en" },
    { "@value": pair.es, "@language": "es" },
    // `satisfies` first, so the literal is still checked against the shape it
    // claims to be; the cast then narrows it to what schema-dts will accept.
  ] satisfies LanguageTaggedValue[] as unknown as Text;

const personJobTitle = aboutData?.person.jobTitle
  ? localizedValues(aboutData.person.jobTitle)
  : (siteData.person?.jobTitle ?? siteData.jobTitle ?? t("seo.jobTitle"));
const personDescription = aboutData?.person.description
  ? localizedValues(aboutData.person.description)
  : t("pages.cv.schemaDescription");

/**
 * The open-source software this Person authors, as bare `@id` references to
 * the `#software` nodes fully described on /projects/ (and, for most of them,
 * on the project's own documentation site, which publishes the SAME @id with
 * `author: { @id: #person }`).
 *
 * schema.org defines no forward "works made by" property on Person — only the
 * reverse edge from the CreativeWork — so `owns` carries the identity-side
 * half of the relation here; see `@utils/projects` for the full rationale.
 * Emitted site-wide and reference-only: every page connects the identity to
 * the body of work without repeating the project descriptions.
 */
const personProjects = [
  ...(await getProjects()).map((project) => ({
    "@id": softwareId(project),
  })),
  // The deployed MCP endpoints are entities of their own: `[WebAPI,
  // SoftwareApplication]` nodes canonically published by mcp.jmrp.io, which
  // already point back here via `provider`/`author`. These references are
  // the missing reverse edge — from the identity, a consumer reaches the
  // running services and not just their source repositories. Derived from
  // `endpoint` in projects.yaml (mirrored in scripts/ci/build-identity.mjs;
  // the drift guards keep both in lockstep).
  ...(await getMcpServers()).map((server) => ({ "@id": mcpApiId(server) })),
];

const personKnowsAbout = siteData.person?.knowsAbout?.map((topic) => {
  const qid = (knowsAboutWikidata as Record<string, string>)[topic];
  // Wikidata's canonical entity concept URI uses a plain, non-secure scheme by
  // design — the standard Linked Data identifier, not a fetchable link.
  return qid
    ? {
        "@type": "Thing" as const,
        // The authored string stays the display label in the nav drawer; the
        // graph publishes Wikidata's own label so this `@id` cannot disagree
        // with the same `@id` emitted from posts or projects.
        name: wikidataLabel(qid, topic),
        "@id": wikidataEntityUri(qid),
      }
    : topic;
});

// 1. WebSite Schema (Global)
const websiteSchema = {
  "@type": "WebSite",
  "@id": new URL("#website", getSiteUrl()).href,
  url: siteRoot,
  name: siteData.author,
  // One `@id` is emitted from both locales, so a plain `t()` string meant the
  // EN and ES pages asserted two different, untagged `description` values —
  // and two different `inLanguage` values — for the same node. That is the
  // last surviving instance of the collision class already fixed at page
  // level. The site genuinely is bilingual, so both are declared.
  description: localizedValues({
    en: useTranslations("en")("seo.siteDescription"),
    es: useTranslations("es")("seo.siteDescription"),
  }),
  inLanguage: ["en", "es"],
  publisher: {
    "@type": "Person",
    "@id": new URL("#person", getSiteUrl()).href,
    name: siteData.author,
    ...(siteData.person?.alternateName && {
      alternateName: siteData.person.alternateName,
    }),
    jobTitle: personJobTitle,
    description: personDescription,
    ...(aboutData?.person.email && { email: aboutData.person.email }),
    url: siteRoot,
    // /about/ emits `ProfilePage.mainEntity → #person`; this is the inverse
    // half of that pair. A plain URL rather than the `#profile` node id, so
    // the downstream sites that splice this node into a graph without that
    // node do not inherit a dangling reference. Unprefixed on purpose: the
    // entity is locale-neutral, like `#person` and `#website`.
    mainEntityOfPage: new URL("/about/", getSiteUrl()).href,
    image: {
      "@type": "ImageObject",
      url: new URL(CANONICAL_PERSON_IMAGE.path, getSiteUrl()).href,
      // Numeric, not a quoted string: schema.org types MediaObject
      // width/height as Distance | QuantitativeValue, never Text, so "460" was
      // simply the wrong datatype. E37 is the UN/CEFACT code for "pixel".
      width: {
        "@type": "QuantitativeValue",
        value: CANONICAL_PERSON_IMAGE.width,
        unitCode: "E37",
      },
      height: {
        "@type": "QuantitativeValue",
        value: CANONICAL_PERSON_IMAGE.height,
        unitCode: "E37",
      },
    },
    ...(siteData.person?.worksFor && {
      worksFor: {
        "@type": "Organization",
        name: siteData.person.worksFor.name,
        ...(siteData.person.worksFor.url && {
          url: siteData.person.worksFor.url,
        }),
      },
    }),
    // Education travels in the canonical node (not as a page-scoped additive
    // fact like /cv/'s certificates): a degree is a stable biographical claim
    // every consumer of this entity should receive, including the project
    // documentation sites that splice /identity/person.jsonld in verbatim.
    alumniOf: CANONICAL_ALUMNI_OF,
    hasCredential: CANONICAL_CREDENTIALS,
    // The profession, not the employer: `worksFor` reads as present tense and
    // the last role has ended, so asserting it would publish a stale employer
    // here and to every project site that splices this node in.
    ...(aboutData?.person.occupation && {
      hasOccupation: {
        "@type": "Occupation" as const,
        name: localizedValues(aboutData.person.occupation),
      },
    }),
    ...(aboutData?.person.knowsLanguage && {
      knowsLanguage: aboutData.person.knowsLanguage.map((language) => ({
        "@type": "Language" as const,
        name: language.name,
        alternateName: language.code,
      })),
    }),
    ...(aboutData?.person.homeLocation && {
      homeLocation: {
        "@type": "Place" as const,
        address: {
          "@type": "PostalAddress" as const,
          addressLocality: aboutData.person.homeLocation.locality,
          addressRegion: aboutData.person.homeLocation.region,
          addressCountry: aboutData.person.homeLocation.country,
        },
      },
    }),
    ...(personKnowsAbout &&
      personKnowsAbout.length > 0 && {
        knowsAbout: personKnowsAbout,
      }),
    ...(personProjects.length > 0 && { owns: personProjects }),
    ...(orcidId && {
      // Array, not a bare object: the graph must be able to carry more than
      // one identifier (Wikidata Q-id when it exists) without silently
      // dropping all but the first.
      identifier: [
        {
          "@type": "PropertyValue",
          propertyID: "ORCID",
          value: orcidId,
          url: orcidUrl,
        },
      ],
    }),
    sameAs: buildSameAs(siteData.social_links, siteData.person?.sameAs),
  },
} satisfies WebSite;

// 2. Navigation Schema — use translated labels
const navLabelKeyMap: Record<string, TranslationKey> = {
  "/": "nav.home",
  "/blog/": "nav.blog",
  "/homelab/": "nav.homelab",
  "/tools/": "nav.tools",
  "/cv/": "nav.cv",
  "/publications/": "nav.publications",
  "/projects/": "nav.projects",
};
const navSchema = (siteData.nav || []).map((item): SiteNavigationElement => ({
  "@type": "SiteNavigationElement",
  name: navLabelKeyMap[item.href] ? t(navLabelKeyMap[item.href]) : item.label,
  // Localized, like the label beside it. This used to emit the raw `item.href`,
  // so Spanish pages advertised Spanish nav names pointing at English URLs
  // ("Herramientas" → /tools/) while the rendered <nav> correctly linked to
  // /es/tools/ — the schema contradicted the DOM on all 61 ES pages. Same class
  // of bug as the ES `@id` collision, in the one place that was missed.
  url: new URL(translatePath(item.href), getSiteUrl()).href,
}));

// 3. Breadcrumb Schema (Automatic)
// Drop the locale prefix: the trail for /es/about/ is home > profile, not
// home > "Es" > profile. The root item must also point at the localized
// home, otherwise the Spanish trail is rooted at the English page. In EN,
// rawSegments[0] is never equal to `locale` ("en" never appears as a URL
// segment), so this branch never activates there.
const rawSegments = Astro.url.pathname.split("/").filter(Boolean);
const pathSegments =
  rawSegments[0] === locale ? rawSegments.slice(1) : rawSegments;
/** URL segments that group children without being a page themselves. */
const STRUCTURAL_SEGMENTS = new Set(["categories", "tags"]);

const breadcrumbRoot = new URL(translatePath("/"), getSiteUrl()).href;
const breadcrumbList = {
  "@type": "BreadcrumbList",
  // Page-scoped @id so each page's breadcrumb trail is a distinct graph node
  // (a single site-wide id would collapse different trails into one).
  "@id": `${new URL(Astro.url.pathname, getSiteUrl()).href}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t("nav.home"),
      item: breadcrumbRoot,
    },
    // Structural URL segments that group children but are not pages of their
    // own: /tools/categories/ and /blog/tags/ both answer 403. Emitting them
    // as ListItems put an unreachable URL inside the trail, and Google treats
    // a BreadcrumbList whose `item` does not resolve as invalid — which
    // silently voided the breadcrumb on the ten indexable category pages
    // (the 28 tag pages are noindex, so those cost nothing).
    // GEO audit 2026-08-22, A6. Collapsing the level is the right fix rather
    // than publishing an index there: the children it would link to are
    // themselves noindex.
    ...pathSegments
      .map((segment, index) => ({ segment, index }))
      .filter(({ segment, index }) => {
        const isLastSegment = index === pathSegments.length - 1;
        return isLastSegment || !STRUCTURAL_SEGMENTS.has(segment);
      })
      .map(({ segment, index }, position): ListItem => {
        const path = translatePath(
          `/${pathSegments.slice(0, index + 1).join("/")}/`,
        );
        const isLastSegment = index === pathSegments.length - 1;
        const absoluteUrl = new URL(path, getSiteUrl()).href;

        // Prefer page title for the last segment if available
        const fallbackName = segment
          .replaceAll("-", " ")
          .replaceAll(/\b\w/g, (l) => l.toUpperCase());
        const name =
          isLastSegment && title && title !== siteData.title
            ? title
            : fallbackName;

        return {
          "@type": "ListItem",
          // Positions must stay contiguous after a segment is dropped, so this
          // counts emitted items rather than reusing the path index.
          position: position + 2,
          name: name,
          item: absoluteUrl,
        };
      }),
  ],
} satisfies BreadcrumbList;

// Minimal in-document definitions for the MCP `#api` nodes that `owns`
// references above. mcp.jmrp.io stays the canonical describer — it publishes
// the full node with name, bilingual description, documentation and
// isBasedOn — but a consumer that resolves the graph per document (which is
// what Google and most parsers do) only saw a bare `@id` here: the sole two
// unresolvable references across all 126 pages (GEO audit 2026-08-22, A5).
//
// Deliberately limited to facts that cannot contradict the canonical node:
// its type, its URL and its provider. In particular NO `name` — the canonical
// node is named after the endpoint path ("libgen"), while projects.yaml calls
// the project "libgen-mcp", and emitting both under one @id would create
// exactly the cross-locale collision this audit flagged elsewhere.
const mcpApiNodes = (await getMcpServers()).map((server) => ({
  "@type": ["WebAPI", "SoftwareApplication"],
  "@id": mcpApiId(server),
  url: server.endpoint,
  provider: { "@id": new URL("#person", getSiteUrl()).href },
}));

// 4. Merge Logic
// We use a @graph to include multiple items (Website, Page, Breadcrumbs, etc.)
let schemaGraph = [
  websiteSchema,
  ...navSchema,
  breadcrumbList,
  ...(mcpApiNodes as unknown as (typeof breadcrumbList)[]),
];

if (schema) {
  // Use type assertion to bypass strict checking since schema is externally provided
  if (Array.isArray(schema)) {
    schemaGraph = [
      ...schemaGraph,
      ...(schema as unknown as (typeof schemaGraph)[number][]),
    ];
  } else {
    schemaGraph.push(schema as unknown as (typeof schemaGraph)[number]);
  }
}

// `dateModified` on the node that describes THIS page.
//
// 36 indexable pages — every collection and plain WebPage — carried no
// `dateModified` even though the sitemap already published a content-derived
// `<lastmod>` for them (GEO audit 2026-08-22, M8). Posts, tools and the
// ProfilePages set their own, so this only fills the gap; a node that already
// declares one is never touched.
//
// The date comes from the same resolver the sitemap uses, so the two can never
// disagree. `modifiedDate` passed by the page still wins.
const pagePath = stripLocalePrefix(Astro.url.pathname) || "/";
const resolvedModified =
  modifiedDate?.toISOString() ?? pageLastmod(pagePath) ?? undefined;

if (resolvedModified) {
  for (const node of schemaGraph) {
    const candidate = node as unknown as Record<string, unknown>;
    if (candidate.url === canonicalURL.href && !candidate.dateModified) {
      candidate.dateModified = resolvedModified;
    }
  }
}

const jsonLD = {
  "@context": "https://schema.org",
  "@graph": schemaGraph,
};
---

<!-- Global Metadata -->
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
/>

<!-- Font Preloads (Managed by Astro) — only the above-the-fold critical weights -->
<Font
  cssVariable="--font-ibm-plex-sans"
  preload={[{ weight: "400", style: "normal" }]}
/>
<Font
  cssVariable="--font-space-grotesk"
  preload={[{ weight: "700", style: "normal" }]}
/>
<Font
  cssVariable="--font-ibm-plex-mono"
  preload={[{ weight: "500", style: "normal" }]}
/>

{
  /*
  Favicon set, ordered and typed for BOTH audiences.

  Search engines are the constraint here, not browsers. They read these tags
  and mostly understand two formats — ICO and PNG — so the `.ico` is declared
  first and explicitly: it was always served at the root, but nothing in the
  markup pointed at it, and a crawler that trusts the declarations over the
  `/favicon.ico` convention only ever saw formats it could not decode. The
  WebP entry that used to sit here was exactly that trap: no search engine
  accepts a WebP favicon.

  Sizes are declared so a consumer can choose without downloading each file,
  and the PNGs are the stable, unhashed files from `public/` rather than
  `getImage()` output: a favicon URL that moves when an asset hash changes is
  a favicon a crawler may re-fetch into a 404. 48×48 is there because Google
  documents a multiple of 48 as its minimum.

  The SVG stays for browsers that prefer it (it is the animated one); ICO and
  PNG cover everything that is not a browser. Chromium scores `sizes="any"`
  as "scalable" and would pick the ICO over the SVG if the ICO carried it, so
  the ICO is pinned to `32x32` and `any` goes on the SVG instead.
*/
}
<link
  rel="icon"
  href="/favicon.ico"
  sizes="32x32"
/>
<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon.svg"
  sizes="any"
/>
<link
  rel="icon"
  type="image/png"
  sizes="48x48"
  href="/favicon-48x48.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="32x32"
  href="/favicon-32x32.png"
/>
<link
  rel="apple-touch-icon"
  href="/apple-touch-icon.png"
/>
<link
  rel="manifest"
  href={locale === defaultLocale
    ? "/site.webmanifest"
    : `/${locale}/site.webmanifest`}
/>
<link
  rel="sitemap"
  href="/sitemap-index.xml"
/>
<link
  rel="alternate"
  type="application/rss+xml"
  title={t("seo.rssFeedTitle")}
  href={locale === defaultLocale ? "/rss.xml" : `/${locale}/rss.xml`}
/>
{/* RSS feed for alternate locale */}
{
  locales
    .filter((l) => l !== locale)
    .map((l) => {
      const altT = useTranslations(l);
      return (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={altT("seo.rssFeedTitle")}
          href={l === defaultLocale ? "/rss.xml" : `/${l}/rss.xml`}
        />
      );
    })
}
{
  /* Canonical identity document — the same #person node BaseHead renders inline,
    exposed as a standalone, machine-readable JSON-LD file for direct fetch. */
}
<link
  rel="alternate"
  type="application/ld+json"
  href="/identity/person.jsonld"
  title="Person entity (JSON-LD)"
/>
{
  /* llms.txt discovery. robots.txt already points at these files, but only as
    comments, which nothing parses. Declaring them here means a client that
    fetched the page — rather than the robots file — can still find the AI
    context index without guessing the well-known path. */
}
<link
  rel="alternate"
  type="text/plain"
  href="/llms.txt"
  title="LLM context index (llmstxt.org)"
/>
<meta
  name="generator"
  content={Astro.generator}
/>
{/* Dark-first theme-color; light override follows the OS preference */}
<meta
  name="theme-color"
  content={siteData.theme_color}
  media="(prefers-color-scheme: dark)"
/>
<meta
  name="theme-color"
  content="#fafaf7"
  media="(prefers-color-scheme: light)"
/>
<!--
  max-snippet:-1 / max-image-preview:large lift the default caps on how much
  of a page a search engine may quote and how large a preview image it may
  show. For a site whose whole posture is "please quote me", the conservative
  defaults work against the goal. They are omitted on noindex pages, where
  they would be meaningless.
-->
<meta
  name="robots"
  content={noIndex
    ? "noindex, follow"
    : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
/>

<!-- SEO -->
<meta
  name="keywords"
  content={t("seo.siteKeywords")}
/>
<meta
  name="author"
  content={siteData.author}
/>
<meta
  name="fediverse:creator"
  content={siteData.fediverse_creator}
/>

<link
  rel="canonical"
  href={canonicalURL}
/>

<!-- Hreflang alternates -->
{
  alternateLinks.map((alt) => (
    <link
      rel="alternate"
      hreflang={alt.hreflang}
      href={alt.url}
    />
  ))
}

<!-- Social Verification (rel="me" for identity verification) -->
{
  siteData.social_links?.map((link) => (
    <link
      rel="me"
      href={link.url}
    />
  ))
}

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta
  name="title"
  content={title}
/>
<meta
  name="description"
  content={description}
/>

<!-- Open Graph / Facebook -->
<meta
  property="og:type"
  content={type}
/>
<meta
  property="og:url"
  content={canonicalURL}
/>
<meta
  property="og:title"
  content={title}
/>
<meta
  property="og:description"
  content={description}
/>
<meta
  property="og:image"
  content={resolvedImage}
/>
<meta
  property="og:image:type"
  content={ogImageMime}
/>
<meta
  property="og:image:width"
  content="1200"
/>
<meta
  property="og:image:height"
  content="630"
/>
<meta
  property="og:image:alt"
  content={imageAlt}
/>
<meta
  property="og:locale"
  content={getOgLocale(locale)}
/>
{
  alternateLinks
    .filter((alt) => alt.locale !== "x-default" && alt.locale !== locale)
    .map((alt) => (
      <meta
        property="og:locale:alternate"
        content={getOgLocale(alt.locale as Locale)}
      />
    ))
}
<meta
  property="og:site_name"
  content={siteData.author}
/>

<!-- Article Specific OG Tags -->
{
  type === "article" && (
    <>
      {publishDate && (
        <meta
          property="article:published_time"
          content={publishDate.toISOString()}
        />
      )}
      {modifiedDate && (
        <meta
          property="article:modified_time"
          content={modifiedDate.toISOString()}
        />
      )}
      {authors.map((author) => (
        <meta
          property="article:author"
          content={author}
        />
      ))}
      {tags.map((tag) => (
        <meta
          property="article:tag"
          content={tag}
        />
      ))}
    </>
  )
}

<!-- Twitter -->
<meta
  name="twitter:card"
  content="summary_large_image"
/>
<meta
  name="twitter:site"
  content={siteData.twitter_creator}
/>
<meta
  name="twitter:creator"
  content={siteData.twitter_creator}
/>
<meta
  name="twitter:url"
  content={canonicalURL}
/>
<meta
  name="twitter:title"
  content={title}
/>
<meta
  name="twitter:description"
  content={description}
/>
<meta
  name="twitter:image"
  content={resolvedImage}
/>
<meta
  name="twitter:image:alt"
  content={imageAlt}
/>

<!-- Cloudflare Web Analytics (Static with SRI) -->
{
  import.meta.env.PROD && import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
    <script
      is:inline
      defer
      src="/scripts/cf-beacon.js"
      data-cf-beacon={JSON.stringify({
        token: import.meta.env.PUBLIC_CF_BEACON_TOKEN,
      })}
      crossorigin="anonymous"
    />
  )
}

<!-- JSON-LD -->
<script
  is:inline
  type="application/ld+json"
  set:html={safeJsonLd(jsonLD)}
/>
