---
/**
 * LanguageDetector Component
 *
 * Client-side script that detects the user's browser language on first visit
 * and redirects to the Spanish version if appropriate.
 *
 * Rules:
 * 1. Only triggers on pages without locale prefix (EN pages)
 * 2. Only redirects if user has NOT manually chosen a language before
 * 3. Checks `navigator.languages` / `navigator.language` for `es*`
 * 4. Falls back to `Intl.DateTimeFormat` locale (Safari iOS reliability)
 * 5. Stores preference in `localStorage` to avoid repeated redirects
 * 6. Does NOT redirect during View Transitions (astro:before-swap)
 *
 * To be included in BaseLayout.astro (runs once per page load).
 */
---

<script>
  // Renamed from "preferred-lang" deliberately. Every browser that used the
  // switcher from an English page holds a value under the old key that records
  // the OPPOSITE of what was chosen (see markLanguageChoice below), and that
  // wrong value permanently disabled the redirect. Fixing the writer does not
  // un-break a reader that already has one stored, so the key changes once and
  // the bad values are simply never read again.
  const LANG_KEY = "lang-choice";
  const REDIRECT_DONE_KEY = "lang-redirect-done";

  function detectAndRedirect() {
    // An explicit choice of English is final; a stored "es" is not a reason to
    // stop, it is a reason to redirect. The previous version bailed out on ANY
    // stored value, so choosing Spanish and choosing English did the same
    // thing — nothing — and the preference was write-only.
    const stored = localStorage.getItem(LANG_KEY);
    if (stored === "en") return;

    // Skip if we already redirected once this session
    if (sessionStorage.getItem(REDIRECT_DONE_KEY)) return;

    // Only redirect on default locale (EN) pages — paths without /es/ prefix
    const path = window.location.pathname;
    if (path.startsWith("/es/") || path === "/es") return;

    // A stored choice of Spanish decides it outright; the browser is only
    // consulted when the reader has never said.
    const langs = navigator.languages
      ? Array.from(navigator.languages)
      : [navigator.language];
    let prefersSpanish =
      stored === "es" ||
      langs.some((lang) => lang.toLowerCase().startsWith("es"));

    // Fallback: Intl.DateTimeFormat resolvedOptions (reliable on Safari iOS)
    if (!prefersSpanish) {
      try {
        const intlLocale = Intl.DateTimeFormat().resolvedOptions().locale;
        if (intlLocale.toLowerCase().startsWith("es")) {
          prefersSpanish = true;
        }
      } catch {
        // Intl not available — ignore
      }
    }

    if (prefersSpanish) {
      // Mark that we've done the redirect to avoid loops
      sessionStorage.setItem(REDIRECT_DONE_KEY, "1");

      // Build the Spanish URL preserving the current path
      const esPath = `/es${path}`;
      window.location.replace(esPath);
    }
  }

  /**
   * Mark that the user has manually chosen a language.
   * Called by the LanguageSwitcher when clicked.
   */
  function markLanguageChoice(targetPath?: string) {
    // The path being GONE TO, not the one being left. This ran on the click
    // handler, before navigation, so `window.location.pathname` was still the
    // current page: clicking "ES" from an English page stored "en" — the exact
    // opposite of the choice — and that value then switched the automatic
    // redirect off for good. The argument is the anchor's own pathname; the
    // fallback only exists for a caller that has none.
    const path = targetPath ?? window.location.pathname;
    const isSpanish = path.startsWith("/es/") || path === "/es";
    localStorage.setItem(LANG_KEY, isSpanish ? "es" : "en");
  }

  // Expose globally so LanguageSwitcher can call it
  (window as any).__markLanguageChoice = markLanguageChoice;

  // Run on initial page load (not on View Transitions)
  detectAndRedirect();
</script>
