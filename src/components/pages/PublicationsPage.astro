---
/**
 * Publications Page shared component.
 * Lists academic publications stored in BibTeX format.
 */
import PublicationItem from "@components/publications/PublicationItem.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { stripHtml } from "@utils/html";
import {
  getPublicationKind,
  getPublications,
  PUBLICATION_KIND_LABEL_KEY,
  stripTrailingPunctuation,
} from "@utils/publications";
import { getAbsoluteUrl, getSiteUrl } from "@utils/site";
import { getEntry } from "astro:content";
import type { CollectionPage, ListItem } from "schema-dts";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const socialsEntry = await getEntry("site_config", "socials");
const orcidId =
  socialsEntry?.data && "orcid_id" in socialsEntry.data
    ? socialsEntry.data.orcid_id
    : undefined;
const orcidUrl = orcidId ? `https://orcid.org/${orcidId}` : undefined;

const publicationGroups = await getPublications(locale);

const allPublications = publicationGroups.flatMap((group) => group.items);

// --- Type counts (shared by the stats band + the sidebar filter) ---------
const typeCounts = new Map<string, number>();
for (const pub of allPublications) {
  const kind = getPublicationKind(pub.type);
  typeCounts.set(kind, (typeCounts.get(kind) ?? 0) + 1);
}

// --- Headline stats ------------------------------------------------------
// All four figures are counted from the source dataset. Citation counts and the
// h-index would need an external source (OpenAlex/Scholar) the site does not
// ingest yet, so they are intentionally omitted rather than shown as blanks.
const coauthorsEntry = await getEntry("publications_data", "coauthors");
const coauthorsCount = Object.keys(coauthorsEntry?.data ?? {}).length;

const stats = [
  {
    value: String(allPublications.length),
    label: t("pages.publications.statPublications"),
  },
  {
    value: String(typeCounts.get("journal") ?? 0),
    label: t("pages.publications.statJournals"),
  },
  {
    value: String(typeCounts.get("conference") ?? 0),
    label: t("pages.publications.statConferences"),
  },
  {
    value: String(coauthorsCount),
    label: t("pages.publications.statCoauthors"),
  },
];

// --- Type filter (sidebar) ----------------------------------------------
const typeFilters = [...typeCounts].map(([kind, count]) => ({
  kind,
  label: t(
    PUBLICATION_KIND_LABEL_KEY[kind as keyof typeof PUBLICATION_KIND_LABEL_KEY],
  ),
  count,
}));

// --- Group by publication year (newest first) ----------------------------
const yearOf = (pub: (typeof allPublications)[number]): number =>
  pub.issued?.["date-parts"]?.[0]?.[0] ?? 0;

const byYear = new Map<number, typeof allPublications>();
for (const pub of allPublications) {
  const year = yearOf(pub);
  const bucket = byYear.get(year);
  if (bucket) bucket.push(pub);
  else byYear.set(year, [pub]);
}
const yearGroups = [...byYear].sort((a, b) => b[0] - a[0]);

/**
 * Builds the most precise ISO date the BibTeX entry supports:
 * `YYYY-MM-DD` / `YYYY-MM` / `YYYY` depending on the `date-parts` available.
 */
const formatIssuedDate = (issued?: {
  "date-parts": number[][];
}): string | undefined => {
  const parts = issued?.["date-parts"]?.[0];
  if (!parts?.[0]) return undefined;
  const [year, month, day] = parts;
  const pad = (n: number) => String(n).padStart(2, "0");
  if (month && day) return `${year}-${pad(month)}-${pad(day)}`;
  if (month) return `${year}-${pad(month)}`;
  return String(year);
};

/** Resolves a bare DOI (e.g. `10.1000/xyz`) to its `https://doi.org/` URL, or passes an already-absolute DOI URL through unchanged. */
const toDoiUrl = (doi: string): string =>
  doi.startsWith("http") ? doi : `https://doi.org/${doi}`;

/** Resolves a BibTeX `url`/`pdf` field (site-relative path or already-absolute URL) to an absolute URL. */
const toAbsoluteUrl = (value: string): string =>
  value.startsWith("http") ? value : getAbsoluteUrl(value);

const siteOrigin = new URL(getSiteUrl()).origin;

/** True when an already-absolute URL points somewhere other than this site. */
const isOffSite = (url: string): boolean => new URL(url).origin !== siteOrigin;

// `@context` omitted: merged into the page-level @graph (BaseLayout) which
// already declares the context.
const collectionUrl = new URL(Astro.url.pathname, getSiteUrl()).href;

const collectionSchema = {
  "@type": "CollectionPage",
  "@id": `${collectionUrl}#collection`,
  name: t("pages.publications.title"),
  description: t("pages.publications.schemaDescription"),
  url: collectionUrl,
  inLanguage: locale,
  isPartOf: { "@id": new URL("#website", getSiteUrl()).href },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: allPublications.length,
    itemListElement: allPublications.map((pub, index): ListItem => {
      // citation-js exposes CSL-JSON fields in their canonical (uppercase)
      // casing — `DOI`/`URL`/`ISBN`, not `doi`/`url`/`isbn`. 13 of the 14
      // entries in papers.bib carry a Zenodo *concept* DOI, which always
      // resolves to the latest version of the deposit rather than pinning one
      // immutable file. `escartiECSSMET2021` has no deposit and carries no
      // `url`/`pdf` either, so it is the one entry whose node has no `url` at
      // all — title, authors and venue are all that identify it.
      const doi = typeof pub.DOI === "string" ? pub.DOI : undefined;
      const doiUrl = doi ? toDoiUrl(doi) : undefined;
      const pubUrl =
        typeof pub.URL === "string" ? toAbsoluteUrl(pub.URL) : undefined;
      const pdfPath = typeof pub.pdf === "string" ? pub.pdf : undefined;
      const pdfUrl = pdfPath ? toAbsoluteUrl(pdfPath) : undefined;
      const isbn = typeof pub.ISBN === "string" ? pub.ISBN : undefined;
      const resolvedUrl = doiUrl ?? pubUrl ?? pdfUrl;
      // `url` can only carry one address, so the DOI wins it. Any other
      // off-site landing page for the same work stays discoverable through
      // `sameAs` instead of being dropped. What is excluded is the locally
      // hosted PDF — that is the file itself, not a reference page
      // identifying the work — whichever BibTeX field it arrived in.
      // `ramis2018aprendizaje` is why both fields are checked: its handle
      // (hdl.handle.net) lives in `pdf`, not `url`.
      const landingPages = [pubUrl, pdfUrl].filter(
        (u): u is string => u !== undefined && isOffSite(u),
      );
      const sameAs = [
        ...new Set([...(doiUrl ? [doiUrl] : []), ...landingPages]),
      ];
      const identifiers = [
        ...(doi
          ? [
              {
                "@type": "PropertyValue" as const,
                propertyID: "DOI",
                value: doi,
              },
            ]
          : []),
        ...(isbn
          ? [
              {
                "@type": "PropertyValue" as const,
                propertyID: "ISBN",
                value: isbn,
              },
            ]
          : []),
      ];

      return {
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "ScholarlyArticle",
          "@id": `${collectionUrl}#pub-${pub.id}`,
          headline: pub.title,
          name: pub.title,
          datePublished: formatIssuedDate(pub.issued),
          author:
            pub.author?.map((a: { family: string; given?: string }) => ({
              "@type": "Person",
              // Link the site owner's own author node to the canonical #person
              // entity. Match the full surname "Requena-Plens"/"Requena Plens"
              // (not a bare "Requena") so a co-author is never mis-attributed.
              ...(/requena[\s-]?plens/i.test(a.family) && {
                "@id": new URL("#person", getSiteUrl()).href,
              }),
              ...(a.given && { givenName: a.given }),
              familyName: a.family,
              name: a.given ? `${a.given} ${a.family}` : a.family,
            })) || [],
          // Schema.org: an article `isPartOf` its venue. A journal is a
          // Periodical; conference proceedings are a CreativeWork (Periodical
          // would wrongly imply a recurring magazine). Standalone works
          // (theses/reports) have no journal/proceedings parent, so omit it.
          ...(() => {
            const venue = stripTrailingPunctuation(
              String(pub["container-title"] || pub.publisher || ""),
            ).trim();
            const isJournal = [
              "article-journal",
              "article",
              "article-magazine",
            ].includes(pub.type);
            const isConference = pub.type === "paper-conference";
            if (!venue || (!isJournal && !isConference)) return {};
            return {
              isPartOf: {
                "@type": isJournal ? "Periodical" : "CreativeWork",
                name: venue,
              },
            };
          })(),
          abstract:
            typeof pub.abstract === "string"
              ? stripHtml(pub.abstract)
              : undefined,
          ...(resolvedUrl && { url: resolvedUrl }),
          ...(sameAs.length > 0 && { sameAs }),
          ...(identifiers.length > 0 && { identifier: identifiers }),
        },
      };
    }),
  },
} satisfies CollectionPage;
---

<BaseLayout
  title={t("pages.publications.title")}
  description={t("pages.publications.description")}
  schema={collectionSchema}
>
  <div class="container">
    <header class="pub-header">
      <div
        class="lab-grid"
        aria-hidden="true"
      >
      </div>
      <p class="section-title">{t("pages.publications.kicker")}</p>
      <h1 class="pub-page-title">{t("pages.publications.title")}</h1>
      <p class="pub-subtitle">{t("pages.publications.description")}</p>
      <p class="pub-period-note">
        {t("pages.publications.periodNote")}
        {
          orcidUrl && (
            <a
              href={orcidUrl}
              class="pub-orcid-link"
              rel="external noopener noreferrer"
              target="_blank"
              aria-label={t("aria.visitProfile", { name: "ORCID" })}
            >
              <span
                class="i-simple-icons:orcid pub-orcid-link__icon"
                aria-hidden="true"
              />
              {t("pages.publications.orcidLink")}
            </a>
          )
        }
      </p>
      <div class="pub-stats">
        {
          stats.map((stat) => (
            <div class="pub-stat">
              <p class="pub-stat__value">{stat.value}</p>
              <p class="pub-stat__label">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </header>

    <div class="pub-layout">
      <aside class="pub-sidebar">
        <nav
          class="pub-filter"
          aria-label={t("pages.publications.filterType")}
          data-pub-filter
        >
          <p class="pub-filter__label">{t("pages.publications.filterType")}</p>
          <button
            type="button"
            class="pub-filter__pill is-active"
            data-kind=""
          >
            {t("pages.publications.filterAll")} · {allPublications.length}
          </button>
          {
            typeFilters.map((f) => (
              <button
                type="button"
                class="pub-filter__pill"
                data-kind={f.kind}
              >
                {f.label} · {f.count}
              </button>
            ))
          }
        </nav>
        <div class="pub-export">
          <p class="pub-filter__label">{t("pages.publications.export")}</p>
          <a
            class="pub-export__btn"
            href="/publications.bib"
            download
          >
            <span
              class="i-mdi:download pub-export__icon"
              aria-hidden="true"
            ></span>
            {t("pages.publications.exportBibtex")}
          </a>
        </div>
      </aside>

      <div class="pub-main">
        {
          yearGroups.map(([year, items]) => (
            <section
              class="pub-year-group"
              aria-label={String(year)}
              data-pub-year
            >
              <h2 class="pub-year-group__title">{year}</h2>
              <div class="publications-list">
                {items.map((pub) => (
                  <PublicationItem pub={pub} />
                ))}
              </div>
            </section>
          ))
        }
        <p
          class="pub-empty"
          hidden
          data-pub-empty
        >
          {t("pages.blog.noResults")}
        </p>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const filter = document.querySelector("[data-pub-filter]");
      const items = Array.prototype.slice.call(
        document.querySelectorAll("[data-pub-type]"),
      );
      const years = Array.prototype.slice.call(
        document.querySelectorAll("[data-pub-year]"),
      );
      const empty = document.querySelector("[data-pub-empty]");
      if (!filter) return;

      filter.addEventListener("click", function (e) {
        const pill = e.target.closest("[data-kind]");
        if (!pill) return;
        const kind = pill.getAttribute("data-kind") || "";
        filter.querySelectorAll(".pub-filter__pill").forEach(function (p) {
          p.classList.toggle("is-active", p === pill);
        });
        let visible = 0;
        items.forEach(function (item) {
          const show = !kind || item.getAttribute("data-pub-type") === kind;
          item.hidden = !show;
          if (show) visible++;
        });
        years.forEach(function (group) {
          const anyVisible = group.querySelector(
            "[data-pub-type]:not([hidden])",
          );
          group.hidden = !anyVisible;
        });
        if (empty) empty.hidden = visible > 0;
      });
    })();
  </script>
</BaseLayout>

<script>
  let publicationsInitialized = false;

  function initPublications() {
    if (publicationsInitialized) return;
    publicationsInitialized = true;

    const handleAbstracts = (selector: string, idPrefix: string) => {
      document.querySelectorAll(selector).forEach((btn) => {
        (btn as HTMLElement).onclick = (e) => {
          e.preventDefault();
          const target = e.currentTarget as HTMLElement;
          const id = target.dataset.id;
          const element = document.getElementById(`${idPrefix}-${id}`);
          if (element) {
            const isHidden = element.classList.toggle("hidden");
            target.setAttribute("aria-expanded", String(!isHidden));
          }
        };
      });
    };

    handleAbstracts(".btn-abstract", "abstract");
    handleAbstracts(".btn-bibtex-toggle", "bibtex");
  }

  document.addEventListener("astro:before-swap", () => {
    publicationsInitialized = false;
  });

  document.addEventListener("astro:page-load", initPublications);
  document.addEventListener("DOMContentLoaded", initPublications);
</script>

<style>
  /* Lab hero: mono kicker + display title over an ambient hairline grid. */
  .pub-header {
    position: relative;
    padding: var(--space-lg) 0 var(--space-md);
    margin-bottom: var(--space-xl);
    overflow: hidden;
  }

  .pub-header .section-title {
    position: relative;
    margin-bottom: var(--space-sm);
  }

  .pub-page-title {
    position: relative;
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
  }

  .pub-subtitle {
    position: relative;
    max-width: var(--max-width-prose);
    margin: 0 0 var(--space-lg);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .pub-period-note {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
    max-width: var(--max-width-prose);
    margin: calc(-1 * var(--space-md)) 0 var(--space-lg);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .pub-orcid-link {
    display: inline-flex;
    gap: 0.35em;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    white-space: nowrap;
    text-decoration: none;
  }

  .pub-orcid-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pub-orcid-link__icon {
    font-size: 1.1em;
  }

  /* Headline stats band */
  .pub-stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, max-content));
    width: fit-content;
    max-width: 100%;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .pub-stat {
    padding: 16px 26px;
    border-right: 1px solid var(--color-border);
  }

  .pub-stat:last-child {
    border-right: 0;
  }

  .pub-stat__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--fw-bold);
    line-height: 1;
    color: var(--color-text-heading);
  }

  .pub-stat__label {
    margin: 7px 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }

  /* Sidebar + main two-column layout */
  .pub-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .pub-sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--space-md));
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .pub-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .pub-filter__label {
    width: 100%;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .pub-filter__pill {
    width: 100%;
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-text);
    text-align: left;
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition:
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .pub-filter__pill:hover {
    border-color: var(--color-accent);
  }

  .pub-filter__pill.is-active {
    font-weight: var(--fw-medium);
    color: var(--color-on-primary);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .pub-filter__pill:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .pub-export__btn {
    display: flex;
    gap: 0.6em;
    align-items: center;
    padding: 9px 12px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .pub-export__btn:hover {
    border-color: var(--color-accent);
  }

  .pub-export__icon {
    color: var(--color-accent);
  }

  .pub-year-group {
    margin-bottom: var(--space-lg);
  }

  /* Year label: small mono kicker with hairline rule below — matches mockup
     (display heading style replaced by the Lab system's mono-label pattern). */
  .pub-year-group__title {
    padding-bottom: 12px;
    margin: 0 0 var(--space-xs); /* 4px gap before first item */
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    letter-spacing: 0;
    border-bottom: 1px solid var(--color-hair);
  }

  .publications-list {
    display: flex;
    flex-direction: column;
  }

  .pub-empty {
    padding: var(--space-lg) 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (width <= 820px) {
    .pub-layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .pub-sidebar {
      position: static;
      top: auto;
    }

    .pub-filter {
      flex-direction: row;
    }

    .pub-filter__pill {
      width: auto;
    }

    .pub-stats {
      grid-template-columns: repeat(2, 1fr);
      width: 100%;
    }

    .pub-stat:nth-child(2) {
      border-right: 0;
    }

    .pub-stat:nth-child(-n + 2) {
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>
