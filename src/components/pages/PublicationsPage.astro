---
/**
 * Publications Page shared component.
 * Lists academic publications stored in BibTeX format.
 */
import PublicationItem from "@components/publications/PublicationItem.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { stripHtml } from "@utils/html";
import { getPublications, stripTrailingPunctuation } from "@utils/publications";
import { getSiteUrl } from "@utils/site";
import type { CollectionPage, ListItem } from "schema-dts";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const publicationGroups = await getPublications(locale);

const allPublications = publicationGroups.flatMap((group) => group.items);

/**
 * Builds the most precise ISO date the BibTeX entry supports:
 * `YYYY-MM-DD` / `YYYY-MM` / `YYYY` depending on the `date-parts` available.
 */
const formatIssuedDate = (issued?: {
  "date-parts": number[][];
}): string | undefined => {
  const parts = issued?.["date-parts"]?.[0];
  if (!parts?.[0]) return undefined;
  const [year, month, day] = parts;
  const pad = (n: number) => String(n).padStart(2, "0");
  if (month && day) return `${year}-${pad(month)}-${pad(day)}`;
  if (month) return `${year}-${pad(month)}`;
  return String(year);
};

// `@context` omitted: merged into the page-level @graph (BaseLayout) which
// already declares the context.
const collectionSchema = {
  "@type": "CollectionPage",
  "@id": new URL("#collection", new URL(Astro.url.pathname, getSiteUrl())).href,
  name: t("pages.publications.title"),
  description: t("pages.publications.schemaDescription"),
  url: new URL(Astro.url.pathname, getSiteUrl()).href,
  inLanguage: locale,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: allPublications.length,
    itemListElement: allPublications.map((pub, index): ListItem => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "ScholarlyArticle",
        headline: pub.title,
        name: pub.title,
        datePublished: formatIssuedDate(pub.issued),
        author:
          pub.author?.map((a: { family: string; given?: string }) => ({
            "@type": "Person",
            // Link the site owner's own author node to the canonical #person
            // entity. Match the full surname "Requena-Plens"/"Requena Plens"
            // (not a bare "Requena") so a co-author is never mis-attributed.
            ...(/requena[\s-]?plens/i.test(a.family) && {
              "@id": new URL("#person", getSiteUrl()).href,
            }),
            ...(a.given && { givenName: a.given }),
            familyName: a.family,
            name: a.given ? `${a.given} ${a.family}` : a.family,
          })) || [],
        // Schema.org: an article `isPartOf` its venue. A journal is a
        // Periodical; conference proceedings are a CreativeWork (Periodical
        // would wrongly imply a recurring magazine). Standalone works
        // (theses/reports) have no journal/proceedings parent, so omit it.
        ...(() => {
          const venue = stripTrailingPunctuation(
            String(pub["container-title"] || pub.publisher || ""),
          ).trim();
          const isJournal = [
            "article-journal",
            "article",
            "article-magazine",
          ].includes(pub.type);
          const isConference = pub.type === "paper-conference";
          if (!venue || (!isJournal && !isConference)) return {};
          return {
            isPartOf: {
              "@type": isJournal ? "Periodical" : "CreativeWork",
              name: venue,
            },
          };
        })(),
        abstract:
          typeof pub.abstract === "string"
            ? stripHtml(pub.abstract)
            : undefined,
        ...(() => {
          const doi = typeof pub.doi === "string" ? pub.doi : undefined;
          let doiUrl: string | undefined;
          if (doi) {
            doiUrl = doi.startsWith("http") ? doi : `https://doi.org/${doi}`;
          }
          const pubUrl = typeof pub.url === "string" ? pub.url : undefined;
          return {
            url: pubUrl || doiUrl || undefined,
            ...(doiUrl && { sameAs: [doiUrl] }),
          };
        })(),
      },
    })),
  },
} satisfies CollectionPage;
---

<BaseLayout
  title={t("pages.publications.title")}
  description={t("pages.publications.description")}
  schema={collectionSchema}
>
  <div class="container">
    <header class="pub-header">
      <div
        class="lab-grid"
        aria-hidden="true"
      >
      </div>
      <p class="section-title">{t("pages.publications.kicker")}</p>
      <h1 class="pub-page-title">{t("pages.publications.title")}</h1>
      <p class="pub-subtitle">{t("pages.publications.description")}</p>
    </header>

    {
      publicationGroups.map((group) => (
        <section
          class="pub-section"
          aria-label={group.title}
        >
          <div class="section-header">
            <h2>{group.title}</h2>
            <span
              class="section-count"
              aria-hidden="true"
            >
              {group.items.length}
            </span>
          </div>
          <div class="publications-list">
            {group.items.map((pub) => (
              <PublicationItem pub={pub} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  let publicationsInitialized = false;

  function initPublications() {
    if (publicationsInitialized) return;
    publicationsInitialized = true;

    const handleAbstracts = (selector: string, idPrefix: string) => {
      document.querySelectorAll(selector).forEach((btn) => {
        (btn as HTMLElement).onclick = (e) => {
          e.preventDefault();
          const target = e.currentTarget as HTMLElement;
          const id = target.dataset.id;
          const element = document.getElementById(`${idPrefix}-${id}`);
          if (element) {
            const isHidden = element.classList.toggle("hidden");
            target.setAttribute("aria-expanded", String(!isHidden));
          }
        };
      });
    };

    handleAbstracts(".btn-abstract", "abstract");
    handleAbstracts(".btn-bibtex-toggle", "bibtex");
  }

  document.addEventListener("astro:before-swap", () => {
    publicationsInitialized = false;
  });

  document.addEventListener("astro:page-load", initPublications);
  document.addEventListener("DOMContentLoaded", initPublications);
</script>

<style>
  /* Lab hero: mono kicker + display title over an ambient hairline grid. */
  .pub-header {
    position: relative;
    padding: var(--space-lg) 0 var(--space-md);
    margin-bottom: var(--space-xl);
    overflow: hidden;
  }

  .pub-header .section-title {
    position: relative;
    margin-bottom: var(--space-sm);
  }

  .pub-page-title {
    position: relative;
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
  }

  .pub-subtitle {
    position: relative;
    max-width: var(--max-width-prose);
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .pub-section {
    margin-bottom: var(--space-xl);
  }

  .publications-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md-lg);
  }

  .section-header {
    display: flex;
    gap: var(--space-md);
    align-items: baseline;
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-hair);
  }

  .pub-section h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--fw-medium);
    color: var(--color-primary);
    letter-spacing: -0.01em;
  }

  /* Mono item count beside the group heading. */
  .section-count {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .section-count::before {
    content: "· ";
  }
</style>
