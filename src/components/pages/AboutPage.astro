---
/**
 * About page ("// PROFILE") — bio, portrait, "I build / I write about / say hi"
 * cards, featured open-source projects, and education. All content is a single
 * localized source in `src/content/profile/about.yaml`; the featured projects are
 * pulled from the CV collection so their data lives in one place, and their
 * public running instances from `projects.yaml`, the source /projects/ reads.
 * Emits a ProfilePage + Person JSON-LD to strengthen author-entity recognition.
 */
import mehomeImg from "@assets/mehome.webp";
import ObfuscatedEmail from "@components/ui/ObfuscatedEmail.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import type { TranslationKey } from "@i18n/utils";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { SiteConfig } from "@src/types";
import { lastCommitDate } from "@utils/content-date";
import { externalLinkProps } from "@utils/links";
import { CANONICAL_ALUMNI_OF } from "@utils/person";
import { getProjects, hostedHref } from "@utils/projects";
import { getSiteUrl } from "@utils/site";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import type { ProfilePage } from "schema-dts";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const aboutEntry = await getEntry("profile", "about");
if (!aboutEntry) throw new Error("Missing content: profile/about.yaml");
// Narrow the profile discriminated union (about | uses) to the about shape.
if (aboutEntry.data.type !== "about")
  throw new Error("profile/about.yaml is not type: about");
const about = aboutEntry.data;
const c = about[locale];

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

/** Featured open-source project shape as stored in the CV sections. */
interface CvProject {
  name: string;
  tech?: string;
  description?: string;
  icon?: string;
  links?: { label: string; url: string }[];
}

// Pull the curated featured projects from the CV collection (single source).
const cvEntry = await getEntry("cv", locale);
const cvSections = (cvEntry?.data.sections ?? []) as unknown as {
  items?: CvProject[];
}[];
const cvItems = cvSections.flatMap((s) => s.items ?? []);
const featuredProjects = about.featuredProjects
  .map((name) => cvItems.find((item) => item?.name === name))
  .filter((p): p is CvProject => Boolean(p));

/** Primary (GitHub, else first) link for a project card. */
const projectHref = (p: CvProject) =>
  p.links?.find((l) => l.label === "GitHub")?.url ?? p.links?.[0]?.url;

/**
 * The public running instance of a featured project, when it has one.
 *
 * /projects/ already renders this from `projects.yaml`; the same cards here
 * showed only the repository, so a reader on the profile page could not tell
 * that one of them is callable right now. Looked up by `id` because the CV
 * items name each project by its repo name — the same key space the projects
 * document uses.
 */
const projects = await getProjects();
const liveHref = (name: string) => {
  const project = projects.find((p) => p.id === name);
  return project && hostedHref(project, locale);
};

// Editorial & corrections policy (#editorial). The site discloses AI assistance
// on every post, which makes the absence of a stated verification and
// correction process conspicuous; the AuthorCard disclosure line links here.
const editorialParagraphs: TranslationKey[] = [
  "pages.about.editorialBody1",
  "pages.about.editorialBody2",
  "pages.about.editorialBody3",
  "pages.about.editorialBody4",
];

const contactLinks = [
  {
    key: "git",
    value: "github.com/jmrplens",
    href: "https://github.com/jmrplens",
  },
  // No `mailto:` and no literal address in the markup — see ObfuscatedEmail.
  { key: "mail", value: "mail@jmrp.io", href: null, email: true },
  { key: "cv", value: "/cv", href: translatePath("/cv/") },
];

// /about/ is the canonical author-entity page: THE ProfilePage for the site
// (home and cv only reference #person by @id — see HomePage.astro/CVPage.astro).
// `mainEntity` only ADDS to the canonical #person node (alumniOf) — it must
// NOT redefine name/jobTitle/description/image/sameAs/knowsAbout, which are
// now defined once in BaseHead.astro (sourced from this very file's
// `person.jobTitle`/`person.description`, so there is no divergence).
// Both locales render from the same YAML, so both share its modification date.
const aboutModified = lastCommitDate("src/content/profile/about.yaml");

// The EN/ES counterpart of this page, so the two ProfilePage nodes can point
// at each other the way BlogPost.astro already pairs article translations.
// Without it, /about/ and /es/about/ were two unrelated nodes describing the
// same page — on the one page that exists to anchor the author entity.
const profileAltUrl = new URL(
  locale === "es" ? "/about/#profile" : "/es/about/#profile",
  getSiteUrl(),
).href;

const personSchema = {
  "@type": "ProfilePage",
  "@id": new URL("#profile", new URL(Astro.url.pathname, getSiteUrl())).href,
  name: t("pages.about.title"),
  url: new URL(Astro.url.pathname, getSiteUrl()).href,
  isPartOf: { "@id": new URL("#website", getSiteUrl()).href },
  ...(locale === "es"
    ? { translationOfWork: { "@id": profileAltUrl } }
    : { workTranslation: { "@id": profileAltUrl } }),
  inLanguage: locale,
  // Freshness from the content's own git history, not the build clock. Using
  // `new Date()` here restamped the page as modified on every deploy even when
  // nothing changed; omitted entirely when git cannot answer, because an
  // absent signal beats a fabricated one. See `@utils/content-date`.
  ...(aboutModified && { dateModified: aboutModified }),
  // This is the page an assistant reads to answer "who is José Manuel Requena
  // Plens", and it was the one page type with no `speakable` at all — every
  // blog post had one. The selectors point at the heading and the first-person
  // biography paragraphs, which are the self-contained prose here; the kicker
  // and the portrait caption are not worth reading aloud.
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".about-hero__title", ".about-hero__lead"],
  },
  mainEntity: {
    "@type": "Person",
    "@id": new URL("#person", getSiteUrl()).href,
    alumniOf: CANONICAL_ALUMNI_OF,
  },
} satisfies ProfilePage;
---

<BaseLayout
  title={t("pages.about.title")}
  description={t("pages.about.description")}
  type="profile"
  schema={personSchema}
>
  <div class="about container">
    <section class="about-hero">
      <div>
        <p class="section-title">{c.kicker}</p>
        <h1 class="page-title about-hero__title">{c.title}</h1>
        {c.lead.map((para) => <p class="about-hero__lead">{para}</p>)}
        <p class="about-hero__note">{c.note}</p>
      </div>
      <div class="about-portrait">
        <Image
          class="about-portrait__img"
          src={mehomeImg}
          alt={siteData.name ?? "José Manuel Requena Plens"}
          width={260}
          height={260}
          widths={[180, 260, 360]}
          sizes="(max-width: 720px) 180px, 260px"
          loading="lazy"
        />
      </div>
    </section>

    <section
      class="about-cards"
      aria-label={c.kicker}
    >
      <div class="about-card">
        <p class="about-card__label">{c.labels.build}</p>
        <ul class="about-card__list">
          {c.build.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="about-card">
        <p class="about-card__label">{c.labels.writesAbout}</p>
        <ul class="about-card__list">
          {c.writesAbout.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="about-card">
        <p class="about-card__label">{c.labels.contact}</p>
        <ul class="about-card__list about-card__list--mono">
          {
            contactLinks.map((link) => (
              <li>
                <span class="about-card__key">{link.key} ·</span>{" "}
                {link.email ? (
                  <ObfuscatedEmail address={link.value} />
                ) : (
                  <a
                    href={link.href}
                    {...externalLinkProps(link.href ?? "")}
                  >
                    {link.value}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      featuredProjects.length > 0 && (
        <section
          class="about-section"
          aria-labelledby="about-projects-title"
        >
          <h2
            class="about-section__title"
            id="about-projects-title"
          >
            {c.labels.projects}
          </h2>
          <div class="about-projects">
            {featuredProjects.map((p) => {
              const href = projectHref(p);
              const live = liveHref(p.name);
              return (
                <article class="proj-card">
                  <div class="proj-card__head">
                    {p.icon && (
                      <span
                        class={`i-${p.icon} proj-card__icon`}
                        aria-hidden="true"
                      />
                    )}
                    <h3 class="proj-card__name">
                      {href ? (
                        <a
                          href={href}
                          {...externalLinkProps(href)}
                        >
                          {p.name}
                        </a>
                      ) : (
                        p.name
                      )}
                    </h3>
                  </div>
                  {p.tech && <p class="proj-card__tech">{p.tech}</p>}
                  {p.description && (
                    <p class="proj-card__desc">{p.description}</p>
                  )}
                  {live && (
                    <p class="proj-card__links">
                      <a
                        href={live}
                        {...externalLinkProps(
                          live,
                          t("aria.opensNewTab", {
                            text: `${t("pages.projects.hosted")} — ${p.name}`,
                          }),
                        )}
                      >
                        <span
                          class="i-mdi:api"
                          aria-hidden="true"
                        />
                        {t("pages.projects.hosted")}
                      </a>
                    </p>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      )
    }

    <section
      class="about-section"
      aria-labelledby="about-education-title"
    >
      <h2
        class="about-section__title"
        id="about-education-title"
      >
        {c.labels.education}
      </h2>
      <ul class="about-edu">
        {
          c.education.map((edu) => (
            <li class="edu-row">
              <span class="edu-row__year">{edu.year}</span>
              <div class="edu-row__body">
                <span class="edu-row__degree">{edu.degree}</span>
                <span class="edu-row__org">{edu.org}</span>
                <span class="edu-row__note">{edu.note}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="about-section"
      id="editorial"
      aria-labelledby="about-editorial-title"
    >
      <h2
        class="about-section__title"
        id="about-editorial-title"
      >
        {t("pages.about.editorialTitle")}
      </h2>
      {
        editorialParagraphs.map((key) => (
          <p class="about-editorial__body">{t(key)}</p>
        ))
      }
      <p class="about-editorial__links">
        <ObfuscatedEmail address="mail@jmrp.io" />
        <a
          href="/.well-known/security.txt"
          data-astro-prefetch="false"
        >
          {t("pages.about.editorialSecurityLabel")}
        </a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .about {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .about-hero {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .about-hero .section-title {
    margin-bottom: var(--space-sm);
  }

  .about-hero__title {
    padding-bottom: 0;
    margin: 0 0 var(--space-md);
    font-size: clamp(2rem, 5vw, 2.875rem);
    line-height: 1.05;
    border-bottom: 0;
  }

  .about-hero__lead {
    margin: 0 0 var(--space-md);
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--color-text);
  }

  .about-hero__note {
    margin: var(--space-sm) 0 0;
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .about-portrait {
    justify-self: center;
    width: 100%;
    max-width: 260px;
  }

  .about-portrait__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .about-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .about-card {
    padding: var(--space-md-lg);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .about-card__label {
    margin: 0 0 var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .about-card__list {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 0;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text);
    list-style: none;
  }

  .about-card__list--mono {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .about-card__key {
    color: var(--color-text-muted);
  }

  .about-card__list a {
    color: var(--color-text);
    text-decoration: none;
  }

  .about-card__list a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Featured projects + education */
  .about-section {
    margin-top: var(--space-xl);
  }

  .about-section__title {
    margin: 0 0 var(--space-md-lg);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .about-projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-md);
  }

  .proj-card {
    padding: var(--space-md-lg);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .proj-card__head {
    display: flex;
    gap: 0.5em;
    align-items: center;
    margin-bottom: 6px;
  }

  .proj-card__icon {
    font-size: var(--text-lg);
  }

  .proj-card__name {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
  }

  .proj-card__name a {
    color: inherit;
    text-decoration: none;
  }

  .proj-card__name a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .proj-card__tech {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
  }

  .proj-card__desc {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text);
  }

  .proj-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: var(--space-md) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .proj-card__links a {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    color: var(--color-accent);
    text-decoration: none;
  }

  .proj-card__links a:hover,
  .proj-card__links a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .about-edu {
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--color-hair);
  }

  .edu-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-md);
    padding: var(--space-md-lg) 2px;
    border-bottom: 1px solid var(--color-hair);
  }

  .edu-row__year {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-accent);
  }

  .edu-row__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .edu-row__degree {
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
  }

  .edu-row__org {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
  }

  .edu-row__note {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text);
  }

  .about-editorial__body {
    max-width: var(--max-width-prose);
    margin: 0 0 var(--space-md);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text);
  }

  .about-editorial__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .about-editorial__links a {
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    text-decoration: none;
  }

  .about-editorial__links a:hover,
  .about-editorial__links a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (width <= 720px) {
    .about-hero {
      grid-template-columns: 1fr;
    }

    .about-portrait {
      justify-self: start;
      order: -1;
      max-width: 160px;
    }
  }
</style>
