---
/**
 * 404 Error Page shared component — "Lab / Engineering" terminal 404.
 * A big display "404", a mono terminal card echoing a failed `cat` on the
 * requested path, and a primary link home. The Jurassic Park "magic word"
 * audio easter egg is preserved (plays on first interaction).
 */
import { nedryAudio } from "@assets/nedry-assets";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);
---

<BaseLayout
  title={t("pages.notFound.title")}
  description={t("pages.notFound.description")}
  noIndex={true}
>
  <div class="nf-page">
    <div
      class="lab-grid"
      aria-hidden="true"
    >
    </div>

    <div class="nf-wrapper">
      <h1 class="nf-code">
        <span
          class="nf-code-num"
          aria-hidden="true"
          >404</span
        >
        <span class="sr-only">{t("pages.notFound.pageNotFound")}</span>
      </h1>

      {
        /* Decorative terminal flourish; meaning is carried by the heading + message. */
      }
      <div
        class="nf-terminal"
        aria-hidden="true"
      >
        <p class="nf-line">
          <span class="nf-prompt">jmrp@home:~$</span>{" "}
          <span class="nf-cmd">cat $REQUEST_URI</span>
        </p>
        <p class="nf-line">
          <span class="nf-out">cat: </span><span class="nf-err"
            >{t("pages.notFound.pageNotFound")}</span
          >
        </p>
        <p class="nf-line">
          <span class="nf-prompt">jmrp@home:~$</span>{" "}
          <span class="nf-cursor"></span>
        </p>
      </div>

      <p class="nf-message">{t("pages.notFound.message")}</p>

      <div class="nf-actions">
        <a
          href={translatePath("/")}
          class="btn btn-primary"
        >
          {t("pages.notFound.goHome")}
        </a>
      </div>
    </div>

    {
      /* eslint-disable astro/jsx-a11y/media-has-caption -- Decorative sound effect, no meaningful speech */
    }
    <audio
      data-nedry-audio
      loop
    >
      <source
        src={nedryAudio}
        type="audio/mp3"
      />
    </audio>
    {/* eslint-enable astro/jsx-a11y/media-has-caption */}
  </div>
</BaseLayout>

<style>
  .nf-page {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: var(--space-lg) var(--space-md);
    overflow: hidden;
  }

  .nf-wrapper {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 640px;
  }

  .nf-code {
    margin: 0;
    line-height: 1;
    text-align: center;
  }

  .nf-code-num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(5rem, 22vw, 11rem);
    font-weight: var(--fw-extrabold);
    color: var(--color-text-heading);
    letter-spacing: -0.04em;
  }

  /* Terminal card */
  .nf-terminal {
    width: 100%;
    max-width: 520px;
    padding: var(--space-md) var(--space-md-lg);
    margin-top: var(--space-lg);
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 2.5vw, 0.95rem);
    line-height: 1.9;
    text-align: left;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-md);
    box-shadow: var(--sh-card);
  }

  .nf-line {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .nf-prompt {
    color: var(--color-text);
  }

  .nf-cmd,
  .nf-out {
    color: var(--color-text-muted);
  }

  .nf-err {
    color: var(--color-accent);
  }

  .nf-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    vertical-align: text-bottom;
    background-color: var(--color-accent);
    border-radius: 1px;
    animation: nf-blink 1.15s steps(1) infinite;
  }

  @keyframes nf-blink {
    0%,
    46% {
      opacity: 100%;
    }

    54%,
    100% {
      opacity: 0%;
    }
  }

  .nf-message {
    margin: var(--space-lg) 0 0;
    font-size: clamp(0.95rem, 2.5vw, 1.05rem);
    color: var(--color-text);
    text-align: center;
  }

  .nf-actions {
    display: flex;
    margin-top: var(--space-md-lg);
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-cursor {
      animation: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var audio = document.querySelector("[data-nedry-audio]");
    var played = false;

    function play() {
      if (!audio || played) return;
      audio
        .play()
        .then(function () {
          played = true;
        })
        .catch(function () {});
    }

    play();

    var once = { once: true, passive: true };
    ["pointerdown", "scroll", "keydown"].forEach(function (evt) {
      document.addEventListener(evt, play, once);
    });
  })();
</script>
