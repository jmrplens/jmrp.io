interface Provider {
  "@type": string;
  name: string;
}

interface Service {
  id: string;
  name: string;
  title: string;
  icon: string;
  description: string;
  url: string;
  linkText: string;
  statsType: "mastodon" | "matrix" | "meshtastic-combined";
  provider: Provider;
  userInfo?: string;
}

const defaultProvider: Provider = {
  "@type": "Person",
  name: "José Manuel Requena Plens",
};

