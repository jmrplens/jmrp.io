---
/**
 * Homelab Page shared component.
 * Displays self-hosted services status and details.
 */
import "@styles/components/service-stats.css";
import "@styles/components/homelab-components.css";

import type { HomelabKpiTranslations } from "@components/homelab/HomelabKpi";
import HomelabKpi from "@components/homelab/HomelabKpi";
import type { InfrastructureTranslations } from "@components/homelab/InfrastructureInsights";
import InfrastructureInsights from "@components/homelab/InfrastructureInsights";
import type {
  NodeCardsTranslations,
  NodeConfig,
} from "@components/homelab/NodeCards";
import NodeCards from "@components/homelab/NodeCards";
import ServiceCard from "@components/homelab/ServiceCard.astro";
import type { ServiceStatsTranslations } from "@components/homelab/ServiceStats";
import ServiceStats from "@components/homelab/ServiceStats";
import type { TorAggregateTranslations } from "@components/homelab/TorAggregate";
import TorAggregate from "@components/homelab/TorAggregate";
import type {
  TorStatsTranslations,
  TorType,
} from "@components/homelab/TorStats";
import TorStats from "@components/homelab/TorStats";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

/**
 * Build translation objects for Preact islands.
 * Props are serialized at build time — no runtime i18n loading needed.
 */
const infrastructureTranslations: InfrastructureTranslations = {
  ariaLabel: t("pages.homelab.statsAriaLabel"),
  error: t("pages.homelab.statsError"),
  requestsReceived: t("pages.homelab.requestsReceived"),
  requestsReceivedSR: t("pages.homelab.requestsReceivedSR"),
  handled: t("pages.homelab.handled"),
  responsesSent: t("pages.homelab.responsesSent"),
  upstream: t("pages.homelab.upstream"),
  sentPrefix: t("pages.homelab.sentPrefix"),
  bandwidthUp: t("pages.homelab.bandwidthUp"),
  receivedPrefix: t("pages.homelab.receivedPrefix"),
  bandwidthDown: t("pages.homelab.bandwidthDown"),
  securityBlocks: t("pages.homelab.securityBlocks"),
  loading: t("pages.homelab.loading"),
  noData: t("pages.homelab.noData"),
  totalSecurityBlocks: t("pages.homelab.totalSecurityBlocks"),
  blocks: t("pages.homelab.blocks"),
  nginxBans: t("pages.homelab.nginxBans"),
  tarpitBlogAria: t("pages.homelab.tarpitBlogAria"),
  tarpitBlogUrl: translatePath("/blog/005-implementing-tarpit-nginx/"),
  tarpitHits: t("pages.homelab.tarpitHits"),
  tarpitHitsUnit: t("pages.homelab.tarpitHitsUnit"),
  portScannerBlogAria: t("pages.homelab.portScannerBlogAria"),
  portScannerBlogUrl: translatePath(
    "/blog/006-implementing-mikrotik-honeypot/",
  ),
  attackRegions: t("pages.homelab.attackRegions"),
  attackRegionsList: t("pages.homelab.attackRegionsList"),
  noAttackRegions: t("pages.homelab.noAttackRegions"),
  hits: t("pages.homelab.hits"),
  rateLimits: t("pages.homelab.rateLimits"),
  systemStatus: t("pages.homelab.systemStatus"),
  nodeResourceLoad: t("pages.homelab.nodeResourceLoad"),
  cpuUsagePrefix: t("pages.homelab.cpuUsagePrefix"),
  percentCPU: t("pages.homelab.percentCPU"),
  memoryUsage: t("pages.homelab.memoryUsage"),
  percentRAM: t("pages.homelab.percentRAM"),
  loadStatus: t("pages.homelab.loadStatus"),
  statusCritical: t("pages.homelab.statusCritical"),
  statusHigh: t("pages.homelab.statusHigh"),
  statusElevated: t("pages.homelab.statusElevated"),
  statusOptimal: t("pages.homelab.statusOptimal"),
  statusHealthy: t("pages.homelab.statusHealthy"),
  statusUnknown: t("pages.homelab.statusUnknown"),
  cpuTemp: t("pages.homelab.cpuTemp"),
  edgeDefense: t("pages.homelab.edgeDefense"),
  flowBand: t("pages.homelab.flowBand"),
  mikrotikTitle: t("pages.homelab.mikrotikTitle"),
  mikrotikLayer: t("pages.homelab.mikrotikLayer"),
  crowdsecTitle: t("pages.homelab.crowdsecTitle"),
  crowdsecLayer: t("pages.homelab.crowdsecLayer"),
  honeypotHits: t("pages.homelab.honeypotHits"),
  blacklistScanners: t("pages.homelab.blacklistScanners"),
  activeConnections: t("pages.homelab.activeConnections"),
  wanTraffic: t("pages.homelab.wanTraffic"),
  crowdsecBlocked: t("pages.homelab.crowdsecBlocked"),
  edgeDefenseChip: t("pages.homelab.edgeDefenseChip"),
  threatsBlocked: t("pages.homelab.kpiThreatsBlocked"),
  edgeDescription: t("pages.homelab.edgeDescription"),
  linkTarpit: t("pages.homelab.linkTarpit"),
  linkHoneypot: t("pages.homelab.linkHoneypot"),
};

const kpiTranslations: HomelabKpiTranslations = {
  ariaLabel: t("pages.homelab.kpiAriaLabel"),
  servicesOnline: t("pages.homelab.kpiServicesOnline"),
  // Breakdown ("· N infra · M Tor") appended below, once nodeCards/torServices exist.
  monitoredNodes: t("pages.homelab.kpiMonitoredNodes"),
  requests24h: t("pages.homelab.kpiRequests24h"),
  wan24h: t("pages.homelab.kpiWan24h"),
  noData: t("pages.homelab.noData"),
};

const serviceStatsTranslations: ServiceStatsTranslations = {
  serviceUnavailable: t("pages.homelab.serviceUnavailable"),
  knownInstances: t("pages.homelab.knownInstances"),
  knownServers: t("pages.homelab.knownServers"),
  trendingNow: t("pages.homelab.trendingNow"),
  nodes: t("pages.homelab.nodes"),
  viewMap: t("pages.homelab.viewMap"),
  viewMapAria: t("pages.homelab.viewMapAria"),
  viewMonitor: t("pages.homelab.viewMonitor"),
  viewMonitorAria: t("pages.homelab.viewMonitorAria"),
  pdsNetworks: t("pages.homelab.pdsNetworks"),
};

const torAggregateTranslations: TorAggregateTranslations = {
  nodes: t("pages.homelab.torNodes"),
  clients: t("pages.homelab.torClients"),
  bandwidth: t("pages.homelab.torBandwidth"),
  traffic: t("pages.homelab.torTraffic"),
};

const torStatsTranslations: TorStatsTranslations = {
  serviceUnavailable: t("pages.homelab.torStatsError"),
  running: t("pages.homelab.torRunning"),
  offline: t("pages.homelab.torOffline"),
  version: t("pages.homelab.torVersion"),
  recommended: t("pages.homelab.torRecommended"),
  obsolete: t("pages.homelab.torObsolete"),
  flags: t("pages.homelab.torFlags"),
  transports: t("pages.homelab.torTransports"),
  traffic24h: t("pages.homelab.torTraffic24h"),
  download: t("pages.homelab.torDownload"),
  upload: t("pages.homelab.torUpload"),
  clients24h: t("pages.homelab.torClients24h"),
  orConnections: t("pages.homelab.torOrConnections"),
  circuits: t("pages.homelab.torCircuits"),
  connections24h: t("pages.homelab.torConnections24h"),
  advertisedBandwidth: t("pages.homelab.torAdvertisedBandwidth"),
  location: t("pages.homelab.torLocation"),
};

interface Provider {
  "@type": string;
  name: string;
}

interface Service {
  id: string;
  name: string;
  title: string;
  icon: string;
  description: string;
  url: string;
  linkText: string;
  statsType: "mastodon" | "matrix" | "meshtastic-combined" | "pds";
  provider: Provider;
  userInfo?: string;
}

const defaultProvider: Provider = {
  "@type": "Person",
  name: "José Manuel Requena Plens",
};

const services: Service[] = [
  {
    id: "mastodon",
    name: t("pages.homelab.mastodonName"),
    title: "Mastodon",
    icon: "fa-brands:mastodon",
    description: t("pages.homelab.mastodonDescription"),
    url: "https://mstdn.jmrp.io/",
    linkText: t("pages.homelab.mastodonLink"),
    statsType: "mastodon",
    provider: defaultProvider,
  },
  {
    id: "matrix",
    name: t("pages.homelab.matrixName"),
    title: "Matrix",
    icon: "simple-icons:matrix",
    description: t("pages.homelab.matrixDescription"),
    url: "https://matrix.to/#/@jmrplens:matrix.jmrp.io",
    linkText: t("pages.homelab.matrixLink"),
    statsType: "matrix",
    provider: defaultProvider,
    userInfo: "@jmrplens:matrix.jmrp.io",
  },
  {
    id: "meshtastic",
    name: t("pages.homelab.meshtasticName"),
    title: "Meshtastic",
    icon: "fa-solid:broadcast-tower",
    description: t("pages.homelab.meshtasticDescription"),
    url: "https://mesh.jmrp.io",
    linkText: t("pages.homelab.meshtasticLink"),
    statsType: "meshtastic-combined",
    provider: defaultProvider,
  },
  {
    id: "pds",
    name: t("pages.homelab.pdsName"),
    title: "AT Protocol",
    icon: "simple-icons:bluesky",
    description: t("pages.homelab.pdsDescription"),
    url: "https://bsky.app/profile/jmrp.io",
    linkText: t("pages.homelab.pdsLink"),
    statsType: "pds",
    provider: defaultProvider,
    userInfo: "@jmrp.io",
  },
];

/** Tor services displayed as separate cards alongside the main services grid. */
const torServices = [
  {
    id: "tor-bridge",
    title: t("pages.homelab.torBridgeName"),
    icon: "simple-icons:torproject",
    description: t("pages.homelab.torBridgeDescription"),
    url: "https://metrics.torproject.org/rs.html#details/1508F567C54ECF5373CE2EF3BF02C62EEA1B320E",
    linkText: t("pages.homelab.torBridgeLink"),
    torType: "bridge" as TorType,
    name: t("pages.homelab.torBridgeName"),
  },
  {
    id: "tor-bridge-es1",
    title: t("pages.homelab.torBridgeEs1Name"),
    icon: "simple-icons:torproject",
    description: t("pages.homelab.torBridgeEs1Description"),
    url: "https://metrics.torproject.org/rs.html#details/98422E9D1648FFDB8F16C06CF58CD64B6C03A003",
    linkText: t("pages.homelab.torBridgeEs1Link"),
    torType: "bridge-es1" as TorType,
    name: t("pages.homelab.torBridgeEs1Name"),
  },
  {
    id: "tor-relay",
    title: t("pages.homelab.torRelayName"),
    icon: "simple-icons:torproject",
    description: t("pages.homelab.torRelayDescription"),
    url: "https://metrics.torproject.org/rs.html#details/B442687AD97B8CC73F3AED95D76E1F47A5504C14",
    linkText: t("pages.homelab.torRelayLink"),
    torType: "relay" as TorType,
    name: t("pages.homelab.torRelayName"),
  },
  {
    id: "tor-relay-es",
    title: t("pages.homelab.torRelayEsName"),
    icon: "simple-icons:torproject",
    description: t("pages.homelab.torRelayEsDescription"),
    url: "https://metrics.torproject.org/rs.html#details/3467943E5042BA46FCE4DE8517B0EBCD5D1BBB1D",
    linkText: t("pages.homelab.torRelayEsLink"),
    torType: "relay-es" as TorType,
    name: t("pages.homelab.torRelayEsName"),
  },
];

/** Infrastructure nodes shown in the compact live resource grid. */
const nodeCards: NodeConfig[] = [
  {
    key: "nginx",
    endpoint: "/api/homelab/stats",
    name: t("pages.homelab.nodeNginxName"),
    role: t("pages.homelab.nodeNginxRole"),
  },
  {
    key: "matrix",
    endpoint: "/api/homelab/matrix",
    name: t("pages.homelab.nodeMatrixName"),
    role: t("pages.homelab.nodeMatrixRole"),
  },
  {
    key: "mastodon",
    endpoint: "/api/homelab/mastodon",
    name: t("pages.homelab.nodeMastodonName"),
    role: t("pages.homelab.nodeMastodonRole"),
  },
  {
    key: "truenas",
    endpoint: "/api/homelab/truenas",
    name: t("pages.homelab.nodeTruenasName"),
    role: t("pages.homelab.nodeTruenasRole"),
  },
  {
    key: "mikrotik",
    endpoint: "/api/homelab/mikrotik",
    name: t("pages.homelab.nodeRouterName"),
    role: t("pages.homelab.nodeRouterRole"),
  },
];

// Node-count breakdown for the KPI band, derived from the real arrays so it stays
// in sync (e.g. "monitored nodes · 5 infra · 4 Tor").
kpiTranslations.monitoredNodes = `${t("pages.homelab.kpiMonitoredNodes")} · ${nodeCards.length} infra · ${torServices.length} Tor`;

const nodeCardsTranslations: NodeCardsTranslations = {
  ariaLabel: t("pages.homelab.nodesAriaLabel"),
  cpu: t("pages.homelab.nodeCpu"),
  ram: t("pages.homelab.nodeRam"),
  tempOptimal: t("pages.homelab.nodeTempOptimal"),
  tempHighLoad: t("pages.homelab.nodeTempHighLoad"),
  statusOptimal: t("pages.homelab.nodeStatusOptimal"),
  statusHighLoad: t("pages.homelab.nodeStatusHighLoad"),
  noData: t("pages.homelab.noData"),
};

// Monitored-node headline count: infrastructure nodes + Tor nodes. Derived from
// the rendered arrays so the figure never drifts from what the page shows.
const monitoredNodesCount = nodeCards.length + torServices.length;

const servicesSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": new URL("#collection", new URL(Astro.url.pathname, getSiteUrl())).href,
  name: t("pages.homelab.schemaName"),
  inLanguage: locale,
  hasPart: [
    ...services.map((service) => ({
      "@type": "Service",
      name: service.name,
      description: service.description,
      url: service.url,
      provider: service.provider,
    })),
    ...torServices.map((service) => ({
      "@type": "Service",
      name: service.name,
      description: service.description,
      url: service.url,
      provider: defaultProvider,
    })),
  ],
};
---

<BaseLayout
  title={t("nav.homelab")}
  description={t("pages.homelab.description")}
  schema={servicesSchema}
>
  {/* HMAC token injected by Nginx sub_filter at serve time for API auth */}
  <div
    data-homelab-token="NGINX_HOMELAB_TOKEN"
    hidden
    aria-hidden="true"
  >
  </div>
  <section aria-label={t("aria.homelabInfrastructure")}>
    <div class="container">
      <div class="homelab-hero">
        <div>
          <p class="section-title">{t("pages.homelab.kicker")}</p>
          <h1 class="page-title">{t("pages.homelab.title")}</h1>
          <p class="homelab-hero__intro">{t("pages.homelab.intro")}</p>
        </div>
        <p class="realtime-pill">
          <span
            class="realtime-pill__dot"
            aria-hidden="true"
          ></span>
          {t("pages.homelab.realtimePill")}
        </p>
      </div>

      <section aria-label={t("pages.homelab.kpiAriaLabel")}>
        <HomelabKpi
          client:visible
          translations={kpiTranslations}
          servicesCount={services.length}
          nodesCount={monitoredNodesCount}
        />
      </section>

      <section
        class="infrastructure-insights"
        aria-label={t("pages.homelab.edgeDefense")}
      >
        <InfrastructureInsights
          client:visible
          translations={infrastructureTranslations}
        />
      </section>

      <section
        class="services-section"
        aria-labelledby="homelab-services-heading"
      >
        <h2
          class="section-title"
          id="homelab-services-heading"
        >
          {t("pages.homelab.servicesKicker")}
        </h2>
        <div class="services-grid">
          {
            services.map((service) => (
              <ServiceCard
                title={service.title}
                icon={service.icon}
                description={service.description}
                link={service.url}
                linkText={service.linkText}
                statusText={t("pages.homelab.online")}
              >
                {service.userInfo && (
                  <div
                    slot="extra"
                    class="user-info"
                  >
                    {t("pages.homelab.userLabel")}{" "}
                    <code>{service.userInfo}</code>
                  </div>
                )}
                <div
                  id={`${service.id}-stats`}
                  class="stats-container"
                >
                  <ServiceStats
                    client:visible
                    type={service.statsType}
                    translations={serviceStatsTranslations}
                  />
                </div>
              </ServiceCard>
            ))
          }
        </div>
      </section>

      <section
        class="tor-section"
        aria-labelledby="homelab-tor-heading"
      >
        <h2
          class="section-title"
          id="homelab-tor-heading"
        >
          {t("pages.homelab.torKicker")} · {torServices.length}{" "}
          {t("pages.homelab.nodesUnit")}
        </h2>
        <TorAggregate
          client:visible
          translations={torAggregateTranslations}
        />
        <div class="services-grid">
          {
            torServices.map((service) => (
              <ServiceCard
                title={service.title}
                icon={service.icon}
                description={service.description}
                link={service.url}
                linkText={service.linkText}
                statusText={t("pages.homelab.torRunning")}
              >
                <div
                  id={`${service.id}-stats`}
                  class="stats-container"
                >
                  <TorStats
                    client:visible
                    type={service.torType}
                    translations={torStatsTranslations}
                  />
                </div>
              </ServiceCard>
            ))
          }
        </div>
      </section>

      <section
        class="nodes-section"
        aria-labelledby="homelab-nodes-title"
      >
        <div class="nodes-section__head">
          <h2
            class="section-title"
            id="homelab-nodes-title"
          >
            {t("pages.homelab.kicker")} · {nodeCards.length}{" "}
            {t("pages.homelab.nodesUnit")}
          </h2>
          <span class="nodes-section__hint">
            {t("pages.homelab.nodesLiveHint")}
          </span>
        </div>
        <NodeCards
          client:visible
          translations={nodeCardsTranslations}
          nodes={nodeCards}
        />
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .homelab-hero {
    margin-bottom: var(--space-xl);
  }

  .homelab-hero .section-title {
    margin-bottom: var(--space-md);
  }

  .homelab-hero .page-title {
    padding-bottom: 0;
    margin: 0 0 var(--space-sm);
    font-size: clamp(2.125rem, 4.4vw, 3.25rem);
    font-weight: var(--fw-bold);
    line-height: 1.04;
    border-bottom: 0;
  }

  .infrastructure-insights,
  .services-section,
  .tor-section {
    margin-top: var(--space-xl);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-lg);
  }

  .section-subtitle {
    margin: var(--space-xl) 0 var(--space-lg);
    font-size: var(--text-2xl);
    font-weight: var(--fw-bold);
    color: var(--color-text-heading);
  }

  .user-info {
    padding: var(--space-sm);
    margin-bottom: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    overflow-wrap: break-word;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
  }

  code {
    padding: 2px 4px;
    color: var(--color-accent);
    background: var(--color-bg);
    border-radius: 4px;
  }

  .stats-container {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    padding: 0;
    margin-top: 0;
    font-size: var(--text-sm);
    overflow-wrap: break-word;
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
  }
</style>
