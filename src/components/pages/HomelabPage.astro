---

<BaseLayout
  title={t("nav.homelab")}
  description={t("pages.homelab.description")}
  schema={servicesSchema}
>
  {/* HMAC token injected by Nginx sub_filter at serve time for API auth */}
  <div
    data-homelab-token="NGINX_HOMELAB_TOKEN"
    hidden
    aria-hidden="true"
  >
  </div>
  <section aria-label={t("aria.homelabInfrastructure")}>
    <div class="container">
      <p class="section-title">{t("pages.homelab.kicker")}</p>
      <h1 class="page-title">{t("pages.homelab.title")}</h1>
      <p class="intro">
        {t("pages.homelab.intro")}
      </p>

      <div class="services-grid">
        {
          services.map((service) => (
            <ServiceCard
              title={service.title}
              icon={service.icon}
              description={service.description}
              link={service.url}
              linkText={service.linkText}
            >
              {service.userInfo && (
                <div
                  slot="extra"
                  class="user-info"
                >
                  {t("pages.homelab.userLabel")} <code>{service.userInfo}</code>
                </div>
              )}
              <div
                id={`${service.id}-stats`}
                class="stats-container"
              >
                <ServiceStats
                  client:visible
                  type={service.statsType}
                  translations={serviceStatsTranslations}
                />
              </div>
            </ServiceCard>
          ))
        }
      </div>

      <section
        class="tor-section"
        aria-label={t("pages.homelab.torSectionAria")}
      >
        <p class="section-title">{t("pages.homelab.torKicker")}</p>
        <TorAggregate
          client:visible
          translations={torAggregateTranslations}
        />
        <div class="services-grid">
          {
            torServices.map((service) => (
              <ServiceCard
                title={service.title}
                icon={service.icon}
                description={service.description}
                link={service.url}
                linkText={service.linkText}
              >
                <div
                  id={`${service.id}-stats`}
                  class="stats-container"
                >
                  <TorStats
                    client:visible
                    type={service.torType}
                    translations={torStatsTranslations}
                  />
                </div>
              </ServiceCard>
            ))
          }
        </div>
      </section>

      <section
        class="infrastructure-insights"
        aria-labelledby="node-nginx-edge-security-analytics"
      >
        <h2
          class="section-subtitle"
          id="node-nginx-edge-security-analytics"
        >
          {t("pages.homelab.nginxNode")}
        </h2>
        <InfrastructureInsights
          client:visible
          translations={infrastructureTranslations}
        />
      </section>

      <section
        class="infrastructure-insights"
        aria-labelledby="node-matrix-homeserver"
      >
        <h2
          class="section-subtitle"
          id="node-matrix-homeserver"
        >
          {t("pages.homelab.matrixNode")}
        </h2>
        <ServerInsights
          client:visible
          type="matrix"
          translations={matrixInsightsTranslations}
        />
      </section>

      <section
        class="infrastructure-insights"
        aria-labelledby="node-mastodon-instance"
      >
        <h2
          class="section-subtitle"
          id="node-mastodon-instance"
        >
          {t("pages.homelab.mastodonNode")}
        </h2>
        <ServerInsights
          client:visible
          type="mastodon"
          translations={mastodonInsightsTranslations}
        />
      </section>

      <section
        class="infrastructure-insights"
        aria-labelledby="node-truenas-storage"
      >
        <h2
          class="section-subtitle"
          id="node-truenas-storage"
        >
          {t("pages.homelab.truenasNode")}
        </h2>
        <ServerInsights
          client:visible
          type="truenas"
          translations={truenasInsightsTranslations}
        />
      </section>

      <section
        class="infrastructure-insights"
        aria-labelledby="node-edge-router"
      >
        <h2
          class="section-subtitle"
          id="node-edge-router"
        >
          {t("pages.homelab.routerNode")}
        </h2>
        <ServerInsights
          client:visible
          type="mikrotik"
          translations={mikrotikInsightsTranslations}
        />
      </section>
