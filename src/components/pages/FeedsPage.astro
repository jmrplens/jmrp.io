---
/**
 * Feeds page ("// FEEDS") — human landing for the RSS feeds.
 *
 * Browsers navigating to /rss.xml (Sec-Fetch-Dest: document) are redirected
 * here by the edge worker (and by nginx as fallback), so a person clicking
 * the RSS button gets an explanation and copyable feed URLs instead of raw
 * XML on the screen. Feed readers keep fetching the unchanged XML at the
 * same URLs — they never send Sec-Fetch-Dest: document.
 *
 * The feed URLs are deliberately NOT rendered as links: clicking them would
 * bounce straight back to this page. They are shown as text with a copy
 * button, which is exactly what a reader app needs.
 */
import CopyButton from "@components/ui/CopyButton.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatDateDot, getPostsForLocale } from "@utils/blog";
import { externalLinkProps } from "@utils/links";
import { getSiteUrl } from "@utils/site";
import type { WebPage } from "schema-dts";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const siteUrl = getSiteUrl();
// The author's Bluesky feed generators — checked-in snapshot of the AT
// Protocol records (see the file's $comment for how to regenerate). The page
// existed to publish "the feeds" and only knew about the two RSS ones; these
// eight are feeds in the same sense, just on another protocol.
import blueskyFeeds from "@data/bluesky-feeds.json";

const blueskyProfile = "https://bsky.app/profile/jmrp.io";
const feedEn = new URL("/rss.xml", siteUrl).href;
const feedEs = new URL("/es/rss.xml", siteUrl).href;

// Current locale's feed first.
const feeds =
  locale === "es"
    ? [
        { label: t("pages.feeds.feedSpanish"), url: feedEs },
        { label: t("pages.feeds.feedEnglish"), url: feedEn },
      ]
    : [
        { label: t("pages.feeds.feedEnglish"), url: feedEn },
        { label: t("pages.feeds.feedSpanish"), url: feedEs },
      ];

const entries = await getPostsForLocale(locale);
const latest = entries
  .map((e) => e.post)
  .sort(
    (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime(),
  )
  .slice(0, 5);

const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const feedsSchema = {
  "@type": "WebPage",
  // Answer target for this page: its title and the one-line intro under it.
  // 66 indexable pages carried no `speakable` (GEO audit 2026-08-22, M7);
  // selectors verified against the built markup.
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".feeds-header__title", ".feeds-header__intro"],
  },
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: t("pages.feeds.title"),
  description: t("pages.feeds.description"),
  inLanguage: locale,
  isPartOf: { "@id": new URL("#website", siteUrl).href },
  publisher: { "@id": new URL("#person", siteUrl).href },
  // The page's whole purpose is to publish these feeds, and its graph did not
  // name a single one (GEO audit 2026-08-22, B1): two RSS DataFeeds plus the
  // eight Bluesky feed generators. Bluesky entries carry both the human page
  // on bsky.app (`url`) and the canonical AT Protocol URI (`identifier`).
  mainEntity: {
    "@type": "ItemList",
    itemListElement: [
      ...[
        { url: feedEn, lang: "en", name: t("pages.feeds.feedEnglish") },
        { url: feedEs, lang: "es", name: t("pages.feeds.feedSpanish") },
      ].map((feed, index) => ({
        "@type": "ListItem" as const,
        position: index + 1,
        item: {
          "@type": "DataFeed" as const,
          name: feed.name,
          url: feed.url,
          encodingFormat: "application/rss+xml",
          inLanguage: feed.lang,
          provider: { "@id": new URL("#person", siteUrl).href },
        },
      })),
      ...blueskyFeeds.feeds.map((feed, index) => ({
        "@type": "ListItem" as const,
        position: index + 3,
        item: {
          "@type": "DataFeed" as const,
          name: feed.name,
          description: feed.description,
          url: `${blueskyProfile}/feed/${feed.rkey}`,
          identifier: `at://${blueskyFeeds.did}/app.bsky.feed.generator/${feed.rkey}`,
          inLanguage: feed.lang,
          provider: { "@id": new URL("#person", siteUrl).href },
        },
      })),
    ],
  },
} satisfies WebPage;
---

<BaseLayout
  title={t("pages.feeds.title")}
  description={t("pages.feeds.description")}
  schema={feedsSchema}
>
  <div class="feeds container">
    <header class="feeds-header">
      <p class="section-title">{t("pages.feeds.kicker")}</p>
      <h1 class="page-title feeds-header__title">
        {t("pages.feeds.heading")}
      </h1>
      <p class="feeds-header__intro">{t("pages.feeds.intro")}</p>
    </header>

    <aside
      class="feeds-note"
      role="note"
      aria-label={t("pages.feeds.landedTitle")}
    >
      <p class="feeds-note__title">{t("pages.feeds.landedTitle")}</p>
      <p class="feeds-note__body">{t("pages.feeds.landedBody")}</p>
    </aside>

    <ul class="feeds-list">
      {
        feeds.map((feed) => (
          <li class="feed-card">
            <span class="feed-card__label">{feed.label}</span>
            <span class="feed-card__row copy-container">
              <code class="feed-card__url">{feed.url}</code>
              <CopyButton
                content={feed.url}
                ariaLabel={`${t("pages.feeds.copyUrl")} — ${feed.label}`}
                text={t("pages.feeds.copyUrl")}
              />
            </span>
          </li>
        ))
      }
    </ul>

    <section
      class="feeds-bluesky"
      aria-labelledby="feeds-bluesky-title"
    >
      <h2
        class="feeds-bluesky__title"
        id="feeds-bluesky-title"
      >
        {t("pages.feeds.blueskyTitle")}
      </h2>
      <p class="feeds-bluesky__intro">{t("pages.feeds.blueskyIntro")}</p>
      <ul class="feeds-list">
        {
          blueskyFeeds.feeds.map((feed) => {
            const feedUrl = `${blueskyProfile}/feed/${feed.rkey}`;
            return (
              <li class="feed-card">
                <span class="feed-card__label">{feed.name}</span>
                {/* The description is the record's own text, in the feed's
                  language — lang tells assistive tech which voice to use. */}
                <span
                  class="feed-card__desc"
                  lang={feed.lang}
                >
                  {feed.description}
                </span>
                <span class="feed-card__row">
                  <a
                    class="feed-card__open"
                    href={feedUrl}
                    {...externalLinkProps(
                      feedUrl,
                      t("aria.opensNewTab", {
                        text: `${t("pages.feeds.blueskyOpen")} — ${feed.name}`,
                      }),
                    )}
                  >
                    {t("pages.feeds.blueskyOpen")}
                    {/* Decorative: the aria-label already announces the new
                      tab, so the glyph must not be read a second time. */}
                    <span aria-hidden="true"> ↗</span>
                  </a>
                </span>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section
      class="feeds-latest"
      aria-labelledby="feeds-latest-title"
    >
      <h2
        class="feeds-latest__title"
        id="feeds-latest-title"
      >
        {t("pages.feeds.latestTitle")}
      </h2>
      <ul class="feeds-latest__list">
        {
          latest.map((post) => (
            <li class="feeds-latest__item">
              <time
                class="feeds-latest__date"
                datetime={post.data.publishedDate.toISOString()}
              >
                {formatDateDot(post.data.publishedDate)}
              </time>
              <a href={translatePath(`/blog/${post.data.slug}/`)}>
                {post.data.title}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        class="feeds-latest__more"
        href={translatePath("/blog/")}
      >
        {t("pages.feeds.backToBlog")} →
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .feeds {
    max-width: var(--max-width-prose);
    padding-block: var(--space-xl);
  }

  .feeds-header {
    margin-bottom: var(--space-lg);
  }

  .feeds-header__intro {
    margin-top: var(--space-sm);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .feeds-note {
    padding: var(--space-md);
    margin-bottom: var(--space-lg);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
  }

  .feeds-note__title {
    margin-bottom: var(--space-xs);
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .feeds-note__body {
    color: var(--color-text-muted);
  }

  .feeds-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: 0;
    margin: 0 0 var(--space-lg);
    list-style: none;
  }

  .feed-card {
    padding: var(--space-md);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .feed-card__label {
    display: block;
    margin-bottom: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .feed-card__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
  }

  .feed-card__url {
    padding: 4px 10px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-heading);
    white-space: nowrap;
    background: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
  }

  .feeds-bluesky {
    margin-top: var(--space-lg);
  }

  .feeds-bluesky__title {
    margin-bottom: var(--space-sm);
  }

  .feeds-bluesky__intro {
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
  }

  .feed-card__desc {
    display: block;
    margin-bottom: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .feed-card__open {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .feeds-latest__title {
    margin-bottom: var(--space-md);
  }

  .feeds-latest__list {
    padding: 0;
    margin: 0 0 var(--space-md);
    list-style: none;
  }

  .feeds-latest__item {
    display: flex;
    gap: var(--space-md);
    align-items: baseline;
    padding-block: var(--space-xs);
  }

  /* WCAG 2.5.8: enlaces independientes → área táctil >=24px */
  .feeds-latest__item a,
  .feeds-latest__more {
    display: inline-block;
    padding-block: 2px;
  }

  .feeds-latest__date {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .feeds-latest__more {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  @media (width <= 640px) {
    .feeds-latest__item {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
