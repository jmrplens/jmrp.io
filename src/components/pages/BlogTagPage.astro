---
/**
 * Blog Tag Page shared component.
 * Displays posts filtered by a specific tag.
 */
import "@styles/blog.css";

import PostGrid from "@components/blog/PostGrid.astro";
import TagCloud from "@components/blog/TagCloud.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { pluralize, useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";
import type { CollectionEntry } from "astro:content";
import type { CollectionPage, ListItem } from "schema-dts";

interface Props {
  /** The tag being filtered. */
  tag: string;
  /** Posts matching this tag. */
  posts: CollectionEntry<"posts">[];
}

const { tag, posts } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const postWord = pluralize(
  posts.length,
  {
    one: t("pages.blogTags.postSingular"),
    other: t("pages.blogTags.postPlural"),
  },
  locale,
);
const articleWord = pluralize(
  posts.length,
  {
    one: t("pages.blogTags.articleSingular"),
    other: t("pages.blogTags.articlePlural"),
  },
  locale,
);

// Schema.org: CollectionPage with ItemList
const schema = {
  "@type": "CollectionPage",
  "@id": new URL("#collection", new URL(Astro.url.pathname, getSiteUrl())).href,
  name: t("pages.blogTags.schemaName", { tag }),
  description: t("pages.blogTags.schemaDescription", {
    count: posts.length,
    tag,
  }),
  url: new URL(Astro.url.pathname, getSiteUrl()).href,
  inLanguage: locale,
  isPartOf: { "@id": new URL("#website", getSiteUrl()).href },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index): ListItem => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(translatePath(`/blog/${post.data.slug}/`), getSiteUrl())
        .href,
      name: post.data.title,
    })),
  },
} satisfies CollectionPage;
---

<BaseLayout
  title={`${t("pages.blogTags.titlePrefix")}${tag}`}
  description={t("pages.blogTags.metaDescription", {
    count: posts.length,
    articleWord,
    tag,
  })}
  schema={schema}
>
  <div class="content-wrapper">
    <header class="page-header">
      <div
        class="lab-grid"
        aria-hidden="true"
      >
      </div>
      <p class="kicker section-title">{t("pages.blog.kicker")}</p>
      <h1>#{tag}</h1>
      <p class="subtitle">
        {posts.length}
        {postWord}
        {t("pages.blogTags.aboutTopic")}
      </p>
      <div class="back-link">
        <a href={translatePath("/blog/")}
          >{t("pages.blogTags.backToAllPosts")}</a
        >
      </div>
    </header>

    <div class="blog-body">
      <TagCloud activeTag={tag} />
      <PostGrid posts={posts} />
    </div>
  </div>
</BaseLayout>

<style>
  /* Left-aligned "Lab" header with mono kicker + ambient grid.
     Overrides the centered defaults from blog.css. */
  .page-header {
    position: relative;
    padding-bottom: var(--space-md-lg);
    overflow: hidden;
    text-align: left;
    border-bottom: 1px solid var(--color-hair);
  }

  .page-header > .lab-grid {
    z-index: 0;
  }

  .page-header :where(.kicker, h1, .subtitle, .back-link) {
    position: relative;
    z-index: 1;
  }

  .kicker {
    margin-bottom: var(--space-sm);
  }

  .page-header h1 {
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .subtitle {
    font-size: var(--text-md);
    color: var(--color-text);
  }

  .blog-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
</style>
