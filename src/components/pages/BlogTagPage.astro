---
/**
 * Blog Tag Page shared component.
 * Displays posts filtered by a specific tag.
 */
import "@styles/blog.css";

import PostGrid from "@components/blog/PostGrid.astro";
import TagCloud from "@components/blog/TagCloud.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import {
  pluralize,
  type TranslationKey,
  useTranslatedPath,
  useTranslations,
} from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";
import type { CollectionEntry } from "astro:content";
import type { CollectionPage, ListItem } from "schema-dts";

interface Props {
  /** The tag being filtered. */
  tag: string;
  /** Posts matching this tag. */
  posts: CollectionEntry<"posts">[];
}

const { tag, posts } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const postWord = pluralize(
  posts.length,
  {
    one: t("pages.blogTags.postSingular"),
    other: t("pages.blogTags.postPlural"),
  },
  locale,
);
const articleWord = pluralize(
  posts.length,
  {
    one: t("pages.blogTags.articleSingular"),
    other: t("pages.blogTags.articlePlural"),
  },
  locale,
);

// Short intro prose per surviving tag, turning a pure listing page into one
// with its own content. `tag` is already lowercased by getUniqueTags(), which
// matches the tagIntro key casing below. Not every tag necessarily has one
// (e.g. new tags added before prose is written), so fall back to omitting the
// paragraph rather than showing the raw, unresolved key.
const tagIntroKey = `pages.blogTags.tagIntro.${tag}` as TranslationKey;
const tagIntro = t(tagIntroKey);
const hasTagIntro = tagIntro !== tagIntroKey;

// Schema.org: CollectionPage with ItemList
const schema = {
  "@type": "CollectionPage",
  "@id": new URL("#collection", new URL(Astro.url.pathname, getSiteUrl())).href,
  name: t("pages.blogTags.schemaName", { tag }),
  description: t("pages.blogTags.schemaDescription", {
    count: posts.length,
    tag,
  }),
  url: new URL(Astro.url.pathname, getSiteUrl()).href,
  inLanguage: locale,
  isPartOf: { "@id": new URL("#website", getSiteUrl()).href },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index): ListItem => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(translatePath(`/blog/${post.data.slug}/`), getSiteUrl())
        .href,
      name: post.data.title,
    })),
  },
} satisfies CollectionPage;
---

{
  /*
    `noindex, follow` — deliberate, and evidence-based rather than a blanket
    "listings are thin" rule.

    Tag pages were observed taking the citation slot from the articles whose
    text was being quoted: on a query about encrypt-then-MAC, an AI answer
    reproduced post 011's wording while citing /blog/tags/cryptography/, and
    post 011 itself never surfaced. The tag page adds no prose of its own — it
    is titles and dates over content that already exists at a canonical URL —
    so when it outranks its own members it costs a citation and returns
    nothing.

    `follow` is the important half: these pages stay fully crawlable and keep
    passing signal to the posts they list. Only the listing is withheld from
    the index, not the paths through it.

    The curated series hubs under /blog/series/ are NOT treated this way. They
    carry original framing that exists nowhere else, which is exactly the thing
    a tag page lacks.
  */
}
<BaseLayout
  title={`${t("pages.blogTags.titlePrefix")}${tag}`}
  description={t("pages.blogTags.metaDescription", {
    count: posts.length,
    articleWord,
    tag,
  })}
  schema={schema}
  noIndex={true}
>
  <div class="content-wrapper">
    <header class="page-header">
      <div
        class="lab-grid"
        aria-hidden="true"
      >
      </div>
      <p class="kicker section-title">{t("pages.blog.kicker")}</p>
      <h1>#{tag}</h1>
      {hasTagIntro && <p class="tag-intro">{tagIntro}</p>}
      <p class="subtitle">
        {posts.length}
        {postWord}
        {t("pages.blogTags.aboutTopic")}
      </p>
      <div class="back-link">
        <a href={translatePath("/blog/")}
          >{t("pages.blogTags.backToAllPosts")}</a
        >
      </div>
    </header>

    <div class="blog-body">
      <TagCloud activeTag={tag} />
      <PostGrid posts={posts} />
    </div>
  </div>
</BaseLayout>

<style>
  /* Left-aligned "Lab" header with mono kicker + ambient grid.
     Overrides the centered defaults from blog.css. */
  .page-header {
    position: relative;
    padding-bottom: var(--space-md-lg);
    overflow: hidden;
    text-align: left;
    border-bottom: 1px solid var(--color-hair);
  }

  .page-header > .lab-grid {
    z-index: 0;
  }

  .page-header :where(.kicker, h1, .subtitle, .back-link) {
    position: relative;
    z-index: 1;
  }

  .kicker {
    margin-bottom: var(--space-sm);
  }

  .page-header h1 {
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .tag-intro {
    max-width: 65ch;
    margin-bottom: var(--space-sm);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text);
  }

  .subtitle {
    font-size: var(--text-md);
    color: var(--color-text);
  }

  .blog-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
</style>
