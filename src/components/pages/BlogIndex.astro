---
/**
 * Blog Index shared component.
 * Lists all published blog posts, sorted by date (newest first).
 */
import "@styles/blog.css";

import FeaturedPost from "@components/blog/FeaturedPost.astro";
import PostGrid from "@components/blog/PostGrid.astro";
import TagCloud from "@components/blog/TagCloud.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getPostsForLocale } from "@utils/blog";
import { getSiteUrl } from "@utils/site";
import { getImage } from "astro:assets";
import type { CollectionPage, ListItem } from "schema-dts";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const entries = await getPostsForLocale(locale);
const posts = entries.map((e) => e.post);

// Hero = the post flagged `featured: true` (fallback: most recent). The rest
// keep their date order in the grid below.
const featuredPost = posts.find((p) => p.data.featured) ?? posts[0];
const gridPosts = posts.filter((p) => p !== featuredPost);

// Optimize LCP image for preload
const lcpPost = featuredPost;
let lcpImagePreload = null;

if (lcpPost && lcpPost.data.coverImage) {
  const optimizedLcp = await getImage({
    src: lcpPost.data.coverImage,
    format: "webp",
    width: 400,
    height: 225,
    widths: [360, 480, 640, 720, 960, 1200],
    quality: 60,
  });
  lcpImagePreload = {
    href: optimizedLcp.src,
    imagesrcset: optimizedLcp.srcSet.attribute,
    imagesizes: "(max-width: 640px) 100vw, 400px",
  };
}

// Schema.org: CollectionPage with ItemList for Blog Index
const baseUrl = new URL(Astro.url.pathname, getSiteUrl()).href;
const schema = {
  "@type": "CollectionPage",
  "@id": `${baseUrl}#collection`,
  name: t("pages.blog.schemaName"),
  description: t("pages.blog.description"),
  url: baseUrl,
  inLanguage: locale,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index): ListItem => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(translatePath(`/blog/${post.data.slug}/`), getSiteUrl())
        .href,
      name: post.data.title,
    })),
  },
} satisfies CollectionPage;
---

<BaseLayout
  title={t("pages.blog.title")}
  description={t("pages.blog.description")}
  schema={schema}
>
  {
    lcpImagePreload && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={lcpImagePreload.href}
        imagesrcset={lcpImagePreload.imagesrcset}
        imagesizes={lcpImagePreload.imagesizes}
        fetchpriority="high"
      />
    )
  }
  <div class="content-wrapper">
    <header class="page-header">
      <div
        class="lab-grid"
        aria-hidden="true"
      >
      </div>
      <div class="page-header__intro">
        <p class="kicker section-title">{t("pages.blog.kicker")}</p>
        <h1>{t("pages.blog.title")}</h1>
        <p class="subtitle">{t("pages.blog.subtitle")}</p>
      </div>
      <div class="page-header__controls">
        <div class="blog-search">
          <span
            class="i-mdi:magnify blog-search__icon"
            aria-hidden="true"
          ></span>
          <input
            type="search"
            class="blog-search__input"
            placeholder={t("pages.blog.searchPlaceholder")}
            aria-label={t("pages.blog.searchLabel")}
            data-blog-search
          />
        </div>
        <a
          class="blog-rss"
          href="/rss.xml"
          aria-label={t("pages.blog.rssLabel")}
        >
          <span
            class="i-mdi:rss"
            aria-hidden="true"
          ></span>
        </a>
      </div>
    </header>

    <div class="blog-body">
      <TagCloud />
      <p class="ai-disclaimer">{t("pages.blog.aiDisclaimer")}</p>
      {featuredPost && <FeaturedPost post={featuredPost} />}
      <PostGrid posts={gridPosts} />
    </div>
  </div>

  <script is:inline>
    (function () {
      const search = document.querySelector("[data-blog-search]");
      const filterNav = document.querySelector("[data-tag-filter]");
      const empty = document.querySelector("[data-posts-empty]");
      const cards = Array.prototype.slice.call(
        document.querySelectorAll("[data-post]"),
      );
      let activeTag = "";
      let query = "";

      function apply() {
        let visible = 0;
        cards.forEach(function (card) {
          const tags = (card.getAttribute("data-tags") || "").split(" ");
          const hay = card.getAttribute("data-search") || "";
          const matchTag = !activeTag || tags.indexOf(activeTag) !== -1;
          const matchQuery = !query || hay.indexOf(query) !== -1;
          const show = matchTag && matchQuery;
          card.hidden = !show;
          if (show) visible++;
        });
        if (empty) empty.hidden = visible > 0;
      }

      if (search) {
        search.addEventListener("input", function (e) {
          query = (e.target.value || "").trim().toLowerCase();
          apply();
        });
      }

      if (filterNav) {
        filterNav.addEventListener("click", function (e) {
          const pill = e.target.closest("[data-tag]");
          if (!pill) return;
          e.preventDefault();
          activeTag = pill.getAttribute("data-tag") || "";
          filterNav.querySelectorAll(".tag-pill").forEach(function (p) {
            p.classList.toggle("is-active", p === pill);
          });
          apply();
        });
      }
    })();
  </script>
</BaseLayout>

<style>
  /* Left-aligned "Lab" header with mono kicker + ambient grid.
     Overrides the centered defaults from blog.css. */
  .page-header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: var(--space-md-lg);
    overflow: hidden;
    text-align: left;
    border-bottom: 1px solid var(--color-hair);
  }

  .page-header > .lab-grid {
    z-index: 0;
  }

  .page-header__intro,
  .page-header__controls {
    position: relative;
    z-index: 1;
  }

  .page-header__controls {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
  }

  .blog-search {
    display: flex;
    gap: 0.6em;
    align-items: center;
    min-width: 200px;
    padding: 8px 14px;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .blog-search:focus-within {
    border-color: var(--color-accent);
  }

  .blog-search__icon {
    flex: none;
    font-size: 0.95rem;
  }

  .blog-search__input {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text);
    outline: none;
    background: transparent;
    border: 0;
  }

  .blog-search__input::placeholder {
    color: var(--color-text-muted);
  }

  .blog-rss {
    display: grid;
    flex: none;
    place-items: center;
    width: 42px;
    height: 42px;
    font-size: 1rem;
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .blog-rss:hover {
    background: var(--accent-dim);
    border-color: var(--accent-line);
  }

  .blog-rss:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .kicker {
    margin-bottom: var(--space-sm);
  }

  .page-header h1 {
    margin-bottom: var(--space-md);
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    font-weight: var(--fw-bold);
    color: var(--color-text-heading);
  }

  .subtitle {
    max-width: 52ch;
    font-size: 1.0625rem;
    color: var(--color-text);
  }

  .ai-disclaimer {
    max-width: 70ch;
    margin: 0;
    font-size: 0.8125rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .blog-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
</style>
