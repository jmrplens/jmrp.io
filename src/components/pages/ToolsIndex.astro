---
/**
 * Tools Index shared component.
 * Displays available interactive tools as a filterable card grid,
 * ordered by category (security → mikrotik).
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";
import { getToolsForLocale } from "@utils/tools";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

/** Category display metadata. Order determines rendering order. */
const categoryMeta: Record<string, { short: string; order: number }> = {
  security: { short: t("pages.tools.shortSecurity"), order: 1 },
  developer: { short: t("pages.tools.shortDeveloper"), order: 2 },
  network: { short: t("pages.tools.shortNetwork"), order: 3 },
  embedded: { short: t("pages.tools.shortEmbedded"), order: 4 },
  mikrotik: { short: t("pages.tools.shortMikrotik"), order: 5 },
};

const toolEntries = await getToolsForLocale(locale);
const allTools = toolEntries.map((e) => e.tool);

/** Group tools by category and sort categories by defined order. */
const categories = Object.values(
  allTools.reduce<
    Record<string, { id: string; short: string; tools: typeof allTools }>
  >((acc, tool) => {
    const cat = tool.data.category;
    if (!acc[cat]) {
      acc[cat] = {
        id: cat,
        short: categoryMeta[cat]?.short ?? cat,
        tools: [],
      };
    }
    acc[cat].tools.push(tool);
    return acc;
  }, {}),
).sort(
  (a, b) =>
    (categoryMeta[a.id]?.order ?? 99) - (categoryMeta[b.id]?.order ?? 99),
);

/** Flat, category-ordered list rendered into the grid. */
const orderedTools = categories.flatMap((c) =>
  c.tools.map((tool) => ({ tool, short: c.short })),
);

const baseUrl = new URL(Astro.url.pathname, getSiteUrl());
const collectionUrl = new URL("#collection", baseUrl).href;

const toolsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": collectionUrl,
  name: t("pages.tools.title"),
  description: t("pages.tools.description"),
  inLanguage: locale,
  hasPart: allTools.map((tool) => {
    const toolUrl = new URL(`/tools/${tool.data.slug}/`, getSiteUrl()).href;
    return {
      "@type": "SoftwareApplication",
      name: tool.data.title,
      description: tool.data.description,
      url: toolUrl,
      applicationCategory: "WebApplication",
      operatingSystem: "Web Browser",
    };
  }),
};
---

<BaseLayout
  title={t("nav.tools")}
  description={t("pages.tools.description")}
  schema={toolsSchema}
>
  <div class="container">
    <header class="tools-hero">
      <div
        class="lab-grid"
        aria-hidden="true"
      >
      </div>
      <p class="section-title">{t("nav.tools")}</p>
      <h1 class="tools-title">{t("pages.tools.title")}</h1>
      <p class="intro">{t("pages.tools.intro")}</p>
      <p class="status-pill">
        <span
          class="status-dot"
          aria-hidden="true"
        ></span>
        <span class="status-text"
          >{t("pages.tools.statusPrivacy")} · {
            t("pages.tools.statusTelemetry")
          }</span
        >
      </p>
    </header>

    <nav
      class="filter-bar"
      aria-label={t("pages.tools.filterLabel")}
    >
      <a
        href={translatePath("/tools/")}
        class="chip chip--active"
        aria-current="page"
      >
        {t("pages.tools.filterAll")} · {allTools.length}
      </a>
      {
        categories.map((category) => (
          <a
            href={translatePath(`/tools/categories/${category.id}/`)}
            class="chip"
          >
            {category.short}
          </a>
        ))
      }
    </nav>

    <div class="tools-grid">
      {
        orderedTools.map(({ tool, short }) => (
          <a
            href={translatePath(`/tools/${tool.data.slug}/`)}
            class="tool-card"
          >
            <span class="tool-card__top">
              <span class={`tool-badge tool-badge--${tool.data.category}`}>
                <span class="sr-only">{t("pages.tools.categoryLabel")}: </span>
                {short}
              </span>
              <span
                class="i-mdi:arrow-top-right tool-arrow"
                aria-hidden="true"
              />
            </span>
            <h2 class="tool-name">{tool.data.title}</h2>
            <p class="tool-description">{tool.data.description}</p>
          </a>
        ))
      }
    </div>

    <section
      class="info-section"
      aria-label={t("pages.tools.aboutTitle")}
    >
      <h2 class="section-title">{t("pages.tools.aboutTitle")}</h2>

      <div class="info-grid">
        <div class="info-item">
          <span
            class="i-mdi:shield-account info-icon"
            aria-hidden="true"
          ></span>
          <div class="info-content">
            <strong>{t("pages.tools.privacyTitle")}</strong>
            <p>{t("pages.tools.privacyDesc")}</p>
          </div>
        </div>
        <div class="info-item">
          <span
            class="i-mdi:lightning-bolt info-icon"
            aria-hidden="true"
          ></span>
          <div class="info-content">
            <strong>{t("pages.tools.instantTitle")}</strong>
            <p>{t("pages.tools.instantDesc")}</p>
          </div>
        </div>
        <div class="info-item">
          <span
            class="i-mdi:open-source-initiative info-icon"
            aria-hidden="true"
          ></span>
          <div class="info-content">
            <strong>{t("pages.tools.openSourceTitle")}</strong>
            <p>
              {t("pages.tools.openSourceDesc").replace("{link}", "")}
              <a
                href="https://github.com/jmrplens/jmrp.io"
                target="_blank"
                rel="noopener noreferrer"
                >GitHub</a
              >.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Hero — kicker + display title + intro + status, over ambient grid. */
  .tools-hero {
    position: relative;
    padding: var(--space-lg) 0 var(--space-md-lg);
    margin-top: var(--space-md);
    overflow: hidden;
  }

  .tools-hero > :not(.lab-grid) {
    position: relative;
    z-index: 1;
  }

  .tools-title {
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
  }

  .intro {
    max-width: 42rem;
    margin: 0 0 var(--space-md);
    font-size: var(--text-md);
    line-height: 1.7;
    color: var(--color-text);
  }

  .status-pill {
    display: inline-flex;
    gap: var(--space-sm);
    align-items: center;
    margin: 0;
  }

  .status-dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--teal);
    border-radius: 50%;
  }

  .status-text {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Filter chips — real links to category pages; active = solid amber. */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .chip {
    display: inline-flex;
    gap: 0.4em;
    align-items: center;
    padding: 0.375rem 0.875rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      background var(--dur-1) var(--ease-out);
  }

  .chip:hover {
    color: var(--color-text-heading);
    border-color: var(--color-primary);
  }

  .chip--active,
  .chip--active:hover {
    font-weight: var(--fw-medium);
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .chip:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Tool cards */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md-lg);
    text-decoration: none;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  .tool-card:hover {
    border-color: var(--color-border);
    box-shadow: var(--sh-card);
    transform: translateY(-2px);
  }

  .tool-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .tool-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .tool-badge {
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-heading);
    letter-spacing: 0.02em;
    background: var(--accent-dim);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-sm);
  }

  /* Per-category badge colour variants.
     Security keeps the default amber/accent tint; the others use their
     respective brand tokens with the same colour-mix pattern as callouts. */
  .tool-badge--security {
    color: var(--color-accent);
  }

  .tool-badge--network {
    color: var(--teal-text);
    background: color-mix(in srgb, var(--teal) 13%, transparent);
    border-color: color-mix(in srgb, var(--teal) 32%, transparent);
  }

  .tool-badge--developer {
    color: var(--violet);
    background: color-mix(in srgb, var(--violet) 13%, transparent);
    border-color: color-mix(in srgb, var(--violet) 32%, transparent);
  }

  .tool-badge--embedded {
    color: var(--color-info);
    background: color-mix(in srgb, var(--color-info) 13%, transparent);
    border-color: color-mix(in srgb, var(--color-info) 32%, transparent);
  }

  .tool-badge--mikrotik {
    color: var(--color-success);
    background: color-mix(in srgb, var(--color-success) 13%, transparent);
    border-color: color-mix(in srgb, var(--color-success) 32%, transparent);
  }

  .tool-arrow {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-text-muted);
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .tool-card:hover .tool-arrow,
  .tool-card:focus-visible .tool-arrow {
    color: var(--color-primary);
    transform: translate(2px, -2px);
  }

  .tool-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--fw-medium);
    line-height: 1.2;
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .tool-description {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-line-clamp: 3;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
    -webkit-box-orient: vertical;
  }

  /* About section */
  .info-section {
    margin-bottom: var(--space-xl);
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--space-md);
  }

  .info-item {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    padding: var(--space-md);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-lg);
  }

  .info-icon {
    flex-shrink: 0;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 1px;
    color: var(--color-primary);
  }

  .info-content {
    min-width: 0;
  }

  .info-content strong {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--color-text-heading);
  }

  .info-content p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .info-content a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .info-content a:hover {
    text-decoration: none;
  }

  @media (width <= 640px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip,
    .tool-card,
    .tool-arrow {
      transition: none;
    }

    .tool-card:hover {
      transform: none;
    }
  }
</style>
