---
/**
 * Tools Index shared component.
 * Displays available interactive tools grouped by category.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";
import { getToolsForLocale } from "@utils/tools";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

/** Category display metadata. Order determines rendering order. */
const categoryMeta: Record<string, { name: string; order: number }> = {
  security: { name: t("pages.tools.categorySecurity"), order: 1 },
  developer: { name: t("pages.tools.categoryDeveloper"), order: 2 },
  network: { name: t("pages.tools.categoryNetwork"), order: 3 },
  embedded: { name: t("pages.tools.categoryEmbedded"), order: 4 },
  mikrotik: { name: t("pages.tools.categoryMikrotik"), order: 5 },
};

const toolEntries = await getToolsForLocale(locale);
const allTools = toolEntries.map((e) => e.tool);

/** Group tools by category and sort categories by defined order. */
const categories = Object.entries(
  allTools.reduce<
    Record<string, { id: string; name: string; tools: typeof allTools }>
  >((acc, tool) => {
    const cat = tool.data.category;
    if (!acc[cat]) {
      acc[cat] = {
        id: cat,
        name: categoryMeta[cat]?.name ?? cat,
        tools: [],
      };
    }
    acc[cat].tools.push(tool);
    return acc;
  }, {}),
)
  .map(([, value]) => value)
  .sort(
    (a, b) =>
      (categoryMeta[a.id]?.order ?? 99) - (categoryMeta[b.id]?.order ?? 99),
  );

const baseUrl = new URL(Astro.url.pathname, getSiteUrl());
const collectionUrl = new URL("#collection", baseUrl).toString();

const toolsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": collectionUrl,
  name: t("pages.tools.title"),
  description: t("pages.tools.description"),
  inLanguage: locale,
  hasPart: allTools.map((tool) => {
    const toolUrl = new URL(
      `/tools/${tool.data.slug}/`,
      getSiteUrl(),
    ).toString();
    return {
      "@type": "SoftwareApplication",
      name: tool.data.title,
      description: tool.data.description,
      url: toolUrl,
      applicationCategory: "WebApplication",
      operatingSystem: "Web Browser",
    };
  }),
};
---

<BaseLayout
  title={t("nav.tools")}
  description={t("pages.tools.description")}
  schema={toolsSchema}
>
  <div class="container">
    <h1 class="page-title">{t("pages.tools.title")}</h1>
    <p class="intro">
      {t("pages.tools.intro")}
    </p>

    {
      categories.map((category) => (
        <section
          class="tools-section"
          aria-label={category.name}
        >
          <div class="section-header">
            <h2>
              <a href={translatePath(`/tools/categories/${category.id}/`)}>
                {category.name}
              </a>
            </h2>
          </div>

          <div class="tools-grid">
            {category.tools.map((tool) => (
              <a
                href={translatePath(`/tools/${tool.data.slug}/`)}
                class="tool-card"
              >
                <span
                  class={`tool-icon ${tool.data.icon}`}
                  aria-hidden="true"
                />
                <div class="tool-content">
                  <h3 class="tool-name">{tool.data.title}</h3>
                  <p class="tool-description">{tool.data.description}</p>
                </div>
                <span
                  class="i-mdi:chevron-right tool-arrow"
                  aria-hidden="true"
                />
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <section
      class="info-section"
      aria-label={t("pages.tools.aboutTitle")}
    >
      <div class="section-header">
        <h2>{t("pages.tools.aboutTitle")}</h2>
      </div>

      <div class="info-grid">
        <div class="info-item">
          <span
            class="i-mdi:shield-account info-icon"
            aria-hidden="true"
          ></span>
          <div class="info-content">
            <strong>{t("pages.tools.privacyTitle")}</strong>
            <p>
              {t("pages.tools.privacyDesc")}
            </p>
          </div>
        </div>
        <div class="info-item">
          <span
            class="i-mdi:lightning-bolt info-icon"
            aria-hidden="true"
          ></span>
          <div class="info-content">
            <strong>{t("pages.tools.instantTitle")}</strong>
            <p>
              {t("pages.tools.instantDesc")}
            </p>
          </div>
        </div>
        <div class="info-item">
          <span
            class="i-mdi:open-source-initiative info-icon"
            aria-hidden="true"
          ></span>
          <div class="info-content">
            <strong>{t("pages.tools.openSourceTitle")}</strong>
            <p>
              {t("pages.tools.openSourceDesc").replace("{link}", "")}
              <a
                href="https://github.com/jmrplens/jmrp.io"
                target="_blank"
                rel="noopener noreferrer"
                >GitHub</a
              >.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    max-width: 600px;
    margin-bottom: var(--space-xl);
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .tools-section,
  .info-section {
    margin-bottom: var(--space-2xl);
  }

  .section-header {
    margin-bottom: var(--space-lg);
    border-bottom: 2px solid var(--color-border);
  }

  .section-header h2 {
    display: inline-block;
    padding-bottom: var(--space-sm);
    margin-bottom: -2px;
    font-size: 1.5rem;
    font-weight: var(--fw-bold);
    border-bottom: 2px solid var(--color-primary);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-sm);
  }

  .tool-card {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    padding: 0.625rem 0.75rem;
    text-decoration: none;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .tool-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 1px 4px rgb(0 0 0 / 8%);
  }

  .tool-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .tool-icon {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-primary);
  }

  .tool-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .tool-name {
    margin: 0;
    font-size: 0.9rem;
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    color: var(--color-text-heading);
  }

  .tool-description {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-line-clamp: 2;
    font-size: 0.775rem;
    line-height: 1.4;
    color: var(--color-text-muted);
    -webkit-box-orient: vertical;
  }

  .tool-arrow {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    color: var(--color-text-muted);
    opacity: 50%;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .tool-card:hover .tool-arrow {
    color: var(--color-primary);
    opacity: 100%;
    transform: translateX(2px);
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: var(--space-sm);
  }

  .info-item {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    padding: 0.625rem 0.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .info-icon {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 1px;
    color: var(--color-primary);
  }

  .info-content {
    min-width: 0;
  }

  .info-content strong {
    display: block;
    margin-bottom: 0.125rem;
    font-size: 0.85rem;
    color: var(--color-text-heading);
  }

  .info-content p {
    margin: 0;
    font-size: 0.775rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .info-content a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .info-content a:hover {
    text-decoration: none;
  }

  @media (width <= 640px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-card,
    .tool-arrow {
      transition: none;
    }
  }
</style>
