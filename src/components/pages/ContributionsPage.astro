---
/**
 * "Open-source contributions" — the /projects/contributions/ subpage
 * (PLAN.md section 2.2). 100% build-time: no `PRJ_*` token anywhere, so the
 * page keeps the edge worker's cache and Early Hints. Every figure comes
 * from `src/data/ghc/projects-contributions.json`, generated at pre-build by
 * `scripts/ghc/build-data.mjs` (falls back to the committed fixture when
 * InfluxDB is unreachable).
 */
import AchievementShelf from "@components/projects/AchievementShelf.astro";
import { asContributionsDataset } from "@components/projects/dataset-types";
import PlatformMark from "@components/projects/PlatformMark.astro";
import FAQ from "@components/ui/FAQ.astro";
import rawContributionsData from "@data/ghc/projects-contributions.json";
import { defaultLocale, type Locale } from "@i18n/config";
import {
  formatCompactStars,
  formatDate,
  formatNumber,
  pluralize,
  useTranslatedPath,
  useTranslations,
} from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  itemRef,
  itemUrl,
  platformOf,
  repoUrl,
} from "@utils/contribution-links";
import { getPageFaq, pageFaqNode } from "@utils/page-faq";
import { getSiteUrl } from "@utils/site";
import { getEntry } from "astro:content";
import type { CollectionPage, ItemList, SoftwareSourceCode } from "schema-dts";

import { foldProjectName } from "../../../scripts/ghc/contributions-yaml.mjs";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const pageUrl = new URL(Astro.url.pathname, getSiteUrl()).href;
const projectsUrl = new URL(translatePath("/projects/"), getSiteUrl()).href;

const contributionsEntry = await getEntry("profile", "contributions");
if (contributionsEntry?.data.type !== "contributions") {
  throw new Error(
    "profile/contributions.yaml is missing or has the wrong type",
  );
}
const { displayName } = contributionsEntry.data;

const contributionsData = asContributionsDataset(rawContributionsData);
const {
  summary,
  highlights: rawHighlights,
  contributedTo,
  acceptedAnswers,
  ledgerByYear,
  achievements,
} = contributionsData;

const asOfDate = new Date(contributionsData.asOf);
const gitlabUsername = contributionsData.gitlab?.username ?? "jmrp";

const contributedToStarsByProject = new Map(
  contributedTo.map((row) => [row.project, row.stars]),
);

const highlights = rawHighlights.slice(0, 7).map((h) => ({
  repo: h.repo,
  number: h.number,
  kind: h.kind,
  platform: platformOf(h.platform),
  why: h.why[locale],
  url: itemUrl({ ...h, fullName: h.repo }),
  stars:
    contributedToStarsByProject.get(foldProjectName(h.repo, displayName)) ??
    null,
}));

const totalPrs =
  summary.contributionTotals.prMerged +
  summary.contributionTotals.prOpen +
  summary.contributionTotals.prClosed;
const totalIssues =
  summary.contributionTotals.issuesOpen +
  summary.contributionTotals.issuesClosed;

/** A "{count} merged/open/closed" label with the singular form for 1. */
function countLabel(
  key: "summaryMerged" | "summaryOpen" | "summaryClosed",
  count: number,
): string {
  return t(`pages.projectsContributions.${key}${count === 1 ? "One" : ""}`, {
    count,
  });
}

/**
 * A ledger row's visible label: "#N title" (GitLab merge requests: "!N
 * title"), prefixed with the repo name only when the project group spans
 * more than one repository.
 */
function itemLabel(
  items: readonly { fullName: string }[],
  item: {
    fullName: string;
    number: number;
    title: string | null;
    kind: "pull_request" | "issue";
    platform?: string;
  },
): string {
  const multiRepo = new Set(items.map((it) => it.fullName)).size > 1;
  const prefix = multiRepo ? `${item.fullName.split("/").at(-1) ?? ""} ` : "";
  return `${prefix}${itemRef(item)} ${item.title ?? ""}`.trim();
}

/**
 * GitLab's merge request list, filtered to this account, for the project
 * with the most items in one folded group (GitLab has no cross-project
 * search a visitor can open without signing in).
 */
function gitlabListing(items: readonly { fullName: string }[]): {
  repo: string;
  url: string;
} {
  const counts = new Map<string, number>();
  for (const it of items)
    counts.set(it.fullName, (counts.get(it.fullName) ?? 0) + 1);
  const [repo] = [...counts].sort((a, b) => b[1] - a[1])[0];
  const params = new URLSearchParams({
    author_username: gitlabUsername,
    state: "all",
  });
  return {
    repo,
    url: `${repoUrl(repo, "gitlab")}/-/merge_requests?${params.toString()}`,
  };
}

/** GitHub search for this account's PRs in every repo of one folded project. */
function githubSearchUrl(items: readonly { fullName: string }[]): string {
  const repos = [...new Set(items.map((it) => it.fullName))]
    .map((fullName) => `repo:${fullName}`)
    .join(" ");
  const query = `is:pr author:jmrplens ${repos}`;
  return `https://github.com/search?type=pullrequests&q=${encodeURIComponent(query)}`;
}

// ── Code and documentation ledger: one box per project, no years ──────────
const years = Object.keys(ledgerByYear).sort((a, b) => Number(b) - Number(a));
const MAX_ITEMS_PER_PROJECT = 10;

/** Duration between two points, in hours, as a short localized string. */
function formatHours(hours: number): string {
  if (hours < 24) {
    const rounded = Math.round(hours);
    return `${rounded} ${pluralize(rounded, { one: "h", other: "h" }, locale)}`;
  }
  const days = Math.round(hours / 24);
  return `${days} ${pluralize(days, { one: locale === "es" ? "día" : "day", other: locale === "es" ? "días" : "days" }, locale)}`;
}

/** A ledger item's lifecycle state. */
type LedgerState = "merged" | "open" | "closed";

/** CSS class for a ledger item's state pill. */
function pillClass(state: LedgerState): string {
  if (state === "merged") return "pill pill--ok";
  if (state === "open") return "pill pill--open";
  return "pill pill--no";
}

/** Localized text for a ledger item's state pill. */
function pillText(state: LedgerState): string {
  if (state === "merged")
    return t("pages.projectsContributions.itemMergedPill");
  if (state === "open") return t("pages.projectsContributions.itemOpenPill");
  return t("pages.projectsContributions.itemNotMergedPill");
}

/** The right-hand timing note for a ledger item (merged-in / under review / opened-on). */
function itemTiming(item: {
  state: LedgerState;
  hoursToMerge: number | null;
  createdAt: string;
}): string {
  if (item.state === "merged" && item.hoursToMerge !== null) {
    return t("pages.projectsContributions.mergedIn", {
      duration: formatHours(item.hoursToMerge),
    });
  }
  if (item.state === "open") {
    return t("pages.projectsContributions.underReview");
  }
  return t("pages.projectsContributions.openedOn", {
    date: formatDate(new Date(item.createdAt), locale),
  });
}

interface LedgerProject {
  project: string;
  items: (typeof ledgerByYear)[string][string];
  merged: number;
  open: number;
  platform: "github" | "gitlab";
}

// One box per project across every year. Closed-unmerged PRs are a single
// count, never rows; a project left with no rows disappears.
const allLedgerItems = years.flatMap((year) =>
  Object.entries(ledgerByYear[year]).flatMap(([project, items]) =>
    items.map((item) => ({ project, item })),
  ),
);
const itemsByProject = new Map<string, LedgerProject["items"][number][]>();
for (const { project, item } of allLedgerItems) {
  if (item.state === "closed") continue;
  const list = itemsByProject.get(project) ?? [];
  list.push(item);
  itemsByProject.set(project, list);
}
const projectEntries: LedgerProject[] = [...itemsByProject]
  .map(([project, items]) => ({
    project,
    items: items.sort(
      (a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt),
    ),
    merged: items.filter((it) => it.state === "merged").length,
    open: items.filter((it) => it.state === "open").length,
    platform: platformOf(items[0]?.platform),
  }))
  // Projects with merged work first, then open-only ones; each group by
  // most recent activity, so an old project cannot outrank this month's.
  .sort(
    (a, b) =>
      Number(b.merged > 0) - Number(a.merged > 0) ||
      Date.parse(b.items[0].createdAt) - Date.parse(a.items[0].createdAt),
  );
const notMergedCount = allLedgerItems.filter(
  ({ item }) => item.state === "closed",
).length;

// ── Distribution and listings, grouped by MY project, then by target ─────
const listingsByOwn = Object.entries(contributionsData.listingsByOwnProject)
  .filter(([own]) => own !== "other")
  .map(([own, targets]) => ({
    own,
    targets: Object.entries(targets).map(([name, row]) => ({
      name,
      fullName: row.fullName,
      url: repoUrl(row.fullName, "github"),
      merged: row.merged,
      open: row.open,
    })),
  }));

/** What kind of place a listing repository is, for the "where" column. */
function listingKind(fullName: string): "packages" | "registry" | "list" {
  const repo = fullName.split("/", 2)[1] ?? fullName;
  if (repo.startsWith("awesome-")) return "list";
  if (fullName === "docker/mcp-registry" || fullName === "crowdsecurity/hub")
    return "registry";
  return "packages";
}

// ── Issues reported, folded by project ─────────────────────────────────────
const issuesByProject = new Map(
  Object.entries(contributionsData.issuesByProject).sort(
    ([, a], [, b]) => b.open + b.closed - (a.open + a.closed),
  ),
);

const answersAnchor = "answers";

const schema = {
  "@type": "CollectionPage",
  "@id": `${pageUrl}#contributions`,
  name: t("pages.projectsContributions.title"),
  description: t("pages.projectsContributions.schemaDescription"),
  url: pageUrl,
  inLanguage: locale,
  isPartOf: { "@id": new URL("#website", getSiteUrl()).href },
  about: { "@id": new URL("#person", getSiteUrl()).href },
  breadcrumb: { "@id": `${projectsUrl}#projects` },
  mainEntity: {
    "@type": "ItemList",
    "@id": `${pageUrl}#upstream-list`,
    name: t("pages.projectsContributions.heading"),
    numberOfItems: contributedTo.length,
    itemListOrder: "https://schema.org/ItemListUnordered",
    itemListElement: contributedTo.map((row, index) => ({
      "@type": "ListItem" as const,
      position: index + 1,
      item: {
        "@type": "SoftwareSourceCode",
        name: row.project,
        codeRepository: repoUrl(row.repo, row.platform),
      } satisfies SoftwareSourceCode,
    })),
  } satisfies ItemList,
} satisfies CollectionPage;

const pageFaq = await getPageFaq("/projects/contributions/", locale);
const faqNode = pageFaq && pageFaqNode(pageFaq, pageUrl, schema["@id"], locale);
---

<BaseLayout
  title={t("pages.projectsContributions.title")}
  description={t("pages.projectsContributions.description")}
  schema={faqNode ? [schema, faqNode].flat() : schema}
>
  <div class="contrib container">
    <header class="contrib-header">
      <p class="contrib-header__kicker">
        <a href={translatePath("/projects/")}>
          {t("pages.projectsContributions.backToProjects")}
        </a>
      </p>
      <h1 class="page-title contrib-header__title">
        {t("pages.projectsContributions.heading")}
      </h1>
      <p class="contrib-header__intro">
        {t("pages.projectsContributions.snapshotIntro", {
          date: formatDate(asOfDate, locale),
          prs: formatNumber(totalPrs, locale),
          issues: formatNumber(totalIssues, locale),
          repos: formatNumber(summary.contributionTotals.repos, locale),
        })}
      </p>
    </header>

    <dl class="contrib-tiles">
      <div class="contrib-tile">
        <dd>{summary.codeVsListingSplit.codeOrDocs.merged}</dd>
        <dt>{t("pages.projects.upstream.tileCodeMerged")}</dt>
      </div>
      <div class="contrib-tile">
        <dd>{summary.codeVsListingSplit.listing.merged}</dd>
        <dt>{t("pages.projects.upstream.tileListingMerged")}</dt>
      </div>
      <div class="contrib-tile">
        <dd>{summary.codeVsListingSplit.codeOrDocs.open}</dd>
        <dt>{t("pages.projects.upstream.tilePrOpen")}</dt>
      </div>
      <div class="contrib-tile">
        <dd>{summary.answersCount}</dd>
        <dt>{t("pages.projects.upstream.tileAnswers")}</dt>
      </div>
    </dl>

    {highlights.length > 0 && (
      <section aria-labelledby="highlights-heading">
        <h2
          id="highlights-heading"
          class="contrib-h2"
        >
          {t("pages.projectsContributions.highlightsHeading")}
        </h2>
        <ol class="hl">
          {highlights.map((h) => (
            <li>
              <span class="pill pill--ok">
                {t("pages.projectsContributions.itemMergedPill")}
              </span>
              <span class="hl__title">
                <PlatformMark platform={h.platform} />
                <a
                  class="external-link"
                  href={h.url}
                  target="_blank"
                  rel="external noopener noreferrer"
                  lang="en"
                  aria-label={t("aria.opensNewTab", {
                    text: `${h.repo} ${itemRef(h)}`,
                  })}
                  set:text={`${h.repo} ${itemRef(h)}`}
                />
              </span>
              <p class="hl__why">{h.why}</p>
              {h.stars !== null && (
                <p class="hl__meta">
                  {formatCompactStars(h.stars, locale)}{" "}
                  <span aria-hidden="true">★</span>
                  <span class="sr-only">{t("aria.starsUnit")}</span>
                </p>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}

    <section aria-labelledby="ledger-heading">
      <h2
        id="ledger-heading"
        class="contrib-h2"
      >
        {t("pages.projectsContributions.ledgerHeading")}
      </h2>
      {projectEntries.map((entry, entryIndex) => (
        <details open={entryIndex === 0}>
          <summary>
            <b class="ledger-name">
              {entry.project}
              <PlatformMark platform={entry.platform} />
            </b>
            <span>
              {entry.merged > 0 && countLabel("summaryMerged", entry.merged)}
              {entry.merged > 0 && entry.open > 0 && " · "}
              {entry.open > 0 && countLabel("summaryOpen", entry.open)}
            </span>
            <span
              class="ledger-toggle"
              aria-hidden="true"
            >
              <span class="i-mdi:plus ledger-toggle__icon ledger-toggle__icon--closed" />
              <span class="i-mdi:minus ledger-toggle__icon ledger-toggle__icon--open" />
            </span>
          </summary>
          <ul class="items">
            {entry.items.slice(0, MAX_ITEMS_PER_PROJECT).map((item) => (
              <li>
                <span class={pillClass(item.state)}>
                  {pillText(item.state)}
                </span>
                {item.redacted || !item.title ? (
                  <span>{t("pages.projectsContributions.itemRedacted")}</span>
                ) : (
                  <span class="items__t">
                    <a
                      class="external-link"
                      href={itemUrl(item)}
                      target="_blank"
                      rel="external noopener noreferrer"
                      lang="en"
                      aria-label={t("aria.opensNewTab", {
                        text: `${item.fullName} ${itemRef(item)}: ${item.title}`,
                      })}
                      set:text={itemLabel(entry.items, item)}
                    />
                  </span>
                )}
                <span class="items__w">{itemTiming(item)}</span>
              </li>
            ))}
          </ul>
          {entry.items.length > MAX_ITEMS_PER_PROJECT &&
            entry.platform === "gitlab" && (
              <p class="items__more">
                {t("pages.projectsContributions.shownNewest", {
                  shown: MAX_ITEMS_PER_PROJECT,
                })}{" "}
                <a
                  class="external-link"
                  href={gitlabListing(entry.items).url}
                  target="_blank"
                  rel="external noopener noreferrer"
                  aria-label={t("aria.opensNewTab", {
                    text: t("pages.projectsContributions.seeAllOnGitlab", {
                      repo: gitlabListing(entry.items).repo,
                    }),
                  })}
                  set:text={t("pages.projectsContributions.seeAllOnGitlab", {
                    repo: gitlabListing(entry.items).repo,
                  })}
                />
              </p>
            )}
          {entry.items.length > MAX_ITEMS_PER_PROJECT &&
            entry.platform === "github" && (
              <p class="items__more">
                {t("pages.projectsContributions.shownNewest", {
                  shown: MAX_ITEMS_PER_PROJECT,
                })}{" "}
                <a
                  class="external-link"
                  href={githubSearchUrl(entry.items)}
                  target="_blank"
                  rel="external noopener noreferrer"
                  aria-label={t("aria.opensNewTab", {
                    text: t("pages.projectsContributions.seeAllOnGithub", {
                      total: entry.items.length,
                      project: entry.project,
                    }),
                  })}
                  set:text={t("pages.projectsContributions.seeAllOnGithub", {
                    total: entry.items.length,
                    project: entry.project,
                  })}
                />
              </p>
            )}
        </details>
      ))}
      {notMergedCount > 0 && (
        <p class="contrib-not-merged">
          {t("pages.projectsContributions.notMergedHeading", {
            count: notMergedCount,
          })}
        </p>
      )}
    </section>

    {listingsByOwn.length > 0 && (
      <section aria-labelledby="distribution-heading">
        <h2
          id="distribution-heading"
          class="contrib-h2"
        >
          {t("pages.projectsContributions.distributionHeading")}
        </h2>
        <p class="contrib-intro">
          {t("pages.projectsContributions.distributionIntro")}
        </p>
        {/* Two columns that wrap: the table fits at any width, so it needs
            no scroll region (and a region named like its section would be a
            duplicate landmark). */}
        <div class="table-wrap">
          <table class="listings">
            <thead>
              <tr>
                <th scope="col">
                  {t("pages.projectsContributions.distributionColProject")}
                </th>
                <th scope="col">
                  {t("pages.projectsContributions.distributionColWhere")}
                </th>
              </tr>
            </thead>
            {listingsByOwn.map(({ own, targets }) => (
              <tbody>
                {targets.map((target, i) => (
                  <tr>
                    {i === 0 && (
                      <th
                        scope="rowgroup"
                        rowspan={targets.length}
                        class="listings__own"
                      >
                        {own}
                      </th>
                    )}
                    <td>
                      <span class="listings__name">
                        {target.name}
                        <span class="listings__kind">
                          {t(
                            `pages.projectsContributions.listingKind.${listingKind(target.fullName)}`,
                          )}
                        </span>
                      </span>
                      <a
                        class="external-link listings__repo"
                        href={target.url}
                        target="_blank"
                        rel="external noopener noreferrer"
                        aria-label={t("aria.opensNewTab", {
                          text: `${target.fullName}, ${own}`,
                        })}
                        set:text={target.fullName}
                      />
                      <div class="listings__states">
                        {target.merged > 0 && (
                          <span class="pill pill--ok">
                            {target.merged > 1
                              ? t("pages.projectsContributions.mergedTimes", {
                                  count: target.merged,
                                })
                              : t("pages.projectsContributions.itemMergedPill")}
                          </span>
                        )}
                        {target.open > 0 && (
                          <span class="pill pill--open">
                            {t("pages.projectsContributions.underReviewPill")}
                          </span>
                        )}
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
      </section>
    )}

    <section
      id={answersAnchor}
      aria-labelledby="answers-heading"
    >
      <h2
        id="answers-heading"
        class="contrib-h2"
      >
        {t("pages.projectsContributions.answersHeading", {
          count: acceptedAnswers.length,
        })}
      </h2>
      <ul class="answers">
        {acceptedAnswers.map((a) => (
          <li>
            <a
              class="external-link"
              href={a.answerUrl}
              target="_blank"
              rel="external noopener noreferrer"
              lang="en"
              aria-label={t("aria.opensNewTab", {
                text: `${a.fullName} #${a.number}: ${a.title}`,
              })}
              set:text={`${a.fullName} #${a.number}`}
            />
          </li>
        ))}
      </ul>
      <p class="contrib-footnote">
        {t("pages.projectsContributions.answersFooter", {
          accepted: summary.answersCount,
          discussions: summary.discussionTotals.discussions,
          repos: summary.discussionTotals.repos,
        })}
      </p>
    </section>

    <details>
      <summary>
        <b>
          {t("pages.projectsContributions.issuesHeading", {
            total: totalIssues,
            open: summary.contributionTotals.issuesOpen,
            closed: summary.contributionTotals.issuesClosed,
          })}
        </b>
        <span
          class="ledger-toggle"
          aria-hidden="true"
        >
          <span class="i-mdi:plus ledger-toggle__icon ledger-toggle__icon--closed" />
          <span class="i-mdi:minus ledger-toggle__icon ledger-toggle__icon--open" />
        </span>
      </summary>
      <ul class="items items--flat">
        {[...issuesByProject].map(([project, counts]) => (
          <li>
            <span>{project}</span>
            <span class="items__w">
              {counts.open > 0 && countLabel("summaryOpen", counts.open)}
              {counts.open > 0 && counts.closed > 0 && " · "}
              {counts.closed > 0 && countLabel("summaryClosed", counts.closed)}
            </span>
          </li>
        ))}
      </ul>
    </details>

    <AchievementShelf
      achievements={achievements}
      acceptedAnswersCount={summary.answersCount}
      answersAnchor={answersAnchor}
    />

    {pageFaq?.visible && <FAQ items={pageFaq.items} />}
  </div>
</BaseLayout>

<style>
  .contrib {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg-xl);
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .contrib-header__kicker {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .contrib-header__kicker a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .contrib-header__title {
    margin: 0 0 var(--space-sm);
  }

  .contrib-header__intro {
    max-width: 60ch;
    margin: 0;
    font-size: var(--text-md);
    color: var(--color-text);
  }

  .contrib-tiles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 0;
    margin: 0;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .contrib-tile {
    padding: var(--space-sm) var(--space-md);
    border-left: 1px solid var(--color-hair);
  }

  .contrib-tile:first-child {
    border-left: 0;
  }

  @media (width <= 640px) {
    .contrib-tiles {
      grid-template-columns: repeat(2, 1fr);
    }

    .contrib-tile:nth-child(3) {
      border-left: 0;
    }

    .contrib-tile:nth-child(n + 3) {
      border-top: 1px solid var(--color-hair);
    }
  }

  .contrib-tile dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-heading);
  }

  .contrib-tile dt {
    margin: 2px 0 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .contrib-h2 {
    margin: 0 0 var(--space-md);
    font-size: 1.25rem;
  }

  .hl {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .hl li {
