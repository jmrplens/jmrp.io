---
/**
 * Tool Page shared component.
 * Renders individual tool pages from the `tools` content collection.
 */
import ToolLayout from "@layouts/ToolLayout.astro";
import { type CollectionEntry, render } from "astro:content";

interface Props {
  /** The tool entry from the content collection. */
  tool: CollectionEntry<"tools">;
}

const { tool } = Astro.props;
const { Content } = await render(tool);
---

<ToolLayout
  title={tool.data.title}
  description={tool.data.description}
  subtitle={tool.data.subtitle}
  icon={tool.data.icon}
  slug={tool.data.slug}
  category={tool.data.category}
  faq={tool.data.faq}
  features={tool.data.features}
  publishedDate={tool.data.publishedDate}
  updatedDate={tool.data.updatedDate}
>
  {
    /* The MDX body carries everything: its own app component (so the page's
      CSS contains only that app's styles — see ToolApp.astro) plus the
      documentation, each in its wrapper. */
  }
  <Content />
</ToolLayout>
