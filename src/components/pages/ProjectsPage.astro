---
/**
 * Projects page ("// /PROJECTS") — the curated, human-readable index of the
 * open-source software behind the `#person` entity.
 *
 * Every fact rendered here is also emitted as JSON-LD (a `CollectionPage` +
 * `ItemList` wrapping one `SoftwareApplication`/`SoftwareSourceCode` node per
 * project), so the visible page corroborates the structured data rather than
 * asserting something only a parser can see. Content lives in
 * `src/content/profile/projects.yaml`; the graph rationale is documented in
 * `@utils/projects`.
 *
 * The list is hand-curated rather than mirrored from the GitHub API: only
 * projects with their own documentation, real usage, or both — no experiments,
 * forks or scratch repos.
 */
import downloadsData from "@data/downloads.json";
import { defaultLocale, type Locale } from "@i18n/config";
import { formatDate, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { compactDownloads, DOWNLOADS_DISPLAY_MIN } from "@utils/downloads";
import { type ProjectListing, projectListings } from "@utils/project-listings";
import {
  buildProjectSchema,
  getProjects,
  hostedHref,
  licenseUrl,
  type Project,
  softwareId,
} from "@utils/projects";
import { getSiteUrl } from "@utils/site";
import { getEntry } from "astro:content";
import type { CollectionPage } from "schema-dts";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

// The hand-read File Exchange counts carry the date they were read
// (MANUAL_COUNTS_VERIFIED_ON, published in downloads.json). Printing it is the
// difference between "we counted" and "we counted, here is when".
//
// The value is checked, not trusted: downloads.json is generated and
// git-ignored, so a build host holds whatever its last successful refresh left
// behind — a copy predating this field carries none — and the field itself
// comes from a hand-edited constant. `Intl.DateTimeFormat.format` throws
// `RangeError: Invalid time value` on an invalid Date, so a missing or
// malformed value would fail the whole build over one parenthetical; without a
// usable date the note is dropped instead and the figures it annotates stay.
// The `typeof` guard is load-bearing: `new Date(null)` is the epoch, not an
// invalid date, and would print "January 1, 1970" as if it had been read then.
const verifiedOnRaw: unknown = downloadsData.manualVerifiedOn;
const verifiedOn =
  typeof verifiedOnRaw === "string" ? new Date(verifiedOnRaw) : undefined;
const manualVerifiedOn =
  verifiedOn && !Number.isNaN(verifiedOn.getTime())
    ? formatDate(verifiedOn, locale)
    : null;

const projects = await getProjects();
const aboutEntry = await getEntry("profile", "about");
// `profile` is a discriminated union, so the entry has to be narrowed
// before `person` exists on it — same guard as BaseHead.astro.
const sponsorUrl =
  aboutEntry?.data.type === "about"
    ? aboutEntry.data.person.sponsorUrl
    : undefined;
const active = projects.filter((p) => p.status === "active");
const archived = projects.filter((p) => p.status === "archived");

const pageUrl = new URL(Astro.url.pathname, getSiteUrl()).href;

/**
 * Combined download count of a project, or `null` when it should not be shown.
 *
 * The figure covers every channel the project ships through (GitHub Releases,
 * Docker Hub…), summed at pre-build into `src/data/downloads.json` — the same
 * document behind the homepage total, so the card and the terminal cannot
 * disagree. A project under `DOWNLOADS_DISPLAY_MIN` renders no figure at all:
 * a small number next to a project reads as a verdict on it, while the
 * site-wide total still counts it.
 */
const downloadsOf = (project: Project): string | null => {
  const count = (
    downloadsData.projects as Record<string, { total?: number } | undefined>
  )[project.id]?.total;
  return count && count >= DOWNLOADS_DISPLAY_MIN
    ? compactDownloads(count)
    : null;
};

/** Localized documentation URL — falls back to the English docs entry point. */
const docsHref = (project: Project) =>
  locale === "es" && project.docsEs ? project.docsEs : project.docs;

/*
 * ── Listings popover ──────────────────────────────────────────────────────
 * Resolved once per project here rather than inside the template: the trigger
 * needs the count and the popover needs the list, and a template that called
 * `projectListings` twice would parse every URL twice per card.
 */
const listingsById = new Map(
  projects.map((project) => [project.id, projectListings(project)]),
);

/** Every directory and registry the project is listed on. */
const listingsOf = (project: Project): ProjectListing[] =>
  listingsById.get(project.id) ?? [];

/**
 * Whether the card gets a listings trigger at all.
 *
 * Only when the project has a URL the card does NOT already render: the button
 * exists to reveal what is hidden, and on the eleven projects whose only
 * listing is the one link already in the row it would open a popover that
 * shows nothing new. Three projects qualify today (both MCP servers and
 * phonometry, whose DOI is `sameAs`-only).
 */
const hasHiddenListings = (project: Project): boolean =>
  listingsOf(project).some((listing) => !listing.onCard);

/** DOM id of a project's popover; also the base of its title's id. */
const listingsId = (project: Project): string => `listings-${project.id}`;

/**
 * The anchor's visible text, in visible order, for the "opens in new tab"
 * label. Composed from the same strings the markup renders so `aria-label`
 * extends the accessible name instead of replacing it (WCAG 2.5.3 Label in
 * Name), the rule `@utils/links` documents for the rest of the site.
 */
const listingName = (listing: ProjectListing): string =>
  [
    listing.label,
    listing.host === listing.label ? "" : listing.host,
    listing.onCard ? t("pages.projects.listingsOnCard") : "",
  ]
    .filter(Boolean)
    .join(" ");

/**
 * CollectionPage → ItemList → each `#software` node. The ItemList references
 * the software by @id only; the full nodes are appended to the same @graph
 * below, so the list stays a pure ordering over entities defined once.
 */
const projectsPageSchema = {
  "@type": "CollectionPage",
  // Answer target for this page: its title and the one-line intro under it.
  // 66 indexable pages carried no `speakable` (GEO audit 2026-08-22, M7);
  // selectors verified against the built markup.
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".projects-header__title", ".projects-header__intro"],
  },
  "@id": `${pageUrl}#projects`,
  name: t("pages.projects.title"),
  description: t("pages.projects.schemaDescription"),
  url: pageUrl,
  inLanguage: locale,
  isPartOf: { "@id": new URL("#website", getSiteUrl()).href },
  about: { "@id": new URL("#person", getSiteUrl()).href },
  mainEntity: {
    "@type": "ItemList",
    "@id": `${pageUrl}#project-list`,
    name: t("pages.projects.title"),
    numberOfItems: projects.length,
    itemListOrder: "https://schema.org/ItemListUnordered",
    itemListElement: projects.map((project, index) => ({
      "@type": "ListItem" as const,
      position: index + 1,
      item: { "@id": softwareId(project) },
    })),
  },
} satisfies CollectionPage;

const schema = [projectsPageSchema, ...projects.map(buildProjectSchema)];

const groups = [
  {
    key: "active",
    heading: t("pages.projects.activeHeading"),
    intro: t("pages.projects.activeIntro"),
    items: active,
  },
  {
    key: "archived",
    heading: t("pages.projects.archivedHeading"),
    intro: t("pages.projects.archivedIntro"),
    items: archived,
  },
];
---

<BaseLayout
  title={t("pages.projects.title")}
  description={t("pages.projects.description")}
  schema={schema}
>
  <div class="projects container">
    <header class="projects-header">
      <p class="section-title">{t("pages.projects.kicker")}</p>
      <h1 class="page-title projects-header__title">
        {t("pages.projects.heading")}
      </h1>
      <p class="projects-header__intro">{t("pages.projects.intro")}</p>
      {
        manualVerifiedOn &&
          // The note's markup is pinned. Inside this expression Prettier
          // formats with JSX rules, where `singleAttributePerLine` breaks any
          // element carrying two or more attributes and moves its children onto
          // their own lines. Astro keeps that whitespace where JSX would strip
          // it, so a reflowed anchor renders "download-sources.mjs ." — a space
          // inside the link and another before the sentence's period. Spreading
          // the attributes instead is not the way out: `spreadAttributes` also
          // appends this component's scoped class to `class`, which the literal
          // form does not carry.
          // prettier-ignore
          <p class="projects-header__note">
            {t("pages.projects.downloadsNote", { date: manualVerifiedOn })}{" "}
            {t("pages.projects.downloadsSourceLead")}{" "}
            <a href="https://github.com/jmrplens/jmrp.io/blob/main/scripts/download-sources.mjs" target="_blank" rel="external noopener noreferrer" class="external-link" aria-label={t("aria.opensNewTab", { text: "download-sources.mjs" })}>download-sources.mjs</a>.
          </p>
      }
    </header>

    {
      groups.map((group) => (
        <section
          class="projects-group"
          aria-labelledby={`projects-${group.key}`}
        >
          <h2
            class="projects-group__title"
            id={`projects-${group.key}`}
          >
            {group.heading}
          </h2>
          <p class="projects-group__intro">{group.intro}</p>

          <ul class="projects-grid">
            {group.items.map((project) => (
              <li class="proj-card">
                <h3 class="proj-card__name">{project.name}</h3>
                {project.name !== project.id && (
                  <p class="proj-card__repo-name">{project.id}</p>
                )}
                <p class="proj-card__summary">{project.summary[locale]}</p>

                <dl class="proj-card__meta">
                  <div class="proj-card__meta-pair">
                    <dt>{t("pages.projects.language")}</dt>
                    <dd>{project.language}</dd>
                  </div>
                  <div class="proj-card__meta-pair">
                    <dt>{t("pages.projects.license")}</dt>
                    <dd>
                      <a
                        href={licenseUrl(project.license)}
                        target="_blank"
                        rel="external noopener noreferrer"
                        aria-label={t("aria.opensNewTab", {
                          text: `${project.license} — ${project.name}`,
                        })}
                      >
                        {project.license}
                      </a>
                    </dd>
                  </div>
                  {downloadsOf(project) && (
                    <div class="proj-card__meta-pair">
                      <dt>{t("pages.projects.downloads")}</dt>
                      <dd>{downloadsOf(project)}</dd>
                    </div>
                  )}
                </dl>

                <ul
                  class="proj-card__topics"
                  aria-label={t("pages.projects.topicsLabel", {
                    project: project.name,
                  })}
                >
                  {project.topics.map((topic) => (
                    <li class="proj-card__topic">{topic.name}</li>
                  ))}
                </ul>

                <p class="proj-card__links">
                  <a
                    href={project.repo}
                    target="_blank"
                    rel="external noopener noreferrer"
                    aria-label={t("aria.opensNewTab", {
                      text: `${t("pages.projects.repo")} — ${project.name}`,
                    })}
                  >
                    <span
                      class="i-fa-brands:github"
                      aria-hidden="true"
                    />
                    {t("pages.projects.repo")}
                  </a>
                  <a
                    href={docsHref(project)}
                    target="_blank"
                    rel="external noopener noreferrer"
                    aria-label={t("aria.opensNewTab", {
                      text: `${t("pages.projects.docs")} — ${project.name}`,
                    })}
                  >
                    <span
                      class="i-mdi:book-open-variant"
                      aria-hidden="true"
                    />
                    {t("pages.projects.docs")}
                  </a>
                  {(project.listings ?? []).map((listing) => (
                    <a
                      href={listing.url}
                      target="_blank"
                      rel="external noopener noreferrer"
                      aria-label={t("aria.opensNewTab", {
                        text: `${listing.label} — ${project.name}`,
                      })}
                    >
                      <span
                        class={`i-${listing.icon}`}
                        aria-hidden="true"
                      />
                      {listing.label}
                    </a>
                  ))}
                  {hostedHref(project, locale) && (
                    <a
                      href={hostedHref(project, locale)}
                      target="_blank"
                      rel="external noopener noreferrer"
                      aria-label={t("aria.opensNewTab", {
                        text: `${t("pages.projects.hosted")} — ${project.name}`,
                      })}
                    >
                      <span
                        class="i-mdi:api"
                        aria-hidden="true"
                      />
                      {t("pages.projects.hosted")}
                    </a>
                  )}
                  {hasHiddenListings(project) && (
                    <button
                      type="button"
                      class="proj-card__listings-btn"
                      popovertarget={listingsId(project)}
                    >
                      <span
                        class="i-mdi:earth"
                        aria-hidden="true"
                      />
                      {t("pages.projects.listingsButton")}
                      <span class="proj-card__listings-count">
                        {listingsOf(project).length}
                      </span>
                      <span class="sr-only">
                        {t("pages.projects.listingsButtonContext", {
                          project: project.name,
                        })}
                      </span>
                    </button>
                  )}
                </p>

                {/*
                 * Outside the <p> above on purpose: a <p> may only contain
                 * phrasing content, so a <div popover> inside it is invalid
                 * HTML. `popovertarget` binds by id and CSS anchoring binds to
                 * the INVOKER, so neither needs DOM adjacency.
                 */}
                {hasHiddenListings(project) && (
                  <div
                    id={listingsId(project)}
                    class="proj-listings"
                    popover="auto"
                    role="dialog"
                    aria-labelledby={`${listingsId(project)}-title`}
                  >
                    <div class="proj-listings__head">
                      <h4
                        class="proj-listings__title"
                        id={`${listingsId(project)}-title`}
                      >
                        {t("pages.projects.listingsTitle", {
                          project: project.name,
                        })}
                      </h4>
                      <button
                        type="button"
                        class="proj-listings__close"
                        popovertarget={listingsId(project)}
                        popovertargetaction="hide"
                        aria-label={t("aria.close")}
                      >
                        <span
                          class="i-mdi:close"
                          aria-hidden="true"
                        />
                      </button>
                    </div>
                    <ul class="proj-listings__list">
                      {listingsOf(project).map((listing) => (
                        <li class="proj-listings__item">
                          <a
                            href={listing.url}
                            target="_blank"
                            rel="external noopener noreferrer"
                            aria-label={t("aria.opensNewTab", {
                              text: listingName(listing),
                            })}
                          >
                            <span
                              class={`proj-listings__icon i-${listing.icon}`}
                              aria-hidden="true"
                            />
                            <span class="proj-listings__label">
                              {listing.label}
                            </span>
                            {listing.host !== listing.label && (
                              <span class="proj-listings__host">
                                {listing.host}
                              </span>
                            )}
                            {/*
                             * Marked, not hidden: see `ProjectListing.onCard`.
                             * The mark is an icon PLUS text, never colour
                             * alone (WCAG 1.4.1).
                             */}
                            {listing.onCard && (
                              <span class="proj-listings__flag">
                                <span
                                  class="i-mdi:check"
                                  aria-hidden="true"
                                />
                                {t("pages.projects.listingsOnCard")}
                              </span>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {
      /*
       * The one funding route this site has, stated where the work it funds is
       * listed. It existed only as a `DonateAction` in the structured data of
       * all 129 pages: machines were told there was a way to support the work
       * and readers were told nothing, while the privacy page said nothing on
       * the site is monetized. A visible link is what makes both true.
       */
    }
    {
      sponsorUrl && (
        <section class="projects-support">
          <h2 class="projects-support__title">
            {t("pages.projects.supportHeading")}
          </h2>
          <p class="projects-support__intro">
            {t("pages.projects.supportIntro")}
          </p>
          <p class="projects-support__links">
            <a
              href={sponsorUrl}
              target="_blank"
              rel="external noopener noreferrer"
              aria-label={t("aria.opensNewTab", {
                text: t("pages.projects.supportLink"),
              })}
            >
              <span
                class="i-mdi:heart-outline"
                aria-hidden="true"
              />
              {t("pages.projects.supportLink")}
            </a>
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .projects {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .projects-header {
    padding-bottom: var(--space-lg);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-hair);
  }

  .projects-header .section-title {
    margin-bottom: var(--space-sm);
  }

  .projects-header__title {
    padding-bottom: 0;
    margin: 0 0 var(--space-md);
    font-size: clamp(1.9rem, 4.5vw, 2.75rem);
    line-height: 1.05;
    border-bottom: 0;
  }

  .projects-header__intro {
    max-width: 60ch;
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text);
  }

  .projects-header__note {
    max-width: 60ch;
    margin: var(--space-sm) 0 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-meta);
  }

  .projects-group + .projects-group {
    margin-top: var(--space-lg-xl);
  }

  .projects-group__title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .projects-group__intro {
    max-width: 60ch;
    margin: 0 0 var(--space-md);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-md);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .proj-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-md);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .proj-card__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .proj-card__repo-name {
    margin: 2px 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  .proj-card__summary {
    margin: var(--space-sm) 0 var(--space-md);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text);
  }

  .proj-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: 0 0 var(--space-sm);
  }

  .proj-card__meta-pair {
    display: flex;
    gap: var(--space-xs);
    align-items: baseline;
  }

  .proj-card__meta dt {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .proj-card__meta dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text);
  }

  .proj-card__meta dd a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .proj-card__meta dd a:hover {
    color: var(--color-accent);
  }

  .proj-card__topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding: 0;
    margin: 0 0 var(--space-md);
    list-style: none;
  }

  .proj-card__topic {
    padding: 2px 8px;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-sm);
  }

  .proj-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: auto 0 0;
  }

  .proj-card__links a {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: none;
  }

  .proj-card__links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── Listings popover ─────────────────────────────────────────────────────
     Zero client JS. The native `popover` attribute already does open, close,
     light dismiss, Escape and focus return; CSS anchor positioning does the
     placement. The trigger is the popover's IMPLICIT anchor, a role HTML gives
     every `popovertarget` invoker, which is what makes this work with no
     `anchor-name` at all: one shared name across twenty cards would resolve
     every popover to the last button in tree order, and a unique name per card
     could only come from an inline style, which the nonce-only CSP forbids.

     Three placements, in order of increasing capability:

     1. Base — any engine with `popover` (Chrome 114+, Safari 17+, Firefox
        125+): the UA's own `inset: 0; margin: auto` centring, capped in size.
        This IS the fallback for engines without anchor positioning, which
        today means Firefox and Safari: the popup opens centred instead of
        anchored, and everything else about it is unchanged.
     2. Narrow viewports — a bottom sheet, at any capability. An anchored
        bubble hanging off a 28px chip has nowhere to go on a 360px screen, and
        a dialog floating mid-screen loses the connection to the card that was
        just tapped; a sheet rising from the bottom edge is the phone idiom and
        can be full-width, which is what a column of hostnames needs.
     3. Wide viewports WITH anchor positioning — anchored under the trigger and
        scaled out of its top-left corner, so it visibly grows from the button.

     `--pop-from` is the closed-state transform, redefined per placement, so
     the entry and exit transitions are declared once instead of three times
     (the popup scales in on desktop and slides up on the sheet). */

  .proj-card__listings-btn {
    display: inline-flex;
    gap: 6px;
    align-items: center;

    /* 24px is the WCAG 2.2 2.5.8 minimum; this row's links are text-sized, so
       the one control among them has to be padded up to it deliberately. */
    min-height: 28px;
    padding: 3px 10px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    cursor: pointer;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
  }

  .proj-card__listings-btn:hover,
  .proj-card__listings-btn:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-border-hover);
  }

  .proj-card__listings-count {
    padding: 0 5px;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-pill);
  }

  .proj-listings {
    --pop-from: scale(0.96);

    width: max-content;
    max-width: min(24rem, calc(100vw - 2 * var(--space-md)));
    max-height: min(60dvh, calc(100dvh - 2 * var(--space-md)));
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--color-text);

    /* One step up the documented elevation scale from the card it belongs to
       (bg < secondary < surface-2), which is how this design system says
       "above" — it has no shadow tokens. */
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    opacity: 0%;
    transform: var(--pop-from);
  }

  .proj-listings:popover-open {
    opacity: 100%;
    transform: none;
