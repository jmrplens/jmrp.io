---
/**
 * Home Page shared component.
 * Displays the hero section, biography, and quick links.
 * Content is configured via `src/content/site_config/site.yaml`.
 */
import mehomeImg from "@assets/mehome.webp";
import PostCard from "@components/blog/PostCard.astro";
import RepoCard from "@components/github/RepoCard.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { SiteConfig } from "@src/types";
import { getPostsForLocale } from "@utils/blog";
import { fetchRepositoriesByName } from "@utils/github";
import { sanitize } from "@utils/html";
import { getSiteUrl } from "@utils/site";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

// Hero content from translations (not from YAML)
const hero = {
  title: t("pages.home.heroTitle"),
  subtitle: t("pages.home.heroSubtitle"),
  bio: [t("pages.home.heroBio1"), t("pages.home.heroBio2")],
};

// Use centralized person config with fallbacks
const person = siteData.person || {
  name: siteData.author || "José Manuel Requena Plens",
  jobTitle: t("seo.jobTitle"),
  worksFor: { name: "Power Electronics" },
};

// Fetch data concurrently with error handling for external API
const [postEntries, featuredProjects] = await Promise.all([
  getPostsForLocale(locale),
  fetchRepositoriesByName(siteData.featured_projects || []).catch((error) => {
    const errorMessage = error instanceof Error ? error.message : String(error);
    console.error(`Failed to fetch featured projects: ${errorMessage}`);
    return [];
  }),
]);

// Process posts
const latestPosts = postEntries.slice(0, 3).map((e) => e.post);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": new URL("#person", getSiteUrl()).toString(),
  name: person.name,
  url: getSiteUrl(),
  image: new URL(mehomeImg.src, getSiteUrl()).toString(),
  sameAs: siteData.social_links?.map((s) => s.url) || [],
  jobTitle: t("seo.jobTitle"),
  worksFor: {
    "@type": "Organization",
    name: person.worksFor.name,
    ...(person.worksFor.url && { url: person.worksFor.url }),
  },
  inLanguage: locale,
};
---

<BaseLayout
  title={t("seo.siteTitle")}
  description={t("seo.siteDescription")}
  schema={personSchema}
>
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <h1>{hero.title}</h1>
          <p
            class="subtitle"
            set:html={sanitize(hero.subtitle)}
          />
          <div class="bio">
            {
              hero.bio.map((paragraph: string) => (
                <p set:html={sanitize(paragraph)} />
              ))
            }
          </div>
        </div>

        <div class="profile-image centered">
          <div class="hero-image">
            <Image
              src={mehomeImg}
              alt={person.name}
              width={350}
              height={350}
              widths={[200, 350, 400, 700]}
              sizes="(max-width: 768px) 200px, 350px"
              quality={50}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>

      <div class="social-links-row">
        <a
          href={translatePath("/cv/")}
          class="btn btn-primary"
          aria-label={t("pages.home.viewCVAria")}
        >
          <span
            class="i-fa-solid:file-pdf"
            aria-hidden="true"
          ></span>
          {t("pages.home.viewCV")}
        </a>
        <a
          href={translatePath("/blog/")}
          class="btn btn-outline"
          aria-label={t("pages.home.readBlogAria")}
        >
          <span
            class="i-fa-solid:pen-nib"
            aria-hidden="true"
          ></span>
          {t("pages.home.readBlog")}
        </a>
        <a
          href={translatePath("/github/")}
          class="btn btn-outline"
          aria-label={t("pages.home.projectsAria")}
        >
          <span
            class="i-fa-brands:github"
            aria-hidden="true"
          ></span>
          {t("pages.home.projects")}
        </a>
        <a
          href={translatePath("/homelab/")}
          class="btn btn-outline"
          aria-label={t("pages.home.homelabAria")}
        >
          <span
            class="i-fa-solid:server"
            aria-hidden="true"
          ></span>
          {t("pages.home.homelab")}
        </a>
      </div>
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="latest-posts">
        <div class="container">
          <div class="section-header">
            <h2>{t("pages.home.latestFromBlog")}</h2>
            <a
              href={translatePath("/blog/")}
              class="btn btn-link"
            >
              {t("pages.home.viewAllPosts")}
            </a>
          </div>
          <div class="grid-layout">
            {latestPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    featuredProjects.length > 0 && (
      <section class="featured-projects">
        <div class="container">
          <div class="section-header">
            <h2>{t("pages.home.featuredProjects")}</h2>
            <a
              href={translatePath("/github/")}
              class="btn btn-link"
            >
              {t("pages.home.viewAllRepos")}
            </a>
          </div>
          <div class="grid-layout">
            {featuredProjects.map((repo) => (
              <RepoCard repo={repo} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding: var(--space-xl) 0;
    background-color: var(--color-bg-secondary);
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-xl);
    align-items: start;
    margin-bottom: var(--space-xl);
  }

  .social-links-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
    justify-content: flex-start;
    min-height: 44px;
    margin-top: var(--space-lg);
  }

  .social-links-row span {
    flex-shrink: 0;
    width: 1.2rem;
    height: 1.2rem;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    min-height: fit-content;
  }

  .hero-text h1 {
    margin-bottom: var(--space-md);
    font-size: 3rem;
    line-height: 1.2;
  }

  .subtitle {
    min-height: 2.8em;
    margin-bottom: var(--space-md);
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .bio {
    font-size: 1.1rem;
    line-height: 1.6;
    transition: none !important;
  }

  .bio p {
    margin-bottom: var(--space-md);
  }

  .profile-image.centered {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .profile-image img {
    width: 100%;
    max-width: 350px;
    height: auto;
    aspect-ratio: 1/1;
    object-fit: cover;
    border: 4px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 40px rgb(0 0 0 / 30%);
    transition: none !important;
  }

  .hero-image {
    display: flex;
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
  }

  section {
    padding: var(--space-lg) 0;
  }

  h2 {
    position: relative;
    display: inline-block;
    margin-bottom: var(--space-lg);
    font-size: 2rem;
  }

  h2::after {
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 40px;
    height: 4px;
    content: "";
    background-color: var(--color-primary);
    border-radius: 2px;
  }

  .latest-posts,
  .featured-projects {
    padding: var(--space-xl) 0;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xl);
  }

  .section-header h2 {
    margin-bottom: 0;
  }

  .grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-lg);
  }

  .btn-link {
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
    text-decoration: none;
    border-radius: 4px;
  }

  .btn-link:hover {
    text-decoration: underline;
  }

  .btn-link:focus-visible {
    text-decoration: underline;
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (width <= 768px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .profile-image {
      order: -1;
      width: 200px;
      max-width: 200px;
      min-height: 200px;
      aspect-ratio: 1 / 1;
      margin: 0 auto var(--space-lg) auto;
    }

    .social-links-row {
      justify-content: center;
      min-height: auto;
    }

    .bio {
      text-align: left;
    }

    .hero-text {
      min-height: auto;
      text-align: center;
    }
  }
</style>
