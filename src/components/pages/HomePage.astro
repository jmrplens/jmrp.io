---
/**
 * Home Page shared component.
 * Displays the hero section, biography, and quick links.
 * Content is configured via `src/content/site_config/site.yaml`.
 */
import FAQ from "@components/ui/FAQ.astro";
import downloadsData from "@data/downloads.json";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { SiteConfig } from "@src/types";
import { formatDateDot, getPostsForLocale } from "@utils/blog";
import {
  featuredProjectCards,
  upstreamSummary,
} from "@utils/featured-projects";
import { langColors } from "@utils/github";
import { sanitize } from "@utils/html";
import { getPageFaq, pageFaqNode } from "@utils/page-faq";
import { getSiteUrl } from "@utils/site";
import { getSiteFacts } from "@utils/site-facts";
import { getEntry } from "astro:content";
import type { WebPage } from "schema-dts";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

// Hero content from translations (not from YAML)
const hero = {
  title: t("pages.home.heroTitle"),
  subtitle: t("pages.home.heroSubtitle"),
  bio: [t("pages.home.heroBio1"), t("pages.home.heroBio2")],
};

// Resolved through @utils/featured-projects (cards) and @utils/github-facts
// (profile), both memoized for the whole build. That is what makes the
// homepage's markdown twin able to publish THESE figures rather than its own
// second reading of the same sources, and the cards' summaries come
// from the data /projects/ renders, so the two pages do not disagree.
const [postEntries, featuredProjects, siteFacts] = await Promise.all([
  getPostsForLocale(locale),
  featuredProjectCards(siteData.featured_projects ?? [], locale),
  getSiteFacts(),
]);

// Build-time "N PRs merged into M other projects" line; see its doc comment
// for why the homepage carries no live token.
const upstreamStrip = upstreamSummary(locale);

// Process posts
const latestPosts = postEntries.slice(0, 4).map((e) => e.post);

/**
 * Per-project metadata: accent category chip label and secondary tech tag.
 * Maintained manually because {@link GitHubRepo} does not include GitHub topics.
 */
const PROJECT_META: Readonly<
  Record<string, { category: string; tag?: string } | undefined>
> = {
  "gitlab-mcp-server": { category: "mcp · ai", tag: "stdio · HTTP" },
  phonometry: { category: "acoustics · dsp", tag: "SciPy" },
  "Cloudflare-DNS-Updater": {
    category: "devops · networking",
    tag: "Cloudflare API",
  },
  mikroscope: { category: "telemetry · routeros", tag: "Docker" },
  "TFG-TFM_EPS": { category: "docs · templates", tag: "CI" },
  "cs-routeros-bouncer": {
    category: "network · security",
    tag: "RouterOS API",
  },
  Kleidos: { category: "hardware · embedded", tag: "ESP-IDF" },
};

/**
 * Compact human-readable count: 52311 → "52.3k", 980 → "980".
 * Used for the terminal download total (a large cumulative figure).
 */
function formatCompact(n: number): string {
  if (n < 1000) return String(n);
  return `${(n / 1000).toFixed(1).replace(/\.0$/, "")}k`;
}

// Hero `~/whoami` terminal: who, what and where, then two figures the author
// owns outright (both also printed elsewhere, by the same accessors): the
// download total (src/data/downloads.json, as /projects/ counts it) and the
// public repositories of his own, forks left out (@utils/site-facts, as
// /about/ states it). The `last.post` row is gone on purpose: it advertised
// how long the blog had been quiet (author's decision, 2026-09-28).
// `focus`/`base` are data in site.yaml.
const terminal = {
  focus: siteData.terminal?.focus ?? "Firmware · Software · QA",
  base: siteData.terminal?.base ?? "Valencia, ES",
  downloads: downloadsData.total > 0 ? formatCompact(downloadsData.total) : "—",
  ownRepos: siteFacts.ownRepos,
};

// The canonical author-entity page is /about/ (see AboutPage.astro's
// ProfilePage). The homepage only needs a lightweight WebPage node pointing
// at the single, fully-populated #person node (defined as the WebSite
// publisher in BaseHead) — emitting a second ProfilePage here would just
// duplicate that identity data across pages.
const homeSchema = {
  "@type": "WebPage",
  "@id": new URL(`${translatePath("/")}#webpage`, getSiteUrl()).href,
  url: new URL(translatePath("/"), getSiteUrl()).href,
  name: t("seo.siteTitle"),
  description: t("seo.siteDescription"),
  inLanguage: locale,
  isPartOf: { "@id": new URL("#website", getSiteUrl()).href },
  about: { "@id": new URL("#person", getSiteUrl()).href },
  // Marks the hero identity block as the citable/answer-target summary for
  // "who is José Manuel Requena Plens?" queries — same speakable pattern the
  // blog posts use for their header + TL;DR.
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".hero__title", ".hero__subtitle", ".hero__bio"],
  },
} satisfies WebPage;
// The page's question-and-answer pairs (GEO audit #8): one source for the
// visible section, the FAQPage node and the markdown twin. See @utils/page-faq.
const pageFaq = await getPageFaq("/", locale);
const faqNode =
  pageFaq &&
  pageFaqNode(
    pageFaq,
    new URL(Astro.url.pathname, getSiteUrl()).href,
    homeSchema["@id"],
    locale,
  );
---

<BaseLayout
  title={t("seo.siteTitle")}
  description={t("seo.siteDescription")}
  schema={faqNode ? [homeSchema, faqNode].flat() : homeSchema}
>
  <section class="hero">
    <div
      class="lab-grid"
      aria-hidden="true"
    ></div>
    <div class="hero__inner container">
      <div class="hero__text">
        <p class="hero__status">
          <span
            class="hero__status-dot"
            aria-hidden="true"
          ></span>
          <span class="hero__status-full">{t("pages.home.availability")}</span>
          <span
            class="hero__status-short"
            aria-hidden="true"
          >
            {t("pages.home.availabilityShort")}
          </span>
        </p>

        <h1 class="hero__title">{hero.title}</h1>

        <p
          class="hero__subtitle"
          set:html={sanitize(hero.subtitle)}
        />

        <div class="hero__bio">
          {hero.bio.map((paragraph: string) => (
            <p set:html={sanitize(paragraph)} />
          ))}
        </div>

        <div class="hero__cta">
          <a
            href={translatePath("/cv/")}
            class="btn btn-primary"
            aria-label={t("pages.home.viewCVAria")}
          >
            {t("pages.home.viewCV")}
            <span
              class="i-tabler:arrow-right"
              aria-hidden="true"
            ></span>
          </a>
          <a
            href={translatePath("/projects/")}
            class="btn btn-outline"
          >
            {t("pages.home.seeProjects")}
          </a>
        </div>
      </div>

      <figure
        class="terminal"
        aria-label={t("pages.home.terminalLabel")}
      >
        <figcaption class="terminal__bar">
          <span
            class="terminal__dots"
            aria-hidden="true"
          >
            <span class="terminal__dot terminal__dot--red"></span>
            <span class="terminal__dot terminal__dot--amber"></span>
            <span class="terminal__dot terminal__dot--teal"></span>
          </span>
          <span class="terminal__path">~/whoami</span>
        </figcaption>
        <div class="terminal__body">
          <p class="terminal__cmd">
            <span class="terminal__prompt">jmrp@home:~$</span> stat
          </p>
          <dl class="terminal__grid">
            <dt>role</dt>
            <dd>{t("pages.home.terminalRole")}</dd>
            <dt>focus</dt>
            <dd>{terminal.focus}</dd>
            <dt>base</dt>
            <dd>{terminal.base}</dd>
          </dl>
          <div class="terminal__metrics">
            <div class="terminal__metric">
              <span>downloads.total</span>
              <span class="terminal__num">{terminal.downloads}</span>
            </div>
            <div class="terminal__metric">
              <span>repos.own</span>
              <span class="terminal__num">{terminal.ownRepos}</span>
            </div>
          </div>
          <p class="terminal__cmd terminal__cmd--last">
            <span class="terminal__prompt">jmrp@home:~$</span>{" "}
            <span
              class="terminal__cursor"
              aria-hidden="true"
            ></span>
          </p>
        </div>
      </figure>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section class="home-section">
      <div class="container">
        <div class="home-section__head">
          <h2 class="section-title standard">
            {t("pages.home.featuredProjects")}
          </h2>
          <a
            href={translatePath("/projects/")}
            class="home-section__link"
          >
            {t("pages.home.viewAllProjects")}
          </a>
        </div>
        <div class="proj-grid">
          {featuredProjects.map((card) => {
            const meta = PROJECT_META[card.id];
            /*
             * The whole card is the link, so its accessible name is its own
             * visible text. No `aria-label`: it REPLACES the name, and any
             * label that omits part of what is on screen (here the repo slug
             * shown when it differs from the name) fails WCAG 2.5.3 Label in
             * Name. A visually hidden span at the end extends the name
             * instead: visible text in DOM order, then the new-tab notice.
             */
            const newTabNotice = t("aria.opensNewTab", { text: "" }).trim();
            const langColor =
              (card.language && langColors[card.language]) ??
              (card.githubLanguage && langColors[card.githubLanguage]) ??
              "#8b949e";
            return (
              <a
                class="proj-card"
                href={card.url}
                target="_blank"
                rel="external noopener noreferrer"
              >
                <div class="proj-card__top">
                  {meta?.category && (
                    <span class="proj-card__chip">{meta.category}</span>
                  )}
                </div>
                <h3 class="proj-card__title">{card.name}</h3>
                {card.name !== card.id && (
                  <p class="proj-card__slug">{card.id}</p>
                )}
                {card.summary && <p class="proj-card__desc">{card.summary}</p>}
                {(card.language ?? meta?.tag) && (
                  <div class="proj-card__foot">
                    {card.language && (
                      <span class="proj-card__lang">
                        <span
                          class="proj-card__dot"
                          style={`--lang-color:${langColor}`}
                          aria-hidden="true"
                        />
                        {card.language}
                      </span>
                    )}
                    {meta?.tag && (
                      <span class="proj-card__tag">{meta.tag}</span>
                    )}
                  </div>
                )}
                <span class="sr-only">{newTabNotice}</span>
              </a>
            );
          })}
        </div>
        {upstreamStrip && (
          <p class="upstream-strip">
            <span
              class="i-tabler:git-merge upstream-strip__icon"
              aria-hidden="true"
            />
            <span class="upstream-strip__text">{upstreamStrip}</span>
            <a
              href={translatePath("/projects/contributions/")}
              class="upstream-strip__link"
            >
              {t("pages.home.upstreamLink")}
            </a>
          </p>
        )}
      </div>
    </section>
  )}

  {latestPosts.length > 0 && (
    <section class="home-section">
      <div class="container">
        <div class="home-section__head">
          <h2 class="section-title standard">
            {t("pages.home.latestFromBlog")}
          </h2>
          <a
            href={translatePath("/blog/")}
            class="home-section__link"
          >
            {t("pages.home.viewAllPosts")}
          </a>
        </div>
        <ul class="notes-list">
          {latestPosts.map((post) => (
            <li class="notes-item">
              <span class="notes-date">
                {formatDateDot(post.data.publishedDate)}
              </span>
              <span class="notes-main">
                <a
                  class="notes-title"
                  href={translatePath(`/blog/${post.data.slug}/`)}
                >
                  {post.data.title}
                </a>
                {post.data.tags?.[0] && (
                  <span class="notes-tag">{post.data.tags[0]}</span>
                )}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  {pageFaq?.visible && <FAQ items={pageFaq.items} />}
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: var(--space-xl) 0 var(--space-lg-xl);
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  /* Availability status pill — teal dot + text (never colour alone) */
  .hero__status {
    display: inline-flex;
    gap: var(--space-sm);
    align-items: center;
    padding: var(--space-xs) var(--space-md);
    margin: 0 0 var(--space-md-lg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
    background: color-mix(in srgb, var(--teal) 8%, var(--color-bg-secondary));
    border: 1px solid color-mix(in srgb, var(--teal) 32%, var(--color-border));
    border-radius: 999px;
  }

  .hero__status-short {
    display: none;
  }

  /* On a phone the short form is shown; the full sentence stays in the
     accessibility tree, visually hidden, so nothing is lost to a reader. */
  @media (width <= 640px) {
    .hero__status-full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      white-space: nowrap;
      clip-path: inset(50%);
    }

    .hero__status-short {
      display: inline;
    }
  }

  .hero__status-dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--teal);
    border-radius: 50%;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--teal) 22%, transparent);
  }

  .hero__title {
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    font-weight: var(--fw-bold);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .hero__subtitle {
    margin: 0 0 var(--space-md);
    font-size: var(--text-xl);
    line-height: 1.4;
    color: var(--color-text);
  }

  .hero__subtitle :global(strong) {
    font-weight: var(--fw-semibold);
    color: var(--color-accent);
  }

  .hero__bio {
    max-width: 60ch;
    font-size: var(--text-md);
    line-height: 1.65;
  }

  .hero__bio :global(p) {
    margin: 0 0 var(--space-md);
  }

  .hero__bio :global(strong) {
    font-weight: var(--fw-semibold);
    color: var(--color-accent);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-md-lg);
  }

  .hero__cta span[class^="i-"] {
    flex-shrink: 0;
    width: 1.05rem;
    height: 1.05rem;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .hero__cta .btn-primary:hover span[class^="i-"] {
    transform: translateX(3px);
  }

  /* ---------- Terminal "whoami" card ---------- */
  .terminal {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--sh-card);
  }

  .terminal__bar {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-hair);
  }

  .terminal__dots {
    display: inline-flex;
    gap: 0.4rem;
  }

  .terminal__dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
  }

  .terminal__dot--red {
    background: color-mix(in srgb, var(--color-text-muted) 55%, transparent);
  }

  .terminal__dot--amber {
    background: var(--color-accent);
  }

  .terminal__dot--teal {
    background: var(--teal);
  }

  .terminal__path {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .terminal__body {
    padding: var(--space-md-lg) var(--space-md-lg) var(--space-lg);
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .terminal__cmd {
    margin: 0 0 var(--space-md);
    color: var(--color-text);
  }

  .terminal__prompt {
    color: var(--color-text);
  }

  .terminal__grid {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-sm) var(--space-md-lg);
    margin: 0;
  }

  .terminal__grid dt {
    color: var(--color-text);
  }

  .terminal__grid dd {
    margin: 0;
    color: var(--color-text-heading);
  }

  .terminal__metrics {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    margin-top: var(--space-md);
    border-top: 1px solid var(--color-hair);
  }

  .terminal__metric {
    display: flex;
    justify-content: space-between;
    color: var(--color-text-muted);
  }

  .terminal__num {
    color: var(--color-text-heading);
  }

  .terminal__cmd--last {
    margin: var(--space-md) 0 0;
    color: var(--color-text-muted);
  }

  .terminal__cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--color-accent);
    border-radius: 1px;
    animation: home-blink 1.1s steps(1) infinite;
  }

  @keyframes home-blink {
    0%,
    46% {
      opacity: 100%;
    }

    54%,
    100% {
      opacity: 0%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal__cursor {
      animation: none;
    }
  }

  /* ---------- Featured / Latest sections ---------- */
  .home-section {
    padding: var(--space-lg-xl) 0;
  }

  .home-section__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-hair);
  }

  .home-section__head .section-title {
    margin-bottom: 0;
  }

  .home-section__link {
    /* WCAG 2.5.8: enlace independiente → área táctil >=24px (texto: 21px) */
    display: inline-block;
    padding-block: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .home-section__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Featured project cards — 2-col desktop, 1-col mobile */
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .proj-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-md-lg);
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .proj-card:hover {
    border-color: var(--accent-line);
    box-shadow: var(--sh-card);
    transform: translateY(-2px);
  }

  /* chip (left) + star metric (right, pushed via margin-left:auto on metric) */
  .proj-card__top {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    margin-bottom: var(--space-md);
  }

  /* accent category chip — "mcp · ai", "hardware · embedded" … */
  .proj-card__chip {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-accent);
    background: var(--accent-dim);
    border-radius: var(--radius-sm);
  }

  .proj-card__title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .proj-card__slug {
    margin: -4px 0 var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
  }

  .proj-card__desc {
    flex: 1;
    margin: 0 0 var(--space-md);
    font-size: var(--text-base);
    font-weight: var(--fw-normal);
    line-height: 1.5;
    color: var(--color-text);
  }

  /* footer: language dot+name (left) · secondary tag (right) */
  .proj-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
  }

  .proj-card__lang {
    display: flex;
    gap: 0.5em;
    align-items: center;
  }

  .proj-card__dot {
    flex-shrink: 0;
    width: 9px;
    height: 9px;
    background: var(--lang-color, var(--color-text-muted));
    border-radius: 50%;
  }

  .proj-card__tag {
    color: var(--color-text-muted);
  }

  /* Upstream contributions strip — build-time line under the project grid */
  .upstream-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    align-items: center;
    padding: var(--space-md) var(--space-md-lg);
    margin: var(--space-md) 0 0;
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-text);
    background: var(--color-bg-secondary);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
  }

  .upstream-strip__icon {
    flex-shrink: 0;
    width: 1.15rem;
    height: 1.15rem;
    color: var(--color-accent);
  }

  .upstream-strip__text {
    flex: 1 1 24ch;
    min-width: 0;
  }

  .upstream-strip__link {
    display: inline-block;

    /* WCAG 2.5.8: standalone link, touch target >= 24px */
    padding-block: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-decoration: none;
