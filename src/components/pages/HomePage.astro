---
/**
 * Home Page shared component.
 * Displays the hero section, biography, and quick links.
 * Content is configured via `src/content/site_config/site.yaml`.
 */
import PostCard from "@components/blog/PostCard.astro";
import RepoCard from "@components/github/RepoCard.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { SiteConfig } from "@src/types";
import { getPostsForLocale } from "@utils/blog";
import { fetchRepositoriesByName } from "@utils/github";
import { sanitize } from "@utils/html";
import { getSiteUrl } from "@utils/site";
import { getEntry } from "astro:content";
import type { ProfilePage } from "schema-dts";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

// Hero content from translations (not from YAML)
const hero = {
  title: t("pages.home.heroTitle"),
  subtitle: t("pages.home.heroSubtitle"),
  bio: [t("pages.home.heroBio1"), t("pages.home.heroBio2")],
};

// Use centralized person config with fallbacks
const person = siteData.person || {
  name: siteData.author || "José Manuel Requena Plens",
  jobTitle: t("seo.jobTitle"),
};

// Fetch data concurrently with error handling for external API
const [postEntries, featuredProjects] = await Promise.all([
  getPostsForLocale(locale),
  fetchRepositoriesByName(siteData.featured_projects || []).catch((error) => {
    const errorMessage = error instanceof Error ? error.message : String(error);
    console.error(`Failed to fetch featured projects: ${errorMessage}`);
    return [];
  }),
]);

// Process posts
const latestPosts = postEntries.slice(0, 3).map((e) => e.post);

// Terminal "whoami" card — language-neutral technical facts (data, not prose).
const whoami = {
  focus: "ESP32 · RouterOS · MCP",
  base: "Alicante, ES",
};

const personSchema = [
  {
    "@type": "ProfilePage",
    "@id": new URL("#profile", getSiteUrl()).href,
    name: person.name,
    url: getSiteUrl(),
    inLanguage: locale,
    // Typed reference to the single, fully-populated #person node (defined as
    // the WebSite publisher in BaseHead) instead of re-emitting a thinner copy.
    mainEntity: {
      "@type": "Person",
      "@id": new URL("#person", getSiteUrl()).href,
    },
  } satisfies ProfilePage,
];
---

<BaseLayout
  title={t("seo.siteTitle")}
  description={t("seo.siteDescription")}
  schema={personSchema}
>
  <section class="hero">
    <div
      class="lab-grid"
      aria-hidden="true"
    >
    </div>
    <div class="hero__inner container">
      <div class="hero__text">
        <p class="hero__status">
          <span
            class="hero__status-dot"
            aria-hidden="true"
          ></span>
          {t("pages.home.availability")}
        </p>

        <h1 class="hero__title">{hero.title}</h1>

        <p
          class="hero__subtitle"
          set:html={sanitize(hero.subtitle)}
        />

        <div class="hero__bio">
          {
            hero.bio.map((paragraph: string) => (
              <p set:html={sanitize(paragraph)} />
            ))
          }
        </div>

        <div class="hero__cta">
          <a
            href={translatePath("/cv/")}
            class="btn btn-primary"
            aria-label={t("pages.home.viewCVAria")}
          >
            {t("pages.home.viewCV")}
            <span
              class="i-tabler:arrow-right"
              aria-hidden="true"
            ></span>
          </a>
          <a
            href={translatePath("/blog/")}
            class="btn btn-outline"
            aria-label={t("pages.home.readBlogAria")}
          >
            {t("pages.home.readBlog")}
          </a>
        </div>
      </div>

      <figure
        class="terminal"
        aria-label={t("pages.home.terminalLabel")}
      >
        <figcaption class="terminal__bar">
          <span
            class="terminal__dots"
            aria-hidden="true"
          >
            <span class="terminal__dot terminal__dot--red"></span>
            <span class="terminal__dot terminal__dot--amber"></span>
            <span class="terminal__dot terminal__dot--teal"></span>
          </span>
          <span class="terminal__path">~/whoami</span>
        </figcaption>
        <div class="terminal__body">
          <p class="terminal__cmd">
            <span class="terminal__prompt">jmrp@home:~$</span> stat
          </p>
          <dl class="terminal__grid">
            <dt>role</dt>
            <dd>{t("pages.home.terminalRole")}</dd>
            <dt>focus</dt>
            <dd>{whoami.focus}</dd>
            <dt>base</dt>
            <dd>{whoami.base}</dd>
          </dl>
        </div>
      </figure>
    </div>
  </section>

  {
    featuredProjects.length > 0 && (
      <section class="home-section">
        <div class="container">
          <div class="home-section__head">
            <h2 class="section-title standard">
              {t("pages.home.featuredProjects")}
            </h2>
            <a
              href={translatePath("/github/")}
              class="home-section__link"
            >
              {t("pages.home.viewAllRepos")}
            </a>
          </div>
          <div class="grid-layout">
            {featuredProjects.map((repo) => (
              <RepoCard repo={repo} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    latestPosts.length > 0 && (
      <section class="home-section">
        <div class="container">
          <div class="home-section__head">
            <h2 class="section-title standard">
              {t("pages.home.latestFromBlog")}
            </h2>
            <a
              href={translatePath("/blog/")}
              class="home-section__link"
            >
              {t("pages.home.viewAllPosts")}
            </a>
          </div>
          <div class="grid-layout">
            {latestPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: var(--space-xl) 0 var(--space-lg-xl);
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  /* Availability status pill — teal dot + text (never colour alone) */
  .hero__status {
    display: inline-flex;
    gap: var(--space-sm);
    align-items: center;
    padding: var(--space-xs) var(--space-md);
    margin: 0 0 var(--space-md-lg);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text);
    background: color-mix(in srgb, var(--teal) 8%, var(--color-bg-secondary));
    border: 1px solid color-mix(in srgb, var(--teal) 32%, var(--color-border));
    border-radius: 999px;
  }

  .hero__status-dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--teal);
    border-radius: 50%;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--teal) 22%, transparent);
  }

  .hero__title {
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    font-weight: var(--fw-bold);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .hero__subtitle {
    margin: 0 0 var(--space-md);
    font-size: 1.375rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .hero__subtitle :global(strong) {
    font-weight: var(--fw-semibold);
    color: var(--color-accent);
  }

  .hero__bio {
    max-width: 60ch;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .hero__bio :global(p) {
    margin: 0 0 var(--space-md);
  }

  .hero__bio :global(strong) {
    font-weight: var(--fw-semibold);
    color: var(--color-accent);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-md-lg);
  }

  .hero__cta span[class^="i-"] {
    flex-shrink: 0;
    width: 1.05rem;
    height: 1.05rem;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .hero__cta .btn-primary:hover span[class^="i-"] {
    transform: translateX(3px);
  }

  /* ---------- Terminal "whoami" card ---------- */
  .terminal {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--sh-card);
  }

  .terminal__bar {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-hair);
  }

  .terminal__dots {
    display: inline-flex;
    gap: 0.4rem;
  }

  .terminal__dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
  }

  .terminal__dot--red {
    background: color-mix(in srgb, var(--color-text-muted) 55%, transparent);
  }

  .terminal__dot--amber {
    background: var(--color-accent);
  }

  .terminal__dot--teal {
    background: var(--teal);
  }

  .terminal__path {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .terminal__body {
    padding: var(--space-md-lg) var(--space-md-lg) var(--space-lg);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .terminal__cmd {
    margin: 0 0 var(--space-md);
    color: var(--color-text);
  }

  .terminal__prompt {
    color: var(--color-text);
  }

  .terminal__grid {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-sm) var(--space-md-lg);
    margin: 0;
  }

  .terminal__grid dt {
    color: var(--color-text);
  }

  .terminal__grid dd {
    margin: 0;
    color: var(--color-text-heading);
  }

  /* ---------- Featured / Latest sections ---------- */
  .home-section {
    padding: var(--space-lg-xl) 0;
  }

  .home-section__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-hair);
  }

  .home-section__head .section-title {
    margin-bottom: 0;
  }

  .home-section__link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .home-section__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-lg);
  }

  /* ---------- Responsive ---------- */
  @media (width <= 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .terminal {
      order: 2;
    }

    .hero__subtitle {
      font-size: 1.25rem;
    }
  }
</style>
