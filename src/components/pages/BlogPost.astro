---
/**
 * Blog Post shared component.
 * Renders individual blog posts with custom MDX components,
 * Table of Contents, and SEO schema.
 */
import "@styles/blog.css";

import AuthorCard from "@components/blog/AuthorCard.astro";
import TableOfContentsDrawer from "@components/layout/TableOfContentsDrawer.astro";
import Callout from "@components/ui/Callout.astro";
import FAQ from "@components/ui/FAQ.astro";
import Code from "@components/ui/Code.astro";
import FallbackBanner from "@components/ui/FallbackBanner.astro";
import References from "@components/ui/References.astro";
import TabPanel from "@components/ui/TabPanel.astro";
import Tabs from "@components/ui/Tabs.astro";
import YouTube from "@components/ui/YouTube.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { formatDate, useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { SiteConfig } from "@src/types";
import { getSiteUrl } from "@utils/site";
import { getImage, Image } from "astro:assets";
import { type CollectionEntry, getEntry, render } from "astro:content";
import * as cheerio from "cheerio";

interface Props {
  /** The blog post entry from the content collection. */
  post: CollectionEntry<"posts">;
  /** Whether this post is a fallback (untranslated) from another locale. */
  isFallback?: boolean;
}

const { post, isFallback = false } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

const { Content, headings } = await render(post);

// --- Reference Collection Logic ---
const bodyWithoutCode = (post.body || "")
  .replaceAll(/```[\s\S]*?```/g, "")
  .replaceAll(/`[^`]*?`/g, "");

const linkRegex = /\[([^\]]+)\]\(([^)]+(?:\([^)]+\)[^)]*)*)\)/g;
const collectedRefsFromMarkdown = [];
let match;
while ((match = linkRegex.exec(bodyWithoutCode)) !== null) {
  const url = match[2];
  if (url.startsWith("#")) continue;
  collectedRefsFromMarkdown.push({ text: match[1], url });
}

const $ = cheerio.load(bodyWithoutCode);
$('a[href^="http"], a[href^="//"]').each((_, el) => {
  const $el = $(el);
  const url = $el.attr("href");
  const text = $el.text().replaceAll(/\s+/g, " ").trim();
  if (url && text) {
    collectedRefsFromMarkdown.push({ text, url });
  }
});

const uniqueUrls = new Set<string>();
const finalReferences = collectedRefsFromMarkdown.filter((ref) => {
  if (!uniqueUrls.has(ref.url)) {
    uniqueUrls.add(ref.url);
    return true;
  }
  return false;
});
// --- End of Reference Logic ---

// --- Image Optimization (JSON-LD) ---
let jsonLdImage = "/default-blog-cover.webp";

const coverImageWidths = [400, 450, 540, 600, 720, 800, 1080, 1200];
const coverImageSizes =
  "(max-width: 768px) calc(100vw - 2.5rem), (max-width: 1024px) 600px, 460px";

if (post.data.coverImage) {
  const coverImage = post.data.coverImage;
  const schemaImage = await getImage({
    src: coverImage,
    format: "webp",
    width: 1200,
    height: 675,
    quality: 60,
  });
  jsonLdImage = schemaImage.src;
}

// Canonical page URL — trailing slash so `@id`/`mainEntityOfPage` reconcile with
// the page canonical (broken links between the article entity and its page otherwise).
const postUrl = new URL(`/blog/${post.data.slug}/`, getSiteUrl()).href;

// Approximate body word count (code blocks already stripped in `bodyWithoutCode`).
const wordCount = bodyWithoutCode
  .replaceAll(/<[^>]+>/g, " ")
  .replaceAll(/[#>*_`~[\]()!]/g, " ")
  .split(/\s+/)
  .filter(Boolean).length;

const personRef = { "@id": new URL("#person", getSiteUrl()).href };

// Primary article node. `articleType` (frontmatter) selects BlogPosting vs the
// more specific, AI-recognized TechArticle for engineering guides.
const articleNode = {
  "@type": post.data.articleType,
  "@id": `${postUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedDate.toISOString(),
  // Only emit dateModified when the post was actually updated, so identical
  // published/modified dates don't dilute the freshness signal.
  ...(post.data.updatedDate && {
    dateModified: post.data.updatedDate.toISOString(),
  }),
  publisher: personRef,
  author: personRef,
  image: new URL(jsonLdImage, getSiteUrl()).href,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  inLanguage: locale,
  wordCount,
  ...(post.data.articleType === "TechArticle" &&
    post.data.proficiencyLevel && {
      proficiencyLevel: post.data.proficiencyLevel,
    }),
  ...(post.data.tags.length > 0 && {
    keywords: post.data.tags,
    articleSection: post.data.tags[0],
  }),
  // Surface the lead/summary to voice assistants and AI readers.
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".post-header h1", ".post-header .lead"],
  },
  isPartOf: {
    "@id": new URL("#website", getSiteUrl()).href,
  },
};

// Secondary graph nodes: FAQPage (from `faq`) and HowTo (from `howto`).
// Both share the post's `faq`/`howto` frontmatter as the single source of truth.
const faqNode =
  post.data.faq && post.data.faq.length > 0
    ? {
        "@type": "FAQPage",
        "@id": `${postUrl}#faq`,
        isPartOf: { "@id": `${postUrl}#article` },
        mainEntity: post.data.faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      }
    : undefined;

const howtoNode = post.data.howto
  ? {
      "@type": "HowTo",
      "@id": `${postUrl}#howto`,
      name: post.data.howto.name,
      ...(post.data.howto.totalTime && {
        totalTime: post.data.howto.totalTime,
      }),
      ...(post.data.howto.tools && {
        tool: post.data.howto.tools.map((name) => ({
          "@type": "HowToTool",
          name,
        })),
      }),
      ...(post.data.howto.supplies && {
        supply: post.data.howto.supplies.map((name) => ({
          "@type": "HowToSupply",
          name,
        })),
      }),
      step: post.data.howto.steps.map((s, i) => ({
        "@type": "HowToStep",
        position: i + 1,
        name: s.name,
        text: s.text,
        ...(s.anchor && { url: `${postUrl}#${s.anchor}` }),
      })),
    }
  : undefined;

const articleSchema = [
  articleNode,
  ...(faqNode ? [faqNode] : []),
  ...(howtoNode ? [howtoNode] : []),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  image={post.data.coverImage?.src}
  publishDate={post.data.publishedDate}
  modifiedDate={post.data.updatedDate}
  tags={post.data.tags}
  schema={articleSchema}
>
  {isFallback && <FallbackBanner locale={locale} />}
  <article
    class="post-content"
    lang={isFallback ? "en" : undefined}
    data-code-fallback={t("pages.blogPost.codeFallback")}
    data-code-example-template={t("pages.blogPost.codeExampleTemplate", {
      lang: "{lang}",
      index: "{index}",
    })}
  >
    <header class="post-header">
      <div class="content-wrapper">
        <div class="header-meta">
          <a
            href={translatePath("/blog/")}
            class="back-link"
          >
            <span class="i-mdi:arrow-left h-5 w-5"></span>
            {t("pages.blogPost.backToBlog")}
          </a>
          <div class="meta">
            <span class="author">
              {post.data.author || siteData.author}
            </span>
            <span class="separator">•</span>
            <time datetime={post.data.publishedDate.toISOString()}>
              {formatDate(post.data.publishedDate, locale)}
            </time>
            <span class="separator">•</span>
            {
              post.data.tags && (
                <div class="tags">
                  {post.data.tags.map((tag) => (
                    <a
                      href={translatePath(
                        `/blog/tags/${encodeURIComponent(tag.toLowerCase())}/`,
                      )}
                      class="tag"
                      aria-label={t("aria.viewTaggedPosts", { tag })}
                    >
                      #{tag}
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        </div>

        <div class="header-grid">
          <div class="header-content">
            <h1>{post.data.title}</h1>
            <p class="lead">{post.data.description}</p>
          </div>
          {
            post.data.coverImage && (
              <div class="cover-image-container">
                <Image
                  src={post.data.coverImage}
                  alt={t("pages.blogPost.coverImageAlt", {
                    title: post.data.title,
                  })}
                  class="cover-image"
                  width={1200}
                  height={675}
                  format="webp"
                  loading="eager"
                  decoding="sync"
                  fetchpriority="high"
                  widths={coverImageWidths}
                  sizes={coverImageSizes}
                  quality={70}
                  style="width: 100%; height: auto; aspect-ratio: 16/9;"
                />
              </div>
            )
          }
        </div>
      </div>
    </header>

    <div class="layout-grid content-wrapper">
      <div class="prose">
        <Content components={{ Callout, Tabs, TabPanel, YouTube, Code }} />
        {
          post.data.faq && post.data.faq.length > 0 && (
            <FAQ items={post.data.faq} />
          )
        }
        <References references={finalReferences} />
        <AuthorCard />
      </div>
    </div>
  </article>

  <TableOfContentsDrawer headings={headings} />

  {/* ICON_DETECTION_START */}
  <div
    class="hidden"
    aria-hidden="true"
  >
    <span class="i-mdi:shield-check"></span>
    <span class="i-mdi:folder-outline"></span>
    <span class="i-mdi:file-cog"></span>
    <span class="i-mdi:alert"></span>
    <span class="i-mdi:shield-alert"></span>
    <span class="i-devicon:nginx"></span>
    <span class="i-mdi:lock"></span>
    <span class="i-mdi:speedometer"></span>
    <span class="i-mdi:refresh"></span>
    <span class="i-mdi:bash"></span>
    <span class="i-mdi:linux"></span>
    <span class="i-mdi:calendar-clock"></span>
    <span class="i-mdi:cellphone"></span>
    <span class="i-mdi:apple-finder"></span>
    <span class="i-mdi:key-alert"></span>
    <span class="i-mdi:lightbulb"></span>
    <span class="i-mdi:information"></span>
    <span class="i-mdi:language-javascript"></span>
    <span class="i-mdi:monitor-dashboard"></span>
    <span class="i-mdi:check-decagram"></span>
    <span class="i-simple-icons:astro"></span>
    <span class="i-mdi:shield-lock"></span>
    <span class="i-mdi:code-json"></span>
    <span class="i-mdi:nodejs"></span>
    <span class="i-mdi:cog"></span>
    <span class="i-mdi:trophy"></span>
    <span class="i-mdi:cellphone-wireless"></span>
    <span class="i-mdi:incognito"></span>
    <span class="i-mdi:alert-circle"></span>
    <span class="i-mdi:file-code"></span>
  </div>
  {/* ICON_DETECTION_END */}
</BaseLayout>

<script>
  const observedElements = new WeakSet<Element>();
  const observerMap = new Map<Element, MutationObserver>();

  const cleanupObservers = () => {
    observerMap.forEach((observer) => observer.disconnect());
    observerMap.clear();
  };

  const setupPostInteractions = () => {
    cleanupObservers();

    const rIC: (callback: IdleRequestCallback) => number =
      window.requestIdleCallback?.bind(window) ??
      ((cb) =>
        window.setTimeout(
          () =>
            cb({ didTimeout: false, timeRemaining: () => 50 } as IdleDeadline),
          50,
        ));

    const applyLabels = () => {
      rIC(() => {
        const article = document.querySelector(".post-content");
        const codeFallback =
          article?.getAttribute("data-code-fallback") || "Code";
        const exampleTemplate =
          article?.getAttribute("data-code-example-template") ||
          "{lang} example {index}";

        const codeBlocks = document.querySelectorAll(
          'pre[role="region"]:not([aria-label])',
        );
        codeBlocks.forEach((block, index) => {
          const lang = block.getAttribute("data-language") || codeFallback;
          block.setAttribute(
            "aria-label",
            exampleTemplate
              .replace("{lang}", lang)
              .replace("{index}", String(index + 1)),
          );
        });
      });
    };

    setTimeout(applyLabels, 100);

    const prose = document.querySelector(".prose");
    if (prose && !observedElements.has(prose)) {
      observedElements.add(prose);
      let timeout: ReturnType<typeof setTimeout>;
      const observer = new MutationObserver(() => {
        clearTimeout(timeout);
        timeout = setTimeout(applyLabels, 300);
      });
      observer.observe(prose, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ["role"],
      });
      observerMap.set(prose, observer);
    }
  };

  setupPostInteractions();
  if (!document.documentElement.hasAttribute("data-blog-listener-init")) {
    document.documentElement.setAttribute("data-blog-listener-init", "true");
    document.addEventListener("astro:after-swap", setupPostInteractions);
  }
</script>

<style>
  .post-header {
    padding: var(--space-lg) 0;
    margin-bottom: var(--space-md-lg);
    background-color: var(--color-bg-secondary);
    border-bottom: var(--border-1);
  }

  .content-wrapper {
    width: 100%;
    max-width: var(--max-width-container);
    padding: 0 var(--space-lg);
    margin: 0 auto;
  }

  .header-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .header-meta {
    margin-bottom: var(--space-lg);
  }

  .header-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
    min-height: 1.5em;
    font-family:
      system-ui,
      -apple-system,
      blinkmacsystemfont,
      "Segoe UI",
      roboto,
      helvetica,
      arial,
      sans-serif;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .author {
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  .separator {
    display: inline-block;
    width: 1ch;
    text-align: center;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tag {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition:
      color 0.2s ease,
      text-decoration 0.2s ease;
  }

  .tag:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tag:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  h1 {
    margin-bottom: 1.25rem;
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lead {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .cover-image-container {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .cover-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  @media (width > 1024px) {
    .post-header {
      padding: var(--space-lg-xl) 0;
    }

    .header-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: var(--space-xl);
      align-items: center;
    }

    h1 {
      font-size: 3.5rem;
    }

    .cover-image-container {
      max-width: none;
      height: auto;
      max-height: none;
      margin: 0;
    }
  }

  @media (width <= 1024px) {
    .cover-image-container {
      order: 2;
      max-width: 600px;
      margin-top: var(--space-md-lg);
      margin-right: auto;
      margin-left: auto;
    }
  }

  @media (width <= 768px) {
    .post-header {
      padding: var(--space-lg) 0;
      text-align: left;
    }

    h1 {
      font-size: 2rem;
    }

    .lead {
      font-size: 1.125rem;
    }

    .content-wrapper {
      padding: 0 1.25rem;
    }

    .cover-image-container {
      width: 100%;
    }
  }
</style>
