---
/**
 * Blog Post shared component.
 * Renders individual blog posts with custom MDX components,
 * Table of Contents, and SEO schema.
 */
import "@styles/blog.css";

import AuthorCard from "@components/blog/AuthorCard.astro";
import RelatedContent from "@components/blog/RelatedContent.astro";
import TableOfContentsDrawer from "@components/layout/TableOfContentsDrawer.astro";
import Callout from "@components/ui/Callout.astro";
import Code from "@components/ui/Code.astro";
import FallbackBanner from "@components/ui/FallbackBanner.astro";
import FAQ from "@components/ui/FAQ.astro";
import References from "@components/ui/References.astro";
import TabPanel from "@components/ui/TabPanel.astro";
import Tabs from "@components/ui/Tabs.astro";
import YouTube from "@components/ui/YouTube.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { formatDate, useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { SiteConfig } from "@src/types";
import { formatDateDot, getReadingTime } from "@utils/blog";
import { getRelatedContent } from "@utils/related";
import { getSiteUrl } from "@utils/site";
import { getImage, Picture } from "astro:assets";
import { type CollectionEntry, getEntry, render } from "astro:content";
import * as cheerio from "cheerio";
import type { BlogPosting, FAQPage, HowTo, TechArticle } from "schema-dts";

interface Props {
  /** The blog post entry from the content collection. */
  post: CollectionEntry<"posts">;
  /** Whether this post is a fallback (untranslated) from another locale. */
  isFallback?: boolean;
}

const { post, isFallback = false } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

const { Content, headings } = await render(post);

// Post header meta: dot date + reading time + 1–2 amber category chips
// (the full tag list lives in the JSON-LD / tag pages, not the header).
const readingMin = getReadingTime(post);
const primaryTags = (post.data.tags ?? []).slice(0, 2);

// Curated related posts/tools, keyed by the post's numeric slug prefix.
const postNumber = /^(\d{3})-/.exec(post.data.slug)?.[1] ?? "";
const relatedContent = await getRelatedContent(postNumber, locale);

// --- Reference Collection Logic ---
const bodyWithoutCode = (post.body || "")
  .replaceAll(/```[\s\S]*?```/g, "")
  .replaceAll(/`[^`]*?`/g, "");

// Link-text group excludes newlines and `[`/`{` so the scan can't run from a
// JSX array/object bracket (e.g. `events={[ … [Real Link](url)`) through to a
// real link's `](`, which would otherwise capture a mangled multi-line "title".
const linkRegex = /\[([^\]\n[{]+)\]\(([^)]+(?:\([^)]+\)[^)]*)*)\)/g;
const collectedRefsFromMarkdown = [];
let match;
while ((match = linkRegex.exec(bodyWithoutCode)) !== null) {
  const url = match[2];
  if (url.startsWith("#")) continue;
  collectedRefsFromMarkdown.push({ text: match[1], url });
}

const $ = cheerio.load(bodyWithoutCode);
$('a[href^="http"], a[href^="//"]').each((_, el) => {
  const $el = $(el);
  const url = $el.attr("href");
  const text = $el.text().replaceAll(/\s+/g, " ").trim();
  if (url && text) {
    collectedRefsFromMarkdown.push({ text, url });
  }
});

const uniqueUrls = new Set<string>();
const finalReferences = collectedRefsFromMarkdown.filter((ref) => {
  if (!uniqueUrls.has(ref.url)) {
    uniqueUrls.add(ref.url);
    return true;
  }
  return false;
});
// --- End of Reference Logic ---

// --- Image Optimization (JSON-LD) ---
let jsonLdImage = "/default-blog-cover.webp";
// Height of the fallback cover (public/default-blog-cover.webp, 1200×800);
// overwritten below when a per-post `coverImage` is optimized instead (which
// is always rendered at the same 1200px width, just a different aspect ratio).
let jsonLdImageHeight = 800;
const jsonLdImageWidth = 1200;

const coverImageWidths = [400, 540, 600, 712, 800, 1080, 1200];
// Narrow 760px stacked header: 760px max-width minus 2×24px side padding = 712px.
const coverImageSizes = "(max-width: 768px) calc(100vw - 2.5rem), 712px";

if (post.data.coverImage) {
  const coverImage = post.data.coverImage;
  const schemaImage = await getImage({
    src: coverImage,
    format: "webp",
    width: 1200,
    height: 675,
    quality: 60,
  });
  jsonLdImage = schemaImage.src;
  jsonLdImageHeight = 675;
}

// Canonical page URL — trailing slash so `@id`/`mainEntityOfPage` reconcile with
// the page canonical (broken links between the article entity and its page otherwise).
// Locale-aware: ES pages must emit the /es/ canonical, not the EN one — otherwise
// the ES article collapses into the EN entity (same @id, two headlines).
const postUrl = new URL(translatePath(`/blog/${post.data.slug}/`), getSiteUrl())
  .href;

// The same post in the other locale. Both files share the numeric slug, so the
// counterpart URL is derivable without a lookup. Linking them with
// workTranslation/translationOfWork tells consumers these are two renderings of
// one work, not two competing entities.
const counterpartUrl = new URL(
  locale === "es" ? `/blog/${post.data.slug}/` : `/es/blog/${post.data.slug}/`,
  getSiteUrl(),
).href;

const translationLink =
  locale === "es"
    ? { translationOfWork: { "@id": `${counterpartUrl}#article` } }
    : { workTranslation: { "@id": `${counterpartUrl}#article` } };

// Approximate body word count (code blocks already stripped in `bodyWithoutCode`).
const wordCount = bodyWithoutCode
  .replaceAll(/<[^>]+>/g, " ")
  .replaceAll(/[#>*_`~[\]()!]/g, " ")
  .split(/\s+/)
  .filter(Boolean).length;

const personRef = { "@id": new URL("#person", getSiteUrl()).href };

// Primary article node. `articleType` (frontmatter) selects BlogPosting vs the
// more specific, AI-recognized TechArticle for engineering guides.
const articleNode = {
  "@type": post.data.articleType,
  "@id": `${postUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedDate.toISOString(),
  // Always emit dateModified: for a never-edited post the last modification IS
  // its publication date (Google/Schema.org recommend it on Article — a
  // freshness signal AI engines read); revised posts use their real updatedDate.
  dateModified: (
    post.data.updatedDate ?? post.data.publishedDate
  ).toISOString(),
  publisher: personRef,
  author: personRef,
  image: {
    "@type": "ImageObject",
    url: new URL(jsonLdImage, getSiteUrl()).href,
    // Numeric, not a quoted string: schema.org types MediaObject width/height
    // as Distance | QuantitativeValue, never Text. E37 = pixel (UN/CEFACT).
    width: {
      "@type": "QuantitativeValue",
      value: jsonLdImageWidth,
      unitCode: "E37",
    },
    height: {
      "@type": "QuantitativeValue",
      value: jsonLdImageHeight,
      unitCode: "E37",
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  // Fallback (untranslated) posts render English content, so mark them as such.
  inLanguage: isFallback ? "en" : locale,
  wordCount,
  ...(post.data.articleType === "TechArticle" &&
    post.data.proficiencyLevel && {
      proficiencyLevel: post.data.proficiencyLevel,
    }),
  ...(post.data.tags.length > 0 && {
    keywords: post.data.tags,
    articleSection: post.data.tags[0],
  }),
  // Topic entities linked to Wikidata: first = about (primary), rest = mentions.
  // `@id` uses Wikidata's canonical entity concept URI scheme (plain,
  // non-secure scheme by design — the standard Linked Data identifier, not a
  // fetchable link; see the inline disable comments below).
  ...(post.data.topics &&
    post.data.topics.length > 0 && {
      about: {
        "@type": "Thing",
        name: post.data.topics[0].name,
        // eslint-disable-next-line unicorn/prefer-https -- see comment above
        "@id": `http://www.wikidata.org/entity/${post.data.topics[0].wikidata}`,
      },
      ...(post.data.topics.length > 1 && {
        mentions: post.data.topics.slice(1).map((topic) => ({
          "@type": "Thing",
          name: topic.name,
          // eslint-disable-next-line unicorn/prefer-https -- see comment above
          "@id": `http://www.wikidata.org/entity/${topic.wikidata}`,
        })),
      }),
    }),
  ...translationLink,
  // Surface the lead/summary to voice assistants and AI readers.
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".post-header h1", ".post-header .lead", ".tldr-content"],
  },
  isPartOf: {
    "@id": new URL("#website", getSiteUrl()).href,
  },
} satisfies BlogPosting | TechArticle;

// Secondary graph nodes: FAQPage (from `faq`) and HowTo (from `howto`).
// Both share the post's `faq`/`howto` frontmatter as the single source of truth.
const faqNode =
  post.data.faq && post.data.faq.length > 0
    ? ({
        "@type": "FAQPage",
        "@id": `${postUrl}#faq`,
        isPartOf: { "@id": `${postUrl}#article` },
        mainEntity: post.data.faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      } satisfies FAQPage)
    : undefined;

const howtoNode = post.data.howto
  ? ({
      "@type": "HowTo",
      "@id": `${postUrl}#howto`,
      name: post.data.howto.name,
      ...(post.data.howto.totalTime && {
        totalTime: post.data.howto.totalTime,
      }),
      ...(post.data.howto.tools && {
        tool: post.data.howto.tools.map((name) => ({
          "@type": "HowToTool",
          name,
        })),
      }),
      ...(post.data.howto.supplies && {
        supply: post.data.howto.supplies.map((name) => ({
          "@type": "HowToSupply",
          name,
        })),
      }),
      step: post.data.howto.steps.map((s, i) => ({
        "@type": "HowToStep",
        position: i + 1,
        name: s.name,
        text: s.text,
        ...(s.anchor && { url: `${postUrl}#${s.anchor}` }),
      })),
    } satisfies HowTo)
  : undefined;

const articleSchema = [
  articleNode,
  ...(faqNode ? [faqNode] : []),
  ...(howtoNode ? [howtoNode] : []),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishDate={post.data.publishedDate}
  modifiedDate={post.data.updatedDate}
  tags={post.data.tags}
  schema={articleSchema}
>
  {isFallback && <FallbackBanner locale={locale} />}
  <article
    class="post-content"
    lang={isFallback ? "en" : undefined}
    data-code-fallback={t("pages.blogPost.codeFallback")}
    data-code-example-template={t("pages.blogPost.codeExampleTemplate", {
      lang: "{lang}",
      index: "{index}",
    })}
  >
    <header class="post-header">
      <div
        class="lab-grid"
        aria-hidden="true"
      >
      </div>
      <div class="content-wrapper">
        <div class="header-meta">
          <a
            href={translatePath("/blog/")}
            class="back-link"
          >
            <span class="i-mdi:arrow-left h-5 w-5"></span>
            {t("pages.blogPost.backToBlog")}
          </a>
          <div class="meta">
            {
              primaryTags.length > 0 && (
                <div class="tags">
                  {primaryTags.map((tag) => (
                    <a
                      href={translatePath(
                        `/blog/tags/${encodeURIComponent(tag.toLowerCase())}/`,
                      )}
                      class="tag-chip"
                      aria-label={t("aria.viewTaggedPosts", { tag })}
                    >
                      {tag}
                    </a>
                  ))}
                </div>
              )
            }
            <span
              class="meta-sep"
              aria-hidden="true"
            >
              ·
            </span>
            <time datetime={post.data.publishedDate.toISOString()}>
              {formatDateDot(post.data.publishedDate)}
            </time>
            <span
              class="meta-sep"
              aria-hidden="true"
            >
              ·
            </span>
            <span class="reading-time">
              {readingMin}
              {t("pages.blog.minRead")}
            </span>
            {
              post.data.updatedDate && (
                <time
                  class="updated"
                  datetime={post.data.updatedDate.toISOString()}
                >
                  {t("pages.blogPost.updatedOn", {
                    date: formatDate(post.data.updatedDate, locale),
                  })}
                </time>
              )
            }
          </div>
        </div>

        <div class="header-grid">
          <div class="header-content">
            <h1>{post.data.title}</h1>
            <p class="lead">{post.data.description}</p>
            <div class="byline">
              {
                /* Monogram initials avatar — decorative; author name in adjacent text */
              }
              <span
                class="byline__avatar"
                aria-hidden="true"
                >JM</span
              >
              <span class="byline__text">
                <span class="byline__name">
                  {post.data.author || siteData.author}
                </span>
              </span>
            </div>
          </div>
          {
            post.data.coverImage && (
              <div class="cover-image-container">
                <Picture
                  src={post.data.coverImage}
                  alt={t("pages.blogPost.coverImageAlt", {
                    title: post.data.title,
                  })}
                  class="cover-image"
                  width={post.data.coverImage.width}
                  height={post.data.coverImage.height}
                  formats={["avif", "webp"]}
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                  widths={coverImageWidths}
                  sizes={coverImageSizes}
                  quality={70}
                />
              </div>
            )
          }
        </div>
      </div>
    </header>

    <div
      class:list={[
        "reading-section",
        { "reading-section--with-toc": headings.length > 0 },
      ]}
    >
      {
        headings.length > 0 && (
          <nav
            class="toc-rail"
            aria-label={t("aria.tableOfContents")}
          >
            <div
              class="toc-rail__eyebrow"
              aria-hidden="true"
            >
              {t("aria.tableOfContents")}
            </div>
            <div class="toc-rail__nav">
              <ul>
                {headings.map((heading) => (
                  <li class={`toc-depth-${heading.depth}`}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        )
      }
      <div class="prose">
        <Content components={{ Callout, Tabs, TabPanel, YouTube, Code }} />
        {
          post.data.faq && post.data.faq.length > 0 && (
            <FAQ items={post.data.faq} />
          )
        }
        <RelatedContent
          posts={relatedContent.posts}
          tools={relatedContent.tools}
        />
        <References references={finalReferences} />
        <AuthorCard />
      </div>
    </div>
  </article>

  <TableOfContentsDrawer headings={headings} />

  {/* ICON_DETECTION_START */}
  <div
    class="hidden"
    aria-hidden="true"
  >
    <span class="i-mdi:shield-check"></span>
    <span class="i-mdi:folder-outline"></span>
    <span class="i-mdi:file-cog"></span>
    <span class="i-mdi:alert"></span>
    <span class="i-mdi:shield-alert"></span>
    <span class="i-devicon:nginx"></span>
    <span class="i-mdi:lock"></span>
    <span class="i-mdi:speedometer"></span>
    <span class="i-mdi:refresh"></span>
    <span class="i-mdi:bash"></span>
    <span class="i-mdi:linux"></span>
    <span class="i-mdi:calendar-clock"></span>
    <span class="i-mdi:cellphone"></span>
    <span class="i-mdi:apple-finder"></span>
    <span class="i-mdi:key-alert"></span>
    <span class="i-mdi:lightbulb"></span>
    <span class="i-mdi:information"></span>
    <span class="i-mdi:language-javascript"></span>
    <span class="i-mdi:monitor-dashboard"></span>
    <span class="i-mdi:check-decagram"></span>
    <span class="i-simple-icons:astro"></span>
    <span class="i-mdi:shield-lock"></span>
    <span class="i-mdi:code-json"></span>
    <span class="i-mdi:nodejs"></span>
    <span class="i-mdi:cog"></span>
    <span class="i-mdi:trophy"></span>
    <span class="i-mdi:cellphone-wireless"></span>
    <span class="i-mdi:incognito"></span>
    <span class="i-mdi:alert-circle"></span>
    <span class="i-mdi:file-code"></span>
  </div>
  {/* ICON_DETECTION_END */}
</BaseLayout>

<script>
  const observedElements = new WeakSet<Element>();
  const observerMap = new Map<Element, MutationObserver>();
  let tocSpyObserver: IntersectionObserver | undefined;

  const cleanupObservers = () => {
    observerMap.forEach((observer) => observer.disconnect());
    observerMap.clear();
  };

  /**
   * Sets up scroll-spy on the desktop TOC rail.
   * Uses IntersectionObserver to track which heading is nearest the top
   * of the viewport and marks the corresponding rail link aria-current.
   */
  const setupTocScrollSpy = () => {
    tocSpyObserver?.disconnect();
    tocSpyObserver = undefined;

    const railNav = document.querySelector<HTMLElement>(".toc-rail__nav");
    if (!railNav) return;

    const headingEls = Array.from(
      document.querySelectorAll<HTMLElement>(".prose h2[id], .prose h3[id]"),
    );
    if (!headingEls.length) return;

    const links = railNav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]');

    const setActive = (id: string | null) => {
      links.forEach((link) => {
        if (link.getAttribute("href") === `#${id}`) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const visible = new Set<string>();

    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            visible.add(entry.target.id);
          } else {
            visible.delete(entry.target.id);
          }
        }
        const first = headingEls.find((h) => visible.has(h.id));
        setActive(first?.id ?? null);
      },
      { rootMargin: "-84px 0px -60% 0px", threshold: 0 },
    );

    tocSpyObserver = spy;
    headingEls.forEach((h) => spy.observe(h));
  };

  const setupPostInteractions = () => {
    cleanupObservers();

    const rIC: (callback: IdleRequestCallback) => number =
      window.requestIdleCallback?.bind(window) ??
      ((cb) =>
        window.setTimeout(
          () =>
            cb({ didTimeout: false, timeRemaining: () => 50 } as IdleDeadline),
          50,
        ));

    const applyLabels = () => {
      rIC(() => {
        const article = document.querySelector(".post-content");
        const codeFallback =
          article?.getAttribute("data-code-fallback") || "Code";
        const exampleTemplate =
          article?.getAttribute("data-code-example-template") ||
          "{lang} example {index}";

        const codeBlocks = document.querySelectorAll(
          'pre[role="region"]:not([aria-label])',
        );
        codeBlocks.forEach((block, index) => {
          const lang = block.getAttribute("data-language") || codeFallback;
          block.setAttribute(
            "aria-label",
            exampleTemplate
              .replace("{lang}", lang)
              .replace("{index}", String(index + 1)),
          );
        });
      });
    };

    setTimeout(applyLabels, 100);

    const prose = document.querySelector(".prose");
    if (prose && !observedElements.has(prose)) {
      observedElements.add(prose);
      let timeout: ReturnType<typeof setTimeout>;
      const observer = new MutationObserver(() => {
        clearTimeout(timeout);
        timeout = setTimeout(applyLabels, 300);
      });
      observer.observe(prose, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ["role"],
      });
      observerMap.set(prose, observer);
    }

    setupTocScrollSpy();
  };

  setupPostInteractions();
  if (!document.documentElement.hasAttribute("data-blog-listener-init")) {
    document.documentElement.setAttribute("data-blog-listener-init", "true");
    document.addEventListener("astro:after-swap", setupPostInteractions);
  }
</script>

<style>
  .post-header {
    position: relative;
    padding: var(--space-lg-xl) 0 0;
    margin-bottom: 0;
    overflow: hidden;
  }

  .post-header > .lab-grid {
    z-index: 0;
  }

  .post-header > .content-wrapper {
    position: relative;
    z-index: 1;
  }

  /* Narrow header column — single stacked column at ~760px matching the mockup.
     Narrower than the global --max-width-container so the header feels intimate
     and the cover image sits centered below the lead rather than beside it. */
  .content-wrapper {
    width: 100%;
    max-width: 760px;
    padding: 0 var(--space-md-lg);
    margin: 0 auto;
  }

  .header-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .header-meta {
    margin-bottom: var(--space-lg);
  }

  .header-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    min-height: 1.5em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
  }

  .meta time {
    white-space: nowrap;
  }

  .meta-sep {
    color: var(--color-border);
  }

  .reading-time {
    white-space: nowrap;
  }

  .updated {
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Category chip — accent-dim tint (not solid fill) matching the mockup.
     Non-colour affordance: accent text on tinted bg distinguishes the chip from
     the muted meta text; only 1–2 primary tags shown so the header stays clean. */
  .tag-chip {
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    text-transform: lowercase;
    text-decoration: none;
    background: var(--accent-dim);
    border-radius: var(--radius-sm);
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .tag-chip:hover {
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
  }

  .tag-chip:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  h1 {
    margin-bottom: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(2.125rem, 4.8vw, 3.25rem); /* 34 → 52px, mockup */
    font-weight: var(--fw-bold);
    line-height: 1.05;
    color: var(--color-text-heading);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .lead {
    font-size: var(--text-xl);
    line-height: 1.6;
    color: var(--color-text);
  }

  /* Author byline strip below the lead. */
  .byline {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-md) 0;
    margin-top: var(--space-md-lg);
    border-top: 1px solid var(--color-hair);
    border-bottom: 1px solid var(--color-hair);
  }

  /* "JM" initials monogram — 36px accent-dim circle matching the mockup.
     display:grid/place-items centers the text; aria-hidden on the span
     means screen readers only read the adjacent .byline__name text. */
  .byline__avatar {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 36px;
    height: 36px;
    font-family: var(--font-display);
    font-size: var(--text-xs);
