---
/**
 * GitHub Repositories shared component.
 * Displays GitHub repositories using SSG + Islands architecture.
 */
import githubAvatar from "@assets/github-avatar.png";
import GitHubSearch from "@components/github/GitHubSearch.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { fetchGitHubProfile, fetchTopRepositories } from "@utils/github";
import { getSiteUrl } from "@utils/site";
import { getImage, Image } from "astro:assets";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const profile = await fetchGitHubProfile();
const repos = await fetchTopRepositories(12);

const avatarSrcSetResolves = await Promise.all(
  [60, 120, 240].map(async (w) => {
    const img = await getImage({
      src: githubAvatar,
      format: "webp",
      width: w,
      height: w,
    });
    return `${img.src} ${w}w`;
  }),
);

const avatarSrcSetString = avatarSrcSetResolves.join(", ");

const githubSchema = {
  "@type": "ProfilePage",
  "@id": new URL("#github-profile", new URL(Astro.url.pathname, getSiteUrl()))
    .href,
  name: t("pages.github.title"),
  description: t("pages.github.schemaDescription"),
  url: new URL(Astro.url.pathname, getSiteUrl()).href,
  inLanguage: locale,
  mainEntity: {
    "@type": "Person",
    name: profile.name ?? "José Manuel Requena Plens",
    url: profile.html_url ?? "https://github.com/jmrplens",
    sameAs: [profile.html_url ?? "https://github.com/jmrplens"],
  },
};
---

<BaseLayout
  title={t("pages.github.title")}
  description={t("pages.github.description")}
  schema={githubSchema}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset={avatarSrcSetString}
    imagesizes="(max-width: 768px) 120px, 240px"
    fetchpriority="high"
  />
  <div class="github-page container">
    <header class="gh-header">
      <div
        class="lab-grid"
        aria-hidden="true"
      >
      </div>
      <p class="section-title">{t("nav.repositories")}</p>
      <h1 class="gh-page-title">{t("pages.github.title")}</h1>
    </header>

    <div class="profile-header">
      <div class="profile-avatar">
        <Image
          src={githubAvatar}
          alt={profile.name ?? t("pages.github.avatarAlt")}
          width="120"
          height="120"
          widths={[60, 120, 240]}
          sizes="(max-width: 768px) 120px, 240px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="profile-info">
        <h2>
          {profile.name ?? profile.login ?? t("pages.github.userFallback")}
        </h2>
        <a
          href={profile.html_url}
          class="username"
          target="_blank"
          rel="noopener noreferrer"
        >
          @{profile.login}
        </a>
        <p class="bio">{profile.bio || t("pages.github.bioFallback")}</p>
        <div class="profile-stats">
          <div class="stat">
            <strong>{(profile.public_repos ?? 0).toLocaleString()}</strong>
            <span> {t("pages.github.repositories")}</span>
          </div>
          <div class="stat">
            <strong>{(profile.followers ?? 0).toLocaleString()}</strong>
            <span> {t("pages.github.followers")}</span>
          </div>
          <div class="stat">
            <strong>{(profile.following ?? 0).toLocaleString()}</strong>
            <span> {t("pages.github.following")}</span>
          </div>
        </div>
        {
          profile.location && (
            <p class="location">
              <span
                class="i-fa-solid:map-marker-alt"
                aria-hidden="true"
              />{" "}
              {profile.location}
            </p>
          )
        }
      </div>
    </div>

    <GitHubSearch initialRepos={repos} />
  </div>
</BaseLayout>

<style>
  /* Lab hero: mono kicker + display title over an ambient hairline grid. */
  .gh-header {
    position: relative;
    padding: var(--space-lg) 0 var(--space-md);
    margin-bottom: var(--space-lg);
    overflow: hidden;
  }

  .gh-header .section-title {
    position: relative;
    margin-bottom: var(--space-sm);
  }

  .gh-page-title {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
  }

  .profile-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: center;
    max-width: 100%;
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
    overflow: hidden;
    text-align: center;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-lg);
  }

  @media (width >= 768px) {
    .profile-header {
      flex-direction: row;
      gap: var(--space-xl);
      align-items: flex-start;
      text-align: left;
    }

    .profile-stats {
      justify-content: flex-start;
    }

    .location {
      justify-content: flex-start;
    }
  }

  .profile-avatar img {
    width: 120px;
    max-width: 100%;
    height: 120px;
    object-fit: cover;
    border: 2px solid var(--color-primary);
    border-radius: 50%;
  }

  .profile-info {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .profile-info h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .profile-info .username {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .profile-info .username:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .profile-info .bio {
    max-width: 100%;
    min-height: 1.5em;
    margin-bottom: 16px;
    overflow-wrap: anywhere;
  }

  .profile-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
    max-width: 100%;
    min-height: 1.5em;
    margin-top: var(--space-md);
    overflow-wrap: anywhere;
  }

  .stat strong {
    font-weight: var(--fw-bold);
    color: var(--color-text);
  }

  .stat span {
    color: var(--color-text-muted);
  }

  .stat {
    display: flex;
    gap: 4px;
    align-items: center;
    min-height: 1.5em;
  }

  .location {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    justify-content: center;
    margin-top: 12px;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
