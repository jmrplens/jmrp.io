---
/**
 * Uses page ("// /USES") — hardware, software, and self-hosted homelab in
 * rotation, grouped into columns of cards with a per-section intro line. All
 * content is a single localized source in `src/content/profile/uses.yaml`.
 * Per the "only mine" link policy, only the author's own services/projects
 * carry an `href` (internal paths are localized; full URLs used verbatim).
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const usesEntry = await getEntry("profile", "uses");
if (!usesEntry) throw new Error("Missing content: profile/uses.yaml");
const c = usesEntry.data[locale];

/** Internal paths get localized; full URLs pass through untouched. */
const resolveHref = (href: string) =>
  href.startsWith("/") ? translatePath(href) : href;
const isExternal = (href: string) => !href.startsWith("/");
---

<BaseLayout
  title={t("pages.uses.title")}
  description={t("pages.uses.description")}
>
  <div class="uses container">
    <header class="uses-header">
      <p class="section-title">{c.kicker}</p>
      <h1 class="page-title uses-header__title">{c.title}</h1>
      <p class="uses-header__intro">{c.intro}</p>
    </header>

    <div class="uses-grid">
      {
        c.groups.map((group) => (
          <section
            class="uses-col"
            aria-label={group.label.replace("// ", "")}
          >
            <h2 class="uses-col__title">{group.label}</h2>
            <p class="uses-col__intro">{group.intro}</p>
            <div class="uses-col__items">
              {group.items.map((item) => (
                <div class="uses-item">
                  <div class="uses-item__name">
                    {item.href ? (
                      <a
                        href={resolveHref(item.href)}
                        {...(isExternal(item.href)
                          ? {
                              target: "_blank",
                              rel: "external noopener noreferrer",
                            }
                          : {})}
                      >
                        {item.name}
                      </a>
                    ) : (
                      item.name
                    )}
                  </div>
                  <div class="uses-item__detail">{item.detail}</div>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .uses {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .uses-header {
    padding-bottom: var(--space-lg);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-hair);
  }

  .uses-header .section-title {
    margin-bottom: var(--space-sm);
  }

  .uses-header__title {
    padding-bottom: 0;
    margin: 0 0 var(--space-md);
    font-size: clamp(1.9rem, 4.5vw, 2.75rem);
    line-height: 1.05;
    border-bottom: 0;
  }

  .uses-header__intro {
    max-width: 60ch;
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text);
  }

  .uses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-lg);
    align-items: start;
  }

  .uses-col__title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .uses-col__intro {
    margin: 0 0 var(--space-md);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .uses-col__items {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .uses-item {
    padding: 14px 16px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .uses-item__name {
    font-size: var(--text-sm);
    color: var(--color-text-heading);
  }

  .uses-item__name a {
    color: inherit;
    text-decoration: none;
  }

  .uses-item__name a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .uses-item__detail {
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
  }
</style>
