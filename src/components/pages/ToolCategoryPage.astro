---
/**
 * Tool Category Page shared component.
 * Displays tools filtered by category, with the same filterable card
 * grid + chip bar as the tools landing.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { pluralize, useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";
import { getToolsForLocale } from "@utils/tools";
import type { CollectionEntry } from "astro:content";

interface Props {
  /** The category identifier. */
  category: string;
  /** Tools in this category. */
  tools: CollectionEntry<"tools">[];
}

const { category, tools } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

/** Category display metadata (order drives the chip bar). */
const categoryMeta: Record<
  string,
  {
    name: string;
    short: string;
    description: string;
    context?: string;
    order: number;
  }
> = {
  security: {
    name: t("pages.tools.categorySecurity"),
    short: t("pages.tools.shortSecurity"),
    description: t("pages.toolsCategory.securityDesc"),
    context: t("pages.toolsCategory.securityContext"),
    order: 1,
  },
  developer: {
    name: t("pages.tools.categoryDeveloper"),
    short: t("pages.tools.shortDeveloper"),
    description: t("pages.toolsCategory.developerDesc"),
    context: t("pages.toolsCategory.developerContext"),
    order: 2,
  },
  network: {
    name: t("pages.tools.categoryNetwork"),
    short: t("pages.tools.shortNetwork"),
    description: t("pages.toolsCategory.networkDesc"),
    context: t("pages.toolsCategory.networkContext"),
    order: 3,
  },
  embedded: {
    name: t("pages.tools.categoryEmbedded"),
    short: t("pages.tools.shortEmbedded"),
    description: t("pages.toolsCategory.embeddedDesc"),
    context: t("pages.toolsCategory.embeddedContext"),
    order: 4,
  },
  mikrotik: {
    name: t("pages.tools.categoryMikrotik"),
    short: t("pages.tools.shortMikrotik"),
    description: t("pages.toolsCategory.mikrotikDesc"),
    context: t("pages.toolsCategory.mikrotikContext"),
    order: 5,
  },
};

const meta = categoryMeta[category] ?? {
  name: category,
  short: category,
  description: t("pages.toolsCategory.fallbackDesc", { category }),
  order: 99,
};

/** All categories (ordered) for the chip bar, plus total for the "all" chip. */
const chipCategories = Object.entries(categoryMeta)
  .map(([id, m]) => ({ id, short: m.short, order: m.order }))
  .sort((a, b) => a.order - b.order);
const totalTools = (await getToolsForLocale(locale)).length;

const schema = {
  "@type": "CollectionPage",
  "@id": new URL("#collection", new URL(Astro.url.pathname, getSiteUrl())).href,
  name: meta.name,
  description: meta.description,
  url: new URL(Astro.url.pathname, getSiteUrl()).href,
  inLanguage: locale,
  isPartOf: { "@id": new URL("#website", getSiteUrl()).href },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: tools.length,
    itemListElement: tools.map(
      (tool: { data: { slug: string; title: string } }, index: number) => ({
        "@type": "ListItem",
        position: index + 1,
        // translatePath, or the ES pages emit a Spanish `name` next to an
        // English `url` — the same defect already fixed on
        // SiteNavigationElement. The markup below has always used it; only
        // this JSON-LD line was missed.
        url: new URL(translatePath(`/tools/${tool.data.slug}/`), getSiteUrl())
          .href,
        name: tool.data.title,
      }),
    ),
  },
};
---

<BaseLayout
  title={meta.name}
  description={meta.description}
  schema={schema}
>
  <div class="container">
    <nav
      class="breadcrumb"
      aria-label={t("aria.breadcrumb")}
    >
      <a href={translatePath("/tools/")}>{t("nav.tools")}</a>
      <span
        class="i-mdi:chevron-right"
        aria-hidden="true"
      ></span>
      <span aria-current="page">{meta.short}</span>
    </nav>

    <header class="cat-hero">
      <div
        class="lab-grid"
        aria-hidden="true"
      >
      </div>
      <p class="section-title">{meta.short}</p>
      <h1 class="cat-title">{meta.name}</h1>
      {
        /* Render the category description as body copy, not only in <head> and
          JSON-LD. Without it these pages were 46-222 words of heading and link
          grid, with no sentence saying what the category is. */
      }
      <p class="cat-lead">{meta.description}</p>
      {
        /* When to reach for this class of tool — 2-3 sentences of real context
           so the hub is a page, not just a list (GEO audit 2026-08-22, B10).
           Approved copy; see the MAINTENANCE note in the translation files
           before adding or removing tools in a category. */
        meta.context && <p class="cat-context">{meta.context}</p>
      }
      <p class="subtitle">
        {tools.length}
        {
          pluralize(
            tools.length,
            {
              one: t("pages.toolsCategory.toolSingular"),
              other: t("pages.toolsCategory.toolPlural"),
            },
            locale,
          )
        }
        {t("pages.toolsCategory.inCategory")}
      </p>
    </header>

    <nav
      class="filter-bar"
      aria-label={t("pages.tools.filterLabel")}
    >
      <a
        href={translatePath("/tools/")}
        class="chip"
      >
        {t("pages.tools.filterAll")} · {totalTools}
      </a>
      {
        chipCategories.map((c) => (
          <a
            href={translatePath(`/tools/categories/${c.id}/`)}
            class:list={["chip", { "chip--active": c.id === category }]}
            aria-current={c.id === category ? "page" : undefined}
          >
            {c.short}
          </a>
        ))
      }
    </nav>

    <div class="tools-grid">
      {
        tools.map(
          (tool: {
            data: {
              slug: string;
              title: string;
              description: string;
            };
          }) => (
            <a
              href={translatePath(`/tools/${tool.data.slug}/`)}
              class="tool-card"
            >
              <span class="tool-card__top">
                <span class="tool-badge">
                  <span class="sr-only">
                    {t("pages.tools.categoryLabel")}:{" "}
                  </span>
                  {meta.short}
                </span>
                <span
                  class="i-mdi:arrow-top-right tool-arrow"
                  aria-hidden="true"
                />
              </span>
              <h2 class="tool-name">{tool.data.title}</h2>
              <p class="tool-description">{tool.data.description}</p>
            </a>
          ),
        )
      }
    </div>

    <div class="back-link">
      <a href={translatePath("/tools/")}
        >{t("pages.toolsCategory.backToTools")}</a
      >
    </div>
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin-bottom: var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .breadcrumb span[class*="i-"] {
    width: 1rem;
    height: 1rem;
  }

  /* Hero */
  .cat-hero {
    position: relative;
    padding: var(--space-md) 0 var(--space-md-lg);
    overflow: hidden;
  }

  .cat-hero > :not(.lab-grid) {
    position: relative;
    z-index: 1;
  }

  .cat-title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: var(--fw-bold);
    line-height: 1.08;
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
  }

  .cat-lead {
    max-width: var(--max-width-prose);
    margin: 0 0 var(--space-sm);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text);
  }

  .cat-context {
    max-width: var(--max-width-prose);
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
  }

  .subtitle {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* Filter chips */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .chip {
    display: inline-flex;
    gap: 0.4em;
    align-items: center;
    padding: 0.375rem 0.875rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      background var(--dur-1) var(--ease-out);
  }

  .chip:hover {
    color: var(--color-text-heading);
    border-color: var(--color-primary);
  }

  .chip--active,
  .chip--active:hover {
    font-weight: var(--fw-medium);
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .chip:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Tool cards */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md-lg);
    text-decoration: none;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  .tool-card:hover {
    border-color: var(--color-border);
    box-shadow: var(--sh-card);
    transform: translateY(-2px);
  }

  .tool-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .tool-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .tool-badge {
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-heading);
    letter-spacing: 0.02em;
    background: var(--accent-dim);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-sm);
  }

  .tool-arrow {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-text-muted);
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .tool-card:hover .tool-arrow,
  .tool-card:focus-visible .tool-arrow {
    color: var(--color-primary);
    transform: translate(2px, -2px);
  }

  .tool-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--fw-medium);
    line-height: 1.2;
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .tool-description {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-line-clamp: 3;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
    -webkit-box-orient: vertical;
  }

  .back-link {
    margin-top: var(--space-lg);
  }

  .back-link a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .back-link a:hover {
    color: var(--color-primary);
  }

  @media (width <= 640px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip,
    .tool-card,
    .tool-arrow {
      transition: none;
    }

    .tool-card:hover {
      transform: none;
    }
  }
</style>
