---
/**
 * CV Page shared component.
 * Displays curriculum vitae data loaded from `src/content/cv/main.yaml`.
 * Renders sections dynamically using specific components or generic layouts.
 */
import "@styles/skills.css";

import CertificateGroup from "@components/cv/CertificateGroup.astro";
import CVMenu, { type MenuSection } from "@components/cv/CVMenu.astro";
import ProjectCard from "@components/cv/ProjectCard.astro";
import SkillGroup from "@components/cv/SkillGroup.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { SiteConfig } from "@src/types";
import { getCVData } from "@utils/cv";
import { sanitize, stripToText } from "@utils/html";
import { buildSameAs, getAbsoluteUrl, getSiteUrl } from "@utils/site";
import { getEntry } from "astro:content";
import type { ProfilePage } from "schema-dts";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const cvData = await getCVData(locale);

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

// Use cvData directly — YAML defines the section order
const sortedSections = cvData;

// Helper to generate slugs
const generateSlug = (text: string) =>
  text
    .toLowerCase()
    .replaceAll(/[^a-z0-9\s-]/g, "")
    .trim()
    .replaceAll(/\s+/g, "-");

// Prepare menu structure with subsections
const menuSections: MenuSection[] = sortedSections.map((section) => {
  const sectionSlug = generateSlug(section.title);
  let items: { title: string; slug: string }[] = [];

  switch (section.type) {
    case "time_table": {
      items = section.contents.map((item, index) => ({
        title: item.year ? `${item.title} (${item.year})` : item.title,
        slug: generateSlug(`${section.title}-${item.title}-${index}`),
      }));
      break;
    }
    case "list_groups":
    case "certificate_list": {
      items = section.contents.map((group, index) => ({
        title: group.category,
        slug: generateSlug(`${section.title}-${group.category}-${index}`),
      }));
      break;
    }
    case "projects": {
      items = section.contents.map((project, index) => ({
        title: project.name,
        slug: generateSlug(`${section.title}-${project.name}-${index}`),
      }));
      break;
    }
  }

  return {
    title: section.title,
    slug: sectionSlug,
    items,
  };
});

// Extract specific sections by type for schema generation.
// Only Experience and Formal Education use the `time_table` type (in that order),
// so this stays stable regardless of where other sections — e.g. `projects` or
// `list_groups` — are inserted in the YAML.
const timeTables = cvData.filter((s) => s.type === "time_table");
const experience = timeTables[0]; // First time_table = Experience
const formalEducation = timeTables[1]; // Second time_table = Formal Education
const technicalSkills = cvData.find((s) => s.type === "list_groups");
const certificates = cvData.find((s) => s.type === "certificate_list");

const personSchema = {
  "@type": "ProfilePage",
  "@id": new URL("#profile", new URL(Astro.url.pathname, getSiteUrl())).href,
  inLanguage: locale,
  mainEntity: {
    "@type": "Person",
    "@id": new URL("#person", getSiteUrl()).href,
    name: "José Manuel Requena Plens",
    jobTitle: t("seo.jobTitle"),
    description: t("pages.cv.schemaDescription"),
    // `url` and `image` are intentionally omitted: this node shares its @id
    // with the canonical #person (the WebSite publisher in BaseHead), which
    // defines them. Re-declaring them here with different values (no trailing
    // slash / a different image) would create a same-@id scalar conflict.
    sameAs: buildSameAs(siteData.social_links, siteData.person?.sameAs),
    knowsAbout:
      technicalSkills?.type === "list_groups"
        ? technicalSkills.contents.flatMap((g) => g.items.map((i) => i.name))
        : [],
    alumniOf:
      formalEducation?.type === "time_table"
        ? formalEducation.contents.map((edu) => ({
            "@type": "EducationalOrganization",
            name: edu.institution ? stripToText(edu.institution) : undefined,
            department: edu.department
              ? stripToText(edu.department)
              : undefined,
          }))
        : [],
    hasOccupation:
      experience?.type === "time_table"
        ? experience.contents.map((job) => ({
            "@type": "Occupation",
            name: job.title,
            description: job.summary ? stripToText(job.summary) : undefined,
          }))
        : [],
    hasCredential:
      certificates?.type === "certificate_list"
        ? certificates.contents.flatMap((group) =>
            group.items.map((cert) => ({
              "@type": "EducationalOccupationalCredential",
              name: cert.name,
              credentialCategory: group.category,
              recognizedBy: {
                "@type": "Organization",
                name: cert.school,
              },
              ...(cert.link && { url: getAbsoluteUrl(cert.link) }),
            })),
          )
        : [],
  },
} satisfies ProfilePage;
---

<BaseLayout
  title={t("pages.cv.title")}
  description={t("pages.cv.description")}
  type="profile"
  schema={personSchema}
>
  <div class="container">
    <h1 class="page-title cv-title">{t("pages.cv.heading")}</h1>

    {
      sortedSections.map((section) => (
        <section
          class="cv-section"
          id={generateSlug(section.title)}
          aria-label={section.title}
        >
          <div class="section-header">
            <h2>{section.title}</h2>
          </div>

          {section.type === "map" && (
            <div class="cv-map">
              {section.contents.map((item) =>
                item.dropdown && item.links ? (
                  <details class="cv-download">
                    <summary>
                      <span
                        class="i-fa-solid:download"
                        aria-hidden="true"
                      />
                      {item.name}
                    </summary>
                    <div class="cv-download-menu">
                      {item.links.map((link) => (
                        <a
                          href={link.link}
                          class="btn btn-sm btn-outline"
                          download={link.download || undefined}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.name}
                        </a>
                      ))}
                    </div>
                  </details>
                ) : (
                  <div class="map-item">
                    <span class="map-key">{item.name}:</span>
                    {item.value && <span class="map-value">{item.value}</span>}
                    {item.links && (
                      <div class="map-links">
                        {item.links.map((link) => (
                          <a
                            href={link.link}
                            class="btn btn-sm btn-outline"
                            download={link.download || undefined}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {link.name}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                ),
              )}
            </div>
          )}

          {section.type === "time_table" && (
            <div class="timeline">
              {section.contents.map((item, index) => (
                <article
                  class="timeline-item"
                  id={generateSlug(`${section.title}-${item.title}-${index}`)}
                >
                  <div
                    class="timeline-marker"
                    aria-hidden="true"
                  />
                  <div class="timeline-content">
                    <header class="timeline-header">
                      <h3 class="item-title">{item.title}</h3>
                      <span class="item-year">{item.year}</span>
                    </header>

                    {item.institution && (
                      <div
                        class="item-institution"
                        set:html={sanitize(item.institution)}
                      />
                    )}
                    {item.department && (
                      <div
                        class="item-department"
                        set:html={sanitize(item.department)}
                      />
                    )}
                    {item.location && (
                      <div class="item-location">
                        <span
                          class="i-fa-solid:map-marker-alt"
                          aria-hidden="true"
                        />{" "}
                        {item.location}
                      </div>
                    )}

                    {item.summary && (
                      <div
                        class="item-summary"
                        set:html={sanitize(item.summary)}
                      />
                    )}

                    {item.description && Array.isArray(item.description) && (
                      <ul class="item-description-list">
                        {item.description.map((desc) => {
                          if (typeof desc === "string")
                            return (
                              <li>
                                <div set:html={sanitize(desc)} />
                              </li>
                            );
                          if (
                            typeof desc === "object" &&
                            desc.title &&
                            Array.isArray(desc.contents)
                          ) {
                            return (
                              <li>
                                <strong>{desc.title}</strong>
                                <ul>
                                  {desc.contents.map((sub: string) => (
                                    <li>
                                      <div set:html={sanitize(sub)} />
                                    </li>
                                  ))}
                                </ul>
                              </li>
                            );
                          }
                          return null;
                        })}
                      </ul>
                    )}

                    {item.linkitems && (
                      <div class="item-links">
                        {item.linkitems.map((link) => (
                          <a
                            href={link.link}
                            class="btn btn-sm"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={link.ariaLabel}
                          >
                            <span
                              class="i-fa-solid:file-pdf"
                              aria-hidden="true"
                            />
                            {link.linkname}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
          )}

          {section.type === "list_groups" && (
            <div class="grid-layout">
              {section.contents.map((group, index) => (
                <div
                  class="skill-group-wrapper"
                  id={generateSlug(
                    `${section.title}-${group.category}-${index}`,
                  )}
                >
                  <SkillGroup group={group} />
                </div>
              ))}
            </div>
          )}

          {section.type === "certificate_list" && (
            <div class="grid-layout">
              {section.contents.map((group, index) => (
                <div
                  class="cert-group-wrapper"
                  id={generateSlug(
                    `${section.title}-${group.category}-${index}`,
                  )}
                >
                  <CertificateGroup group={group} />
                </div>
              ))}
            </div>
          )}

          {section.type === "projects" && (
            <div class="grid-layout">
              {section.contents.map((project, index) => (
                <div
                  class="project-card-wrapper"
                  id={generateSlug(`${section.title}-${project.name}-${index}`)}
                >
                  <ProjectCard project={project} />
                </div>
              ))}
            </div>
          )}
        </section>
      ))
    }
  </div>

  <CVMenu sections={menuSections} />

  {/* ICON_DETECTION_START */}
  <div
    class="hidden"
    aria-hidden="true"
  >
    <span class="i-fa-solid:microchip"></span>
    <span class="i-logos:c"></span>
    <span class="i-simple-icons:arm"></span>
    <span class="i-simple-icons:espressif"></span>
    <span class="i-mdi:chip"></span>
    <span class="i-mdi:clock-fast"></span>
    <span class="i-fa-solid:project-diagram"></span>
    <span class="i-fa-solid:bug"></span>
    <span class="i-fa-solid:wave-square"></span>
    <span class="i-fa-solid:code"></span>
    <span class="i-logos:python"></span>
    <span class="i-logos:c-plusplus"></span>
    <span class="i-vscode-icons:file-type-clangd"></span>
    <span class="i-logos:git-icon"></span>
    <span class="i-mdi:github"></span>
    <span class="i-mdi:gitlab"></span>
    <span class="i-simple-icons:githubactions"></span>
    <span class="i-logos:docker-icon"></span>
    <span class="i-vscode-icons:file-type-matlab"></span>
    <span class="i-vscode-icons:file-type-cmake"></span>
    <span class="i-logos:jetbrains"></span>
    <span class="i-mdi:robot-outline"></span>
    <span class="i-simple-icons:modelcontextprotocol"></span>
    <span class="i-simple-icons:claude"></span>
    <span class="i-mdi:brain"></span>
    <span class="i-simple-icons:comsol"></span>
    <span class="i-simple-icons:labview"></span>
    <span class="i-fa-solid:desktop"></span>
    <span class="i-fa-solid:network-wired"></span>
    <span class="i-logos:linux-tux"></span>
    <span class="i-simple-icons:apple"></span>
    <span class="i-logos:microsoft-windows-icon"></span>
    <span class="i-vscode-icons:file-type-tex"></span>
    <span class="i-vscode-icons:file-type-html"></span>
    <span class="i-fa-solid:medkit"></span>
    <span class="i-fa-solid:users"></span>
    <span class="i-fa-solid:industry"></span>
    <span class="i-fa-solid:laptop-code"></span>
    <span class="i-logos:go"></span>
    <span class="i-logos:typescript-icon"></span>
    <span class="i-logos:bash-icon"></span>
    <span class="i-simple-icons:platformio"></span>
    <span class="i-mdi:shield-key-outline"></span>
    <span class="i-simple-icons:doxygen"></span>
    <span class="i-fa-solid:shield-alt"></span>
    <span class="i-simple-icons:gitlab"></span>
    <span class="i-simple-icons:jenkins"></span>
    <span class="i-simple-icons:sonarqube"></span>
    <span class="i-mdi:package-variant-closed"></span>
    <span class="i-fa-solid:search-plus"></span>
    <span class="i-fa-solid:vials"></span>
    <span class="i-simple-icons:precommit"></span>
    <span class="i-mdi:lan"></span>
    <span class="i-simple-icons:mikrotik"></span>
    <span class="i-simple-icons:wireguard"></span>
    <span class="i-mdi:ip-network-outline"></span>
    <span class="i-mdi:lightning-bolt"></span>
    <span class="i-mdi:dns"></span>
    <span class="i-mdi:shield-lock-outline"></span>
    <span class="i-fa-solid:key"></span>
    <span class="i-fa-solid:certificate"></span>
    <span class="i-simple-icons:nginx"></span>
    <span class="i-fa-solid:user-shield"></span>
    <span class="i-fa-solid:download"></span>
  </div>
  {/* ICON_DETECTION_END */}
</BaseLayout>

<style>
  .cv-title {
    margin-bottom: var(--space-md);
  }

  /* Section Styling */
  .cv-section {
    margin-bottom: var(--space-lg-xl);
    scroll-margin-top: var(--header-height);
  }

  .section-header {
    margin-bottom: var(--space-lg);
    border-bottom: 2px solid var(--color-border);
  }

  .cv-section h2 {
    display: inline-block;
    padding-bottom: var(--space-sm);
    margin-bottom: -2px;
    border-bottom: 2px solid var(--color-primary);
  }

  .timeline-item,
  .skill-group-wrapper,
  .cert-group-wrapper,
  .project-card-wrapper {
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }

  /* Map Type */
  .cv-map {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .map-item {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    align-items: baseline;
    font-size: 1.05rem;
  }

  .map-key {
    font-weight: var(--fw-bold);
    color: var(--color-text);
  }

  .map-value {
    color: var(--color-text-offset);
  }

  .map-links {
    display: inline-flex;
    gap: var(--space-sm);
  }

  /* Download dropdowns (accessible <details>, zero-JS) */
  .cv-download {
    margin-top: var(--space-xs);
  }

  .cv-download > summary {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    padding: var(--space-xs) var(--space-md);
    font-weight: var(--fw-medium);
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    background-color: var(--color-bg-subtle);
    border: var(--border-1);
    border-radius: var(--radius-md);
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .cv-download > summary::-webkit-details-marker {
    display: none;
  }

  .cv-download > summary::after {
    width: 0;
    height: 0;
    content: "";
    border-right: 0.3em solid transparent;
    border-left: 0.3em solid transparent;
    border-top: 0.35em solid currentcolor;
    transition: transform 0.2s;
  }

  .cv-download[open] > summary::after {
    transform: rotate(180deg);
  }

  .cv-download > summary:hover,
  .cv-download[open] > summary {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .cv-download > summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .cv-download-menu {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    margin-left: var(--space-sm);
  }

  /* Time Table (Timeline) */
  .timeline {
    position: relative;
    padding-left: var(--space-lg);
    border-left: 2px solid var(--color-border);
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-xl);
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    top: 24px;
    left: calc(-1 * var(--space-lg) - 7px);
    z-index: 10;
    width: 12px;
    height: 12px;
    background-color: var(--color-bg);
    border: 2px solid var(--color-primary);
    border-radius: 50%;
  }

  .timeline-content {
    position: relative;
    padding: var(--space-lg);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      transform 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .timeline-content:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  /* Decorative notch linking the card to the timeline rail. Kept as a ::before
     on .timeline-content (flush with the card edge). This makes axe report the
     card's links as `color-contrast` "incomplete" (it can't resolve a pseudo
     ancestor's background), but that is benign — the unmasked audit confirmed
     no hidden contrast failure here. */
  .timeline-content::before {
    position: absolute;
    top: 22px;
    left: -6px;
    width: 12px;
    height: 12px;
    content: "";
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    transform: rotate(45deg);
    transition: border-color 0.2s;
  }

  .timeline-content:hover::before {
    border-bottom-color: var(--color-primary);
    border-left-color: var(--color-primary);
  }

  .timeline-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .item-title {
    margin: 0;
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .item-year {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: var(--fw-medium);
    color: var(--color-primary);
  }

  .item-institution,
  .item-department {
    font-size: 1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
  }

  .item-location {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin-top: var(--space-xs);
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .item-summary {
    margin-top: var(--space-md);
    line-height: 1.6;
    color: var(--color-text-offset);
  }

  .item-description-list {
    padding-left: var(--space-lg);
    margin-top: var(--space-sm);
    color: var(--color-text-offset);
  }

  .item-description-list li {
    margin-bottom: var(--space-xs);
  }

  .item-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  /* Grid Layouts for Skills/Certs */
  .grid-layout {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .grid-layout :global(h3) {
    box-sizing: border-box;
    min-height: var(--grid-header-min-h, auto);
  }

  /* Responsive */
  @media (width <= 768px) {
    .timeline-header {
      flex-direction: column;
      gap: 0;
    }

    .grid-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  /** Equalizes h3 header heights within each .grid-layout container via CSS custom property. */
  function equalizeGridHeaders() {
    document.querySelectorAll<HTMLElement>(".grid-layout").forEach((grid) => {
      const headings = grid.querySelectorAll<HTMLElement>("h3");
      if (headings.length < 2) return;

      grid.style.removeProperty("--grid-header-min-h");

      let maxHeight = 0;
      headings.forEach((h) => {
        if (h.offsetHeight > maxHeight) maxHeight = h.offsetHeight;
      });

      grid.style.setProperty("--grid-header-min-h", `${maxHeight}px`);
    });
  }

  equalizeGridHeaders();
  document.addEventListener("astro:after-swap", equalizeGridHeaders);

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(equalizeGridHeaders, 150);
  });
</script>
