---
/**
 * CV Page shared component.
 * Renders the curriculum vitae from `src/content/cv/{locale}.yaml`
 * (`{ basics, downloads, sections }`). Section bodies are rendered by `kind`.
 */
import "@styles/skills.css";

import CertificateGroup from "@components/cv/CertificateGroup.astro";
import CVMenu, { type MenuSection } from "@components/cv/CVMenu.astro";
import ProjectCard from "@components/cv/ProjectCard.astro";
import SkillGroup from "@components/cv/SkillGroup.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { SiteConfig } from "@src/types";
import { getCVData } from "@utils/cv";
import { fetchRepoStats, formatStats, githubSlug } from "@utils/cv-github";
import { markdownToHtml } from "@utils/cv-markdown";
import { stripToText } from "@utils/html";
import { buildSameAs, getAbsoluteUrl, getSiteUrl } from "@utils/site";
import { getEntry } from "astro:content";
import type { ProfilePage } from "schema-dts";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const { basics, downloads, sections } = await getCVData(locale);

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;

/** Generates a URL slug from arbitrary text. */
const generateSlug = (text: string) =>
  text
    .toLowerCase()
    .replaceAll(/[^a-z0-9\s-]/g, "")
    .trim()
    .replaceAll(/\s+/g, "-");

type OrgEntity = { name: string; short?: string; url?: string };

/** Inline-markdown label for an organization entity. */
const orgMd = (o: OrgEntity) => {
  if (o.short) {
    return o.url
      ? `${o.name} ([${o.short}](${o.url}))`
      : `${o.name} (${o.short})`;
  }
  return o.url ? `[${o.name}](${o.url})` : o.name;
};

/** Rendered HTML for an organization list (joined by ·). */
const orgsHtml = (orgs: OrgEntity[]) =>
  markdownToHtml(orgs.map((o) => orgMd(o)).join(" · "));

// Build the navigation menu structure from the body sections.
const menuSections: MenuSection[] = sections.map((section) => {
  const sectionSlug = generateSlug(section.title);
  let items: { title: string; slug: string }[] = [];

  switch (section.kind) {
    case "experience": {
      items = section.items.map((item, index) => ({
        title: item.period ? `${item.role} (${item.period})` : item.role,
        slug: generateSlug(`${section.title}-${item.role}-${index}`),
      }));
      break;
    }
    case "education": {
      items = section.items.map((item, index) => ({
        title: item.period ? `${item.degree} (${item.period})` : item.degree,
        slug: generateSlug(`${section.title}-${item.degree}-${index}`),
      }));
      break;
    }
    case "skills":
    case "certificates": {
      items = section.groups.map((group, index) => ({
        title: group.category,
        slug: generateSlug(`${section.title}-${group.category}-${index}`),
      }));
      break;
    }
    case "projects": {
      items = section.items.map((project, index) => ({
        title: project.name,
        slug: generateSlug(`${section.title}-${project.name}-${index}`),
      }));
      break;
    }
  }

  return { title: section.title, slug: sectionSlug, items };
});

// Live GitHub stats for the project cards, fetched at build time so star /
// release / download counts never need manual maintenance.
const projectsSection = sections.find((s) => s.kind === "projects");
const projectStats = new Map<string, string[]>();
if (projectsSection?.kind === "projects") {
  for (const project of projectsSection.items) {
    const slug = githubSlug(project.links);
    if (!slug || projectStats.has(project.name)) continue;
    try {
      projectStats.set(
        project.name,
        formatStats(await fetchRepoStats(slug), locale),
      );
    } catch {
      projectStats.set(project.name, []);
    }
  }
}

// Sections used to build the ProfilePage JSON-LD.
const experience = sections.find((s) => s.kind === "experience");
const education = sections.find((s) => s.kind === "education");
const skills = sections.find((s) => s.kind === "skills");
const certificates = sections.find((s) => s.kind === "certificates");

const personSchema = {
  "@type": "ProfilePage",
  "@id": new URL("#profile", new URL(Astro.url.pathname, getSiteUrl())).href,
  inLanguage: locale,
  mainEntity: {
    "@type": "Person",
    "@id": new URL("#person", getSiteUrl()).href,
    name: basics.name,
    jobTitle: t("seo.jobTitle"),
    description: t("pages.cv.schemaDescription"),
    sameAs: buildSameAs(siteData.social_links, siteData.person?.sameAs),
    knowsAbout:
      skills?.kind === "skills"
        ? skills.groups.flatMap((g) => g.items.map((i) => i.name))
        : [],
    alumniOf:
      education?.kind === "education"
        ? education.items.map((edu) => ({
            "@type": "EducationalOrganization",
            name: edu.org[0]?.name,
            department: edu.department?.name,
          }))
        : [],
    hasOccupation:
      experience?.kind === "experience"
        ? experience.items.map((job) => ({
            "@type": "Occupation",
            name: job.role,
            description: job.summary
              ? stripToText(markdownToHtml(job.summary))
              : undefined,
          }))
        : [],
    hasCredential:
      certificates?.kind === "certificates"
        ? certificates.groups.flatMap((group) =>
            group.items.map((cert) => ({
              "@type": "EducationalOccupationalCredential",
              name: cert.name,
              credentialCategory: group.category,
              recognizedBy: {
                "@type": "Organization",
                name: cert.school,
              },
              ...(cert.url && { url: getAbsoluteUrl(cert.url) }),
            })),
          )
        : [],
  },
} satisfies ProfilePage;
---

<BaseLayout
  title={t("pages.cv.title")}
  description={t("pages.cv.description")}
  type="profile"
  schema={personSchema}
>
  <div class="container">
    <h1 class="page-title cv-title">{t("pages.cv.heading")}</h1>

    <header class="cv-basics">
      <h2 class="cv-name">{basics.name}</h2>
      <p class="cv-headline">{basics.headline}</p>

      <ul class="cv-contact">
        <li>
          <span
            class="i-fa-solid:map-marker-alt"
            aria-hidden="true"
          ></span>{" "}
          {basics.location}
        </li>
      </ul>

      {
        basics.availability && (
          <p class="cv-availability">
            <strong>{t("pages.cv.availability")}:</strong> {basics.availability}
          </p>
        )
      }

      <div
        class="cv-profile"
        set:html={markdownToHtml(basics.profile)}
      />

      <div
        class="cv-downloads"
        role="group"
        aria-labelledby="cv-downloads-title"
      >
        <span
          class="cv-downloads-title"
          id="cv-downloads-title"
        >
          {t("pages.cv.downloadsTitle")}
        </span>
        {
          downloads.map((fmt) => (
            <div class:list={["dl-format", { recommended: fmt.recommended }]}>
              <div class="dl-format-head">
                <span
                  class="dl-dot"
                  aria-hidden="true"
                />
                <span class="dl-format-name">{fmt.format}</span>
                {fmt.recommended && (
                  <span class="dl-badge">
                    {t("pages.cv.downloadRecommended")}
                  </span>
                )}
                {fmt.note && <span class="dl-format-note">{fmt.note}</span>}
              </div>
              <div class="dl-format-links">
                {fmt.files.map((file) => (
                  <a
                    class="dl-btn"
                    href={file.url}
                    download={file.download}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${fmt.format} · ${file.label} (PDF)`}
                  >
                    <span
                      class="i-fa-solid:download"
                      aria-hidden="true"
                    />
                    {file.label}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </header>

    {
      sections.map((section) => (
        <section
          class="cv-section"
          id={generateSlug(section.title)}
          aria-label={section.title}
        >
          <div class="section-header">
            <h2>{section.title}</h2>
          </div>

          {(section.kind === "experience" || section.kind === "education") && (
            <div class="timeline">
              {section.items.map((item, index) => {
                const title = "role" in item ? item.role : item.degree;
                return (
                  <article
                    class="timeline-item"
                    id={generateSlug(`${section.title}-${title}-${index}`)}
                  >
                    <div
                      class="timeline-marker"
                      aria-hidden="true"
                    />
                    <div class="timeline-content">
                      <header class="timeline-header">
                        <h3 class="item-title">{title}</h3>
                        <span class="item-year">{item.period}</span>
                      </header>

                      <div
                        class="item-institution"
                        set:html={orgsHtml(item.org)}
                      />
                      {item.department && (
                        <div
                          class="item-department"
                          set:html={markdownToHtml(orgMd(item.department))}
                        />
                      )}
                      {item.location && (
                        <div class="item-location">
                          <span
                            class="i-fa-solid:map-marker-alt"
                            aria-hidden="true"
                          />{" "}
                          {item.location}
                        </div>
                      )}

                      {item.summary && (
                        <div
                          class="item-summary"
                          set:html={markdownToHtml(item.summary)}
                        />
                      )}
                      {item.notes?.map((note) => (
                        <div
                          class="item-summary"
                          set:html={markdownToHtml(note)}
                        />
                      ))}

                      {item.bullets && item.bullets.length > 0 && (
                        <ul class="item-description-list">
                          {item.bullets.map((bullet) => (
                            <li set:html={markdownToHtml(bullet)} />
                          ))}
                        </ul>
                      )}

                      {item.pubGroups?.map((pg) => (
                        <div class="item-pubgroup">
                          <strong>{pg.heading}</strong>
                          <ul>
                            {pg.items.map((pub) => (
                              <li set:html={markdownToHtml(pub)} />
                            ))}
                          </ul>
                        </div>
                      ))}

                      {"documents" in item && item.documents && (
                        <div class="item-links">
                          {item.documents.map((doc) => (
                            <a
                              href={doc.url}
                              class="btn btn-sm"
                              target="_blank"
                              rel="external noopener noreferrer"
                              aria-label={doc.ariaLabel}
                            >
                              <span
                                class="i-fa-solid:file-pdf"
                                aria-hidden="true"
                              />
                              {doc.label}
                            </a>
                          ))}
                        </div>
                      )}

                      {item.links && item.links.length > 0 && (
                        <div class="item-links">
                          {item.links.map((link) => (
                            <a
                              href={link.url}
                              class="btn btn-sm"
                              target="_blank"
                              rel="external noopener noreferrer"
                              aria-label={link.ariaLabel}
                            >
                              {link.label}
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          )}

          {section.kind === "skills" && (
            <div class="grid-layout">
              {section.groups.map((group, index) => (
                <div
                  class="skill-group-wrapper"
                  id={generateSlug(
                    `${section.title}-${group.category}-${index}`,
                  )}
                >
                  <SkillGroup group={group} />
                </div>
              ))}
            </div>
          )}

          {section.kind === "certificates" && (
            <div class="grid-layout">
              {section.groups.map((group, index) => (
                <div
                  class="cert-group-wrapper"
                  id={generateSlug(
                    `${section.title}-${group.category}-${index}`,
                  )}
                >
                  <CertificateGroup group={group} />
                </div>
              ))}
            </div>
          )}

          {section.kind === "projects" && (
            <div class="grid-layout">
              {section.items.map((project, index) => (
                <div
                  class="project-card-wrapper"
                  id={generateSlug(`${section.title}-${project.name}-${index}`)}
                >
                  <ProjectCard
                    project={{
                      ...project,
                      metrics: [
                        ...(projectStats.get(project.name) ?? []),
                        ...(project.metrics ?? []),
                      ],
                    }}
                  />
                </div>
              ))}
            </div>
          )}
        </section>
      ))
    }
  </div>

  <CVMenu sections={menuSections} />

  {/* ICON_DETECTION_START */}
  <div
    class="hidden"
    aria-hidden="true"
  >
    <span class="i-fa-solid:microchip"></span>
    <span class="i-logos:c"></span>
    <span class="i-simple-icons:arm"></span>
    <span class="i-simple-icons:espressif"></span>
    <span class="i-mdi:chip"></span>
    <span class="i-mdi:clock-fast"></span>
    <span class="i-fa-solid:project-diagram"></span>
    <span class="i-fa-solid:bug"></span>
    <span class="i-fa-solid:wave-square"></span>
    <span class="i-fa-solid:code"></span>
    <span class="i-logos:python"></span>
    <span class="i-logos:c-plusplus"></span>
    <span class="i-vscode-icons:file-type-clangd"></span>
    <span class="i-logos:git-icon"></span>
    <span class="i-mdi:github"></span>
    <span class="i-mdi:gitlab"></span>
    <span class="i-simple-icons:githubactions"></span>
    <span class="i-logos:docker-icon"></span>
    <span class="i-vscode-icons:file-type-matlab"></span>
    <span class="i-vscode-icons:file-type-cmake"></span>
    <span class="i-logos:jetbrains"></span>
    <span class="i-mdi:robot-outline"></span>
    <span class="i-simple-icons:modelcontextprotocol"></span>
    <span class="i-simple-icons:claude"></span>
    <span class="i-mdi:brain"></span>
    <span class="i-simple-icons:comsol"></span>
    <span class="i-simple-icons:labview"></span>
    <span class="i-fa-solid:desktop"></span>
    <span class="i-fa-solid:network-wired"></span>
    <span class="i-logos:linux-tux"></span>
    <span class="i-simple-icons:apple"></span>
    <span class="i-logos:microsoft-windows-icon"></span>
    <span class="i-vscode-icons:file-type-tex"></span>
    <span class="i-vscode-icons:file-type-html"></span>
    <span class="i-fa-solid:medkit"></span>
    <span class="i-fa-solid:users"></span>
    <span class="i-fa-solid:industry"></span>
    <span class="i-fa-solid:laptop-code"></span>
    <span class="i-logos:go"></span>
    <span class="i-logos:typescript-icon"></span>
    <span class="i-logos:bash-icon"></span>
    <span class="i-simple-icons:platformio"></span>
    <span class="i-mdi:shield-key-outline"></span>
    <span class="i-simple-icons:doxygen"></span>
    <span class="i-fa-solid:shield-alt"></span>
    <span class="i-simple-icons:gitlab"></span>
    <span class="i-simple-icons:jenkins"></span>
    <span class="i-simple-icons:sonarqube"></span>
    <span class="i-mdi:package-variant-closed"></span>
    <span class="i-fa-solid:search-plus"></span>
    <span class="i-fa-solid:vials"></span>
    <span class="i-simple-icons:precommit"></span>
    <span class="i-mdi:lan"></span>
    <span class="i-simple-icons:mikrotik"></span>
    <span class="i-simple-icons:wireguard"></span>
    <span class="i-mdi:ip-network-outline"></span>
    <span class="i-mdi:lightning-bolt"></span>
    <span class="i-mdi:dns"></span>
    <span class="i-mdi:shield-lock-outline"></span>
    <span class="i-fa-solid:key"></span>
    <span class="i-fa-solid:certificate"></span>
    <span class="i-simple-icons:nginx"></span>
    <span class="i-fa-solid:user-shield"></span>
    <span class="i-fa-solid:download"></span>
    <span class="i-fa-solid:map-marker-alt"></span>
    <span class="i-fa-solid:file-pdf"></span>
  </div>
  {/* ICON_DETECTION_END */}
</BaseLayout>

<style>
  .cv-title {
    margin-bottom: var(--space-md);
  }

  /* Basics / header block */
  .cv-basics {
    margin-bottom: var(--space-lg-xl);
  }

  .cv-name {
    margin: 0;
    font-size: 1.6rem;
    color: var(--color-text-heading);
  }

  .cv-headline {
    margin: var(--space-xs) 0 0;
    font-size: 1.1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
  }

  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    padding: 0;
    margin: var(--space-sm) 0 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    list-style: none;
  }

  .cv-contact li {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
  }

  .cv-availability {
    margin: var(--space-sm) 0 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .cv-profile {
    margin-top: var(--space-md);
    line-height: 1.6;
    color: var(--color-text-offset);
  }

  /* Section Styling */
  .cv-section {
    margin-bottom: var(--space-lg-xl);
    scroll-margin-top: var(--header-height);
  }

  .section-header {
    margin-bottom: var(--space-lg);
    border-bottom: 2px solid var(--color-border);
  }

  .cv-section h2 {
    display: inline-block;
    padding-bottom: var(--space-sm);
    margin-bottom: -2px;
    border-bottom: 2px solid var(--color-primary);
  }

  .timeline-item,
  .skill-group-wrapper,
  .cert-group-wrapper,
  .project-card-wrapper {
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }

  /* Downloads — grouped by format, zero-JS */
  .cv-downloads {
    margin-top: var(--space-lg);
  }

  .cv-downloads-title {
    display: block;
    margin-bottom: var(--space-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  .dl-format + .dl-format {
    margin-top: var(--space-md);
  }

  .dl-format-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    align-items: baseline;
  }

  .dl-dot {
    display: inline-block;
    align-self: center;
    width: 0.55em;
    height: 0.55em;
    border: 1.5px solid var(--color-text-muted);
    border-radius: 50%;
  }

  .dl-format.recommended .dl-dot {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .dl-format-name {
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  .dl-badge {
    padding: 0.05rem 0.45rem;
    font-size: 0.68rem;
    font-weight: var(--fw-medium);
    color: var(--color-on-primary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background-color: var(--color-primary);
    border-radius: var(--radius-sm);
  }

  .dl-format-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .dl-format-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .dl-btn {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    padding: var(--space-xs) var(--space-md);
    font-size: 0.9rem;
    color: var(--color-text);
    text-decoration: none;
    background-color: var(--color-bg-subtle);
    border: var(--border-1);
    border-radius: var(--radius-md);
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s;
  }

  .dl-btn:hover {
    color: var(--color-on-primary);
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .dl-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Time Table (Timeline) */
  .timeline {
    position: relative;
    padding-left: var(--space-lg);
    border-left: 2px solid var(--color-border);
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-xl);
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    top: 24px;
    left: calc(-1 * var(--space-lg) - 7px);
    z-index: 10;
    width: 12px;
    height: 12px;
    background-color: var(--color-bg);
    border: 2px solid var(--color-primary);
    border-radius: 50%;
  }

  .timeline-content {
    position: relative;
    padding: var(--space-lg);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      transform 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .timeline-content:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  /* Decorative notch linking the card to the timeline rail. */
  .timeline-content::before {
    position: absolute;
    top: 22px;
    left: -6px;
    width: 12px;
    height: 12px;
    content: "";
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    transform: rotate(45deg);
    transition: border-color 0.2s;
  }

  .timeline-content:hover::before {
    border-bottom-color: var(--color-primary);
    border-left-color: var(--color-primary);
  }

  .timeline-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .item-title {
    margin: 0;
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .item-year {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: var(--fw-medium);
    color: var(--color-primary);
  }

  .item-institution,
  .item-department {
    font-size: 1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
  }

  .item-location {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin-top: var(--space-xs);
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .item-summary {
    margin-top: var(--space-md);
    line-height: 1.6;
    color: var(--color-text-offset);
  }

  .item-description-list {
    padding-left: var(--space-lg);
    margin-top: var(--space-sm);
    color: var(--color-text-offset);
  }

  .item-description-list li {
    margin-bottom: var(--space-xs);
  }

  .item-pubgroup {
    margin-top: var(--space-sm);
    color: var(--color-text-offset);
  }

  .item-pubgroup ul {
    padding-left: var(--space-lg);
    margin-top: var(--space-xs);
  }

  .item-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  /* Grid Layouts for Skills/Certs */
  .grid-layout {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .grid-layout :global(h3) {
    box-sizing: border-box;
    min-height: var(--grid-header-min-h, auto);
  }

  /* Responsive */
  @media (width <= 768px) {
    .timeline-header {
      flex-direction: column;
      gap: 0;
    }

    .grid-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  /** Equalizes h3 header heights within each .grid-layout container via CSS custom property. */
  function equalizeGridHeaders() {
    document.querySelectorAll<HTMLElement>(".grid-layout").forEach((grid) => {
      const headings = grid.querySelectorAll<HTMLElement>("h3");
      if (headings.length < 2) return;

      grid.style.removeProperty("--grid-header-min-h");

      let maxHeight = 0;
      headings.forEach((h) => {
        if (h.offsetHeight > maxHeight) maxHeight = h.offsetHeight;
      });

      grid.style.setProperty("--grid-header-min-h", `${maxHeight}px`);
    });
  }

  equalizeGridHeaders();
  document.addEventListener("astro:after-swap", equalizeGridHeaders);

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(equalizeGridHeaders, 150);
  });
</script>
