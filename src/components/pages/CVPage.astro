---
/**
 * CV Page shared component.
 * Renders the curriculum vitae from `src/content/cv/{locale}.yaml`
 * (`{ basics, downloads, sections }`). Section bodies are rendered by `kind`.
 *
 * Desktop: 2-column grid — 300 px sticky sidebar + 1 fr main.
 * Mobile (< 1024 px): single column; sidebar flows above main content.
 * The CVMenu FAB drawer handles section navigation on all viewports.
 */
import CertificateGroup from "@components/cv/CertificateGroup.astro";
import CVMenu, { type MenuSection } from "@components/cv/CVMenu.astro";
import ProjectCard from "@components/cv/ProjectCard.astro";
import SkillGroup from "@components/cv/SkillGroup.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCVData } from "@utils/cv";
import { fetchRepoStats, formatStats, githubSlug } from "@utils/cv-github";
import { markdownToHtml } from "@utils/cv-markdown";
import { stripToText } from "@utils/html";
import { CANONICAL_ALUMNI_OF } from "@utils/person";
import { getAbsoluteUrl, getSiteUrl } from "@utils/site";
import type { Person, WebPage } from "schema-dts";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const { basics, downloads, sections } = await getCVData(locale);

/** Generates a URL slug from arbitrary text. */
const generateSlug = (text: string) =>
  text
    .toLowerCase()
    .replaceAll(/[^a-z0-9\s-]/g, "")
    .trim()
    .replaceAll(/\s+/g, "-");

type OrgEntity = { name: string; short?: string; url?: string };

/** Inline-markdown label for an organization entity. */
const orgMd = (o: OrgEntity) => {
  if (o.short) {
    return o.url
      ? `${o.name} ([${o.short}](${o.url}))`
      : `${o.name} (${o.short})`;
  }
  return o.url ? `[${o.name}](${o.url})` : o.name;
};

/** Rendered HTML for an organization list (joined by ·). */
const orgsHtml = (orgs: OrgEntity[]) =>
  markdownToHtml(orgs.map((o) => orgMd(o)).join(" · "));

// Build the navigation menu structure from the body sections.
const menuSections: MenuSection[] = sections.map((section) => {
  const sectionSlug = generateSlug(section.title);
  let items: { title: string; slug: string }[] = [];

  switch (section.kind) {
    case "experience": {
      items = section.items.map((item, index) => ({
        title: item.period ? `${item.role} (${item.period})` : item.role,
        slug: generateSlug(`${section.title}-${item.role}-${index}`),
      }));
      break;
    }
    case "education": {
      items = section.items.map((item, index) => ({
        title: item.period ? `${item.degree} (${item.period})` : item.degree,
        slug: generateSlug(`${section.title}-${item.degree}-${index}`),
      }));
      break;
    }
    case "skills":
    case "certificates": {
      items = section.groups.map((group, index) => ({
        title: group.category,
        slug: generateSlug(`${section.title}-${group.category}-${index}`),
      }));
      break;
    }
    case "projects": {
      items = section.items.map((project, index) => ({
        title: project.name,
        slug: generateSlug(`${section.title}-${project.name}-${index}`),
      }));
      break;
    }
  }

  return { title: section.title, slug: sectionSlug, items };
});

// Live GitHub stats for the project cards, fetched at build time so star /
// release / download counts never need manual maintenance.
const projectsSection = sections.find((s) => s.kind === "projects");
const projectStats = new Map<string, string[]>();
if (projectsSection?.kind === "projects") {
  await Promise.all(
    projectsSection.items.map(async (project) => {
      const slug = githubSlug(project.links);
      if (!slug) return;
      try {
        projectStats.set(
          project.name,
          formatStats(await fetchRepoStats(slug), locale),
        );
      } catch {
        projectStats.set(project.name, []);
      }
    }),
  );
}

// Sections used to build the CV JSON-LD (WebPage + additive Person facts).
const experience = sections.find((s) => s.kind === "experience");
const certificates = sections.find((s) => s.kind === "certificates");

// /cv/ is not the canonical ProfilePage (that's /about/ — see AboutPage.astro)
// so it emits a plain WebPage referencing the canonical #person node, plus a
// SEPARATE Person node that only ADDS occupation/education/credential facts —
// it must never redefine name/jobTitle/description/image/sameAs/knowsAbout,
// which are now defined once in BaseHead.astro.
const cvWebPage = {
  "@type": "WebPage",
  "@id": new URL("#webpage", new URL(Astro.url.pathname, getSiteUrl())).href,
  name: t("pages.cv.title"),
  description: t("pages.cv.description"),
  url: new URL(Astro.url.pathname, getSiteUrl()).href,
  inLanguage: locale,
  isPartOf: { "@id": new URL("#website", getSiteUrl()).href },
  mainEntity: { "@id": new URL("#person", getSiteUrl()).href },
  // Every blog post declares a speakable region; the CV — the page an
  // assistant is most likely to be asked to read out about this person — had
  // none. Points at the identity line only: the section grids below are
  // tabular and read badly aloud.
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".cv-title", ".cv-name", ".cv-headline"],
  },
} satisfies WebPage;

const cvPersonFacts = {
  "@type": "Person",
  "@id": new URL("#person", getSiteUrl()).href,
  alumniOf: CANONICAL_ALUMNI_OF,
  hasOccupation:
    experience?.kind === "experience"
      ? experience.items.map((job) => ({
          "@type": "Occupation",
          name: job.role,
          description: job.summary
            ? stripToText(markdownToHtml(job.summary))
            : undefined,
        }))
      : [],
  hasCredential:
    certificates?.kind === "certificates"
      ? certificates.groups.flatMap((group) =>
          group.items.map((cert) => ({
            "@type": "EducationalOccupationalCredential",
            name: cert.name,
            credentialCategory: group.category,
            recognizedBy: {
              "@type": "Organization",
              name: cert.school,
            },
            ...(cert.url && { url: getAbsoluteUrl(cert.url) }),
          })),
        )
      : [],
} satisfies Person;

const cvSchema = [cvWebPage, cvPersonFacts];

/**
 * Link kinds displayed in the sidebar contact block.
 * "orcid" and other academic IDs are intentionally omitted — they belong
 * in the full profile / publications page, not the sidebar snapshot.
 */
const SIDEBAR_LINK_KINDS = new Set([
  "website",
  "github",
  "linkedin",
  "scholar",
]);
---

<BaseLayout
  title={t("pages.cv.title")}
  description={t("pages.cv.description")}
  type="profile"
  schema={cvSchema}
>
  <div class="container">
    <h1 class="page-title cv-title">{t("pages.cv.heading")}</h1>

    <!-- Full-width hero: name + headline + location/availability -->
    <header class="cv-hero">
      <h2 class="cv-name">{basics.name}</h2>
      <p class="cv-headline">{basics.headline}</p>
      <p class="cv-hero-meta">
        <span
          class="i-fa-solid:map-marker-alt"
          aria-hidden="true"
        ></span>
        {basics.location}
        {basics.availability && <> · {basics.availability}</>}
      </p>
    </header>

    <!-- 2-column layout: 300px sticky sidebar + 1fr main -->
    <div class="cv-layout">
      <!-- Left column: sticky sidebar (stacks above main on mobile) -->
      <aside
        class="cv-sidebar"
        aria-label={t("pages.cv.sidebarAriaLabel")}
      >
        <!-- Block: Downloads -->
        <div class="cv-sb-block">
          <p
            class="cv-sb-eyebrow"
            id="cv-sb-dl-label"
          >
            {t("pages.cv.downloadsTitle")}
          </p>
          <div
            class="cv-sb-downloads"
            role="group"
            aria-labelledby="cv-sb-dl-label"
          >
            {
              downloads.map((fmt) => (
                <div
                  class:list={["dl-format", { recommended: fmt.recommended }]}
                >
                  <div class="dl-format-head">
                    <span
                      class="dl-dot"
                      aria-hidden="true"
                    />
                    <span class="dl-format-name">{fmt.format}</span>
                    {fmt.recommended && (
                      <span class="dl-badge">
                        {t("pages.cv.downloadRecommended")}
                      </span>
                    )}
                    {fmt.note && <span class="dl-format-note">{fmt.note}</span>}
                  </div>
                  <div class="dl-format-links">
                    {fmt.files.map((file) => (
                      <a
                        class="dl-btn"
                        href={file.url}
                        download={file.download}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${fmt.format} · ${file.label} (PDF)`}
                      >
                        <span
                          class="i-fa-solid:download"
                          aria-hidden="true"
                        />
                        {file.label}
                      </a>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="cv-sb-divider"
          aria-hidden="true"
        >
        </div>

        <!-- Block: Contact links + location -->
        <div class="cv-sb-block">
          <p
            class="cv-sb-eyebrow"
            id="cv-sb-contact-label"
          >
            {t("pages.cv.sidebarContact")}
          </p>
          <ul class="cv-sb-contact">
            {
              basics.links
                .filter((l) => SIDEBAR_LINK_KINDS.has(l.kind ?? ""))
                .map((link) => (
                  <li>
                    <a
                      href={link.url}
                      class="cv-sb-link"
                      target="_blank"
                      rel="external noopener noreferrer"
                      aria-label={link.ariaLabel || undefined}
                    >
                      <span
                        class="cv-sb-link-arrow"
                        aria-hidden="true"
                      >
                        ↳
                      </span>
                      {link.label}
                    </a>
                  </li>
                ))
            }
            <li>
              <span class="cv-sb-link cv-sb-location">
                <span
                  class="cv-sb-link-arrow"
                  aria-hidden="true"
                  >↳</span
                >
                {basics.location}
              </span>
            </li>
          </ul>
        </div>

        {
          basics.objetivo && basics.objetivo.length > 0 && (
            <div class="cv-sb-group">
              <div
                class="cv-sb-divider"
                aria-hidden="true"
              />
              <div class="cv-sb-block">
                <p
                  class="cv-sb-eyebrow"
                  id="cv-sb-objetivo-label"
                >
                  {t("pages.cv.sidebarObjective")}
                </p>
                <ul class="cv-sb-chips">
                  {basics.objetivo.map((role) => (
                    <li>
                      <span class="cv-chip">{role}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )
        }

        {
          basics.idiomas && basics.idiomas.length > 0 && (
            <div class="cv-sb-group">
              <div
                class="cv-sb-divider"
                aria-hidden="true"
              />
              <div class="cv-sb-block">
                <p
                  class="cv-sb-eyebrow"
                  id="cv-sb-idiomas-label"
                >
                  {t("pages.cv.sidebarLanguages")}
                </p>
                <dl class="cv-sb-idiomas">
                  {basics.idiomas.map((lang) => (
                    <div class="cv-sb-idioma-row">
                      <dt>{lang.name}</dt>
                      <dd>{lang.level}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          )
        }
      </aside>

      <!-- Right column: profile paragraph + CV sections -->
      <div class="cv-main">
        <div
          class="cv-profile"
          set:html={markdownToHtml(basics.profile)}
        />

        {
          sections.map((section) => (
            <section
              class="cv-section"
              id={generateSlug(section.title)}
              aria-label={section.title}
            >
              <div class="section-header">
                <h2>{section.title}</h2>
              </div>

              {(section.kind === "experience" ||
                section.kind === "education") && (
                <div class="timeline">
                  {section.items.map((item, index) => {
                    const title = "role" in item ? item.role : item.degree;
                    return (
                      <article
                        class="timeline-item"
                        id={generateSlug(`${section.title}-${title}-${index}`)}
                      >
                        <div
                          class:list={[
                            "timeline-marker",
                            { "timeline-marker--past": index > 0 },
                          ]}
                          aria-hidden="true"
                        />
                        <span class="item-year">{item.period}</span>
                        <div class="timeline-content">
                          <h3 class="item-title">{title}</h3>

                          <div
                            class="item-institution"
                            set:html={orgsHtml(item.org)}
                          />
                          {item.department && (
                            <div
                              class="item-department"
                              set:html={markdownToHtml(orgMd(item.department))}
                            />
                          )}
                          {item.location && (
                            <div class="item-location">
                              <span
                                class="i-fa-solid:map-marker-alt"
                                aria-hidden="true"
                              />{" "}
                              {item.location}
                            </div>
                          )}

                          {item.summary && (
                            <div
                              class="item-summary"
                              set:html={markdownToHtml(item.summary)}
                            />
                          )}
                          {item.notes?.map((note) => (
                            <div
                              class="item-summary"
                              set:html={markdownToHtml(note)}
                            />
                          ))}

                          {item.bullets && item.bullets.length > 0 && (
                            <ul class="item-description-list">
                              {item.bullets.map((bullet) => (
                                <li set:html={markdownToHtml(bullet)} />
                              ))}
                            </ul>
                          )}

                          {item.pubGroups?.map((pg) => (
                            <div class="item-pubgroup">
                              <strong>{pg.heading}</strong>
                              <ul>
                                {pg.items.map((pub) => (
                                  <li set:html={markdownToHtml(pub)} />
                                ))}
                              </ul>
                            </div>
                          ))}

                          {"documents" in item && item.documents && (
                            <div class="item-links">
                              {item.documents.map((doc) => (
                                <a
                                  href={doc.url}
                                  class="btn btn-sm"
                                  target="_blank"
                                  rel="external noopener noreferrer"
                                  aria-label={doc.ariaLabel}
                                >
                                  <span
                                    class="i-fa-solid:file-pdf"
                                    aria-hidden="true"
                                  />
                                  {doc.label}
                                </a>
                              ))}
                            </div>
                          )}

                          {item.links && item.links.length > 0 && (
                            <div class="item-links">
                              {item.links.map((link) => (
                                <a
                                  href={link.url}
                                  class="btn btn-sm"
                                  target="_blank"
                                  rel="external noopener noreferrer"
                                  aria-label={link.ariaLabel}
                                >
                                  {link.label}
                                </a>
                              ))}
                            </div>
                          )}
                        </div>
                      </article>
                    );
                  })}
                </div>
              )}

              {section.kind === "skills" && (
                <>
                  <div class="grid-layout grid-layout--skills">
                    {section.groups.map((group, index) => (
                      <div
                        class="skill-group-wrapper"
                        id={generateSlug(
                          `${section.title}-${group.category}-${index}`,
                        )}
                      >
                        <SkillGroup group={group} />
                      </div>
                    ))}
                  </div>
                  <div
                    class="skills-legend"
                    aria-hidden="true"
                  >
                    <span class="legend-item">
                      <span class="legend-swatch legend-swatch--advanced" />
                      {t("pages.cv.levelAdvanced")}
                    </span>
                    <span class="legend-item">
                      <span class="legend-swatch" />
                      {`${t("pages.cv.levelIntermediate")} / ${t("pages.cv.levelBasic").toLowerCase()}`}
                    </span>
                  </div>
                </>
              )}

              {section.kind === "certificates" && (
                <div class="grid-layout grid-layout--cards">
                  {section.groups.map((group, index) => (
                    <div
                      class="cert-group-wrapper"
                      id={generateSlug(
                        `${section.title}-${group.category}-${index}`,
                      )}
                    >
                      <CertificateGroup group={group} />
                    </div>
                  ))}
                </div>
              )}

              {section.kind === "projects" && (
                <div class="grid-layout grid-layout--cards">
                  {section.items.map((project, index) => (
                    <div
                      class="project-card-wrapper"
                      id={generateSlug(
                        `${section.title}-${project.name}-${index}`,
                      )}
                    >
                      <ProjectCard
                        project={{
                          ...project,
                          metrics: [
                            ...(projectStats.get(project.name) ?? []),
                            ...(project.metrics ?? []),
                          ],
                        }}
                      />
                    </div>
                  ))}
                </div>
              )}
            </section>
          ))
        }
      </div>
    </div>
  </div>

  <CVMenu sections={menuSections} />

  {/* ICON_DETECTION_START */}
  <div
    class="hidden"
    aria-hidden="true"
  >
    <span class="i-fa-solid:microchip"></span>
    <span class="i-logos:c"></span>
    <span class="i-simple-icons:arm"></span>
    <span class="i-simple-icons:espressif"></span>
    <span class="i-mdi:chip"></span>
    <span class="i-mdi:clock-fast"></span>
    <span class="i-fa-solid:project-diagram"></span>
    <span class="i-fa-solid:bug"></span>
    <span class="i-fa-solid:wave-square"></span>
    <span class="i-fa-solid:code"></span>
    <span class="i-logos:python"></span>
    <span class="i-logos:c-plusplus"></span>
    <span class="i-vscode-icons:file-type-clangd"></span>
    <span class="i-logos:git-icon"></span>
    <span class="i-mdi:github"></span>
    <span class="i-mdi:gitlab"></span>
    <span class="i-simple-icons:githubactions"></span>
    <span class="i-logos:docker-icon"></span>
    <span class="i-vscode-icons:file-type-matlab"></span>
    <span class="i-vscode-icons:file-type-cmake"></span>
    <span class="i-logos:jetbrains"></span>
    <span class="i-mdi:robot-outline"></span>
    <span class="i-simple-icons:modelcontextprotocol"></span>
    <span class="i-simple-icons:claude"></span>
    <span class="i-mdi:brain"></span>
    <span class="i-simple-icons:comsol"></span>
    <span class="i-simple-icons:labview"></span>
    <span class="i-fa-solid:desktop"></span>
    <span class="i-fa-solid:network-wired"></span>
    <span class="i-logos:linux-tux"></span>
    <span class="i-simple-icons:apple"></span>
    <span class="i-logos:microsoft-windows-icon"></span>
    <span class="i-vscode-icons:file-type-tex"></span>
    <span class="i-vscode-icons:file-type-html"></span>
    <span class="i-fa-solid:medkit"></span>
    <span class="i-fa-solid:users"></span>
    <span class="i-fa-solid:industry"></span>
    <span class="i-fa-solid:laptop-code"></span>
    <span class="i-logos:go"></span>
    <span class="i-logos:typescript-icon"></span>
    <span class="i-logos:bash-icon"></span>
    <span class="i-simple-icons:platformio"></span>
    <span class="i-mdi:shield-key-outline"></span>
    <span class="i-simple-icons:doxygen"></span>
    <span class="i-fa-solid:shield-alt"></span>
    <span class="i-simple-icons:gitlab"></span>
    <span class="i-simple-icons:jenkins"></span>
    <span class="i-simple-icons:sonarqube"></span>
    <span class="i-mdi:package-variant-closed"></span>
    <span class="i-fa-solid:search-plus"></span>
    <span class="i-fa-solid:vials"></span>
    <span class="i-simple-icons:precommit"></span>
    <span class="i-mdi:lan"></span>
    <span class="i-simple-icons:mikrotik"></span>
    <span class="i-simple-icons:wireguard"></span>
    <span class="i-mdi:ip-network-outline"></span>
    <span class="i-mdi:lightning-bolt"></span>
    <span class="i-mdi:dns"></span>
    <span class="i-mdi:shield-lock-outline"></span>
    <span class="i-fa-solid:key"></span>
    <span class="i-fa-solid:certificate"></span>
    <span class="i-simple-icons:nginx"></span>
    <span class="i-fa-solid:user-shield"></span>
    <span class="i-fa-solid:download"></span>
    <span class="i-fa-solid:map-marker-alt"></span>
    <span class="i-fa-solid:file-pdf"></span>
  </div>
  {/* ICON_DETECTION_END */}
</BaseLayout>

<style>
  /* ===== Page kicker "// curriculum vitae" ======================== */
  .cv-title {
    padding: 0;
    margin: var(--space-lg) 0 var(--space-sm);
    font-family: var(--font-mono);

    /* !important defeats the global mobile `h1 { font-size: 1.5em !important }`
       so the CV title stays a small mono kicker on narrow viewports. */
    font-size: var(--text-xs) !important;
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    border: 0;
  }

  .cv-title::before {
    content: "// ";
  }

  /* ===== Full-width hero (name / headline / location) ============= */
  .cv-hero {
    padding-bottom: var(--space-lg);
    margin-bottom: var(--space-lg-xl);
    border-bottom: 1px solid var(--color-hair);
  }

  .cv-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
  }

  .cv-headline {
    margin: var(--space-sm) 0 0;
    font-size: var(--text-lg);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
  }

  /* Location + availability in one mono line */
  .cv-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    align-items: center;
    margin: var(--space-sm) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* ===== 2-column layout ========================================== */
  .cv-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: var(--space-lg-xl); /* 48px — matches mockup */
    align-items: start;
  }

  /* ===== Left sticky sidebar ====================================== */
  .cv-sidebar {
    position: sticky;
    top: calc(var(--header-height) + 1.25rem); /* ≈ 84px */
    display: flex;
    flex-direction: column;
    gap: var(--space-md-lg); /* 24px between blocks */
  }

  /* Horizontal hairline between sidebar blocks */
  .cv-sb-divider {
    height: 1px;
    background: var(--color-hair);
  }

  /* Transparent wrapper: lets optional divider+block participate directly
     in the sidebar flex flow without an extra visual layer. */
  .cv-sb-group {
    display: contents;
  }

  /* Mono eyebrow label — same "// " prefix style as section headings */
  .cv-sb-eyebrow {
    margin: 0 0 0.8125rem; /* 13px */
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .cv-sb-eyebrow::before {
    content: "// ";
  }

  /* ===== Contact link list ======================================== */
  .cv-sb-contact {
    display: flex;
    flex-direction: column;
    gap: 0.5625rem; /* 9px */
    padding: 0;
    margin: 0;
    list-style: none;
  }

