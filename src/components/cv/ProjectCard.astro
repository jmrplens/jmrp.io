---
/**
 * Renders a single featured open-source / portfolio project as a card.
 * Used by the CV "projects" section type.
 */
import type { CVProjectItem } from "@src/types";
import { markdownToHtml } from "@utils/cv-markdown";

interface Props {
  project: CVProjectItem;
}

const { project } = Astro.props;
---

<article class="project-card">
  <header class="project-header">
    <h3 class="project-name">
      {
        project.icon && (
          <span
            class={`i-${project.icon} project-icon`}
            aria-hidden="true"
          />
        )
      }
      {project.name}
    </h3>
    {
      project.metrics && project.metrics.length > 0 && (
        <ul class="project-metrics">
          {project.metrics.map((m) => (
            <li class="metric-badge">{m}</li>
          ))}
        </ul>
      )
    }
  </header>

  {project.tech && <p class="project-tech">{project.tech}</p>}

  {
    project.description && (
      <div
        class="project-description"
        set:html={markdownToHtml(project.description)}
      />
    )
  }

  {
    project.links && project.links.length > 0 && (
      <div class="project-links">
        {project.links.map((link) => (
          <a
            href={link.url}
            class="btn btn-sm btn-outline"
            target="_blank"
            rel="external noopener noreferrer"
            aria-label={link.ariaLabel ?? `${link.label} — ${project.name}`}
          >
            <span
              class="i-fa-solid:external-link-alt"
              aria-hidden="true"
            />
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-lg);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      transform var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  .project-card:hover {
    border-color: var(--accent-line);
    box-shadow: var(--sh-card);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }

    .project-card:hover {
      transform: none;
    }
  }

  .project-header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    align-items: baseline;
    justify-content: space-between;
  }

  .project-name {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: var(--fw-bold);
    color: var(--color-text-heading);
  }

  .project-icon {
    width: 1.4rem;
    min-width: 1.4rem;
    height: 1.4rem;
  }

  .project-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .metric-badge {
    padding: 0.15rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: var(--fw-medium);
    color: var(--color-on-primary);
    background-color: var(--color-primary);
    border-radius: var(--radius-sm);
  }

  .project-tech {
    margin: var(--space-xs) 0 0;
    font-size: 0.9rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
  }

  .project-description {
    margin-top: var(--space-sm);
    line-height: 1.65;
    color: var(--color-text);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    margin-top: auto;
  }
</style>
