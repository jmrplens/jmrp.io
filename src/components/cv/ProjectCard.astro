---
/**
 * Renders a single featured open-source / portfolio project as a card.
 *
 * The project name is a link to the first entry in `project.links`.
 * GitHub metrics (stars, releases, downloads) are displayed as plain mono text
 * so as not to compete visually with the project description.
 */
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import type { CVProjectItem } from "@src/types";
import { markdownToHtml } from "@utils/cv-markdown";

interface Props {
  /** The project data including live GitHub stats merged by CVPage.astro. */
  project: CVProjectItem;
}

const { project } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);

/** Primary link used for the card title anchor. */
const primaryLink = project.links?.[0];

/**
 * Every configured link, rendered as a row so the YAML never carries hidden
 * URLs; a lone GitHub link is already the title anchor and gets no row.
 */
const linkRow = (project.links?.length ?? 0) > 1 ? project.links : undefined;
---

<article class="project-card">
  <header class="project-header">
    <h3 class="project-name">
      {
        primaryLink ? (
          <a
            href={primaryLink.url}
            target="_blank"
            rel="external noopener noreferrer"
            aria-label={primaryLink.ariaLabel ?? `${project.name} — GitHub`}
          >
            {project.name}
          </a>
        ) : (
          project.name
        )
      }
    </h3>
    {project.tech && <span class="project-tech-tag">{project.tech}</span>}
  </header>

  {
    project.description && (
      <div
        class="project-description"
        set:html={markdownToHtml(project.description)}
      />
    )
  }

  {
    project.metrics && project.metrics.length > 0 && (
      <div class="project-metrics">
        {project.metrics.map((m) => (
          <span class:list={[{ "metric--star": m.includes("★") }]}>{m}</span>
        ))}
      </div>
    )
  }

  {
    linkRow && (
      <ul
        class="project-links"
        aria-label={t("pages.cv.projectLinksAriaLabel", {
          project: project.name,
        })}
      >
        {linkRow.map((link) => (
          <li>
            <a
              href={link.url}
              target="_blank"
              rel="external noopener noreferrer"
              aria-label={link.ariaLabel ?? `${project.name} — ${link.label}`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.125rem; /* 18 px */
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  .project-card:hover {
    border-color: var(--accent-line);
    box-shadow: var(--sh-card);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
  }

  .project-header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.4375rem; /* 7 px */
  }

  .project-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
  }

  /* Name link inherits heading color, no underline until hover. */
  .project-name a {
    color: inherit;
    text-decoration: none;
  }

  .project-name a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .project-name a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Tech stack tag — mono, accent color, top-right of header. */
  .project-tech-tag {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .project-description {
    flex: 1;
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text);
  }

  /* Plain mono metrics row — e.g. "★27 · 35 releases · ~29k downloads". */
  .project-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem; /* 10 px */
    margin-top: 0.6875rem; /* 11 px */
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }

  /* Star count rendered in teal to match GitHub's star iconography. */
  .project-metrics .metric--star {
    color: var(--teal);
  }

  /* Configured link row — mono like the metrics, underlined so the links
     are distinguishable without relying on color alone. */
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) 0.625rem; /* 10 px */
    padding: 0;
    margin: 0.6875rem 0 0; /* 11 px */
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    list-style: none;
  }

  .project-links a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .project-links a:hover {
    color: var(--color-accent);
  }

  .project-links a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
