---
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import type { CVSkillGroup } from "@src/types";

interface Props {
  group: CVSkillGroup;
}

const { group } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const levelTextMap: Record<number, string> = {
  0: t("pages.cv.levelNone"),
  1: t("pages.cv.levelElementary"),
  2: t("pages.cv.levelBasic"),
  3: t("pages.cv.levelIntermediate"),
  4: t("pages.cv.levelAdvanced"),
  5: t("pages.cv.levelExpert"),
};

import "@styles/skills.css";
---

<div class="group-category">
  <h3>
    {
      group.icon && (
        <span
          class={`i-${group.icon}`}
          aria-hidden="true"
        />
      )
    }
    {group.category}
  </h3>
  <div class="compact-list">
    {
      group.items.map((item) => {
        // Handle numeric and string levels
        // If numeric, use directly. If string, map if possible or default to 0 for score
        // For aria-valuenow, we only want a number.

        let score = 0;
        let levelLabel: string | number = t("pages.cv.levelUnknown");

        if (typeof item.level === "number") {
          score = item.level;
          levelLabel = levelTextMap[item.level] || String(item.level);
        } else if (typeof item.level === "string") {
          // Try to find if the string matches a known level name
          levelLabel = item.level;
        }

        const showDots = typeof item.level === "number";

        return (
          <div class="compact-item skill-item">
            {item.icon && (
              <span
                class={`i-${item.icon} skill-icon`}
                aria-hidden="true"
              />
            )}
            <div class="skill-content">
              <div class="skill-header">
                <span class="compact-name">{item.name}</span>
                {item.note && <span class="skill-desc">{item.note}</span>}
              </div>
              {item.level != null && (
                <div
                  class="skill-meta"
                  role={showDots ? "meter" : "status"}
                  aria-valuemin={showDots ? 0 : undefined}
                  aria-valuemax={showDots ? 5 : undefined}
                  aria-valuenow={showDots ? score : undefined}
                  aria-label={t("aria.skillLevel", {
                    name: item.name,
                    level: String(levelLabel),
                  })}
                >
                  {showDots && (
                    <div
                      class="level-dots"
                      aria-hidden="true"
                    >
                      {[1, 2, 3, 4, 5].map((i) => (
                        <div class={`dot ${i <= score ? "filled" : ""}`} />
                      ))}
                    </div>
                  )}
                  <span
                    class="level-text"
                    aria-hidden="true"
                  >
                    {levelLabel}
                  </span>
                </div>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .group-category {
    padding: var(--space-md);
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-md);
    break-inside: avoid;
  }

  .group-category h3 {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    padding-bottom: var(--space-sm);
    margin: 0 0 var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: var(--fw-semibold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-bottom: 1px solid var(--color-hair);
  }

  .compact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* Skill Item Styles duplicate from cv.astro to ensure self-contained style or inherit from global */

  /* .skill-item is now imported from @styles/skills.css */

  .skill-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    min-width: 1.5rem;
    height: 1.5rem;
  }

  .skill-content {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden; /* Prevent overflow */
  }

  .skill-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }

  .skill-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .skill-meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .level-dots {
    display: flex;
    gap: 4px;
  }

  .dot {
    width: 10px;
    height: 10px;
    background-color: transparent;
    border: 1.5px solid var(--color-border);
    border-radius: 50%;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .dot.filled {
    background-color: var(--color-primary); /* Uses theme color */
    border-color: var(--color-primary);
  }

  .level-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
</style>
