---
import type { CVSkillGroup } from "@src/types";

interface Props {
  group: CVSkillGroup;
}

const { group } = Astro.props;

const levelTextMap: Record<number | string, string> = {
  0: "None",
  1: "Elementary",
  2: "Basic",
  3: "Intermediate",
  4: "Advanced",
  5: "Expert",
};

import "@styles/skills.css";
---

<div class="group-category">
  <h3>
    {group.icon && <span class={`i-${group.icon}`} />}
    {group.category}
  </h3>
  <div class="compact-list">
    {
      group.items.map((item) => {
        // Handle numeric and string levels
        // If numeric, use directly. If string, map if possible or default to 0 for score
        // For aria-valuenow, we only want a number.

        let score = 0;
        let levelLabel: string | number = item.level ?? 0; // Explicitly allow both, default to 0

        if (typeof item.level === "number") {
          score = item.level;
          levelLabel = levelTextMap[item.level] || String(item.level);
        } else if (typeof item.level === "string") {
          // Try to find if the string matches a known level name
          score = 0;
          levelLabel = item.level;
        }

        const showDots = typeof item.level === "number";

        return (
          <div class="compact-item skill-item">
            {item.icon && (
              <span
                class={`i-${item.icon} skill-icon`}
                aria-hidden="true"
              />
            )}
            <div class="skill-content">
              <div class="skill-header">
                <span class="compact-name">{item.name}</span>
                {item.desc && <span class="skill-desc">{item.desc}</span>}
              </div>
              {item.level != null && (
                <div
                  class="skill-meta"
                  role={showDots ? "meter" : "status"}
                  aria-valuemin={showDots ? 0 : undefined}
                  aria-valuemax={showDots ? 5 : undefined}
                  aria-valuenow={showDots ? score : undefined}
                  aria-label={`${item.name} level: ${levelLabel}`}
                >
                  {showDots && (
                    <div
                      class="level-dots"
                      aria-hidden="true"
                    >
                      {[1, 2, 3, 4, 5].map((i) => (
                        <div class={`dot ${i <= score ? "filled" : ""}`} />
                      ))}
                    </div>
                  )}
                  <span
                    class="level-text"
                    aria-hidden="true"
                  >
                    {levelLabel}
                  </span>
                </div>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .group-category {
    break-inside: avoid;
  }

  .group-category h3 {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    padding-bottom: var(--space-xs);
    margin-bottom: var(--space-md);
    border-bottom: var(--border-2);
  }

  .compact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* Skill Item Styles duplicate from cv.astro to ensure self-contained style or inherit from global */

  /* .skill-item is now imported from @styles/skills.css */

  .skill-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    min-width: 24px;
    height: 1.5rem;
  }

  .skill-content {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden; /* Prevent overflow */
  }

  .skill-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }

  .skill-desc {
    font-size: 0.75rem;
    color: var(--color-text-offset);
    white-space: nowrap; /* Prevent breaking mid-word */
  }

  .skill-meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .level-dots {
    display: flex;
    gap: 4px;
  }

  .dot {
    width: 10px;
    height: 10px;
    background-color: transparent;
    border: 1.5px solid var(--color-border);
    border-radius: 50%;
    transition: all 0.2s ease;
  }

  .dot.filled {
    background-color: var(--color-primary); /* Uses theme color */
    border-color: var(--color-primary);
  }

  .level-text {
    font-size: 0.7rem;
    color: var(--color-text-offset);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
</style>
