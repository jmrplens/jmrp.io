---
/**
 * Renders a single skill group as a set of level-colored tag chips.
 *
 * Advanced skills (level ≥ 4 or string "advanced"/"expert") get an accent-colored
 * border and text; intermediate / basic skills use the neutral border color.
 * A section-level legend (rendered in CVPage.astro) explains the visual convention.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import type { CVSkillGroup } from "@src/types";

interface Props {
  /** The skill group data (category title + items with optional level). */
  group: CVSkillGroup;
}

const { group } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

/**
 * Returns true when a skill level qualifies as "advanced" (≥ 4 on 0–5 scale,
 * or the string values "advanced", "expert", "avanzado", "experto").
 *
 * @param level - The raw level value from the CV YAML.
 */
function isAdvanced(level: number | string | null | undefined): boolean {
  if (typeof level === "number") return level >= 4;
  if (typeof level === "string") {
    return ["advanced", "expert", "avanzado", "experto"].includes(
      level.toLowerCase(),
    );
  }
  return false;
}
---

<div class="skill-group">
  <h3 class="skill-group-title">{group.category}</h3>
  <ul class="chip-list">
    {
      group.items.map((item) => {
        const advanced = isAdvanced(item.level);
        return (
          <li class:list={["chip", { "chip--advanced": advanced }]}>
            {item.name}
            {advanced && (
              <span class="sr-only">, {t("pages.cv.levelAdvanced")}</span>
            )}
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .skill-group {
    break-inside: avoid;
  }

  /* Group heading — display font, heading color (not mono kicker style). */
  .skill-group-title {
    margin: 0 0 0.6875rem;
    font-family: var(--font-display);
    font-size: 0.8125rem; /* 13 px */
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
  }

  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem; /* 6 px */
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* Base chip — intermediate / basic level. */
  .chip {
    padding: 0.1875rem 0.5rem; /* 3 px 8 px */
    font-family: var(--font-mono);
    font-size: 0.6875rem; /* 11 px */
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  /* Advanced chip — accent border + accent text. */
  .chip--advanced {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
