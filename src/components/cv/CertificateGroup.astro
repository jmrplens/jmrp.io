---
/**
 * Renders a certificate group as a single summary card.
 *
 * The card shows the group category name alongside an item-count badge.
 * Certificate names are listed in a single compact paragraph, reducing
 * visual complexity compared to individual downloadable rows.
 */
import type { CVCertificateGroup } from "@src/types";

interface Props {
  /** The certificate group data (category + array of individual certs). */
  group: CVCertificateGroup;
}

const { group } = Astro.props;

const count = group.items.length;
const names = group.items.map((item) => item.name).join(" · ");
---

<div class="cert-card">
  <header class="cert-card-header">
    <span class="cert-card-name">{group.category}</span>
    <span class="cert-count">{count}</span>
  </header>
  <p class="cert-items">{names}</p>
</div>

<style>
  .cert-card {
    padding: 1rem 1.125rem; /* 16 px 18 px */
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  .cert-card:hover {
    border-color: var(--accent-line);
    box-shadow: var(--sh-card);
  }

  @media (prefers-reduced-motion: reduce) {
    .cert-card {
      transition: none;
    }
  }

  .cert-card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5625rem; /* 9 px */
  }

  .cert-card-name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
  }

  /* Item count badge — mono, accent, top-right of card header. */
  .cert-count {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-accent);
  }

  .cert-items {
    margin: 0;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text);
  }
</style>
