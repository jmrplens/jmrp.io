---
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";
import type { CVCertificateGroup } from "@src/types";

interface Props {
  group: CVCertificateGroup;
}

const { group } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
---

<div class="group-category">
  <h3>
    {
      group.icon && (
        <span
          class={`i-${group.icon}`}
          aria-hidden="true"
        />
      )
    }
    {group.category}
  </h3>
  <div class="certificate-list">
    {
      group.items.map((item) => (
        <div class="certificate-item">
          <div class="cert-main">
            <span class="cert-name">{item.name}</span>
            <div class="cert-meta">
              {item.school && (
                <span class="cert-school">
                  <span
                    class="i-fa-solid:university meta-icon"
                    aria-hidden="true"
                  />
                  {item.school}
                </span>
              )}
              {item.time && (
                <span class="cert-time">
                  <span
                    class="i-fa-solid:clock meta-icon"
                    aria-hidden="true"
                  />
                  {item.time}
                </span>
              )}
            </div>
          </div>

          {item.link && (
            <a
              href={item.link}
              class="btn btn-sm"
              download
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t("aria.downloadCertificate", { name: item.name })}
            >
              <span
                class="i-fa-solid:download"
                aria-hidden="true"
              />
              {item.linkname || t("pages.cv.certificateFallback")}
            </a>
          )}
        </div>
      ))
    }
  </div>
</div>

<style>
  .group-category {
    break-inside: avoid;
  }

  .group-category h3 {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    padding-bottom: var(--space-xs);
    margin-bottom: var(--space-md);
    color: var(--color-text);
    border-bottom: var(--border-2);
  }

  .certificate-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .certificate-item {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm);
    background-color: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-sm);
  }

  .cert-main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .cert-name {
    font-size: 1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  .cert-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .cert-meta span {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }

  .meta-icon {
    font-size: 0.8em;
    opacity: 80%;
  }

  @media (width <= 600px) {
    .certificate-item {
      flex-direction: column;
      gap: var(--space-sm);
      align-items: flex-start;
    }
  }
</style>
