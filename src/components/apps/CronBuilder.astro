---
/**
 * CronBuilder Component
 * Visual cron expression builder with interactive field selectors,
 * human-readable descriptions, next executions preview, and sharing.
 *
 * Features:
 * - Interactive grid selectors for each cron field (click to toggle values)
 * - Quick-pick helpers (Every, Range, Step) per field
 * - Improved human-readable description with day/month names
 * - Inline syntax quick reference
 * - Copy expression + Share Link
 * - URL parameter support (?expr=...)
 * - Crontab line output with editable command
 * - 14 common presets
 * - Next 10 executions with relative times
 *
 * @example
 * <CronBuilder title="Cron Expression Builder" />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

interface Props {
  title?: string;
}

const { title = t("tools.cronBuilder.title") } = Astro.props;
const uniqueId = `cron-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

const presets = [
  { label: t("tools.cronBuilder.presetEveryMinute"), value: "* * * * *" },
  { label: t("tools.cronBuilder.presetEvery5Min"), value: "*/5 * * * *" },
  { label: t("tools.cronBuilder.presetEvery15Min"), value: "*/15 * * * *" },
  { label: t("tools.cronBuilder.presetEvery30Min"), value: "*/30 * * * *" },
  { label: t("tools.cronBuilder.presetEveryHour"), value: "0 * * * *" },
  { label: t("tools.cronBuilder.presetEvery6Hours"), value: "0 */6 * * *" },
  {
    label: t("tools.cronBuilder.presetEvery12Hours"),
    value: "0 */12 * * *",
  },
  { label: t("tools.cronBuilder.presetEveryDay"), value: "0 0 * * *" },
  { label: t("tools.cronBuilder.presetDailyAt3AM"), value: "0 3 * * *" },
  { label: t("tools.cronBuilder.presetTwiceDaily"), value: "0 9,21 * * *" },
  {
    label: t("tools.cronBuilder.presetEveryWeekday"),
    value: "0 9 * * 1-5",
  },
  { label: t("tools.cronBuilder.presetEveryWeek"), value: "0 0 * * 0" },
  { label: t("tools.cronBuilder.presetEveryMonth"), value: "0 0 1 * *" },
  {
    label: t("tools.cronBuilder.presetQuarterly"),
    value: "0 0 1 1,4,7,10 *",
  },
];

const fields = [
  { id: "minute", label: t("tools.cronBuilder.minute"), min: 0, max: 59 },
  { id: "hour", label: t("tools.cronBuilder.hour"), min: 0, max: 23 },
  { id: "dom", label: t("tools.cronBuilder.dayMonth"), min: 1, max: 31 },
  { id: "month", label: t("tools.cronBuilder.month"), min: 1, max: 12 },
  { id: "dow", label: t("tools.cronBuilder.dayWeek"), min: 0, max: 6 },
];

const monthLabels = [
  t("tools.cronBuilder.monthJanShort"),
  t("tools.cronBuilder.monthFebShort"),
  t("tools.cronBuilder.monthMarShort"),
  t("tools.cronBuilder.monthAprShort"),
  t("tools.cronBuilder.monthMayShort"),
  t("tools.cronBuilder.monthJunShort"),
  t("tools.cronBuilder.monthJulShort"),
  t("tools.cronBuilder.monthAugShort"),
  t("tools.cronBuilder.monthSepShort"),
  t("tools.cronBuilder.monthOctShort"),
  t("tools.cronBuilder.monthNovShort"),
  t("tools.cronBuilder.monthDecShort"),
];
const dowLabels = [
  t("tools.cronBuilder.daySunShort"),
  t("tools.cronBuilder.dayMonShort"),
  t("tools.cronBuilder.dayTueShort"),
  t("tools.cronBuilder.dayWedShort"),
  t("tools.cronBuilder.dayThuShort"),
  t("tools.cronBuilder.dayFriShort"),
  t("tools.cronBuilder.daySatShort"),
];

/** Translations passed to the inline script via define:vars. */
const i18n = {
  dayNames: [
    t("tools.cronBuilder.daySun"),
    t("tools.cronBuilder.dayMon"),
    t("tools.cronBuilder.dayTue"),
    t("tools.cronBuilder.dayWed"),
    t("tools.cronBuilder.dayThu"),
    t("tools.cronBuilder.dayFri"),
    t("tools.cronBuilder.daySat"),
    t("tools.cronBuilder.daySun"),
  ],
  monthNames: [
    "",
    t("tools.cronBuilder.monthJan"),
    t("tools.cronBuilder.monthFeb"),
    t("tools.cronBuilder.monthMar"),
    t("tools.cronBuilder.monthApr"),
    t("tools.cronBuilder.monthMay"),
    t("tools.cronBuilder.monthJun"),
    t("tools.cronBuilder.monthJul"),
    t("tools.cronBuilder.monthAug"),
    t("tools.cronBuilder.monthSep"),
    t("tools.cronBuilder.monthOct"),
    t("tools.cronBuilder.monthNov"),
    t("tools.cronBuilder.monthDec"),
  ],
  everyMinute: t("tools.cronBuilder.everyMinute"),
  descEveryNMinutes: t("tools.cronBuilder.descEveryNMinutes"),
  descEveryNHours: t("tools.cronBuilder.descEveryNHours"),
  descAtMidnight: t("tools.cronBuilder.descAtMidnight"),
  descAtTimes: t("tools.cronBuilder.descAtTimes"),
  descAtMinuteOfHour: t("tools.cronBuilder.descAtMinuteOfHour"),
  descEveryMinuteDuringHour: t("tools.cronBuilder.descEveryMinuteDuringHour"),
  descAtMinuteOfEveryHour: t("tools.cronBuilder.descAtMinuteOfEveryHour"),
  descOnDayOfMonth: t("tools.cronBuilder.descOnDayOfMonth"),
  descOnWeekdays: t("tools.cronBuilder.descOnWeekdays"),
  descOnWeekends: t("tools.cronBuilder.descOnWeekends"),
  descriptionIn: t("tools.cronBuilder.descriptionIn"),
  descriptionOn: t("tools.cronBuilder.descriptionOn"),
  customSchedule: t("tools.cronBuilder.customSchedule"),
  enterExpression: t("tools.cronBuilder.enterExpression"),
  invalidExpressionFormat: t("tools.cronBuilder.invalidExpressionFormat"),
  invalidExpressionShort: t("tools.cronBuilder.invalidExpressionShort"),
  noExecutions: t("tools.cronBuilder.noExecutions"),
  relativeInDH: t("tools.cronBuilder.relativeInDH"),
  relativeInHM: t("tools.cronBuilder.relativeInHM"),
  relativeInM: t("tools.cronBuilder.relativeInM"),
  copied: t("tools.shared.copied"),
  shareLink: t("tools.shared.shareLink"),
};
---

<div
  class="cron-builder"
  data-cron-id={uniqueId}
>
  {title && <div class="cron-title">{title}</div>}

  <div class="cron-layout">
    {/* Expression input + copy */}
    <div class="cron-expr-section">
      <label
        class="cron-label"
        for={`${uniqueId}-expr`}
      >
        <span
          class="i-mdi:timer-outline"
          aria-hidden="true"
        ></span>
        {t("tools.cronBuilder.expressionLabel")}
      </label>
      <div class="cron-expr-row">
        <input
          type="text"
          id={`${uniqueId}-expr`}
          class="cron-expr-input"
          value="0 3 * * *"
          spellcheck="false"
          autocomplete="off"
          aria-label={t("tools.cronBuilder.expressionAriaLabel")}
        />
        <button
          type="button"
          class="cron-copy-expr-btn"
          aria-label={t("tools.cronBuilder.copyExpression")}
        >
          <span
            class="i-mdi:content-copy"
            aria-hidden="true"
          ></span>
        </button>
      </div>
      <div class="cron-field-labels">
        {fields.map((f) => <span class="cron-field-label">{f.label}</span>)}
      </div>
    </div>

    {/* Human readable */}
    <div class="cron-human">
      <span
        class="i-mdi:translate"
        aria-hidden="true"
      ></span>
      <span id={`${uniqueId}-human`}></span>
    </div>

    {/* Visual field selectors */}
    <div class="cron-fields-section">
      <div class="cron-fields-header">
        <span
          class="i-mdi:tune-variant"
          aria-hidden="true"
        ></span>
        <span>{t("tools.cronBuilder.fieldSelectors")}</span>
      </div>
      {
        fields.map((f) => (
          <div
            class="cron-field-group"
            data-field={f.id}
          >
            <div class="cron-field-top">
              <span class="cron-field-name">{f.label}</span>
              <span class="cron-field-range">
                ({f.min}–{f.max})
              </span>
              <div class="cron-field-quick">
                <button
                  type="button"
                  class="cron-quick-btn"
                  data-action="every"
                >
                  {t("tools.cronBuilder.everyWildcard")}
                </button>
                <button
                  type="button"
                  class="cron-quick-btn"
                  data-action="clear"
                >
                  {t("tools.cronBuilder.clear")}
                </button>
              </div>
            </div>
            <div
              class="cron-value-grid"
              role="group"
              aria-label={t("tools.cronBuilder.selectFieldValues").replace(
                "{field}",
                () => f.label.toLowerCase(),
              )}
            >
              {Array.from({ length: f.max - f.min + 1 }, (_, i) => {
                const val = f.min + i;
                let displayLabel = String(val);
                if (f.id === "month") displayLabel = monthLabels[i];
                else if (f.id === "dow") displayLabel = dowLabels[i];
                return (
                  <button
                    type="button"
                    class="cron-val-btn"
                    data-val={val}
                    aria-label={`${f.label} ${displayLabel}`}
                    aria-pressed="false"
                  >
                    {displayLabel}
                  </button>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>

    {/* Presets */}
    <div class="cron-presets">
      <span class="cron-presets-header">
        <span
          class="i-mdi:flash"
          aria-hidden="true"
        ></span>
        {t("tools.cronBuilder.commonSchedules")}
      </span>
      <div class="cron-presets-grid">
        {
          presets.map((p) => (
            <button
              type="button"
              class="cron-preset-btn"
              data-value={p.value}
            >
              <code>{p.value}</code>
              <span>{p.label}</span>
            </button>
          ))
        }
      </div>
    </div>

    {/* Next executions */}
    <div class="cron-next-section">
      <div class="cron-next-header">
        <span
          class="i-mdi:calendar-clock"
          aria-hidden="true"
        ></span>
        <span>{t("tools.cronBuilder.nextExecutionsTitle")}</span>
      </div>
      {
        /* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- scrollable region requires keyboard access */
      }
      <div
        class="cron-next-list"
        id={`${uniqueId}-next`}
        tabindex="0"
        role="region"
        aria-label={t("tools.cronBuilder.nextExecutionsAriaLabel")}
      >
      </div>
      {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
    </div>

    {/* Crontab line output */}
    <div class="cron-crontab-section">
      <div class="cron-crontab-header">
        <span
          class="i-mdi:console"
          aria-hidden="true"
        ></span>
        <span>{t("tools.cronBuilder.crontabLine")}</span>
      </div>
      <div class="cron-crontab-row">
        <code
          class="cron-crontab-expr"
          id={`${uniqueId}-crontab-expr`}
          >0 3 * * *</code
        >
        <input
          type="text"
          id={`${uniqueId}-crontab-cmd`}
          class="cron-crontab-cmd"
          value="/usr/local/bin/backup.sh >> /var/log/backup.log 2>&1"
          spellcheck="false"
          autocomplete="off"
          aria-label={t("tools.cronBuilder.commandToRun")}
          placeholder={t("tools.cronBuilder.commandPlaceholder")}
        />
        <button
          type="button"
          class="cron-copy-line-btn"
          aria-label={t("tools.cronBuilder.copyCrontabLine")}
        >
          <span
            class="i-mdi:content-copy"
            aria-hidden="true"
          ></span>
        </button>
      </div>
    </div>

    {/* Syntax quick reference */}
    <details class="cron-syntax-ref">
      <summary>
        <span
          class="i-mdi:information-outline"
          aria-hidden="true"
        ></span>
        <span>{t("tools.cronBuilder.syntaxReference")}</span>
      </summary>
      <div class="cron-syntax-content">
        <table class="cron-syntax-table">
          <thead>
            <tr>
              <th>{t("tools.cronBuilder.symbolColumn")}</th>
              <th>{t("tools.cronBuilder.meaningColumn")}</th>
              <th>{t("tools.cronBuilder.exampleColumn")}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>*</code></td>
              <td>{t("tools.cronBuilder.symbolAsteriskMeaning")}</td>
              <td
                ><code>* * * * *</code> — {
                  t("tools.cronBuilder.symbolAsteriskExample")
                }</td
              >
            </tr>
            <tr>
              <td><code>,</code></td>
              <td>{t("tools.cronBuilder.symbolCommaMeaning")}</td>
              <td
                ><code>0,30 * * * *</code> — {
                  t("tools.cronBuilder.symbolCommaExample")
                }</td
              >
            </tr>
            <tr>
              <td><code>-</code></td>
              <td>{t("tools.cronBuilder.symbolDashMeaning")}</td>
              <td
                ><code>0 9-17 * * *</code> — {
                  t("tools.cronBuilder.symbolDashExample")
                }</td
              >
            </tr>
            <tr>
              <td><code>/</code></td>
              <td>{t("tools.cronBuilder.symbolSlashMeaning")}</td>
              <td
                ><code>*/10 * * * *</code> — {
                  t("tools.cronBuilder.symbolSlashExample")
                }</td
              >
            </tr>
          </tbody>
        </table>
        <div class="cron-syntax-fields">
          <code>┌──────── {t("tools.cronBuilder.syntaxMinute")}</code>
          <code>│ ┌────── {t("tools.cronBuilder.syntaxHour")}</code>
          <code>│ │ ┌──── {t("tools.cronBuilder.syntaxDom")}</code>
          <code>│ │ │ ┌── {t("tools.cronBuilder.syntaxMonth")}</code>
          <code>│ │ │ │ ┌ {t("tools.cronBuilder.syntaxDow")}</code>
          <code>* * * * * {t("tools.cronBuilder.syntaxCommand")}</code>
        </div>
      </div>
    </details>

    {/* Error */}
    <div
      class="cron-error"
      id={`${uniqueId}-error`}
      hidden
    >
      <span
        class="i-mdi:alert-circle-outline"
        aria-hidden="true"
      ></span>
      <span id={`${uniqueId}-error-text`}></span>
    </div>

    {/* Actions */}
    <div class="cron-actions">
      <button
        type="button"
        class="cron-share-btn"
      >
        <span
          class="i-mdi:share-variant"
          aria-hidden="true"
        ></span>
        <span class="cron-share-text">{t("tools.shared.shareLink")}</span>
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ uniqueId, i18n }}>
  (function () {
    var container = document.querySelector('[data-cron-id="' + uniqueId + '"]');
    if (!container) return;

    /** Replace `{key}` placeholders in a string with values from vars object. */
    function tpl(str, vars) {
      return str.replace(/\{(\w+)\}/g, function (_, k) {
        return vars[k] != null ? vars[k] : "";
      });
    }

    /* ── Element references ── */
    var exprInput = document.getElementById(uniqueId + "-expr");
    var humanEl = document.getElementById(uniqueId + "-human");
    var nextList = document.getElementById(uniqueId + "-next");
    var errorEl = document.getElementById(uniqueId + "-error");
    var errorText = document.getElementById(uniqueId + "-error-text");
    var crontabExpr = document.getElementById(uniqueId + "-crontab-expr");
    var crontabCmd = document.getElementById(uniqueId + "-crontab-cmd");
    var copyExprBtn = container.querySelector(".cron-copy-expr-btn");
    var copyLineBtn = container.querySelector(".cron-copy-line-btn");
    var shareBtn = container.querySelector(".cron-share-btn");
    var shareText = container.querySelector(".cron-share-text");
    var presetBtns = container.querySelectorAll(".cron-preset-btn");
    var fieldGroups = container.querySelectorAll(".cron-field-group");

    if (!exprInput) return;

    var syncing = false;

    var dayNames = i18n.dayNames;
    var monthNames = i18n.monthNames;

    var fieldDefs = [
      { id: "minute", min: 0, max: 59, idx: 0 },
      { id: "hour", min: 0, max: 23, idx: 1 },
      { id: "dom", min: 1, max: 31, idx: 2 },
      { id: "month", min: 1, max: 12, idx: 3 },
      { id: "dow", min: 0, max: 6, idx: 4 },
    ];

    /* ── Cron parsing ── */
    function parseCronField(field, min, max) {
      var values = [];
      var parts = field.split(",");

      for (var i = 0; i < parts.length; i++) {
        var part = parts[i].trim();

        var stepMatch = part.match(/^(.+)\/(\d+)$/);
        var step = 1;
        if (stepMatch) {
          step = parseInt(stepMatch[2]);
          part = stepMatch[1];
        }

        if (part === "*") {
          for (var v = min; v <= max; v += step) values.push(v);
        } else if (part.indexOf("-") !== -1) {
          var range = part.split("-");
          var start = parseInt(range[0]);
          var end = parseInt(range[1]);
          if (isNaN(start) || isNaN(end)) return null;
          for (var v = start; v <= end; v += step) values.push(v);
        } else {
          var val = parseInt(part);
          if (isNaN(val)) return null;
          if (step > 1) {
            for (var v = val; v <= max; v += step) values.push(v);
          } else {
            values.push(val);
          }
        }
      }

      for (var i = 0; i < values.length; i++) {
        if (values[i] < min || values[i] > max) return null;
      }

      return values.length > 0 ? values : null;
    }

    function parseCron(expr) {
      var parts = expr.trim().split(/\s+/);
      if (parts.length !== 5) return null;

      var minutes = parseCronField(parts[0], 0, 59);
      var hours = parseCronField(parts[1], 0, 23);
      var days = parseCronField(parts[2], 1, 31);
      var months = parseCronField(parts[3], 1, 12);
      var weekdays = parseCronField(parts[4], 0, 7);

      if (!minutes || !hours || !days || !months || !weekdays) return null;

      weekdays = weekdays.map(function (d) {
        return d === 7 ? 0 : d;
      });
      weekdays = Array.from(new Set(weekdays)).sort(function (a, b) {
        return a - b;
      });

      return {
        minutes: minutes,
        hours: hours,
        days: days,
        months: months,
        weekdays: weekdays,
        raw: parts,
      };
    }

    /* ── Next executions ── */
    function getNextExecutions(cron, count) {
      var results = [];
      var date = new Date();
      date.setSeconds(0, 0);
      date.setMinutes(date.getMinutes() + 1);

      var allDays = cron.raw[2] === "*";
      var allWeekdays = cron.raw[4] === "*";
      var maxIterations = 525960;

      for (
        var iter = 0;
        iter < maxIterations && results.length < count;
        iter++
      ) {
        var month = date.getMonth() + 1;
        var day = date.getDate();
        var weekday = date.getDay();
        var hour = date.getHours();
        var minute = date.getMinutes();

        var monthMatch = cron.months.indexOf(month) !== -1;
        var minuteMatch = cron.minutes.indexOf(minute) !== -1;
        var hourMatch = cron.hours.indexOf(hour) !== -1;

        var dayMatch;
        if (allDays && allWeekdays) {
          dayMatch = true;
        } else if (allDays) {
          dayMatch = cron.weekdays.indexOf(weekday) !== -1;
        } else if (allWeekdays) {
          dayMatch = cron.days.indexOf(day) !== -1;
        } else {
          dayMatch =
            cron.days.indexOf(day) !== -1 ||
            cron.weekdays.indexOf(weekday) !== -1;
        }

        if (monthMatch && dayMatch && hourMatch && minuteMatch) {
          results.push(new Date(date));
        }

        date.setMinutes(date.getMinutes() + 1);
      }

      return results;
    }

    /* ── Human-readable description ── */
    function toHumanReadable(cron) {
      var p = cron.raw;

      if (p.join(" ") === "* * * * *") return i18n.everyMinute;

      var desc = [];

      /* Time part */
      if (p[0].indexOf("/") !== -1 && p[1] === "*" && p[0].charAt(0) === "*") {
        desc.push(i18n.descEveryNMinutes.replace("{n}", p[0].slice(2)));
      } else if (
        p[1].indexOf("/") !== -1 &&
        p[0] === "0" &&
        p[1].charAt(0) === "*"
      ) {
        desc.push(i18n.descEveryNHours.replace("{n}", p[1].slice(2)));
      } else if (p[0] === "0" && p[1] === "0") {
        desc.push(i18n.descAtMidnight);
      } else if (p[1] !== "*" && p[0] !== "*") {
        var times = [];
        cron.hours.forEach(function (h) {
          cron.minutes.forEach(function (m) {
            times.push(
              String(h).padStart(2, "0") + ":" + String(m).padStart(2, "0"),
            );
          });
        });
        if (times.length <= 6) {
          desc.push(i18n.descAtTimes.replace("{times}", times.join(", ")));
        } else {
          desc.push(tpl(i18n.descAtMinuteOfHour, { min: p[0], hour: p[1] }));
        }
      } else if (p[1] !== "*" && p[0] === "*") {
        desc.push(i18n.descEveryMinuteDuringHour.replace("{hour}", p[1]));
      } else if (p[0] !== "*") {
        desc.push(i18n.descAtMinuteOfEveryHour.replace("{min}", p[0]));
      } else {
        desc.push(i18n.everyMinute);
      }

      /* Day of month */
      if (p[2] !== "*") {
        var dayList = cron.days.join(", ");
        desc.push(i18n.descOnDayOfMonth.replace("{days}", dayList));
      }

      /* Month */
      if (p[3] !== "*") {
        var mNames = cron.months.map(function (m) {
          return monthNames[m];
        });
        desc.push(i18n.descriptionIn + " " + mNames.join(", "));
      }

      /* Weekday */
      if (p[4] !== "*") {
        var dNames = cron.weekdays.map(function (d) {
          return dayNames[d];
        });
        if (p[4] === "1-5") {
          desc.push(i18n.descOnWeekdays);
        } else if (p[4] === "0,6") {
          desc.push(i18n.descOnWeekends);
        } else {
          desc.push(i18n.descriptionOn + " " + dNames.join(", "));
        }
      }

      return desc.join(", ") || i18n.customSchedule;
    }

    /* ── Visual selectors: read from expression ── */
    function syncSelectorsFromExpr() {
      if (syncing) return;
      syncing = true;

      var expr = exprInput.value.trim();
      var cron = parseCron(expr);

      fieldDefs.forEach(function (fDef) {
        var group = container.querySelector(
          '.cron-field-group[data-field="' + fDef.id + '"]',
        );
        if (!group) return;
        var btns = group.querySelectorAll(".cron-val-btn");
        var parts = expr.split(/\s+/);
        var fieldStr = parts[fDef.idx] || "*";
        var vals = cron
          ? fDef.idx === 0
            ? cron.minutes
            : fDef.idx === 1
              ? cron.hours
              : fDef.idx === 2
                ? cron.days
                : fDef.idx === 3
                  ? cron.months
                  : cron.weekdays
          : null;

        btns.forEach(function (btn) {
          var v = parseInt(btn.dataset.val);
          var active = vals ? vals.indexOf(v) !== -1 : false;
          /* Mark all values active when field is wildcard */
          if (fieldStr === "*") active = true;
          btn.classList.toggle("active", active);
          btn.setAttribute("aria-pressed", String(active));
        });
      });

      syncing = false;
    }

    /* ── Visual selectors: write to expression ── */
    function buildFieldString(fieldId) {
      var fDef = fieldDefs.find(function (f) {
        return f.id === fieldId;
      });
      if (!fDef) return "*";
      var group = container.querySelector(
        '.cron-field-group[data-field="' + fieldId + '"]',
      );
      if (!group) return "*";

      var btns = group.querySelectorAll(".cron-val-btn");
      var selected = [];
      btns.forEach(function (btn) {
        if (btn.classList.contains("active")) {
          selected.push(parseInt(btn.dataset.val));
        }
      });

      if (selected.length === 0) return "*";

      var totalValues = fDef.max - fDef.min + 1;
      if (selected.length === totalValues) return "*";

      /* Try to detect step patterns */
      if (selected.length > 1) {
        var step = selected[1] - selected[0];
        if (step > 1) {
          var isStep = true;
          for (var i = 2; i < selected.length; i++) {
            if (selected[i] - selected[i - 1] !== step) {
              isStep = false;
              break;
            }
          }
          if (isStep && selected[0] === fDef.min) {
            return "*/" + step;
          }
        }
      }

      /* Detect range */
      var isConsecutive = true;
      for (var i = 1; i < selected.length; i++) {
        if (selected[i] - selected[i - 1] !== 1) {
          isConsecutive = false;
          break;
        }
      }
      if (isConsecutive && selected.length > 2) {
        return selected[0] + "-" + selected[selected.length - 1];
      }

      return selected.join(",");
    }

    function syncExprFromSelectors() {
      if (syncing) return;
      syncing = true;

      var parts = fieldDefs.map(function (f) {
        return buildFieldString(f.id);
      });
      exprInput.value = parts.join(" ");

      update();
      syncing = false;
    }

    /* ── Core update ── */
    function update() {
      if (errorEl) errorEl.hidden = true;

      var expr = exprInput.value.trim();
      if (!expr) {
        if (humanEl) humanEl.textContent = i18n.enterExpression;
        if (nextList) nextList.textContent = "";
        return;
      }

      var cron = parseCron(expr);
      if (!cron) {
        if (errorEl && errorText) {
          errorText.textContent = i18n.invalidExpressionFormat;
          errorEl.hidden = false;
        }
        if (humanEl) humanEl.textContent = i18n.invalidExpressionShort;
        if (nextList) nextList.textContent = "";
        return;
      }

      /* Human-readable */
      if (humanEl) humanEl.textContent = toHumanReadable(cron);

      /* Crontab line */
      if (crontabExpr) crontabExpr.textContent = expr;

      /* Sync selectors */
      syncSelectorsFromExpr();

      /* URL */
      var encoded = expr.replace(/ /g, "+");
      history.replaceState(
        null,
        "",
        window.location.pathname + "?expr=" + encoded,
      );

      /* Next executions */
      if (nextList) {
        nextList.textContent = "";
        var executions = getNextExecutions(cron, 10);

        if (executions.length === 0) {
          nextList.textContent = i18n.noExecutions;
          return;
        }

        executions.forEach(function (date, idx) {
          var item = document.createElement("div");
          item.className = "cron-next-item";

          var num = document.createElement("span");
          num.className = "cron-next-num";
          num.textContent = "#" + (idx + 1);

          var dateStr = document.createElement("span");
          dateStr.className = "cron-next-date";
          var options = {
            weekday: "short",
            year: "numeric",
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            hour12: false,
          };
          dateStr.textContent = date.toLocaleDateString(undefined, options);

          var relative = document.createElement("span");
          relative.className = "cron-next-relative";
          var diff = date - new Date();
          var mins = Math.floor(diff / 60000);
          var hrs = Math.floor(mins / 60);
          var daysD = Math.floor(hrs / 24);

          if (daysD > 0) {
            relative.textContent = tpl(i18n.relativeInDH, {
              d: daysD,
              h: hrs % 24,
            });
          } else if (hrs > 0) {
            relative.textContent = tpl(i18n.relativeInHM, {
              h: hrs,
              m: mins % 60,
            });
          } else {
            relative.textContent = i18n.relativeInM.replace("{m}", mins);
          }

          item.appendChild(num);
          item.appendChild(dateStr);
          item.appendChild(relative);
          nextList.appendChild(item);
        });
      }
    }

    /* ── Event: visual selector clicks ── */
    fieldGroups.forEach(function (group) {
      var grid = group.querySelector(".cron-value-grid");
      var quickBtns = group.querySelectorAll(".cron-quick-btn");

      if (grid) {
        grid.addEventListener("click", function (e) {
          var btn = e.target.closest(".cron-val-btn");
          if (!btn) return;
          btn.classList.toggle("active");
          btn.setAttribute(
            "aria-pressed",
            String(btn.classList.contains("active")),
          );
          syncExprFromSelectors();
        });
      }

      quickBtns.forEach(function (qBtn) {
        qBtn.addEventListener("click", function () {
          var action = qBtn.dataset.action;
          var btns = group.querySelectorAll(".cron-val-btn");
          if (action === "every") {
            btns.forEach(function (b) {
              b.classList.add("active");
              b.setAttribute("aria-pressed", "true");
            });
          } else if (action === "clear") {
            btns.forEach(function (b) {
              b.classList.remove("active");
              b.setAttribute("aria-pressed", "false");
            });
          }
          syncExprFromSelectors();
        });
      });
    });

    /* ── Event: presets ── */
    presetBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        exprInput.value = btn.dataset.value;
        update();
      });
    });

    /* ── Event: manual expr input ── */
    var inputTimeout;
    exprInput.addEventListener("input", function () {
      clearTimeout(inputTimeout);
      inputTimeout = setTimeout(function () {
        update();
      }, 200);
    });

    /* ── Event: copy expression ── */
    if (copyExprBtn) {
      copyExprBtn.addEventListener("click", function () {
        if (navigator.clipboard) {
          navigator.clipboard
            .writeText(exprInput.value.trim())
            .then(function () {
              copyExprBtn.classList.add("copied");
              setTimeout(function () {
                copyExprBtn.classList.remove("copied");
              }, 1500);
            })
            .catch(function () {});
        }
      });
    }

    /* ── Event: copy crontab line ── */
    if (copyLineBtn) {
      copyLineBtn.addEventListener("click", function () {
        if (navigator.clipboard && crontabCmd) {
          var line = exprInput.value.trim() + " " + crontabCmd.value.trim();
          navigator.clipboard
            .writeText(line)
            .then(function () {
              copyLineBtn.classList.add("copied");
              setTimeout(function () {
                copyLineBtn.classList.remove("copied");
              }, 1500);
            })
            .catch(function () {});
        }
      });
    }

    /* ── Event: share ── */
    if (shareBtn) {
      shareBtn.addEventListener("click", function () {
        if (navigator.clipboard) {
          navigator.clipboard
            .writeText(window.location.href)
            .then(function () {
              shareBtn.classList.add("copied");
              if (shareText) shareText.textContent = i18n.copied;
              setTimeout(function () {
                shareBtn.classList.remove("copied");
                if (shareText) shareText.textContent = i18n.shareLink;
              }, 1500);
            })
            .catch(function () {});
        }
      });
    }

    /* ── Init from URL ── */
    var params = new URLSearchParams(window.location.search);
    var urlExpr = params.get("expr");
    if (urlExpr) {
      exprInput.value = urlExpr.replace(/\+/g, " ");
    }

    update();
  })();
</script>

