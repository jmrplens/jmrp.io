    display: flex;
    gap: 0.375rem;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    cursor: pointer;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: all 0.15s;
  }

  .mbus-mode-btn span {
    width: 16px;
