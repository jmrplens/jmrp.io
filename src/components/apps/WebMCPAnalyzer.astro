    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .wma-url-input:focus {
    outline: 2px solid rgb(179 137 245 / 30%);
    outline-offset: 1px;
    border-color: var(--color-primary);
