  }

  .wma-extra-pages {
    flex-basis: 100%;
  }

  .wma-pages-input {
    width: 100%;
    padding: 0.5rem 0.75rem;
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .wma-pages-input:focus {
    outline: 2px solid rgb(179 137 245 / 30%);
    outline-offset: 1px;
    border-color: var(--color-primary);
  }

  /* ── Progress ── */
  .wma-progress {
    margin-bottom: var(--space-lg);
  }

  .wma-progress-bar {
    height: 6px;
    margin-bottom: var(--space-xs);
    overflow: hidden;
    background: var(--color-bg-subtle);
    border-radius: 3px;
  }

  .wma-progress-fill {
    width: 0;
    height: 100%;
    background: var(--color-primary);
    border-radius: 3px;
    transition: width 0.3s ease;
  }

  .wma-progress-text {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* ── Error ── */
  .wma-error {
    padding: var(--space-md);
    margin-bottom: var(--space-lg);
    font-size: 0.9rem;
    color: var(--color-error, #ef4444);
    background: rgb(239 68 68 / 10%);
    border: 1px solid rgb(239 68 68 / 30%);
    border-radius: var(--radius-md);
  }

  /* ── Score Panel ── */
  .wma-score-panel {
    display: flex;
    gap: var(--space-lg);
    align-items: center;
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-lg);
  }

  .wma-score-circle {
    position: relative;
    flex-shrink: 0;
    width: 120px;
    height: 120px;
  }

  .wma-score-svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .wma-score-bg {
    fill: none;
    stroke: var(--color-bg-subtle);
    stroke-width: 8;
  }

  .wma-score-ring {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 8;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.5s ease;
  }

  .wma-score-value {
    position: absolute;
    top: 50%;
    left: 50%;
    font-size: 2rem;
    font-weight: var(--fw-extrabold);
    color: var(--color-text-heading);
    transform: translate(-50%, -50%);
  }

  .wma-score-details {
    flex: 1;
  }

  .wma-score-label {
    font-size: 1.1rem;
    font-weight: var(--fw-bold);
    color: var(--color-text-heading);
  }

  .wma-impl-type {
    margin-top: var(--space-xs);
    margin-bottom: var(--space-sm);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .wma-score-counts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .wma-score-counts span {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    font-size: 0.85rem;
  }

  .wma-count-pass {
    color: var(--color-success, #10b981);
  }

  .wma-count-warn {
    color: var(--color-warning, #f59e0b);
  }

  .wma-count-err {
    color: var(--color-error, #ef4444);
  }

  .wma-count-info {
    color: var(--color-info, #3b82f6);
  }

  .wma-score-counts span[class*="i-"] {
    width: 1rem;
    height: 1rem;
  }

  /* ── Actions Bar ── */
  .wma-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .wma-actions button {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    padding: 0.5rem 0.875rem;
    font-size: 0.85rem;
    font-weight: var(--fw-medium);
    color: var(--color-text);
    cursor: pointer;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
    transition: border-color 0.2s;
  }

  .wma-actions button:hover {
    border-color: var(--color-primary);
  }

  .wma-actions button span[class*="i-"] {
    width: 1rem;
    height: 1rem;
  }

  /* ── Manifest Viewer ── */
  .wma-manifest-viewer {
    margin-bottom: var(--space-lg);
  }

  .wma-manifest-pre {
    max-height: 400px;
    padding: var(--space-md);
    overflow: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  /* ── Checks Section ── */
  .wma-section-title {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    margin-bottom: var(--space-md);
    font-size: 1rem;
    font-weight: var(--fw-bold);
    color: var(--color-text-heading);
  }

  .wma-section-title span[class*="i-"] {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--color-primary);
  }

  .wma-cat-section {
    padding: var(--space-md);
    margin-bottom: var(--space-md);
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .wma-cat-header {
    display: flex;
    gap: var(--space-sm);
    justify-content: space-between;
    margin-bottom: var(--space-xs);
  }

  .wma-cat-name {
    font-size: 0.9rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .wma-cat-score {
    font-size: 0.8rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
  }

  .wma-cat-bar {
    height: 4px;
    margin-bottom: var(--space-sm);
    overflow: hidden;
    background: var(--color-bg-subtle);
    border-radius: 2px;
  }

  .wma-cat-fill {
    height: 100%;
    border-radius: 2px;
    transition: width 0.4s ease;
  }

  .wma-fill-pass {
    background: var(--color-success, #10b981);
  }

  .wma-fill-warn {
    background: var(--color-warning, #f59e0b);
  }

  .wma-fill-err {
    background: var(--color-error, #ef4444);
  }

  /* Width classes (CSP-safe alternative to inline styles) */
  .wma-w-0 {
    width: 0%;
  }

  .wma-w-5 {
    width: 5%;
  }

  .wma-w-10 {
    width: 10%;
  }

