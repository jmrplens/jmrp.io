    border-radius: var(--radius-md);
    transition: background 0.2s;
  }

  .wma-analyze-btn:hover:not(:disabled) {
    background: var(--color-primary-hover);
  }

  .wma-analyze-btn:disabled {
    cursor: not-allowed;
    opacity: 70%;
  }

  .wma-analyze-btn span[class*="i-"] {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* Options */
  .wma-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .wma-checkbox {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    font-size: 0.85rem;
    color: var(--color-text);
    cursor: pointer;
  }

  .wma-checkbox input[type="checkbox"] {
    accent-color: var(--color-primary);
  }

  .wma-hint {
    font-size: 0.75rem;
