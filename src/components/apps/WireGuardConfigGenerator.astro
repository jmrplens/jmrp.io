  }

  details.wg-card:not([open]) > .wg-card-header {
    border-bottom: none;
  }

  /* Fields: :global() needed because peers are dynamically created via innerHTML */
  .wg-card-body :global(.wg-fields-row) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.5rem;
  }

