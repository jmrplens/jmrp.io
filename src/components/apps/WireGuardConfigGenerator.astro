  .wg-card-body :global(.wg-select:focus) {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    border-color: var(--color-primary);
  }

  .wg-card-body :global(.wg-field-hint) {
    font-size: var(--text-2xs);
