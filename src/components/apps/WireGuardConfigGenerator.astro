---
/* eslint-disable sonarjs/no-hardcoded-ip -- Default IPs are essential for a VPN config builder */
/**
 * WireGuardConfigGenerator Component
 * Interactive MikroTik WireGuard VPN configuration builder.
 * Generates complete RouterOS scripts and client .conf files
 * based on user-defined parameters.
 *
 * Usage:
 * <WireGuardConfigGenerator title="WireGuard Config Generator" />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

interface Props {
  title?: string;
}

const { title = t("tools.wireguardConfigGenerator.title") } = Astro.props;
const uniqueId = `wg-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

/** Translations passed to the inline script via define:vars. */
const i18n = {
  // Shared
  copy: t("tools.shared.copy"),
  copied: t("tools.shared.copied"),
  // Peer labels & defaults
  peerLabel: t("tools.wireguardConfigGenerator.peerLabel"),
  peerDefaultName: t("tools.wireguardConfigGenerator.peerDefaultName"),
  labelName: t("tools.wireguardConfigGenerator.labelName"),
  labelPeerComment: t("tools.wireguardConfigGenerator.labelPeerComment"),
  placeholderClientDescription: t(
    "tools.wireguardConfigGenerator.placeholderClientDescription",
  ),
  labelIpv4Address: t("tools.wireguardConfigGenerator.labelIpv4Address"),
  labelIpv6Address: t("tools.wireguardConfigGenerator.labelIpv6Address"),
  labelKeepalive: t("tools.wireguardConfigGenerator.labelKeepalive"),
  labelKeyGeneration: t("tools.wireguardConfigGenerator.labelKeyGeneration"),
  optRouterosAuto: t("tools.wireguardConfigGenerator.optRouterosAuto"),
  optManualKeys: t("tools.wireguardConfigGenerator.optManualKeys"),
  labelPrivateKey: t("tools.wireguardConfigGenerator.labelPrivateKey"),
  placeholderPrivateKey: t(
    "tools.wireguardConfigGenerator.placeholderPrivateKey",
  ),
  generatePrivateKeyAriaLabel: t(
    "tools.wireguardConfigGenerator.generatePrivateKeyAriaLabel",
  ),
  labelPublicKey: t("tools.wireguardConfigGenerator.labelPublicKey"),
  placeholderPublicKey: t(
    "tools.wireguardConfigGenerator.placeholderPublicKey",
  ),
  labelPresharedKey: t("tools.wireguardConfigGenerator.labelPresharedKey"),
  hintPresharedKeyOptional: t(
    "tools.wireguardConfigGenerator.hintPresharedKeyOptional",
  ),
  placeholderPresharedKey: t(
    "tools.wireguardConfigGenerator.placeholderPresharedKey",
  ),
  generatePresharedKeyAriaLabel: t(
    "tools.wireguardConfigGenerator.generatePresharedKeyAriaLabel",
  ),
  removePeerAriaLabel: t("tools.wireguardConfigGenerator.removePeerAriaLabel"),
  // Default comments
  commentPhoneMobile: t("tools.wireguardConfigGenerator.commentPhoneMobile"),
  commentLaptopMobile: t("tools.wireguardConfigGenerator.commentLaptopMobile"),
  commentTabletMobile: t("tools.wireguardConfigGenerator.commentTabletMobile"),
  commentDesktopVpn: t("tools.wireguardConfigGenerator.commentDesktopVpn"),
  commentRemoteSite: t("tools.wireguardConfigGenerator.commentRemoteSite"),
  // Client config output
  keysAutoGenerated: t("tools.wireguardConfigGenerator.keysAutoGenerated"),
  retrieveWith: t("tools.wireguardConfigGenerator.retrieveWith"),
  orScanQr: t("tools.wireguardConfigGenerator.orScanQr"),
  retrieveKeysForManual: t(
    "tools.wireguardConfigGenerator.retrieveKeysForManual",
  ),
  serverPublicKey: t("tools.wireguardConfigGenerator.serverPublicKey"),
  // RouterOS header and MTU comments
  headerRouterosVersion: t(
    "tools.wireguardConfigGenerator.headerRouterosVersion",
  ),
  headerClientMtuVersion: t(
    "tools.wireguardConfigGenerator.headerClientMtuVersion",
  ),
  mtuCommentAuto: t("tools.wireguardConfigGenerator.mtuCommentAuto"),
  mtuCommentManual: t("tools.wireguardConfigGenerator.mtuCommentManual"),
  mtuFamilyIpv4: t("tools.wireguardConfigGenerator.mtuFamilyIpv4"),
  mtuFamilyDual: t("tools.wireguardConfigGenerator.mtuFamilyDual"),
  confMtuComment: t("tools.wireguardConfigGenerator.confMtuComment"),
  // MTU warnings
  warnIpv6MinMtu: t("tools.wireguardConfigGenerator.warnIpv6MinMtu"),
  warnTunnelMtuTooLarge: t(
    "tools.wireguardConfigGenerator.warnTunnelMtuTooLarge",
  ),
  warnClientMtuTooLarge: t(
    "tools.wireguardConfigGenerator.warnClientMtuTooLarge",
  ),
};
---

<div
  class="wg-generator"
  data-wg-id={uniqueId}
>
  {title && <div class="wg-title">{title}</div>}

  <div class="wg-layout">
    {/* ── Presets ── */}
    <div class="wg-presets-bar">
      <span class="wg-presets-label">
        <span
          class="i-mdi:lightning-bolt"
          aria-hidden="true"
        ></span>
        {t("tools.wireguardConfigGenerator.presetLabel")}
      </span>
      <div class="wg-presets">
        <button
          type="button"
          class="wg-preset-btn"
          data-preset="ipv4-only"
        >
          {t("tools.wireguardConfigGenerator.presetIpv4Only")}
        </button>
        <button
          type="button"
          class="wg-preset-btn wg-preset-active"
          data-preset="dual-stack"
        >
          {t("tools.wireguardConfigGenerator.presetDualStack")}
        </button>
        <button
          type="button"
          class="wg-preset-btn"
          data-preset="site-to-site"
        >
          {t("tools.wireguardConfigGenerator.presetSiteToSite")}
        </button>
      </div>
    </div>

    {/* ── Interface Settings ── */}
    <div class="wg-card">
      <div class="wg-card-header">
        <span
          class="i-mdi:vpn"
          aria-hidden="true"
        ></span>
        {t("tools.wireguardConfigGenerator.sectionInterface")}
      </div>
      <div class="wg-card-body">
        <div class="wg-fields-row">
          <div class="wg-field">
            <label
              class="wg-label"
              for={`${uniqueId}-iface-name`}
            >
              {t("tools.wireguardConfigGenerator.labelInterfaceName")}
            </label>
            <input
              id={`${uniqueId}-iface-name`}
              class="wg-input"
              type="text"
              value="wg_devices"
              placeholder="wg_devices"
            />
          </div>
          <div class="wg-field">
            <label
              class="wg-label"
              for={`${uniqueId}-listen-port`}
            >
              {t("tools.wireguardConfigGenerator.labelListenPort")}
            </label>
            <input
              id={`${uniqueId}-listen-port`}
              class="wg-input"
              type="number"
              value="53537"
              min="1"
              max="65535"
            />
          </div>
        </div>
        <div class="wg-field">
          <label
            class="wg-label"
            for={`${uniqueId}-iface-comment`}
          >
            {t("tools.wireguardConfigGenerator.labelComment")}
          </label>
          <input
            id={`${uniqueId}-iface-comment`}
            class="wg-input"
            type="text"
            value="VPN for Mobile Devices"
            placeholder="VPN for Mobile Devices"
          />
        </div>
      </div>
    </div>

    {/* ── Network Settings ── */}
    <div class="wg-card">
      <div class="wg-card-header">
        <span
          class="i-mdi:ip-network"
          aria-hidden="true"
        ></span>
        {t("tools.wireguardConfigGenerator.sectionNetwork")}
      </div>
      <div class="wg-card-body">
        <div class="wg-fields-row">
          <div class="wg-field">
            <label
              class="wg-label"
              for={`${uniqueId}-vpn-subnet`}
            >
              {t("tools.wireguardConfigGenerator.labelVpnIpv4Subnet")}
            </label>
            <input
              id={`${uniqueId}-vpn-subnet`}
              class="wg-input"
              type="text"
              value="192.168.100.0/24"
              placeholder="192.168.100.0/24"
            />
            <span class="wg-field-hint">
              {t("tools.wireguardConfigGenerator.hintGatewayV4")}
            </span>
          </div>
          <div class="wg-field">
            <label
              class="wg-label"
              for={`${uniqueId}-lan-subnet`}
            >
              {t("tools.wireguardConfigGenerator.labelHomeLanSubnet")}
            </label>
            <input
              id={`${uniqueId}-lan-subnet`}
              class="wg-input"
              type="text"
              value="192.168.0.0/24"
              placeholder="192.168.0.0/24"
            />
          </div>
        </div>
        <div class="wg-toggle-row wg-main-toggle">
          <label class="wg-toggle-label">
            <input
              id={`${uniqueId}-enable-ipv6`}
              type="checkbox"
              checked
            />
            <span>{t("tools.wireguardConfigGenerator.toggleEnableIpv6")}</span>
          </label>
        </div>
        <div
          class="wg-sub-fields"
          id={`${uniqueId}-ipv6-fields`}
        >
          <div class="wg-field">
            <label
              class="wg-label"
              for={`${uniqueId}-vpn-ipv6`}
            >
              {t("tools.wireguardConfigGenerator.labelVpnIpv6Prefix")}
            </label>
            <input
              id={`${uniqueId}-vpn-ipv6`}
              class="wg-input"
              type="text"
              value="fd00:1111:2222:100::/64"
              placeholder="fd00:1111:2222:100::/64"
            />
            <span class="wg-field-hint">
              {t("tools.wireguardConfigGenerator.hintGatewayV6")}
            </span>
          </div>
        </div>
        <div class="wg-toggle-row">
          <label class="wg-toggle-label">
            <input
              id={`${uniqueId}-enable-extra-lans`}
              type="checkbox"
            />
            <span>
              {t("tools.wireguardConfigGenerator.toggleAdditionalLans")}
            </span>
          </label>
        </div>
        <div
          class="wg-sub-fields"
          id={`${uniqueId}-extra-lans-fields`}
          hidden
        >
          <div class="wg-field">
            <label
              class="wg-label"
              for={`${uniqueId}-extra-lans`}
            >
              {t("tools.wireguardConfigGenerator.labelSubnets")}
            </label>
            <input
              id={`${uniqueId}-extra-lans`}
              class="wg-input"
              type="text"
              value=""
              placeholder={t(
                "tools.wireguardConfigGenerator.placeholderExtraLans",
              )}
            />
            <span class="wg-field-hint">
              {t("tools.wireguardConfigGenerator.hintExtraSubnets")}
            </span>
          </div>
        </div>
      </div>
    </div>

    {/* ── Endpoint & DNS ── */}
    <div class="wg-card">
      <div class="wg-card-header">
        <span
          class="i-mdi:dns"
          aria-hidden="true"
        ></span>
        {t("tools.wireguardConfigGenerator.sectionEndpointDns")}
      </div>
      <div class="wg-card-body">
        <div class="wg-fields-row">
          <div class="wg-field">
            <label
              class="wg-label"
              for={`${uniqueId}-endpoint`}
            >
              {t("tools.wireguardConfigGenerator.labelPublicEndpoint")}
            </label>
            <input
              id={`${uniqueId}-endpoint`}
              class="wg-input"
              type="text"
              value=""
              placeholder={t(
                "tools.wireguardConfigGenerator.placeholderEndpoint",
              )}
            />
            <span class="wg-field-hint">
              {t("tools.wireguardConfigGenerator.hintEndpoint")}
            </span>
          </div>
          <div class="wg-field">
            <label
              class="wg-label"
              for={`${uniqueId}-dns`}
            >
              {t("tools.wireguardConfigGenerator.labelDnsServers")}
            </label>
            <input
              id={`${uniqueId}-dns`}
              class="wg-input"
              type="text"
              value=""
              placeholder={t("tools.wireguardConfigGenerator.placeholderDns")}
            />
            <span class="wg-field-hint">
              {t("tools.wireguardConfigGenerator.hintDns")}
            </span>
          </div>
        </div>
      </div>
    </div>

    {/* ── Advanced Configuration Toggle ── */}
    <div class="wg-toggle-row wg-main-toggle">
      <label class="wg-toggle-label">
        <input
          id={`${uniqueId}-advanced`}
          type="checkbox"
        />
        <span>{t("tools.wireguardConfigGenerator.toggleAdvanced")}</span>
      </label>
    </div>

    <div
      id={`${uniqueId}-advanced-section`}
      hidden
    >
      {/* ── MTU ── */}
      <div
        class="wg-card"
        style="margin-bottom: 1rem;"
      >
        <div class="wg-card-header">
          <span
            class="i-mdi:resize"
            aria-hidden="true"
          ></span>
          {t("tools.wireguardConfigGenerator.sectionMtu")}
        </div>
        <div class="wg-card-body">
          <div class="wg-fields-row">
            <div class="wg-field">
              <label
                class="wg-label"
                for={`${uniqueId}-wan-mtu`}
              >
                {t("tools.wireguardConfigGenerator.labelWanMtu")}
              </label>
              <input
                id={`${uniqueId}-wan-mtu`}
                class="wg-input"
                type="number"
                value="1500"
                min="1280"
                max="9000"
                aria-describedby={`${uniqueId}-wan-mtu-hint`}
              />
              <span
                class="wg-field-hint"
                id={`${uniqueId}-wan-mtu-hint`}
              >
                {t("tools.wireguardConfigGenerator.hintWanMtu")}
              </span>
            </div>
            <div class="wg-field">
              <label
                class="wg-label"
                for={`${uniqueId}-endpoint-family`}
              >
                {t("tools.wireguardConfigGenerator.labelEndpointFamily")}
              </label>
              <select
                id={`${uniqueId}-endpoint-family`}
                class="wg-select"
                aria-describedby={`${uniqueId}-endpoint-family-hint`}
              >
                <option value="ipv4">
                  {t("tools.wireguardConfigGenerator.optEndpointIpv4")}
                </option>
                <option
                  value="dual"
                  selected
                >
                  {t("tools.wireguardConfigGenerator.optEndpointDual")}
                </option>
              </select>
              <span
                class="wg-field-hint"
                id={`${uniqueId}-endpoint-family-hint`}
              >
                {t("tools.wireguardConfigGenerator.hintEndpointFamily")}
              </span>
            </div>
          </div>
          <div class="wg-fields-row">
            <div class="wg-field">
              <label
                class="wg-label"
                for={`${uniqueId}-mtu`}
              >
                {t("tools.wireguardConfigGenerator.labelTunnelMtu")}
              </label>
              <input
                id={`${uniqueId}-mtu`}
                class="wg-input"
                type="number"
                value="1420"
                min="576"
                max="9000"
                aria-describedby={`${uniqueId}-mtu-hint`}
              />
              <span
                class="wg-field-hint"
                id={`${uniqueId}-mtu-hint`}
              >
                {t("tools.wireguardConfigGenerator.hintTunnelMtu")}
              </span>
            </div>
            <div class="wg-field">
              <label
                class="wg-label"
                for={`${uniqueId}-client-mtu`}
              >
                {t("tools.wireguardConfigGenerator.labelClientMtu")}
              </label>
              <input
                id={`${uniqueId}-client-mtu`}
                class="wg-input"
                type="number"
                value="1420"
                min="576"
                max="9000"
                aria-describedby={`${uniqueId}-client-mtu-hint`}
              />
              <span
                class="wg-field-hint"
                id={`${uniqueId}-client-mtu-hint`}
              >
                {t("tools.wireguardConfigGenerator.hintClientMtu")}
              </span>
            </div>
          </div>
          <div class="wg-field">
            <label class="wg-toggle-label">
              <input
                id={`${uniqueId}-ros725`}
                type="checkbox"
                checked
                aria-describedby={`${uniqueId}-ros725-hint`}
              />
              <span>{t("tools.wireguardConfigGenerator.toggleRos725")}</span>
            </label>
            <span
              class="wg-field-hint"
              id={`${uniqueId}-ros725-hint`}
            >
              {t("tools.wireguardConfigGenerator.hintRos725")}
            </span>
          </div>
          {/* The status region stays in the accessibility tree so a warning
               is announced when it appears; only the box inside is hidden. */}
          <div
            class="wg-mtu-status"
            role="status"
            aria-live="polite"
          >
            <div
              class="wg-mtu-warning"
              id={`${uniqueId}-mtu-warning`}
              hidden
            >
              <span
                class="i-mdi:alert-outline"
                aria-hidden="true"
              ></span>
              <span id={`${uniqueId}-mtu-warning-text`}></span>
            </div>
          </div>
        </div>
      </div>

      {/* ── Interface Lists ── */}
      <details
        class="wg-card"
        style="margin-bottom: 1rem;"
      >
        <summary class="wg-card-header wg-summary">
          <span
            class="i-mdi:format-list-group"
            aria-hidden="true"
          ></span>
          {t("tools.wireguardConfigGenerator.sectionInterfaceLists")}
          <span
            class="i-mdi:chevron-right wg-chevron"
            aria-hidden="true"
          ></span>
        </summary>
        <div class="wg-card-body">
          <div class="wg-fields-row">
            <div class="wg-field">
              <label
                class="wg-label"
                for={`${uniqueId}-wan-list`}
              >
                {t("tools.wireguardConfigGenerator.labelWanList")}
              </label>
              <input
                id={`${uniqueId}-wan-list`}
                class="wg-input"
                type="text"
                value="WAN"
                placeholder="WAN"
              />
            </div>
            <div class="wg-field">
              <label
                class="wg-label"
                for={`${uniqueId}-vpn-list`}
              >
                {t("tools.wireguardConfigGenerator.labelVpnList")}
              </label>
              <input
                id={`${uniqueId}-vpn-list`}
                class="wg-input"
                type="text"
                value="VPN"
                placeholder="VPN"
              />
            </div>
            <div class="wg-field">
              <label
                class="wg-label"
                for={`${uniqueId}-lan-list`}
              >
                {t("tools.wireguardConfigGenerator.labelLanList")}
              </label>
              <input
                id={`${uniqueId}-lan-list`}
                class="wg-input"
                type="text"
                value="LAN"
                placeholder="LAN"
              />
            </div>
          </div>
          <div class="wg-toggle-row">
            <label class="wg-toggle-label">
              <input
                id={`${uniqueId}-add-to-lan`}
                type="checkbox"
                checked
              />
              <span>{t("tools.wireguardConfigGenerator.toggleAddToLan")}</span>
            </label>
          </div>
        </div>
      </details>

      {/* ── Firewall Options ── */}
      <details
        class="wg-card"
        open
      >
        <summary class="wg-card-header wg-summary">
          <span
            class="i-mdi:shield-lock"
            aria-hidden="true"
          ></span>
          {t("tools.wireguardConfigGenerator.sectionFirewallNat")}
          <span
            class="i-mdi:chevron-right wg-chevron"
            aria-hidden="true"
          ></span>
        </summary>
        <div class="wg-card-body">
          <div class="wg-toggles-row">
            <label class="wg-toggle-label">
              <input
                id={`${uniqueId}-fw-internet`}
                type="checkbox"
                checked
              />
              <span>
                {t("tools.wireguardConfigGenerator.toggleAllowVpnInternet")}
              </span>
            </label>
            <label class="wg-toggle-label">
              <input
                id={`${uniqueId}-fw-lan`}
                type="checkbox"
                checked
              />
              <span>
                {t("tools.wireguardConfigGenerator.toggleAllowVpnLan")}
              </span>
            </label>
            <label class="wg-toggle-label">
              <input
                id={`${uniqueId}-fw-fasttrack`}
                type="checkbox"
                checked
              />
              <span>{t("tools.wireguardConfigGenerator.toggleFastTrack")}</span>
            </label>
            <label class="wg-toggle-label">
              <input
                id={`${uniqueId}-fw-addrlist`}
                type="checkbox"
                checked
              />
              <span>
                {t("tools.wireguardConfigGenerator.toggleAddressList")}
              </span>
            </label>
          </div>
          <div class="wg-toggles-row">
            <label class="wg-toggle-label">
              <input
                id={`${uniqueId}-fw-mss`}
                type="checkbox"
                checked
              />
              <span>
                {t("tools.wireguardConfigGenerator.toggleMssClamping")}
              </span>
            </label>
            <label class="wg-toggle-label">
              <input
                id={`${uniqueId}-fw-raw`}
                type="checkbox"
                checked
              />
              <span>
                {t("tools.wireguardConfigGenerator.toggleRawSkipFlood")}
              </span>
            </label>
          </div>
          <div
            class="wg-sub-fields"
            id={`${uniqueId}-mss-fields`}
          >
            <div class="wg-fields-row">
              <div class="wg-field">
                <label
                  class="wg-label"
                  for={`${uniqueId}-mss-v4`}
                >
                  {t("tools.wireguardConfigGenerator.labelMssV4")}
                </label>
                <input
                  id={`${uniqueId}-mss-v4`}
                  class="wg-input"
                  type="number"
                  value="1380"
                  min="500"
                  max="9000"
                  aria-describedby={`${uniqueId}-mss-v4-hint`}
                />
                <span
                  class="wg-field-hint"
                  id={`${uniqueId}-mss-v4-hint`}
                >
                  {t("tools.wireguardConfigGenerator.hintMssV4")}
                </span>
              </div>
              <div
                class="wg-field"
                id={`${uniqueId}-mss-v6-field`}
              >
                <label
                  class="wg-label"
                  for={`${uniqueId}-mss-v6`}
                >
                  {t("tools.wireguardConfigGenerator.labelMssV6")}
                </label>
                <input
                  id={`${uniqueId}-mss-v6`}
                  class="wg-input"
                  type="number"
                  value="1360"
                  min="500"
                  max="9000"
                  aria-describedby={`${uniqueId}-mss-v6-hint`}
                />
                <span
                  class="wg-field-hint"
                  id={`${uniqueId}-mss-v6-hint`}
                >
                  {t("tools.wireguardConfigGenerator.hintMssV6")}
                </span>
              </div>
            </div>
          </div>
        </div>
      </details>
    </div>

    {/* ── Peers ── */}
    <div class="wg-card">
      <div class="wg-card-header">
        <span
          class="i-mdi:devices"
          aria-hidden="true"
        ></span>
        {t("tools.wireguardConfigGenerator.sectionPeers")}
        <button
          type="button"
          class="wg-add-peer-btn"
          id={`${uniqueId}-add-peer`}
          aria-label={t("tools.wireguardConfigGenerator.addPeerAriaLabel")}
        >
          <span
            class="i-mdi:plus"
            aria-hidden="true"
          ></span>
          {t("tools.wireguardConfigGenerator.addPeer")}
        </button>
      </div>
      <div
        class="wg-card-body"
        id={`${uniqueId}-peers-container`}
      >
        <div class="wg-field">
          <label class="wg-toggle-label">
            <input
              id={`${uniqueId}-responder`}
              type="checkbox"
              checked
              aria-describedby={`${uniqueId}-responder-hint`}
            />
            <span>{t("tools.wireguardConfigGenerator.toggleResponder")}</span>
          </label>
          <span
            class="wg-field-hint"
            id={`${uniqueId}-responder-hint`}
          >
            {t("tools.wireguardConfigGenerator.hintResponder")}
          </span>
        </div>

        {/* Peer 1 (default) */}
        <div
          class="wg-peer"
          data-peer-index="0"
        >
          <div class="wg-peer-header">
            <span class="wg-peer-number">
              {t("tools.wireguardConfigGenerator.peerLabel").replace(
                "{n}",
                "1",
              )}
            </span>
            <button
              type="button"
              class="wg-remove-peer-btn"
              data-remove-peer="0"
              aria-label={t(
                "tools.wireguardConfigGenerator.removePeerAriaLabel",
              )}
