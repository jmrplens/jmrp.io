    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: all 0.15s;
  }

  .wg-related a:hover {
    border-color: var(--color-primary);
  }

  @media (width <= 640px) {
    .wg-card-body :global(.wg-fields-row) {
      grid-template-columns: 1fr;
    }
  }
</style>
