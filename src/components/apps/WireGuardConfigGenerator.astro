    border-left: 2px solid var(--color-primary-muted, rgb(99 102 241 / 30%));
  }

  .wg-sub-fields[hidden] {
    display: none;
  }

  /* MTU warning. The status region is always rendered (an empty live region
     still announces what is added to it), so it cancels the card-body gap
     while empty and the box inside restores it when shown. */
  .wg-mtu-status {
    margin-top: -0.625rem;
  }

  .wg-mtu-warning {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    padding: 0.5rem 0.625rem;
    margin-top: 0.625rem;
    font-size: var(--text-xs);
    color: var(--color-text);
    background: var(--warning-dim);
    border: 1px solid var(--color-warning);
    border-radius: var(--radius-sm);
  }

  .wg-mtu-warning[hidden] {
    display: none;
  }

  .wg-mtu-warning span[class*="i-"] {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    color: var(--color-warning);
  }

  /* Peer sections: :global() needed because peers are dynamically created via innerHTML */
  .wg-card-body :global(.wg-peer) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem;
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-sm);
  }

  .wg-card-body :global(.wg-peer + .wg-peer) {
    margin-top: 0.5rem;
  }

  .wg-card-body :global(.wg-peer-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wg-card-body :global(.wg-peer-number) {
    font-size: var(--text-micro);
    font-weight: var(--fw-bold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .wg-card-body :global(.wg-remove-peer-btn) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    color: var(--color-text-muted);
    cursor: pointer;
    background: none;
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: all 0.15s;
  }

  .wg-card-body :global(.wg-remove-peer-btn:hover) {
    color: var(--color-danger, #ef4444);
    border-color: var(--color-danger, var(--color-danger));
  }

  .wg-card-body :global(.wg-remove-peer-btn span) {
    width: 14px;
    height: 14px;
  }

  .wg-add-peer-btn {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    padding: 0.25rem 0.625rem;
    margin-left: auto;
    font-size: var(--text-micro);
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
    cursor: pointer;
    background: var(--color-bg);
    border: var(--border-1);
    border-color: var(--color-primary);
    border-radius: var(--radius-sm);
    transition: all 0.15s;
  }

  .wg-add-peer-btn:hover {
    background: var(--color-bg-subtle);
  }

  .wg-add-peer-btn span {
    width: 14px;
    height: 14px;
  }

  /* Key row (input + generate button); :global() for dynamic peers */
  .wg-card-body :global(.wg-key-row) {
    display: flex;
    gap: 0.375rem;
    align-items: center;
  }

  .wg-card-body :global(.wg-key-row .wg-input) {
    flex: 1;
    min-width: 0;
