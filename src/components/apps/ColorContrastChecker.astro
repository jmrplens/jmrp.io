---
/**
 * ColorContrastChecker Component
 * WCAG 2.2 color contrast ratio checker.
 *
 * Usage:
 * <ColorContrastChecker title="Color Contrast Checker" />
 */

interface Props {
  title?: string;
}

const { title = "Color Contrast Checker" } = Astro.props;
const uniqueId = `cc-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;
---

<div
  class="cc-checker"
  data-cc-id={uniqueId}
>
  {title && <div class="cc-title">{title}</div>}

  <div class="cc-layout">
    {/* Color pickers */}
    <div class="cc-pickers">
      <div class="cc-picker-group">
        <label
          class="cc-picker-label"
          for={`${uniqueId}-fg-color`}
          >Foreground (Text)</label
        >
        <div class="cc-picker-row">
          <input
            type="color"
            id={`${uniqueId}-fg-color`}
            class="cc-color-input"
            value="#1a1a2e"
          />
          <input
            type="text"
            id={`${uniqueId}-fg-hex`}
            class="cc-hex-input"
            value="#1a1a2e"
            spellcheck="false"
            maxlength="9"
            aria-label="Foreground color hex value"
          />
        </div>
      </div>

      <button
        type="button"
        class="cc-swap-btn"
        aria-label="Swap foreground and background colors"
      >
        <span class="i-mdi:swap-horizontal"></span>
      </button>

      <div class="cc-picker-group">
        <label
          class="cc-picker-label"
          for={`${uniqueId}-bg-color`}
          >Background</label
        >
        <div class="cc-picker-row">
          <input
            type="color"
            id={`${uniqueId}-bg-color`}
            class="cc-color-input"
            value="#ffffff"
          />
          <input
            type="text"
            id={`${uniqueId}-bg-hex`}
            class="cc-hex-input"
            value="#ffffff"
            spellcheck="false"
            maxlength="9"
            aria-label="Background color hex value"
          />
        </div>
      </div>
    </div>

    {/* Preview */}
    <div
      class="cc-preview"
      id={`${uniqueId}-preview`}
    >
      <span
        class="cc-preview-normal"
        id={`${uniqueId}-preview-normal`}
      >
        Normal text (16px) — The quick brown fox jumps over the lazy dog.
      </span>
      <span
        class="cc-preview-large"
        id={`${uniqueId}-preview-large`}
      >
        Large text (24px) — Example heading
      </span>
      <span
        class="cc-preview-small"
        id={`${uniqueId}-preview-small`}
      >
        Small text (12px) — Secondary information and captions
      </span>
    </div>

    {/* Contrast ratio */}
    <div class="cc-ratio-section">
      <div class="cc-ratio-display">
        <span
          class="cc-ratio-value"
          id={`${uniqueId}-ratio`}
          >—</span
        >
        <span class="cc-ratio-label">Contrast Ratio</span>
      </div>

      {/* WCAG results */}
      <div class="cc-wcag-grid">
        <div
          class="cc-wcag-item"
          id={`${uniqueId}-aa-normal`}
        >
          <span class="cc-wcag-badge">AA</span>
          <span class="cc-wcag-text">Normal Text</span>
          <span class="cc-wcag-min">(≥ 4.5:1)</span>
          <span class="cc-wcag-result">—</span>
        </div>
        <div
          class="cc-wcag-item"
          id={`${uniqueId}-aa-large`}
        >
          <span class="cc-wcag-badge">AA</span>
          <span class="cc-wcag-text">Large Text</span>
          <span class="cc-wcag-min">(≥ 3:1)</span>
          <span class="cc-wcag-result">—</span>
        </div>
        <div
          class="cc-wcag-item"
          id={`${uniqueId}-aaa-normal`}
        >
          <span class="cc-wcag-badge cc-wcag-aaa">AAA</span>
          <span class="cc-wcag-text">Normal Text</span>
          <span class="cc-wcag-min">(≥ 7:1)</span>
          <span class="cc-wcag-result">—</span>
        </div>
        <div
          class="cc-wcag-item"
          id={`${uniqueId}-aaa-large`}
        >
          <span class="cc-wcag-badge cc-wcag-aaa">AAA</span>
          <span class="cc-wcag-text">Large Text</span>
          <span class="cc-wcag-min">(≥ 4.5:1)</span>
          <span class="cc-wcag-result">—</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ uniqueId }}>
  (function () {
    const container = document.querySelector(`[data-cc-id="${uniqueId}"]`);
    if (!container) return;

    const fgColor = document.getElementById(`${uniqueId}-fg-color`);
    const fgHex = document.getElementById(`${uniqueId}-fg-hex`);
    const bgColor = document.getElementById(`${uniqueId}-bg-color`);
    const bgHex = document.getElementById(`${uniqueId}-bg-hex`);
    const preview = document.getElementById(`${uniqueId}-preview`);
    const ratioEl = document.getElementById(`${uniqueId}-ratio`);
    const swapBtn = container.querySelector(".cc-swap-btn");

    var wcagItems = {};
    ["aa-normal", "aa-large", "aaa-normal", "aaa-large"].forEach(function (id) {
      wcagItems[id] = document.getElementById(`${uniqueId}-${id}`);
    });

    if (!fgColor || !bgColor) return;

    function hexToRgb(hex) {
      hex = hex.replace("#", "");
      if (hex.length === 3) {
        hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
      }
      if (hex.length !== 6) return null;
      var num = parseInt(hex, 16);
      if (isNaN(num)) return null;
      return {
        r: (num >> 16) & 255,
        g: (num >> 8) & 255,
        b: num & 255,
      };
    }

    function relativeLuminance(rgb) {
      var rsrgb = rgb.r / 255;
      var gsrgb = rgb.g / 255;
      var bsrgb = rgb.b / 255;

      var r =
        rsrgb <= 0.04045
          ? rsrgb / 12.92
          : Math.pow((rsrgb + 0.055) / 1.055, 2.4);
      var g =
        gsrgb <= 0.04045
          ? gsrgb / 12.92
          : Math.pow((gsrgb + 0.055) / 1.055, 2.4);
      var b =
        bsrgb <= 0.04045
          ? bsrgb / 12.92
          : Math.pow((bsrgb + 0.055) / 1.055, 2.4);

      return 0.2126 * r + 0.7152 * g + 0.0722 * b;
    }

    function contrastRatio(fg, bg) {
      var l1 = relativeLuminance(fg);
      var l2 = relativeLuminance(bg);
      var lighter = Math.max(l1, l2);
      var darker = Math.min(l1, l2);
      return (lighter + 0.05) / (darker + 0.05);
    }

    function updateWcagItem(id, ratio, threshold) {
      var el = wcagItems[id];
      if (!el) return;

      var result = el.querySelector(".cc-wcag-result");
      if (!result) return;

      var passes = ratio >= threshold;
      result.textContent = passes ? "Pass ✓" : "Fail ✗";
      el.className = "cc-wcag-item " + (passes ? "cc-pass" : "cc-fail");
    }

    function update() {
      var fg = hexToRgb(fgHex.value);
      var bg = hexToRgb(bgHex.value);

      if (!fg || !bg) {
        if (ratioEl) ratioEl.textContent = "Invalid color";
        return;
      }

      var ratio = contrastRatio(fg, bg);
      if (ratioEl) ratioEl.textContent = ratio.toFixed(2) + ":1";

      // Update preview
      if (preview) {
        preview.style.setProperty("--cc-preview-bg", bgHex.value);
        preview.style.setProperty("--cc-preview-fg", fgHex.value);
      }

      // WCAG checks
      updateWcagItem("aa-normal", ratio, 4.5);
      updateWcagItem("aa-large", ratio, 3);
      updateWcagItem("aaa-normal", ratio, 7);
      updateWcagItem("aaa-large", ratio, 4.5);
    }

    // Sync color picker <-> hex input
    function syncFromColor(colorEl, hexEl) {
      hexEl.value = colorEl.value;
      update();
    }

    function syncFromHex(hexEl, colorEl) {
      var val = hexEl.value.trim();
      if (!val.startsWith("#")) val = "#" + val;
      if (/^#[0-9a-f]{6}$/i.test(val)) {
        colorEl.value = val;
      }
      hexEl.value = val;
      update();
    }

    fgColor.addEventListener("input", function () {
      syncFromColor(fgColor, fgHex);
    });
    bgColor.addEventListener("input", function () {
      syncFromColor(bgColor, bgHex);
    });
    fgHex.addEventListener("input", function () {
      syncFromHex(fgHex, fgColor);
    });
    bgHex.addEventListener("input", function () {
      syncFromHex(bgHex, bgColor);
    });

    // Swap
    if (swapBtn) {
      swapBtn.addEventListener("click", function () {
        var tmpColor = fgColor.value;
        var tmpHex = fgHex.value;
        fgColor.value = bgColor.value;
        fgHex.value = bgHex.value;
        bgColor.value = tmpColor;
        bgHex.value = tmpHex;
        update();
      });
    }

    update();
  })();
</script>

<style>
  .cc-checker {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-subtle);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .cc-title {
    padding: 1rem 1.25rem;
    font-size: 1.1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
    background: var(--color-bg-secondary);
    border-bottom: var(--border-1);
  }

  .cc-layout {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
  }

  /* Pickers */
  .cc-pickers {
    display: flex;
    gap: 1rem;
    align-items: flex-end;
  }

  .cc-picker-group {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.375rem;
  }

  .cc-picker-label {
    font-size: 0.8rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .cc-picker-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .cc-color-input {
    width: 48px;
    height: 40px;
    padding: 2px;
    cursor: pointer;
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-sm);
  }

  .cc-color-input::-webkit-color-swatch-wrapper {
    padding: 2px;
  }

  .cc-color-input::-webkit-color-swatch {
    border: none;
    border-radius: 3px;
  }

  .cc-hex-input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s;
  }

  .cc-hex-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .cc-swap-btn {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-text-muted);
    cursor: pointer;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: 50%;
    transition: all 0.15s;
  }

  .cc-swap-btn span {
    width: 20px;
    height: 20px;
  }

  .cc-swap-btn:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* Preview */
  .cc-preview {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    color: var(--cc-preview-fg, #1a1a2e);
    background-color: var(--cc-preview-bg, #fff);
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .cc-preview-normal {
    font-size: 1rem;
    line-height: 1.5;
  }

  .cc-preview-large {
    font-size: 1.5rem;
    font-weight: var(--fw-bold);
    line-height: 1.3;
  }

  .cc-preview-small {
    font-size: 0.75rem;
    line-height: 1.4;
  }

  /* Ratio */
  .cc-ratio-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cc-ratio-display {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: center;
    padding: 1rem;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-sm);
  }

  .cc-ratio-value {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: var(--fw-bold);
    color: var(--color-text-heading);
  }

  .cc-ratio-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* WCAG grid */
  .cc-wcag-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .cc-wcag-item {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    align-items: center;
    padding: 0.625rem 0.75rem;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: border-color 0.2s;
  }

  .cc-wcag-item.cc-pass {
    border-color: #047857;
  }

  .cc-wcag-item.cc-fail {
    border-color: #b91c1c;
  }

  .cc-wcag-badge {
    padding: 0.125rem 0.375rem;
    font-size: 0.7rem;
    font-weight: var(--fw-bold);
    color: #065f46;
    background: #d1fae5;
    border-radius: var(--radius-sm);
  }

  :root[data-theme="dark"] .cc-wcag-badge {
    color: #6ee7b7;
    background: rgb(6 95 70 / 40%);
  }

  .cc-wcag-aaa {
    color: #6d28d9;
    background: rgb(124 58 237 / 12%);
  }

  :root[data-theme="dark"] .cc-wcag-aaa {
    color: #a78bfa;
    background: rgb(124 58 237 / 20%);
  }

  .cc-wcag-text {
    font-size: 0.8rem;
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .cc-wcag-min {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .cc-wcag-result {
    margin-left: auto;
    font-size: 0.8rem;
    font-weight: var(--fw-semibold);
  }

  .cc-pass .cc-wcag-result {
    color: #047857;
  }

  .cc-fail .cc-wcag-result {
    color: #b91c1c;
  }

  @media (width <= 640px) {
    .cc-layout {
      padding: 1rem;
    }

    .cc-pickers {
      flex-direction: column;
      gap: 0.75rem;
    }

    .cc-swap-btn {
      align-self: center;
      transform: rotate(90deg);
    }

    .cc-wcag-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
