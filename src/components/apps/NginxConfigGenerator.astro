---
/**
 * NginxConfigGenerator Component
 * Visual Nginx server block builder with collapsible sections and presets.
 * Includes upstream blocks, QUIC/HTTP3, rate limiting, tarpit, access control,
 * OCSP stapling, Brotli, CSP, PHP-FPM, SPA fallback, proxy caching,
 * timeouts, and modern best practices.
 *
 * Usage:
 * <NginxConfigGenerator title="Nginx Config Generator" />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

interface Props {
  title?: string;
}

const { title = t("tools.nginxConfigGenerator.title") } = Astro.props;
const uniqueId = `ngx-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

/** Translations passed to the inline script via define:vars. */
const i18n = {
  copied: t("tools.shared.copied"),
  copy: t("tools.shared.copy"),
};
---

<div
  class="ngx-generator"
  data-ngx-id={uniqueId}
>
  {title && <div class="ngx-title">{title}</div>}

  <div class="ngx-layout">
    {/* Quick Preset */}
    <div class="ngx-presets-bar">
      <span class="ngx-presets-label">
        <span
          class="i-mdi:lightning-bolt"
          aria-hidden="true"
        ></span>
        {t("tools.nginxConfigGenerator.preset")}
      </span>
      <div class="ngx-presets">
        <button
          type="button"
          class="ngx-preset-btn ngx-preset-active"
          data-preset="static"
          >{t("tools.nginxConfigGenerator.presetStaticSite")}</button
        >
        <button
          type="button"
          class="ngx-preset-btn"
          data-preset="reverse-proxy"
          >{t("tools.nginxConfigGenerator.presetReverseProxy")}</button
        >
        <button
          type="button"
          class="ngx-preset-btn"
          data-preset="spa"
          >{t("tools.nginxConfigGenerator.presetSpaReact")}</button
        >
        <button
          type="button"
          class="ngx-preset-btn"
          data-preset="php"
          >{t("tools.nginxConfigGenerator.presetPhpFpm")}</button
        >
        <button
          type="button"
          class="ngx-preset-btn"
          data-preset="api"
          >{t("tools.nginxConfigGenerator.presetApiBackend")}</button
        >
        <button
          type="button"
          class="ngx-preset-btn"
          data-preset="hardened"
          >{t("tools.nginxConfigGenerator.presetHardened")}</button
        >
      </div>
    </div>

    {/* Server Basics */}
    <div class="ngx-card">
      <div class="ngx-card-header">
        <span
          class="i-mdi:server"
          aria-hidden="true"
        ></span>
        {t("tools.nginxConfigGenerator.sectionServer")}
      </div>
      <div class="ngx-card-body">
        <div class="ngx-fields-row">
          <div class="ngx-field">
            <label
              class="ngx-label"
              for={`${uniqueId}-domain`}
              >{t("tools.nginxConfigGenerator.labelDomain")}</label
            >
            <input
              id={`${uniqueId}-domain`}
              class="ngx-input"
              type="text"
              value="example.com"
              placeholder="example.com"
            />
          </div>
          <div
            class="ngx-field"
            id={`${uniqueId}-root-field`}
          >
            <label
              class="ngx-label"
              for={`${uniqueId}-root`}
              >{t("tools.nginxConfigGenerator.labelRootPath")}</label
            >
            <input
              id={`${uniqueId}-root`}
              class="ngx-input"
              type="text"
              value="/var/www/html"
              placeholder="/var/www/html"
            />
          </div>
          <div
            class="ngx-field"
            id={`${uniqueId}-index-field`}
          >
            <label
              class="ngx-label"
              for={`${uniqueId}-index`}
              >{t("tools.nginxConfigGenerator.labelIndexFiles")}</label
            >
            <input
              id={`${uniqueId}-index`}
              class="ngx-input"
              type="text"
              value="index.html index.htm"
              placeholder="index.html index.htm"
            />
          </div>
        </div>
        <div class="ngx-toggles-row">
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-server-tokens`}
              checked
            />
            <span>server_tokens off</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-charset`}
              checked
            />
            <span>charset utf-8</span>
          </label>
        </div>
        <div
          class="ngx-toggles-row"
          id={`${uniqueId}-app-mode-row`}
        >
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-spa-mode`}
            />
            <span>{t("tools.nginxConfigGenerator.toggleSpaMode")}</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-php-fpm`}
            />
            <span>PHP-FPM</span>
          </label>
        </div>
        <div
          class="ngx-sub-fields"
          id={`${uniqueId}-php-fields`}
          hidden
        >
          <div class="ngx-field">
            <label
              class="ngx-label"
              for={`${uniqueId}-php-socket`}
              >{t("tools.nginxConfigGenerator.labelPhpSocket")}</label
            >
            <input
              id={`${uniqueId}-php-socket`}
              class="ngx-input"
              type="text"
              value="unix:/var/run/php/php-fpm.sock"
              placeholder="unix:/var/run/php/php-fpm.sock"
            />
          </div>
        </div>
      </div>
    </div>

    {/* SSL / TLS */}
    <details
      class="ngx-card"
      id={`${uniqueId}-ssl-details`}
      open
    >
      <summary class="ngx-card-header ngx-summary">
        <span
          class="i-mdi:chevron-right ngx-chevron"
          aria-hidden="true"
        ></span>
        <span
          class="i-mdi:shield-lock-outline"
          aria-hidden="true"
        ></span>
        {t("tools.nginxConfigGenerator.sectionSslTls")}
      </summary>
      <div class="ngx-card-body">
        <div class="ngx-toggle-row ngx-main-toggle">
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-ssl`}
              checked
            />
            <span>{t("tools.nginxConfigGenerator.toggleEnableHttps")}</span>
          </label>
        </div>
        <div
          class="ngx-sub-fields"
          id={`${uniqueId}-ssl-fields`}
        >
          <div class="ngx-fields-row">
            <div class="ngx-field">
              <label
                class="ngx-label"
                for={`${uniqueId}-cert`}
                >{t("tools.nginxConfigGenerator.labelCertificate")}</label
              >
              <input
                id={`${uniqueId}-cert`}
                class="ngx-input"
                type="text"
                value="/etc/letsencrypt/live/example.com/fullchain.pem"
              />
            </div>
            <div class="ngx-field">
              <label
                class="ngx-label"
                for={`${uniqueId}-key`}
                >{t("tools.nginxConfigGenerator.labelPrivateKey")}</label
              >
              <input
                id={`${uniqueId}-key`}
                class="ngx-input"
                type="text"
                value="/etc/letsencrypt/live/example.com/privkey.pem"
              />
            </div>
          </div>
          <div class="ngx-toggles-row">
            <label class="ngx-toggle-label">
              <input
                type="checkbox"
                id={`${uniqueId}-http2`}
                checked
              />
              <span>HTTP/2</span>
            </label>
            <label class="ngx-toggle-label">
              <input
                type="checkbox"
                id={`${uniqueId}-http3`}
              />
              <span>QUIC / HTTP/3</span>
            </label>
            <label class="ngx-toggle-label">
              <input
                type="checkbox"
                id={`${uniqueId}-hsts`}
                checked
              />
              <span>HSTS</span>
            </label>
            <label class="ngx-toggle-label">
              <input
                type="checkbox"
                id={`${uniqueId}-ocsp`}
                checked
              />
              <span>OCSP Stapling</span>
            </label>
            <label class="ngx-toggle-label">
              <input
                type="checkbox"
                id={`${uniqueId}-ssl-early`}
              />
              <span>0-RTT Early Data</span>
            </label>
            <label class="ngx-toggle-label">
              <input
                type="checkbox"
                id={`${uniqueId}-redirect-http`}
                checked
              />
              <span>{t("tools.nginxConfigGenerator.toggleRedirectHttp")}</span>
            </label>
          </div>
        </div>
      </div>
    </details>

    {/* Reverse Proxy */}
    <details
      class="ngx-card"
      id={`${uniqueId}-proxy-details`}
    >
      <summary class="ngx-card-header ngx-summary">
        <span
          class="i-mdi:chevron-right ngx-chevron"
          aria-hidden="true"
        ></span>
        <span
          class="i-mdi:arrow-right-bold"
          aria-hidden="true"
        ></span>
        {t("tools.nginxConfigGenerator.sectionReverseProxy")}
      </summary>
      <div class="ngx-card-body">
        <div class="ngx-toggle-row ngx-main-toggle">
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-proxy`}
            />
            <span>{t("tools.nginxConfigGenerator.toggleEnableProxy")}</span>
          </label>
        </div>
        <div
          class="ngx-sub-fields"
          id={`${uniqueId}-proxy-fields`}
          hidden
        >
          <div class="ngx-fields-row">
            <div class="ngx-field">
              <label
                class="ngx-label"
                for={`${uniqueId}-upstream-name`}
                >{t("tools.nginxConfigGenerator.labelUpstreamName")}</label
              >
              <input
                id={`${uniqueId}-upstream-name`}
                class="ngx-input"
                type="text"
                value="backend_app"
                placeholder="backend_app"
              />
            </div>
            <div class="ngx-field">
              <label
                class="ngx-label"
                for={`${uniqueId}-upstream`}
                >{t("tools.nginxConfigGenerator.labelBackendServers")}</label
              >
              <input
                id={`${uniqueId}-upstream`}
                class="ngx-input"
                type="text"
                value="127.0.0.1:3000"
                placeholder="127.0.0.1:3000"
              />
              <span class="ngx-field-hint"
                >{t("tools.nginxConfigGenerator.hintCommaSeparated")}</span
              >
            </div>
          </div>
          <div class="ngx-field">
            <label
              class="ngx-label"
              for={`${uniqueId}-lb-method`}
              >{t("tools.nginxConfigGenerator.labelLoadBalancing")}</label
            >
            <select
              id={`${uniqueId}-lb-method`}
              class="ngx-select"
            >
              <option value="round-robin"
                >{t("tools.nginxConfigGenerator.optRoundRobin")}</option
              >
              <option value="least_conn"
                >{t("tools.nginxConfigGenerator.optLeastConn")}</option
              >
              <option value="ip_hash"
                >{t("tools.nginxConfigGenerator.optIpHash")}</option
              >
            </select>
          </div>
          <div class="ngx-toggles-row">
            <label class="ngx-toggle-label">
              <input
                type="checkbox"
                id={`${uniqueId}-keepalive`}
                checked
              />
              <span>Keepalive (64)</span>
            </label>
            <label class="ngx-toggle-label">
              <input
                type="checkbox"
                id={`${uniqueId}-ws`}
              />
              <span>WebSocket</span>
            </label>
            <label class="ngx-toggle-label">
              <input
                type="checkbox"
                id={`${uniqueId}-proxy-buffering`}
              />
              <span>{t("tools.nginxConfigGenerator.toggleProxyBuffering")}</span
              >
            </label>
          </div>
          <div class="ngx-toggle-row">
            <label class="ngx-toggle-label">
              <input
                type="checkbox"
                id={`${uniqueId}-resolver`}
              />
              <span>{t("tools.nginxConfigGenerator.toggleDnsResolver")}</span>
            </label>
          </div>
          <div
            class="ngx-sub-fields"
            id={`${uniqueId}-resolver-fields`}
            hidden
          >
            <div class="ngx-field">
              <label
                class="ngx-label"
                for={`${uniqueId}-resolver-servers`}
                >{t("tools.nginxConfigGenerator.labelResolverServers")}</label
              >
              <input
                id={`${uniqueId}-resolver-servers`}
                class="ngx-input"
                type="text"
                value="1.1.1.1 8.8.8.8"
                placeholder="1.1.1.1 8.8.8.8"
              />
            </div>
          </div>
          <div class="ngx-toggle-row">
            <label class="ngx-toggle-label">
              <input
                type="checkbox"
                id={`${uniqueId}-proxy-cache`}
              />
              <span>{t("tools.nginxConfigGenerator.toggleProxyCache")}</span>
            </label>
          </div>
          <div
            class="ngx-sub-fields"
            id={`${uniqueId}-proxy-cache-fields`}
            hidden
          >
            <div class="ngx-fields-row">
              <div class="ngx-field">
                <label
                  class="ngx-label"
                  for={`${uniqueId}-cache-zone`}
                  >{t("tools.nginxConfigGenerator.labelZoneName")}</label
                >
                <input
                  id={`${uniqueId}-cache-zone`}
                  class="ngx-input"
                  type="text"
                  value="app_cache"
                  placeholder="app_cache"
                />
              </div>
              <div class="ngx-field">
                <label
                  class="ngx-label"
                  for={`${uniqueId}-cache-valid-time`}
                  >{t("tools.nginxConfigGenerator.labelCacheValid")}</label
                >
                <input
                  id={`${uniqueId}-cache-valid-time`}
                  class="ngx-input"
                  type="text"
                  value="10m"
                  placeholder="10m"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </details>

    {/* Security Headers */}
    <details
      class="ngx-card"
      id={`${uniqueId}-security-details`}
      open
    >
      <summary class="ngx-card-header ngx-summary">
        <span
          class="i-mdi:chevron-right ngx-chevron"
          aria-hidden="true"
        ></span>
        <span
          class="i-mdi:security"
          aria-hidden="true"
        ></span>
        {t("tools.nginxConfigGenerator.sectionSecurityHeaders")}
      </summary>
      <div class="ngx-card-body">
        <div class="ngx-toggles-row">
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-sec-xframe`}
              checked
            />
            <span>X-Frame-Options</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-sec-xcto`}
              checked
            />
            <span>X-Content-Type-Options</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-sec-referrer`}
              checked
            />
            <span>Referrer-Policy</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-sec-permissions`}
            />
            <span>Permissions-Policy</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-sec-coop`}
            />
            <span>COOP / CORP / COEP</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-sec-csp`}
            />
            <span>CSP (basic)</span>
          </label>
        </div>
        <div
          class="ngx-info-hint"
          id={`${uniqueId}-csp-hint`}
          hidden
        >
          <span
            class="i-mdi:information-outline"
            aria-hidden="true"
          ></span>
          <span
            >{t("tools.nginxConfigGenerator.hintCspAdvanced")}
            <a href="/tools/csp-builder/"
              >{t("tools.nginxConfigGenerator.hintCspBuilderLink")}</a
            >
            {t("tools.nginxConfigGenerator.hintCspAdvancedSuffix")}</span
          >
        </div>
      </div>
    </details>

    {/* Access Control */}
    <details
      class="ngx-card"
      id={`${uniqueId}-access-details`}
      open
    >
      <summary class="ngx-card-header ngx-summary">
        <span
          class="i-mdi:chevron-right ngx-chevron"
          aria-hidden="true"
        ></span>
        <span
          class="i-mdi:shield-alert-outline"
          aria-hidden="true"
        ></span>
        {t("tools.nginxConfigGenerator.sectionAccessControl")}
      </summary>
      <div class="ngx-card-body">
        <div class="ngx-toggle-row">
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-rate-limit`}
            />
            <span>{t("tools.nginxConfigGenerator.toggleRateLimiting")}</span>
          </label>
        </div>
        <div
          class="ngx-sub-fields"
          id={`${uniqueId}-rate-fields`}
          hidden
        >
          <div class="ngx-fields-row">
            <div class="ngx-field">
              <label
                class="ngx-label"
                for={`${uniqueId}-rate-value`}
                >{t("tools.nginxConfigGenerator.labelRate")}</label
              >
              <input
                id={`${uniqueId}-rate-value`}
                class="ngx-input"
                type="number"
                min="1"
                max="1000"
                value="10"
              />
            </div>
            <div class="ngx-field">
              <label
                class="ngx-label"
                for={`${uniqueId}-rate-burst`}
                >{t("tools.nginxConfigGenerator.labelBurst")}</label
              >
              <input
                id={`${uniqueId}-rate-burst`}
                class="ngx-input"
                type="number"
                min="0"
                max="500"
                value="20"
              />
            </div>
          </div>
        </div>
        <div class="ngx-toggles-row">
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-block-hidden`}
              checked
            />
            <span>{t("tools.nginxConfigGenerator.toggleBlockHidden")}</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-block-exploits`}
            />
            <span>{t("tools.nginxConfigGenerator.toggleBlockExploits")}</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-tarpit`}
            />
            <span>{t("tools.nginxConfigGenerator.toggleTarpit")}</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-body-limit`}
              checked
            />
            <span>{t("tools.nginxConfigGenerator.toggleBodyLimit")}</span>
          </label>
        </div>
        <div
          class="ngx-info-hint"
          id={`${uniqueId}-tarpit-hint`}
          hidden
        >
          <span
            class="i-mdi:information-outline"
            aria-hidden="true"
          ></span>
          <span
            >{t("tools.nginxConfigGenerator.hintTarpit")}
            <a href="/blog/005-implementing-tarpit-nginx/"
              >{t("tools.nginxConfigGenerator.hintTarpitLink")}</a
            >.</span
          >
        </div>
      </div>
    </details>

    {/* Performance & Caching */}
    <details
      class="ngx-card"
      id={`${uniqueId}-perf-details`}
      open
    >
      <summary class="ngx-card-header ngx-summary">
        <span
          class="i-mdi:chevron-right ngx-chevron"
          aria-hidden="true"
        ></span>
        <span
          class="i-mdi:speedometer"
          aria-hidden="true"
        ></span>
        {t("tools.nginxConfigGenerator.sectionPerformance")}
      </summary>
      <div class="ngx-card-body">
        <div class="ngx-toggles-row">
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-gzip`}
              checked
            />
            <span>Gzip</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-brotli`}
            />
            <span>Brotli</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-cache`}
              checked
            />
            <span>{t("tools.nginxConfigGenerator.toggleStaticCaching")}</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-open-file-cache`}
            />
            <span>{t("tools.nginxConfigGenerator.toggleOpenFileCache")}</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-sendfile`}
              checked
            />
            <span>sendfile + tcp_nopush</span>
          </label>
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-logs`}
              checked
            />
            <span>{t("tools.nginxConfigGenerator.toggleLogs")}</span>
          </label>
        </div>
      </div>
    </details>

    {/* Timeouts & Buffers */}
    <details
      class="ngx-card"
      id={`${uniqueId}-timeouts-details`}
    >
      <summary class="ngx-card-header ngx-summary">
        <span
          class="i-mdi:chevron-right ngx-chevron"
          aria-hidden="true"
        ></span>
        <span
          class="i-mdi:clock-outline"
          aria-hidden="true"
        ></span>
        {t("tools.nginxConfigGenerator.sectionTimeouts")}
      </summary>
      <div class="ngx-card-body">
        <div class="ngx-fields-row">
          <div class="ngx-field">
            <label
              class="ngx-label"
              for={`${uniqueId}-keepalive-timeout`}
              >keepalive_timeout</label
            >
            <input
              id={`${uniqueId}-keepalive-timeout`}
              class="ngx-input"
              type="number"
              min="0"
              max="600"
              value="65"
            />
          </div>
          <div class="ngx-field">
            <label
              class="ngx-label"
              for={`${uniqueId}-client-body-timeout`}
              >client_body_timeout</label
            >
            <input
              id={`${uniqueId}-client-body-timeout`}
              class="ngx-input"
              type="number"
              min="0"
              max="300"
              value="60"
            />
          </div>
          <div class="ngx-field">
            <label
              class="ngx-label"
              for={`${uniqueId}-client-header-timeout`}
              >client_header_timeout</label
            >
            <input
              id={`${uniqueId}-client-header-timeout`}
              class="ngx-input"
              type="number"
              min="0"
              max="300"
              value="60"
            />
          </div>
          <div class="ngx-field">
            <label
              class="ngx-label"
              for={`${uniqueId}-send-timeout`}
              >send_timeout</label
            >
            <input
              id={`${uniqueId}-send-timeout`}
              class="ngx-input"
              type="number"
              min="0"
              max="300"
              value="60"
            />
          </div>
        </div>
        <div class="ngx-toggle-row">
          <label class="ngx-toggle-label">
            <input
              type="checkbox"
              id={`${uniqueId}-keepalive-requests`}
              checked
            />
            <span>keepalive_requests (1000)</span>
          </label>
        </div>
        <div
          class="ngx-sub-fields"
          id={`${uniqueId}-proxy-timeout-fields`}
          hidden
        >
          <div class="ngx-sub-label">
            {t("tools.nginxConfigGenerator.subLabelProxyTimeouts")}
          </div>
          <div class="ngx-fields-row">
            <div class="ngx-field">
              <label
                class="ngx-label"
                for={`${uniqueId}-proxy-read-timeout`}
                >proxy_read_timeout</label
              >
              <input
                id={`${uniqueId}-proxy-read-timeout`}
                class="ngx-input"
                type="number"
                min="0"
                max="600"
                value="60"
              />
            </div>
            <div class="ngx-field">
              <label
                class="ngx-label"
                for={`${uniqueId}-proxy-connect-timeout`}
                >proxy_connect_timeout</label
              >
              <input
                id={`${uniqueId}-proxy-connect-timeout`}
                class="ngx-input"
                type="number"
                min="0"
                max="600"
                value="60"
              />
            </div>
          </div>
        </div>
      </div>
    </details>

    {/* Related blog posts */}
    <div class="ngx-related">
      <span
        class="i-mdi:book-open-outline"
        aria-hidden="true"
      ></span>
      <span>{t("tools.nginxConfigGenerator.relatedGuides")}</span>
      <a href="/blog/004-enabling-quic-http3-nginx/">QUIC/HTTP3</a>
      <a href="/blog/005-implementing-tarpit-nginx/">Tarpit</a>
      <a href="/blog/003-implementing-content-security-policy-nginx/">CSP</a>
      <a href="/blog/001-secure-nginx-client-certificates/"
        >{t("tools.nginxConfigGenerator.relatedClientCerts")}</a
      >
    </div>

    {/* Output */}
    <div class="ngx-output-section">
      <div class="ngx-output-header">
        <span class="ngx-output-label">
          <span
            class="i-devicon:nginx"
            aria-hidden="true"
          ></span>
          {t("tools.nginxConfigGenerator.generatedConfig")}
        </span>
        <button
          type="button"
          class="ngx-copy-btn"
          aria-label={t("tools.nginxConfigGenerator.copyConfigAriaLabel")}
        >
          <span
            class="i-mdi:content-copy"
            aria-hidden="true"
          ></span>
          {t("tools.shared.copy")}
        </button>
      </div>
      {
        /* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- scrollable region requires keyboard access */
      }
      <pre
        class="ngx-output-code"
        tabindex="0"
        role="region"
        aria-label={t(
          "tools.nginxConfigGenerator.outputAriaLabel",
        )}><code id={`${uniqueId}-output`} /></pre>
      {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
    </div>
  </div>
</div>

<script is:inline define:vars={{ uniqueId, i18n }}>
  (function () {
    var container = document.querySelector('[data-ngx-id="' + uniqueId + '"]');
    if (!container) return;

    var el = function (id) {
      return document.getElementById(uniqueId + "-" + id);
    };

    // Server Basics
    var domainInput = el("domain");
    var rootInput = el("root");
    var rootField = el("root-field");
    var indexInput = el("index");
    var indexField = el("index-field");
    var serverTokensCheck = el("server-tokens");
    var charsetCheck = el("charset");
    var appModeRow = el("app-mode-row");
    var spaModeCheck = el("spa-mode");
    var phpFpmCheck = el("php-fpm");
    var phpFields = el("php-fields");
    var phpSocketInput = el("php-socket");

    // SSL / TLS
    var sslDetails = el("ssl-details");
    var sslCheck = el("ssl");
    var sslFields = el("ssl-fields");
    var certInput = el("cert");
    var keyInput = el("key");
    var http2Check = el("http2");
    var http3Check = el("http3");
    var hstsCheck = el("hsts");
    var ocspCheck = el("ocsp");
    var sslEarlyCheck = el("ssl-early");
    var redirectCheck = el("redirect-http");

    // Reverse Proxy
    var proxyDetails = el("proxy-details");
    var proxyCheck = el("proxy");
    var proxyFields = el("proxy-fields");
    var upstreamNameInput = el("upstream-name");
    var upstreamInput = el("upstream");
    var lbMethodSelect = el("lb-method");
    var keepaliveCheck = el("keepalive");
    var wsCheck = el("ws");
    var proxyBufferingCheck = el("proxy-buffering");
    var resolverCheck = el("resolver");
    var resolverFields = el("resolver-fields");
    var resolverServersInput = el("resolver-servers");
    var proxyCacheCheck = el("proxy-cache");
    var proxyCacheFields = el("proxy-cache-fields");
    var cacheZoneInput = el("cache-zone");
    var cacheValidTimeInput = el("cache-valid-time");

    // Security Headers
    var securityDetails = el("security-details");
    var xframeCheck = el("sec-xframe");
    var xctoCheck = el("sec-xcto");
    var referrerCheck = el("sec-referrer");
    var permissionsCheck = el("sec-permissions");
    var coopCheck = el("sec-coop");
    var cspCheck = el("sec-csp");
    var cspHint = el("csp-hint");

    // Access Control
    var accessDetails = el("access-details");
    var rateLimitCheck = el("rate-limit");
    var rateFields = el("rate-fields");
    var rateValue = el("rate-value");
    var rateBurst = el("rate-burst");
    var blockHiddenCheck = el("block-hidden");
    var blockExploitsCheck = el("block-exploits");
    var tarpitCheck = el("tarpit");
    var tarpitHint = el("tarpit-hint");
    var bodyLimitCheck = el("body-limit");

    // Performance
    var perfDetails = el("perf-details");
    var gzipCheck = el("gzip");
    var brotliCheck = el("brotli");
    var cacheCheck = el("cache");
    var openFileCacheCheck = el("open-file-cache");
    var sendfileCheck = el("sendfile");
    var logsCheck = el("logs");

    // Timeouts
    var timeoutsDetails = el("timeouts-details");
    var keepaliveTimeoutInput = el("keepalive-timeout");
    var clientBodyTimeoutInput = el("client-body-timeout");
    var clientHeaderTimeoutInput = el("client-header-timeout");
    var sendTimeoutInput = el("send-timeout");
    var keepaliveRequestsCheck = el("keepalive-requests");
    var proxyTimeoutFields = el("proxy-timeout-fields");
    var proxyReadTimeoutInput = el("proxy-read-timeout");
    var proxyConnectTimeoutInput = el("proxy-connect-timeout");

    // Output
    var output = el("output");
    var copyBtn = container.querySelector(".ngx-copy-btn");
    var presetBtns = container.querySelectorAll(".ngx-preset-btn");

    var I1 = "    ";
    var I2 = "        ";

    function generate() {
      var lines = [];
      var domain = domainInput.value.trim() || "example.com";
      var root = rootInput.value.trim() || "/var/www/html";
      var idx = indexInput.value.trim() || "index.html";
      var ssl = sslCheck.checked;
      var proxy = proxyCheck.checked;
      var upName = (upstreamNameInput.value.trim() || "backend_app").replace(
        /[^a-zA-Z0-9_]/g,
        "_",
      );
      var hasTarpit =
        tarpitCheck.checked &&
        (blockExploitsCheck.checked || blockHiddenCheck.checked);
      var spaMode = spaModeCheck.checked && !proxy;
      var phpMode = phpFpmCheck.checked && !proxy;

      // ─── http {} context directives ───

      // Rate limiting zone
      if (rateLimitCheck.checked) {
        var rate = parseInt(rateValue.value) || 10;
        lines.push("# Place in http {} context");
        lines.push(
          "limit_req_zone $binary_remote_addr zone=req_limit:10m rate=" +
            rate +
            "r/s;",
        );
        lines.push("");
      }

      // Tarpit zone
      if (hasTarpit) {
        lines.push("# Place in http {} context — tarpit rate limiter");
        lines.push(
          "limit_req_zone $binary_remote_addr zone=tarpit:10m rate=1r/m;",
        );
        lines.push("");
      }

      // WebSocket map block
      if (proxy && wsCheck.checked) {
        lines.push("# Place in http {} context — WebSocket upgrade map");
        lines.push("map $http_upgrade $connection_upgrade {");
        lines.push(I1 + "default upgrade;");
        lines.push(I1 + "''      close;");
        lines.push("}");
        lines.push("");
      }

      // Proxy cache zone
      if (proxy && proxyCacheCheck.checked) {
        var cacheName = (cacheZoneInput.value.trim() || "app_cache").replace(
          /[^a-zA-Z0-9_]/g,
          "_",
        );
        lines.push("# Place in http {} context — proxy cache zone");
        lines.push(
          "proxy_cache_path /var/cache/nginx/" +
            cacheName +
            " levels=1:2 keys_zone=" +
            cacheName +
            ":10m max_size=1g inactive=60m use_temp_path=off;",
        );
        lines.push("");
      }

      // ─── Upstream block ───
      if (proxy) {
        lines.push("upstream " + upName + " {");
        var lbMethod = lbMethodSelect.value;
        if (lbMethod === "least_conn") lines.push(I1 + "least_conn;");
        if (lbMethod === "ip_hash") lines.push(I1 + "ip_hash;");

        var servers = upstreamInput.value
          .trim()
          .split(",")
          .map(function (s) {
            return s.trim();
          })
          .filter(Boolean);
        if (servers.length === 0) servers = ["127.0.0.1:3000"];
        servers.forEach(function (srv) {
          lines.push(I1 + "server " + srv + ";");
        });

        if (keepaliveCheck.checked) {
          lines.push("");
          lines.push(I1 + "keepalive 64;");
        }
        lines.push("}");
        lines.push("");
      }

      // ─── HTTP redirect server block ───
      if (ssl && redirectCheck.checked) {
        lines.push("server {");
        lines.push(I1 + "listen 80;");
        lines.push(I1 + "listen [::]:80;");
        lines.push(I1 + "server_name " + domain + " www." + domain + ";");
        lines.push("");
        lines.push(I1 + "return 301 https://$host$request_uri;");
        lines.push("}");
        lines.push("");
      }

      // ─── Main server block ───
      lines.push("server {");

      // Listen directives
      if (ssl) {
        lines.push(I1 + "listen 443 ssl;");
        lines.push(I1 + "listen [::]:443 ssl;");

        if (http3Check.checked) {
          lines.push(I1 + "listen 443 quic reuseport;");
          lines.push(I1 + "listen [::]:443 quic reuseport;");
        }

        if (http2Check.checked) {
          lines.push(I1 + "http2 on;");
        }
      } else {
        lines.push(I1 + "listen 80;");
        lines.push(I1 + "listen [::]:80;");
      }

      lines.push(I1 + "server_name " + domain + " www." + domain + ";");
      lines.push("");

      // Root and index (only when not using proxy)
      if (!proxy) {
        lines.push(I1 + "root " + root + ";");
        lines.push(I1 + "index " + idx + ";");
        lines.push("");
      }

      // Server tokens
      if (serverTokensCheck.checked) {
        lines.push(I1 + "server_tokens off;");
      }

      // Charset
      if (charsetCheck.checked) {
        lines.push(I1 + "charset utf-8;");
      }

      if (serverTokensCheck.checked || charsetCheck.checked) lines.push("");

      // sendfile + tcp_nopush + tcp_nodelay
      if (sendfileCheck.checked) {
        lines.push(I1 + "# I/O Optimization");
        lines.push(I1 + "sendfile on;");
        lines.push(I1 + "tcp_nopush on;");
        lines.push(I1 + "tcp_nodelay on;");
        lines.push("");
      }

      // SSL configuration
      if (ssl) {
        lines.push(I1 + "# SSL / TLS");
        lines.push(
          I1 +
            "ssl_certificate " +
            (certInput.value.trim() ||
              "/etc/letsencrypt/live/" + domain + "/fullchain.pem") +
            ";",
        );
        lines.push(
          I1 +
            "ssl_certificate_key " +
            (keyInput.value.trim() ||
              "/etc/letsencrypt/live/" + domain + "/privkey.pem") +
            ";",
        );
        lines.push(I1 + "ssl_protocols TLSv1.2 TLSv1.3;");
        lines.push(
          I1 +
            "ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;",
        );
        lines.push(I1 + "ssl_prefer_server_ciphers off;");
        lines.push(I1 + "ssl_session_cache shared:SSL:10m;");
        lines.push(I1 + "ssl_session_timeout 1d;");
        lines.push(I1 + "ssl_session_tickets off;");

        if (ocspCheck.checked) {
          lines.push("");
          lines.push(I1 + "# OCSP Stapling");
          lines.push(I1 + "ssl_stapling on;");
          lines.push(I1 + "ssl_stapling_verify on;");
          lines.push(
            I1 +
              "ssl_trusted_certificate " +
              (certInput.value.trim() ||
                "/etc/letsencrypt/live/" + domain + "/fullchain.pem") +
              ";",
          );
          lines.push(I1 + "resolver 1.1.1.1 8.8.8.8 valid=300s;");
          lines.push(I1 + "resolver_timeout 5s;");
        }

        if (sslEarlyCheck.checked) {
          lines.push("");
          lines.push(I1 + "# 0-RTT Early Data (TLS 1.3)");
          lines.push(I1 + "ssl_early_data on;");
          lines.push(
            I1 + "# Protect against replay attacks with Early-Data header",
          );
          lines.push(I1 + "proxy_set_header Early-Data $ssl_early_data;");
        }

        if (http3Check.checked) {
          lines.push("");
          lines.push(I1 + "# QUIC / HTTP/3");
          lines.push(I1 + "add_header Alt-Svc 'h3=\":443\"; ma=86400' always;");
        }

        lines.push("");
      }

      // DNS Resolver (for proxy with domain names)
      if (proxy && resolverCheck.checked) {
        var resolverSrv =
          resolverServersInput.value.trim() || "1.1.1.1 8.8.8.8";
        lines.push(I1 + "# DNS Resolver");
        lines.push(I1 + "resolver " + resolverSrv + " valid=300s;");
        lines.push(I1 + "resolver_timeout 5s;");
        lines.push("");
      }

      // Security headers
      var hasSecHeaders =
        xframeCheck.checked ||
        xctoCheck.checked ||
        referrerCheck.checked ||
        permissionsCheck.checked ||
        coopCheck.checked ||
        cspCheck.checked ||
        (ssl && hstsCheck.checked);
      if (hasSecHeaders) {
        lines.push(I1 + "# Security Headers");
        if (ssl && hstsCheck.checked)
          lines.push(
            I1 +
              'add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;',
          );
        if (xframeCheck.checked)
          lines.push(I1 + 'add_header X-Frame-Options "DENY" always;');
        if (xctoCheck.checked)
          lines.push(
            I1 + 'add_header X-Content-Type-Options "nosniff" always;',
          );
        if (referrerCheck.checked)
          lines.push(
            I1 +
              'add_header Referrer-Policy "strict-origin-when-cross-origin" always;',
          );
        if (permissionsCheck.checked)
          lines.push(
            I1 +
              'add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;',
          );
        if (coopCheck.checked) {
          lines.push(
            I1 + 'add_header Cross-Origin-Opener-Policy "same-origin" always;',
          );
          lines.push(
            I1 +
              'add_header Cross-Origin-Resource-Policy "same-origin" always;',
          );
          lines.push(
            I1 +
              'add_header Cross-Origin-Embedder-Policy "require-corp" always;',
          );
        }
        if (cspCheck.checked) {
          lines.push(
            I1 +
              "# Basic CSP — use /tools/csp-builder/ to create a complete policy",
          );
          lines.push(
            I1 +
              "add_header Content-Security-Policy \"default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'\" always;",
          );
        }
        lines.push("");
      }

      // Client body limit
      if (bodyLimitCheck.checked) {
        lines.push(I1 + "client_max_body_size 16m;");
        lines.push("");
      }

      // Timeouts
      var kt = parseInt(keepaliveTimeoutInput.value) || 65;
      var cbt = parseInt(clientBodyTimeoutInput.value) || 60;
      var cht = parseInt(clientHeaderTimeoutInput.value) || 60;
      var st = parseInt(sendTimeoutInput.value) || 60;
      lines.push(I1 + "# Timeouts");
      lines.push(I1 + "keepalive_timeout " + kt + ";");
      lines.push(I1 + "client_body_timeout " + cbt + ";");
      lines.push(I1 + "client_header_timeout " + cht + ";");
      lines.push(I1 + "send_timeout " + st + ";");
      if (keepaliveRequestsCheck.checked) {
        lines.push(I1 + "keepalive_requests 1000;");
      }
      lines.push("");

      // Proxy timeouts
      if (proxy) {
        var prt = parseInt(proxyReadTimeoutInput.value) || 60;
        var pct = parseInt(proxyConnectTimeoutInput.value) || 60;
        lines.push(I1 + "# Proxy Timeouts");
        lines.push(I1 + "proxy_read_timeout " + prt + ";");
        lines.push(I1 + "proxy_connect_timeout " + pct + ";");
        lines.push("");
      }

      // Logs
      if (logsCheck.checked) {
        lines.push(I1 + "# Logging");
        lines.push(I1 + "access_log /var/log/nginx/" + domain + ".access.log;");
        lines.push(I1 + "error_log /var/log/nginx/" + domain + ".error.log;");
        lines.push("");
      }

      // Gzip
      if (gzipCheck.checked) {
        lines.push(I1 + "# Gzip Compression");
        lines.push(I1 + "gzip on;");
        lines.push(I1 + "gzip_vary on;");
        lines.push(I1 + "gzip_min_length 1024;");
        lines.push(I1 + "gzip_proxied any;");
        lines.push(I1 + "gzip_comp_level 6;");
        lines.push(
          I1 +
            "gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;",
        );
        lines.push("");
      }

      // Brotli
      if (brotliCheck.checked) {
        lines.push(I1 + "# Brotli Compression (requires ngx_brotli module)");
        lines.push(I1 + "brotli on;");
        lines.push(I1 + "brotli_comp_level 6;");
        lines.push(
          I1 +
            "brotli_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml font/woff2;",
        );
        lines.push("");
      }

      // Open file cache
      if (openFileCacheCheck.checked) {
        lines.push(I1 + "# Open File Cache");
        lines.push(I1 + "open_file_cache max=1000 inactive=20s;");
        lines.push(I1 + "open_file_cache_valid 30s;");
        lines.push(I1 + "open_file_cache_min_uses 2;");
        lines.push(I1 + "open_file_cache_errors on;");
        lines.push("");
      }

      // Rate limiting
      if (rateLimitCheck.checked) {
        var burst = parseInt(rateBurst.value) || 20;
        lines.push(I1 + "# Rate Limiting");
        lines.push(
          I1 + "limit_req zone=req_limit burst=" + burst + " nodelay;",
        );
        lines.push(I1 + "limit_req_status 429;");
        lines.push("");
      }

      // Block hidden files
      if (blockHiddenCheck.checked) {
        lines.push(I1 + "# Block hidden files (.git, .env, .htaccess, etc.)");
        lines.push(I1 + "location ~ /\\. {");
        if (hasTarpit) {
          lines.push(I2 + "limit_req zone=tarpit burst=1 nodelay;");
          lines.push(I2 + "limit_rate 50;  # bytes/sec — slow tarpit response");
          lines.push(I2 + "return 444;");
        } else {
          lines.push(I2 + "deny all;");
          lines.push(I2 + "return 404;");
        }
        lines.push(I1 + "}");
        lines.push("");
      }

      // Block common exploit paths
      if (blockExploitsCheck.checked) {
        lines.push(I1 + "# Block common exploit / scanner paths");
        lines.push(
          I1 +
            "location ~* ^/(wp-admin|wp-login|wp-content|wp-includes|xmlrpc\\.php|phpmyadmin|myadmin|mysql|admin|administrator|cgi-bin) {",
        );
        if (hasTarpit) {
          lines.push(I2 + "limit_req zone=tarpit burst=1 nodelay;");
          lines.push(
            I2 + "limit_rate 50;  # bytes/sec — waste attacker resources",
          );
          lines.push(I2 + "return 444;");
        } else {
          lines.push(I2 + "return 444;");
        }
        lines.push(I1 + "}");
        lines.push("");
      }

      // ─── Main location block ───
      if (proxy) {
        // Reverse proxy location
        lines.push(I1 + "location / {");

        // Proxy cache directives
        if (proxyCacheCheck.checked) {
          var cName = (cacheZoneInput.value.trim() || "app_cache").replace(
            /[^a-zA-Z0-9_]/g,
            "_",
          );
          lines.push(I2 + "proxy_cache " + cName + ";");
          lines.push(
            I2 +
              "proxy_cache_valid 200 302 " +
              (cacheValidTimeInput.value.trim() || "10m") +
              ";",
          );
          lines.push(I2 + "proxy_cache_valid 404 1m;");
          lines.push(
            I2 +
              "proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;",
          );
          lines.push(I2 + "proxy_cache_lock on;");
          lines.push("");
        }

        lines.push(I2 + "proxy_pass http://" + upName + ";");
        lines.push(I2 + "proxy_set_header Host $host;");
        lines.push(I2 + "proxy_set_header X-Real-IP $remote_addr;");
        lines.push(
          I2 + "proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;",
        );
        lines.push(I2 + "proxy_set_header X-Forwarded-Proto $scheme;");

        if (keepaliveCheck.checked && !wsCheck.checked) {
          lines.push("");
          lines.push(I2 + "proxy_http_version 1.1;");
          lines.push(I2 + 'proxy_set_header Connection "";');
        }

        if (wsCheck.checked) {
          lines.push("");
          lines.push(I2 + "# WebSocket Support");
          lines.push(I2 + "proxy_http_version 1.1;");
          lines.push(I2 + "proxy_set_header Upgrade $http_upgrade;");
          lines.push(I2 + "proxy_set_header Connection $connection_upgrade;");
          lines.push(I2 + "proxy_read_timeout 86400s;");
        }

        if (proxyBufferingCheck.checked) {
          lines.push("");
          lines.push(I2 + "# Proxy Buffering");
          lines.push(I2 + "proxy_buffering on;");
          lines.push(I2 + "proxy_buffer_size 16k;");
          lines.push(I2 + "proxy_buffers 4 64k;");
          lines.push(I2 + "proxy_busy_buffers_size 128k;");
        }

        if (sslEarlyCheck.checked && ssl) {
          lines.push(I2 + "proxy_set_header Early-Data $ssl_early_data;");
        }

        lines.push(I1 + "}");
      } else if (phpMode) {
        // PHP-FPM location
        lines.push(I1 + "location / {");
        lines.push(I2 + "try_files $uri $uri/ /index.php?$query_string;");
        lines.push(I1 + "}");
        lines.push("");

        var socket =
          phpSocketInput.value.trim() || "unix:/var/run/php/php-fpm.sock";
        lines.push(I1 + "# PHP-FPM Processing");
        lines.push(I1 + "location ~ \\.php$ {");
        lines.push(I2 + "fastcgi_pass " + socket + ";");
        lines.push(I2 + "fastcgi_index index.php;");
        lines.push(
          I2 +
            "fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;",
