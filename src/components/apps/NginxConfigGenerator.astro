        sslCheck.checked = true;
        http2Check.checked = true;
        http3Check.checked = false;
        gzipCheck.checked = true;
        brotliCheck.checked = false;
        cacheCheck.checked = true;
        wsCheck.checked = false;
        keepaliveCheck.checked = true;
        proxyBufferingCheck.checked = false;
        rateLimitCheck.checked = false;
        blockHiddenCheck.checked = true;
        blockExploitsCheck.checked = false;
        tarpitCheck.checked = false;
        cspCheck.checked = false;
        ocspCheck.checked = true;
        permissionsCheck.checked = false;
        coopCheck.checked = false;
        openFileCacheCheck.checked = false;
        serverTokensCheck.checked = true;
        bodyLimitCheck.checked = true;
        sslEarlyCheck.checked = false;
        upstreamNameInput.value = "backend_app";
        upstreamInput.value = "127.0.0.1:3000";
        lbMethodSelect.value = "round-robin";
      },
      spa: function () {
        proxyCheck.checked = false;
        sslCheck.checked = true;
        http2Check.checked = true;
        http3Check.checked = false;
        gzipCheck.checked = true;
        brotliCheck.checked = false;
        cacheCheck.checked = true;
        wsCheck.checked = false;
        rateLimitCheck.checked = false;
        blockHiddenCheck.checked = true;
        blockExploitsCheck.checked = false;
        tarpitCheck.checked = false;
        cspCheck.checked = false;
        ocspCheck.checked = true;
        permissionsCheck.checked = false;
        coopCheck.checked = false;
        openFileCacheCheck.checked = false;
        serverTokensCheck.checked = true;
        bodyLimitCheck.checked = true;
        sslEarlyCheck.checked = false;
        indexInput.value = "index.html";
      },
      php: function () {
        proxyCheck.checked = false;
        sslCheck.checked = true;
        http2Check.checked = true;
        http3Check.checked = false;
        gzipCheck.checked = true;
        brotliCheck.checked = false;
        cacheCheck.checked = true;
        wsCheck.checked = false;
        rateLimitCheck.checked = false;
        blockHiddenCheck.checked = true;
        blockExploitsCheck.checked = true;
        tarpitCheck.checked = false;
        cspCheck.checked = false;
        ocspCheck.checked = true;
        permissionsCheck.checked = false;
        coopCheck.checked = false;
        openFileCacheCheck.checked = false;
        serverTokensCheck.checked = true;
        bodyLimitCheck.checked = true;
        sslEarlyCheck.checked = false;
        indexInput.value = "index.php index.html";
      },
      api: function () {
        proxyCheck.checked = true;
        sslCheck.checked = true;
        http2Check.checked = true;
        http3Check.checked = false;
        gzipCheck.checked = true;
        brotliCheck.checked = false;
        cacheCheck.checked = false;
        wsCheck.checked = false;
        keepaliveCheck.checked = true;
        proxyBufferingCheck.checked = true;
        rateLimitCheck.checked = true;
        rateValue.value = "30";
        rateBurst.value = "50";
        blockHiddenCheck.checked = true;
        blockExploitsCheck.checked = true;
        tarpitCheck.checked = false;
        cspCheck.checked = false;
        ocspCheck.checked = true;
        permissionsCheck.checked = false;
        coopCheck.checked = false;
        openFileCacheCheck.checked = false;
        serverTokensCheck.checked = true;
        bodyLimitCheck.checked = true;
        sslEarlyCheck.checked = false;
        upstreamNameInput.value = "api_backend";
        upstreamInput.value = "127.0.0.1:8080";
        lbMethodSelect.value = "round-robin";
      },
      hardened: function () {
        proxyCheck.checked = false;
        sslCheck.checked = true;
        http2Check.checked = true;
        http3Check.checked = true;
        gzipCheck.checked = true;
        brotliCheck.checked = true;
        cacheCheck.checked = true;
        wsCheck.checked = false;
        rateLimitCheck.checked = true;
        rateValue.value = "10";
        rateBurst.value = "20";
        blockHiddenCheck.checked = true;
        blockExploitsCheck.checked = true;
        tarpitCheck.checked = true;
        cspCheck.checked = true;
        hstsCheck.checked = true;
        ocspCheck.checked = true;
        sslEarlyCheck.checked = true;
