    border-color: var(--color-primary);
  }

  .enc-copy-btn.copied {
    color: #047857;
    border-color: #10b981;
  }

  .enc-download-btn[hidden] {
    display: none;
  }

  .enc-download-btn:hover {
    color: #047857;
    border-color: #10b981;
  }

  .enc-info-row {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.75rem;
    color: var(--color-text-muted);
