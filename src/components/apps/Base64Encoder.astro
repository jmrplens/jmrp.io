  .enc-ratio {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .enc-error {
    font-weight: var(--fw-medium);
    color: #b91c1c;
  }

  @media (width <= 640px) {
    .enc-layout {
      padding: 1rem;
    }

    .enc-dropzone {
      padding: 1.5rem 1rem;
    }
  }
</style>
