  .enc-drop-privacy span[class^="i-"] {
    width: 14px;
    height: 14px;
  }

  .enc-file-input {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    opacity: 0%;
  }

  /* Data URI toggle */
  .enc-data-uri-toggle {
    display: flex;
    gap: 0.375rem;
    align-items: center;
    margin-left: auto;
    font-size: 0.8rem;
    font-weight: var(--fw-normal);
    color: var(--color-text-muted);
    text-transform: none;
    letter-spacing: normal;
    cursor: pointer;
  }

  .enc-data-uri-toggle input[type="checkbox"] {
    width: 14px;
    height: 14px;
    accent-color: var(--color-primary);
  }

  /* File preview */
  .enc-file-preview {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.875rem;
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-sm);
  }

  .enc-file-preview[hidden] {
    display: none !important;
  }

  .enc-file-info {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .enc-file-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-primary);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
  }

  .enc-file-icon span {
    width: 22px;
    height: 22px;
  }

  .enc-file-details {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .enc-file-name {
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.9rem;
    font-weight: var(--fw-medium);
    color: var(--color-text);
    white-space: nowrap;
  }

  .enc-file-meta {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .enc-file-remove {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--color-text-muted);
    cursor: pointer;
    background: transparent;
    border: none;
    border-radius: 50%;
    transition: all 0.15s;
  }

  .enc-file-remove span {
    width: 18px;
    height: 18px;
  }

  .enc-file-remove:hover {
    color: #b91c1c;
    background: var(--color-bg-secondary);
  }

  /* Preview content */
  .enc-preview-content :global(img) {
    max-width: 100%;
    max-height: 200px;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .enc-preview-content :global(audio) {
    width: 100%;
  }

  .enc-preview-content :global(video) {
    max-width: 100%;
    max-height: 240px;
    border-radius: var(--radius-sm);
  }

  .enc-preview-content :global(pre) {
    max-height: 150px;
    padding: 0.75rem;
    margin: 0;
    overflow: auto;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.4;
    word-break: break-all;
    white-space: pre-wrap;
    background: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
  }

  /* Direction toggle */
  .enc-direction {
    display: flex;
    justify-content: center;
