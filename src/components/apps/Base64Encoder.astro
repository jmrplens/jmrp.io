    display: flex;
    gap: 0.375rem;
    align-items: center;
    padding: 0.25rem 0.75rem;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: #047857;
    background: #ecfdf5;
    border-radius: 999px;
