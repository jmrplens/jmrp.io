    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.5;
    word-break: break-all;
    white-space: pre-wrap;
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-sm);
  }

  .enc-output-actions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
