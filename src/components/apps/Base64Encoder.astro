---
/**
 * Base64Encoder Component
 * Multi-format encoding/decoding tool with file support.
 * Supports Base64, Base64URL, URL encoding, Hex, HTML entities, and Binary.
 * Files (images, audio, documents, etc.) can be encoded/decoded entirely client-side.
 *
 * Usage:
 * <Base64Encoder title="Encoding Tool" />
 */

interface Props {
  title?: string;
}

const { title = "Base64 & Encoding Tool" } = Astro.props;
const uniqueId = `enc-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

const formats = [
  { id: "base64", name: "Base64" },
  { id: "base64url", name: "Base64URL" },
  { id: "url", name: "URL Encoding" },
  { id: "hex", name: "Hexadecimal" },
  { id: "html", name: "HTML Entities" },
  { id: "binary", name: "Binary" },
];
---

<div
  class="enc-tool"
  data-enc-id={uniqueId}
>
  {title && <div class="enc-title">{title}</div>}

  <div class="enc-layout">
    {/* Input mode tabs */}
    <div
      class="enc-mode-tabs"
      role="tablist"
      aria-label="Input mode"
    >
      <button
        type="button"
        class="enc-mode-btn active"
        role="tab"
        aria-selected="true"
        data-mode="text"
      >
        <span
          class="i-mdi:text-box-outline"
          aria-hidden="true"
        ></span>
        <span>Text</span>
      </button>
      <button
        type="button"
        class="enc-mode-btn"
        role="tab"
        aria-selected="false"
        data-mode="file"
      >
        <span
          class="i-mdi:file-upload-outline"
          aria-hidden="true"
        ></span>
        <span>File</span>
      </button>
    </div>

    {/* Text Input Panel */}
    <div
      class="enc-panel enc-text-panel"
      data-panel="text"
    >
      <div class="enc-panel-header">
        <span
          class="i-mdi:text-box-outline enc-panel-icon"
          aria-hidden="true"
        ></span>
        <span>Input</span>
        <select
          id={`${uniqueId}-input-format`}
          class="enc-format-select"
          aria-label="Input format"
        >
          <option value="text">Plain Text</option>
          {formats.map((f) => <option value={f.id}>{f.name}</option>)}
        </select>
      </div>
      <textarea
        id={`${uniqueId}-input`}
        class="enc-textarea"
        rows="6"
        placeholder="Enter text to encode/decode..."
        spellcheck="false"
        aria-label="Input text"
        >Hello, World! 🌍</textarea
      >
      <div class="enc-info-row">
        <span
          class="enc-byte-count"
          id={`${uniqueId}-input-bytes`}
          >0 bytes</span
        >
      </div>
    </div>

    {/* File Input Panel */}
    <div
      class="enc-panel enc-file-panel"
      data-panel="file"
      hidden
    >
      <div class="enc-panel-header">
        <span
          class="i-mdi:file-upload-outline enc-panel-icon"
          aria-hidden="true"
        ></span>
        <span>File Input</span>
        <label class="enc-data-uri-toggle">
          <input
            type="checkbox"
            id={`${uniqueId}-data-uri`}
          />
          <span>Include Data URI prefix</span>
        </label>
      </div>

      <div
        class="enc-dropzone"
        id={`${uniqueId}-dropzone`}
        role="button"
        tabindex="0"
        aria-label="Drop a file here or click to browse. All processing is local."
      >
        <span
          class="i-mdi:cloud-upload-outline enc-drop-icon"
          aria-hidden="true"
        ></span>
        <span class="enc-drop-text">Drop a file here or click to browse</span>
        <span class="enc-drop-hint"
          >Images, audio, documents, or any file type</span
        >
        <span class="enc-drop-privacy">
          <span
            class="i-mdi:shield-check-outline"
            aria-hidden="true"
          ></span>
          All processing stays in your browser
        </span>
        <input
          type="file"
          id={`${uniqueId}-file-input`}
          class="enc-file-input"
          aria-label="Select file to encode"
        />
      </div>

      {/* File preview area */}
      <div
        class="enc-file-preview"
        id={`${uniqueId}-file-preview`}
        hidden
      >
        <div class="enc-file-info">
          <span
            class="enc-file-icon"
            id={`${uniqueId}-file-type-icon`}
          >
            <span
              class="i-mdi:file-outline"
              aria-hidden="true"
            ></span>
          </span>
          <div class="enc-file-details">
            <span
              class="enc-file-name"
              id={`${uniqueId}-file-name`}
            ></span>
            <span
              class="enc-file-meta"
              id={`${uniqueId}-file-meta`}
            ></span>
          </div>
          <button
            type="button"
            class="enc-file-remove"
            aria-label="Remove file"
          >
            <span
              class="i-mdi:close-circle"
              aria-hidden="true"
            ></span>
          </button>
        </div>
        <div
          class="enc-preview-content"
          id={`${uniqueId}-preview-content`}
        >
        </div>
      </div>
    </div>

    {/* Direction toggle */}
    <div class="enc-direction">
      <button
        type="button"
        class="enc-swap-btn"
        aria-label="Swap input and output"
      >
        <span
          class="i-mdi:swap-vertical"
          aria-hidden="true"
        ></span>
      </button>
    </div>

    {/* Output */}
    <div class="enc-panel">
      <div class="enc-panel-header">
        <span
          class="i-mdi:code-braces enc-panel-icon"
          aria-hidden="true"
        ></span>
        <span>Output</span>
        <select
          id={`${uniqueId}-output-format`}
          class="enc-format-select enc-text-only-control"
          aria-label="Output format"
        >
          {
            formats.map((f) => (
              <option
                value={f.id}
                selected={f.id === "base64"}
              >
                {f.name}
              </option>
            ))
          }
          <option value="text">Plain Text</option>
        </select>
      </div>
      <div class="enc-output-wrapper">
        {
          /* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- scrollable region requires keyboard access */
        }
        <pre
          class="enc-output"
          tabindex="0"
          role="region"
          aria-label="Encoded or decoded output"><code id={`${uniqueId}-output`}>...</code></pre>
        {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
        <div class="enc-output-actions">
          <button
            type="button"
            class="enc-copy-btn"
            aria-label="Copy output"
          >
            <span
              class="i-mdi:content-copy"
              aria-hidden="true"
            ></span>
            <span class="enc-copy-text">Copy</span>
          </button>
          <button
            type="button"
            class="enc-download-btn"
            aria-label="Download decoded file"
            hidden
          >
            <span
              class="i-mdi:download"
              aria-hidden="true"
            ></span>
            <span class="enc-download-text">Download</span>
          </button>
        </div>
      </div>
      <div class="enc-info-row">
        <span
          class="enc-byte-count"
          id={`${uniqueId}-output-bytes`}
          >0 bytes</span
        >
        <span
          class="enc-ratio"
          id={`${uniqueId}-ratio`}
          hidden
        ></span>
        <span
          class="enc-error"
          id={`${uniqueId}-error`}
          hidden
        ></span>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ uniqueId }}>
  (function () {
    var container = document.querySelector('[data-enc-id="' + uniqueId + '"]');
    if (!container) return;

    var inputEl = document.getElementById(uniqueId + "-input");
    var outputEl = document.getElementById(uniqueId + "-output");
    var inputFormat = document.getElementById(uniqueId + "-input-format");
    var outputFormat = document.getElementById(uniqueId + "-output-format");
    var inputBytes = document.getElementById(uniqueId + "-input-bytes");
    var outputBytes = document.getElementById(uniqueId + "-output-bytes");
    var errorEl = document.getElementById(uniqueId + "-error");
    var ratioEl = document.getElementById(uniqueId + "-ratio");
    var copyBtn = container.querySelector(".enc-copy-btn");
    var swapBtn = container.querySelector(".enc-swap-btn");
    var downloadBtn = container.querySelector(".enc-download-btn");

    // File-related elements
    var modeBtns = container.querySelectorAll(".enc-mode-btn");
    var textPanel = container.querySelector('[data-panel="text"]');
    var filePanel = container.querySelector('[data-panel="file"]');
    var dropzone = document.getElementById(uniqueId + "-dropzone");
    var fileInput = document.getElementById(uniqueId + "-file-input");
    var filePreview = document.getElementById(uniqueId + "-file-preview");
    var previewContent = document.getElementById(uniqueId + "-preview-content");
    var fileNameEl = document.getElementById(uniqueId + "-file-name");
    var fileMetaEl = document.getElementById(uniqueId + "-file-meta");
    var fileTypeIcon = document.getElementById(uniqueId + "-file-type-icon");
    var fileRemoveBtn = container.querySelector(".enc-file-remove");
    var dataUriCheckbox = document.getElementById(uniqueId + "-data-uri");
    var textOnlyControls = container.querySelectorAll(".enc-text-only-control");

    if (!inputEl || !outputEl) return;

    var currentMode = "text";
    var currentFileData = null; // { bytes, name, type, size }

    // ========================
    // Encoding functions
    // ========================
    function textToBytes(text) {
      return new TextEncoder().encode(text);
    }

    function bytesToText(bytes) {
      return new TextDecoder().decode(bytes);
    }

    function toBase64(bytes) {
      var chunkSize = 8192;
      var parts = [];
      for (var i = 0; i < bytes.length; i += chunkSize) {
        parts.push(
          String.fromCharCode.apply(null, bytes.subarray(i, i + chunkSize)),
        );
      }
      return btoa(parts.join(""));
    }

    function fromBase64(str) {
      try {
        var cleaned = str.trim();
        // Remove data URI prefix if present
        var dataUriMatch = cleaned.match(/^data:[^;]*;base64,(.*)$/s);
        if (dataUriMatch) cleaned = dataUriMatch[1];
        // Pad if needed
        while (cleaned.length % 4) cleaned += "=";
        var bin = atob(cleaned);
        var bytes = new Uint8Array(bin.length);
        for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
        return bytes;
      } catch (_e) {
        return null;
      }
    }

    function toBase64Url(bytes) {
      return toBase64(bytes)
        .replace(/\+/g, "-")
        .replace(/\//g, "_")
        .replace(/=+$/, "");
    }

    function fromBase64Url(str) {
      var s = str.trim().replace(/-/g, "+").replace(/_/g, "/");
      while (s.length % 4) s += "=";
      return fromBase64(s);
    }

    function toHex(bytes) {
      return Array.from(bytes)
        .map(function (b) {
          return b.toString(16).padStart(2, "0");
        })
        .join(" ");
    }

    function fromHex(str) {
      try {
        var hex = str.trim().replace(/\s+/g, "").replace(/0x/gi, "");
        if (hex.length % 2 !== 0) return null;
        var bytes = new Uint8Array(hex.length / 2);
        for (var i = 0; i < hex.length; i += 2) {
          var val = parseInt(hex.substring(i, i + 2), 16);
          if (isNaN(val)) return null;
          bytes[i / 2] = val;
        }
        return bytes;
      } catch (_e) {
        return null;
      }
    }

    function toUrlEncoding(bytes) {
      return encodeURIComponent(bytesToText(bytes));
    }

    function fromUrlEncoding(str) {
      try {
        return textToBytes(decodeURIComponent(str.trim()));
      } catch (_e) {
        return null;
      }
    }

    function toHtmlEntities(bytes) {
      var text = bytesToText(bytes);
      return text
        .split("")
        .map(function (ch) {
          var code = ch.codePointAt(0);
          if (
            code > 127 ||
            ch === "&" ||
            ch === "<" ||
            ch === ">" ||
            ch === '"' ||
            ch === "'"
          ) {
            return "&#" + code + ";";
          }
          return ch;
        })
        .join("");
    }

    function fromHtmlEntities(str) {
      try {
        var decoded = str
          .replace(/&#(\d+);/g, function (_, n) {
            return String.fromCodePoint(parseInt(n));
          })
          .replace(/&#x([0-9a-f]+);/gi, function (_, n) {
            return String.fromCodePoint(parseInt(n, 16));
          })
          .replace(/&amp;/g, "&")
          .replace(/&lt;/g, "<")
          .replace(/&gt;/g, ">")
          .replace(/&quot;/g, '"')
          .replace(/&apos;/g, "'");
        return textToBytes(decoded);
      } catch (_e) {
        return null;
      }
    }

    function toBinary(bytes) {
      return Array.from(bytes)
        .map(function (b) {
          return b.toString(2).padStart(8, "0");
        })
        .join(" ");
    }

    function fromBinary(str) {
      try {
        var bits = str.trim().replace(/\s+/g, "");
        if (bits.length % 8 !== 0) return null;
        var bytes = new Uint8Array(bits.length / 8);
        for (var i = 0; i < bits.length; i += 8) {
          var val = parseInt(bits.substring(i, i + 8), 2);
          if (isNaN(val)) return null;
          bytes[i / 8] = val;
        }
        return bytes;
      } catch (_e) {
        return null;
      }
    }

    function decode(str, format) {
      if (format === "text") return textToBytes(str);
      if (format === "base64") return fromBase64(str);
      if (format === "base64url") return fromBase64Url(str);
      if (format === "url") return fromUrlEncoding(str);
      if (format === "hex") return fromHex(str);
      if (format === "html") return fromHtmlEntities(str);
      if (format === "binary") return fromBinary(str);
      return textToBytes(str);
    }

    function encode(bytes, format) {
      if (format === "text") return bytesToText(bytes);
      if (format === "base64") return toBase64(bytes);
      if (format === "base64url") return toBase64Url(bytes);
      if (format === "url") return toUrlEncoding(bytes);
      if (format === "hex") return toHex(bytes);
      if (format === "html") return toHtmlEntities(bytes);
      if (format === "binary") return toBinary(bytes);
      return bytesToText(bytes);
    }

    // ========================
    // File utilities
    // ========================
    function formatSize(bytes) {
      if (bytes === 0) return "0 B";
      var units = ["B", "KB", "MB", "GB"];
      var i = Math.floor(Math.log(bytes) / Math.log(1024));
      return (
        (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 2 : 0) + " " + units[i]
      );
    }

    function getMimeCategory(type) {
      if (!type) return "unknown";
      if (type.startsWith("image/")) return "image";
      if (type.startsWith("audio/")) return "audio";
      if (type.startsWith("video/")) return "video";
      if (type.startsWith("text/")) return "text";
      if (type.includes("pdf")) return "pdf";
      if (
        type.includes("json") ||
        type.includes("xml") ||
        type.includes("javascript")
      )
        return "code";
      if (
        type.includes("zip") ||
        type.includes("tar") ||
        type.includes("gzip") ||
        type.includes("rar") ||
        type.includes("7z")
      )
        return "archive";
      return "unknown";
    }

    /** Detect MIME type from Data URI prefix or magic bytes */
    function detectMimeFromBase64(input) {
      var cleaned = input.trim();
      var mime = "application/octet-stream";
      var ext = "bin";

      // Check for Data URI prefix: data:image/png;base64,...
      var dataUriMatch = cleaned.match(/^data:([^;,]+);base64,/i);
      if (dataUriMatch) {
        mime = dataUriMatch[1];
      } else {
        // Try magic bytes detection from decoded content
        try {
          var padded = cleaned;
          while (padded.length % 4) padded += "=";
          var bin = atob(padded.slice(0, 32));
          var b = [];
          for (var i = 0; i < bin.length; i++) b.push(bin.charCodeAt(i));

          if (b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4e && b[3] === 0x47)
            mime = "image/png";
          else if (b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff)
            mime = "image/jpeg";
          else if (
            b[0] === 0x47 &&
            b[1] === 0x49 &&
            b[2] === 0x46 &&
            b[3] === 0x38
          )
            mime = "image/gif";
          else if (
            b[0] === 0x52 &&
            b[1] === 0x49 &&
            b[2] === 0x46 &&
            b[3] === 0x46 &&
            b[8] === 0x57 &&
            b[9] === 0x45 &&
            b[10] === 0x42 &&
            b[11] === 0x50
          )
            mime = "image/webp";
          else if (
            b[0] === 0x25 &&
            b[1] === 0x50 &&
            b[2] === 0x44 &&
            b[3] === 0x46
          )
            mime = "application/pdf";
          else if (
            b[0] === 0x50 &&
            b[1] === 0x4b &&
            b[2] === 0x03 &&
            b[3] === 0x04
          )
            mime = "application/zip";
          else if (b[0] === 0x49 && b[1] === 0x44 && b[2] === 0x33)
            mime = "audio/mpeg";
          else if (b[0] === 0xff && (b[1] & 0xe0) === 0xe0) mime = "audio/mpeg";
          else if (
            b[0] === 0x4f &&
            b[1] === 0x67 &&
            b[2] === 0x67 &&
            b[3] === 0x53
          )
            mime = "audio/ogg";
          else if (
            b[0] === 0x52 &&
            b[1] === 0x49 &&
            b[2] === 0x46 &&
            b[3] === 0x46 &&
            b[8] === 0x57 &&
            b[9] === 0x41 &&
            b[10] === 0x56 &&
            b[11] === 0x45
          )
            mime = "audio/wav";
          else if (
            b[4] === 0x66 &&
            b[5] === 0x74 &&
            b[6] === 0x79 &&
            b[7] === 0x70
          )
            mime = "video/mp4";
          else if (
            b[0] === 0x1a &&
            b[1] === 0x45 &&
            b[2] === 0xdf &&
            b[3] === 0xa3
          )
            mime = "video/webm";
          else if (b[0] === 0x3c) {
            var snippet = bin.slice(0, 20).toLowerCase();
            if (snippet.includes("<svg")) mime = "image/svg+xml";
            else if (snippet.includes("<?xml") || snippet.includes("<html"))
              mime = "text/xml";
          }
        } catch (_e) {
          /* ignore decode errors */
        }
      }

      // Map MIME to file extension
      var extMap = {
        "image/png": "png",
        "image/jpeg": "jpg",
        "image/gif": "gif",
        "image/webp": "webp",
        "image/svg+xml": "svg",
        "application/pdf": "pdf",
        "application/zip": "zip",
        "audio/mpeg": "mp3",
        "audio/ogg": "ogg",
        "audio/wav": "wav",
        "video/mp4": "mp4",
        "video/webm": "webm",
        "text/xml": "xml",
        "text/plain": "txt",
        "text/html": "html",
        "application/json": "json",
      };
      ext = extMap[mime] || "bin";

      return { mime: mime, ext: ext };
    }

    function getFileIconClass(type) {
      var cat = getMimeCategory(type);
      var icons = {
        image: "i-mdi:file-image-outline",
        audio: "i-mdi:file-music-outline",
        video: "i-mdi:file-video-outline",
        text: "i-mdi:file-document-outline",
        pdf: "i-mdi:file-pdf-box",
        code: "i-mdi:file-code-outline",
        archive: "i-mdi:folder-zip-outline",
        unknown: "i-mdi:file-outline",
      };
      return icons[cat] || icons.unknown;
    }

    function showPreview(file, bytes) {
      if (!filePreview || !previewContent) return;
      filePreview.hidden = false;
      previewContent.innerHTML = "";

      if (fileNameEl) fileNameEl.textContent = file.name;
      if (fileMetaEl) {
        fileMetaEl.textContent =
          formatSize(file.size) + " \u2022 " + (file.type || "unknown type");
      }

      // Update icon
      if (fileTypeIcon) {
        fileTypeIcon.innerHTML =
          '<span class="' +
          getFileIconClass(file.type) +
          '" aria-hidden="true"></span>';
      }

      var cat = getMimeCategory(file.type);

      if (cat === "image") {
        var img = document.createElement("img");
        img.src = URL.createObjectURL(file);
        img.alt = "Preview of " + file.name;
        img.className = "enc-preview-image";
        img.addEventListener("load", function () {
          URL.revokeObjectURL(img.src);
        });
        previewContent.appendChild(img);
      } else if (cat === "audio") {
        var audio = document.createElement("audio");
        audio.controls = true;
        audio.src = URL.createObjectURL(file);
        audio.className = "enc-preview-audio";
        audio.setAttribute("aria-label", "Audio preview: " + file.name);
        previewContent.appendChild(audio);
      } else if (cat === "video") {
        var video = document.createElement("video");
        video.controls = true;
        video.src = URL.createObjectURL(file);
        video.className = "enc-preview-video";
        video.setAttribute("aria-label", "Video preview: " + file.name);
        previewContent.appendChild(video);
      } else if (cat === "text" || cat === "code") {
        if (bytes.length < 100000) {
          var text = bytesToText(bytes);
          var preview =
            text.length > 2000 ? text.substring(0, 2000) + "\n..." : text;
          var pre = document.createElement("pre");
          pre.className = "enc-preview-text";
          pre.textContent = preview;
          previewContent.appendChild(pre);
        }
      }
    }

    function clearFilePreview() {
      currentFileData = null;
      if (filePreview) filePreview.hidden = true;
      if (previewContent) previewContent.innerHTML = "";
      if (fileInput) fileInput.value = "";
      if (dropzone) dropzone.classList.remove("has-file");
      updateOutput();
    }

    // ========================
    // Mode switching
    // ========================
    function setMode(mode) {
      currentMode = mode;
      modeBtns.forEach(function (btn) {
        var isActive = btn.getAttribute("data-mode") === mode;
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-selected", isActive ? "true" : "false");
      });

      if (textPanel) textPanel.hidden = mode !== "text";
      if (filePanel) filePanel.hidden = mode !== "file";

      // Hide output format selector in file mode (always base64)
      textOnlyControls.forEach(function (ctrl) {
        ctrl.hidden = mode === "file";
      });

      // Show/hide download button based on mode and format
      updateDownloadVisibility(mode);

      updateOutput();
    }

    modeBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        setMode(btn.getAttribute("data-mode") || "text");
      });
    });

    // ========================
    // File handling
    // ========================
    function handleFile(file) {
      if (!file) return;

      // Max 50MB client-side
      if (file.size > 50 * 1024 * 1024) {
        showError("File too large (max 50 MB)");
        return;
      }

      var reader = new FileReader();
      reader.onload = function (e) {
        var arrayBuffer = e.target.result;
        var bytes = new Uint8Array(arrayBuffer);
        currentFileData = {
          bytes: bytes,
          name: file.name,
          type: file.type || "application/octet-stream",
          size: file.size,
        };
        showPreview(file, bytes);
        if (dropzone) dropzone.classList.add("has-file");
        updateOutput();
      };
      reader.onerror = function () {
        showError("Failed to read the file");
      };
      reader.readAsArrayBuffer(file);
    }

    // Dropzone click
    if (dropzone) {
      dropzone.addEventListener("click", function (e) {
        if (
          e.target === fileRemoveBtn ||
          (fileRemoveBtn && fileRemoveBtn.contains(e.target))
        )
          return;
        if (fileInput) fileInput.click();
      });
      dropzone.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          if (fileInput) fileInput.click();
        }
      });
    }

    // File input change
    if (fileInput) {
      fileInput.addEventListener("change", function () {
        if (fileInput.files && fileInput.files[0]) {
          handleFile(fileInput.files[0]);
        }
      });
    }

    // Drag and drop
    if (dropzone) {
      ["dragenter", "dragover"].forEach(function (evt) {
        dropzone.addEventListener(evt, function (e) {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add("drag-over");
        });
      });
      ["dragleave", "drop"].forEach(function (evt) {
        dropzone.addEventListener(evt, function (e) {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove("drag-over");
        });
      });
      dropzone.addEventListener("drop", function (e) {
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
          handleFile(e.dataTransfer.files[0]);
        }
      });
    }

    // Remove file button
    if (fileRemoveBtn) {
      fileRemoveBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        clearFilePreview();
      });
    }

    // Data URI toggle
    if (dataUriCheckbox) {
      dataUriCheckbox.addEventListener("change", updateOutput);
    }

    // ========================
    // Update output
    // ========================
    function showError(msg) {
      if (errorEl) {
        errorEl.textContent = msg;
        errorEl.hidden = false;
      }
    }

    function updateOutput() {
      if (errorEl) errorEl.hidden = true;
      if (ratioEl) ratioEl.hidden = true;

      if (currentMode === "file") {
        updateFileOutput();
      } else {
        updateTextOutput();
      }
    }

    function updateTextOutput() {
      var input = inputEl.value;
      var inFmt = inputFormat.value;
      var outFmt = outputFormat.value;

      if (!input) {
        outputEl.textContent = "(Enter text above)";
        if (inputBytes) inputBytes.textContent = "0 bytes";
        if (outputBytes) {
          outputBytes.textContent = "0 bytes";
          outputBytes.hidden = false;
        }
        if (ratioEl) ratioEl.hidden = true;
        return;
      }

      var bytes = decode(input, inFmt);

      if (!bytes) {
        outputEl.textContent = "Invalid input for selected format";
        showError("Could not decode input");
        return;
      }

      var inSize = new TextEncoder().encode(input).length;
      if (inputBytes) inputBytes.textContent = formatSize(inSize);

      try {
        var result = encode(bytes, outFmt);
        outputEl.textContent = result;
        var outSize = new TextEncoder().encode(result).length;

        // Show size comparison (hides outputBytes to avoid duplicate)
        if (ratioEl && inSize > 0) {
          if (outputBytes) outputBytes.hidden = true;
          var diff = outSize - inSize;
          var pct = ((Math.abs(diff) / inSize) * 100).toFixed(1);
          var arrow = " \u2192 ";
          if (diff > 0) {
            ratioEl.textContent =
              formatSize(inSize) +
              arrow +
              formatSize(outSize) +
              " (+" +
              formatSize(diff) +
              ", " +
              pct +
              "% larger)";
          } else if (diff < 0) {
            ratioEl.textContent =
              formatSize(inSize) +
              arrow +
              formatSize(outSize) +
              " (-" +
              formatSize(Math.abs(diff)) +
              ", " +
              pct +
              "% smaller)";
          } else {
            ratioEl.textContent =
              formatSize(inSize) + arrow + formatSize(outSize) + " (same size)";
          }
          ratioEl.hidden = false;
        }
      } catch (_e) {
        outputEl.textContent = "Encoding error";
        showError("Encoding failed");
      }
    }

    function updateFileOutput() {
      if (!currentFileData) {
        outputEl.textContent = "(Select a file above)";
        if (inputBytes) inputBytes.textContent = "0 bytes";
        if (outputBytes) {
          outputBytes.textContent = "0 bytes";
          outputBytes.hidden = false;
        }
        if (ratioEl) ratioEl.hidden = true;
        return;
      }

      var bytes = currentFileData.bytes;
      var base64 = toBase64(bytes);
      var includeDataUri = dataUriCheckbox && dataUriCheckbox.checked;
      var result = includeDataUri
        ? "data:" + currentFileData.type + ";base64," + base64
        : base64;

      outputEl.textContent = result;

      var inSize = currentFileData.size;
      var outSize = result.length;
      if (inputBytes) inputBytes.textContent = formatSize(inSize);

      if (ratioEl && inSize > 0) {
        if (outputBytes) outputBytes.hidden = true;
        var diff = outSize - inSize;
        var pct = ((Math.abs(diff) / inSize) * 100).toFixed(1);
        var arrow = " \u2192 ";
        if (diff > 0) {
          ratioEl.textContent =
            formatSize(inSize) +
            arrow +
            formatSize(outSize) +
            " (+" +
            formatSize(diff) +
            ", " +
            pct +
            "% larger)";
        } else if (diff < 0) {
          ratioEl.textContent =
            formatSize(inSize) +
            arrow +
            formatSize(outSize) +
            " (-" +
            formatSize(Math.abs(diff)) +
            ", " +
            pct +
            "% smaller)";
        } else {
          ratioEl.textContent =
            formatSize(inSize) + arrow + formatSize(outSize) + " (same size)";
        }
        ratioEl.hidden = false;
      }
    }

    // ========================
    // Event listeners
    // ========================
    var timeout;
    inputEl.addEventListener("input", function () {
      clearTimeout(timeout);
      timeout = setTimeout(updateOutput, 100);
    });

    inputFormat.addEventListener("change", function () {
      updateDownloadVisibility(currentMode);
      updateOutput();
    });
    outputFormat.addEventListener("change", updateOutput);

    // Swap (text mode only)
    if (swapBtn) {
      swapBtn.addEventListener("click", function () {
        if (currentMode === "file") return;
        var outText = outputEl.textContent;
        var outFmtVal = outputFormat.value;
        var inFmtVal = inputFormat.value;

        inputEl.value = outText;
        inputFormat.value = outFmtVal;
        outputFormat.value = inFmtVal === "text" ? "base64" : inFmtVal;
        updateOutput();
      });
    }

    // Copy
    if (copyBtn) {
      copyBtn.addEventListener("click", function () {
        if (navigator.clipboard && outputEl.textContent) {
          navigator.clipboard.writeText(outputEl.textContent).then(function () {
            var text = copyBtn.querySelector(".enc-copy-text");
            if (text) text.textContent = "Copied!";
            copyBtn.classList.add("copied");
            setTimeout(function () {
              if (text) text.textContent = "Copy";
              copyBtn.classList.remove("copied");
            }, 2000);
          });
        }
      });
    }

    /** Show/hide download button based on mode and input format */
    function updateDownloadVisibility(mode) {
      if (!downloadBtn) return;
      var dlLabel = downloadBtn.querySelector(".enc-download-text");
      if (mode === "file") {
        downloadBtn.hidden = false;
        downloadBtn.setAttribute("aria-label", "Download Base64 as text file");
        if (dlLabel) dlLabel.textContent = "Download";
      } else {
        var inFmt = inputFormat.value;
        var isBase64Input = inFmt === "base64" || inFmt === "base64url";
        downloadBtn.hidden = !isBase64Input;
        if (isBase64Input) {
          downloadBtn.setAttribute(
            "aria-label",
            "Decode Base64 and download as original file",
          );
          if (dlLabel) dlLabel.textContent = "Decode to file";
        }
      }
    }

    // Download handler
    if (downloadBtn) {
      downloadBtn.addEventListener("click", function () {
        if (currentMode === "file") {
          // File mode: download the Base64 text output
          var outputText = outputEl.textContent;
          if (!outputText) return;

          var filename = "base64-output.txt";
          if (currentFileData && currentFileData.name) {
            filename = currentFileData.name + ".base64.txt";
          }

          var blob = new Blob([outputText], { type: "text/plain" });
          var url = URL.createObjectURL(blob);
          var a = document.createElement("a");
          a.href = url;
          a.download = filename;
          a.click();
          URL.revokeObjectURL(url);
        } else {
          // Text mode with Base64 input: decode to binary file
          var input = inputEl.value;
          if (!input) return;

          var inFmt = inputFormat.value;
          var bytes;
          if (inFmt === "base64") {
            bytes = fromBase64(input);
          } else if (inFmt === "base64url") {
            bytes = fromBase64Url(input);
          }

          if (!bytes || bytes.length === 0) {
            showError("Could not decode Base64 input");
            return;
          }

          var detected = detectMimeFromBase64(input);
          var blob = new Blob([bytes], { type: detected.mime });
          var url = URL.createObjectURL(blob);
          var a = document.createElement("a");
          a.href = url;
          a.download = "decoded-file." + detected.ext;
          a.click();
          URL.revokeObjectURL(url);
        }
      });
    }

    // Initialize
    updateOutput();
  })();
</script>

<style>
  .enc-tool {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-subtle);
    border: var(--border-1);
    border-radius: var(--radius-md);
