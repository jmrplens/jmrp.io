  .enc-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  /* Dropzone */
  .enc-dropzone {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    min-height: 160px;
    padding: 2rem 1.5rem;
    cursor: pointer;
    background: var(--color-bg);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-sm);
    transition: all 0.2s;
  }

  .enc-dropzone:hover,
  .enc-dropzone:focus-visible {
    background: var(--color-bg-subtle);
    border-color: var(--color-primary);
  }

  .enc-dropzone.drag-over {
    background: var(--color-bg-subtle);
    border-color: var(--color-primary);
    box-shadow: inset 0 0 0 2px rgb(181 9 172 / 10%);
  }

  .enc-dropzone.has-file {
    min-height: auto;
    padding: 1rem;
  }

  .enc-dropzone.has-file .enc-drop-icon,
  .enc-dropzone.has-file .enc-drop-text,
  .enc-dropzone.has-file .enc-drop-hint,
  .enc-dropzone.has-file .enc-drop-privacy {
    display: none;
  }

  .enc-drop-icon {
    width: 48px;
    height: 48px;
    color: var(--color-text-muted);
  }

  .enc-drop-text {
    font-size: 0.95rem;
    font-weight: var(--fw-medium);
