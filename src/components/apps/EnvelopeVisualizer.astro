---
/**
 * EnvelopeVisualizer Component
 *
 * Interactive encrypt-then-MAC envelope playground (companion to post 011).
 * Seals a secret into the vault's `[ver][iv][hmacTag][cipher]` envelope with real
 * WebCrypto (AES-256-CBC + HMAC-SHA256, separate enc/mac sub-keys) and lets you:
 *   1. Launch concrete tampering attacks (flip cipher/IV, forge tag, truncate)
 *      and context attacks (cross-slot, cross-type, rollback) — each fails for
 *      its own reason against the constant-time, context-bound MAC.
 *   2. Bind the authenticated context prefix `ver‖recordType‖slotId‖generation`
 *      into the tag and watch relocation / type-confusion / rollback break it.
 *   3. Flip the read path between Encrypt-then-MAC (verify-before-decrypt) and
 *      decrypt-first (the doom path), then run a REAL CBC padding-oracle attack
 *      that recovers the last plaintext block byte-by-byte — and watch it go
 *      silent the moment the MAC gate is restored.
 *   4. See CBC malleability: flipping an IV byte flips the matching plaintext
 *      byte of block 0 by the exact same delta (the attacker's lever).
 * Zero server — everything runs in the browser.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const uniqueId = `env-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

/** Strings handed to the inline script (no module imports in is:inline). */
const i18n = {
  emptyState: t("tools.etmEnvelope.emptyState"),
  okVerdict: t("tools.etmEnvelope.okVerdict"),
  failTitle: t("tools.etmEnvelope.failTitle"),
  decryptedLabel: t("tools.etmEnvelope.decryptedLabel"),
  byteTitle: t("tools.etmEnvelope.byteTitle"),
  bytesLabel: t("tools.shared.bytes"),
  insecureContext: t("tools.etmEnvelope.insecureContext"),
  error: t("tools.shared.error"),
  pristine: t("tools.etmEnvelope.pristine"),
  reasonByteFlip: t("tools.etmEnvelope.reasonByteFlip"),
  reasonFlipCipher: t("tools.etmEnvelope.reasonFlipCipher"),
  reasonFlipIv: t("tools.etmEnvelope.reasonFlipIv"),
  reasonForgeTag: t("tools.etmEnvelope.reasonForgeTag"),
  reasonTruncate: t("tools.etmEnvelope.reasonTruncate"),
  reasonCrossSlot: t("tools.etmEnvelope.reasonCrossSlot"),
  reasonCrossType: t("tools.etmEnvelope.reasonCrossType"),
  reasonRollback: t("tools.etmEnvelope.reasonRollback"),
  decryptFirstLeakTitle: t("tools.etmEnvelope.decryptFirstLeakTitle"),
  decryptFirstLeakNote: t("tools.etmEnvelope.decryptFirstLeakNote"),
  decryptFirstOkNote: t("tools.etmEnvelope.decryptFirstOkNote"),
  oracleRun: t("tools.etmEnvelope.oracleRun"),
  oracleRunning: t("tools.etmEnvelope.oracleRunning"),
  oracleBlocked: t("tools.etmEnvelope.oracleBlocked"),
  oracleRecoveredLabel: t("tools.etmEnvelope.oracleRecoveredLabel"),
  oracleDone: t("tools.etmEnvelope.oracleDone"),
  oracleNeedBlock: t("tools.etmEnvelope.oracleNeedBlock"),
  malleabilityIdle: t("tools.etmEnvelope.malleabilityIdle"),
  malleabilityFlipped: t("tools.etmEnvelope.malleabilityFlipped"),
  typeCredential: t("tools.etmEnvelope.typeCredential"),
  typeTotp: t("tools.etmEnvelope.typeTotp"),
  typeIndex: t("tools.etmEnvelope.typeIndex"),
};

const segs = [
  { id: "ver", label: t("tools.etmEnvelope.fieldVer") },
  { id: "iv", label: t("tools.etmEnvelope.fieldIv") },
  { id: "tag", label: t("tools.etmEnvelope.fieldTag") },
  { id: "cipher", label: t("tools.etmEnvelope.fieldCipher") },
];

const attacks = [
  { id: "flipCipher", icon: "i-mdi:dice-multiple-outline" },
  { id: "flipIv", icon: "i-mdi:shuffle-variant" },
  { id: "forgeTag", icon: "i-mdi:draw-pen" },
  { id: "truncate", icon: "i-mdi:content-cut" },
  { id: "crossSlot", icon: "i-mdi:swap-horizontal" },
  { id: "crossType", icon: "i-mdi:rename-box-outline" },
  { id: "rollback", icon: "i-mdi:history" },
];
---

<div
  class="ev"
  data-ev-id={uniqueId}
>
  <div class="ev-inputs">
    <label class="ev-field">
      <span class="ev-label">
        <span
          class="i-mdi:form-textbox-password ev-label-icon"
          aria-hidden="true"
        ></span>
        {t("tools.etmEnvelope.secretLabel")}
      </span>
      <input
        type="text"
        class="ev-input"
        data-ev-secret
        value={t("tools.etmEnvelope.secretExample")}
        spellcheck="false"
        autocomplete="off"
      />
    </label>
    <label class="ev-field">
      <span class="ev-label">
        <span
          class="i-mdi:key-outline ev-label-icon"
          aria-hidden="true"
        ></span>
        {t("tools.etmEnvelope.passphraseLabel")}
      </span>
      <input
        type="text"
        class="ev-input"
        data-ev-pass
        value={t("tools.etmEnvelope.passphraseExample")}
        spellcheck="false"
        autocomplete="off"
      />
    </label>
  </div>

  {/* Authenticated context prefix (bound into the tag, not stored on disk) */}
  <fieldset class="ev-context">
    <legend class="ev-section-title">
      {t("tools.etmEnvelope.contextHeading")}
    </legend>
    <p class="ev-context-note">{t("tools.etmEnvelope.contextNote")}</p>
    <div class="ev-context-grid">
      <label class="ev-ctx-field">
        <span class="ev-ctx-label">{t("tools.etmEnvelope.fieldType")}</span>
        <select
          class="ev-input"
          data-ev-type
        >
          <option value="0">{t("tools.etmEnvelope.typeCredential")}</option>
          <option value="1">{t("tools.etmEnvelope.typeTotp")}</option>
          <option value="2">{t("tools.etmEnvelope.typeIndex")}</option>
        </select>
      </label>
      <label class="ev-ctx-field">
        <span class="ev-ctx-label">{t("tools.etmEnvelope.fieldSlot")}</span>
        <input
          type="number"
          class="ev-input"
          data-ev-slot
          value="3"
          min="0"
          max="255"
        />
      </label>
      <label class="ev-ctx-field">
        <span class="ev-ctx-label">{t("tools.etmEnvelope.fieldGen")}</span>
        <input
          type="number"
          class="ev-input"
          data-ev-gen
          value="1"
          min="0"
          max="4294967295"
        />
      </label>
    </div>
  </fieldset>

  {/* Derived sub-keys */}
  <div class="ev-keys">
    <span class="ev-keys-note">{t("tools.etmEnvelope.keyDerivationNote")}</span>
    <div class="ev-key-row">
      <span class="ev-key-tag ev-key-tag--enc"
        >{t("tools.etmEnvelope.encKeyLabel")}</span
      >
      <code data-ev-enckey>…</code>
    </div>
    <div class="ev-key-row">
      <span class="ev-key-tag ev-key-tag--mac"
        >{t("tools.etmEnvelope.macKeyLabel")}</span
      >
      <code data-ev-mackey>…</code>
    </div>
  </div>

  {/* Envelope bytes */}
  <div class="ev-envelope-head">
    <span class="ev-section-title"
      >{t("tools.etmEnvelope.envelopeHeading")}
      <span
        class="ev-total"
        data-ev-total
      ></span></span
    >
    <button
      type="button"
      class="ev-restore"
      data-ev-restore
      hidden
    >
      <span
        class="i-mdi:restore"
        aria-hidden="true"
      ></span>
      {t("tools.etmEnvelope.restore")}
    </button>
  </div>
  <p class="ev-tamper-hint">{t("tools.etmEnvelope.tamperHint")}</p>

  <div
    class="ev-envelope"
    data-ev-envelope
  >
    {
      segs.map((s) => (
        <div
          class="ev-seg"
          data-ev-seg-wrap={s.id}
        >
          <span class={`ev-seg-label ev-seg-label--${s.id}`}>{s.label}</span>
          <div
            class="ev-bytes"
            data-ev-bytes={s.id}
          />
        </div>
      ))
    }
  </div>

  {/* Attack toolbar */}
  <div class="ev-section-title ev-attacks-title">
    {t("tools.etmEnvelope.attacksHeading")}
  </div>
  <p class="ev-tamper-hint">{t("tools.etmEnvelope.attacksNote")}</p>
  <div
    class="ev-attacks"
    role="group"
    aria-label={t("tools.etmEnvelope.attacksHeading")}
  >
    {
      attacks.map((a) => (
        <button
          type="button"
          class="ev-attack"
          data-ev-attack={a.id}
        >
          <span
            class={`${a.icon} ev-attack-icon`}
            aria-hidden="true"
          />
          {t(
            `tools.etmEnvelope.atk_${a.id}` as `tools.etmEnvelope.atk_flipCipher`,
          )}
        </button>
      ))
    }
  </div>

  {/* Read-path mode */}
  <fieldset class="ev-mode">
    <legend class="ev-section-title">
      {t("tools.etmEnvelope.modeHeading")}
    </legend>
    <label class="ev-mode-opt">
      <input
        type="radio"
        name={`${uniqueId}-mode`}
        value="etm"
        data-ev-mode
        checked
      />
      <strong>{t("tools.etmEnvelope.modeEtm")}</strong>
      <small>{t("tools.etmEnvelope.modeEtmNote")}</small>
    </label>
    <label class="ev-mode-opt">
      <input
        type="radio"
        name={`${uniqueId}-mode`}
        value="decrypt-first"
        data-ev-mode
      />
      <strong>{t("tools.etmEnvelope.modeDecryptFirst")}</strong>
      <small>{t("tools.etmEnvelope.modeDecryptFirstNote")}</small>
    </label>
  </fieldset>

  {/* Read path verdict */}
  <div
    class="ev-verdict"
    data-ev-verdict
    role="status"
    aria-live="polite"
  >
  </div>

  {/* Padding-oracle attacker (decrypt-first only) */}
  <div class="ev-oracle">
    <div class="ev-section-title">{t("tools.etmEnvelope.oracleHeading")}</div>
    <p class="ev-tamper-hint">{t("tools.etmEnvelope.oracleIntro")}</p>
    <button
      type="button"
      class="ev-oracle-btn"
      data-ev-oracle
    >
      <span
        class="i-mdi:robot-angry-outline ev-attack-icon"
        aria-hidden="true"
      ></span>
      {t("tools.etmEnvelope.oracleRun")}
    </button>
    <p
      class="ev-oracle-status"
      data-ev-oracle-status
      role="status"
      aria-live="polite"
    >
    </p>
    <div
      class="ev-oracle-out"
      data-ev-oracle-out
      hidden
    >
    </div>
  </div>

  {/* CBC malleability (the attacker's lever) */}
  <div class="ev-cbc">
    <div class="ev-section-title">
      {t("tools.etmEnvelope.malleabilityHeading")}
    </div>
    <p class="ev-tamper-hint">{t("tools.etmEnvelope.malleabilityNote")}</p>
    <p
      class="ev-cbc-status"
      data-ev-cbc
      role="status"
      aria-live="polite"
    >
    </p>
  </div>
</div>

<script is:inline define:vars={{ uniqueId, i18n }}>
  const root = document.querySelector(`[data-ev-id="${uniqueId}"]`);
  if (root) {
    const enc = new TextEncoder();
    const dec = new TextDecoder();
    const VER = 0x01;
    const BLOCK = 16;

    const $ = (sel) => root.querySelector(sel);
    const secretInput = $("[data-ev-secret]");
    const passInput = $("[data-ev-pass]");
    const typeSel = $("[data-ev-type]");
    const slotInput = $("[data-ev-slot]");
    const genInput = $("[data-ev-gen]");
    const encKeyEl = $("[data-ev-enckey]");
    const macKeyEl = $("[data-ev-mackey]");
    const verdictEl = $("[data-ev-verdict]");
    const restoreBtn = $("[data-ev-restore]");
    const totalEl = $("[data-ev-total]");
    const oracleBtn = $("[data-ev-oracle]");
    const oracleStatus = $("[data-ev-oracle-status]");
    const oracleOut = $("[data-ev-oracle-out]");
    const cbcEl = $("[data-ev-cbc]");
    const byteHosts = {
      ver: $('[data-ev-bytes="ver"]'),
      iv: $('[data-ev-bytes="iv"]'),
      tag: $('[data-ev-bytes="tag"]'),
      cipher: $('[data-ev-bytes="cipher"]'),
    };

    // Sealed originals + a live (mutable) copy + the reader's context view.
    let state = null; // { ver, iv, tag, cipher, encKey, macKey, aesKey, ctx, padded }
    let live = null; // { ver, iv, tag, cipher } (Uint8Array copies)
    let readerCtx = null; // { type, slot, gen } the reader currently assumes
    let tampered = false;
    let lastReason = null; // i18n key suffix describing the active attack
    let mode = "etm";

    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    const toHex = (bytes) =>
      Array.from(bytes)
        .map((b) => b.toString(16).padStart(2, "0"))
        .join("");
    const printable = (bytes) =>
      Array.from(bytes)
        .map((b) => (b >= 0x20 && b < 0x7f ? String.fromCharCode(b) : "·"))
        .join("");

    async function hmac(keyBytes, msg) {
      const k = await crypto.subtle.importKey(
        "raw",
        keyBytes,
        { name: "HMAC", hash: "SHA-256" },
        false,
        ["sign"],
      );
      return new Uint8Array(await crypto.subtle.sign("HMAC", k, msg));
    }

    async function deriveKeys(passphrase) {
      const master = new Uint8Array(
        await crypto.subtle.digest("SHA-256", enc.encode(passphrase)),
      );
      const encKey = await hmac(master, enc.encode("vault-enc"));
      const macKey = await hmac(master, enc.encode("vault-mac"));
      return { encKey, macKey };
    }

    function concat(...arrs) {
      const total = arrs.reduce((n, a) => n + a.length, 0);
      const out = new Uint8Array(total);
      let off = 0;
      for (const a of arrs) {
        out.set(a, off);
        off += a.length;
      }
      return out;
    }

    // authPrefix = ver(1) ‖ recordType(1) ‖ slotId(1) ‖ generation(4, little-endian)
    function authPrefix(ctx) {
      const g = ctx.gen >>> 0;
      return new Uint8Array([
        VER,
        ctx.type & 0xff,
        ctx.slot & 0xff,
        g & 0xff,
        (g >>> 8) & 0xff,
        (g >>> 16) & 0xff,
        (g >>> 24) & 0xff,
      ]);
    }

    // The authenticated message: authPrefix ‖ iv ‖ cipher
    function authMsg(ctx, iv, cipher) {
      return concat(authPrefix(ctx), iv, cipher);
    }

    // PKCS#7 pad to the AES block size (so block 0 is exact for the malleability demo).
    function pkcs7(bytes) {
      const padLen = BLOCK - (bytes.length % BLOCK);
      return concat(bytes, new Uint8Array(BLOCK).fill(padLen).slice(0, padLen));
    }

    // Constant-time-style compare (mirrors the firmware's mbedtls_ct_memcmp intent).
    function ctEqual(a, b) {
      if (a.length !== b.length) return false;
      let diff = 0;
      for (let i = 0; i < a.length; i++) diff |= a[i] ^ b[i];
      return diff === 0;
    }

    function readCtxInputs() {
      return {
        type: Math.max(0, Math.min(2, Number(typeSel.value) || 0)),
        slot: Math.max(0, Math.min(255, Number(slotInput.value) || 0)),
        gen: Math.max(0, Math.min(0xffffffff, Number(genInput.value) || 0)),
      };
    }

    async function seal() {
      verdictEl.textContent = "";
      totalEl.textContent = "";
      resetOracle();
      if (!window.isSecureContext || !window.crypto || !crypto.subtle) {
        state = live = readerCtx = null;
        for (const id of Object.keys(byteHosts)) byteHosts[id].textContent = "";
        encKeyEl.textContent = macKeyEl.textContent = "—";
        verdictEl.className = "ev-verdict ev-verdict--empty";
        verdictEl.textContent = i18n.insecureContext;
        restoreBtn.hidden = true;
        return;
      }
      const secret = secretInput.value;
      const pass = passInput.value;
      if (!secret) {
        state = live = readerCtx = null;
        tampered = false;
        lastReason = null;
        restoreBtn.hidden = true;
        for (const id of Object.keys(byteHosts)) byteHosts[id].textContent = "";
        encKeyEl.textContent = macKeyEl.textContent = "…";
        setVerdict("empty");
        updateMalleability();
        return;
      }
      try {
        const ctx = readCtxInputs();
        const { encKey, macKey } = await deriveKeys(pass);
        encKeyEl.textContent = toHex(encKey).slice(0, 24) + "…";
        macKeyEl.textContent = toHex(macKey).slice(0, 24) + "…";

        const iv = crypto.getRandomValues(new Uint8Array(BLOCK));
        const aesKey = await crypto.subtle.importKey(
          "raw",
          encKey,
          { name: "AES-CBC" },
          false,
          ["encrypt", "decrypt"],
        );
        const padded = pkcs7(enc.encode(secret));
        const cipher = new Uint8Array(
          await crypto.subtle.encrypt(
            { name: "AES-CBC", iv },
            aesKey,
            enc.encode(secret),
          ),
        );
        const ver = new Uint8Array([VER]);
        const tag = await hmac(macKey, authMsg(ctx, iv, cipher));

        state = { ver, iv, tag, cipher, encKey, macKey, aesKey, ctx, padded };
        live = {
          ver: ver.slice(),
          iv: iv.slice(),
          tag: tag.slice(),
          cipher: cipher.slice(),
        };
        readerCtx = { ...ctx };
        tampered = false;
        lastReason = null;
        render();
        updateMalleability();
        await readPath();
      } catch (e) {
        verdictEl.className = "ev-verdict ev-verdict--fail";
        verdictEl.textContent = i18n.error;
      }
    }

    function render() {
      for (const id of Object.keys(byteHosts)) {
        const host = byteHosts[id];
        host.textContent = "";
        const bytes = live[id];
        bytes.forEach((b, idx) => {
          const cell = document.createElement("button");
          cell.type = "button";
          cell.className = `ev-byte ev-byte--${id}`;
          cell.textContent = b.toString(16).padStart(2, "0");
          cell.dataset.seg = id;
          cell.dataset.idx = String(idx);
          cell.title = i18n.byteTitle;
          const orig = state[id];
          if (idx >= orig.length || orig[idx] !== b)
            cell.classList.add("ev-byte--flipped");
          host.appendChild(cell);
        });
      }
      const total =
        live.ver.length + live.iv.length + live.tag.length + live.cipher.length;
      totalEl.textContent = i18n.bytesLabel.replace("{count}", String(total));
      const ctxChanged =
        readerCtx.type !== state.ctx.type ||
        readerCtx.slot !== state.ctx.slot ||
        readerCtx.gen !== state.ctx.gen;
      restoreBtn.hidden = !(tampered || ctxChanged);
    }

    // Recompute the tag over the reader's context + the live IV/cipher.
    async function tagMatches() {
      const expected = await hmac(
        state.macKey,
        authMsg(readerCtx, live.iv, live.cipher),
      );
      return ctEqual(expected, live.tag);
    }

    async function tryDecrypt() {
      const aesKey = await crypto.subtle.importKey(
        "raw",
        state.encKey,
        { name: "AES-CBC" },
        false,
        ["decrypt"],
      );
      const plain = new Uint8Array(
        await crypto.subtle.decrypt(
          { name: "AES-CBC", iv: live.iv },
          aesKey,
          live.cipher,
        ),
      );
      return dec.decode(plain);
    }

    async function readPath() {
      if (!state) return;
      if (mode === "etm") {
        // Verify-before-decrypt: the MAC gate runs first.
        const ok = await tagMatches();
        if (!ok) {
          setVerdict("fail");
          return;
        }
        try {
          setVerdict("ok", await tryDecrypt());
        } catch (e) {
          setVerdict("fail");
        }
        return;
      }
      // decrypt-first (the doom path): decryption runs on attacker bytes BEFORE
      // the MAC is ever consulted — this is exactly where the oracle leaks.
      try {
        const plaintext = await tryDecrypt();
        const macOk = await tagMatches();
        setVerdict("leak-ok", plaintext, macOk);
      } catch (e) {
        // WebCrypto threw OperationError == "invalid padding" == the oracle bit.
        setVerdict("leak-bad");
      }
    }

    function clearVerdict() {
      verdictEl.innerHTML = "";
    }
    function addIcon(cls) {
      const icon = document.createElement("span");
      icon.className = `${cls} ev-verdict-icon`;
      icon.setAttribute("aria-hidden", "true");
      verdictEl.appendChild(icon);
    }
    function reasonText() {
      if (!lastReason) return i18n.pristine;
      const map = {
        flipCipher: i18n.reasonFlipCipher,
        flipIv: i18n.reasonFlipIv,
        forgeTag: i18n.reasonForgeTag,
        truncate: i18n.reasonTruncate,
        crossSlot: i18n.reasonCrossSlot,
        crossType: i18n.reasonCrossType,
        rollback: i18n.reasonRollback,
        byte: i18n.reasonByteFlip,
      };
      return map[lastReason] || i18n.reasonByteFlip;
    }

    function setVerdict(kind, plaintext, macOk) {
      if (kind === "empty") {
        verdictEl.className = "ev-verdict ev-verdict--empty";
        verdictEl.textContent = i18n.emptyState;
        return;
      }
      if (kind === "fail") {
        verdictEl.className = "ev-verdict ev-verdict--fail";
        clearVerdict();
        addIcon("i-mdi:close-octagon-outline");
        const wrap = document.createElement("span");
        const title = document.createElement("strong");
        title.textContent = i18n.failTitle + " ";
        const why = document.createElement("span");
        why.className = "ev-why";
        why.textContent = reasonText();
        wrap.append(title, why);
        verdictEl.appendChild(wrap);
        return;
      }
      if (kind === "leak-bad") {
        // decrypt-first, decryption threw → padding-oracle signal leaked.
        verdictEl.className = "ev-verdict ev-verdict--leak";
        clearVerdict();
        addIcon("i-mdi:alert-octagon-outline");
        const wrap = document.createElement("span");
        const title = document.createElement("strong");
        title.textContent = i18n.decryptFirstLeakTitle + " ";
        const why = document.createElement("span");
        why.className = "ev-why";
        why.textContent = i18n.decryptFirstLeakNote;
        wrap.append(title, why);
        verdictEl.appendChild(wrap);
        return;
      }
      if (kind === "leak-ok") {
        // decrypt-first, decryption succeeded → plaintext already exposed,
        // and only THEN is the MAC checked (too late).
        verdictEl.className = "ev-verdict ev-verdict--leak";
        clearVerdict();
        addIcon("i-mdi:lock-open-alert-outline");
        const wrap = document.createElement("span");
        const lbl = document.createElement("span");
        lbl.className = "ev-plain-label";
        lbl.textContent = i18n.decryptedLabel + ": ";
        const out = document.createElement("strong");
        out.className = "ev-plain";
        out.textContent = plaintext;
        const why = document.createElement("span");
        why.className = "ev-why";
        why.textContent =
          " — " + i18n.decryptFirstOkNote.replace("{mac}", macOk ? "✓" : "✗");
        wrap.append(lbl, out, why);
        verdictEl.appendChild(wrap);
        return;
      }
      // ok (EtM happy path)
      verdictEl.className = "ev-verdict ev-verdict--ok";
      clearVerdict();
      addIcon("i-mdi:check-decagram-outline");
      const wrap = document.createElement("span");
      const txt = document.createElement("span");
      txt.textContent = i18n.okVerdict + " ";
      const lbl = document.createElement("span");
      lbl.className = "ev-plain-label";
      lbl.textContent = i18n.decryptedLabel + ": ";
      const out = document.createElement("strong");
      out.className = "ev-plain";
      out.textContent = plaintext;
      wrap.append(txt, lbl, out);
      verdictEl.appendChild(wrap);
    }

    // ---- CBC malleability (the attacker's lever) -------------------------
    // For block 0, ΔP0[i] == ΔIV[i] exactly: flipping an IV byte flips the
    // matching plaintext byte by the same delta. We show that controlled change
    // without needing to decrypt (it's a deterministic property of CBC).
    function updateMalleability() {
      if (!state) {
        cbcEl.textContent = i18n.malleabilityIdle;
        cbcEl.classList.remove("ev-cbc--active");
        return;
      }
      const diffs = [];
      for (let i = 0; i < BLOCK; i++) {
        const delta = live.iv[i] ^ state.iv[i];
        if (delta !== 0) diffs.push({ i, delta });
      }
      if (diffs.length === 0) {
        cbcEl.textContent = i18n.malleabilityIdle;
        cbcEl.classList.remove("ev-cbc--active");
        return;
      }
      const p0 = state.padded.slice(0, BLOCK);
      const parts = diffs.map((d) => {
        const before = p0[d.i];
        const after = (before ^ d.delta) & 0xff;
        const bc =
          before >= 0x20 && before < 0x7f ? String.fromCharCode(before) : "·";
        const ac =
          after >= 0x20 && after < 0x7f ? String.fromCharCode(after) : "·";
        return `#${d.i}: ${bc} (0x${before.toString(16).padStart(2, "0")}) → ${ac} (0x${after.toString(16).padStart(2, "0")})  [⊕0x${d.delta.toString(16).padStart(2, "0")}]`;
      });
      cbcEl.textContent = i18n.malleabilityFlipped + " " + parts.join(" · ");
      cbcEl.classList.add("ev-cbc--active");
    }

    // ---- Padding-oracle attacker -----------------------------------------
    function resetOracle() {
      if (oracleStatus) oracleStatus.textContent = "";
      if (oracleOut) {
        oracleOut.hidden = true;
        oracleOut.textContent = "";
      }
    }

    // Oracle: WebCrypto AES-CBC decrypt throws OperationError on invalid PKCS#7
    // padding and succeeds otherwise — exactly the one-bit signal Vaudenay needs.
    async function paddingValid(prev16, target16) {
      try {
        await crypto.subtle.decrypt(
          { name: "AES-CBC", iv: prev16 },
          state.aesKey,
          target16,
        );
        return true;
      } catch {
        return false;
      }
    }

    // Recover the last plaintext block byte-by-byte using only the padding bit.
    async function recoverLastBlock(onByte) {
      const C = live.cipher;
      const n = C.length / BLOCK;
      const target = C.slice((n - 1) * BLOCK, n * BLOCK);
      const prevReal =
        n >= 2 ? C.slice((n - 2) * BLOCK, (n - 1) * BLOCK) : live.iv.slice();
      const inter = new Uint8Array(BLOCK); // I = Dec(target)
      const craft = new Uint8Array(BLOCK);
      for (let pos = BLOCK - 1; pos >= 0; pos--) {
        const pad = BLOCK - pos;
        for (let k = pos + 1; k < BLOCK; k++) craft[k] = inter[k] ^ pad;
        let found = false;
        for (let g = 0; g < 256; g++) {
          craft[pos] = g;
          if (await paddingValid(craft, target)) {
            if (pos === BLOCK - 1) {
              // Guard against a coincidental 0x02 0x02 … by perturbing byte 14.
              craft[BLOCK - 2] ^= 0xff;
              const ok2 = await paddingValid(craft, target);
              craft[BLOCK - 2] ^= 0xff;
              if (!ok2) continue;
            }
            inter[pos] = g ^ pad;
            found = true;
            break;
          }
        }
        if (!found) inter[pos] = 0;
        const plainByte = inter[pos] ^ prevReal[pos];
        onByte(pos, plainByte);
        await sleep(20);
      }
      const P = new Uint8Array(BLOCK);
      for (let i = 0; i < BLOCK; i++) P[i] = inter[i] ^ prevReal[i];
      return P;
    }

    async function runOracle() {
      if (!state) return;
      if (mode !== "decrypt-first") {
        oracleStatus.textContent = i18n.oracleBlocked;
        oracleStatus.className = "ev-oracle-status ev-oracle-status--blocked";
        oracleOut.hidden = true;
        return;
      }
      if (live.cipher.length < BLOCK) {
        oracleStatus.textContent = i18n.oracleNeedBlock;
        return;
      }
      oracleBtn.disabled = true;
      oracleStatus.className = "ev-oracle-status";
      oracleStatus.textContent = i18n.oracleRunning;
      oracleOut.hidden = false;
      const recovered = new Uint8Array(BLOCK).fill(0);
      const cells = [];
      oracleOut.textContent = "";
      const row = document.createElement("div");
      row.className = "ev-oracle-bytes";
      for (let i = 0; i < BLOCK; i++) {
        const c = document.createElement("span");
        c.className = "ev-oracle-byte";
        c.textContent = "··";
        row.appendChild(c);
        cells.push(c);
      }
      oracleOut.appendChild(row);
      const txt = document.createElement("div");
      txt.className = "ev-oracle-text";
      oracleOut.appendChild(txt);

      try {
        await recoverLastBlock((pos, b) => {
          recovered[pos] = b;
          cells[pos].textContent = b.toString(16).padStart(2, "0");
          cells[pos].classList.add("ev-oracle-byte--got");
          txt.textContent =
            i18n.oracleRecoveredLabel + " “" + printable(recovered) + "”";
        });
        oracleStatus.textContent = i18n.oracleDone;
        oracleStatus.className = "ev-oracle-status ev-oracle-status--done";
      } finally {
        oracleBtn.disabled = false;
      }
    }

    // ---- events -----------------------------------------------------------
    $("[data-ev-envelope]").addEventListener("click", (e) => {
      const cell = e.target.closest(".ev-byte");
      if (!cell || !live) return;
      const seg = cell.dataset.seg;
      const idx = Number(cell.dataset.idx);
      live[seg][idx] ^= 0xff;
      tampered = true;
      lastReason =
        seg === "iv" ? "flipIv" : seg === "cipher" ? "flipCipher" : "byte";
      render();
      updateMalleability();
      readPath();
      resetOracle();
    });

    root.querySelectorAll("[data-ev-attack]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!live) return;
        const kind = btn.dataset.evAttack;
        const rnd = (max) =>
          crypto.getRandomValues(new Uint32Array(1))[0] % max;
        if (kind === "flipCipher" && live.cipher.length) {
          live.cipher[rnd(live.cipher.length)] ^= 0xff;
          tampered = true;
        } else if (kind === "flipIv") {
          live.iv[rnd(BLOCK)] ^= 0xff;
          tampered = true;
        } else if (kind === "forgeTag") {
          live.tag = crypto.getRandomValues(new Uint8Array(live.tag.length));
          tampered = true;
        } else if (kind === "truncate" && live.cipher.length > BLOCK) {
          live.cipher = live.cipher.slice(0, live.cipher.length - BLOCK);
          tampered = true;
        } else if (kind === "crossSlot") {
          readerCtx.slot = (state.ctx.slot + 2) & 0xff;
          slotInput.value = String(readerCtx.slot);
        } else if (kind === "crossType") {
          readerCtx.type = (state.ctx.type + 1) % 3;
          typeSel.value = String(readerCtx.type);
        } else if (kind === "rollback") {
          readerCtx.gen = (state.ctx.gen + 1) >>> 0;
          genInput.value = String(readerCtx.gen);
        }
        lastReason = kind;
        render();
        updateMalleability();
        readPath();
        resetOracle();
      });
    });

    restoreBtn.addEventListener("click", () => {
      if (!state) return;
      live = {
        ver: state.ver.slice(),
        iv: state.iv.slice(),
        tag: state.tag.slice(),
        cipher: state.cipher.slice(),
      };
      readerCtx = { ...state.ctx };
      typeSel.value = String(state.ctx.type);
      slotInput.value = String(state.ctx.slot);
      genInput.value = String(state.ctx.gen);
      tampered = false;
      lastReason = null;
      render();
      updateMalleability();
      readPath();
      resetOracle();
    });

    root.querySelectorAll("[data-ev-mode]").forEach((r) => {
      r.addEventListener("change", () => {
        if (r.checked) {
          mode = r.value;
          resetOracle();
          readPath();
        }
      });
    });

    oracleBtn.addEventListener("click", runOracle);

    function debounce(fn, d) {
      let to;
      return (...a) => {
        clearTimeout(to);
        to = setTimeout(() => fn(...a), d);
      };
    }
    const onInput = debounce(seal, 200);
    secretInput.addEventListener("input", onInput);
    passInput.addEventListener("input", onInput);
    // Changing a context field at the top RE-SEALS (the file's home context).
    [typeSel, slotInput, genInput].forEach((el) =>
      el.addEventListener("change", onInput),
    );

    seal();
  }
</script>

