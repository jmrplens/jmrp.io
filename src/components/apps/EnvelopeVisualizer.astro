---
/**
 * EnvelopeVisualizer Component
 *
 * Interactive encrypt-then-MAC envelope playground (companion to post 011).
 * Seals a secret into the vault's `[ver][iv][hmacTag][cipher]` envelope with real
 * WebCrypto, following the firmware's key hierarchy: PBKDF2-SHA256 turns the
 * passphrase into a key-encryption key (KEK), the KEK unwraps a random vault key
 * (VK), and the VK yields separate enc/mac sub-keys. It lets you:
 *   1. Launch concrete tampering attacks (flip cipher/IV, forge tag, truncate)
 *      and context attacks (cross-slot, cross-type, rollback) — each fails for
 *      its own reason against the constant-time, context-bound MAC.
 *   2. Bind the authenticated context prefix `ver‖recordType‖slotId‖generation`
 *      into the tag and watch relocation / type-confusion / rollback break it.
 *   3. Change the passphrase (a rewrap that leaves the envelope untouched),
 *      re-encrypt under a new vault key, and check whether a retired passphrase
 *      plus the old meta.bin still opens the vault.
 *   4. Flip the read path between Encrypt-then-MAC (verify-before-decrypt) and
 *      decrypt-first (the doom path), then run a REAL CBC padding-oracle attack
 *      that recovers every plaintext block byte-by-byte — and watch it go
 *      silent the moment the MAC gate is restored.
 *   5. See CBC malleability: flipping an IV byte flips the matching plaintext
 *      byte of block 0 by the exact same delta (the attacker's lever).
 * Zero server — everything runs in the browser.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const uniqueId = `env-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

/** Strings handed to the inline script (no module imports in is:inline). */
const i18n = {
  emptyState: t("tools.etmEnvelope.emptyState"),
  emptyPass: t("tools.etmEnvelope.emptyPass"),
  okVerdict: t("tools.etmEnvelope.okVerdict"),
  failTitle: t("tools.etmEnvelope.failTitle"),
  decryptedLabel: t("tools.etmEnvelope.decryptedLabel"),
  byteTitle: t("tools.etmEnvelope.byteTitle"),
  byteAria: t("tools.etmEnvelope.byteAria"),
  bytesLabel: t("tools.shared.bytes"),
  insecureContext: t("tools.etmEnvelope.insecureContext"),
  error: t("tools.shared.error"),
  deriving: t("tools.etmEnvelope.keyDeriving"),
  pristine: t("tools.etmEnvelope.pristine"),
  reasonByteFlip: t("tools.etmEnvelope.reasonByteFlip"),
  reasonFlipCipher: t("tools.etmEnvelope.reasonFlipCipher"),
  reasonFlipIv: t("tools.etmEnvelope.reasonFlipIv"),
  reasonForgeTag: t("tools.etmEnvelope.reasonForgeTag"),
  reasonTruncate: t("tools.etmEnvelope.reasonTruncate"),
  reasonCrossSlot: t("tools.etmEnvelope.reasonCrossSlot"),
  reasonCrossType: t("tools.etmEnvelope.reasonCrossType"),
  reasonRollback: t("tools.etmEnvelope.reasonRollback"),
  reasonVersion: t("tools.etmEnvelope.reasonVersion"),
  decryptFirstLeakTitle: t("tools.etmEnvelope.decryptFirstLeakTitle"),
  decryptFirstLeakNote: t("tools.etmEnvelope.decryptFirstLeakNote"),
  decryptFirstOkNote: t("tools.etmEnvelope.decryptFirstOkNote"),
  oracleRunning: t("tools.etmEnvelope.oracleRunning"),
  oracleBlocked: t("tools.etmEnvelope.oracleBlocked"),
  oracleRecoveredLabel: t("tools.etmEnvelope.oracleRecoveredLabel"),
  oracleDone: t("tools.etmEnvelope.oracleDone"),
  oracleNeedBlock: t("tools.etmEnvelope.oracleNeedBlock"),
  malleabilityIdle: t("tools.etmEnvelope.malleabilityIdle"),
  malleabilityFlipped: t("tools.etmEnvelope.malleabilityFlipped"),
  rekeyIdle: t("tools.etmEnvelope.rekeyIdle"),
  rekeyChanged: t("tools.etmEnvelope.rekeyChanged"),
  rekeyRotated: t("tools.etmEnvelope.rekeyRotated"),
  retiredOpened: t("tools.etmEnvelope.retiredOpened"),
  retiredRevoked: t("tools.etmEnvelope.retiredRevoked"),
  needNewPass: t("tools.etmEnvelope.needNewPass"),
};

const segs = [
  { id: "ver", label: t("tools.etmEnvelope.fieldVer") },
  { id: "iv", label: t("tools.etmEnvelope.fieldIv") },
  { id: "tag", label: t("tools.etmEnvelope.fieldTag") },
  { id: "cipher", label: t("tools.etmEnvelope.fieldCipher") },
];

const attacks = [
  { id: "flipCipher", icon: "i-mdi:dice-multiple-outline" },
  { id: "flipIv", icon: "i-mdi:shuffle-variant" },
  { id: "forgeTag", icon: "i-mdi:draw-pen" },
  { id: "truncate", icon: "i-mdi:content-cut" },
  { id: "crossSlot", icon: "i-mdi:swap-horizontal" },
  { id: "crossType", icon: "i-mdi:rename-box-outline" },
  { id: "rollback", icon: "i-mdi:history" },
];

/** Key rows: the KEK half of meta.bin, then what the vault key keys. */
const kekRows = [
  { id: "kek", label: "KEK" },
  { id: "pin", label: "pinVerifier" },
  { id: "wrap", label: "wrapCipher" },
];
const vkRows = [
  { id: "check", label: "vkCheck", tone: "kek" },
  { id: "enc", label: t("tools.etmEnvelope.encKeyLabel"), tone: "enc" },
  { id: "mac", label: t("tools.etmEnvelope.macKeyLabel"), tone: "mac" },
];
---

<div
  class="ev"
  data-ev-id={uniqueId}
>
  <div class="ev-inputs">
    <label class="ev-field">
      <span class="ev-label">
        <span
          class="i-mdi:form-textbox-password ev-label-icon"
          aria-hidden="true"
        ></span>
        {t("tools.etmEnvelope.secretLabel")}
      </span>
      <input
        type="text"
        class="ev-input"
        data-ev-secret
        value={t("tools.etmEnvelope.secretExample")}
        spellcheck="false"
        autocomplete="off"
      />
    </label>
    <label class="ev-field">
      <span class="ev-label">
        <span
          class="i-mdi:key-outline ev-label-icon"
          aria-hidden="true"
        ></span>
        {t("tools.etmEnvelope.passphraseLabel")}
      </span>
      <input
        type="text"
        class="ev-input"
        data-ev-pass
        value={t("tools.etmEnvelope.passphraseExample")}
        spellcheck="false"
        autocomplete="off"
      />
      <span class="ev-field-note">{t("tools.etmEnvelope.passphraseNote")}</span>
    </label>
  </div>

  {/* Authenticated context prefix (bound into the tag, not part of the envelope) */}
  <fieldset class="ev-context">
    <legend class="ev-section-title">
      {t("tools.etmEnvelope.contextHeading")}
    </legend>
    <p class="ev-context-note">{t("tools.etmEnvelope.contextNote")}</p>
    <div class="ev-context-grid">
      <label class="ev-ctx-field">
        <span class="ev-ctx-label">{t("tools.etmEnvelope.fieldType")}</span>
        <select
          class="ev-input"
          data-ev-type
        >
          <option value="1">{t("tools.etmEnvelope.typeCredential")}</option>
          <option value="2">{t("tools.etmEnvelope.typeTotp")}</option>
          <option value="6">{t("tools.etmEnvelope.typeIndex")}</option>
        </select>
      </label>
      <label class="ev-ctx-field">
        <span class="ev-ctx-label">{t("tools.etmEnvelope.fieldSlot")}</span>
        <input
          type="number"
          class="ev-input"
          data-ev-slot
          value="3"
          min="0"
          max="65535"
        />
      </label>
      <label class="ev-ctx-field">
        <span class="ev-ctx-label">{t("tools.etmEnvelope.fieldGen")}</span>
        <input
          type="number"
          class="ev-input"
          data-ev-gen
          value="1"
          min="0"
          max="4294967295"
        />
      </label>
    </div>
    <p class="ev-prefix">
      <span class="ev-prefix-label">{t("tools.etmEnvelope.prefixLabel")}</span>
      <code
        class="ev-prefix-bytes"
        data-ev-prefix
      >
        …
      </code>
    </p>
  </fieldset>

  {/* Key hierarchy: passphrase → KEK → wrapped VK → record sub-keys */}
  <div class="ev-keys">
    <span class="ev-keys-note">{t("tools.etmEnvelope.keyDerivationNote")}</span>
    <span class="ev-key-group">{t("tools.etmEnvelope.keyGroupKek")}</span>
    {kekRows.map((r) => (
      <div class="ev-key-row">
        <span class="ev-key-tag ev-key-tag--kek">{r.label}</span>
        <code data-ev-key={r.id}>…</code>
      </div>
    ))}
    <span class="ev-key-group">{t("tools.etmEnvelope.keyGroupVk")}</span>
    {vkRows.map((r) => (
      <div class="ev-key-row">
        <span class={`ev-key-tag ev-key-tag--${r.tone}`}>{r.label}</span>
        <code data-ev-key={r.id}>…</code>
      </div>
    ))}
  </div>

  {/* Envelope bytes */}
  <div class="ev-envelope-head">
    <span class="ev-section-title">
      {t("tools.etmEnvelope.envelopeHeading")}
      <span
        class="ev-total"
        data-ev-total
      ></span>
    </span>
    <button
      type="button"
      class="ev-restore"
      data-ev-restore
      hidden
    >
      <span
        class="i-mdi:restore"
        aria-hidden="true"
      ></span>
      {t("tools.etmEnvelope.restore")}
    </button>
  </div>
  <p class="ev-tamper-hint">{t("tools.etmEnvelope.tamperHint")}</p>

  <div
    class="ev-envelope"
    data-ev-envelope
  >
    {segs.map((s) => (
      <div
        class="ev-seg"
        data-ev-seg-wrap={s.id}
      >
        <span class={`ev-seg-label ev-seg-label--${s.id}`}>{s.label}</span>
        <div
          class="ev-bytes"
          data-ev-bytes={s.id}
        />
      </div>
    ))}
  </div>
  <p class="ev-tamper-hint ev-length-note">
    {t("tools.etmEnvelope.lengthNote")}
  </p>

  {/* Attack toolbar */}
  <div class="ev-section-title ev-attacks-title">
    {t("tools.etmEnvelope.attacksHeading")}
  </div>
  <p class="ev-tamper-hint">{t("tools.etmEnvelope.attacksNote")}</p>
  <div
    class="ev-attacks"
    role="group"
    aria-label={t("tools.etmEnvelope.attacksHeading")}
  >
    {attacks.map((a) => (
      <button
        type="button"
        class="ev-attack"
        data-ev-attack={a.id}
      >
        <span
          class={`${a.icon} ev-attack-icon`}
          aria-hidden="true"
        />
        {t(
          `tools.etmEnvelope.atk_${a.id}` as `tools.etmEnvelope.atk_flipCipher`,
        )}
      </button>
    ))}
  </div>

  {/* Read-path mode */}
  <fieldset class="ev-mode">
    <legend class="ev-section-title">
      {t("tools.etmEnvelope.modeHeading")}
    </legend>
    <label class="ev-mode-opt">
      <input
        type="radio"
        name={`${uniqueId}-mode`}
        value="etm"
        data-ev-mode
        checked
      />
      <strong>{t("tools.etmEnvelope.modeEtm")}</strong>
      <small>{t("tools.etmEnvelope.modeEtmNote")}</small>
    </label>
    <label class="ev-mode-opt">
      <input
        type="radio"
        name={`${uniqueId}-mode`}
        value="decrypt-first"
        data-ev-mode
      />
      <strong>{t("tools.etmEnvelope.modeDecryptFirst")}</strong>
      <small>{t("tools.etmEnvelope.modeDecryptFirstNote")}</small>
    </label>
  </fieldset>

  {/* Read path verdict */}
  <div
    class="ev-verdict"
    data-ev-verdict
    role="status"
    aria-live="polite"
  ></div>

  {/* PIN change (rewrap) vs re-encryption (new vault key) */}
  <div class="ev-panel ev-rekey">
    <div class="ev-section-title">{t("tools.etmEnvelope.rekeyHeading")}</div>
    <p class="ev-tamper-hint">{t("tools.etmEnvelope.rekeyNote")}</p>
    <label class="ev-field ev-rekey-field">
      <span class="ev-label">
        <span
          class="i-mdi:key-change ev-label-icon"
          aria-hidden="true"
        ></span>
        {t("tools.etmEnvelope.newPassLabel")}
      </span>
      <input
        type="text"
        class="ev-input"
        data-ev-new-pass
        value={t("tools.etmEnvelope.newPassExample")}
        spellcheck="false"
        autocomplete="off"
      />
    </label>
    <div class="ev-rekey-actions">
      <button
        type="button"
        class="ev-attack"
        data-ev-change-pass
      >
        <span
          class="i-mdi:key-arrow-right ev-attack-icon"
          aria-hidden="true"
        ></span>
        {t("tools.etmEnvelope.btnChangePass")}
      </button>
      <button
        type="button"
        class="ev-attack"
        data-ev-reencrypt
      >
        <span
          class="i-mdi:lock-reset ev-attack-icon"
          aria-hidden="true"
        ></span>
        {t("tools.etmEnvelope.btnRotate")}
      </button>
      <button
        type="button"
        class="ev-attack"
        data-ev-retired
        disabled
      >
        <span
          class="i-mdi:account-key-outline ev-attack-icon"
          aria-hidden="true"
        ></span>
        {t("tools.etmEnvelope.btnTryRetired")}
      </button>
    </div>
    <p
      class="ev-rekey-status"
      data-ev-rekey-status
      role="status"
      aria-live="polite"
    >
      {t("tools.etmEnvelope.rekeyIdle")}
    </p>
  </div>

  {/* Padding-oracle attacker (decrypt-first only) */}
  <div class="ev-panel ev-oracle">
    <div class="ev-section-title">{t("tools.etmEnvelope.oracleHeading")}</div>
    <p class="ev-tamper-hint">{t("tools.etmEnvelope.oracleIntro")}</p>
    <button
      type="button"
      class="ev-oracle-btn"
      data-ev-oracle
    >
      <span
        class="i-mdi:robot-angry-outline ev-attack-icon"
        aria-hidden="true"
      ></span>
      {t("tools.etmEnvelope.oracleRun")}
    </button>
    <p
      class="ev-oracle-status"
      data-ev-oracle-status
      role="status"
      aria-live="polite"
    ></p>
    <div
      class="ev-oracle-out"
      data-ev-oracle-out
      hidden
    ></div>
    <p class="ev-tamper-hint ev-oracle-note">
      {t("tools.etmEnvelope.oraclePaddingNote")}
    </p>
  </div>

  {/* CBC malleability (the attacker's lever) */}
  <div class="ev-panel ev-cbc">
    <div class="ev-section-title">
      {t("tools.etmEnvelope.malleabilityHeading")}
    </div>
    <p class="ev-tamper-hint">{t("tools.etmEnvelope.malleabilityNote")}</p>
    <p
      class="ev-cbc-status"
      data-ev-cbc
      role="status"
      aria-live="polite"
    ></p>
  </div>
</div>

<script
  is:inline
  define:vars={{ uniqueId, i18n }}
>
  const root = document.querySelector(`[data-ev-id="${uniqueId}"]`);
  if (root) {
    const enc = new TextEncoder();
    const dec = new TextDecoder();
    const VER = 0x01;
    const BLOCK = 16;
    // The ESP32-S3 production work factor; each vault records its own count.
    const ITERATIONS = 175000;
    // EnvelopeRecordType values: Credential, Totp, IndexSegment (0x03 is retired).
    const TYPES = [0x01, 0x02, 0x06];
    const FIELD_NAMES = {
      ver: "ver",
      iv: "iv",
      tag: "hmacTag",
      cipher: "cipher",
    };

    const $ = (sel) => root.querySelector(sel);
    const secretInput = $("[data-ev-secret]");
    const passInput = $("[data-ev-pass]");
    const newPassInput = $("[data-ev-new-pass]");
    const typeSel = $("[data-ev-type]");
    const slotInput = $("[data-ev-slot]");
    const genInput = $("[data-ev-gen]");
    const prefixEl = $("[data-ev-prefix]");
    const verdictEl = $("[data-ev-verdict]");
    const restoreBtn = $("[data-ev-restore]");
    const totalEl = $("[data-ev-total]");
    const oracleBtn = $("[data-ev-oracle]");
    const oracleStatus = $("[data-ev-oracle-status]");
    const oracleOut = $("[data-ev-oracle-out]");
    const cbcEl = $("[data-ev-cbc]");
    const changePassBtn = $("[data-ev-change-pass]");
    const reencryptBtn = $("[data-ev-reencrypt]");
    const retiredBtn = $("[data-ev-retired]");
    const rekeyStatus = $("[data-ev-rekey-status]");
    const keyEls = {};
    root.querySelectorAll("[data-ev-key]").forEach((el) => {
      keyEls[el.dataset.evKey] = el;
    });
    const byteHosts = {
      ver: $('[data-ev-bytes="ver"]'),
      iv: $('[data-ev-bytes="iv"]'),
      tag: $('[data-ev-bytes="tag"]'),
      cipher: $('[data-ev-bytes="cipher"]'),
    };

    let vault = null; // { vk, hmacSalt, encKey, macKey, aesKey }
    let half = null; // the current KEK half of meta.bin
    let retired = null; // { pass, half } kept by a passphrase change
    // Sealed originals + a live (mutable) copy + the reader's context view.
    let state = null; // { ver, iv, tag, cipher, ctx, padded, macKey, encKey, aesKey }
    let live = null; // { ver, iv, tag, cipher } (Uint8Array copies)
    let readerCtx = null; // { type, slot, gen } the reader currently assumes
    let tampered = false;
    let lastReason = null; // i18n key suffix describing the active attack
    let mode = "etm";
    let epoch = 0; // discards results of a derivation that a newer one replaced

    // Astro scopes this component's CSS by an attribute on every element it
    // renders; nodes created here need the same attribute or no rule matches.
    const scope = Array.from(root.attributes)
      .map((a) => a.name)
      .find((name) => name.startsWith("data-astro-cid-"));
    const make = (tag) => {
      const el = document.createElement(tag);
      if (scope) el.setAttribute(scope, "");
      return el;
    };
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    const rand = (n) => crypto.getRandomValues(new Uint8Array(n));
    const fmt = (s, vars) =>
      Object.entries(vars).reduce((acc, [k, v]) => acc.replace(`{${k}}`, v), s);
    const toHex = (bytes) =>
      Array.from(bytes)
        .map((b) => b.toString(16).padStart(2, "0"))
        .join("");
    const short = (bytes) => toHex(bytes).slice(0, 24) + "…";
    const printable = (bytes) =>
      Array.from(bytes)
        .map((b) => (b >= 0x20 && b < 0x7f ? String.fromCharCode(b) : "·"))
        .join("");

    function concat(...arrs) {
      const total = arrs.reduce((n, a) => n + a.length, 0);
      const out = new Uint8Array(total);
      let off = 0;
      for (const a of arrs) {
        out.set(a, off);
        off += a.length;
      }
      return out;
    }

    function le32(v) {
      const g = v >>> 0;
      return new Uint8Array([
        g & 0xff,
        (g >>> 8) & 0xff,
        (g >>> 16) & 0xff,
        (g >>> 24) & 0xff,
      ]);
    }

    async function hmac(keyBytes, msg) {
      const k = await crypto.subtle.importKey(
        "raw",
        keyBytes,
        { name: "HMAC", hash: "SHA-256" },
        false,
        ["sign"],
      );
      return new Uint8Array(await crypto.subtle.sign("HMAC", k, msg));
    }
    const label = (key, text, ...extra) =>
      hmac(key, concat(enc.encode(text), ...extra));

    async function pbkdf2(pass, salt) {
      const base = await crypto.subtle.importKey(
        "raw",
        enc.encode(pass),
        "PBKDF2",
        false,
        ["deriveBits"],
      );
      return new Uint8Array(
        await crypto.subtle.deriveBits(
          { name: "PBKDF2", hash: "SHA-256", salt, iterations: ITERATIONS },
          base,
          256,
        ),
      );
    }

    const aesKey = (raw, usages) =>
      crypto.subtle.importKey("raw", raw, { name: "AES-CBC" }, false, usages);

    // Wrap the 32-byte VK with AES-256-CBC and no padding. WebCrypto always pads,
    // but CBC's first two blocks do not depend on the padding block: drop it.
    async function wrapVk(wrapEnc, iv, vk) {
      const k = await aesKey(wrapEnc, ["encrypt"]);
      const c = await crypto.subtle.encrypt({ name: "AES-CBC", iv }, k, vk);
      return new Uint8Array(c).slice(0, 32);
    }

    // Unwrap without padding: append the block that decrypts to a full padding
    // block, E(C2 ⊕ 0x10…), so WebCrypto's decrypt returns exactly the 32 bytes.
    async function unwrapVk(wrapEnc, iv, wrapCipher) {
      const k = await aesKey(wrapEnc, ["encrypt", "decrypt"]);
      const last = wrapCipher.slice(16, 32);
      const fill = new Uint8Array(BLOCK).fill(BLOCK);
      const tail = new Uint8Array(
        await crypto.subtle.encrypt({ name: "AES-CBC", iv: last }, k, fill),
      ).slice(0, BLOCK);
      const plain = await crypto.subtle.decrypt(
        { name: "AES-CBC", iv },
        k,
        concat(wrapCipher, tail),
      );
      return new Uint8Array(plain);
    }

    // The bytes the wrap tag covers (a simplified KEK half: the demo's fields).
    const halfBody = (h) =>
      concat(
        new Uint8Array([0x4b, 0x56, VER]),
        h.kdfSalt,
        le32(ITERATIONS),
        h.pinVerifier,
        h.vkCheck,
        h.wrapIv,
        h.wrapCipher,
      );

    // Mint a KEK half: fresh kdfSalt and wrap IV, the VK wrapped under the KEK.
    async function mintHalf(pass, vk) {
      const kdfSalt = rand(16);
      const kek = await pbkdf2(pass, kdfSalt);
      const pinVerifier = await label(kek, "kleidos-pin");
      const wrapEnc = await label(kek, "kleidos-wrap-enc");
      const wrapMac = await label(kek, "kleidos-wrap-mac");
      const vkCheck = (await label(vk, "kleidos-vk-id")).slice(0, 16);
      const wrapIv = rand(BLOCK);
      const wrapCipher = await wrapVk(wrapEnc, wrapIv, vk);
      const h = { kdfSalt, kek, pinVerifier, vkCheck, wrapIv, wrapCipher };
      h.wrapTag = await hmac(wrapMac, halfBody(h));
      return h;
    }

    // Open a half the way unlock does: tag, then verifier, then unwrap + vkCheck.
    async function openHalf(pass, h) {
      const kek = await pbkdf2(pass, h.kdfSalt);
      const wrapMac = await label(kek, "kleidos-wrap-mac");
      const tag = await hmac(wrapMac, halfBody(h));
      if (!ctEqual(tag, h.wrapTag)) return null;
      if (!ctEqual(await label(kek, "kleidos-pin"), h.pinVerifier)) return null;
      const wrapEnc = await label(kek, "kleidos-wrap-enc");
      const vk = await unwrapVk(wrapEnc, h.wrapIv, h.wrapCipher);
      const check = (await label(vk, "kleidos-vk-id")).slice(0, 16);
      return ctEqual(check, h.vkCheck) ? vk : null;
    }

    async function vaultKeys(vk, hmacSalt) {
      const encKey = await label(vk, "kleidos-enc");
      const macKey = await label(vk, "kleidos-mac", hmacSalt);
      const aes = await aesKey(encKey, ["encrypt", "decrypt"]);
      return { encKey, macKey, aesKey: aes };
    }

    // authPrefix = ver(1) ‖ recordType(1) ‖ slotId(2, LE) ‖ generation(4, LE)
    function authPrefix(ctx) {
      const head = [
        VER,
        ctx.type & 0xff,
        ctx.slot & 0xff,
        (ctx.slot >>> 8) & 0xff,
      ];
      return concat(new Uint8Array(head), le32(ctx.gen));
    }

    // The authenticated message: authPrefix ‖ iv ‖ cipher
    function authMsg(ctx, iv, cipher) {
      return concat(authPrefix(ctx), iv, cipher);
    }

    // PKCS#7 pad to the AES block size (so block 0 is exact for the malleability demo).
    function pkcs7(bytes) {
      const padLen = BLOCK - (bytes.length % BLOCK);
      return concat(bytes, new Uint8Array(padLen).fill(padLen));
    }

    // Constant-time-style compare (mirrors the firmware's mbedtls_ct_memcmp intent).
    function ctEqual(a, b) {
      if (a.length !== b.length) return false;
      let diff = 0;
      for (let i = 0; i < a.length; i++) diff |= a[i] ^ b[i];
      return diff === 0;
    }

    function readCtxInputs() {
      const type = Number(typeSel.value);
      return {
        type: TYPES.includes(type) ? type : TYPES[0],
        slot: Math.max(0, Math.min(0xffff, Number(slotInput.value) || 0)),
        gen: Math.max(0, Math.min(0xffffffff, Number(genInput.value) || 0)),
      };
    }

    function cryptoAvailable() {
      return Boolean(window.isSecureContext && window.crypto && crypto.subtle);
    }

    function clearEnvelope() {
      state = live = readerCtx = null;
      tampered = false;
      lastReason = null;
      restoreBtn.hidden = true;
      totalEl.textContent = "";
      prefixEl.textContent = "…";
      for (const id of Object.keys(byteHosts)) byteHosts[id].textContent = "";
      updateMalleability();
    }

    function renderKeys() {
      const show = (id, bytes) => {
        keyEls[id].textContent = bytes ? short(bytes) : "…";
      };
      show("kek", half && half.kek);
      show("pin", half && half.pinVerifier);
      show("wrap", half && half.wrapCipher);
      show("check", half && half.vkCheck);
      show("enc", vault && vault.encKey);
      show("mac", vault && vault.macKey);
    }

    function setRekeyStatus(text, tone) {
      rekeyStatus.textContent = text;
      rekeyStatus.className = tone
        ? `ev-rekey-status ev-rekey-status--${tone}`
        : "ev-rekey-status";
    }

    function setBusy(busy) {
      changePassBtn.disabled = busy || !vault;
      reencryptBtn.disabled = busy || !vault;
      retiredBtn.disabled = busy || !retired;
    }

    // A fresh vault: new VK and hmacSalt, a KEK half minted from the passphrase.
    async function provision() {
      const my = ++epoch;
      resetOracle();
      if (!cryptoAvailable()) {
        vault = half = retired = null;
        clearEnvelope();
        renderKeys();
        verdictEl.className = "ev-verdict ev-verdict--empty";
        verdictEl.textContent = i18n.insecureContext;
        setBusy(true);
        return;
      }
      const pass = passInput.value;
      if (!pass) {
        vault = half = retired = null;
        clearEnvelope();
        renderKeys();
        setVerdict("empty", { text: i18n.emptyPass });
        setBusy(true);
        return;
      }
      setBusy(true);
      for (const el of Object.values(keyEls)) el.textContent = i18n.deriving;
      try {
        const vk = rand(32);
        const hmacSalt = rand(16);
        const keys = await vaultKeys(vk, hmacSalt);
        const h = await mintHalf(pass, vk);
        if (my !== epoch) return;
        vault = { vk, hmacSalt, ...keys };
        half = h;
        retired = null;
        renderKeys();
        setRekeyStatus(i18n.rekeyIdle);
        await seal();
      } catch {
        if (my !== epoch) return;
        verdictEl.className = "ev-verdict ev-verdict--fail";
        verdictEl.textContent = i18n.error;
      } finally {
        if (my === epoch) setBusy(false);
      }
    }

    // Seal the secret under the current vault keys, at the context set above.
    async function seal() {
      resetOracle();
      if (!vault) return;
      const secret = secretInput.value;
      if (!secret) {
        clearEnvelope();
        setVerdict("empty");
        return;
      }
      try {
        const ctx = readCtxInputs();
        const iv = rand(BLOCK);
        const plain = enc.encode(secret);
        const cipher = new Uint8Array(
          await crypto.subtle.encrypt(
            { name: "AES-CBC", iv },
            vault.aesKey,
            plain,
          ),
        );
        const ver = new Uint8Array([VER]);
        const tag = await hmac(vault.macKey, authMsg(ctx, iv, cipher));
        state = {
          ver,
          iv,
          tag,
          cipher,
          ctx,
          padded: pkcs7(plain),
          encKey: vault.encKey,
          macKey: vault.macKey,
          aesKey: vault.aesKey,
        };
        live = {
          ver: ver.slice(),
          iv: iv.slice(),
          tag: tag.slice(),
          cipher: cipher.slice(),
        };
        readerCtx = { ...ctx };
        tampered = false;
        lastReason = null;
        render();
        updateMalleability();
        await readPath();
      } catch {
        verdictEl.className = "ev-verdict ev-verdict--fail";
        verdictEl.textContent = i18n.error;
      }
    }

    function renderPrefix() {
      const sealed = authPrefix(state.ctx);
      const reader = authPrefix(readerCtx);
      prefixEl.textContent = "";
      reader.forEach((b, i) => {
        const span = make("span");
        span.className = "ev-pfx-byte";
        if (b !== sealed[i]) span.classList.add("ev-pfx-byte--changed");
        span.textContent = b.toString(16).padStart(2, "0");
        prefixEl.appendChild(span);
      });
    }

    function render() {
      for (const id of Object.keys(byteHosts)) {
        const host = byteHosts[id];
        host.textContent = "";
        const bytes = live[id];
        bytes.forEach((b, idx) => {
          const cell = make("button");
          const hex = b.toString(16).padStart(2, "0");
          cell.type = "button";
          cell.className = `ev-byte ev-byte--${id}`;
          cell.textContent = hex;
          cell.dataset.seg = id;
          cell.dataset.idx = String(idx);
          cell.title = i18n.byteTitle;
          cell.setAttribute(
            "aria-label",
            fmt(i18n.byteAria, {
              field: FIELD_NAMES[id],
              index: String(idx),
              hex,
            }),
          );
          const orig = state[id];
          if (idx >= orig.length || orig[idx] !== b)
            cell.classList.add("ev-byte--flipped");
          host.appendChild(cell);
        });
      }
      const total =
        live.ver.length + live.iv.length + live.tag.length + live.cipher.length;
      totalEl.textContent = i18n.bytesLabel.replace("{count}", String(total));
      renderPrefix();
      const ctxChanged =
        readerCtx.type !== state.ctx.type ||
        readerCtx.slot !== state.ctx.slot ||
        readerCtx.gen !== state.ctx.gen;
      restoreBtn.hidden = !(tampered || ctxChanged);
    }

    // Recompute the tag over the reader's context + the live IV/cipher.
    async function tagMatches() {
      const expected = await hmac(
        state.macKey,
        authMsg(readerCtx, live.iv, live.cipher),
      );
      return ctEqual(expected, live.tag);
    }

    async function tryDecrypt() {
      const plain = await crypto.subtle.decrypt(
        { name: "AES-CBC", iv: live.iv },
        state.aesKey,
        live.cipher,
      );
      return dec.decode(new Uint8Array(plain));
    }

    async function readPath() {
      if (!state) return;
      if (mode === "etm") {
        // Structure and version are checked before the tag, as the firmware does.
        if (live.cipher.length === 0 || live.cipher.length % BLOCK !== 0) {
          setVerdict("fail", { reason: "truncate" });
          return;
        }
        if (live.ver[0] !== VER) {
          setVerdict("fail", { reason: "version" });
          return;
        }
        // Verify-before-decrypt: the MAC gate runs first.
        if (!(await tagMatches())) {
          setVerdict("fail");
          return;
        }
        try {
          setVerdict("ok", { plaintext: await tryDecrypt() });
        } catch {
          setVerdict("fail");
        }
        return;
      }
      // decrypt-first (the doom path): decryption runs on attacker bytes BEFORE
      // the MAC is ever consulted — this is exactly where the oracle leaks.
      try {
        const plaintext = await tryDecrypt();
        const macOk = await tagMatches();
        setVerdict("leak-ok", { plaintext, macOk });
      } catch {
        // WebCrypto threw OperationError == "invalid padding" == the oracle bit.
        setVerdict("leak-bad");
      }
    }

    function clearVerdict() {
      verdictEl.innerHTML = "";
    }
    function addIcon(cls) {
      const icon = make("span");
      icon.className = `${cls} ev-verdict-icon`;
      icon.setAttribute("aria-hidden", "true");
      verdictEl.appendChild(icon);
    }
    function reasonText(reason) {
      const key = reason || lastReason;
      if (!key) return i18n.pristine;
      const map = {
        flipCipher: i18n.reasonFlipCipher,
        flipIv: i18n.reasonFlipIv,
        forgeTag: i18n.reasonForgeTag,
        truncate: i18n.reasonTruncate,
        crossSlot: i18n.reasonCrossSlot,
        crossType: i18n.reasonCrossType,
        rollback: i18n.reasonRollback,
        version: i18n.reasonVersion,
        byte: i18n.reasonByteFlip,
      };
      return map[key] || i18n.reasonByteFlip;
    }

    function verdictLine(title, note) {
      const wrap = make("span");
      const strong = make("strong");
      strong.textContent = title + " ";
      const why = make("span");
      why.className = "ev-why";
      why.textContent = note;
      wrap.append(strong, why);
      verdictEl.appendChild(wrap);
    }

    function plainLine(prefix, plaintext, suffix) {
      const wrap = make("span");
      if (prefix) {
        const txt = make("span");
        txt.textContent = prefix + " ";
        wrap.appendChild(txt);
      }
      const lbl = make("span");
      lbl.className = "ev-plain-label";
      lbl.textContent = i18n.decryptedLabel + ": ";
      const out = make("strong");
      out.className = "ev-plain";
      out.textContent = plaintext;
      wrap.append(lbl, out);
      if (suffix) {
        const why = make("span");
        why.className = "ev-why";
        why.textContent = " · " + suffix;
        wrap.appendChild(why);
      }
      verdictEl.appendChild(wrap);
    }

    function setVerdict(kind, opts = {}) {
      if (kind === "empty") {
        verdictEl.className = "ev-verdict ev-verdict--empty";
        verdictEl.textContent = opts.text || i18n.emptyState;
        return;
      }
      clearVerdict();
      if (kind === "fail") {
        verdictEl.className = "ev-verdict ev-verdict--fail";
        addIcon("i-mdi:close-octagon-outline");
        verdictLine(i18n.failTitle, reasonText(opts.reason));
        return;
      }
      if (kind === "leak-bad") {
        // decrypt-first, decryption threw → padding-oracle signal leaked.
        verdictEl.className = "ev-verdict ev-verdict--leak";
        addIcon("i-mdi:alert-octagon-outline");
        verdictLine(i18n.decryptFirstLeakTitle, i18n.decryptFirstLeakNote);
        return;
      }
      if (kind === "leak-ok") {
        // decrypt-first, decryption succeeded → plaintext already exposed,
        // and only THEN is the MAC checked (too late).
        verdictEl.className = "ev-verdict ev-verdict--leak";
        addIcon("i-mdi:lock-open-alert-outline");
        const note = i18n.decryptFirstOkNote.replace(
          "{mac}",
          opts.macOk ? "✓" : "✗",
        );
        plainLine("", opts.plaintext, note);
        return;
      }
      // ok (EtM happy path)
      verdictEl.className = "ev-verdict ev-verdict--ok";
      addIcon("i-mdi:check-decagram-outline");
      plainLine(i18n.okVerdict, opts.plaintext);
    }

    // ---- CBC malleability (the attacker's lever) -------------------------
    // For block 0, ΔP0[i] == ΔIV[i] exactly: flipping an IV byte flips the
    // matching plaintext byte by the same delta. We show that controlled change
    // without needing to decrypt (it's a deterministic property of CBC).
    function updateMalleability() {
      const diffs = [];
      if (state) {
        for (let i = 0; i < BLOCK; i++) {
          const delta = live.iv[i] ^ state.iv[i];
          if (delta !== 0) diffs.push({ i, delta });
        }
      }
      if (diffs.length === 0) {
        cbcEl.textContent = i18n.malleabilityIdle;
        cbcEl.classList.remove("ev-cbc--active");
        return;
      }
      const p0 = state.padded.slice(0, BLOCK);
      const hex = (b) => `0x${b.toString(16).padStart(2, "0")}`;
      const chr = (b) => (b >= 0x20 && b < 0x7f ? String.fromCharCode(b) : "·");
      const parts = diffs.map((d) => {
        const before = p0[d.i];
        const after = (before ^ d.delta) & 0xff;
        return `#${d.i}: ${chr(before)} (${hex(before)}) → ${chr(after)} (${hex(after)})  [⊕${hex(d.delta)}]`;
      });
      cbcEl.textContent = i18n.malleabilityFlipped + " " + parts.join(" · ");
      cbcEl.classList.add("ev-cbc--active");
    }

    // ---- PIN change vs re-encryption -------------------------------------
    // A passphrase change mints a new KEK half around the SAME vault key: the
    // envelope is not touched. Re-encryption draws a new vault key and seals
    // the record again, which is what revokes an old half.
    async function changePassphrase() {
      const next = newPassInput.value;
      if (!vault || !next || next === passInput.value) {
        setRekeyStatus(i18n.needNewPass, "warn");
        return;
      }
      const my = epoch;
      setBusy(true);
      try {
        const h = await mintHalf(next, vault.vk);
        if (my !== epoch) return;
        retired = { pass: passInput.value, half };
        half = h;
        passInput.value = next;
        newPassInput.value = "";
        renderKeys();
        setRekeyStatus(i18n.rekeyChanged, "ok");
        await readPath();
      } catch {
        setRekeyStatus(i18n.error, "warn");
      } finally {
        if (my === epoch) setBusy(false);
      }
    }

    async function reencrypt() {
      if (!vault) return;
      const my = epoch;
      setBusy(true);
      try {
        const vk = rand(32);
        const keys = await vaultKeys(vk, vault.hmacSalt);
        const h = await mintHalf(passInput.value, vk);
        if (my !== epoch) return;
        vault = { vk, hmacSalt: vault.hmacSalt, ...keys };
        half = h;
        renderKeys();
        await seal();
        setRekeyStatus(i18n.rekeyRotated, "ok");
      } catch {
        setRekeyStatus(i18n.error, "warn");
      } finally {
        if (my === epoch) setBusy(false);
      }
    }

    // The T19 check: a retired passphrase plus the meta.bin from before the
    // change, against the envelope as it sits on flash now.
    async function tryRetired() {
      if (!retired || !state) return;
      const my = epoch;
      setBusy(true);
      try {
        const vk = await openHalf(retired.pass, retired.half);
        if (my !== epoch) return;
        if (!vk) {
          setRekeyStatus(i18n.retiredRevoked, "ok");
          return;
        }
        const keys = await vaultKeys(vk, vault.hmacSalt);
        const msg = authMsg(state.ctx, state.iv, state.cipher);
        if (!ctEqual(await hmac(keys.macKey, msg), state.tag)) {
          setRekeyStatus(i18n.retiredRevoked, "ok");
          return;
        }
        const plain = await crypto.subtle.decrypt(
          { name: "AES-CBC", iv: state.iv },
          keys.aesKey,
          state.cipher,
        );
        const text = dec.decode(new Uint8Array(plain));
        setRekeyStatus(fmt(i18n.retiredOpened, { plain: text }), "warn");
      } catch {
        setRekeyStatus(i18n.error, "warn");
      } finally {
        if (my === epoch) setBusy(false);
      }
    }

    // ---- Padding-oracle attacker -----------------------------------------
    function resetOracle() {
      if (oracleStatus) {
        oracleStatus.textContent = "";
        oracleStatus.className = "ev-oracle-status";
      }
      if (oracleOut) {
        oracleOut.hidden = true;
        oracleOut.textContent = "";
      }
    }

    // Oracle: WebCrypto AES-CBC decrypt throws OperationError on invalid PKCS#7
    // padding and succeeds otherwise — exactly the one-bit signal Vaudenay needs.
    async function paddingValid(prev16, target16, counter) {
      counter.queries++;
      try {
        await crypto.subtle.decrypt(
          { name: "AES-CBC", iv: prev16 },
          state.aesKey,
          target16,
        );
        return true;
      } catch {
        return false;
      }
    }

    // Recover one plaintext block byte-by-byte using only the padding bit.
    async function recoverBlock(prevReal, target, onByte, counter, pause) {
      const inter = new Uint8Array(BLOCK); // I = Dec(target)
      const craft = new Uint8Array(BLOCK);
      for (let pos = BLOCK - 1; pos >= 0; pos--) {
        const pad = BLOCK - pos;
        for (let k = pos + 1; k < BLOCK; k++) craft[k] = inter[k] ^ pad;
        for (let g = 0; g < 256; g++) {
          craft[pos] = g;
          if (await paddingValid(craft, target, counter)) {
            if (pos === BLOCK - 1) {
              // Guard against a coincidental 0x02 0x02 … by perturbing byte 14.
              craft[BLOCK - 2] ^= 0xff;
              const ok2 = await paddingValid(craft, target, counter);
              craft[BLOCK - 2] ^= 0xff;
              if (!ok2) continue;
            }
            inter[pos] = g ^ pad;
            break;
          }
        }
        onByte(pos, inter[pos] ^ prevReal[pos]);
        if (pause) await sleep(pause);
      }
    }

    async function runOracle() {
      if (!state) return;
      if (mode !== "decrypt-first") {
        oracleStatus.textContent = i18n.oracleBlocked;
        oracleStatus.className = "ev-oracle-status ev-oracle-status--blocked";
        oracleOut.hidden = true;
        return;
      }
      const C = live.cipher;
      if (C.length < BLOCK || C.length % BLOCK !== 0) {
        oracleStatus.textContent = i18n.oracleNeedBlock;
        return;
      }
      const blocks = C.length / BLOCK;
      let pause = 0;
      if (blocks <= 2) pause = 20;
      else if (blocks <= 6) pause = 6;
      oracleBtn.disabled = true;
      oracleStatus.className = "ev-oracle-status";
      oracleOut.hidden = false;
      oracleOut.textContent = "";
      const recovered = new Uint8Array(C.length);
      const cells = [];
      for (let b = 0; b < blocks; b++) {
        const row = make("div");
        row.className = "ev-oracle-bytes";
        for (let i = 0; i < BLOCK; i++) {
          const c = make("span");
          c.className = "ev-oracle-byte";
          c.textContent = "··";
          row.appendChild(c);
          cells.push(c);
        }
        oracleOut.appendChild(row);
      }
      const txt = make("div");
      txt.className = "ev-oracle-text";
      oracleOut.appendChild(txt);
      const counter = { queries: 0 };
      const onByte = (b) => (pos, byte) => {
        const at = b * BLOCK + pos;
        recovered[at] = byte;
        cells[at].textContent = byte.toString(16).padStart(2, "0");
        cells[at].classList.add("ev-oracle-byte--got");
        txt.textContent = `${i18n.oracleRecoveredLabel} “${printable(recovered)}”`;
      };
      try {
        for (let b = 0; b < blocks; b++) {
          oracleStatus.textContent = fmt(i18n.oracleRunning, {
            block: String(b + 1),
            total: String(blocks),
          });
          // Block 0 is chained to the IV, every later block to the one before.
          const prev = b === 0 ? live.iv : C.slice((b - 1) * BLOCK, b * BLOCK);
          const target = C.slice(b * BLOCK, (b + 1) * BLOCK);
          await recoverBlock(prev, target, onByte(b), counter, pause);
        }
        const lang = document.documentElement.lang || undefined;
        oracleStatus.textContent = fmt(i18n.oracleDone, {
          bytes: String(C.length),
          queries: counter.queries.toLocaleString(lang),
        });
        oracleStatus.className = "ev-oracle-status ev-oracle-status--done";
      } finally {
        oracleBtn.disabled = false;
      }
    }

    // ---- events -----------------------------------------------------------
    $("[data-ev-envelope]").addEventListener("click", (e) => {
      const cell = e.target.closest(".ev-byte");
      if (!cell || !live) return;
      const seg = cell.dataset.seg;
      const idx = Number(cell.dataset.idx);
      live[seg][idx] ^= 0xff;
      tampered = true;
      if (seg === "iv") lastReason = "flipIv";
      else if (seg === "cipher") lastReason = "flipCipher";
      else lastReason = "byte";
      render();
      updateMalleability();
      readPath();
      resetOracle();
      // Re-rendering replaced the cell: keep keyboard focus on the same byte.
      const again = byteHosts[seg].children[idx];
      if (again) again.focus();
    });

    root.querySelectorAll("[data-ev-attack]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!live) return;
        const kind = btn.dataset.evAttack;
        const rnd = (max) =>
          crypto.getRandomValues(new Uint32Array(1))[0] % max;
        if (kind === "flipCipher" && live.cipher.length) {
          live.cipher[rnd(live.cipher.length)] ^= 0xff;
          tampered = true;
        } else if (kind === "flipIv") {
          live.iv[rnd(BLOCK)] ^= 0xff;
          tampered = true;
        } else if (kind === "forgeTag") {
          live.tag = rand(live.tag.length);
          tampered = true;
        } else if (kind === "truncate" && live.cipher.length > BLOCK) {
          live.cipher = live.cipher.slice(0, live.cipher.length - BLOCK);
          tampered = true;
        } else if (kind === "crossSlot") {
          readerCtx.slot = (state.ctx.slot + 2) & 0xffff;
          slotInput.value = String(readerCtx.slot);
        } else if (kind === "crossType") {
          const next = (TYPES.indexOf(state.ctx.type) + 1) % TYPES.length;
          readerCtx.type = TYPES[next];
          typeSel.value = String(readerCtx.type);
        } else if (kind === "rollback") {
          readerCtx.gen = (state.ctx.gen + 1) >>> 0;
          genInput.value = String(readerCtx.gen);
        }
        lastReason = kind;
        render();
        updateMalleability();
        readPath();
        resetOracle();
      });
    });

    restoreBtn.addEventListener("click", () => {
      if (!state) return;
      live = {
        ver: state.ver.slice(),
        iv: state.iv.slice(),
        tag: state.tag.slice(),
        cipher: state.cipher.slice(),
      };
      readerCtx = { ...state.ctx };
      typeSel.value = String(state.ctx.type);
      slotInput.value = String(state.ctx.slot);
      genInput.value = String(state.ctx.gen);
      tampered = false;
      lastReason = null;
      render();
      updateMalleability();
      readPath();
      resetOracle();
    });

    root.querySelectorAll("[data-ev-mode]").forEach((r) => {
      r.addEventListener("change", () => {
        if (r.checked) {
          mode = r.value;
          resetOracle();
          readPath();
        }
      });
    });

    oracleBtn.addEventListener("click", runOracle);
    changePassBtn.addEventListener("click", changePassphrase);
    reencryptBtn.addEventListener("click", reencrypt);
    retiredBtn.addEventListener("click", tryRetired);

    function debounce(fn, d) {
      let to;
      return (...a) => {
        clearTimeout(to);
        to = setTimeout(() => fn(...a), d);
      };
    }
    secretInput.addEventListener("input", debounce(seal, 200));
    // Editing the passphrase field provisions a fresh vault (PBKDF2 runs again).
    passInput.addEventListener("input", debounce(provision, 400));
    // Changing a context field at the top RE-SEALS (the record's home context).
    const onCtx = debounce(seal, 200);
    [typeSel, slotInput, genInput].forEach((el) =>
      el.addEventListener("change", onCtx),
    );

    provision();
  }
</script>

<style>
  .ev {
    /* Categorical field hues from the central --dg-cat-* ramp (themed AA). */
    --ev-ver: var(--dg-cat-1);
