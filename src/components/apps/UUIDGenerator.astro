---
/**
 * UUIDGenerator Component
 * Generates UUID v4, UUID v7, ULID, and Nano ID.
 *
 * Usage:
 * <UUIDGenerator title="UUID Generator" />
 */

interface Props {
  title?: string;
}

const { title = "UUID / ID Generator" } = Astro.props;
const uniqueId = `uuid-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

const formats = [
  { id: "uuidv4", name: "UUID v4", description: "Random UUID (RFC 4122)" },
  {
    id: "uuidv7",
    name: "UUID v7",
    description: "Timestamp-based UUID (RFC 9562)",
  },
  {
    id: "ulid",
    name: "ULID",
    description: "Universally Unique Lexicographically Sortable",
  },
  { id: "nanoid", name: "Nano ID", description: "Compact URL-safe unique ID" },
];
---

<div
  class="uuid-gen"
  data-uuid-id={uniqueId}
>
  {title && <div class="uuid-title">{title}</div>}

  <div class="uuid-layout">
    {/* Format selection */}
    <div class="uuid-formats">
      {
        formats.map((f, idx) => (
          <button
            type="button"
            class:list={["uuid-format-btn", { active: idx === 0 }]}
            data-format={f.id}
          >
            <span class="uuid-format-name">{f.name}</span>
            <span class="uuid-format-desc">{f.description}</span>
          </button>
        ))
      }
    </div>

    {/* Options */}
    <div class="uuid-options">
      <div class="uuid-option-row">
        <label for={`${uniqueId}-count`}>Count</label>
        <div class="uuid-count-row">
          <input
            type="range"
            id={`${uniqueId}-count`}
            min="1"
            max="50"
            value="5"
            class="uuid-range"
          />
          <span
            class="uuid-count-value"
            id={`${uniqueId}-count-value`}
            >5</span
          >
        </div>
      </div>
      <div
        class="uuid-option-row"
        id={`${uniqueId}-nanoid-length-row`}
        hidden
      >
        <label for={`${uniqueId}-nanoid-length`}>Length</label>
        <div class="uuid-count-row">
          <input
            type="range"
            id={`${uniqueId}-nanoid-length`}
            min="6"
            max="64"
            value="21"
            class="uuid-range"
          />
          <span
            class="uuid-count-value"
            id={`${uniqueId}-nanoid-length-value`}
            >21</span
          >
        </div>
      </div>
    </div>

    {/* Actions */}
    <div class="uuid-actions">
      <button
        type="button"
        class="uuid-generate-btn"
      >
        <span
          class="i-mdi:refresh"
          aria-hidden="true"
        ></span>
        Generate
      </button>
      <button
        type="button"
        class="uuid-copy-all-btn"
      >
        <span
          class="i-mdi:content-copy"
          aria-hidden="true"
        ></span>
        Copy All
      </button>
    </div>

    {/* Output */}
    {
      /* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- scrollable region requires keyboard access */
    }
    <div
      class="uuid-output"
      id={`${uniqueId}-output`}
      aria-live="polite"
      tabindex="0"
      role="region"
      aria-label="Generated UUIDs"
    >
    </div>
    {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}

    {/* Info */}
    <div
      class="uuid-info"
      id={`${uniqueId}-info`}
      hidden
    >
      <span
        class="i-mdi:information-outline"
        aria-hidden="true"
      ></span>
      <span id={`${uniqueId}-info-text`}></span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ uniqueId }}>
  (function () {
    const container = document.querySelector(`[data-uuid-id="${uniqueId}"]`);
    if (!container) return;

    const outputEl = document.getElementById(`${uniqueId}-output`);
    const countInput = document.getElementById(`${uniqueId}-count`);
    const countValue = document.getElementById(`${uniqueId}-count-value`);
    const nanoidLengthRow = document.getElementById(
      `${uniqueId}-nanoid-length-row`,
    );
    const nanoidLength = document.getElementById(`${uniqueId}-nanoid-length`);
    const nanoidLengthValue = document.getElementById(
      `${uniqueId}-nanoid-length-value`,
    );
    const infoEl = document.getElementById(`${uniqueId}-info`);
    const infoText = document.getElementById(`${uniqueId}-info-text`);
    const formatBtns = container.querySelectorAll(".uuid-format-btn");
    const generateBtn = container.querySelector(".uuid-generate-btn");
    const copyAllBtn = container.querySelector(".uuid-copy-all-btn");

    if (!outputEl) return;

    var currentFormat = "uuidv4";

    // Generators
    function generateUUIDv4() {
      var arr = new Uint8Array(16);
      crypto.getRandomValues(arr);
      arr[6] = (arr[6] & 0x0f) | 0x40; // version 4
      arr[8] = (arr[8] & 0x3f) | 0x80; // variant 10
      var hex = Array.from(arr)
        .map(function (b) {
          return b.toString(16).padStart(2, "0");
        })
        .join("");
      return (
        hex.slice(0, 8) +
        "-" +
        hex.slice(8, 12) +
        "-" +
        hex.slice(12, 16) +
        "-" +
        hex.slice(16, 20) +
        "-" +
        hex.slice(20)
      );
    }

    function generateUUIDv7() {
      var now = Date.now();
      var arr = new Uint8Array(16);
      crypto.getRandomValues(arr);

      // First 48 bits: Unix timestamp in ms
      arr[0] = (now / 1099511627776) & 0xff;
      arr[1] = (now / 4294967296) & 0xff;
      arr[2] = (now / 16777216) & 0xff;
      arr[3] = (now / 65536) & 0xff;
      arr[4] = (now / 256) & 0xff;
      arr[5] = now & 0xff;

      arr[6] = (arr[6] & 0x0f) | 0x70; // version 7
      arr[8] = (arr[8] & 0x3f) | 0x80; // variant 10

      var hex = Array.from(arr)
        .map(function (b) {
          return b.toString(16).padStart(2, "0");
        })
        .join("");
      return (
        hex.slice(0, 8) +
        "-" +
        hex.slice(8, 12) +
        "-" +
        hex.slice(12, 16) +
        "-" +
        hex.slice(16, 20) +
        "-" +
        hex.slice(20)
      );
    }

    function generateULID() {
      var ENCODING = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
      var now = Date.now();

      // Timestamp: 10 chars (48 bits)
      var ts = "";
      var t = now;
      for (var i = 9; i >= 0; i--) {
        ts = ENCODING[t % 32] + ts;
        t = Math.floor(t / 32);
      }

      // Randomness: 16 chars (80 bits)
      var rand = "";
      var arr = new Uint8Array(10);
      crypto.getRandomValues(arr);
      for (var i = 0; i < 10; i++) {
        // Use each byte to generate ~1.6 chars, but simplify to 1 char per byte + extras
        rand += ENCODING[arr[i] % 32];
      }
      // Need 16 random chars total
      var arr2 = new Uint8Array(6);
      crypto.getRandomValues(arr2);
      for (var i = 0; i < 6; i++) {
        rand += ENCODING[arr2[i] % 32];
      }

      return ts + rand;
    }

    function generateNanoID(len) {
      var alphabet =
        "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_-";
      var arr = new Uint8Array(len);
      crypto.getRandomValues(arr);
      var id = "";
      for (var i = 0; i < len; i++) {
        id += alphabet[arr[i] & 63];
      }
      return id;
    }

    function generate() {
      var count = parseInt(countInput.value);
      var ids = [];

      for (var i = 0; i < count; i++) {
        if (currentFormat === "uuidv4") ids.push(generateUUIDv4());
        else if (currentFormat === "uuidv7") ids.push(generateUUIDv7());
        else if (currentFormat === "ulid") ids.push(generateULID());
        else if (currentFormat === "nanoid")
          ids.push(generateNanoID(parseInt(nanoidLength.value)));
      }

      // Render
      outputEl.textContent = "";
      ids.forEach(function (id) {
        var row = document.createElement("div");
        row.className = "uuid-row";

        var code = document.createElement("code");
        code.textContent = id;
        code.className = "uuid-value";

        var btn = document.createElement("button");
        btn.type = "button";
        btn.className = "uuid-copy-btn";
        btn.setAttribute("aria-label", "Copy " + id);
        var icon = document.createElement("span");
        icon.className = "i-mdi:content-copy";
        btn.appendChild(icon);

        btn.addEventListener("click", function () {
          if (navigator.clipboard) {
            navigator.clipboard.writeText(id).then(function () {
              btn.classList.add("copied");
              icon.className = "i-mdi:check";
              setTimeout(function () {
                btn.classList.remove("copied");
                icon.className = "i-mdi:content-copy";
              }, 1500);
            });
          }
        });

        row.appendChild(code);
        row.appendChild(btn);
        outputEl.appendChild(row);
      });

      // Info
      if (infoEl && infoText) {
        infoEl.hidden = false;
        if (currentFormat === "uuidv7") {
          var d = new Date();
          infoText.textContent =
            "Timestamp embedded: " +
            d.toISOString() +
            " — UUIDs are sortable by creation time.";
        } else if (currentFormat === "ulid") {
          infoText.textContent =
            "Timestamp-prefixed, lexicographically sortable. Compatible with UUID storage.";
        } else if (currentFormat === "uuidv4") {
          infoText.textContent =
            "122 bits of randomness. Collision probability: ~1 in 2.71 quintillion per pair.";
        } else {
          var bits = Math.floor(parseInt(nanoidLength.value) * 6);
          infoText.textContent =
            bits + " bits of entropy. URL-safe alphabet (A-Za-z0-9_-).";
        }
      }
    }

    // Format buttons
    formatBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        formatBtns.forEach(function (b) {
          b.classList.remove("active");
        });
        btn.classList.add("active");
        currentFormat = btn.dataset.format;

        if (nanoidLengthRow) {
          nanoidLengthRow.hidden = currentFormat !== "nanoid";
        }

        generate();
      });
    });

    // Count
    if (countInput) {
      countInput.addEventListener("input", function () {
        if (countValue) countValue.textContent = countInput.value;
        generate();
      });
    }

    // Nano ID length
    if (nanoidLength) {
      nanoidLength.addEventListener("input", function () {
        if (nanoidLengthValue)
          nanoidLengthValue.textContent = nanoidLength.value;
        generate();
      });
    }

    // Generate button
    if (generateBtn) generateBtn.addEventListener("click", generate);

    // Copy all
    if (copyAllBtn) {
      copyAllBtn.addEventListener("click", function () {
        var codes = outputEl.querySelectorAll(".uuid-value");
        var text = Array.from(codes)
          .map(function (c) {
            return c.textContent;
          })
          .join("\n");
        if (navigator.clipboard && text) {
          navigator.clipboard.writeText(text).then(function () {
            var span = copyAllBtn.querySelector("span:last-child");
            if (span) {
              var orig = span.className;
              span.className = "i-mdi:check";
              setTimeout(function () {
                span.className = orig;
              }, 1500);
            }
          });
        }
      });
    }

    generate();
  })();
</script>

<style>
  .uuid-gen {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-subtle);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .uuid-title {
    padding: 1rem 1.25rem;
    font-size: 1.1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
    background: var(--color-bg-secondary);
    border-bottom: var(--border-1);
  }

  .uuid-layout {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
  }

  /* Formats */
  .uuid-formats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.5rem;
  }

  .uuid-format-btn {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.75rem;
    text-align: left;
    cursor: pointer;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: all 0.15s;
  }

  .uuid-format-btn:hover {
    border-color: var(--color-primary);
  }

  .uuid-format-btn.active {
    background: rgb(from var(--color-primary) r g b / 8%);
    border-color: var(--color-primary);
  }

  .uuid-format-name {
    font-size: 0.9rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .uuid-format-desc {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  /* Options */
  .uuid-options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .uuid-option-row {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .uuid-option-row[hidden] {
    display: none;
  }

  .uuid-option-row label {
    min-width: 60px;
    font-size: 0.85rem;
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .uuid-count-row {
    display: flex;
    flex: 1;
    gap: 0.75rem;
    align-items: center;
  }

  .uuid-range {
    flex: 1;
    height: 6px;
    appearance: none;
    cursor: pointer;
    background: var(--color-bg-secondary);
    border-radius: 3px;
  }

  .uuid-range::-webkit-slider-thumb {
    width: 18px;
    height: 18px;
    appearance: none;
    cursor: pointer;
    background: var(--color-primary);
    border-radius: 50%;
  }

  .uuid-range::-moz-range-thumb {
    width: 18px;
    height: 18px;
    cursor: pointer;
    background: var(--color-primary);
    border: none;
    border-radius: 50%;
  }

  .uuid-count-value {
    min-width: 2rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
    text-align: center;
  }

  /* Actions */
  .uuid-actions {
    display: flex;
    gap: 0.5rem;
  }

  .uuid-generate-btn,
  .uuid-copy-all-btn {
    display: flex;
    gap: 0.375rem;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: var(--fw-medium);
    cursor: pointer;
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: all 0.15s;
  }

  .uuid-generate-btn {
    color: #fff;
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .uuid-generate-btn:hover {
    opacity: 90%;
  }

  .uuid-generate-btn span,
  .uuid-copy-all-btn span {
    width: 16px;
    height: 16px;
  }

  .uuid-copy-all-btn {
    color: var(--color-text-muted);
    background: var(--color-bg-secondary);
  }

  .uuid-copy-all-btn:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* Output */
  .uuid-output {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-height: 400px;
    overflow-y: auto;
  }

  .uuid-output :global(.uuid-row) {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-sm);
  }

  .uuid-output :global(.uuid-value) {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text);
    word-break: break-all;
  }

  .uuid-output :global(.uuid-copy-btn) {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--color-text-muted);
    cursor: pointer;
    background: transparent;
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: all 0.15s;
  }

  .uuid-output :global(.uuid-copy-btn) span {
    width: 14px;
    height: 14px;
  }

  .uuid-output :global(.uuid-copy-btn:hover) {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .uuid-output :global(.uuid-copy-btn.copied) {
    color: #047857;
    border-color: #10b981;
  }

  /* Info */
  .uuid-info {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.625rem 0.75rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
  }

  .uuid-info[hidden] {
    display: none;
  }

  .uuid-info span[class^="i-"] {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    color: var(--color-primary);
  }

  @media (width <= 640px) {
    .uuid-layout {
      padding: 1rem;
    }

    .uuid-formats {
      grid-template-columns: 1fr 1fr;
    }

    .uuid-actions {
      flex-direction: column;
    }
  }
</style>
