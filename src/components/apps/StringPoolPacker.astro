---
/**
 * StringPoolPacker Component
 * Visualizes the flash cost of a pointer table vs a packed, tail-merged string
 * pool with uint16 offsets — the technique from the i18n string-pool blog post.
 *
 * Two input modes:
 *  - "Lines": one string per line (each line = one index entry).
 *  - "CSV":   id + one column per language (the real firmware layout), with an
 *             identifier × language lookup that simulates tr() / gen::string().
 * The breakdown shows each string's byte offset, making it concrete that a
 * tail-merged string is read by pool + offset just like any other.
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

interface Props {
  title?: string;
}

const { title } = Astro.props;

const linesExample = [
  "OK",
  "OK",
  "Cancel",
  "Cancelar",
  "ancel",
  "Settings",
  "in Bluetooth Settings",
  "Kleidos",
  "Kleidos",
].join("\n");

const csvExample = [
  "id,en,es,fr,de,it",
  "BRAND,Kleidos,Kleidos,Kleidos,Kleidos,Kleidos",
  "CommonOk,OK,OK,OK,OK,OK",
  "CommonBt,BT,BT,BT,BT,BT",
  "CommonUsb,USB,USB,USB,USB,USB",
  "CommonTotp,TOTP,TOTP,TOTP,TOTP,TOTP",
  "CommonPin,PIN,PIN,PIN,PIN,PIN",
  "CommonId,ID,ID,ID,ID,ID",
  "CommonIp,IP,IP,IP,IP,IP",
  "CommonMac,MAC,MAC,MAC,MAC,MAC",
  "CommonBle,BLE,BLE,BLE,BLE,BLE",
  "CommonWifi,Wi-Fi,Wi-Fi,Wi-Fi,Wi-Fi,Wi-Fi",
  "CommonOn,On,On,On,On,On",
  "CommonOff,Off,Off,Off,Off,Off",
  "CommonCancel,Cancel,Cancelar,Annuler,Abbrechen,Annulla",
  "SetTitle,Settings,Ajustes,Réglages,Einstellungen,Impostazioni",
  "SetBt,Bluetooth Settings,Ajustes Bluetooth,Réglages Bluetooth,Bluetooth-Einstellungen,Impostazioni Bluetooth",
].join("\n");

const uniqueId = `spp-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

/** Strings the inline script needs at runtime. */
const i18n = {
  emptyState: t("tools.stringPoolPacker.emptyState"),
  statusStored: t("tools.stringPoolPacker.statusStored"),
  statusTail: t("tools.stringPoolPacker.statusTail"),
  savedFmt: t("tools.stringPoolPacker.savedFmt"),
  noSaving: t("tools.stringPoolPacker.noSaving"),
  guardOk: t("tools.stringPoolPacker.guardOk"),
  guardExceeded: t("tools.stringPoolPacker.guardExceeded"),
  occurrences: t("tools.stringPoolPacker.occurrences"),
  truncated: t("tools.stringPoolPacker.truncated"),
  csvError: t("tools.stringPoolPacker.csvError"),
  lookupResolved: t("tools.stringPoolPacker.lookupResolved"),
  lookupTail: t("tools.stringPoolPacker.lookupTail"),
};
---

<div
  class="spp"
  data-spp-id={uniqueId}
>
  {title && <div class="spp-title">{title}</div>}

  {/* Mode toggle */}
  <fieldset class="spp-modes">
    <legend class="spp-label">
      <span
        class="i-mdi:toggle-switch-outline spp-label-icon"
        aria-hidden="true"
      ></span>
      {t("tools.stringPoolPacker.modeLabel")}
    </legend>
    <div class="spp-mode-tabs">
      <label class="spp-mode-tab">
        <input
          type="radio"
          name={`${uniqueId}-mode`}
          value="lines"
          checked
        />
        <span>{t("tools.stringPoolPacker.modeLines")}</span>
      </label>
      <label class="spp-mode-tab">
        <input
          type="radio"
          name={`${uniqueId}-mode`}
          value="csv"
        />
        <span>{t("tools.stringPoolPacker.modeCsv")}</span>
      </label>
    </div>
  </fieldset>

  <div class="spp-controls">
    {/* Lines panel */}
    <div
      class="spp-panel"
      data-panel="lines"
    >
      <label
        class="spp-label"
        for={`${uniqueId}-lines`}
      >
        <span
          class="i-mdi:format-list-bulleted spp-label-icon"
          aria-hidden="true"
        ></span>
        {t("tools.stringPoolPacker.inputLabel")}
      </label>
      <textarea
        id={`${uniqueId}-lines`}
        data-spp-lines
        class="spp-textarea"
        rows="9"
        spellcheck="false"
        autocomplete="off"
        placeholder={t("tools.stringPoolPacker.inputPlaceholder")}
        >{linesExample}</textarea
      >
      <p class="spp-hint">{t("tools.stringPoolPacker.inputHint")}</p>
    </div>

    {/* CSV panel */}
    <div
      class="spp-panel"
      data-panel="csv"
      hidden
    >
      <label
        class="spp-label"
        for={`${uniqueId}-csv`}
      >
        <span
          class="i-mdi:table spp-label-icon"
          aria-hidden="true"
        ></span>
        {t("tools.stringPoolPacker.csvInputLabel")}
      </label>
      <textarea
        id={`${uniqueId}-csv`}
        data-spp-csv
        class="spp-textarea"
        rows="9"
        spellcheck="false"
        autocomplete="off"
        >{csvExample}</textarea
      >
      <p class="spp-hint">{t("tools.stringPoolPacker.csvHint")}</p>
    </div>

    {/* Shared side controls */}
    <fieldset class="spp-fieldset">
      <legend class="spp-label">
        <span
          class="i-mdi:memory spp-label-icon"
          aria-hidden="true"
        ></span>
        {t("tools.stringPoolPacker.pointerWidthLabel")}
      </legend>
      <div class="spp-radios">
        <label class="spp-radio">
          <input
            type="radio"
            name={`${uniqueId}-pw`}
            value="4"
            checked
          />
          <span>{t("tools.stringPoolPacker.bits32")}</span>
        </label>
        <label class="spp-radio">
          <input
            type="radio"
            name={`${uniqueId}-pw`}
            value="8"
          />
          <span>{t("tools.stringPoolPacker.bits64")}</span>
        </label>
      </div>
      <button
        type="button"
        class="spp-example-btn"
        data-action="example"
      >
        <span
          class="i-mdi:lightbulb-on-outline"
          aria-hidden="true"
        ></span>
        {t("tools.stringPoolPacker.loadExample")}
      </button>
    </fieldset>
  </div>

  {/* Identifier lookup (CSV mode only) */}
  <div
    class="spp-lookup"
    data-lookup
    hidden
  >
    <div class="spp-lookup-head">
      <span
        class="i-mdi:magnify spp-label-icon"
        aria-hidden="true"
      ></span>
      {t("tools.stringPoolPacker.lookupTitle")}
    </div>
    <div class="spp-lookup-row">
      <label class="spp-lookup-field">
        <span>{t("tools.stringPoolPacker.lookupIdLabel")}</span>
        <select
          class="spp-select"
          data-lookup-id
        ></select>
      </label>
      <label class="spp-lookup-field">
        <span>{t("tools.stringPoolPacker.lookupLangLabel")}</span>
        <select
          class="spp-select"
          data-lookup-lang
        ></select>
      </label>
    </div>
    <output
      class="spp-lookup-out"
      data-lookup-out
    ></output>
  </div>

  <div
    class="spp-results"
    aria-live="polite"
    data-results
  >
    {/* Stat cards */}
    <div class="spp-stats">
      <div class="spp-stat">
        <span
          class="spp-stat-value"
          data-stat="entries"
          >0</span
        >
        <span class="spp-stat-label"
          >{t("tools.stringPoolPacker.statEntries")}</span
        >
      </div>
      <div class="spp-stat">
        <span
          class="spp-stat-value"
          data-stat="distinct"
          >0</span
        >
        <span class="spp-stat-label"
          >{t("tools.stringPoolPacker.statDistinct")}</span
        >
      </div>
      <div class="spp-stat">
        <span
          class="spp-stat-value"
          data-stat="packed"
          >0</span
        >
        <span class="spp-stat-label"
          >{t("tools.stringPoolPacker.statPacked")}</span
        >
      </div>
      <div class="spp-stat">
        <span
          class="spp-stat-value"
          data-stat="poolBytes"
          >0</span
        >
        <span class="spp-stat-label"
          >{t("tools.stringPoolPacker.statPoolBytes")}</span
        >
      </div>
    </div>

    {/* Comparison */}
    <div class="spp-compare">
      <div class="spp-approach">
        <div class="spp-approach-head">
          {t("tools.stringPoolPacker.pointerApproach")}
        </div>
        <dl class="spp-rows">
          <div class="spp-row">
            <dt>{t("tools.stringPoolPacker.rowIndex")}</dt>
            <dd data-ptr="index">—</dd>
          </div>
          <div class="spp-row">
            <dt>{t("tools.stringPoolPacker.rowBlob")}</dt>
            <dd data-ptr="blob">—</dd>
          </div>
          <div class="spp-row spp-row--total">
            <dt>{t("tools.stringPoolPacker.rowTotal")}</dt>
            <dd data-ptr="total">—</dd>
          </div>
          <div class="spp-row spp-row--reloc">
            <dt>{t("tools.stringPoolPacker.rowReloc")}</dt>
            <dd data-ptr="reloc">—</dd>
          </div>
        </dl>
        <div
          class="spp-bar"
          aria-hidden="true"
        >
          <span
            class="spp-bar-fill spp-bar-fill--ptr"
            data-bar="ptr"
          ></span>
        </div>
      </div>

      <div class="spp-approach">
        <div class="spp-approach-head">
          {t("tools.stringPoolPacker.packedApproach")}
        </div>
        <dl class="spp-rows">
          <div class="spp-row">
            <dt>{t("tools.stringPoolPacker.rowIndex")}</dt>
            <dd data-pk="index">—</dd>
          </div>
          <div class="spp-row">
            <dt>{t("tools.stringPoolPacker.rowBlob")}</dt>
            <dd data-pk="blob">—</dd>
          </div>
          <div class="spp-row spp-row--total">
            <dt>{t("tools.stringPoolPacker.rowTotal")}</dt>
            <dd data-pk="total">—</dd>
          </div>
          <div class="spp-row spp-row--reloc">
            <dt>{t("tools.stringPoolPacker.rowReloc")}</dt>
            <dd data-pk="reloc">—</dd>
          </div>
        </dl>
        <div
          class="spp-bar"
          aria-hidden="true"
        >
          <span
            class="spp-bar-fill spp-bar-fill--pk"
            data-bar="pk"
          ></span>
        </div>
      </div>
    </div>

    <div
      class="spp-saving"
      data-saving
    >
    </div>
    <div
      class="spp-guard"
      data-guard
    >
    </div>

    <p class="spp-retrieval">
      <span
        class="i-mdi:cursor-default-click-outline"
        aria-hidden="true"
      ></span>
      {t("tools.stringPoolPacker.retrievalNote")}
    </p>

    {/* Breakdown */}
    <div class="spp-breakdown">
      <div class="spp-breakdown-head">
        {t("tools.stringPoolPacker.breakdownTitle")}
      </div>
      <div class="spp-table-wrap">
        <table class="spp-table">
          <thead>
            <tr>
              <th scope="col">{t("tools.stringPoolPacker.colString")}</th>
              <th scope="col">{t("tools.stringPoolPacker.colOcc")}</th>
              <th scope="col">{t("tools.stringPoolPacker.colOffset")}</th>
              <th scope="col">{t("tools.stringPoolPacker.colBytes")}</th>
              <th scope="col">{t("tools.stringPoolPacker.colStatus")}</th>
            </tr>
          </thead>
          <tbody data-tbody></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="spp-privacy">
    <span
      class="i-mdi:shield-lock-outline"
      aria-hidden="true"
    ></span>
    {t("tools.stringPoolPacker.privacyNote")}
  </p>
</div>

<script is:inline define:vars={{ uniqueId, i18n, locale }}>
  // cspell:ignore atrás retour zurück indietro siguiente suivant weiter avanti
  // cspell:ignore bloquear verrouiller sperren blocca bóveda borrada coffre
  // cspell:ignore effacé cancellato idioma langue sprache lingua annuler
  // cspell:ignore abbrechen annulla cancelar tresor gelöscht verlust kleidos ancel
  // cspell:ignore ajustes réglages einstellungen impostazioni
  const root = document.querySelector(`[data-spp-id="${uniqueId}"]`);
  if (root) {
    const linesInput = root.querySelector("[data-spp-lines]");
    const csvInput = root.querySelector("[data-spp-csv]");
    const tbody = root.querySelector("[data-tbody]");
    const savingEl = root.querySelector("[data-saving]");
    const guardEl = root.querySelector("[data-guard]");
    const lookupBox = root.querySelector("[data-lookup]");
    const lookupId = root.querySelector("[data-lookup-id]");
    const lookupLang = root.querySelector("[data-lookup-lang]");
    const lookupOut = root.querySelector("[data-lookup-out]");
    const enc = new TextEncoder();
    const MAX_ROWS = 250;

    const fmt = (n) => Number(n).toLocaleString(locale);
    const byteLen = (s) => enc.encode(s).length;
    const setText = (sel, value) => {
      const el = root.querySelector(sel);
      if (el) el.textContent = value;
    };

    function getMode() {
      const m = root.querySelector(`input[name="${uniqueId}-mode"]:checked`);
      return m ? m.value : "lines";
    }
    function getPointerWidth() {
      const c = root.querySelector(`input[name="${uniqueId}-pw"]:checked`);
      return c ? parseInt(c.value, 10) : 4;
    }

    /**
     * Pack a set of DISTINCT strings into a tail-merged blob and record the
     * byte offset of every string (including tail-merged ones, whose offset
     * points partway into a longer entry).
     */
    function packPool(distinct) {
      const sorted = [...distinct].sort(
        (a, b) => byteLen(b) - byteLen(a) || (a < b ? -1 : a > b ? 1 : 0),
      );
      let blobBytes = 0;
      const poolEntries = [];
      const offsetOf = new Map();
      const status = new Map(); // s -> { tail, into }
      for (const s of sorted) {
        let into = "";
        for (const p of poolEntries) {
          if (p !== s && p.endsWith(s)) {
            into = p;
            break;
          }
        }
        if (into) {
          offsetOf.set(s, offsetOf.get(into) + (byteLen(into) - byteLen(s)));
          status.set(s, { tail: true, into });
        } else {
          offsetOf.set(s, blobBytes);
          blobBytes += byteLen(s) + 1; // + NUL
          poolEntries.push(s);
          status.set(s, { tail: false, into: "" });
        }
      }
      return { offsetOf, blobBytes, poolEntries, status };
    }

    /** Minimal CSV parser: header row + data rows, simple quoted fields. */
    function parseCsv(text) {
      const lines = text.split("\n").map((l) => l.replace(/\r$/, ""));
      const rows = [];
      for (const line of lines) {
        if (!line.trim()) continue;
        const fields = [];
        let cur = "";
        let inQ = false;
        for (let i = 0; i < line.length; i++) {
          const ch = line[i];
          if (inQ) {
            if (ch === '"' && line[i + 1] === '"') {
              cur += '"';
              i++;
            } else if (ch === '"') {
              inQ = false;
            } else {
              cur += ch;
            }
          } else if (ch === '"') {
            inQ = true;
          } else if (ch === ",") {
            fields.push(cur);
            cur = "";
          } else {
            cur += ch;
          }
        }
        fields.push(cur);
        rows.push(fields.map((f) => f.trim()));
      }
      if (rows.length < 2) return null;
      const header = rows[0].map((h) => h.toLowerCase());
      if (header[0] !== "id") return null;
      const langs = header.slice(1).filter((h) => h.length > 0);
      if (langs.length === 0) return null;
      const enIdx = 0; // first language column is the fallback
      const data = [];
      for (let r = 1; r < rows.length; r++) {
        const cols = rows[r];
        if (!cols[0]) continue;
        const values = langs.map((_, c) => cols[c + 1] || "");
        // Empty cell falls back to the first language column (mirrors firmware).
        const filled = values.map((v) => (v ? v : values[enIdx] || ""));
        data.push({ id: cols[0], values: filled });
      }
      return { langs, rows: data };
    }

    function renderShared(cells, packed, pw) {
      const N = cells.length;
      const counts = new Map();
      for (const c of cells) counts.set(c, (counts.get(c) || 0) + 1);
      const distinct = [...counts.keys()];

      const blobDedupBytes = distinct.reduce((a, s) => a + byteLen(s) + 1, 0);
      const blobTailBytes = packed.blobBytes;
      const offsetWidth =
        blobTailBytes < 0x10000 ? 2 : blobTailBytes < 0x100000000 ? 4 : 8;
      const ptrIndex = N * pw;
      const pkIndex = N * offsetWidth;
      const ptrTotal = ptrIndex + blobDedupBytes;
      const pkTotal = pkIndex + blobTailBytes;
      const saved = ptrTotal - pkTotal;
      const pct = ptrTotal > 0 ? Math.round((saved / ptrTotal) * 1000) / 10 : 0;
      const idxSave =
        ptrIndex > 0 ? Math.round((1 - pkIndex / ptrIndex) * 100) : 0;

      setText('[data-stat="entries"]', fmt(N));
      setText('[data-stat="distinct"]', fmt(distinct.length));
      setText('[data-stat="packed"]', fmt(packed.poolEntries.length));
      setText('[data-stat="poolBytes"]', fmt(blobTailBytes));

      const B = (n) => fmt(n) + " B";
      setText('[data-ptr="index"]', `${B(ptrIndex)} (${N}×${pw})`);
      setText('[data-ptr="blob"]', B(blobDedupBytes));
      setText('[data-ptr="total"]', B(ptrTotal));
      setText('[data-pk="index"]', `${B(pkIndex)} (${N}×${offsetWidth})`);
      setText('[data-pk="blob"]', B(blobTailBytes));
      setText('[data-pk="total"]', B(pkTotal));
      // One relocation per pointer cell; offsets are position-independent integers.
      setText('[data-ptr="reloc"]', fmt(N));
      setText('[data-pk="reloc"]', "0");

      const maxTotal = Math.max(ptrTotal, pkTotal, 1);
      const ptrBar = root.querySelector('[data-bar="ptr"]');
      const pkBar = root.querySelector('[data-bar="pk"]');
      if (ptrBar)
        ptrBar.style.setProperty(
          "--spp-bar-w",
          (ptrTotal / maxTotal) * 100 + "%",
        );
      if (pkBar)
        pkBar.style.setProperty(
          "--spp-bar-w",
          (pkTotal / maxTotal) * 100 + "%",
        );

      if (savingEl) {
        if (saved > 0) {
          savingEl.textContent = i18n.savedFmt
            .replace("{idx}", String(idxSave))
            .replace("{n}", fmt(saved))
            .replace("{pct}", String(pct));
          savingEl.dataset.state = "good";
        } else {
          savingEl.textContent = i18n.noSaving;
          savingEl.dataset.state = "neutral";
        }
      }
      if (guardEl) {
        if (offsetWidth === 2) {
          guardEl.textContent = i18n.guardOk;
          guardEl.dataset.state = "good";
        } else {
          guardEl.textContent = i18n.guardExceeded.replace(
            "{w}",
            String(offsetWidth),
          );
          guardEl.dataset.state = "warn";
        }
      }

      renderBreakdown(distinct, counts, packed);
    }

    function renderBreakdown(distinct, counts, packed) {
      if (!tbody) return;
      tbody.textContent = "";
      const ordered = [...distinct].sort((a, b) => {
        const ta = packed.status.get(a).tail,
          tb = packed.status.get(b).tail;
        if (ta !== tb) return ta ? 1 : -1;
        return counts.get(b) - counts.get(a);
      });
      const rows = ordered.slice(0, MAX_ROWS);
      const frag = document.createDocumentFragment();
      for (const s of rows) {
        const st = packed.status.get(s);
        const tr = document.createElement("tr");

        const tdStr = document.createElement("td");
        const code = document.createElement("code");
        code.textContent = s === "" ? "∅" : s;
        tdStr.appendChild(code);

        const tdOcc = document.createElement("td");
        tdOcc.textContent = i18n.occurrences.replace("{n}", fmt(counts.get(s)));

        const tdOff = document.createElement("td");
        tdOff.className = "spp-num";
        tdOff.textContent = "@" + fmt(packed.offsetOf.get(s));

        const tdBytes = document.createElement("td");
        tdBytes.className = "spp-num";
        tdBytes.textContent = st.tail ? "0" : fmt(byteLen(s) + 1);

        const tdStatus = document.createElement("td");
        const badge = document.createElement("span");
        if (st.tail) {
          badge.className = "spp-badge spp-badge--tail";
          badge.textContent = st.into
            ? i18n.statusTail.replace("{s}", st.into)
            : i18n.statusTail.replace('"{s}"', "").trim();
        } else {
          badge.className = "spp-badge spp-badge--stored";
          badge.textContent = i18n.statusStored;
        }
        tdStatus.appendChild(badge);

        tr.append(tdStr, tdOcc, tdOff, tdBytes, tdStatus);
        frag.appendChild(tr);
      }
      if (ordered.length > MAX_ROWS) {
        const tr = document.createElement("tr");
        const td = document.createElement("td");
        td.colSpan = 5;
        td.className = "spp-truncated";
        td.textContent = i18n.truncated
          .replace("{n}", fmt(MAX_ROWS))
          .replace("{total}", fmt(ordered.length));
        tr.appendChild(td);
        frag.appendChild(tr);
      }
      if (rows.length === 0) {
        const tr = document.createElement("tr");
        const td = document.createElement("td");
        td.colSpan = 5;
        td.className = "spp-truncated";
        td.textContent = i18n.emptyState;
        tr.appendChild(td);
        frag.appendChild(tr);
      }
      tbody.appendChild(frag);
    }

    // State for the lookup (populated in CSV mode).
    let csvState = null;

    function analyzeLines() {
      const cells = linesInput.value
        .split("\n")
        .map((l) => l.replace(/\r$/, ""))
        .filter((l) => l.length > 0);
      const distinct = [...new Set(cells)];
      const packed = packPool(distinct);
      renderShared(cells, packed, getPointerWidth());
    }

    function analyzeCsv() {
      const parsed = parseCsv(csvInput.value);
      if (!parsed) {
        if (savingEl) {
          savingEl.textContent = i18n.csvError;
          savingEl.dataset.state = "warn";
        }
        if (tbody) tbody.textContent = "";
        // Clear stale comparison numbers so a failed parse can't leave them up.
        for (const el of root.querySelectorAll("[data-ptr],[data-pk]"))
          el.textContent = "—";
        for (const el of root.querySelectorAll("[data-stat]"))
          el.textContent = "0";
        csvState = null;
        populateLookup();
        return;
      }
      const cells = [];
      for (const row of parsed.rows) {
        for (const v of row.values) cells.push(v);
      }
      const distinct = [...new Set(cells)];
      const packed = packPool(distinct);
      renderShared(cells, packed, getPointerWidth());
      csvState = { ...parsed, packed };
      populateLookup();
    }

    function populateLookup() {
      if (!lookupId || !lookupLang) return;
      if (!csvState) {
        lookupId.textContent = "";
        lookupLang.textContent = "";
        if (lookupOut) lookupOut.textContent = "";
        return;
      }
      const prevId = lookupId.value;
      const prevLang = lookupLang.value;
      lookupId.textContent = "";
      lookupLang.textContent = "";
      csvState.rows.forEach((r, i) => {
        const o = document.createElement("option");
        o.value = String(i);
        o.textContent = r.id;
        lookupId.appendChild(o);
      });
      csvState.langs.forEach((lang, i) => {
        const o = document.createElement("option");
        o.value = String(i);
        o.textContent = lang.toUpperCase();
        lookupLang.appendChild(o);
      });
      if (prevId && Number(prevId) < csvState.rows.length)
        lookupId.value = prevId;
      if (prevLang && Number(prevLang) < csvState.langs.length)
        lookupLang.value = prevLang;
      renderLookup();
    }

    function renderLookup() {
      if (!lookupOut || !csvState) return;
      const ri = parseInt(lookupId.value, 10) || 0;
      const li = parseInt(lookupLang.value, 10) || 0;
      const row = csvState.rows[ri];
      if (!row) {
        lookupOut.textContent = "";
        return;
      }
      const value = row.values[li];
      const off = csvState.packed.offsetOf.get(value);
      const st = csvState.packed.status.get(value);
      lookupOut.textContent = "";
      const code = document.createElement("code");
      code.textContent = i18n.lookupResolved
        .replace("{lang}", String(li))
        .replace("{id}", String(ri))
        .replace("{off}", fmt(off))
        .replace("{val}", value === "" ? "∅" : value);
      lookupOut.appendChild(code);
      if (st && st.tail && st.into) {
        const note = document.createElement("span");
        note.className = "spp-lookup-note";
        note.textContent = i18n.lookupTail.replace("{s}", st.into);
        lookupOut.appendChild(note);
      }
    }

    function setMode(mode) {
      const linesPanel = root.querySelector('[data-panel="lines"]');
      const csvPanel = root.querySelector('[data-panel="csv"]');
      if (linesPanel) linesPanel.hidden = mode !== "lines";
      if (csvPanel) csvPanel.hidden = mode !== "csv";
      if (lookupBox) lookupBox.hidden = mode !== "csv";
      if (mode === "csv") analyzeCsv();
      else analyzeLines();
    }

    function recompute() {
      if (getMode() === "csv") analyzeCsv();
      else analyzeLines();
    }

    function debounce(fn, delay) {
      let timer;
      return function (...args) {
        clearTimeout(timer);
        timer = setTimeout(() => fn.apply(this, args), delay);
      };
    }

    linesInput.addEventListener("input", debounce(analyzeLines, 150));
    csvInput.addEventListener("input", debounce(analyzeCsv, 150));
    root
      .querySelectorAll(`input[name="${uniqueId}-pw"]`)
      .forEach((r) => r.addEventListener("change", recompute));
    root
      .querySelectorAll(`input[name="${uniqueId}-mode"]`)
      .forEach((r) => r.addEventListener("change", () => setMode(getMode())));
    if (lookupId) lookupId.addEventListener("change", renderLookup);
    if (lookupLang) lookupLang.addEventListener("change", renderLookup);

    const exampleBtn = root.querySelector('[data-action="example"]');
    if (exampleBtn) {
      exampleBtn.addEventListener("click", () => {
        if (getMode() === "csv") {
          csvInput.value = [
            "id,en,es,fr,de,it",
            "BRAND,Kleidos,Kleidos,Kleidos,Kleidos,Kleidos",
            "CommonOk,OK,OK,OK,OK,OK",
            "CommonBt,BT,BT,BT,BT,BT",
            "CommonUsb,USB,USB,USB,USB,USB",
            "CommonTotp,TOTP,TOTP,TOTP,TOTP,TOTP",
            "CommonPin,PIN,PIN,PIN,PIN,PIN",
            "CommonId,ID,ID,ID,ID,ID",
            "CommonIp,IP,IP,IP,IP,IP",
            "CommonMac,MAC,MAC,MAC,MAC,MAC",
            "CommonBle,BLE,BLE,BLE,BLE,BLE",
            "CommonWifi,Wi-Fi,Wi-Fi,Wi-Fi,Wi-Fi,Wi-Fi",
            "CommonOn,On,On,On,On,On",
            "CommonOff,Off,Off,Off,Off,Off",
            "CommonCancel,Cancel,Cancelar,Annuler,Abbrechen,Annulla",
            "SetTitle,Settings,Ajustes,Réglages,Einstellungen,Impostazioni",
            "SetBt,Bluetooth Settings,Ajustes Bluetooth,Réglages Bluetooth,Bluetooth-Einstellungen,Impostazioni Bluetooth",
          ].join("\n");
          analyzeCsv();
        } else {
          linesInput.value = [
            "OK",
            "OK",
            "Cancel",
            "Cancelar",
            "ancel",
            "Settings",
            "in Bluetooth Settings",
            "Kleidos",
            "Kleidos",
          ].join("\n");
          analyzeLines();
        }
      });
    }

    setMode("lines");
  }
</script>

