    color: #fcd34d;
  }

  :root[data-theme="dark"] .hdr-fetch-error {
    color: #fca5a5;
  }

  .hdr-separator {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
