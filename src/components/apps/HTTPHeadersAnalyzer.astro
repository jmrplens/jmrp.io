  }

  .hdr-separator::before,
  .hdr-separator::after {
    flex: 1;
    height: 1px;
    content: "";
    background: var(--color-border);
  }

  /* Input */
  .hdr-input-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hdr-label {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.85rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .hdr-label span[class^="i-"] {
    width: 18px;
    height: 18px;
  }

  .hdr-textarea {
    width: 100%;
    min-height: 150px;
    padding: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-text);
    resize: vertical;
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s;
  }

  .hdr-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .hdr-analyze-btn {
    display: flex;
    gap: 0.375rem;
    align-items: center;
    align-self: flex-start;
    padding: 0.625rem 1.25rem;
    font-size: 0.9rem;
    font-weight: var(--fw-medium);
    color: #fff;
    cursor: pointer;
    background: var(--color-primary);
    border: none;
    border-radius: var(--radius-sm);
    transition: opacity 0.15s;
  }

  .hdr-analyze-btn span {
    width: 18px;
    height: 18px;
  }

  .hdr-analyze-btn:hover {
    opacity: 90%;
  }

  /* Score - SVG Ring */
  .hdr-score-section {
    display: flex;
    justify-content: center;
  }

  .hdr-score-section[hidden] {
    display: none;
  }

  .hdr-score-display {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    padding: 1.5rem 2rem;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .hdr-score-ring {
    position: relative;
    width: 120px;
    height: 120px;
  }

  .hdr-ring-svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .hdr-ring-bg {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 8;
  }

  .hdr-ring-fill {
    fill: none;
    stroke: currentcolor;
    stroke-width: 8;
    stroke-linecap: round;
    transition:
      stroke-dashoffset 0.6s ease,
      color 0.3s ease;
  }

  .hdr-ring-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .hdr-score-value {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-text-heading);
  }

  .hdr-score-max {
    margin-top: 0.125rem;
    font-size: 0.8rem;
