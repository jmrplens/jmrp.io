    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s;
  }

  .hdr-url-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .hdr-fetch-btn {
    display: flex;
    flex-shrink: 0;
