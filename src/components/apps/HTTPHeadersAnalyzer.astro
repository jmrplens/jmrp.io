---
/**
 * HTTPHeadersAnalyzer Component
 * Analyzes HTTP security headers and provides recommendations.
 * Supports pasting headers or fetching from a URL.
 *
 * Usage:
 * <HTTPHeadersAnalyzer title="HTTP Security Headers Analyzer" />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

interface Props {
  title?: string;
}

const { title = t("tools.httpHeadersAnalyzer.title") } = Astro.props;
const uniqueId = `hdr-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

/** Translations passed to the inline script via define:vars. */
const i18n = {
  // Fetch status
  fetching: t("tools.httpHeadersAnalyzer.fetching"),
  fetchingHeaders: t("tools.httpHeadersAnalyzer.fetchingHeaders"),
  noHeadersReturned: t("tools.httpHeadersAnalyzer.noHeadersReturned"),
  fetchedHeaders: t("tools.httpHeadersAnalyzer.fetchedHeaders"),
  failedToFetch: t("tools.httpHeadersAnalyzer.failedToFetch"),
  failedToFetchDefault: t("tools.httpHeadersAnalyzer.failedToFetchDefault"),
  fetch: t("tools.httpHeadersAnalyzer.fetch"),
  // Section titles
  cookieSecurity: t("tools.httpHeadersAnalyzer.cookieSecurity"),
  informationLeakage: t("tools.httpHeadersAnalyzer.informationLeakage"),
  crossHeaderConsistency: t("tools.httpHeadersAnalyzer.crossHeaderConsistency"),
  inconsistencyDetected: t("tools.httpHeadersAnalyzer.inconsistencyDetected"),
  // Summary
  summaryPresent: t("tools.httpHeadersAnalyzer.present"),
  summaryMissing: t("tools.httpHeadersAnalyzer.summaryMissing"),
  summaryCookieAnalyzed: t("tools.httpHeadersAnalyzer.cookieAnalyzed"),
  summaryCookiesAnalyzed: t("tools.httpHeadersAnalyzer.cookiesAnalyzed"),
  summaryInfoLeaks: t("tools.httpHeadersAnalyzer.infoLeaksDetected"),
  summaryInconsistency: t("tools.httpHeadersAnalyzer.inconsistencyCount"),
  summaryInconsistencies: t("tools.httpHeadersAnalyzer.inconsistenciesCount"),
  // Result labels
  recommended: t("tools.httpHeadersAnalyzer.recommended"),
  learnMore: t("tools.httpHeadersAnalyzer.learnMore"),
  cspBuilderTool: t("tools.httpHeadersAnalyzer.cspBuilderTool"),
  // Severity labels
  severityCritical: t("tools.httpHeadersAnalyzer.severityCritical"),
  severityHigh: t("tools.httpHeadersAnalyzer.severityHigh"),
  severityMedium: t("tools.httpHeadersAnalyzer.severityMedium"),
  severityLow: t("tools.httpHeadersAnalyzer.severityLow"),
  severityInfo: t("tools.httpHeadersAnalyzer.severityInfo"),
  severityCookie: t("tools.httpHeadersAnalyzer.severityCookie"),
  // CSP
  cspDesc: t("tools.httpHeadersAnalyzer.cspDesc"),
  cspMissing: t("tools.httpHeadersAnalyzer.cspMissing"),
  cspDefaultSrcNone: t("tools.httpHeadersAnalyzer.cspDefaultSrcNone"),
  cspDefaultSrcSelf: t("tools.httpHeadersAnalyzer.cspDefaultSrcSelf"),
  cspMissingDefaultSrc: t("tools.httpHeadersAnalyzer.cspMissingDefaultSrc"),
  cspUnsafeInline: t("tools.httpHeadersAnalyzer.cspUnsafeInline"),
  cspUnsafeEval: t("tools.httpHeadersAnalyzer.cspUnsafeEval"),
  cspDangerousSource: t("tools.httpHeadersAnalyzer.cspDangerousSource"),
  cspTrustsAllHttps: t("tools.httpHeadersAnalyzer.cspTrustsAllHttps"),
  cspCdnBypass: t("tools.httpHeadersAnalyzer.cspCdnBypass"),
  cspUsesNonces: t("tools.httpHeadersAnalyzer.cspUsesNonces"),
  cspMissingNonces: t("tools.httpHeadersAnalyzer.cspMissingNonces"),
  cspStrictDynamic: t("tools.httpHeadersAnalyzer.cspStrictDynamic"),
  cspMissingStrictDynamic: t(
    "tools.httpHeadersAnalyzer.cspMissingStrictDynamic",
  ),
  cspObjectSrcNone: t("tools.httpHeadersAnalyzer.cspObjectSrcNone"),
  cspMissingObjectSrc: t("tools.httpHeadersAnalyzer.cspMissingObjectSrc"),
  cspBaseUriRestricted: t("tools.httpHeadersAnalyzer.cspBaseUriRestricted"),
  cspMissingBaseUri: t("tools.httpHeadersAnalyzer.cspMissingBaseUri"),
  cspFormActionDefined: t("tools.httpHeadersAnalyzer.cspFormActionDefined"),
  cspMissingFormAction: t("tools.httpHeadersAnalyzer.cspMissingFormAction"),
  cspFrameAncestorsDefined: t(
    "tools.httpHeadersAnalyzer.cspFrameAncestorsDefined",
  ),
  cspMissingFrameAncestors: t(
    "tools.httpHeadersAnalyzer.cspMissingFrameAncestors",
  ),
  cspUpgradeInsecure: t("tools.httpHeadersAnalyzer.cspUpgradeInsecure"),
  cspMissingUpgradeInsecure: t(
    "tools.httpHeadersAnalyzer.cspMissingUpgradeInsecure",
  ),
  cspReportingConfigured: t("tools.httpHeadersAnalyzer.cspReportingConfigured"),
  cspNoReporting: t("tools.httpHeadersAnalyzer.cspNoReporting"),
  cspTrustedTypes: t("tools.httpHeadersAnalyzer.cspTrustedTypes"),
  // HSTS
  hstsDesc: t("tools.httpHeadersAnalyzer.hstsDesc"),
  hstsMissing: t("tools.httpHeadersAnalyzer.hstsMissing"),
  hstsMaxAgeZero: t("tools.httpHeadersAnalyzer.hstsMaxAgeZero"),
  hstsMaxAge2Years: t("tools.httpHeadersAnalyzer.hstsMaxAge2Years"),
  hstsMaxAge1Year: t("tools.httpHeadersAnalyzer.hstsMaxAge1Year"),
  hstsMaxAgeLow: t("tools.httpHeadersAnalyzer.hstsMaxAgeLow"),
  hstsIncludeSubDomains: t("tools.httpHeadersAnalyzer.hstsIncludeSubDomains"),
  hstsMissingIncludeSubDomains: t(
    "tools.httpHeadersAnalyzer.hstsMissingIncludeSubDomains",
  ),
  hstsPreload: t("tools.httpHeadersAnalyzer.hstsPreload"),
  hstsMissingPreload: t("tools.httpHeadersAnalyzer.hstsMissingPreload"),
  // X-Content-Type-Options
  xctDesc: t("tools.httpHeadersAnalyzer.xctDesc"),
  xctMissing: t("tools.httpHeadersAnalyzer.xctMissing"),
  xctCorrect: t("tools.httpHeadersAnalyzer.xctCorrect"),
  xctWrong: t("tools.httpHeadersAnalyzer.xctWrong"),
  // X-Frame-Options
  xfoDesc: t("tools.httpHeadersAnalyzer.xfoDesc"),
  xfoMissing: t("tools.httpHeadersAnalyzer.xfoMissing"),
  xfoDeny: t("tools.httpHeadersAnalyzer.xfoDeny"),
  xfoSameorigin: t("tools.httpHeadersAnalyzer.xfoSameorigin"),
  xfoUnexpected: t("tools.httpHeadersAnalyzer.xfoUnexpected"),
  // Referrer-Policy
  rpDesc: t("tools.httpHeadersAnalyzer.rpDesc"),
  rpMissing: t("tools.httpHeadersAnalyzer.rpMissing"),
  rpSecure: t("tools.httpHeadersAnalyzer.rpSecure"),
  rpAcceptable: t("tools.httpHeadersAnalyzer.rpAcceptable"),
  rpUnsafeUrl: t("tools.httpHeadersAnalyzer.rpUnsafeUrl"),
  rpConsider: t("tools.httpHeadersAnalyzer.rpConsider"),
  // Permissions-Policy
  ppDesc: t("tools.httpHeadersAnalyzer.ppDesc"),
  ppMissing: t("tools.httpHeadersAnalyzer.ppMissing"),
  ppDisabled: t("tools.httpHeadersAnalyzer.ppDisabled"),
  ppMissingRestriction: t("tools.httpHeadersAnalyzer.ppMissingRestriction"),
  // X-XSS-Protection
  xxpDesc: t("tools.httpHeadersAnalyzer.xxpDesc"),
  xxpAbsentCorrect: t("tools.httpHeadersAnalyzer.xxpAbsentCorrect"),
  xxpDisabledCorrect: t("tools.httpHeadersAnalyzer.xxpDisabledCorrect"),
  xxpShouldBeZero: t("tools.httpHeadersAnalyzer.xxpShouldBeZero"),
  xxpMissingNoCsp: t("tools.httpHeadersAnalyzer.xxpMissingNoCsp"),
  xxpDisabledNoCsp: t("tools.httpHeadersAnalyzer.xxpDisabledNoCsp"),
  xxpLegacyEnabled: t("tools.httpHeadersAnalyzer.xxpLegacyEnabled"),
  xxpConsiderCsp: t("tools.httpHeadersAnalyzer.xxpConsiderCsp"),
  // COOP
  coopDesc: t("tools.httpHeadersAnalyzer.coopDesc"),
  coopMissing: t("tools.httpHeadersAnalyzer.coopMissing"),
  coopSameOrigin: t("tools.httpHeadersAnalyzer.coopSameOrigin"),
  coopPartialIsolation: t("tools.httpHeadersAnalyzer.coopPartialIsolation"),
  coopConsiderSameOrigin: t("tools.httpHeadersAnalyzer.coopConsiderSameOrigin"),
  coopUnexpected: t("tools.httpHeadersAnalyzer.coopUnexpected"),
  // CORP
  corpDesc: t("tools.httpHeadersAnalyzer.corpDesc"),
  corpMissing: t("tools.httpHeadersAnalyzer.corpMissing"),
  corpSameOrigin: t("tools.httpHeadersAnalyzer.corpSameOrigin"),
  corpSameSite: t("tools.httpHeadersAnalyzer.corpSameSite"),
  corpConsiderSameOrigin2: t(
    "tools.httpHeadersAnalyzer.corpConsiderSameOrigin2",
  ),
  corpCrossOrigin: t("tools.httpHeadersAnalyzer.corpCrossOrigin"),
  corpConsiderSameOrigin5: t(
    "tools.httpHeadersAnalyzer.corpConsiderSameOrigin5",
  ),
  // COEP
  coepDesc: t("tools.httpHeadersAnalyzer.coepDesc"),
  coepMissing: t("tools.httpHeadersAnalyzer.coepMissing"),
  coepRequireCorp: t("tools.httpHeadersAnalyzer.coepRequireCorp"),
  coepCredentialless: t("tools.httpHeadersAnalyzer.coepCredentialless"),
  coepConsiderRequireCorp: t(
    "tools.httpHeadersAnalyzer.coepConsiderRequireCorp",
  ),
  coepUnexpected: t("tools.httpHeadersAnalyzer.coepUnexpected"),
  // Info leak descriptions
  serverDesc: t("tools.httpHeadersAnalyzer.serverDesc"),
  xPoweredByDesc: t("tools.httpHeadersAnalyzer.xPoweredByDesc"),
  xAspnetVersionDesc: t("tools.httpHeadersAnalyzer.xAspnetVersionDesc"),
  xAspnetMvcVersionDesc: t("tools.httpHeadersAnalyzer.xAspnetMvcVersionDesc"),
  xGeneratorDesc: t("tools.httpHeadersAnalyzer.xGeneratorDesc"),
  // Info leak checks
  serverNotExposed: t("tools.httpHeadersAnalyzer.serverNotExposed"),
  serverProxyCdn: t("tools.httpHeadersAnalyzer.serverProxyCdn"),
  serverVersionExposed: t("tools.httpHeadersAnalyzer.serverVersionExposed"),
  serverNameExposed: t("tools.httpHeadersAnalyzer.serverNameExposed"),
  xPoweredByExposed: t("tools.httpHeadersAnalyzer.xPoweredByExposed"),
  xAspnetVersionExposed: t("tools.httpHeadersAnalyzer.xAspnetVersionExposed"),
  xAspnetMvcVersionExposed: t(
    "tools.httpHeadersAnalyzer.xAspnetMvcVersionExposed",
  ),
  xGeneratorExposed: t("tools.httpHeadersAnalyzer.xGeneratorExposed"),
  // Cookie security
  cookieMissingSecure: t("tools.httpHeadersAnalyzer.cookieMissingSecure"),
  cookieMissingHttpOnly: t("tools.httpHeadersAnalyzer.cookieMissingHttpOnly"),
  cookieMissingSameSite: t("tools.httpHeadersAnalyzer.cookieMissingSameSite"),
  cookieSameSiteNoneNoSecure: t(
    "tools.httpHeadersAnalyzer.cookieSameSiteNoneNoSecure",
  ),
  cookieHostPrefix: t("tools.httpHeadersAnalyzer.cookieHostPrefix"),
  cookieSecurePrefix: t("tools.httpHeadersAnalyzer.cookieSecurePrefix"),
  cookieAllPresent: t("tools.httpHeadersAnalyzer.cookieAllPresent"),
  // Consistency
  consistencyXfoNoCspFrameAncestors: t(
    "tools.httpHeadersAnalyzer.consistencyXfoNoCspFrameAncestors",
  ),
  consistencyXxpNotZero: t("tools.httpHeadersAnalyzer.consistencyXxpNotZero"),
  consistencyUpgradeNoHsts: t(
    "tools.httpHeadersAnalyzer.consistencyUpgradeNoHsts",
  ),
  consistencyXfoContradictsFrameAncestors: t(
    "tools.httpHeadersAnalyzer.consistencyXfoContradictsFrameAncestors",
  ),
};

const sampleHeaders = `content-security-policy: default-src 'none'; script-src 'self' 'nonce-MASKED' 'strict-dynamic'; style-src 'self' 'nonce-MASKED'; img-src 'self' data: https://*.jmrp.io; font-src 'self'; connect-src 'self' https://api.github.com https://cloudflareinsights.com https://*.cloudflareinsights.com; media-src 'self'; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; report-uri /csp-report
strict-transport-security: max-age=63072000; includeSubDomains; preload
x-content-type-options: nosniff
x-frame-options: DENY
referrer-policy: strict-origin-when-cross-origin
permissions-policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(self), sync-xhr=(), usb=(), xr-spatial-tracking=()
cross-origin-opener-policy: same-origin
cross-origin-resource-policy: same-origin
cross-origin-embedder-policy: require-corp
set-cookie: __Host-Session=1; path=/; Secure; HttpOnly; SameSite=Strict
set-cookie: __Secure-Pref=1; path=/; Secure; HttpOnly; SameSite=Strict
server: jmrp.io`;
---

<div
  class="hdr-analyzer"
  data-hdr-id={uniqueId}
>
  {title && <div class="hdr-title">{title}</div>}

  <div class="hdr-layout">
    {/* URL Fetch */}
    <div class="hdr-fetch-section">
      <label
        class="hdr-label"
        for={`${uniqueId}-url`}
      >
        <span
          class="i-mdi:link-variant"
          aria-hidden="true"
        ></span>
        {t("tools.httpHeadersAnalyzer.fetchFromUrl")}
      </label>
      <div class="hdr-url-row">
        <input
          type="url"
          id={`${uniqueId}-url`}
          class="hdr-url-input"
          placeholder="https://example.com"
          spellcheck="false"
          autocomplete="off"
        />
        <button
          type="button"
          class="hdr-fetch-btn"
        >
          <span
            class="i-mdi:download"
            aria-hidden="true"
          ></span>
          {t("tools.httpHeadersAnalyzer.fetch")}
        </button>
      </div>
      <div
        class="hdr-fetch-status"
        id={`${uniqueId}-fetch-status`}
        hidden
      >
      </div>
      <div class="hdr-separator">
        <span>{t("tools.httpHeadersAnalyzer.orPasteHeaders")}</span>
      </div>
    </div>

    {/* Input */}
    <div class="hdr-input-section">
      <label
        class="hdr-label"
        for={`${uniqueId}-input`}
      >
        <span
          class="i-mdi:web"
          aria-hidden="true"
        ></span>
        {t("tools.httpHeadersAnalyzer.responseHeaders")}
      </label>
      <textarea
        id={`${uniqueId}-input`}
        class="hdr-textarea"
        rows="10"
        placeholder={t("tools.httpHeadersAnalyzer.pasteHeadersPlaceholder")}
        spellcheck="false"
        >{sampleHeaders}</textarea
      >
      <button
        type="button"
        class="hdr-analyze-btn"
      >
        <span
          class="i-mdi:shield-search"
          aria-hidden="true"
        ></span>
        {t("tools.httpHeadersAnalyzer.analyzeHeaders")}
      </button>
    </div>

    {/* Score */}
    <div
      class="hdr-score-section"
      id={`${uniqueId}-score`}
      hidden
    >
      <div class="hdr-score-display">
        <div
          class="hdr-score-ring"
          id={`${uniqueId}-score-ring`}
        >
          <svg
            viewBox="0 0 120 120"
            class="hdr-ring-svg"
          >
            <circle
              cx="60"
              cy="60"
              r="52"
              class="hdr-ring-bg"
            ></circle>
            <circle
              cx="60"
              cy="60"
              r="52"
              class="hdr-ring-fill"
              id={`${uniqueId}-ring-fill`}
            ></circle>
          </svg>
          <div class="hdr-ring-text">
            <span
              class="hdr-score-value"
              id={`${uniqueId}-score-value`}
              >0</span
            >
            <span class="hdr-score-max">/100</span>
          </div>
        </div>
        <span
          class="hdr-score-grade"
          id={`${uniqueId}-grade`}
          >—</span
        >
        <div
          class="hdr-summary"
          id={`${uniqueId}-summary`}
        >
        </div>
      </div>
    </div>

    {/* Results */}
    <div
      class="hdr-results"
      id={`${uniqueId}-results`}
    >
    </div>
  </div>
</div>

<script is:inline define:vars={{ uniqueId, i18n }}>
  (function () {
    const container = document.querySelector(`[data-hdr-id="${uniqueId}"]`);
    if (!container) return;

    /** Replace `{key}` placeholders in a string with values from vars object. */
    function tpl(str, vars) {
      return str.replace(/\{(\w+)\}/g, function (_, k) {
        return vars[k] != null ? vars[k] : "";
      });
    }

    const textarea = document.getElementById(`${uniqueId}-input`);
    const urlInput = document.getElementById(`${uniqueId}-url`);
    const fetchBtn = container.querySelector(".hdr-fetch-btn");
    const fetchStatus = document.getElementById(`${uniqueId}-fetch-status`);
    const scoreSection = document.getElementById(`${uniqueId}-score`);
    const scoreValue = document.getElementById(`${uniqueId}-score-value`);
    const ringFill = document.getElementById(`${uniqueId}-ring-fill`);
    const scoreRing = document.getElementById(`${uniqueId}-score-ring`);
    const gradeEl = document.getElementById(`${uniqueId}-grade`);
    const summaryEl = document.getElementById(`${uniqueId}-summary`);
    const resultsEl = document.getElementById(`${uniqueId}-results`);
    const analyzeBtn = container.querySelector(".hdr-analyze-btn");

    if (!textarea || !resultsEl) return;

    var circumference = 2 * Math.PI * 52;

    /* ====== URL Fetch ====== */
    if (fetchBtn && urlInput) {
      fetchBtn.addEventListener("click", async function () {
        var url = urlInput.value.trim();
        if (!url) return;
        if (!/^https?:\/\//.test(url)) url = "https://" + url;

        fetchBtn.disabled = true;
        fetchBtn.textContent = i18n.fetching;
        if (fetchStatus) {
          fetchStatus.hidden = false;
          fetchStatus.textContent = i18n.fetchingHeaders;
          fetchStatus.className = "hdr-fetch-status hdr-fetch-loading";
        }

        try {
          var res = await fetch(
            "/api/headers-proxy?url=" + encodeURIComponent(url),
          );
          var data = await res.json();
          if (!res.ok || data.error) {
            throw new Error(data.error || i18n.failedToFetchDefault);
          }
          var lines = [];
          if (data.headers && data.headers.length) {
            data.headers.forEach(function (h) {
              lines.push(h.name + ": " + h.value);
            });
          }
          if (lines.length === 0) {
            throw new Error(i18n.noHeadersReturned);
          }
          textarea.value = lines.join("\n");
          if (fetchStatus) {
            fetchStatus.textContent = tpl(i18n.fetchedHeaders, {
              count: lines.length,
            });
            fetchStatus.className = "hdr-fetch-status hdr-fetch-success";
          }
          analyze();
        } catch (err) {
          if (fetchStatus) {
            fetchStatus.textContent = tpl(i18n.failedToFetch, {
              msg: err.message || i18n.failedToFetchDefault,
              url: url,
            });
            fetchStatus.className = "hdr-fetch-status hdr-fetch-error";
          }
        } finally {
          fetchBtn.disabled = false;
          fetchBtn.innerHTML =
            '<span class="i-mdi:download" aria-hidden="true"></span> ' +
            i18n.fetch;
        }
      });

      urlInput.addEventListener("keydown", function (e) {
        if (e.key === "Enter") fetchBtn.click();
      });
    }

    /* ====== Security Headers Definition ====== */
    var securityHeaders = [
      {
        name: "content-security-policy",
        weight: 25,
        severity: i18n.severityCritical,
        description: i18n.cspDesc,
        link: "/blog/003-implementing-content-security-policy-nginx/",
        toolLink: "/tools/csp-builder/",
        recommended:
          "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'",
        check: function (val) {
          if (!val)
            return {
              score: 0,
              notes: [i18n.cspMissing],
            };
          var score = 5;
          var notes = [];
          // Core structure
          if (val.match(/default-src\s+'none'/)) {
            score += 6;
            notes.push(i18n.cspDefaultSrcNone);
          } else if (val.match(/default-src\s+'self'/)) {
            score += 3;
            notes.push(i18n.cspDefaultSrcSelf);
          } else if (val.includes("default-src")) {
            score += 1;
          } else {
            notes.push(i18n.cspMissingDefaultSrc);
          }
          // Script safety
          if (val.match(/script-src[^;]*'unsafe-inline'/)) {
            score -= 3;
            notes.push(i18n.cspUnsafeInline);
          }
          if (val.includes("'unsafe-eval'")) {
            score -= 3;
            notes.push(i18n.cspUnsafeEval);
          }
          // Wildcard / broad sources in script-src
          if (val.match(/script-src[^;]*(\s\*\s|data:|blob:)/)) {
            score -= 3;
            notes.push(i18n.cspDangerousSource);
          }
          if (val.match(/script-src[^;]*https:/)) {
            notes.push(i18n.cspTrustsAllHttps);
          }
          // CDN bypass warning
          if (
            val.match(
              /cdn\.jsdelivr\.net|cdnjs\.cloudflare\.com|unpkg\.com|googleapis\.com/,
            )
          ) {
            notes.push(i18n.cspCdnBypass);
          }
          // Strict CSP
          if (val.includes("nonce-")) {
            score += 4;
            notes.push(i18n.cspUsesNonces);
          } else {
            notes.push(i18n.cspMissingNonces);
          }
          if (val.includes("'strict-dynamic'")) {
            score += 3;
            notes.push(i18n.cspStrictDynamic);
          } else if (
            val.includes("nonce-") ||
            val.match(/'sha(256|384|512)-/)
          ) {
            notes.push(i18n.cspMissingStrictDynamic);
          }
          // Hardening directives
          if (val.match(/object-src\s+'none'/)) {
            score += 2;
            notes.push(i18n.cspObjectSrcNone);
          } else if (!val.includes("object-src")) {
            notes.push(i18n.cspMissingObjectSrc);
          }
          if (val.match(/base-uri\s+'(none|self)'/)) {
            score += 1;
            notes.push(i18n.cspBaseUriRestricted);
          } else if (!val.includes("base-uri")) {
            notes.push(i18n.cspMissingBaseUri);
          }
          if (val.includes("form-action")) {
            score += 1;
            notes.push(i18n.cspFormActionDefined);
          } else {
            notes.push(i18n.cspMissingFormAction);
          }
          if (val.includes("frame-ancestors")) {
            score += 1;
            notes.push(i18n.cspFrameAncestorsDefined);
          } else {
            notes.push(i18n.cspMissingFrameAncestors);
          }
          if (val.includes("upgrade-insecure-requests")) {
            score += 1;
            notes.push(i18n.cspUpgradeInsecure);
          } else {
            notes.push(i18n.cspMissingUpgradeInsecure);
          }
          if (val.includes("report-to") || val.includes("report-uri")) {
            score += 1;
            notes.push(i18n.cspReportingConfigured);
          } else {
            notes.push(i18n.cspNoReporting);
          }
          if (val.includes("require-trusted-types-for")) {
            notes.push(i18n.cspTrustedTypes);
          }
          return { score: Math.min(Math.max(score, 0), 25), notes: notes };
        },
      },
      {
        name: "strict-transport-security",
        weight: 15,
        severity: i18n.severityHigh,
        description: i18n.hstsDesc,
        recommended: "max-age=63072000; includeSubDomains; preload",
        check: function (val) {
          if (!val)
            return {
              score: 0,
              notes: [i18n.hstsMissing],
            };
          var score = 8;
          var notes = [];
          var maxAgeMatch = val.match(/max-age=(\d+)/);
          if (maxAgeMatch) {
            var maxAge = parseInt(maxAgeMatch[1]);
            if (maxAge === 0) {
              return {
                score: 1,
                notes: [i18n.hstsMaxAgeZero],
              };
            }
            if (maxAge >= 63072000) {
              score += 3;
              notes.push(i18n.hstsMaxAge2Years);
            } else if (maxAge >= 31536000) {
              score += 2;
              notes.push(i18n.hstsMaxAge1Year);
            } else {
              notes.push(i18n.hstsMaxAgeLow);
            }
          }
          if (val.includes("includeSubDomains")) {
            score += 2;
            notes.push(i18n.hstsIncludeSubDomains);
          } else {
            notes.push(i18n.hstsMissingIncludeSubDomains);
          }
          if (val.includes("preload")) {
            score += 2;
            notes.push(i18n.hstsPreload);
          } else {
            notes.push(i18n.hstsMissingPreload);
          }
          return { score: Math.min(score, 15), notes: notes };
        },
      },
      {
        name: "x-content-type-options",
        weight: 10,
        severity: i18n.severityMedium,
        description: i18n.xctDesc,
        recommended: "nosniff",
        check: function (val) {
          if (!val)
            return {
              score: 0,
              notes: [i18n.xctMissing],
            };
          if (val.trim() === "nosniff")
            return { score: 10, notes: [i18n.xctCorrect] };
          return { score: 2, notes: [i18n.xctWrong] };
        },
      },
      {
        name: "x-frame-options",
        weight: 8,
        severity: i18n.severityMedium,
        description: i18n.xfoDesc,
        recommended: "DENY",
        check: function (val) {
          if (!val)
            return {
              score: 0,
              notes: [i18n.xfoMissing],
            };
          if (val.trim().toUpperCase() === "DENY")
            return { score: 8, notes: [i18n.xfoDeny] };
          if (val.trim().toUpperCase() === "SAMEORIGIN")
            return {
              score: 6,
              notes: [i18n.xfoSameorigin],
            };
          return {
            score: 2,
            notes: [tpl(i18n.xfoUnexpected, { val: val })],
          };
        },
      },
      {
        name: "referrer-policy",
        weight: 8,
        severity: i18n.severityMedium,
        description: i18n.rpDesc,
        recommended: "strict-origin-when-cross-origin",
        check: function (val) {
          if (!val)
            return {
              score: 0,
              notes: [i18n.rpMissing],
            };
          var good = [
            "no-referrer",
            "strict-origin-when-cross-origin",
            "strict-origin",
            "same-origin",
          ];
          if (good.includes(val.trim()))
            return {
              score: 8,
              notes: [tpl(i18n.rpSecure, { val: val.trim() })],
            };
          if (val.trim() === "no-referrer-when-downgrade")
            return {
              score: 5,
              notes: [i18n.rpAcceptable],
            };
          if (val.trim() === "unsafe-url")
            return {
              score: 0,
              notes: [i18n.rpUnsafeUrl],
            };
          return { score: 2, notes: [i18n.rpConsider] };
        },
      },
      {
        name: "permissions-policy",
        weight: 8,
        severity: i18n.severityLow,
        description: i18n.ppDesc,
        recommended: "camera=(), microphone=(), geolocation=(), payment=()",
        check: function (val) {
          if (!val)
            return {
              score: 0,
              notes: [i18n.ppMissing],
            };
          var score = 4;
          var notes = [];
          var features = [
            "camera=()",
            "microphone=()",
            "geolocation=()",
            "payment=()",
          ];
          features.forEach(function (f) {
            var featureName =
              f.split("=")[0].charAt(0).toUpperCase() +
              f.split("=")[0].slice(1);
            if (val.includes(f)) {
              score += 1;
              notes.push(tpl(i18n.ppDisabled, { feature: featureName }));
            } else {
              notes.push(
                tpl(i18n.ppMissingRestriction, {
                  feature: featureName.toLowerCase(),
                }),
              );
            }
          });
          return { score: Math.min(score, 8), notes: notes };
        },
      },
      {
        name: "x-xss-protection",
        weight: 3,
        severity: i18n.severityInfo,
        description: i18n.xxpDesc,
        recommended: "0",
        // This check receives hasCsp as second arg from analyze()
        check: function (val, hasCsp) {
          if (hasCsp) {
            // CSP present: absent or '0' both acceptable
            if (!val)
              return {
                score: 3,
                notes: [i18n.xxpAbsentCorrect],
              };
            if (val.trim() === "0")
              return {
                score: 3,
                notes: [i18n.xxpDisabledCorrect],
              };
            return {
              score: 1,
              notes: [i18n.xxpShouldBeZero],
            };
          }
          // No CSP: x-xss-protection becomes more relevant
          if (!val)
            return {
              score: 0,
              notes: [i18n.xxpMissingNoCsp],
            };
          if (val.trim() === "0")
            return {
              score: 1,
              notes: [i18n.xxpDisabledNoCsp],
            };
          if (val.trim() === "1; mode=block")
            return {
              score: 2,
              notes: [i18n.xxpLegacyEnabled],
            };
          return {
            score: 1,
            notes: [i18n.xxpConsiderCsp],
          };
        },
      },
      {
        name: "cross-origin-opener-policy",
        weight: 8,
        severity: i18n.severityMedium,
        description: i18n.coopDesc,
        recommended: "same-origin",
        check: function (val) {
          if (!val)
            return {
              score: 0,
              notes: [i18n.coopMissing],
            };
          if (val.trim() === "same-origin")
            return { score: 8, notes: [i18n.coopSameOrigin] };
          if (val.trim() === "same-origin-allow-popups")
            return {
              score: 5,
              notes: [i18n.coopPartialIsolation, i18n.coopConsiderSameOrigin],
            };
          return { score: 2, notes: [i18n.coopUnexpected] };
        },
      },
      {
        name: "cross-origin-resource-policy",
        weight: 8,
        severity: i18n.severityMedium,
        description: i18n.corpDesc,
        recommended: "same-origin",
        check: function (val) {
          if (!val)
            return {
              score: 0,
              notes: [i18n.corpMissing],
            };
          if (val.trim() === "same-origin")
            return { score: 8, notes: [i18n.corpSameOrigin] };
          if (val.trim() === "same-site")
            return {
              score: 6,
              notes: [i18n.corpSameSite, i18n.corpConsiderSameOrigin2],
            };
          return {
            score: 3,
            notes: [i18n.corpCrossOrigin, i18n.corpConsiderSameOrigin5],
          };
        },
      },
      {
        name: "cross-origin-embedder-policy",
        weight: 7,
        severity: i18n.severityMedium,
        description: i18n.coepDesc,
        recommended: "require-corp",
        check: function (val) {
          if (!val)
            return {
              score: 0,
              notes: [i18n.coepMissing],
            };
          if (val.trim() === "require-corp")
            return { score: 7, notes: [i18n.coepRequireCorp] };
          if (val.trim() === "credentialless")
            return {
              score: 5,
              notes: [i18n.coepCredentialless, i18n.coepConsiderRequireCorp],
            };
          return { score: 2, notes: [i18n.coepUnexpected] };
        },
      },
    ];

    /* ====== Information Leak & Cookie Checks ====== */
    var infoLeakHeaders = [
      {
        name: "server",
        severity: i18n.severityInfo,
        description: i18n.serverDesc,
        check: function (val) {
          if (!val) return { status: "good", notes: [i18n.serverNotExposed] };
          var proxies = [
            "cloudflare",
            "vercel",
            "netlify",
            "fastly",
            "akamai",
            "cloudfront",
            "azure",
            "google frontend",
            "gws",
            "gse",
            "envoy",
            "fly.io",
            "railway",
            "render",
            "heroku",
            "deno",
          ];
          var isProxy = proxies.some(function (p) {
            return val.toLowerCase().includes(p);
          });
          if (isProxy)
            return {
              status: "good",
              notes: [tpl(i18n.serverProxyCdn, { val: val })],
            };
          if (/\d/.test(val))
            return {
              status: "warn",
              notes: [tpl(i18n.serverVersionExposed, { val: val })],
            };
          return {
            status: "info",
            notes: [tpl(i18n.serverNameExposed, { val: val })],
          };
        },
      },
      {
        name: "x-powered-by",
        severity: i18n.severityInfo,
        description: i18n.xPoweredByDesc,
        check: function (val) {
          if (!val) return { status: "good", notes: [i18n.serverNotExposed] };
          return {
            status: "warn",
            notes: [tpl(i18n.xPoweredByExposed, { val: val })],
          };
        },
      },
      {
        name: "x-aspnet-version",
        severity: i18n.severityInfo,
        description: i18n.xAspnetVersionDesc,
        check: function (val) {
          if (!val) return null;
          return {
            status: "warn",
            notes: [tpl(i18n.xAspnetVersionExposed, { val: val })],
          };
        },
      },
      {
        name: "x-aspnetmvc-version",
        severity: i18n.severityInfo,
        description: i18n.xAspnetMvcVersionDesc,
        check: function (val) {
          if (!val) return null;
          return {
            status: "warn",
            notes: [i18n.xAspnetMvcVersionExposed],
          };
        },
      },
      {
        name: "x-generator",
        severity: i18n.severityInfo,
        description: i18n.xGeneratorDesc,
        check: function (val) {
          if (!val) return null;
          return {
            status: "warn",
            notes: [tpl(i18n.xGeneratorExposed, { val: val })],
          };
        },
      },
    ];

    function parseHeaders(text) {
      var headers = {};
      var setCookies = [];
      text.split("\n").forEach(function (line) {
        line = line.trim();
        if (!line) return;
        if (/^HTTP\/[\d.]+\s/.test(line)) return;
        var colonIdx = line.indexOf(":");
        if (colonIdx === -1) return;
        var name = line.substring(0, colonIdx).trim().toLowerCase();
        var value = line.substring(colonIdx + 1).trim();
        if (name === "set-cookie") {
          setCookies.push(value);
        }
        headers[name] = value;
      });
      headers._setCookies = setCookies;
      return headers;
    }

    function analyze() {
      var headers = parseHeaders(textarea.value);
      var totalScore = 0;
      var maxScore = 0;
      var present = 0;
      var missing = 0;
      var hasCsp = !!headers["content-security-policy"];

      resultsEl.textContent = "";

      securityHeaders.forEach(function (h) {
        maxScore += h.weight;
        var val = headers[h.name] || null;
        var result =
          h.name === "x-xss-protection" ? h.check(val, hasCsp) : h.check(val);
        totalScore += result.score;
        if (val) present++;
        else if (h.name === "x-xss-protection" && hasCsp) {
          // Don't count as missing if CSP covers it
          present++;
        } else {
          missing++;
        }

        var card = document.createElement("div");
        var isGood = result.score >= h.weight * 0.7;
        var cardClass = "hdr-result-card";
        if (val) cardClass += " hdr-present";
        else if (
          h.name === "x-xss-protection" &&
          hasCsp &&
          result.score >= h.weight * 0.7
        )
          cardClass += " hdr-present";
        else cardClass += " hdr-missing";
        card.className = cardClass;

        var header = document.createElement("div");
        header.className = "hdr-result-header";

        var status = document.createElement("span");
        status.className =
          "hdr-status " +
          (isGood
            ? "hdr-status-good"
            : result.score > 0
              ? "hdr-status-warn"
              : "hdr-status-bad");
        var statusIcon = document.createElement("span");
        statusIcon.className = isGood
          ? "i-mdi:check-circle"
          : result.score > 0
            ? "i-mdi:alert-circle"
            : "i-mdi:close-circle";
        status.appendChild(statusIcon);

        var name = document.createElement("code");
        name.className = "hdr-result-name";
        name.textContent = h.name;

        var severity = document.createElement("span");
        severity.className = "hdr-severity hdr-severity-" + h.severity;
        severity.textContent = h.severity;

        var scoreEl = document.createElement("span");
        scoreEl.className = "hdr-result-score";
        scoreEl.textContent = result.score + "/" + h.weight;

        header.appendChild(status);
        header.appendChild(name);
        header.appendChild(severity);
        header.appendChild(scoreEl);

        var desc = document.createElement("p");
        desc.className = "hdr-result-desc";
        desc.textContent = h.description;

        card.appendChild(header);
        card.appendChild(desc);

        if (val) {
          var value = document.createElement("div");
          value.className = "hdr-result-value";
          var valueCode = document.createElement("code");
          valueCode.textContent = val;
          value.appendChild(valueCode);
          card.appendChild(value);
        }

        if (!val && h.recommended) {
          var rec = document.createElement("div");
          rec.className = "hdr-recommended";
          rec.innerHTML =
            '<span class="hdr-rec-label">' +
            i18n.recommended +
            "</span> <code>" +
            h.recommended +
            "</code>";
          card.appendChild(rec);
        }

        if (result.notes.length > 0) {
          var notes = document.createElement("ul");
          notes.className = "hdr-result-notes";
          result.notes.forEach(function (n) {
            var li = document.createElement("li");
            li.textContent = n;
            if (n.includes("\u2713")) {
              li.className = "hdr-note-pass";
            } else if (result.score < h.weight * 0.7) {
              li.className = "hdr-note-miss";
            }
            notes.appendChild(li);
          });
          card.appendChild(notes);
        }

        // Links
        if (h.link || h.toolLink) {
          var linksDiv = document.createElement("div");
          linksDiv.className = "hdr-result-links";
          if (h.link) {
            var link = document.createElement("a");
            link.className = "hdr-learn-more";
            link.href = h.link;
            link.textContent = i18n.learnMore;
            linksDiv.appendChild(link);
          }
          if (h.toolLink) {
            var toolLink = document.createElement("a");
            toolLink.className = "hdr-learn-more";
            toolLink.href = h.toolLink;
            toolLink.textContent = i18n.cspBuilderTool;
            linksDiv.appendChild(toolLink);
          }
          card.appendChild(linksDiv);
        }

        resultsEl.appendChild(card);
      });

      // Set-Cookie security
      var cookies = headers._setCookies || [];
      if (cookies.length > 0) {
        var cookieTitle = document.createElement("div");
        cookieTitle.className = "hdr-section-title";
        cookieTitle.textContent = i18n.cookieSecurity;
        resultsEl.appendChild(cookieTitle);

        cookies.forEach(function (cookie) {
          var cookieName = cookie.split("=")[0].trim();
          var lc = cookie.toLowerCase();
          var notes = [];
          var worstStatus = "good";

          if (!lc.includes("secure")) {
            notes.push(i18n.cookieMissingSecure);
            worstStatus = "warn";
          }
          if (!lc.includes("httponly")) {
            notes.push(i18n.cookieMissingHttpOnly);
            worstStatus = "warn";
          }
          if (!lc.includes("samesite")) {
            notes.push(i18n.cookieMissingSameSite);
            worstStatus = "warn";
          }
          if (lc.includes("samesite=none") && !lc.includes("secure")) {
            notes.push(i18n.cookieSameSiteNoneNoSecure);
            worstStatus = "warn";
          }
          if (cookieName.startsWith("__Host-")) {
            notes.push(i18n.cookieHostPrefix);
          } else if (cookieName.startsWith("__Secure-")) {
            notes.push(i18n.cookieSecurePrefix);
          }
          if (notes.length === 0) {
            notes.push(i18n.cookieAllPresent);
          }

          var card = document.createElement("div");
          card.className =
            "hdr-result-card hdr-info-card hdr-info-" + worstStatus;

          var hdr = document.createElement("div");
          hdr.className = "hdr-result-header";

          var st = document.createElement("span");
          st.className = "hdr-status hdr-status-" + worstStatus;
          var stIcon = document.createElement("span");
          stIcon.className =
            worstStatus === "good"
              ? "i-mdi:check-circle"
              : "i-mdi:alert-circle";
          st.appendChild(stIcon);

          var n = document.createElement("code");
          n.className = "hdr-result-name";
          n.textContent = cookieName;

          var sev = document.createElement("span");
          sev.className = "hdr-severity hdr-severity-medium";
          sev.textContent = i18n.severityCookie;

          hdr.appendChild(st);
          hdr.appendChild(n);
          hdr.appendChild(sev);

          card.appendChild(hdr);

          var valDiv = document.createElement("div");
          valDiv.className = "hdr-result-value";
          var valCode = document.createElement("code");
          valCode.textContent = cookie;
          valDiv.appendChild(valCode);
          card.appendChild(valDiv);

          var notesList = document.createElement("ul");
          notesList.className = "hdr-result-notes";
          notes.forEach(function (note) {
            var li = document.createElement("li");
            li.textContent = note;
            notesList.appendChild(li);
          });
          card.appendChild(notesList);
          resultsEl.appendChild(card);
        });
      }

      // Information leak section
      var hasInfoLeak = false;
      var infoResults = [];
      infoLeakHeaders.forEach(function (h) {
        var val = headers[h.name] || null;
        var result = h.check(val);
        if (result) infoResults.push({ header: h, result: result, val: val });
        if (result && result.status === "warn") hasInfoLeak = true;
      });

      if (infoResults.length > 0) {
        var infoTitle = document.createElement("div");
        infoTitle.className = "hdr-section-title";
        infoTitle.textContent = i18n.informationLeakage;
        resultsEl.appendChild(infoTitle);

        infoResults.forEach(function (item) {
          if (!item.result) return;
          var card = document.createElement("div");
          card.className =
            "hdr-result-card hdr-info-card hdr-info-" + item.result.status;

          var header = document.createElement("div");
          header.className = "hdr-result-header";

          var status = document.createElement("span");
          status.className = "hdr-status hdr-status-" + item.result.status;
          var statusIcon = document.createElement("span");
          statusIcon.className =
            item.result.status === "good"
              ? "i-mdi:check-circle"
              : "i-mdi:alert-circle";
          status.appendChild(statusIcon);

          var nameEl = document.createElement("code");
          nameEl.className = "hdr-result-name";
          nameEl.textContent = item.header.name;

          var sev = document.createElement("span");
          sev.className = "hdr-severity hdr-severity-info";
          sev.textContent = i18n.severityInfo;

          header.appendChild(status);
          header.appendChild(nameEl);
          header.appendChild(sev);

          var desc = document.createElement("p");
          desc.className = "hdr-result-desc";
          desc.textContent = item.header.description;

          card.appendChild(header);
          card.appendChild(desc);

          if (item.result.notes.length > 0) {
            var notes = document.createElement("ul");
            notes.className = "hdr-result-notes";
            item.result.notes.forEach(function (n) {
              var li = document.createElement("li");
              li.textContent = n;
              notes.appendChild(li);
            });
            card.appendChild(notes);
          }

          resultsEl.appendChild(card);
        });
      }

      // Cross-header consistency checks
      var consistency = [];
      if (
        headers["x-frame-options"] &&
        hasCsp &&
        !headers["content-security-policy"].includes("frame-ancestors")
      ) {
        consistency.push(i18n.consistencyXfoNoCspFrameAncestors);
      }
      if (
        hasCsp &&
        headers["x-xss-protection"] &&
        headers["x-xss-protection"].trim() !== "0"
      ) {
        consistency.push(i18n.consistencyXxpNotZero);
      }
      if (
        !headers["strict-transport-security"] &&
        hasCsp &&
        headers["content-security-policy"].includes("upgrade-insecure-requests")
      ) {
        consistency.push(i18n.consistencyUpgradeNoHsts);
      }
      if (
        headers["x-frame-options"] &&
        hasCsp &&
        headers["content-security-policy"].includes("frame-ancestors") &&
        headers["x-frame-options"].trim().toUpperCase() !== "DENY" &&
        headers["content-security-policy"].includes("frame-ancestors 'none'")
      ) {
        consistency.push(
          i18n.consistencyXfoContradictsFrameAncestors.replace(
            "{val}",
            headers["x-frame-options"],
          ),
        );
      }

      if (consistency.length > 0) {
        var conTitle = document.createElement("div");
        conTitle.className = "hdr-section-title";
        conTitle.textContent = i18n.crossHeaderConsistency;
        resultsEl.appendChild(conTitle);

        consistency.forEach(function (msg) {
          var card = document.createElement("div");
          card.className = "hdr-result-card hdr-info-card hdr-info-warn";
          var hdr = document.createElement("div");
          hdr.className = "hdr-result-header";
          var st = document.createElement("span");
          st.className = "hdr-status hdr-status-warn";
          var stIcon = document.createElement("span");
          stIcon.className = "i-mdi:alert-circle";
          st.appendChild(stIcon);
          var label = document.createElement("span");
          label.className = "hdr-result-name";
          label.style.fontFamily = "inherit";
          label.textContent = i18n.inconsistencyDetected;
          hdr.appendChild(st);
          hdr.appendChild(label);
          card.appendChild(hdr);
          var desc = document.createElement("p");
          desc.className = "hdr-result-desc";
          desc.textContent = msg;
          card.appendChild(desc);
          resultsEl.appendChild(card);
        });
      }

      // Score
      var pct = Math.round((totalScore / maxScore) * 100);
      if (scoreSection) scoreSection.hidden = false;
      if (scoreValue) scoreValue.textContent = String(pct);

      if (ringFill) {
        var offset = circumference - (pct / 100) * circumference;
        ringFill.style.strokeDasharray = circumference;
        ringFill.style.strokeDashoffset = offset;
      }

      var grade;
      if (pct >= 90) grade = "A+";
      else if (pct >= 80) grade = "A";
      else if (pct >= 70) grade = "B";
      else if (pct >= 50) grade = "C";
      else if (pct >= 30) grade = "D";
      else grade = "F";

      var gradeClass = "hdr-grade-" + grade.replace("+", "plus").toLowerCase();

      if (gradeEl) {
        gradeEl.textContent = grade;
        gradeEl.className = "hdr-score-grade " + gradeClass;
      }

      if (scoreRing) {
        scoreRing.className = "hdr-score-ring " + gradeClass;
      }

      if (summaryEl) {
        summaryEl.innerHTML =
          '<span class="hdr-sum-ok">' +
          tpl(i18n.summaryPresent, { count: present }) +
          "</span> \u00B7 " +
          '<span class="hdr-sum-miss">' +
          tpl(i18n.summaryMissing, { count: missing }) +
          "</span>" +
          (cookies.length > 0
            ? " \u00B7 <span>" +
              tpl(
                cookies.length > 1
                  ? i18n.summaryCookiesAnalyzed
                  : i18n.summaryCookieAnalyzed,
                { count: cookies.length },
              ) +
              "</span>"
            : "") +
          (hasInfoLeak
            ? ' \u00B7 <span class="hdr-sum-warn">' +
              i18n.summaryInfoLeaks +
              "</span>"
            : "") +
          (consistency.length > 0
            ? ' \u00B7 <span class="hdr-sum-warn">' +
              tpl(
                consistency.length > 1
                  ? i18n.summaryInconsistencies
                  : i18n.summaryInconsistency,
                { count: consistency.length },
              ) +
              "</span>"
            : "");
      }
    }

    if (analyzeBtn) analyzeBtn.addEventListener("click", analyze);

    analyze();
  })();
</script>

<style>
  .hdr-analyzer {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-subtle);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .hdr-title {
    padding: 1rem 1.25rem;
    font-size: var(--text-lg);
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
    background: var(--color-bg-secondary);
    border-bottom: var(--border-1);
  }

  .hdr-layout {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
  }

  /* URL Fetch */
  .hdr-fetch-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hdr-url-row {
    display: flex;
    gap: 0.5rem;
  }

  .hdr-url-input {
    flex: 1;
    padding: 0.625rem 0.875rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s;
  }

  .hdr-url-input:focus {
    outline: none;
