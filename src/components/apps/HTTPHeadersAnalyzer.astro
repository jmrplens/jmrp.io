    color: #fff;
    cursor: pointer;
    background: var(--color-primary);
    border: none;
    border-radius: var(--radius-sm);
    transition: opacity 0.15s;
  }

  .hdr-fetch-btn span {
    width: 16px;
    height: 16px;
  }

  .hdr-fetch-btn:hover {
    opacity: 90%;
  }

  .hdr-fetch-btn:disabled {
    cursor: not-allowed;
    opacity: 60%;
  }

  .hdr-fetch-status {
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    line-height: 1.4;
    border-radius: var(--radius-sm);
  }

  .hdr-fetch-status[hidden] {
