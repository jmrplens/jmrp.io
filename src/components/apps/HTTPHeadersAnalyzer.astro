    background: transparent;
  }

  :root[data-theme="dark"] .hdr-grade-aplus,
  :root[data-theme="dark"] .hdr-grade-a {
    color: #6ee7b7;
    background: rgb(6 95 70 / 40%);
  }

  :root[data-theme="dark"] .hdr-score-ring.hdr-grade-aplus,
  :root[data-theme="dark"] .hdr-score-ring.hdr-grade-a {
    color: #34d399;
    background: transparent;
  }

  :root[data-theme="dark"] .hdr-grade-b {
    color: #fcd34d;
    background: rgb(146 64 14 / 40%);
  }

  :root[data-theme="dark"] .hdr-score-ring.hdr-grade-b {
    color: #fbbf24;
    background: transparent;
  }

  :root[data-theme="dark"] .hdr-grade-c {
    color: #fdba74;
    background: rgb(154 52 18 / 40%);
  }

  :root[data-theme="dark"] .hdr-score-ring.hdr-grade-c {
    color: #fb923c;
    background: transparent;
  }

  :root[data-theme="dark"] .hdr-grade-d,
  :root[data-theme="dark"] .hdr-grade-f {
    color: #fca5a5;
    background: rgb(153 27 27 / 40%);
  }

  :root[data-theme="dark"] .hdr-score-ring.hdr-grade-d,
  :root[data-theme="dark"] .hdr-score-ring.hdr-grade-f {
    color: #f87171;
    background: transparent;
  }

  .hdr-summary {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .hdr-summary :global(.hdr-sum-ok) {
    color: #047857;
  }

  .hdr-summary :global(.hdr-sum-miss) {
    color: #b91c1c;
  }

  .hdr-summary :global(.hdr-sum-warn) {
    color: #92400e;
  }

  :root[data-theme="dark"] .hdr-summary :global(.hdr-sum-ok) {
    color: #6ee7b7;
  }

  :root[data-theme="dark"] .hdr-summary :global(.hdr-sum-miss) {
    color: #fca5a5;
  }

  :root[data-theme="dark"] .hdr-summary :global(.hdr-sum-warn) {
    color: #fcd34d;
  }

  /* Results */
  .hdr-results {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hdr-results :global(.hdr-section-title) {
