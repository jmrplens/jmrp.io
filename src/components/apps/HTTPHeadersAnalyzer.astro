  }

  .hdr-score-grade {
    padding: 0.25rem 1rem;
    font-size: 1.25rem;
    font-weight: var(--fw-bold);
    border-radius: var(--radius-sm);
  }

  .hdr-grade-aplus,
  .hdr-grade-a {
    color: #065f46;
    background: #d1fae5;
  }

  .hdr-score-ring.hdr-grade-aplus,
  .hdr-score-ring.hdr-grade-a {
    color: #10b981;
    background: transparent;
  }

  .hdr-grade-b {
    color: #92400e;
    background: #fef3c7;
  }

  .hdr-score-ring.hdr-grade-b {
    color: #f59e0b;
    background: transparent;
  }

  .hdr-grade-c {
    color: #9a3412;
    background: #fed7aa;
  }

  .hdr-score-ring.hdr-grade-c {
    color: #f97316;
    background: transparent;
  }

  .hdr-grade-d,
  .hdr-grade-f {
    color: #991b1b;
    background: #fecaca;
  }

  .hdr-score-ring.hdr-grade-d,
  .hdr-score-ring.hdr-grade-f {
