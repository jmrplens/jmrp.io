      "yeast",
      "yield",
      "young",
      "yours",
      "youth",
      "zebra",
      "zones",
      "zesty",
    ];

    const charsets = {
      uppercase: "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
      lowercase: "abcdefghijklmnopqrstuvwxyz",
      numbers: "0123456789",
      symbols: "!@#$%^&*()_+-=[]{}|;:,.<>?",
    };

    function getSecureRandom(max) {
      const arr = new Uint32Array(1);
      crypto.getRandomValues(arr);
      return arr[0] % max;
    }

    function generatePassword() {
      const length = parseInt(lengthInput.value);
      let charset = "";
      var checks = container.querySelectorAll(".pwd-check[data-charset]");
      checks.forEach(function (cb) {
        if (cb.checked) charset += charsets[cb.dataset.charset];
      });

      if (!charset) {
        charset = charsets.lowercase;
      }

      let result = "";
      for (let i = 0; i < length; i++) {
        result += charset[getSecureRandom(charset.length)];
      }

      const entropy = Math.floor(length * Math.log2(charset.length));
      return { password: result, entropy: entropy };
    }

    function generatePassphrase() {
      const numWords = parseInt(wordsInput.value);
      const separator = separatorSelect.value;
      const capitalize = container.querySelector(
        '[data-pp-opt="capitalize"]',
      )?.checked;
      const addNumber = container.querySelector(
        '[data-pp-opt="number"]',
      )?.checked;

      const words = [];
      for (let i = 0; i < numWords; i++) {
        let word = wordList[getSecureRandom(wordList.length)];
        if (capitalize) word = word[0].toUpperCase() + word.slice(1);
        words.push(word);
      }

      let result = words.join(separator);
      if (addNumber) {
        result += separator + getSecureRandom(1000);
      }

      const entropy = Math.floor(numWords * Math.log2(wordList.length));
      return { password: result, entropy: entropy };
    }

    function updateStrength(entropy) {
      let label, percent, colorClass;

      if (entropy >= 128) {
        label = "Very Strong";
        percent = 100;
        colorClass = "strength-very-strong";
      } else if (entropy >= 80) {
        label = "Strong";
        percent = 80;
        colorClass = "strength-strong";
      } else if (entropy >= 60) {
        label = "Good";
        percent = 60;
        colorClass = "strength-good";
      } else if (entropy >= 40) {
        label = "Fair";
        percent = 40;
        colorClass = "strength-fair";
      } else {
        label = "Weak";
        percent = 20;
        colorClass = "strength-weak";
      }

      if (strengthFill) {
        strengthFill.style.setProperty("--pwd-strength", percent + "%");
        strengthFill.className = "pwd-strength-fill " + colorClass;
      }
      if (strengthLabel) strengthLabel.textContent = label;
      if (entropyEl) entropyEl.textContent = entropy + " bits of entropy";
    }

    function generate() {
      var gen = mode === "password" ? generatePassword() : generatePassphrase();
      if (resultEl) resultEl.textContent = gen.password;
      updateStrength(gen.entropy);
    }

    // Mode toggle
    modeBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        modeBtns.forEach(function (b) {
          b.classList.remove("active");
        });
        btn.classList.add("active");
        mode = btn.dataset.mode;

        if (passwordOpts) passwordOpts.hidden = mode !== "password";
        if (passphraseOpts) passphraseOpts.hidden = mode !== "passphrase";
        generate();
      });
    });

    // Range inputs
    if (lengthInput) {
      lengthInput.addEventListener("input", function () {
        if (lengthValue) lengthValue.textContent = lengthInput.value;
        generate();
      });
    }
    if (wordsInput) {
      wordsInput.addEventListener("input", function () {
        if (wordsValue) wordsValue.textContent = wordsInput.value;
        generate();
      });
    }

    // Checkbox and select changes
    container
      .querySelectorAll(".pwd-check, .pwd-select")
      .forEach(function (el) {
        el.addEventListener("change", generate);
      });
    if (separatorSelect) separatorSelect.addEventListener("change", generate);

    // Copy
    if (copyBtn) {
      copyBtn.addEventListener("click", function () {
        if (navigator.clipboard && resultEl) {
          navigator.clipboard
            .writeText(resultEl.textContent || "")
            .then(function () {
              copyBtn.classList.add("copied");
              setTimeout(function () {
                copyBtn.classList.remove("copied");
              }, 2000);
            });
        }
      });
    }

    // Refresh
    if (refreshBtn) {
      refreshBtn.addEventListener("click", generate);
    }

    generate();
  })();
</script>

