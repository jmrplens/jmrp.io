---
/**
 * PasswordGenerator Component
 * Cryptographically secure password and passphrase generator.
 * Uses WebCrypto API for randomness. No data leaves the browser.
 *
 * Usage:
 * <PasswordGenerator title="Password Generator" />
 */

interface Props {
  title?: string;
}

const { title = "Password Generator" } = Astro.props;
const uniqueId = `pwd-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;
---

<div
  class="pwd-generator"
  data-pwd-id={uniqueId}
>
  {title && <div class="pwd-title">{title}</div>}

  <div class="pwd-layout">
    {/* Output */}
    <div class="pwd-output-section">
      <div class="pwd-result-wrapper">
        <code
          class="pwd-result"
          id={`${uniqueId}-result`}
          aria-live="polite"
          >Generating...</code
        >
        <div class="pwd-actions">
          <button
            type="button"
            class="pwd-btn pwd-copy-btn"
            aria-label="Copy password"
          >
            <span class="i-mdi:content-copy"></span>
          </button>
          <button
            type="button"
            class="pwd-btn pwd-refresh-btn"
            aria-label="Generate new password"
          >
            <span class="i-mdi:refresh"></span>
          </button>
        </div>
      </div>

      {/* Strength meter */}
      <div class="pwd-strength">
        <div class="pwd-strength-bar">
          <div
            class="pwd-strength-fill"
            id={`${uniqueId}-strength-fill`}
          >
          </div>
        </div>
        <div class="pwd-strength-info">
          <span
            class="pwd-strength-label"
            id={`${uniqueId}-strength-label`}
            >...</span
          >
          <span
            class="pwd-entropy"
            id={`${uniqueId}-entropy`}
            >0 bits</span
          >
        </div>
      </div>
    </div>

    {/* Mode toggle */}
    <div class="pwd-mode-toggle">
      <button
        type="button"
        class="pwd-mode-btn active"
        data-mode="password"
      >
        <span
          class="i-mdi:form-textbox-password"
          aria-hidden="true"
        ></span>
        Random Password
      </button>
      <button
        type="button"
        class="pwd-mode-btn"
        data-mode="passphrase"
      >
        <span
          class="i-mdi:text-long"
          aria-hidden="true"
        ></span>
        Passphrase
      </button>
    </div>

    {/* Password Options */}
    <div
      class="pwd-options"
      id={`${uniqueId}-password-options`}
    >
      <div class="pwd-option-row">
        <label for={`${uniqueId}-length`}>Length</label>
        <div class="pwd-range-wrapper">
          <input
            type="range"
            id={`${uniqueId}-length`}
            min="8"
            max="128"
            value="20"
            class="pwd-range"
          />
          <span
            class="pwd-range-value"
            id={`${uniqueId}-length-value`}
            >20</span
          >
        </div>
      </div>
      <div class="pwd-checkboxes">
        <label class="pwd-check-label">
          <input
            type="checkbox"
            class="pwd-check"
            data-charset="uppercase"
            checked
          />
          <span class="pwd-check-box"
            ><span class="pwd-check-icon">✓</span></span
          >
          <span>Uppercase (A-Z)</span>
        </label>
        <label class="pwd-check-label">
          <input
            type="checkbox"
            class="pwd-check"
            data-charset="lowercase"
            checked
          />
          <span class="pwd-check-box"
            ><span class="pwd-check-icon">✓</span></span
          >
          <span>Lowercase (a-z)</span>
        </label>
        <label class="pwd-check-label">
          <input
            type="checkbox"
            class="pwd-check"
            data-charset="numbers"
            checked
          />
          <span class="pwd-check-box"
            ><span class="pwd-check-icon">✓</span></span
          >
          <span>Numbers (0-9)</span>
        </label>
        <label class="pwd-check-label">
          <input
            type="checkbox"
            class="pwd-check"
            data-charset="symbols"
            checked
          />
          <span class="pwd-check-box"
            ><span class="pwd-check-icon">✓</span></span
          >
          <span>Symbols (!@#$...)</span>
        </label>
      </div>
    </div>

    {/* Passphrase Options */}
    <div
      class="pwd-options"
      id={`${uniqueId}-passphrase-options`}
      hidden
    >
      <div class="pwd-option-row">
        <label for={`${uniqueId}-words`}>Words</label>
        <div class="pwd-range-wrapper">
          <input
            type="range"
            id={`${uniqueId}-words`}
            min="3"
            max="12"
            value="5"
            class="pwd-range"
          />
          <span
            class="pwd-range-value"
            id={`${uniqueId}-words-value`}
            >5</span
          >
        </div>
      </div>
      <div class="pwd-option-row">
        <label for={`${uniqueId}-separator`}>Separator</label>
        <select
          id={`${uniqueId}-separator`}
          class="pwd-select"
        >
          <option value="-">Hyphen (-)</option>
          <option value=".">Dot (.)</option>
          <option value="_">Underscore (_)</option>
          <option value=" ">Space</option>
          <option value="">None</option>
        </select>
      </div>
      <div class="pwd-checkboxes">
        <label class="pwd-check-label">
          <input
            type="checkbox"
            class="pwd-check"
            data-pp-opt="capitalize"
            checked
          />
          <span class="pwd-check-box"
            ><span class="pwd-check-icon">✓</span></span
          >
          <span>Capitalize Words</span>
        </label>
        <label class="pwd-check-label">
          <input
            type="checkbox"
            class="pwd-check"
            data-pp-opt="number"
            checked
          />
          <span class="pwd-check-box"
            ><span class="pwd-check-icon">✓</span></span
          >
          <span>Add Number</span>
        </label>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ uniqueId }}>
  (function () {
    const container = document.querySelector(`[data-pwd-id="${uniqueId}"]`);
    if (!container) return;

    const resultEl = document.getElementById(`${uniqueId}-result`);
    const strengthFill = document.getElementById(`${uniqueId}-strength-fill`);
    const strengthLabel = document.getElementById(`${uniqueId}-strength-label`);
    const entropyEl = document.getElementById(`${uniqueId}-entropy`);
    const copyBtn = container.querySelector(".pwd-copy-btn");
    const refreshBtn = container.querySelector(".pwd-refresh-btn");
    const modeBtns = container.querySelectorAll(".pwd-mode-btn");
    const passwordOpts = document.getElementById(
      `${uniqueId}-password-options`,
    );
    const passphraseOpts = document.getElementById(
      `${uniqueId}-passphrase-options`,
    );
    const lengthInput = document.getElementById(`${uniqueId}-length`);
    const lengthValue = document.getElementById(`${uniqueId}-length-value`);
    const wordsInput = document.getElementById(`${uniqueId}-words`);
    const wordsValue = document.getElementById(`${uniqueId}-words-value`);
    const separatorSelect = document.getElementById(`${uniqueId}-separator`);

    if (!resultEl) return;

    let mode = "password";

