---
/**
 * TimestampConverter Component
 * Convert between Unix timestamps and human-readable dates.
 *
 * Features:
 * - Bidirectional sync (timestamp ↔ date picker)
 * - Auto-detect seconds vs milliseconds
 * - Timezone comparison table (11 zones, local highlighted)
 * - Multiple output formats (Local, UTC, RFC 2822, short date, week, day-of-year)
 * - URL parameter sharing (?ts=...&unit=auto|s|ms)
 * - Copy buttons on all result values
 * - Live current-timestamp clock with "Now" button
 *
 * @example
 * <TimestampConverter title="Unix Timestamp Converter" />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

interface Props {
  title?: string;
}

const { title = t("tools.timestampConverter.title") } = Astro.props;
const uniqueId = `ts-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

/** Translations passed to the inline script via define:vars. */
const i18n = {
  local: t("tools.timestampConverter.local"),
  invalidTimestamp: t("tools.timestampConverter.invalidTimestamp"),
  autoDetectedAsSeconds: t("tools.timestampConverter.autoDetectedAs").replace(
    "{unit}",
    () => t("tools.timestampConverter.seconds").toLowerCase(),
  ),
  autoDetectedAsMilliseconds: t(
    "tools.timestampConverter.autoDetectedAs",
  ).replace("{unit}", () =>
    t("tools.timestampConverter.milliseconds").toLowerCase(),
  ),
  invalidDate: t("tools.timestampConverter.invalidDate"),
  year: t("tools.timestampConverter.year"),
  years: t("tools.timestampConverter.years"),
  month: t("tools.timestampConverter.month"),
  months: t("tools.timestampConverter.months"),
  day: t("tools.timestampConverter.day"),
  days: t("tools.timestampConverter.days"),
  hour: t("tools.timestampConverter.hour"),
  hours: t("tools.timestampConverter.hours"),
  minute: t("tools.timestampConverter.minute"),
  minutes: t("tools.timestampConverter.minutes"),
  second: t("tools.timestampConverter.second"),
  ago: t("tools.timestampConverter.ago"),
  fromNow: t("tools.timestampConverter.fromNow"),
  copied: t("tools.shared.copied"),
  shareLink: t("tools.shared.shareLink"),
  secondsRelative: t("tools.timestampConverter.seconds_relative"),
};
---

<div
  class="ts-converter"
  data-ts-id={uniqueId}
>
  {title && <div class="ts-title">{title}</div>}

  <div class="ts-layout">
    {/* Current time + Now button */}
    <div class="ts-current">
      <span
        class="i-mdi:clock-outline ts-current-icon"
        aria-hidden="true"
      ></span>
      <span>{t("tools.timestampConverter.currentTimestamp")}</span>
      <code
        class="ts-current-value"
        id={`${uniqueId}-current`}
        >—</code
      >
      <button
        type="button"
        class="ts-now-btn"
        aria-label={t("tools.timestampConverter.fillCurrentAriaLabel")}
      >
        <span
          class="i-mdi:clock-fast"
          aria-hidden="true"
        ></span>
        <span>{t("tools.timestampConverter.now")}</span>
      </button>
    </div>

    {/* Timestamp → Date */}
    <div class="ts-section">
      <div class="ts-section-header">
        <span
          class="i-mdi:arrow-right-bold"
          aria-hidden="true"
        ></span>
        <span>{t("tools.timestampConverter.timestampToDate")}</span>
      </div>
      <div class="ts-input-row">
        <input
          type="text"
          id={`${uniqueId}-ts-input`}
          class="ts-input"
          placeholder={t("tools.timestampConverter.inputPlaceholder")}
          spellcheck="false"
          autocomplete="off"
          aria-label={t("tools.timestampConverter.inputAriaLabel")}
          inputmode="numeric"
        />
        <div class="ts-unit-toggle">
          <button
            type="button"
            class="ts-unit-btn active"
            data-unit="auto"
            >{t("tools.timestampConverter.auto")}</button
          >
          <button
            type="button"
            class="ts-unit-btn"
            data-unit="s"
            >{t("tools.timestampConverter.seconds")}</button
          >
          <button
            type="button"
            class="ts-unit-btn"
            data-unit="ms"
            >{t("tools.timestampConverter.milliseconds")}</button
          >
        </div>
      </div>
      <div
        class="ts-detect-hint"
        id={`${uniqueId}-detect-hint`}
        aria-live="polite"
      >
      </div>
      <div
        class="ts-results"
        id={`${uniqueId}-ts-results`}
      >
        <div class="ts-result-item">
          <span class="ts-result-label"
            >{t("tools.timestampConverter.localTime")}</span
          >
          <div class="ts-result-with-copy">
            <code
              class="ts-result-value"
              id={`${uniqueId}-local`}
              >—</code
            >
            <button
              type="button"
              class="ts-copy-btn"
              data-target-id={`${uniqueId}-local`}
              aria-label={t("tools.timestampConverter.copyLocalTime")}
            >
              <span class="i-mdi:content-copy"></span>
            </button>
          </div>
        </div>
        <div class="ts-result-item">
          <span class="ts-result-label"
            >{t("tools.timestampConverter.utcIso8601")}</span
          >
          <div class="ts-result-with-copy">
            <code
              class="ts-result-value"
              id={`${uniqueId}-utc`}
              >—</code
            >
            <button
              type="button"
              class="ts-copy-btn"
              data-target-id={`${uniqueId}-utc`}
              aria-label={t("tools.timestampConverter.copyUtcTime")}
            >
              <span class="i-mdi:content-copy"></span>
            </button>
          </div>
        </div>
        <div class="ts-result-item">
          <span class="ts-result-label"
            >{t("tools.timestampConverter.rfc2822")}</span
          >
          <div class="ts-result-with-copy">
            <code
              class="ts-result-value"
              id={`${uniqueId}-rfc`}
              >—</code
            >
            <button
              type="button"
              class="ts-copy-btn"
              data-target-id={`${uniqueId}-rfc`}
              aria-label={t("tools.timestampConverter.copyRfc2822")}
            >
              <span class="i-mdi:content-copy"></span>
            </button>
          </div>
        </div>
        <div class="ts-result-item">
          <span class="ts-result-label"
            >{t("tools.timestampConverter.shortDate")}</span
          >
          <div class="ts-result-with-copy">
            <code
              class="ts-result-value"
              id={`${uniqueId}-short`}
              >—</code
            >
            <button
              type="button"
              class="ts-copy-btn"
              data-target-id={`${uniqueId}-short`}
              aria-label={t("tools.timestampConverter.copyShortDate")}
            >
              <span class="i-mdi:content-copy"></span>
            </button>
          </div>
        </div>
        <div class="ts-result-item">
          <span class="ts-result-label"
            >{t("tools.timestampConverter.relative")}</span
          >
          <code
            class="ts-result-value"
            id={`${uniqueId}-relative`}
            >—</code
          >
        </div>
        <div class="ts-result-item">
          <span class="ts-result-label"
            >{t("tools.timestampConverter.dayOfWeek")}</span
          >
          <code
            class="ts-result-value"
            id={`${uniqueId}-dow`}
            >—</code
          >
        </div>
        <div class="ts-result-item">
          <span class="ts-result-label"
            >{t("tools.timestampConverter.weekNumber")}</span
          >
          <code
            class="ts-result-value"
            id={`${uniqueId}-week`}
            >—</code
          >
        </div>
        <div class="ts-result-item">
          <span class="ts-result-label"
            >{t("tools.timestampConverter.dayOfYear")}</span
          >
          <code
            class="ts-result-value"
            id={`${uniqueId}-doy`}
            >—</code
          >
        </div>
      </div>
    </div>

    {/* Date → Timestamp */}
    <div class="ts-section">
      <div class="ts-section-header">
        <span
          class="i-mdi:arrow-left-bold"
          aria-hidden="true"
        ></span>
        <span>{t("tools.timestampConverter.dateToTimestamp")}</span>
      </div>
      <div class="ts-date-inputs">
        <div class="ts-date-field">
          <label for={`${uniqueId}-date`}
            >{t("tools.timestampConverter.date")}</label
          >
          <input
            type="date"
            id={`${uniqueId}-date`}
            class="ts-input"
          />
        </div>
        <div class="ts-date-field">
          <label for={`${uniqueId}-time`}
            >{t("tools.timestampConverter.time")}</label
          >
          <input
            type="time"
            id={`${uniqueId}-time`}
            class="ts-input"
            step="1"
          />
        </div>
      </div>
      <div class="ts-results">
        <div class="ts-result-item">
          <span class="ts-result-label"
            >{t("tools.timestampConverter.unixSeconds")}</span
          >
          <div class="ts-result-with-copy">
            <code
              class="ts-result-value"
              id={`${uniqueId}-unix-s`}
              >—</code
            >
            <button
              type="button"
              class="ts-copy-btn"
              data-target-id={`${uniqueId}-unix-s`}
              aria-label={t("tools.timestampConverter.copySecondsTimestamp")}
            >
              <span class="i-mdi:content-copy"></span>
            </button>
          </div>
        </div>
        <div class="ts-result-item">
          <span class="ts-result-label"
            >{t("tools.timestampConverter.unixMilliseconds")}</span
          >
          <div class="ts-result-with-copy">
            <code
              class="ts-result-value"
              id={`${uniqueId}-unix-ms`}
              >—</code
            >
            <button
              type="button"
              class="ts-copy-btn"
              data-target-id={`${uniqueId}-unix-ms`}
              aria-label={t(
                "tools.timestampConverter.copyMillisecondsTimestamp",
              )}
            >
              <span class="i-mdi:content-copy"></span>
            </button>
          </div>
        </div>
        <div class="ts-result-item">
          <span class="ts-result-label"
            >{t("tools.timestampConverter.iso8601")}</span
          >
          <div class="ts-result-with-copy">
            <code
              class="ts-result-value"
              id={`${uniqueId}-iso`}
              >—</code
            >
            <button
              type="button"
              class="ts-copy-btn"
              data-target-id={`${uniqueId}-iso`}
              aria-label={t("tools.timestampConverter.copyIsoTimestamp")}
            >
              <span class="i-mdi:content-copy"></span>
            </button>
          </div>
        </div>
        <div class="ts-result-item">
          <span class="ts-result-label"
            >{t("tools.timestampConverter.rfc2822")}</span
          >
          <div class="ts-result-with-copy">
            <code
              class="ts-result-value"
              id={`${uniqueId}-rfc2`}
              >—</code
            >
            <button
              type="button"
              class="ts-copy-btn"
              data-target-id={`${uniqueId}-rfc2`}
              aria-label={t("tools.timestampConverter.copyRfc2822")}
            >
              <span class="i-mdi:content-copy"></span>
            </button>
          </div>
        </div>
      </div>
    </div>

    {/* Timezone Comparison */}
    <div class="ts-section">
      <div class="ts-section-header">
        <span
          class="i-mdi:earth"
          aria-hidden="true"
        ></span>
        <span>{t("tools.timestampConverter.timezoneComparison")}</span>
      </div>
      <div class="ts-tz-wrap">
        <table
          class="ts-tz-table"
          aria-label={t("tools.timestampConverter.timezoneTableAriaLabel")}
        >
          <thead>
            <tr>
              <th scope="col">{t("tools.timestampConverter.thCity")}</th>
              <th scope="col">{t("tools.timestampConverter.thDateTime")}</th>
              <th scope="col">{t("tools.timestampConverter.thZone")}</th>
            </tr>
          </thead>
          <tbody id={`${uniqueId}-tz-body`}></tbody>
        </table>
      </div>
    </div>

    {/* Actions */}
    <div class="ts-actions">
      <button
        type="button"
        class="ts-share-btn"
        aria-label={t("tools.timestampConverter.copyShareableLink")}
      >
        <span
          class="i-mdi:share-variant"
          aria-hidden="true"
        ></span>
        <span class="ts-share-text">{t("tools.shared.shareLink")}</span>
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ uniqueId, i18n }}>
  (function () {
    var container = document.querySelector('[data-ts-id="' + uniqueId + '"]');
    if (!container) return;

    /* ── Element references ── */
    var currentEl = document.getElementById(uniqueId + "-current");
    var tsInput = document.getElementById(uniqueId + "-ts-input");
    var detectHint = document.getElementById(uniqueId + "-detect-hint");
    var localEl = document.getElementById(uniqueId + "-local");
    var utcEl = document.getElementById(uniqueId + "-utc");
    var rfcEl = document.getElementById(uniqueId + "-rfc");
    var shortEl = document.getElementById(uniqueId + "-short");
    var relativeEl = document.getElementById(uniqueId + "-relative");
    var dowEl = document.getElementById(uniqueId + "-dow");
    var weekEl = document.getElementById(uniqueId + "-week");
    var doyEl = document.getElementById(uniqueId + "-doy");
    var dateInput = document.getElementById(uniqueId + "-date");
    var timeInput = document.getElementById(uniqueId + "-time");
    var unixS = document.getElementById(uniqueId + "-unix-s");
    var unixMs = document.getElementById(uniqueId + "-unix-ms");
    var isoEl = document.getElementById(uniqueId + "-iso");
    var rfc2El = document.getElementById(uniqueId + "-rfc2");
    var tzBody = document.getElementById(uniqueId + "-tz-body");
    var unitBtns = container.querySelectorAll(".ts-unit-btn");
    var copyBtns = container.querySelectorAll(".ts-copy-btn");
    var nowBtn = container.querySelector(".ts-now-btn");
    var shareBtn = container.querySelector(".ts-share-btn");
    var shareText = container.querySelector(".ts-share-text");

    var unit = "auto";
    var syncing = false;
    var currentDate = null;
    var dayNames = [
      "Sunday",
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
    ];
    var dayAbbr = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    var monthAbbr = [
      "Jan",
      "Feb",
      "Mar",
      "Apr",
      "May",
      "Jun",
      "Jul",
      "Aug",
      "Sep",
      "Oct",
      "Nov",
      "Dec",
    ];

    /* ── Timezone list ── */
    var tzList = [
      { tz: "local", label: i18n.local },
      { tz: "UTC", label: "UTC" },
      { tz: "America/New_York", label: "New York" },
      { tz: "America/Los_Angeles", label: "Los Angeles" },
      { tz: "America/Chicago", label: "Chicago" },
      { tz: "Europe/London", label: "London" },
      { tz: "Europe/Berlin", label: "Berlin" },
      { tz: "Asia/Tokyo", label: "Tokyo" },
      { tz: "Asia/Shanghai", label: "Shanghai" },
      { tz: "Asia/Kolkata", label: "Kolkata" },
      { tz: "Australia/Sydney", label: "Sydney" },
    ];

    var localTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    var tzRows = [];

    /* Build timezone table rows */
    tzList.forEach(function (item) {
      var tr = document.createElement("tr");
      var tdCity = document.createElement("td");
      if (item.tz === "local") {
        var cityName = localTz.split("/").pop().replace(/_/g, " ");
        tdCity.textContent = item.label + " (" + cityName + ")";
        tr.className = "ts-tz-local";
      } else {
        tdCity.textContent = item.label;
      }
      var tdTime = document.createElement("td");
      tdTime.className = "ts-tz-time";
      tdTime.textContent = "\u2014";
      var tdZone = document.createElement("td");
      tdZone.className = "ts-tz-zone";
      tdZone.textContent = "\u2014";
      tr.appendChild(tdCity);
      tr.appendChild(tdTime);
      tr.appendChild(tdZone);
      tzBody.appendChild(tr);
      tzRows.push({ tz: item.tz, time: tdTime, zone: tdZone });
    });

    /* ── URL params ── */
    var params = new URLSearchParams(window.location.search);
    var urlTs = params.get("ts");
    var urlUnit = params.get("unit");

    /* ── Helpers ── */
    function pad2(n) {
      return String(n).padStart(2, "0");
    }

    function autoDetect(val) {
      var num = parseInt(val, 10);
      if (isNaN(num)) return "s";
      return Math.abs(num) > 9999999999 ? "ms" : "s";
    }

    function getEffectiveUnit(val) {
      if (unit !== "auto") return unit;
      return autoDetect(val);
    }

    function isLeapYear(year) {
      return (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
    }

    function toRFC2822(date) {
      var d = dayAbbr[date.getDay()];
      var day = pad2(date.getDate());
      var mon = monthAbbr[date.getMonth()];
      var year = date.getFullYear();
      var time =
        pad2(date.getHours()) +
        ":" +
        pad2(date.getMinutes()) +
        ":" +
        pad2(date.getSeconds());
      var offset = date.getTimezoneOffset();
      var sign = offset <= 0 ? "+" : "-";
      var offH = pad2(Math.floor(Math.abs(offset) / 60));
      var offM = pad2(Math.abs(offset) % 60);
      return (
        d +
        ", " +
        day +
        " " +
        mon +
        " " +
        year +
        " " +
        time +
        " " +
        sign +
        offH +
        offM
      );
    }

    function getWeekNumber(date) {
      var d = new Date(
        Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()),
      );
      var dayNum = d.getUTCDay() || 7;
      d.setUTCDate(d.getUTCDate() + 4 - dayNum);
      var yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
      return Math.ceil(((d - yearStart) / 86400000 + 1) / 7);
    }

    function getDayOfYear(date) {
      var start = new Date(date.getFullYear(), 0, 0);
      return Math.floor((date - start) / 86400000);
    }

    function formatRelative(date) {
      var diff = date.getTime() - Date.now();
      var absDiff = Math.abs(diff);
      var isPast = diff < 0;
      var secs = Math.floor(absDiff / 1000);
      var mins = Math.floor(secs / 60);
      var hours = Math.floor(mins / 60);
      var daysDiff = Math.floor(hours / 24);
      var months = Math.floor(daysDiff / 30.44);
      var years = Math.floor(daysDiff / 365.25);

      var str;
      if (years > 0) str = years + " " + (years > 1 ? i18n.years : i18n.year);
      else if (months > 0)
        str = months + " " + (months > 1 ? i18n.months : i18n.month);
      else if (daysDiff > 0)
        str = daysDiff + " " + (daysDiff > 1 ? i18n.days : i18n.day);
      else if (hours > 0)
        str = hours + " " + (hours > 1 ? i18n.hours : i18n.hour);
      else if (mins > 0)
        str = mins + " " + (mins > 1 ? i18n.minutes : i18n.minute);
      else str = secs + " " + (secs !== 1 ? i18n.secondsRelative : i18n.second);

      var template = isPast ? i18n.ago : i18n.fromNow;
      return template.replace("{time}", str);
    }

    function formatInTz(date, tz) {
      var opts = {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
      };
      if (tz && tz !== "local") opts.timeZone = tz;
      try {
        var parts = new Intl.DateTimeFormat("en-CA", opts).formatToParts(date);
        var find = function (type) {
          var p = parts.find(function (x) {
            return x.type === type;
          });
          return p ? p.value : "";
        };
        var h = find("hour");
        if (h === "24") h = "00";
        return (
          find("year") +
          "-" +
          find("month") +
          "-" +
          find("day") +
          " " +
          h +
          ":" +
          find("minute") +
          ":" +
          find("second")
        );
      } catch (e) {
        return "\u2014";
      }
    }

    function getTzAbbr(date, tz) {
      if (tz === "UTC") return "UTC";
      var opts = { timeZoneName: "short" };
      if (tz && tz !== "local") opts.timeZone = tz;
      try {
        var parts = new Intl.DateTimeFormat("en", opts).formatToParts(date);
        var p = parts.find(function (x) {
          return x.type === "timeZoneName";
        });
        return p ? p.value : "";
      } catch (e) {
        return "";
      }
    }

    /* ── Core update ── */
    function clearAll() {
      var dashes = [
        localEl,
        utcEl,
        rfcEl,
        shortEl,
        relativeEl,
        dowEl,
        weekEl,
        doyEl,
        unixS,
        unixMs,
        isoEl,
        rfc2El,
      ];
      dashes.forEach(function (el) {
        if (el) el.textContent = "\u2014";
      });
      tzRows.forEach(function (r) {
        r.time.textContent = "\u2014";
        r.zone.textContent = "\u2014";
      });
      if (detectHint) detectHint.textContent = "";
      currentDate = null;
    }

    function updateOutputs(date) {
      if (!date || isNaN(date.getTime())) {
        clearAll();
        return;
      }
      currentDate = date;

      /* Timestamp → Date results */
      if (localEl) localEl.textContent = date.toLocaleString();
      if (utcEl) utcEl.textContent = date.toISOString();
      if (rfcEl) rfcEl.textContent = toRFC2822(date);
      if (shortEl) shortEl.textContent = date.toISOString().slice(0, 10);
      if (relativeEl) relativeEl.textContent = formatRelative(date);
      if (dowEl) dowEl.textContent = dayNames[date.getDay()];
      if (weekEl) weekEl.textContent = "W" + pad2(getWeekNumber(date));
      if (doyEl)
        doyEl.textContent =
          getDayOfYear(date) +
          " / " +
          (isLeapYear(date.getFullYear()) ? "366" : "365");

      /* Date → Timestamp results */
      var s = Math.floor(date.getTime() / 1000);
      var ms = date.getTime();
      if (unixS) unixS.textContent = String(s);
      if (unixMs) unixMs.textContent = String(ms);
      if (isoEl) isoEl.textContent = date.toISOString();
      if (rfc2El) rfc2El.textContent = toRFC2822(date);

      /* Timezone table */
      tzRows.forEach(function (r) {
        r.time.textContent = formatInTz(date, r.tz);
        r.zone.textContent = getTzAbbr(date, r.tz);
      });

      /* URL update */
      updateUrl(s);
    }

    function updateUrl(ts) {
      var u = unit === "auto" ? "" : "&unit=" + unit;
      var newUrl = window.location.pathname + "?ts=" + ts + u;
      history.replaceState(null, "", newUrl);
    }

    /* ── Sync functions ── */
    function syncFromTimestamp() {
      if (syncing) return;
      syncing = true;

      var val = tsInput ? tsInput.value.trim() : "";
      if (!val) {
        clearAll();
        syncing = false;
        return;
      }

      var num = parseFloat(val);
      if (isNaN(num) || !isFinite(num)) {
        if (localEl) localEl.textContent = i18n.invalidTimestamp;
        syncing = false;
        return;
      }
      num = Math.floor(num);

      var eff = getEffectiveUnit(val);
      var ms = eff === "ms" ? num : num * 1000;
      var date = new Date(ms);

      /* Auto-detect hint */
      if (detectHint) {
        detectHint.textContent =
          unit === "auto"
            ? eff === "ms"
              ? i18n.autoDetectedAsMilliseconds
              : i18n.autoDetectedAsSeconds
            : "";
      }

      if (isNaN(date.getTime())) {
        if (localEl) localEl.textContent = i18n.invalidDate;
        syncing = false;
        return;
      }

      /* Sync date picker */
      if (dateInput) dateInput.value = date.toISOString().slice(0, 10);
      if (timeInput)
        timeInput.value =
          pad2(date.getHours()) +
          ":" +
          pad2(date.getMinutes()) +
          ":" +
          pad2(date.getSeconds());

      updateOutputs(date);
      syncing = false;
    }

    function syncFromDate() {
      if (syncing) return;
      syncing = true;

      if (!dateInput || !dateInput.value) {
        syncing = false;
        return;
      }

      var dateStr = dateInput.value;
      var timeStr = timeInput && timeInput.value ? timeInput.value : "00:00:00";
      var date = new Date(dateStr + "T" + timeStr);

      if (isNaN(date.getTime())) {
        if (unixS) unixS.textContent = i18n.invalidDate;
        syncing = false;
        return;
      }

      /* Sync timestamp input */
      var s = Math.floor(date.getTime() / 1000);
      if (tsInput) tsInput.value = String(s);
      if (detectHint) detectHint.textContent = "";

      updateOutputs(date);
      syncing = false;
    }

    /* ── Live clock ── */
    function updateCurrent() {
      if (currentEl)
        currentEl.textContent = String(Math.floor(Date.now() / 1000));
    }
    setInterval(updateCurrent, 1000);
    updateCurrent();

    /* Refresh relative time every 30 s */
    setInterval(function () {
      if (currentDate && relativeEl) {
        relativeEl.textContent = formatRelative(currentDate);
      }
    }, 30000);

    /* ── Now button ── */
    if (nowBtn) {
      nowBtn.addEventListener("click", function () {
        var now = Math.floor(Date.now() / 1000);
        if (tsInput) tsInput.value = String(now);
        syncFromTimestamp();
      });
    }

    /* ── Unit toggle ── */
    unitBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        unitBtns.forEach(function (b) {
          b.classList.remove("active");
        });
        btn.classList.add("active");
        unit = btn.dataset.unit;
        syncFromTimestamp();
      });
    });

    /* ── Inputs ── */
    if (tsInput) {
      var timeout;
      tsInput.addEventListener("input", function () {
        clearTimeout(timeout);
        timeout = setTimeout(syncFromTimestamp, 150);
      });
    }

    if (dateInput) {
      dateInput.addEventListener("change", syncFromDate);
      dateInput.addEventListener("input", syncFromDate);
    }
    if (timeInput) {
      timeInput.addEventListener("change", syncFromDate);
      timeInput.addEventListener("input", syncFromDate);
    }

    /* ── Copy buttons ── */
    copyBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var target = document.getElementById(btn.dataset.targetId);
        if (
          target &&
          target.textContent &&
          target.textContent !== "\u2014" &&
          navigator.clipboard
        ) {
          navigator.clipboard
            .writeText(target.textContent)
            .then(function () {
              btn.classList.add("copied");
              setTimeout(function () {
                btn.classList.remove("copied");
              }, 1500);
            })
            .catch(function () {});
        }
      });
    });

    /* ── Share button ── */
    if (shareBtn) {
      shareBtn.addEventListener("click", function () {
        if (navigator.clipboard) {
          navigator.clipboard
            .writeText(window.location.href)
            .then(function () {
              shareBtn.classList.add("copied");
              if (shareText) shareText.textContent = i18n.copied;
              setTimeout(function () {
                shareBtn.classList.remove("copied");
                if (shareText) shareText.textContent = i18n.shareLink;
              }, 1500);
            })
            .catch(function () {});
        }
      });
    }

    /* ── Initialize ── */
    if (urlTs) {
      if (tsInput) tsInput.value = urlTs;
      if (
        urlUnit &&
        (urlUnit === "s" || urlUnit === "ms" || urlUnit === "auto")
      ) {
        unit = urlUnit;
        unitBtns.forEach(function (b) {
          b.classList.remove("active");
          if (b.dataset.unit === unit) b.classList.add("active");
        });
      }
      syncFromTimestamp();
    } else {
      var now = new Date();
      if (tsInput) tsInput.value = String(Math.floor(now.getTime() / 1000));
      syncFromTimestamp();
    }
  })();
</script>

