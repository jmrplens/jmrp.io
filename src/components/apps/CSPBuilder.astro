---
/**
 * CSPBuilder Component
 * Interactive CSP policy builder with checkboxes for directives.
 * Supports multiple export formats, presets, editable values, and security warnings.
 *
 * Features:
 * - 20+ CSP directives organized by category
 * - Editable values for custom domains
 * - Quick presets for common integrations (Google, YouTube, CDNs)
 * - Multiple export formats (Header, Nginx, Apache, Cloudflare, Netlify, Vercel)
 * - Report-Only mode toggle
 * - Security warnings and best practices
 *
 * Usage:
 * <CSPBuilder title="Build Your CSP" />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

interface Directive {
  name: string;
  value: string;
  description: string;
  category: "essential" | "security" | "resources" | "advanced";
  defaultChecked?: boolean;
  requiredForStrict?: boolean;
  editable?: boolean;
  notInMeta?: boolean;
  deprecated?: boolean;
}

interface Preset {
  id: string;
  label: string;
  icon: string;
  description: string;
  additions: Record<string, string[]>;
}

interface Props {
  title?: string;
}

const { title = t("tools.cspBuilder.title") } = Astro.props;

// Generate unique ID for this instance
const uniqueId = `csp-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

const directives: Directive[] = [
  // Essential / Core
  {
    name: "default-src",
    value: "'none'",
    description: t("tools.cspBuilder.descDefaultSrc"),
    category: "essential",
    defaultChecked: true,
    requiredForStrict: true,
  },
  {
    name: "script-src",
    value: "'self' 'nonce-{RANDOM}'",
    description: t("tools.cspBuilder.descScriptSrc"),
    category: "essential",
    defaultChecked: true,
    requiredForStrict: true,
    editable: true,
  },
  {
    name: "style-src",
    value: "'self' 'unsafe-inline'",
    description: t("tools.cspBuilder.descStyleSrc"),
    category: "essential",
    defaultChecked: true,
    editable: true,
  },

  // Security Hardening
  {
    name: "object-src",
    value: "'none'",
    description: t("tools.cspBuilder.descObjectSrc"),
    category: "security",
    defaultChecked: true,
    requiredForStrict: true,
  },
  {
    name: "base-uri",
    value: "'none'",
    description: t("tools.cspBuilder.descBaseUri"),
    category: "security",
    defaultChecked: true,
    requiredForStrict: true,
  },
  {
    name: "frame-ancestors",
    value: "'none'",
    description: t("tools.cspBuilder.descFrameAncestors"),
    category: "security",
    defaultChecked: true,
    notInMeta: true,
  },
  {
    name: "form-action",
    value: "'self'",
    description: t("tools.cspBuilder.descFormAction"),
    category: "security",
    defaultChecked: false,
  },
  {
    name: "frame-src",
    value: "'self'",
    description: t("tools.cspBuilder.descFrameSrc"),
    category: "security",
    defaultChecked: false,
    editable: true,
  },
  {
    name: "sandbox",
    value: "allow-scripts allow-same-origin",
    description: t("tools.cspBuilder.descSandbox"),
    category: "security",
    defaultChecked: false,
    notInMeta: true,
  },

  // Resource Loading
  {
    name: "img-src",
    value: "'self' data:",
    description: t("tools.cspBuilder.descImgSrc"),
    category: "resources",
    defaultChecked: true,
    editable: true,
  },
  {
    name: "font-src",
    value: "'self'",
    description: t("tools.cspBuilder.descFontSrc"),
    category: "resources",
    defaultChecked: true,
    editable: true,
  },
  {
    name: "connect-src",
    value: "'self'",
    description: t("tools.cspBuilder.descConnectSrc"),
    category: "resources",
    defaultChecked: true,
    editable: true,
  },
  {
    name: "media-src",
    value: "'self'",
    description: t("tools.cspBuilder.descMediaSrc"),
    category: "resources",
    defaultChecked: false,
    editable: true,
  },
  {
    name: "worker-src",
    value: "'self'",
    description: t("tools.cspBuilder.descWorkerSrc"),
    category: "resources",
    defaultChecked: false,
  },
  {
    name: "child-src",
    value: "'self'",
    description: t("tools.cspBuilder.descChildSrc"),
    category: "resources",
    defaultChecked: false,
    editable: true,
  },
  {
    name: "manifest-src",
    value: "'self'",
    description: t("tools.cspBuilder.descManifestSrc"),
    category: "resources",
    defaultChecked: false,
  },

  // Advanced
  {
    name: "strict-dynamic",
    value: "",
    description: t("tools.cspBuilder.descStrictDynamic"),
    category: "advanced",
    defaultChecked: false,
  },
  {
    name: "upgrade-insecure-requests",
    value: "",
    description: t("tools.cspBuilder.descUpgradeInsecureRequests"),
    category: "advanced",
    defaultChecked: true,
  },
  {
    name: "block-all-mixed-content",
    value: "",
    description: t("tools.cspBuilder.descBlockAllMixedContent"),
    category: "advanced",
    defaultChecked: false,
    deprecated: true,
  },
  {
    name: "require-trusted-types-for",
    value: "'script'",
    description: t("tools.cspBuilder.descRequireTrustedTypes"),
    category: "advanced",
    defaultChecked: false,
  },
  {
    name: "report-to",
    value: "csp-endpoint",
    description: t("tools.cspBuilder.descReportTo"),
    category: "advanced",
    defaultChecked: false,
    notInMeta: true,
  },
  {
    name: "report-uri",
    value: "/csp-reports",
    description: t("tools.cspBuilder.descReportUri"),
    category: "advanced",
    defaultChecked: false,
    deprecated: true,
    notInMeta: true,
  },
];

const categories = [
  {
    id: "essential",
    label: t("tools.cspBuilder.categoryEssential"),
    icon: "i-mdi:lightning-bolt",
  },
  {
    id: "security",
    label: t("tools.cspBuilder.categorySecurity"),
    icon: "i-mdi:shield-check",
  },
  {
    id: "resources",
    label: t("tools.cspBuilder.categoryResources"),
    icon: "i-mdi:package-variant",
  },
  {
    id: "advanced",
    label: t("tools.cspBuilder.categoryAdvanced"),
    icon: "i-mdi:cog",
  },
];

const presets: Preset[] = [
  {
    id: "strict",
    label: t("tools.cspBuilder.presetStrictLabel"),
    icon: "i-mdi:shield-lock",
    description: t("tools.cspBuilder.presetStrictDesc"),
    additions: {},
  },
  {
    id: "google-fonts",
    label: t("tools.cspBuilder.presetGoogleFontsLabel"),
    icon: "i-mdi:format-font",
    description: t("tools.cspBuilder.presetGoogleFontsDesc"),
    additions: {
      "style-src": ["https://fonts.googleapis.com"],
      "font-src": ["https://fonts.gstatic.com"],
    },
  },
  {
    id: "google-analytics",
    label: t("tools.cspBuilder.presetAnalyticsLabel"),
    icon: "i-mdi:google-analytics",
    description: t("tools.cspBuilder.presetAnalyticsDesc"),
    additions: {
      "script-src": [
        "https://www.googletagmanager.com",
        "https://www.google-analytics.com",
      ],
      "connect-src": [
        "https://www.google-analytics.com",
        "https://analytics.google.com",
      ],
      "img-src": ["https://www.google-analytics.com"],
    },
  },
  {
    id: "youtube",
    label: t("tools.cspBuilder.presetYoutubeLabel"),
    icon: "i-mdi:youtube",
    description: t("tools.cspBuilder.presetYoutubeDesc"),
    additions: {
      "frame-src": [
        "https://www.youtube.com",
        "https://www.youtube-nocookie.com",
      ],
      "img-src": ["https://i.ytimg.com", "https://img.youtube.com"],
    },
  },
  {
    id: "cdns",
    label: t("tools.cspBuilder.presetCdnsLabel"),
    icon: "i-mdi:cloud",
    description: t("tools.cspBuilder.presetCdnsDesc"),
    additions: {
      "script-src": [
        "https://cdnjs.cloudflare.com",
        "https://unpkg.com",
        "https://cdn.jsdelivr.net",
      ],
      "style-src": [
        "https://cdnjs.cloudflare.com",
        "https://unpkg.com",
        "https://cdn.jsdelivr.net",
      ],
    },
  },
];

const exportFormats = [
  { id: "nginx", label: "Nginx", icon: "i-devicon:nginx" },
  { id: "apache", label: "Apache", icon: "i-devicon:apache" },
  { id: "header", label: "HTTP Header", icon: "i-mdi:web" },
  { id: "cloudflare", label: "Cloudflare", icon: "i-simple-icons:cloudflare" },
  { id: "netlify", label: "Netlify", icon: "i-simple-icons:netlify" },
  { id: "vercel", label: "Vercel", icon: "i-simple-icons:vercel" },
  { id: "meta", label: "Meta Tag", icon: "i-mdi:code-tags" },
];

// Group directives by category
const groupedDirectives = categories.map((cat) => ({
  ...cat,
  directives: directives.filter((d) => d.category === cat.id),
}));

/** Translations passed to the inline script via define:vars. */
const i18n = {
  copy: t("tools.shared.copy"),
  copied: t("tools.shared.copied"),
  noDirectivesSelected: t("tools.cspBuilder.noDirectivesSelected"),
  ratingAPlus: t("tools.cspBuilder.ratingAPlus"),
  ratingA: t("tools.cspBuilder.ratingA"),
  ratingB: t("tools.cspBuilder.ratingB"),
  ratingC: t("tools.cspBuilder.ratingC"),
  ratingD: t("tools.cspBuilder.ratingD"),
  warnStyleNonce: t("tools.cspBuilder.warnStyleNonce"),
  warnFrameAncestorsMeta: t("tools.cspBuilder.warnFrameAncestorsMeta"),
  warnSandboxMeta: t("tools.cspBuilder.warnSandboxMeta"),
  warnReportOnlyMeta: t("tools.cspBuilder.warnReportOnlyMeta"),
  warnReportUriDeprecated: t("tools.cspBuilder.warnReportUriDeprecated"),
  warnBlockMixedContentDeprecated: t(
    "tools.cspBuilder.warnBlockMixedContentDeprecated",
  ),
  warnNoDefaultSrc: t("tools.cspBuilder.warnNoDefaultSrc"),
};
---

<div
  class="csp-builder"
  data-csp-id={uniqueId}
  data-directives={JSON.stringify(directives)}
  data-presets={JSON.stringify(presets)}
>
  {title && <div class="csp-title">{title}</div>}

  {/* Top Bar: Reset + Report-Only Toggle */}
  <div class="csp-topbar">
    <button
      type="button"
      class="csp-reset-btn"
      aria-label={t("tools.cspBuilder.resetAriaLabel")}
    >
      <span class="i-mdi:refresh csp-reset-icon"></span>
      {t("tools.cspBuilder.reset")}
    </button>
    <label class="csp-report-only-toggle">
      <input
        type="checkbox"
        class="csp-report-only-checkbox"
        id={`${uniqueId}-report-only`}
      />
      <span class="csp-toggle-track">
        <span class="csp-toggle-thumb"></span>
      </span>
      <span class="csp-toggle-label"
        >{t("tools.cspBuilder.reportOnlyMode")}</span
      >
    </label>
  </div>

  {/* Quick Presets */}
  <div class="csp-presets">
    <div class="csp-presets-header">
      <span class="i-mdi:flash csp-presets-icon"></span>
      <span>{t("tools.cspBuilder.quickPresets")}</span>
    </div>
    <div class="csp-presets-grid">
      {
        presets.map((preset) => (
          <button
            type="button"
            class="csp-preset-btn"
            data-preset={preset.id}
            title={preset.description}
          >
            <span class={preset.icon} />
            <span>{preset.label}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="csp-layout">
    {/* Directive Selection */}
    <div class="csp-directives">
      {
        groupedDirectives.map((group) => (
          <div class="csp-category">
            {group.id === "essential" ? (
              /* Core directives always visible */
              <>
                <div class="csp-category-header">
                  <span class={`csp-category-icon ${group.icon}`} />
                  <span class="csp-category-label">{group.label}</span>
                </div>
                <div class="csp-items">
                  {group.directives.map((directive) => {
                    const inputId = `${uniqueId}-${directive.name}`;
                    return (
                      <div class="csp-item-wrapper">
                        <div class="csp-item">
                          <input
                            type="checkbox"
                            id={inputId}
                            class="csp-checkbox"
                            checked={directive.defaultChecked}
                            data-directive={directive.name}
                            data-value={directive.value}
                            data-default={
                              directive.defaultChecked ? "true" : "false"
                            }
                            data-editable={
                              directive.editable ? "true" : "false"
                            }
                            data-not-in-meta={
                              directive.notInMeta ? "true" : "false"
                            }
                            aria-label={`${directive.name}: ${directive.description}`}
                          />
                          <span class="csp-item-check">
                            <span class="csp-check-icon">✓</span>
                          </span>
                          <span class="csp-item-content">
                            <span class="csp-directive-header">
                              <code class="csp-directive-name">
                                {directive.name}
                              </code>
                              {directive.requiredForStrict && (
                                <span
                                  class="csp-badge csp-strict-badge"
                                  title={t("tools.cspBuilder.badgeStrictTitle")}
                                >
                                  {t("tools.cspBuilder.badgeStrict")}
                                </span>
                              )}
                              {directive.deprecated && (
                                <span
                                  class="csp-badge csp-deprecated-badge"
                                  title={t(
                                    "tools.cspBuilder.badgeDeprecatedTitle",
                                  )}
                                >
                                  {t("tools.cspBuilder.badgeDeprecated")}
                                </span>
                              )}
                              {directive.notInMeta && (
                                <span
                                  class="csp-badge csp-meta-badge"
                                  title={t("tools.cspBuilder.badgeNoMetaTitle")}
                                >
                                  {t("tools.cspBuilder.badgeNoMeta")}
                                </span>
                              )}
                              {directive.editable && (
                                <button
                                  type="button"
                                  class="csp-edit-btn"
                                  data-for={directive.name}
                                  aria-label={t(
                                    "tools.cspBuilder.addCustomDomainsAriaLabel",
                                  )}
                                >
                                  <span class="i-mdi:plus-circle-outline" />
                                </button>
                              )}
                            </span>
                            <span class="csp-directive-desc">
                              {directive.description}
                            </span>
                            <code class="csp-directive-value">
                              {directive.value}
                            </code>
                          </span>
                        </div>
                        {directive.editable && (
                          <div
                            class="csp-custom-values"
                            data-for={directive.name}
                            hidden
                          >
                            <div class="csp-custom-input-row">
                              <input
                                type="text"
                                class="csp-custom-input"
                                placeholder={t(
                                  "tools.cspBuilder.addDomainPlaceholder",
                                )}
                                data-directive={directive.name}
                              />
                              <button
                                type="button"
                                class="csp-add-value-btn"
                                aria-label={t(
                                  "tools.cspBuilder.addDomainAriaLabel",
                                )}
                                data-directive={directive.name}
                              >
                                <span class="i-mdi:plus" />
                              </button>
                            </div>
                            <div
                              class="csp-custom-tags"
                              data-directive={directive.name}
                            />
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              </>
            ) : (
              /* Other categories are collapsible */
              <details
                class="csp-collapsible"
                open={group.id === "security"}
              >
                <summary class="csp-category-header csp-category-toggle">
                  <span class="csp-collapse-icon i-mdi:chevron-right" />
                  <span class={`csp-category-icon ${group.icon}`} />
                  <span class="csp-category-label">{group.label}</span>
                </summary>
                <div class="csp-items">
                  {group.directives.map((directive) => {
                    const inputId = `${uniqueId}-${directive.name}`;
                    return (
                      <div class="csp-item-wrapper">
                        <div class="csp-item">
                          <input
                            type="checkbox"
                            id={inputId}
                            class="csp-checkbox"
                            checked={directive.defaultChecked}
                            data-directive={directive.name}
                            data-value={directive.value}
                            data-default={
                              directive.defaultChecked ? "true" : "false"
                            }
                            data-editable={
                              directive.editable ? "true" : "false"
                            }
                            data-not-in-meta={
                              directive.notInMeta ? "true" : "false"
                            }
                            aria-label={`${directive.name}: ${directive.description}`}
                          />
                          <span class="csp-item-check">
                            <span class="csp-check-icon">✓</span>
                          </span>
                          <span class="csp-item-content">
                            <span class="csp-directive-header">
                              <code class="csp-directive-name">
                                {directive.name}
                              </code>
                              {directive.requiredForStrict && (
                                <span
                                  class="csp-badge csp-strict-badge"
                                  title={t("tools.cspBuilder.badgeStrictTitle")}
                                >
                                  {t("tools.cspBuilder.badgeStrict")}
                                </span>
                              )}
                              {directive.deprecated && (
                                <span
                                  class="csp-badge csp-deprecated-badge"
                                  title={t(
                                    "tools.cspBuilder.badgeDeprecatedTitle",
                                  )}
                                >
                                  {t("tools.cspBuilder.badgeDeprecated")}
                                </span>
                              )}
                              {directive.notInMeta && (
                                <span
                                  class="csp-badge csp-meta-badge"
                                  title={t("tools.cspBuilder.badgeNoMetaTitle")}
                                >
                                  {t("tools.cspBuilder.badgeNoMeta")}
                                </span>
                              )}
                              {directive.editable && (
                                <button
                                  type="button"
                                  class="csp-edit-btn"
                                  data-for={directive.name}
                                  aria-label={t(
                                    "tools.cspBuilder.addCustomDomainsAriaLabel",
                                  )}
                                >
                                  <span class="i-mdi:plus-circle-outline" />
                                </button>
                              )}
                            </span>
                            <span class="csp-directive-desc">
                              {directive.description}
                            </span>
                            <code class="csp-directive-value">
                              {directive.value}
                            </code>
                          </span>
                        </div>
                        {directive.editable && (
                          <div
                            class="csp-custom-values"
                            data-for={directive.name}
                            hidden
                          >
                            <div class="csp-custom-input-row">
                              <input
                                type="text"
                                class="csp-custom-input"
                                placeholder={t(
                                  "tools.cspBuilder.addDomainPlaceholder",
                                )}
                                data-directive={directive.name}
                              />
                              <button
                                type="button"
                                class="csp-add-value-btn"
                                aria-label={t(
                                  "tools.cspBuilder.addDomainAriaLabel",
                                )}
                                data-directive={directive.name}
                              >
                                <span class="i-mdi:plus" />
                              </button>
                            </div>
                            <div
                              class="csp-custom-tags"
                              data-directive={directive.name}
                            />
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              </details>
            )}
          </div>
        ))
      }
    </div>

    {/* Live Preview */}
    <div class="csp-preview">
      <div class="csp-preview-header">
        <span class="i-mdi:code-braces csp-preview-icon"></span>
        <span>{t("tools.cspBuilder.generatedPolicy")}</span>
      </div>

      {/* Export Format Selector */}
      <div class="csp-format-selector">
        <label
          for={`${uniqueId}-format`}
          class="csp-format-label"
          >{t("tools.cspBuilder.formatLabel")}</label
        >
        <select
          id={`${uniqueId}-format`}
          class="csp-format-select"
        >
          {
            exportFormats.map((format, idx) => (
              <option
                value={format.id}
                selected={idx === 0}
              >
                {format.label}
              </option>
            ))
          }
        </select>
      </div>

      <div class="csp-output-wrapper">
        {
          /* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- scrollable region requires keyboard access */
        }
        <pre
          class="csp-output"
          tabindex="0"><code id={`${uniqueId}-output`}>Content-Security-Policy: ...</code></pre>
        {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
        <button
          class="csp-copy-btn"
          type="button"
          aria-label={t("tools.cspBuilder.copyAriaLabel")}
        >
          <span class="i-mdi:content-copy"></span>
          <span class="csp-copy-text">{t("tools.shared.copy")}</span>
        </button>
      </div>

      <div class="csp-rating">
        <span class="csp-rating-label"
          >{t("tools.cspBuilder.securityLevel")}</span
        >
        <span
          class="csp-rating-badge"
          id={`${uniqueId}-rating`}
          >...</span
        >
      </div>

      {/* Warnings Section */}
      <div
        class="csp-warnings"
        id={`${uniqueId}-warnings`}
        hidden
      >
        <div class="csp-warnings-header">
          <span class="i-mdi:alert-circle-outline"></span>
          <span>{t("tools.cspBuilder.recommendations")}</span>
        </div>
        <ul class="csp-warnings-list"></ul>
      </div>

      <div class="csp-strict-info">
        <span class="i-mdi:information-outline csp-strict-info-icon"></span>
        <span
          set:html={t("tools.cspBuilder.strictInfoText")
            .replace(
              "{scriptSrcNonce}",
              `<strong>${t("tools.cspBuilder.scriptSrcNonce")}</strong>`,
            )
            .replace(
              "{objectSrcNone}",
              `<strong>${t("tools.cspBuilder.objectSrcNone")}</strong>`,
            )
            .replace(
              "{baseUriNone}",
              `<strong>${t("tools.cspBuilder.baseUriNone")}</strong>`,
            )}
        />
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ uniqueId, i18n }}>
  // CSP Builder interactive functionality
  (function () {
    const container = document.querySelector(`[data-csp-id="${uniqueId}"]`);
    if (!container) return;

    const checkboxes = container.querySelectorAll(".csp-checkbox");
    const output = document.getElementById(`${uniqueId}-output`);
    const rating = document.getElementById(`${uniqueId}-rating`);
    const warnings = document.getElementById(`${uniqueId}-warnings`);
    const warningsList = warnings?.querySelector(".csp-warnings-list");
    const copyBtn = container.querySelector(".csp-copy-btn");
    const resetBtn = container.querySelector(".csp-reset-btn");
    const formatSelect = document.getElementById(`${uniqueId}-format`);
    const reportOnlyCheckbox = document.getElementById(
      `${uniqueId}-report-only`,
    );
    const presetBtns = container.querySelectorAll(".csp-preset-btn");
    const editBtns = container.querySelectorAll(".csp-edit-btn");
    const addValueBtns = container.querySelectorAll(".csp-add-value-btn");

    // Get presets data with defensive parsing
    let presets = [];
    try {
      presets = JSON.parse(container.dataset.presets || "[]");
    } catch (e) {
      console.error("[CSPBuilder] Failed to parse presets data:", e);
      presets = [];
    }

    // Guard against missing elements
    if (!output || !rating) {
      console.error("[CSPBuilder] Missing output or rating element");
      return;
    }

    // Store custom values per directive
    const customValues = {};

    // Current export format (default: nginx)
    let currentFormat = "nginx";
    let isReportOnly = false;

    // Track active presets for toggling
    const activePresets = new Set();

    // Build the raw policy string
    function buildPolicy() {
      const parts = [];
      let hasNonce = false;
      let hasStrictDynamic = false;

      checkboxes.forEach((cb) => {
        if (cb.checked) {
          const name = cb.dataset.directive;
          let value = cb.dataset.value;

          // Handle strict-dynamic specially (adds to script-src)
          if (name === "strict-dynamic") {
            hasStrictDynamic = true;
            return;
          }

          // Track nonce usage
          if (name === "script-src" && value?.includes("nonce")) {
            hasNonce = true;
          }

          // Add custom values
          if (customValues[name] && customValues[name].length > 0) {
            value = value
              ? `${value} ${customValues[name].join(" ")}`
              : customValues[name].join(" ");
          }

          if (value) {
            parts.push(`${name} ${value}`);
          } else {
            parts.push(name);
          }
        }
      });

      // Add strict-dynamic to script-src if both are checked
      if (hasStrictDynamic && hasNonce) {
        const scriptIdx = parts.findIndex((p) => p.startsWith("script-src"));
        if (scriptIdx !== -1) {
          parts[scriptIdx] = parts[scriptIdx].replace(
            "'nonce-{RANDOM}'",
            "'nonce-{RANDOM}' 'strict-dynamic'",
          );
        }
      }

      return parts.join("; ");
    }

    // Get warnings based on current config
    function getWarnings() {
      const warns = [];
      const checkedDirectives = {};

      checkboxes.forEach((cb) => {
        if (cb.checked) {
          checkedDirectives[cb.dataset.directive] = cb.dataset.value;
        }
      });

      // Warning: unsafe-inline with nonce
      if (
        checkedDirectives["style-src"]?.includes("'unsafe-inline'") &&
        checkedDirectives["script-src"]?.includes("nonce")
      ) {
        warns.push({
          type: "info",
          text: i18n.warnStyleNonce,
        });
      }

      // Warning: frame-ancestors in meta
      if (currentFormat === "meta" && checkedDirectives["frame-ancestors"]) {
        warns.push({
          type: "warning",
          text: i18n.warnFrameAncestorsMeta,
        });
      }

      // Warning: sandbox in meta
      if (currentFormat === "meta" && checkedDirectives["sandbox"]) {
        warns.push({
          type: "warning",
          text: i18n.warnSandboxMeta,
        });
      }

      // Warning: Report-Only mode not supported for meta tags
      if (currentFormat === "meta" && isReportOnly) {
        warns.push({
          type: "warning",
          text: i18n.warnReportOnlyMeta,
        });
      }

      // Warning: deprecated directives
      if (checkedDirectives["report-uri"]) {
        warns.push({
          type: "info",
          text: i18n.warnReportUriDeprecated,
        });
      }

      if (checkedDirectives["block-all-mixed-content"]) {
        warns.push({
          type: "info",
          text: i18n.warnBlockMixedContentDeprecated,
        });
      }

      // Warning: no default-src
      if (!checkedDirectives["default-src"]) {
        warns.push({
          type: "warning",
          text: i18n.warnNoDefaultSrc,
        });
      }

      return warns;
    }

    // Update warnings display
    function updateWarnings() {
      if (!warnings || !warningsList) return;

      const warns = getWarnings();

      if (warns.length === 0) {
        warnings.hidden = true;
        return;
      }

      warnings.hidden = false;
      warningsList.textContent = "";
      warns.forEach((w) => {
        const li = document.createElement("li");
        li.className = `csp-warning-item csp-warning-${w.type}`;
        const icon = document.createElement("span");
        icon.className = `i-mdi:${w.type === "warning" ? "alert" : "information"}-outline`;
        li.appendChild(icon);
        li.appendChild(document.createTextNode(` ${w.text}`));
        warningsList.appendChild(li);
      });
    }

    // Calculate security score
    function calculateScore() {
      let score = 0;

      checkboxes.forEach((cb) => {
        if (cb.checked) {
          const name = cb.dataset.directive;
          const value = cb.dataset.value;

          if (name === "default-src" && value === "'none'") score += 15;
          if (name === "script-src" && value?.includes("nonce")) score += 20;
          if (name === "object-src" && value === "'none'") score += 15;
          if (name === "base-uri" && value === "'none'") score += 10;
          if (name === "frame-ancestors") score += 10;
          if (name === "form-action") score += 5;
          if (name === "upgrade-insecure-requests") score += 5;
          if (name === "connect-src") score += 5;
          if (name === "img-src") score += 3;
          if (name === "font-src") score += 3;
          if (name === "style-src") score += 3;
          if (name === "strict-dynamic") score += 15;
          if (name === "frame-src") score += 3;
          if (name === "require-trusted-types-for") score += 10;
        }
      });

      return score;
    }

    // Escape policy string for different output formats
    function escapeForFormat(str, format) {
      if (!str) return str;
      switch (format) {
        case "nginx":
        case "apache":
        case "netlify":
          // Escape backslashes and double quotes for shell/config files
          return str.replace(/\\/g, "\\\\").replace(/"/g, '\\"');
        case "vercel":
          // JSON escape (quotes and backslashes)
          return str.replace(/\\/g, "\\\\").replace(/"/g, '\\"');
        case "meta":
          // HTML attribute escape
          return str
            .replace(/&/g, "&amp;")
            .replace(/"/g, "&quot;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
        default:
          return str;
      }
    }

    // Format output based on selected format
    function formatOutput(policy) {
      if (!policy) return i18n.noDirectivesSelected;

      const headerName = isReportOnly
        ? "Content-Security-Policy-Report-Only"
        : "Content-Security-Policy";

      // For meta tag, filter out directives that don't work there
      let metaPolicy = policy;
      if (currentFormat === "meta") {
        metaPolicy = policy
          .split("; ")
          .filter((p) => {
            const directive = p.split(" ")[0];
            return ![
              "frame-ancestors",
              "sandbox",
              "report-uri",
              "report-to",
            ].includes(directive);
          })
          .join("; ");
      }

      // Escape policy for the current format
      const escapedPolicy = escapeForFormat(policy, currentFormat);
      const escapedMetaPolicy = escapeForFormat(metaPolicy, "meta");

      switch (currentFormat) {
        case "nginx":
          return `add_header ${headerName} "${escapedPolicy}" always;`;
        case "apache":
          return `Header always set ${headerName} "${escapedPolicy}"`;
        case "cloudflare":
          return `# _headers file
/*
  ${headerName}: ${escapedPolicy}`;
        case "netlify":
          return `# netlify.toml
[[headers]]
  for = "/*"
  [headers.values]
    ${headerName} = "${escapedPolicy}"`;
        case "vercel":
          return `// vercel.json
{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "${headerName}",
          "value": "${escapedPolicy}"
        }
      ]
    }
  ]
}`;
        case "meta":
          return `<meta http-equiv="Content-Security-Policy" content="${escapedMetaPolicy}">`;
        default:
          return `${headerName}: ${policy}`;
      }
    }

    function updatePolicy() {
      const policy = buildPolicy();
      const score = calculateScore();

      // Update output
      output.textContent = formatOutput(policy);

      // Determine rating
      let ratingText, ratingClass;
      if (score >= 85) {
        ratingText = i18n.ratingAPlus;
        ratingClass = "rating-a-plus";
      } else if (score >= 70) {
        ratingText = i18n.ratingA;
        ratingClass = "rating-a";
      } else if (score >= 50) {
        ratingText = i18n.ratingB;
        ratingClass = "rating-b";
      } else if (score >= 30) {
        ratingText = i18n.ratingC;
        ratingClass = "rating-c";
      } else {
        ratingText = i18n.ratingD;
        ratingClass = "rating-d";
      }

      rating.textContent = ratingText;
      rating.className = `csp-rating-badge ${ratingClass}`;

      // Update warnings
      updateWarnings();
    }

    // Add custom value to a directive
    function addCustomValue(directive, value) {
      if (!value || !value.trim()) return;

      value = value.trim();

      // CSP values that should NOT be prefixed with https://
      const isQuotedKeyword = value.startsWith("'") && value.endsWith("'"); // 'self', 'unsafe-inline', 'nonce-xxx'
      const isSchemeSource = /^[a-z][-a-z0-9+.]*:$/i.test(value); // data:, blob:, https:
      const hasScheme = value.includes("://"); // https://example.com
      const isWildcard = value.startsWith("*."); // *.example.com

      // Only prefix plain hostnames without scheme
      if (!isQuotedKeyword && !isSchemeSource && !hasScheme && !isWildcard) {
        // Match hostnames, IPv4 addresses, or bracketed IPv6 with optional port
        // Examples: example.com, example.com:8080, 192.168.1.1, 192.168.1.1:443, [::1], [::1]:8080
        const hostnamePattern =
          /^(?:[\w.-]+\.\w+|\d{1,3}(?:\.\d{1,3}){3}|\[[\da-f:]+\])(?::\d+)?$/i;
        if (hostnamePattern.test(value)) {
          value = `https://${value}`;
        }
      }

      if (!customValues[directive]) {
        customValues[directive] = [];
      }

      if (!customValues[directive].includes(value)) {
        customValues[directive].push(value);
        updateCustomTags(directive);
        updatePolicy();
      }
    }

    // Remove custom value
    function removeCustomValue(directive, value) {
      if (customValues[directive]) {
        customValues[directive] = customValues[directive].filter(
          (v) => v !== value,
        );
        updateCustomTags(directive);
        updatePolicy();
      }
    }

    // Update custom value tags display
    function updateCustomTags(directive) {
      const tagsContainer = container.querySelector(
        `.csp-custom-tags[data-directive="${directive}"]`,
      );
      if (!tagsContainer) return;

      // Clear existing content safely
      tagsContainer.textContent = "";

      const values = customValues[directive] || [];
      values.forEach((value) => {
        const span = document.createElement("span");
        span.className = "csp-custom-tag";

        const code = document.createElement("code");
        code.textContent = value;
        span.appendChild(code);

        const button = document.createElement("button");
        button.type = "button";
        button.className = "csp-remove-tag";
        button.dataset.directive = directive;
        button.dataset.value = value;

        const icon = document.createElement("span");
        icon.className = "i-mdi:close";
        button.appendChild(icon);

        span.appendChild(button);
        tagsContainer.appendChild(span);
      });

      // Add remove listeners
      tagsContainer.querySelectorAll(".csp-remove-tag").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          removeCustomValue(btn.dataset.directive, btn.dataset.value);
        });
      });
    }

    // Apply or remove a preset (toggle behavior)
    function togglePreset(presetId) {
      const preset = presets.find((p) => p.id === presetId);
      if (!preset) return;

      const isActive = activePresets.has(presetId);
      const btn = container.querySelector(`[data-preset="${presetId}"]`);

      if (isActive) {
        // Remove preset
        activePresets.delete(presetId);
        if (btn) btn.classList.remove("active");

        if (presetId === "strict") {
          // Reset strict-dynamic
          const strictDynamicCb = container.querySelector(
            '[data-directive="strict-dynamic"]',
          );
          if (strictDynamicCb) strictDynamicCb.checked = false;
        } else {
          // Remove only the values this preset added
          Object.entries(preset.additions).forEach(([directive, values]) => {
            values.forEach((value) => removeCustomValue(directive, value));
          });
        }
      } else {
        // Add preset
        activePresets.add(presetId);
        if (btn) btn.classList.add("active");

        if (presetId === "strict") {
          // For strict preset, enable required checkboxes
          checkboxes.forEach((cb) => {
            const name = cb.dataset.directive;
            if (
              ["default-src", "script-src", "object-src", "base-uri"].includes(
                name,
              )
            ) {
              cb.checked = true;
            }
            if (name === "strict-dynamic") {
              cb.checked = true;
            }
          });
        } else {
          // For other presets, add custom values and enable directives
          Object.entries(preset.additions).forEach(([directive, values]) => {
            // Enable the directive if not already
            const cb = container.querySelector(
              `[data-directive="${directive}"]`,
            );
            if (cb) {
              cb.checked = true;
              // Show custom values UI
              const customUI = container.querySelector(
                `.csp-custom-values[data-for="${directive}"]`,
              );
              if (customUI) customUI.hidden = false;
            }

            // Add custom values (avoiding duplicates is handled in addCustomValue)
            values.forEach((value) => addCustomValue(directive, value));
          });
        }
      }

      updatePolicy();
    }

    // Reset to defaults
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        checkboxes.forEach((cb) => {
          cb.checked = cb.dataset.default === "true";
        });
        // Clear custom values
        Object.keys(customValues).forEach((k) => {
          customValues[k] = [];
          updateCustomTags(k);
        });
        // Hide all custom UIs
        container.querySelectorAll(".csp-custom-values").forEach((el) => {
          el.hidden = true;
        });
        // Clear active presets
        activePresets.clear();
        container.querySelectorAll(".csp-preset-btn").forEach((btn) => {
          btn.classList.remove("active");
        });
        // Reset report-only
        if (reportOnlyCheckbox) {
          reportOnlyCheckbox.checked = false;
          isReportOnly = false;
        }
        updatePolicy();
      });
    }

    // Format selector
    if (formatSelect) {
      formatSelect.addEventListener("change", () => {
        currentFormat = formatSelect.value;
        updatePolicy();
      });
    }

    // Report-only toggle
    if (reportOnlyCheckbox) {
      reportOnlyCheckbox.addEventListener("change", () => {
        isReportOnly = reportOnlyCheckbox.checked;
        updatePolicy();
      });
    }

    // Preset buttons (toggle behavior)
    presetBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        togglePreset(btn.dataset.preset);
      });
    });

    // Edit buttons (toggle custom values UI)
    editBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const directive = btn.dataset.for;
        const customUI = container.querySelector(
          `.csp-custom-values[data-for="${directive}"]`,
        );
        if (customUI) {
          customUI.hidden = !customUI.hidden;
          if (!customUI.hidden) {
            customUI.querySelector("input")?.focus();
          }
        }
      });
    });

    // Add value buttons
    addValueBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const directive = btn.dataset.directive;
        const input = container.querySelector(
          `.csp-custom-input[data-directive="${directive}"]`,
        );
        if (input) {
          addCustomValue(directive, input.value);
          input.value = "";
        }
      });
    });

    // Enter key on custom inputs
    container.querySelectorAll(".csp-custom-input").forEach((input) => {
      input.addEventListener("keypress", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          addCustomValue(input.dataset.directive, input.value);
          input.value = "";
        }
      });
    });

    // Copy functionality
    if (copyBtn) {
      copyBtn.addEventListener("click", () => {
        const text = output.textContent;
        if (navigator.clipboard && text) {
          navigator.clipboard
            .writeText(text)
            .then(() => {
              copyBtn.classList.add("copied");
              const copyText = copyBtn.querySelector(".csp-copy-text");
              if (copyText) copyText.textContent = i18n.copied;
              setTimeout(() => {
                copyBtn.classList.remove("copied");
                if (copyText) copyText.textContent = i18n.copy;
              }, 2000);
            })
            .catch((err) => {
              console.error("[CSPBuilder] Clipboard write failed:", err);
              copyBtn.classList.add("error");
              setTimeout(() => copyBtn.classList.remove("error"), 2000);
            });
        }
      });
    }

    // Add listeners
    checkboxes.forEach((cb) => cb.addEventListener("change", updatePolicy));

    // Add click handler for csp-item to toggle checkboxes (needed for mobile touch events)
    const cspItems = container.querySelectorAll(".csp-item");
    cspItems.forEach((item) => {
      item.addEventListener("click", (e) => {
        // Don't toggle if user clicked on a button or input inside the item
        if (
          e.target.closest("button") ||
          e.target.closest("input") ||
          e.target.tagName === "BUTTON" ||
          e.target.tagName === "INPUT"
        ) {
          return;
        }

        // Find the associated checkbox
        const checkbox = item.querySelector(".csp-checkbox");
        if (checkbox && !checkbox.disabled) {
          checkbox.checked = !checkbox.checked;
          // Dispatch change event to trigger policy update
          checkbox.dispatchEvent(new Event("change", { bubbles: true }));
        }
      });
    });

    // Initial update
    updatePolicy();
  })();
</script>

