---
/**
 * JWTDecoder Component
 * Interactive JWT token decoder and inspector.
 * Decodes header, payload and shows signature info.
 * Alerts on insecure algorithms.
 *
 * Usage:
 * <JWTDecoder title="JWT Decoder" />
 */

interface Props {
  title?: string;
}

const { title = "JWT Decoder" } = Astro.props;
const uniqueId = `jwt-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

/* eslint-disable no-secrets/no-secrets -- sample JWT for UI demo, not a real secret */
const sampleJWT =
  "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyLCJleHAiOjE3MzkyNDkwMjJ9.abc123signature";
/* eslint-enable no-secrets/no-secrets */
---

<div
  class="jwt-decoder"
  data-jwt-id={uniqueId}
>
  {title && <div class="jwt-title">{title}</div>}

  <div class="jwt-layout">
    {/* Input Section */}
    <div class="jwt-input-section">
      <label
        class="jwt-label"
        for={`${uniqueId}-input`}
      >
        <span
          class="i-mdi:key-variant jwt-label-icon"
          aria-hidden="true"
        ></span>
        Encoded Token
      </label>
      <textarea
        id={`${uniqueId}-input`}
        class="jwt-textarea"
        rows="6"
        placeholder="Paste your JWT token here..."
        spellcheck="false"
        autocomplete="off"
        >{sampleJWT}</textarea
      >
    </div>

    {/* Output Section */}
    <div class="jwt-output-section">
      {/* Header */}
      <div class="jwt-part">
        <div class="jwt-part-header">
          <span
            class="i-mdi:code-json jwt-part-icon"
            aria-hidden="true"
          ></span>
          <span>Header</span>
          <span class="jwt-part-color header-color"></span>
        </div>
        <div class="jwt-part-content">
          {
            /* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- scrollable region requires keyboard access */
          }
          <pre
            tabindex="0"
            role="region"
            aria-label="Decoded JWT header"><code id={`${uniqueId}-header`}>...</code></pre>
          {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
          <button
            class="jwt-copy-btn"
            type="button"
            data-target={`${uniqueId}-header`}
            aria-label="Copy header"
          >
            <span class="i-mdi:content-copy"></span>
          </button>
        </div>
      </div>

      {/* Payload */}
      <div class="jwt-part">
        <div class="jwt-part-header">
          <span
            class="i-mdi:database jwt-part-icon"
            aria-hidden="true"
          ></span>
          <span>Payload</span>
          <span class="jwt-part-color payload-color"></span>
        </div>
        <div class="jwt-part-content">
          {
            /* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- scrollable region requires keyboard access */
          }
          <pre
            tabindex="0"
            role="region"
            aria-label="Decoded JWT payload"><code id={`${uniqueId}-payload`}>...</code></pre>
          {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
          <button
            class="jwt-copy-btn"
            type="button"
            data-target={`${uniqueId}-payload`}
            aria-label="Copy payload"
          >
            <span class="i-mdi:content-copy"></span>
          </button>
        </div>
      </div>

      {/* Signature */}
      <div class="jwt-part">
        <div class="jwt-part-header">
          <span
            class="i-mdi:shield-check jwt-part-icon"
            aria-hidden="true"
          ></span>
          <span>Signature</span>
          <span class="jwt-part-color signature-color"></span>
        </div>
        <div class="jwt-part-content signature-content">
          <code id={`${uniqueId}-signature`}>...</code>
        </div>
      </div>

      {/* Claims Info */}
      <div
        class="jwt-claims"
        id={`${uniqueId}-claims`}
        hidden
      >
        <div class="jwt-claims-header">
          <span
            class="i-mdi:information-outline"
            aria-hidden="true"
          ></span>
          <span>Token Claims</span>
        </div>
        <div
          class="jwt-claims-list"
          id={`${uniqueId}-claims-list`}
        >
        </div>
      </div>

      {/* Warnings */}
      <div
        class="jwt-warnings"
        id={`${uniqueId}-warnings`}
        hidden
      >
        <div class="jwt-warnings-header">
          <span
            class="i-mdi:alert-circle-outline"
            aria-hidden="true"
          ></span>
          <span>Security Warnings</span>
        </div>
        <ul
          class="jwt-warnings-list"
          id={`${uniqueId}-warnings-list`}
        >
        </ul>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ uniqueId }}>
  (function () {
    const container = document.querySelector(`[data-jwt-id="${uniqueId}"]`);
    if (!container) return;

    const textarea = document.getElementById(`${uniqueId}-input`);
    const headerOutput = document.getElementById(`${uniqueId}-header`);
    const payloadOutput = document.getElementById(`${uniqueId}-payload`);
    const signatureOutput = document.getElementById(`${uniqueId}-signature`);
    const claimsSection = document.getElementById(`${uniqueId}-claims`);
    const claimsList = document.getElementById(`${uniqueId}-claims-list`);
    const warningsSection = document.getElementById(`${uniqueId}-warnings`);
    const warningsList = document.getElementById(`${uniqueId}-warnings-list`);

    if (!textarea || !headerOutput || !payloadOutput || !signatureOutput)
      return;

    const knownClaims = {
      iss: "Issuer",
      sub: "Subject",
      aud: "Audience",
      exp: "Expiration Time",
      nbf: "Not Before",
      iat: "Issued At",
      jti: "JWT ID",
      name: "Name",
      email: "Email",
      role: "Role",
      scope: "Scope",
      azp: "Authorized Party",
      nonce: "Nonce",
    };

    const insecureAlgorithms = ["none", "HS256"];

    function base64UrlDecode(str) {
      let base64 = str.replace(/-/g, "+").replace(/_/g, "/");
      while (base64.length % 4) base64 += "=";
      try {
        return decodeURIComponent(
          atob(base64)
            .split("")
            .map(function (c) {
              return "%" + ("00" + c.charCodeAt(0).toString(16)).slice(-2);
            })
            .join(""),
        );
      } catch (e) {
        return null;
      }
    }

    function formatTimestamp(ts) {
      try {
        const d = new Date(ts * 1000);
        const now = new Date();
        const diff = d - now;
        const isPast = diff < 0;
        const absDiff = Math.abs(diff);
        const days = Math.floor(absDiff / 86400000);
        const hours = Math.floor((absDiff % 86400000) / 3600000);

        let relative;
        if (days > 0) {
          relative = `${days}d ${hours}h ${isPast ? "ago" : "from now"}`;
        } else if (hours > 0) {
          relative = `${hours}h ${isPast ? "ago" : "from now"}`;
        } else {
          relative = isPast ? "just now" : "imminent";
        }

        return `${d.toISOString()} (${relative})`;
      } catch (e) {
        return String(ts);
      }
    }

    function decodeJWT() {
      const token = textarea.value.trim();
      const warnings = [];

      if (!token) {
        headerOutput.textContent = "(Paste a JWT above)";
        payloadOutput.textContent = "";
        signatureOutput.textContent = "";
        if (claimsSection) claimsSection.hidden = true;
        if (warningsSection) warningsSection.hidden = true;
        return;
      }

      const parts = token.split(".");
      if (parts.length !== 3) {
        headerOutput.textContent =
          "Invalid JWT format (expected 3 parts separated by dots)";
        payloadOutput.textContent = "";
        signatureOutput.textContent = "";
        if (claimsSection) claimsSection.hidden = true;
        if (warningsSection) warningsSection.hidden = true;
        return;
      }

      // Decode header
      const headerStr = base64UrlDecode(parts[0]);
      let header = null;
      if (headerStr) {
        try {
          header = JSON.parse(headerStr);
          headerOutput.textContent = JSON.stringify(header, null, 2);
        } catch (e) {
          headerOutput.textContent = "Invalid JSON in header";
        }
      } else {
        headerOutput.textContent = "Could not decode header";
      }

      // Decode payload
      const payloadStr = base64UrlDecode(parts[1]);
      let payload = null;
      if (payloadStr) {
        try {
          payload = JSON.parse(payloadStr);
          payloadOutput.textContent = JSON.stringify(payload, null, 2);
        } catch (e) {
          payloadOutput.textContent = "Invalid JSON in payload";
        }
      } else {
        payloadOutput.textContent = "Could not decode payload";
      }

      // Show signature
      signatureOutput.textContent = parts[2] || "(empty)";

      // Analyze header for warnings
      if (header) {
        if (header.alg === "none") {
          warnings.push({
            type: "critical",
            text: 'Algorithm is "none" — this token has NO signature verification. Never trust unsigned tokens.',
          });
        } else if (header.alg === "HS256") {
          warnings.push({
            type: "warning",
            text: "HS256 uses symmetric signing. If the secret is weak, it can be brute-forced. Consider RS256 or ES256 for production.",
          });
        }

        if (header.typ && header.typ !== "JWT") {
          warnings.push({
            type: "info",
            text: `Token type is "${header.typ}" — not a standard JWT.`,
          });
        }
      }

      // Analyze payload for claims
      if (payload && claimsSection && claimsList) {
        claimsSection.hidden = false;
        claimsList.textContent = "";

        const entries = Object.entries(payload);
        entries.forEach(function (entry) {
          var key = entry[0];
          var value = entry[1];
          const div = document.createElement("div");
          div.className = "jwt-claim-item";

          const keyEl = document.createElement("span");
          keyEl.className = "jwt-claim-key";
          keyEl.textContent = knownClaims[key]
            ? knownClaims[key] + " (" + key + ")"
            : key;

          const valEl = document.createElement("span");
          valEl.className = "jwt-claim-value";

          // Format timestamps
          if (
            ["exp", "iat", "nbf"].includes(key) &&
            typeof value === "number"
          ) {
            valEl.textContent = formatTimestamp(value);

            // Check expiration
            if (key === "exp") {
              const now = Math.floor(Date.now() / 1000);
              if (value < now) {
                valEl.classList.add("expired");
                warnings.push({
                  type: "warning",
                  text: "Token has expired (exp claim is in the past).",
                });
              }
            }
          } else {
            valEl.textContent =
              typeof value === "object" ? JSON.stringify(value) : String(value);
          }

          div.appendChild(keyEl);
          div.appendChild(valEl);
          claimsList.appendChild(div);
        });

        // Check for missing recommended claims
        if (!payload.exp) {
          warnings.push({
            type: "info",
            text: "No expiration (exp) claim. Tokens without expiration never expire.",
          });
        }
      } else if (claimsSection) {
        claimsSection.hidden = true;
      }

      // Show warnings
      if (warningsSection && warningsList) {
        if (warnings.length > 0) {
          warningsSection.hidden = false;
          warningsList.textContent = "";
          warnings.forEach(function (w) {
            const li = document.createElement("li");
            li.className = "jwt-warning-item jwt-warning-" + w.type;
            const icon = document.createElement("span");
            icon.className =
              w.type === "critical"
                ? "i-mdi:alert-octagon"
                : w.type === "warning"
                  ? "i-mdi:alert"
                  : "i-mdi:information-outline";
            li.appendChild(icon);
            li.appendChild(document.createTextNode(" " + w.text));
            warningsList.appendChild(li);
          });
        } else {
          warningsSection.hidden = true;
        }
      }
    }

    // Copy functionality
    container.querySelectorAll(".jwt-copy-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        const target = document.getElementById(btn.dataset.target);
        if (target && navigator.clipboard) {
          navigator.clipboard.writeText(target.textContent || "").then(
            function () {
              btn.classList.add("copied");
              setTimeout(function () {
                btn.classList.remove("copied");
              }, 2000);
            },
            function () {
              btn.classList.add("error");
              setTimeout(function () {
                btn.classList.remove("error");
              }, 2000);
            },
          );
        }
      });
    });

    // Debounce
    var timeout;
    textarea.addEventListener("input", function () {
      clearTimeout(timeout);
      timeout = setTimeout(decodeJWT, 150);
    });

    decodeJWT();
  })();
</script>

<style>
  .jwt-decoder {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-subtle);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .jwt-title {
    padding: 1rem 1.25rem;
    font-size: 1.1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
    background: var(--color-bg-secondary);
    border-bottom: var(--border-1);
  }

  .jwt-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: 1.25rem;
  }

  @media (width >= 768px) {
    .jwt-layout {
      grid-template-columns: 1fr 1fr;
    }
  }

  .jwt-input-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .jwt-label {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.85rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .jwt-label-icon {
    width: 18px;
    height: 18px;
  }

  .jwt-textarea {
    width: 100%;
    min-height: 160px;
    padding: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-text);
    word-break: break-all;
    resize: vertical;
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s;
  }

  .jwt-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .jwt-output-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .jwt-part {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .jwt-part-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.8rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .jwt-part-icon {
    width: 16px;
    height: 16px;
  }

  .jwt-part-color {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .header-color {
    background: #ef4444;
  }

  .payload-color {
    background: #a855f7;
  }

  .signature-color {
    background: #3b82f6;
  }

  .jwt-part-content {
    position: relative;
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    padding: 0.625rem 0.75rem;
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-sm);
  }

  .jwt-part-content pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    word-break: break-all;
    white-space: pre-wrap;
  }

  .signature-content {
    flex-wrap: wrap;
  }

  .signature-content code {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    word-break: break-all;
  }

  .jwt-copy-btn {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--color-text-muted);
    cursor: pointer;
    background: var(--color-bg-subtle);
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: all 0.15s;
  }

  .jwt-copy-btn span {
    width: 14px;
    height: 14px;
  }

  .jwt-copy-btn:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .jwt-copy-btn.copied {
    color: #047857;
    border-color: #10b981;
  }

  /* Claims */
  .jwt-claims {
    padding: 0.75rem;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-sm);
  }

  .jwt-claims-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .jwt-claims-header span[class^="i-"] {
    width: 16px;
    height: 16px;
  }

  .jwt-claim-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.375rem 0;
    font-size: 0.8rem;
    border-bottom: 1px solid var(--color-border);
  }

  .jwt-claim-item:last-child {
    border-bottom: none;
  }

  .jwt-claim-key {
    flex-shrink: 0;
    min-width: 120px;
    font-weight: var(--fw-medium);
    color: var(--color-primary);
  }

  .jwt-claim-value {
    color: var(--color-text);
    word-break: break-all;
  }

  .jwt-claim-value.expired {
    font-weight: var(--fw-medium);
    color: #b91c1c;
  }

  /* Warnings */
  .jwt-warnings {
    padding: 0.75rem;
    background: rgb(251 191 36 / 10%);
    border: 1px solid rgb(251 191 36 / 30%);
    border-radius: var(--radius-sm);
  }

  .jwt-warnings-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
    font-weight: var(--fw-semibold);
    color: #92400e;
  }

  :root[data-theme="dark"] .jwt-warnings-header {
    color: #fbbf24;
  }

  .jwt-warnings-header span[class^="i-"] {
    width: 16px;
    height: 16px;
  }

  .jwt-warnings-list {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .jwt-warning-item {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    padding: 0.25rem 0;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .jwt-warning-item span[class^="i-"] {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    margin-top: 2px;
  }

  .jwt-warning-critical span[class^="i-"] {
    color: #b91c1c;
  }

  .jwt-warning-warning span[class^="i-"] {
    color: #92400e;
  }

  :root[data-theme="dark"] .jwt-warning-warning span[class^="i-"] {
    color: #fbbf24;
  }

  .jwt-warning-info span[class^="i-"] {
    color: var(--color-primary);
  }

  @media (width <= 640px) {
    .jwt-layout {
      padding: 1rem;
    }

    .jwt-claim-item {
      flex-direction: column;
      gap: 0.125rem;
    }

    .jwt-claim-key {
      min-width: auto;
    }
  }
</style>
