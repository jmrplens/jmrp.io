---

<div
  class="cert-inspector"
  data-cert-id={uniqueId}
>
  {title && <div class="cert-title">{title}</div>}

  <div class="cert-layout">
    <div class="cert-input-section">
      <!-- URL Fetch -->
      <div class="cert-url-row">
        <label
          class="cert-label"
          for={`${uniqueId}-url`}
        >
          <span
            class="i-mdi:web"
            aria-hidden="true"
          ></span>
          {t("tools.certInspector.fetchFromUrl")}
        </label>
        <div class="cert-url-input-row">
          <input
            type="text"
            id={`${uniqueId}-url`}
            class="cert-url-input"
            placeholder={t("tools.certInspector.urlPlaceholder")}
            spellcheck="false"
            autocomplete="off"
          />
          <button
            type="button"
            class="cert-fetch-btn"
          >
            <span
              class="i-mdi:download"
              aria-hidden="true"
            ></span>
            {t("tools.certInspector.fetch")}
          </button>
        </div>
      </div>

      <!-- Certificate selector (shown when multiple issuers found) -->
      <div
        class="cert-selector-container"
        id={`${uniqueId}-selector`}
        hidden
      >
        <span class="cert-label">
          <span
            class="i-mdi:certificate-outline"
            aria-hidden="true"
          ></span>
          {t("tools.certInspector.certificatesFound")}
        </span>
        <div
          class="cert-selector-pills"
          role="radiogroup"
          aria-label={t("tools.certInspector.selectCertificateAriaLabel")}
        >
        </div>
      </div>

      <div class="cert-separator">
        <span>{t("tools.certInspector.separatorOr")}</span>
      </div>

      <!-- PEM Paste -->
      <label
        class="cert-label"
        for={`${uniqueId}-pem`}
      >
        <span
          class="i-mdi:certificate"
          aria-hidden="true"
        ></span>
        Paste PEM Certificate
      </label>
      <textarea
        id={`${uniqueId}-pem`}
        class="cert-textarea"
        rows="8"
        placeholder={t("tools.certInspector.pastePemPlaceholder")}
        spellcheck="false"
        data-sample-pem={sampleCert}
      ></textarea>
      <button
        type="button"
        class="cert-inspect-btn"
      >
        <span
          class="i-mdi:magnify"
          aria-hidden="true"
        ></span>
        {t("tools.certInspector.inspectCertificate")}
      </button>
    </div>

    <div
      class="cert-results"
      id={`${uniqueId}-results`}
    >
    </div>
  </div>
</div>

<script is:inline define:vars={{ uniqueId, i18n }}>
  (function () {
    var container = document.querySelector('[data-cert-id="' + uniqueId + '"]');
    if (!container) return;

    var textarea = document.getElementById(uniqueId + "-pem");
    var resultsEl = document.getElementById(uniqueId + "-results");
    var inspectBtn = container.querySelector(".cert-inspect-btn");
    var urlInput = document.getElementById(uniqueId + "-url");
    var fetchBtn = container.querySelector(".cert-fetch-btn");

    var selectorEl = document.getElementById(uniqueId + "-selector");
    var selectorPills = selectorEl
      ? selectorEl.querySelector(".cert-selector-pills")
      : null;
    if (!textarea || !resultsEl || !inspectBtn) return;

    // Quick-parse a PEM to extract issuer O and CN, and validity dates
    function quickParseCert(pemData) {
      try {
        var der = parsePEM(pemData);
        var tree = decodeDER(Array.from(der), 0, der.length);
        if (!tree || !tree[0] || !tree[0].children) return null;
        var tbsCert = tree[0].children[0].children;
        if (!tbsCert || tbsCert.length < 6) return null;

        var idx = 0;
        if (tbsCert[idx].tagClass === 2 && tbsCert[idx].tagNum === 0) idx++;
        idx++; // serial
        idx++; // sig alg

        // Issuer
        var issuerParts = decodeNameParts(tbsCert[idx].children);
        idx++;

        // Validity
        var notBefore = decodeTime(tbsCert[idx].children[0]);
        var notAfter = decodeTime(tbsCert[idx].children[1]);

        var label = issuerParts.O || issuerParts.CN || i18n.unknown;
        if (issuerParts.CN && issuerParts.O) {
          label = issuerParts.O + " (" + issuerParts.CN + ")";
        }

        return {
          issuerO: issuerParts.O || "",
          issuerCN: issuerParts.CN || "",
          issuerLabel: label,
          notBefore: notBefore,
          notAfter: notAfter,
        };
      } catch (e) {
        return null;
      }
    }

    // Group certificates by issuer org, keep most recent valid from each
    function groupByIssuer(certs) {
      var groups = {};
      certs.forEach(function (c) {
        var key = c.issuerO || c.issuerLabel;
        if (
          !groups[key] ||
          c.notBefore.getTime() > groups[key].notBefore.getTime()
        ) {
          groups[key] = c;
        }
      });
      // Sort: most recent first
      return Object.values(groups).sort(function (a, b) {
        return b.notBefore.getTime() - a.notBefore.getTime();
      });
    }

    function renderSelector(certs) {
      if (!selectorEl || !selectorPills || certs.length <= 1) {
        if (selectorEl) selectorEl.hidden = true;
        return;
      }

      selectorPills.textContent = "";
      certs.forEach(function (c, i) {
        var now = new Date();
        var isValid = now >= c.notBefore && now <= c.notAfter;
        var daysLeft = Math.ceil((c.notAfter - now) / (1000 * 60 * 60 * 24));

        var pill = document.createElement("button");
        pill.type = "button";
        pill.className = "cert-pill" + (i === 0 ? " cert-pill-active" : "");
        pill.setAttribute("role", "radio");
        pill.setAttribute("aria-checked", i === 0 ? "true" : "false");

        var pillLabel = document.createElement("span");
        pillLabel.className = "cert-pill-label";
        pillLabel.textContent = c.issuerLabel;

        var pillMeta = document.createElement("span");
        pillMeta.className =
          "cert-pill-meta" +
          (isValid
            ? daysLeft <= 30
              ? " cert-pill-expiring"
              : " cert-pill-valid"
            : " cert-pill-expired");
        pillMeta.textContent = isValid
          ? i18n.dRemaining.replace("{days}", daysLeft)
          : i18n.expired;

        pill.appendChild(pillLabel);
        pill.appendChild(pillMeta);

        pill.addEventListener("click", function () {
          // Update active state
          selectorPills.querySelectorAll(".cert-pill").forEach(function (p) {
            p.classList.remove("cert-pill-active");
            p.setAttribute("aria-checked", "false");
          });
          pill.classList.add("cert-pill-active");
          pill.setAttribute("aria-checked", "true");

          textarea.value = c.pem;
          inspect();
        });

        selectorPills.appendChild(pill);
      });

      selectorEl.hidden = false;
    }

    // --- URL Fetch ---
    if (fetchBtn && urlInput) {
      fetchBtn.addEventListener("click", function () {
        var url = urlInput.value.trim();
        if (!url) return;
        if (!url.match(/^https?:\/\//)) url = "https://" + url;

        // Clean to hostname
        var hostname;
        try {
          hostname = new URL(url).hostname;
        } catch (e) {
          showError(i18n.invalidUrl);
          return;
        }

        fetchBtn.disabled = true;
        var origHtml = fetchBtn.innerHTML;
        fetchBtn.textContent = i18n.fetching;

        // Use multiple public APIs for certificate info
        var apiUrl =
          "https://api.certspotter.com/v1/issuances?domain=" +
          encodeURIComponent(hostname) +
          "&include_subdomains=false&expand=dns_names&expand=cert";

        fetch(apiUrl)
          .then(function (r) {
            if (!r.ok) throw new Error("API returned " + r.status);
            return r.json();
          })
          .then(function (data) {
            if (!data || data.length === 0)
              throw new Error(
                i18n.noCertsFound.replace("{hostname}", hostname),
              );

            // Process ALL certificates
            var allCerts = [];
            data.forEach(function (item) {
              if (item.cert && item.cert.data) {
                var certData = item.cert.data.trim();
                if (!certData.includes("BEGIN CERTIFICATE")) {
                  certData =
                    "-----BEGIN CERTIFICATE-----\n" +
                    certData +
                    "\n-----END CERTIFICATE-----";
                }
                var parsed = quickParseCert(certData);
                if (parsed) {
                  parsed.pem = certData;
                  allCerts.push(parsed);
                }
              }
            });

            if (allCerts.length === 0) throw new Error(i18n.couldNotParse);

            // Group by issuer, keep most recent from each
            var grouped = groupByIssuer(allCerts);
            // Show selector if multiple issuers
            renderSelector(grouped);

            // Load most recent cert
            textarea.value = grouped[0].pem;
            inspect();
          })
          .catch(function () {
            // Fallback: try crt.sh
            var crtUrl =
              "https://crt.sh/?q=" +
              encodeURIComponent(hostname) +
              "&output=json";
            fetch(crtUrl)
              .then(function (r) {
                if (!r.ok) throw new Error("crt.sh returned " + r.status);
                return r.json();
              })
              .then(function (data) {
                if (!data || data.length === 0)
                  throw new Error("No certificates found");
                // Get the most recent cert by not_before
                data.sort(function (a, b) {
                  return (
                    new Date(b.not_before).getTime() -
                    new Date(a.not_before).getTime()
                  );
                });
                var certId = data[0].min_cert_id || data[0].id;
                // Fetch PEM from crt.sh
                return fetch("https://crt.sh/?d=" + certId);
              })
              .then(function (r) {
                if (!r.ok) throw new Error("Failed to fetch PEM");
                return r.text();
              })
              .then(function (pem) {
                if (pem && pem.includes("BEGIN CERTIFICATE")) {
                  textarea.value = pem.trim();
                  inspect();
                } else {
                  throw new Error("Invalid PEM data");
                }
              })
              .catch(function () {
                showError(
                  i18n.couldNotFetch.replace(/\{hostname\}/g, hostname),
                );
              });
          })
          .finally(function () {
            fetchBtn.disabled = false;
            fetchBtn.innerHTML = origHtml;
          });
      });
    }

    function showError(msg) {
      resultsEl.textContent = "";
      var errDiv = document.createElement("div");
      errDiv.className = "cert-error";
      errDiv.textContent = msg;
      resultsEl.appendChild(errDiv);
    }

    // ASN.1 DER decoder (minimal for X.509)
    function decodeDER(bytes, offset, end) {
      if (offset >= end) return null;
      var items = [];

      while (offset < end) {
        var tag = bytes[offset++];
        if (offset >= end) break;

        // Length
        var len = bytes[offset++];
        if (len & 0x80) {
          var numLenBytes = len & 0x7f;
          len = 0;
          for (var lb = 0; lb < numLenBytes; lb++) {
            len = (len << 8) | bytes[offset++];
          }
        }

        var value = bytes.slice(offset, offset + len);
        var isConstructed = tag & 0x20;
        var tagClass = (tag >> 6) & 3;
        var tagNum = tag & 0x1f;

        var item = {
          tag: tag,
          tagNum: tagNum,
          tagClass: tagClass,
          constructed: isConstructed,
          length: len,
          value: value,
          offset: offset,
        };

        if (isConstructed) {
          item.children = decodeDER(bytes, offset, offset + len);
        }

        items.push(item);
        offset += len;
      }

      return items;
    }

    function bytesToHex(bytes, sep) {
      return Array.from(bytes)
        .map(function (b) {
          return b.toString(16).toUpperCase().padStart(2, "0");
        })
        .join(sep || ":");
    }

    function decodeOID(bytes) {
      var oid = [];
      oid.push(Math.floor(bytes[0] / 40));
      oid.push(bytes[0] % 40);

      var val = 0;
      for (var i = 1; i < bytes.length; i++) {
        val = (val << 7) | (bytes[i] & 0x7f);
        if (!(bytes[i] & 0x80)) {
          oid.push(val);
          val = 0;
        }
      }
      return oid.join(".");
    }

    function decodeUTF8(bytes) {
      try {
        return new TextDecoder("utf-8").decode(new Uint8Array(bytes));
      } catch (e) {
        return String.fromCharCode.apply(null, bytes);
      }
    }

    function decodeBitString(bytes) {
      return bytes.slice(1);
    }

    var OID_NAMES = {
      "2.5.4.3": "CN",
      "2.5.4.6": "C",
      "2.5.4.7": "L",
      "2.5.4.8": "ST",
      "2.5.4.10": "O",
      "2.5.4.11": "OU",
      "2.5.4.5": "SerialNumber",
      "1.2.840.113549.1.1.1": "RSA",
      "1.2.840.113549.1.1.5": "SHA1withRSA",
      "1.2.840.113549.1.1.11": "SHA256withRSA",
      "1.2.840.113549.1.1.12": "SHA384withRSA",
      "1.2.840.113549.1.1.13": "SHA512withRSA",
      "1.2.840.10045.2.1": "EC",
      "1.2.840.10045.4.3.2": "SHA256withECDSA",
      "1.2.840.10045.4.3.3": "SHA384withECDSA",
      "1.2.840.10045.4.3.4": "SHA512withECDSA",
      "1.2.840.10045.3.1.7": "P-256",
      "1.3.132.0.34": "P-384",
      "1.3.132.0.35": "P-521",
      "1.2.840.113549.1.1.10": "RSASSA-PSS",
      "1.3.101.112": "Ed25519",
      "1.3.101.113": "Ed448",
      "2.5.29.14": "Subject Key Identifier",
      "2.5.29.15": "Key Usage",
      "2.5.29.17": "Subject Alt Name",
      "2.5.29.19": "Basic Constraints",
      "2.5.29.31": "CRL Distribution Points",
      "2.5.29.32": "Certificate Policies",
      "2.5.29.35": "Authority Key Identifier",
      "2.5.29.37": "Extended Key Usage",
      "1.3.6.1.5.5.7.1.1": "Authority Info Access",
      "1.3.6.1.4.1.11129.2.4.2": "CT Precertificate SCTs",
      "1.3.6.1.5.5.7.3.1": "TLS Web Server Authentication",
      "1.3.6.1.5.5.7.3.2": "TLS Web Client Authentication",
      "1.3.6.1.5.5.7.3.3": "Code Signing",
      "1.3.6.1.5.5.7.3.4": "Email Protection",
      "1.3.6.1.5.5.7.3.8": "Time Stamping",
      "1.3.6.1.5.5.7.3.9": "OCSP Signing",
      "1.3.6.1.5.5.7.48.1": "OCSP",
      "1.3.6.1.5.5.7.48.2": "CA Issuers",
    };

    var EKU_OIDS = {
      "1.3.6.1.5.5.7.3.1": "TLS Web Server Authentication",
      "1.3.6.1.5.5.7.3.2": "TLS Web Client Authentication",
      "1.3.6.1.5.5.7.3.3": "Code Signing",
      "1.3.6.1.5.5.7.3.4": "Email Protection",
      "1.3.6.1.5.5.7.3.8": "Time Stamping",
      "1.3.6.1.5.5.7.3.9": "OCSP Signing",
    };

    var KEY_USAGE_BITS = [
      "Digital Signature",
      "Non Repudiation",
      "Key Encipherment",
      "Data Encipherment",
      "Key Agreement",
      "Certificate Signing",
      "CRL Signing",
      "Encipher Only",
      "Decipher Only",
    ];

    function oidName(oid) {
      return OID_NAMES[oid] || oid;
    }

    function decodeName(children) {
      if (!children) return "Unknown";
      var parts = [];
      children.forEach(function (set) {
        if (set.children) {
          set.children.forEach(function (seq) {
            if (seq.children && seq.children.length >= 2) {
              var oid = decodeOID(seq.children[0].value);
              var val = decodeUTF8(seq.children[1].value);
              parts.push(oidName(oid) + "=" + val);
            }
          });
        }
      });
      return parts.join(", ");
    }

    function decodeNameParts(children) {
      if (!children) return {};
      var result = {};
      children.forEach(function (set) {
        if (set.children) {
          set.children.forEach(function (seq) {
            if (seq.children && seq.children.length >= 2) {
              var oid = decodeOID(seq.children[0].value);
              var val = decodeUTF8(seq.children[1].value);
              result[oidName(oid)] = val;
            }
          });
        }
      });
      return result;
    }

    function decodeTime(item) {
      var str = decodeUTF8(item.value);
      if (item.tag === 0x17) {
        var year = parseInt(str.substring(0, 2));
        year += year >= 50 ? 1900 : 2000;
        return new Date(
          Date.UTC(
            year,
            parseInt(str.substring(2, 4)) - 1,
            parseInt(str.substring(4, 6)),
            parseInt(str.substring(6, 8)),
            parseInt(str.substring(8, 10)),
            parseInt(str.substring(10, 12)),
          ),
        );
      }
      if (item.tag === 0x18) {
        return new Date(
          Date.UTC(
            parseInt(str.substring(0, 4)),
            parseInt(str.substring(4, 6)) - 1,
            parseInt(str.substring(6, 8)),
            parseInt(str.substring(8, 10)),
            parseInt(str.substring(10, 12)),
            parseInt(str.substring(12, 14)),
          ),
        );
      }
      return new Date(str);
    }

    function parsePEM(pem) {
      var b64 = pem.replace(/-----[A-Z\s]+-----/g, "").replace(/\s+/g, "");
      while (b64.length % 4 !== 0) b64 += "=";
      var bin = atob(b64);
      var bytes = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return bytes;
    }

    // SHA-256 fingerprint
    async function computeFingerprint(der) {
      try {
        var hash = await crypto.subtle.digest("SHA-256", der);
        return bytesToHex(new Uint8Array(hash), ":");
      } catch (_) {
        return i18n.unavailable;
      }
    }

    // Decode extensions from TBS certificate
    function decodeExtensions(tbsCert) {
      var extensions = [];
      for (var i = 0; i < tbsCert.length; i++) {
        if (tbsCert[i].tagClass === 2 && tbsCert[i].tagNum === 3) {
          var extSeq = decodeDER(tbsCert[i].value, 0, tbsCert[i].value.length);
          if (extSeq && extSeq[0] && extSeq[0].children) {
            extSeq[0].children.forEach(function (ext) {
              if (ext.children && ext.children.length >= 2) {
                var oid = decodeOID(ext.children[0].value);
                var critical = false;
                var valueIdx = 1;
                if (ext.children.length >= 3 && ext.children[1].tag === 0x01) {
                  critical = ext.children[1].value[0] !== 0;
                  valueIdx = 2;
                }
                extensions.push({
                  oid: oid,
                  name: oidName(oid),
                  critical: critical,
                  value: ext.children[valueIdx]
                    ? ext.children[valueIdx].value
                    : [],
                });
              }
            });
          }
          break;
        }
      }
      return extensions;
    }

    // Decode SANs from extension value
    function decodeSANs(extValue) {
      var sans = [];
      var items = decodeDER(extValue, 0, extValue.length);
      if (items && items[0] && items[0].children) {
        items[0].children.forEach(function (item) {
          if (item.tagClass === 2) {
            var val = decodeUTF8(item.value);
            if (item.tagNum === 2) sans.push("DNS:" + val);
            else if (item.tagNum === 1) sans.push("Email:" + val);
            else if (item.tagNum === 6) sans.push("URI:" + val);
            else if (item.tagNum === 7) {
              // IP address
              if (item.value.length === 4) {
                sans.push("IP:" + item.value.join("."));
              } else if (item.value.length === 16) {
                var parts = [];
                for (var j = 0; j < 16; j += 2) {
                  parts.push(
                    ((item.value[j] << 8) | item.value[j + 1])
                      .toString(16)
                      .padStart(4, "0"),
                  );
                }
                sans.push("IP:" + parts.join(":"));
              }
            }
          }
        });
      }
      return sans;
    }

    // Decode Key Usage bits
    function decodeKeyUsage(extValue) {
      var items = decodeDER(extValue, 0, extValue.length);
      if (!items || !items[0]) return [];
      var bits = items[0].value;
      var usages = [];
      if (bits.length < 2) return usages;
      // bits[0] = unused bits at end; bits[1..] = bit string
      var unusedBits = bits[0];
      for (var byteIdx = 1; byteIdx < bits.length; byteIdx++) {
        for (var bitIdx = 7; bitIdx >= 0; bitIdx--) {
          var totalBit = (byteIdx - 1) * 8 + (7 - bitIdx);
          if (
            byteIdx === bits.length - 1 &&
            7 - bitIdx >= 8 - unusedBits &&
            unusedBits > 0
          )
            continue;
          if (bits[byteIdx] & (1 << bitIdx)) {
            if (totalBit < KEY_USAGE_BITS.length)
              usages.push(KEY_USAGE_BITS[totalBit]);
          }
        }
      }
      return usages;
    }

    // Decode Extended Key Usage
    function decodeEKU(extValue) {
      var items = decodeDER(extValue, 0, extValue.length);
      if (!items || !items[0] || !items[0].children) return [];
      var ekus = [];
      items[0].children.forEach(function (item) {
        if (item.tag === 0x06) {
          var oid = decodeOID(item.value);
          ekus.push(EKU_OIDS[oid] || oid);
        }
      });
      return ekus;
    }

    // Decode Basic Constraints
    function decodeBasicConstraints(extValue) {
      var items = decodeDER(extValue, 0, extValue.length);
      if (!items || !items[0]) return { isCA: false, pathLen: null };
      var result = { isCA: false, pathLen: null };
      if (items[0].children && items[0].children.length > 0) {
        if (
          items[0].children[0].tag === 0x01 &&
          items[0].children[0].value[0] !== 0
        ) {
          result.isCA = true;
        }
        if (items[0].children.length > 1 && items[0].children[1].tag === 0x02) {
          result.pathLen = items[0].children[1].value[0];
        }
      }
      return result;
    }

    // Decode Authority Info Access
    function decodeAIA(extValue) {
      var result = { ocsp: [], caIssuers: [] };
      var items = decodeDER(extValue, 0, extValue.length);
      if (!items || !items[0] || !items[0].children) return result;
      items[0].children.forEach(function (seq) {
        if (seq.children && seq.children.length >= 2) {
          var oid = decodeOID(seq.children[0].value);
          var uri = decodeUTF8(seq.children[1].value);
          if (oid === "1.3.6.1.5.5.7.48.1") result.ocsp.push(uri);
          else if (oid === "1.3.6.1.5.5.7.48.2") result.caIssuers.push(uri);
        }
      });
      return result;
    }

    // Decode Subject / Authority Key Identifier
    function decodeKeyIdentifier(extValue) {
      var items = decodeDER(extValue, 0, extValue.length);
      if (!items || !items[0]) return "";
      // SKI: OCTET STRING wrapping context-specific [0]
      if (items[0].children && items[0].children[0]) {
        return bytesToHex(items[0].children[0].value, ":");
      }
      return bytesToHex(items[0].value, ":");
    }

    // Security assessment
    function assessSecurity(certInfo) {
      var findings = [];

      // Validity checks
      if (!certInfo.isValid) {
        findings.push({
          severity: "critical",
          text: i18n.certExpired,
        });
      } else if (certInfo.daysLeft <= 7) {
        findings.push({
          severity: "critical",
          text: i18n.certExpiresIn.replace("{days}", certInfo.daysLeft),
        });
      } else if (certInfo.daysLeft <= 30) {
        findings.push({
          severity: "warning",
          text: i18n.certExpiresIn.replace("{days}", certInfo.daysLeft),
        });
      } else {
        findings.push({ severity: "pass", text: i18n.certValid });
      }

      // Key strength
      if (certInfo.keyAlgName === "RSA") {
        var bits = parseInt(certInfo.keyBits);
        if (bits < 2048) {
          findings.push({
            severity: "critical",
            text: i18n.rsaKeyTooSmall.replace("{bits}", bits),
          });
        } else if (bits < 4096) {
          findings.push({
            severity: "pass",
            text: i18n.rsaKeyOk.replace("{bits}", bits),
          });
        } else {
          findings.push({
            severity: "pass",
            text: i18n.rsaKeyStrong.replace("{bits}", bits),
          });
        }
      } else if (certInfo.keyAlgName === "EC") {
        var curve = certInfo.keyBits;
        if (curve === "P-256" || curve === "P-384" || curve === "P-521") {
          findings.push({
            severity: "pass",
            text: i18n.ecdsaKeyStrong.replace("{curve}", curve),
          });
        } else {
          findings.push({
            severity: "info",
            text: i18n.ecCurve.replace("{curve}", curve),
          });
        }
      }

      // Signature algorithm
      var sigAlg = certInfo.sigAlgName;
      if (sigAlg.includes("SHA1")) {
        findings.push({
          severity: "critical",
          text: i18n.sha1Deprecated,
        });
      } else if (
        sigAlg.includes("SHA256") ||
        sigAlg.includes("SHA384") ||
        sigAlg.includes("SHA512")
      ) {
        findings.push({
          severity: "pass",
          text: i18n.sigAlgOk.replace("{alg}", sigAlg),
        });
      }

      // Self-signed
      if (certInfo.isSelfSigned && !certInfo.isCA) {
        findings.push({
          severity: "warning",
          text: i18n.selfSignedWarning,
        });
      }

      // SANs
      if (certInfo.sans.length > 0) {
        findings.push({
          severity: "pass",
          text: i18n.sansPresent.replace("{count}", certInfo.sans.length),
        });
      } else if (!certInfo.isCA) {
        findings.push({
          severity: "warning",
          text: i18n.noSans,
        });
      }

      // Wildcard check
      var hasWildcard = certInfo.sans.some(function (s) {
        return s.includes("*");
      });
      if (hasWildcard) {
        findings.push({
          severity: "info",
          text: i18n.wildcardDetected,
        });
      }

      // CA check
      if (certInfo.isCA) {
        findings.push({
          severity: "info",
          text: i18n.isCaCert,
        });
      }

      // Certificate Transparency
      if (certInfo.hasCT) {
        findings.push({
          severity: "pass",
          text: i18n.ctSctsPresent,
        });
      } else if (!certInfo.isCA) {
        findings.push({
          severity: "warning",
          text: i18n.noCtScts,
        });
      }

      // Validity duration
      var totalDays = Math.ceil(
        (certInfo.notAfter - certInfo.notBefore) / (1000 * 60 * 60 * 24),
      );
      if (totalDays > 398) {
        findings.push({
          severity: "warning",
          text: i18n.validityExceeds.replace("{days}", totalDays),
        });
      } else if (!certInfo.isCA) {
        findings.push({
          severity: "pass",
          text: i18n.validityPeriodOk.replace("{days}", totalDays),
        });
      }

      return findings;
    }

    function inspect() {
      var pem = textarea.value.trim();
      resultsEl.textContent = "";

      if (!pem.includes("BEGIN CERTIFICATE")) {
        showError(i18n.invalidPem);
        return;
      }

      try {
        var der = parsePEM(pem);
        var tree = decodeDER(Array.from(der), 0, der.length);

        if (!tree || !tree[0] || !tree[0].children) {
          throw new Error(i18n.invalidStructure);
        }

        var cert = tree[0].children;
        var tbsCert = cert[0].children;

        if (!tbsCert || tbsCert.length < 6) {
          throw new Error(i18n.invalidTbs);
        }

        // Parse fields
        var idx = 0;

        // Version
        var version = 1;
        if (tbsCert[idx].tagClass === 2 && tbsCert[idx].tagNum === 0) {
          var versionChildren = decodeDER(
            tbsCert[idx].value,
            0,
            tbsCert[idx].value.length,
          );
          if (versionChildren && versionChildren[0]) {
            version = versionChildren[0].value[0] + 1;
          }
          idx++;
        }

        // Serial Number
        var serialHex = bytesToHex(tbsCert[idx].value, ":");
        idx++;

        // Signature Algorithm
        var sigAlgOID = decodeOID(tbsCert[idx].children[0].value);
        var sigAlgName = oidName(sigAlgOID);
        idx++;

        // Issuer
        var issuer = decodeName(tbsCert[idx].children);
        var issuerParts = decodeNameParts(tbsCert[idx].children);
        idx++;

        // Validity
        var notBefore = decodeTime(tbsCert[idx].children[0]);
        var notAfter = decodeTime(tbsCert[idx].children[1]);
        idx++;

        // Subject
        var subject = decodeName(tbsCert[idx].children);
        var subjectParts = decodeNameParts(tbsCert[idx].children);
        idx++;

        // Subject Public Key Info
        var keyAlgOID = decodeOID(tbsCert[idx].children[0].children[0].value);
        var keyAlgName = oidName(keyAlgOID);

        var keyBits = "Unknown";
        if (keyAlgName === "RSA") {
          var pubKeyData = decodeBitString(tbsCert[idx].children[1].value);
          var pubKeyTree = decodeDER(pubKeyData, 0, pubKeyData.length);
          if (pubKeyTree && pubKeyTree[0] && pubKeyTree[0].children) {
            var modulusBytes = pubKeyTree[0].children[0].value;
            keyBits =
              (modulusBytes.length - (modulusBytes[0] === 0 ? 1 : 0)) * 8 +
              " bits";
          }
        } else if (keyAlgName === "EC") {
          if (tbsCert[idx].children[0].children.length > 1) {
            var curveOID = decodeOID(
              tbsCert[idx].children[0].children[1].value,
            );
            keyBits = oidName(curveOID);
          }
        } else if (keyAlgName === "Ed25519") {
          keyBits = "256 bits";
        } else if (keyAlgName === "Ed448") {
          keyBits = "448 bits";
        }
        idx++;

        // Parse extensions
        var extensions = decodeExtensions(tbsCert);
        var sans = [];
        var keyUsage = [];
        var ekuList = [];
        var basicConstraints = { isCA: false, pathLen: null };
        var aia = { ocsp: [], caIssuers: [] };
        var hasCT = false;
        var ski = "";
        var aki = "";

        extensions.forEach(function (ext) {
          if (ext.oid === "2.5.29.17") {
            sans = decodeSANs(ext.value);
          } else if (ext.oid === "2.5.29.15") {
            keyUsage = decodeKeyUsage(ext.value);
          } else if (ext.oid === "2.5.29.37") {
            ekuList = decodeEKU(ext.value);
          } else if (ext.oid === "2.5.29.19") {
            basicConstraints = decodeBasicConstraints(ext.value);
          } else if (ext.oid === "1.3.6.1.5.5.7.1.1") {
            aia = decodeAIA(ext.value);
          } else if (ext.oid === "1.3.6.1.4.1.11129.2.4.2") {
            hasCT = true;
          } else if (ext.oid === "2.5.29.14") {
            ski = decodeKeyIdentifier(ext.value);
          } else if (ext.oid === "2.5.29.35") {
            aki = decodeKeyIdentifier(ext.value);
          }
        });

        // Check validity
        var now = new Date();
        var isValid = now >= notBefore && now <= notAfter;
        var daysLeft = Math.ceil((notAfter - now) / (1000 * 60 * 60 * 24));
        var isExpiring = isValid && daysLeft <= 30;
        var isSelfSigned = subject === issuer;

        // Security assessment
        var certInfo = {
          isValid: isValid,
          daysLeft: daysLeft,
          keyAlgName: keyAlgName,
          keyBits: keyBits,
          sigAlgName: sigAlgName,
          isSelfSigned: isSelfSigned,
          isCA: basicConstraints.isCA,
          sans: sans,
          hasCT: hasCT,
          notBefore: notBefore,
          notAfter: notAfter,
        };
        var findings = assessSecurity(certInfo);

        // Build result sections
        var sections = [];

        // Status
        var statusClass = isValid
          ? isExpiring
            ? "cert-status-warning"
            : "cert-status-valid"
          : "cert-status-expired";
        var statusText = isValid
          ? i18n.validDaysRemaining.replace("{days}", daysLeft)
          : i18n.expired;
        sections.push({
          title: i18n.sectionStatus,
          items: [
            { label: i18n.certificate, value: statusText, cls: statusClass },
            {
              label: i18n.type,
              value: basicConstraints.isCA
                ? i18n.caCertificate
                : i18n.endEntityCertificate,
            },
          ],
        });

        // Subject
        var subjectItems = [];
        if (subjectParts.CN)
          subjectItems.push({
            label: i18n.commonName,
            value: subjectParts.CN,
          });
        if (subjectParts.O)
          subjectItems.push({
            label: i18n.organization,
            value: subjectParts.O,
          });
        if (subjectParts.OU)
          subjectItems.push({
            label: i18n.organizationalUnit,
            value: subjectParts.OU,
          });
        if (subjectParts.C)
          subjectItems.push({ label: i18n.country, value: subjectParts.C });
        if (subjectParts.ST)
          subjectItems.push({ label: i18n.state, value: subjectParts.ST });
        if (subjectParts.L)
          subjectItems.push({ label: i18n.locality, value: subjectParts.L });
        if (subjectItems.length === 0)
          subjectItems.push({ label: i18n.distinguishedName, value: subject });
        sections.push({ title: i18n.sectionSubject, items: subjectItems });

        // SANs
        if (sans.length > 0) {
          sections.push({
            title: i18n.sectionSans.replace("{count}", sans.length),
            items: sans.map(function (s, i) {
              return {
                label: i18n.sanLabel.replace("{index}", i + 1),
                value: s,
              };
            }),
          });
        }

        // Issuer
        var issuerItems = [];
        if (issuerParts.CN)
          issuerItems.push({
            label: i18n.commonName,
            value: issuerParts.CN,
          });
        if (issuerParts.O)
          issuerItems.push({ label: i18n.organization, value: issuerParts.O });
        if (issuerParts.C)
          issuerItems.push({ label: i18n.country, value: issuerParts.C });
        if (issuerItems.length === 0)
          issuerItems.push({ label: i18n.distinguishedName, value: issuer });
        issuerItems.push({
          label: i18n.selfSigned,
          value: isSelfSigned ? i18n.yes : i18n.no,
        });
        sections.push({ title: i18n.sectionIssuer, items: issuerItems });

        // Validity
        var totalDays = Math.ceil(
          (notAfter - notBefore) / (1000 * 60 * 60 * 24),
        );
        sections.push({
          title: i18n.sectionValidity,
          items: [
            { label: i18n.notBefore, value: notBefore.toUTCString() },
            { label: i18n.notAfter, value: notAfter.toUTCString() },
            {
              label: i18n.duration,
              value: i18n.daysValue.replace("{days}", totalDays),
            },
            {
              label: i18n.daysRemaining,
              value: isValid ? String(daysLeft) : i18n.expired,
              cls: isValid
                ? daysLeft <= 30
                  ? "cert-status-warning"
                  : ""
                : "cert-status-expired",
            },
          ],
        });

        // Key Info
        sections.push({
          title: i18n.sectionPublicKey,
          items: [
            { label: i18n.algorithm, value: keyAlgName },
            { label: i18n.keySizeCurve, value: keyBits },
            { label: i18n.signatureAlgorithm, value: sigAlgName },
          ],
        });

        // Key Usage
        if (keyUsage.length > 0) {
          sections.push({
            title: i18n.sectionKeyUsage,
            items: keyUsage.map(function (u) {
              return { label: "\u2713", value: u, cls: "cert-ext-value" };
            }),
          });
        }

        // Extended Key Usage
        if (ekuList.length > 0) {
          sections.push({
            title: i18n.sectionExtKeyUsage,
            items: ekuList.map(function (u) {
              return { label: "\u2713", value: u, cls: "cert-ext-value" };
            }),
          });
        }

        // Authority Info Access
        if (aia.ocsp.length > 0 || aia.caIssuers.length > 0) {
          var aiaItems = [];
          aia.ocsp.forEach(function (u) {
            aiaItems.push({ label: "OCSP", value: u });
          });
          aia.caIssuers.forEach(function (u) {
            aiaItems.push({ label: i18n.caIssuers, value: u });
          });
          sections.push({ title: i18n.sectionAia, items: aiaItems });
        }

        // Details
        var detailItems = [
          { label: i18n.version, value: "v" + version },
          { label: i18n.serialNumber, value: serialHex },
        ];
        if (ski) detailItems.push({ label: i18n.subjectKeyId, value: ski });
        if (aki) detailItems.push({ label: i18n.authorityKeyId, value: aki });
        detailItems.push({
          label: i18n.ctScts,
          value: hasCT ? i18n.ctPresent : i18n.ctNotFound,
          cls: hasCT ? "cert-status-valid" : "",
        });
        sections.push({ title: i18n.sectionDetails, items: detailItems });

        // Security Assessment
        sections.push({
          title: i18n.sectionSecurity,
          items: findings.map(function (f) {
            var cls = "";
            if (f.severity === "pass") cls = "cert-finding-pass";
            else if (f.severity === "warning") cls = "cert-finding-warning";
            else if (f.severity === "critical") cls = "cert-finding-critical";
            else if (f.severity === "info") cls = "cert-finding-info";
            return {
              label:
                f.severity === "pass"
                  ? "\u2713"
                  : f.severity === "warning"
                    ? "\u26A0"
                    : f.severity === "critical"
                      ? "\u2717"
                      : "\u24D8",
              value: f.text,
              cls: cls,
            };
          }),
        });

        // Render all sections
        renderSections(sections);

        // Compute and display fingerprint async
        computeFingerprint(der).then(function (fp) {
          var fpRow = resultsEl.querySelector(".cert-fingerprint-value");
          if (fpRow) fpRow.textContent = fp;
        });

        // Add fingerprint placeholder before security section
        var detailsSection = resultsEl.querySelectorAll(".cert-section");
        if (detailsSection.length >= 2) {
          var secAssessIdx = detailsSection.length - 1;
          var lastDetailSection = detailsSection[secAssessIdx - 1];
          var fpRow = document.createElement("div");
          fpRow.className = "cert-row";
          var fpLabel = document.createElement("span");
          fpLabel.className = "cert-row-label";
          fpLabel.textContent = i18n.sha256Fingerprint;
          var fpValue = document.createElement("span");
          fpValue.className = "cert-row-value cert-fingerprint-value";
          fpValue.textContent = i18n.computing;
          fpRow.appendChild(fpLabel);
          fpRow.appendChild(fpValue);
          lastDetailSection.appendChild(fpRow);
        }
      } catch (e) {
        showError(
          i18n.errorParsing.replace(
            "{message}",
            e.message || i18n.unknownError,
          ),
        );
      }
    }

    function renderSections(sections) {
      sections.forEach(function (section) {
        var card = document.createElement("div");
        card.className = "cert-section";

        var heading = document.createElement("div");
        heading.className = "cert-section-heading";
        heading.textContent = section.title;
        card.appendChild(heading);

        section.items.forEach(function (item) {
          var row = document.createElement("div");
          row.className = "cert-row";

          var label = document.createElement("span");
          label.className = "cert-row-label";
          label.textContent = item.label;

          var value = document.createElement("span");
          value.className = "cert-row-value" + (item.cls ? " " + item.cls : "");
          value.textContent = item.value;

          row.appendChild(label);
          row.appendChild(value);
          card.appendChild(row);
        });

        resultsEl.appendChild(card);
      });
    }

    inspectBtn.addEventListener("click", inspect);

    // Seed the demo certificate from a data attribute rather than shipping it
    // as the textarea's child text. As child text it was the first ~1,856
    // characters of this page's extractable content — 14% of the total, and
    // ahead of every word of prose, so a retrieval system chunking the page
    // led with a base64 blob. In an attribute it still renders identically
    // for the reader but no longer front-loads the text extraction.
    if (!textarea.value) {
      var samplePem = textarea.getAttribute("data-sample-pem");
      if (samplePem) textarea.value = samplePem;
    }

    // Auto-inspect on load
    inspect();
  })();
</script>

