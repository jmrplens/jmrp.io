  caIssuers: t("tools.certInspector.caIssuers"),
  // Details
  version: t("tools.certInspector.version"),
  serialNumber: t("tools.certInspector.serialNumber"),
  subjectKeyId: t("tools.certInspector.subjectKeyId"),
  authorityKeyId: t("tools.certInspector.authorityKeyId"),
  ctScts: t("tools.certInspector.ctScts"),
  ctPresent: t("tools.certInspector.ctPresent"),
  ctNotFound: t("tools.certInspector.ctNotFound"),
  // Fingerprint
  sha256Fingerprint: t("tools.certInspector.sha256Fingerprint"),
  computing: t("tools.certInspector.computing"),
  unavailable: t("tools.certInspector.unavailable"),
  // Security findings
  unknown: t("tools.certInspector.unknown"),
  certExpired: t("tools.certInspector.certExpired"),
  certExpiresIn: t("tools.certInspector.certExpiresIn"),
  certValid: t("tools.certInspector.certValid"),
  rsaKeyTooSmall: t("tools.certInspector.rsaKeyTooSmall"),
  rsaKeyOk: t("tools.certInspector.rsaKeyOk"),
  rsaKeyStrong: t("tools.certInspector.rsaKeyStrong"),
  ecdsaKeyStrong: t("tools.certInspector.ecdsaKeyStrong"),
  ecCurve: t("tools.certInspector.ecCurve"),
  sha1Deprecated: t("tools.certInspector.sha1Deprecated"),
  sigAlgOk: t("tools.certInspector.sigAlgOk"),
  selfSignedWarning: t("tools.certInspector.selfSignedWarning"),
  sansPresent: t("tools.certInspector.sansPresent"),
  noSans: t("tools.certInspector.noSans"),
  wildcardDetected: t("tools.certInspector.wildcardDetected"),
  isCaCert: t("tools.certInspector.isCaCert"),
  ctSctsPresent: t("tools.certInspector.ctSctsPresent"),
  noCtScts: t("tools.certInspector.noCtScts"),
  validityExceeds: t("tools.certInspector.validityExceeds"),
  validityPeriodOk: t("tools.certInspector.validityPeriodOk"),
};

