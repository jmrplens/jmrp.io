---
/**
 * CertInspector Component
 * Decode and inspect PEM-encoded X.509 certificates client-side.
 * Fetch certificates from URLs or paste PEM data directly.
 * Extracts subject, issuer, validity, SANs, key info, extensions, and
 * provides a security assessment.
 *
 * Usage:
 * <CertInspector title="Certificate Inspector" />
 */
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

interface Props {
  title?: string;
}

const { title = t("tools.certInspector.title") } = Astro.props;
const uniqueId = `cert-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

/** Translations passed to the inline script via define:vars. */
const i18n = {
  // Fetch states & errors
  fetching: t("tools.certInspector.fetching"),
  invalidUrl: t("tools.certInspector.invalidUrl"),
  noCertsFound: t("tools.certInspector.noCertsFound"),
  couldNotParse: t("tools.certInspector.couldNotParse"),
  couldNotFetch: t("tools.certInspector.couldNotFetch"),
  // Pill meta
  dRemaining: t("tools.certInspector.dRemaining"),
  expired: t("tools.certInspector.expired"),
  // Parse errors
  invalidPem: t("tools.certInspector.invalidPem"),
  invalidStructure: t("tools.certInspector.invalidStructure"),
  invalidTbs: t("tools.certInspector.invalidTbs"),
