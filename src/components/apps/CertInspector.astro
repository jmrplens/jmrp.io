---
/**
 * CertInspector Component
 * Decode and inspect PEM-encoded X.509 certificates client-side.
 * Extracts subject, issuer, validity, SANs, key info, and extensions.
 *
 * Usage:
 * <CertInspector title="Certificate Inspector" />
 */

interface Props {
  title?: string;
}

const { title = "Certificate Inspector" } = Astro.props;
const uniqueId = `cert-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;

/* eslint-disable no-secrets/no-secrets -- PEM certificate sample for demo, not a secret */
