---
/**
 * CRCCalculator Component
 * Calculate CRC-8, CRC-16, and CRC-32 checksums for hex or ASCII data.
 * Supports common polynomial presets used in embedded protocols.
 *
 * Usage:
 * <CRCCalculator title="CRC Calculator" />
 */

interface Props {
  title?: string;
}

const { title = "CRC Calculator" } = Astro.props;
const uniqueId = `crc-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36)}`;
---

<div
  class="crc-calculator"
  data-crc-id={uniqueId}
>
  {title && <div class="crc-title">{title}</div>}

  <div class="crc-layout">
    {/* Input */}
    <div class="crc-input-section">
      <div class="crc-field-row">
        <div class="crc-field">
          <label
            class="crc-label"
            for={`${uniqueId}-input-type`}
            >Input Type</label
          >
          <select
            id={`${uniqueId}-input-type`}
            class="crc-select"
          >
            <option
              value="hex"
              selected
              >Hexadecimal</option
            >
            <option value="ascii">ASCII Text</option>
          </select>
        </div>
        <div
          class="crc-field"
          style="flex:2"
        >
          <label
            class="crc-label"
            for={`${uniqueId}-data`}
            >Data</label
          >
          <input
            id={`${uniqueId}-data`}
            class="crc-input"
            type="text"
            value="01 03 00 00 00 0A"
            placeholder="Enter hex bytes or ASCII text..."
            spellcheck="false"
          />
        </div>
      </div>
    </div>

    {/* Preset selector */}
    <div class="crc-presets">
      <span class="crc-presets-label">Presets:</span>
      <button
        type="button"
        class="crc-preset-btn crc-preset-active"
        data-preset="all"
        >All</button
      >
      <button
        type="button"
        class="crc-preset-btn"
        data-preset="modbus"
        >Modbus</button
      >
      <button
        type="button"
        class="crc-preset-btn"
        data-preset="embedded"
        >Embedded</button
      >
      <button
        type="button"
        class="crc-preset-btn"
        data-preset="network"
        >Network</button
      >
    </div>

    {/* Results */}
    <div
      class="crc-results"
      id={`${uniqueId}-results`}
    >
    </div>
  </div>
</div>

<script is:inline define:vars={{ uniqueId }}>
  (function () {
    var container = document.querySelector('[data-crc-id="' + uniqueId + '"]');
    if (!container) return;

    var inputType = document.getElementById(uniqueId + "-input-type");
    var dataInput = document.getElementById(uniqueId + "-data");
    var resultsEl = document.getElementById(uniqueId + "-results");
    var presetBtns = container.querySelectorAll(".crc-preset-btn");

    if (!dataInput || !resultsEl) return;

    var activePreset = "all";

    // CRC algorithm definitions
    var algorithms = [
      // CRC-8
      {
        name: "CRC-8",
        width: 8,
        poly: 0x07,
        init: 0x00,
        refIn: false,
        refOut: false,
        xorOut: 0x00,
        tags: ["embedded"],
      },
      {
        name: "CRC-8/MAXIM",
        width: 8,
        poly: 0x31,
        init: 0x00,
        refIn: true,
        refOut: true,
        xorOut: 0x00,
        tags: ["embedded"],
        note: "1-Wire / Dallas",
      },
      {
        name: "CRC-8/AUTOSAR",
        width: 8,
        poly: 0x2f,
        init: 0xff,
        refIn: false,
        refOut: false,
        xorOut: 0xff,
        tags: ["embedded"],
      },
      // CRC-16
      {
        name: "CRC-16/MODBUS",
        width: 16,
        poly: 0x8005,
        init: 0xffff,
        refIn: true,
        refOut: true,
        xorOut: 0x0000,
        tags: ["modbus", "embedded"],
        note: "Modbus RTU",
      },
      {
        name: "CRC-16/CCITT-FALSE",
        width: 16,
        poly: 0x1021,
        init: 0xffff,
        refIn: false,
        refOut: false,
        xorOut: 0x0000,
        tags: ["network"],
      },
      {
        name: "CRC-16/XMODEM",
        width: 16,
        poly: 0x1021,
        init: 0x0000,
        refIn: false,
        refOut: false,
        xorOut: 0x0000,
        tags: ["network", "embedded"],
      },
      {
        name: "CRC-16/USB",
        width: 16,
        poly: 0x8005,
        init: 0xffff,
        refIn: true,
        refOut: true,
        xorOut: 0xffff,
        tags: ["embedded"],
      },
      {
        name: "CRC-16/ARC",
        width: 16,
        poly: 0x8005,
        init: 0x0000,
        refIn: true,
        refOut: true,
        xorOut: 0x0000,
        tags: ["embedded"],
        note: "LHA",
      },
      {
        name: "CRC-16/DNP",
        width: 16,
        poly: 0x3d65,
        init: 0x0000,
        refIn: true,
        refOut: true,
        xorOut: 0xffff,
        tags: ["network"],
        note: "DNP3",
      },
      // CRC-32
      {
        name: "CRC-32",
        width: 32,
        poly: 0x04c11db7,
        init: 0xffffffff,
        refIn: true,
        refOut: true,
        xorOut: 0xffffffff,
        tags: ["network"],
        note: "Ethernet, ZIP, PNG",
      },
      {
        name: "CRC-32/MPEG-2",
        width: 32,
        poly: 0x04c11db7,
        init: 0xffffffff,
        refIn: false,
        refOut: false,
        xorOut: 0x00000000,
        tags: ["network"],
      },
      {
        name: "CRC-32C",
        width: 32,
        poly: 0x1edc6f41,
        init: 0xffffffff,
        refIn: true,
        refOut: true,
        xorOut: 0xffffffff,
        tags: ["network"],
        note: "Castagnoli / iSCSI",
      },
    ];

    function reflectBits(val, width) {
      var result = 0;
      for (var i = 0; i < width; i++) {
        if (val & (1 << i)) result |= 1 << (width - 1 - i);
      }
      return result;
    }

    function computeCRC(data, algo) {
      var width = algo.width;
      var poly = algo.poly;
      var crc = algo.init;

      // Build table
      var table = new Array(256);
      for (var i = 0; i < 256; i++) {
        var entry;
        if (width <= 8) {
          entry = i;
          for (var b = 0; b < 8; b++) {
            entry =
              entry & 0x80 ? ((entry << 1) ^ poly) & 0xff : (entry << 1) & 0xff;
          }
        } else if (width <= 16) {
          entry = i << 8;
          for (var b = 0; b < 8; b++) {
            entry =
              entry & 0x8000
                ? ((entry << 1) ^ poly) & 0xffff
                : (entry << 1) & 0xffff;
          }
        } else {
          entry = (i << 24) >>> 0;
          for (var b = 0; b < 8; b++) {
            entry =
              entry & 0x80000000
                ? (((entry << 1) >>> 0) ^ poly) >>> 0
                : (entry << 1) >>> 0;
          }
        }
        table[i] = entry >>> 0;
      }

      var mask;
      if (width <= 8) mask = 0xff;
      else if (width <= 16) mask = 0xffff;
      else mask = 0xffffffff;

      for (var j = 0; j < data.length; j++) {
        var byte = data[j];
        if (algo.refIn) byte = reflectBits(byte, 8);

        if (width <= 8) {
          crc = table[(crc ^ byte) & 0xff] & mask;
        } else if (width <= 16) {
          crc = (table[((crc >> 8) ^ byte) & 0xff] ^ (crc << 8)) & mask;
        } else {
          crc =
            (table[((crc >>> 24) ^ byte) & 0xff] ^ ((crc << 8) >>> 0)) >>> 0;
        }
      }

      if (algo.refOut) crc = reflectBits(crc, width) >>> 0;
      crc = (crc ^ algo.xorOut) & mask;
      return crc >>> 0;
    }

    function parseData() {
      var type = inputType.value;
      var raw = dataInput.value.trim();
      if (!raw) return [];

      if (type === "hex") {
        return raw
          .replace(/[^0-9a-fA-F\s]/g, "")
          .split(/\s+/)
          .filter(Boolean)
          .map(function (h) {
            return parseInt(h, 16);
          });
      } else {
        var bytes = [];
        for (var i = 0; i < raw.length; i++) {
          bytes.push(raw.charCodeAt(i) & 0xff);
        }
        return bytes;
      }
    }

    function toHex(val, width) {
      var hexLen = Math.ceil(width / 4);
      return (
        "0x" + (val >>> 0).toString(16).toUpperCase().padStart(hexLen, "0")
      );
    }

    function calculate() {
      var data = parseData();
      resultsEl.textContent = "";

      if (data.length === 0) {
        resultsEl.innerHTML =
          '<div class="crc-no-data">Enter data to calculate checksums</div>';
        return;
      }

      var filtered = algorithms.filter(function (algo) {
        if (activePreset === "all") return true;
        return algo.tags.includes(activePreset);
      });

      // Group by width
      var groups = {};
      filtered.forEach(function (algo) {
        var grp = "CRC-" + algo.width;
        if (!groups[grp]) groups[grp] = [];
        groups[grp].push(algo);
      });

      ["CRC-8", "CRC-16", "CRC-32"].forEach(function (grp) {
        if (!groups[grp]) return;

        var section = document.createElement("div");
        section.className = "crc-result-group";

        var heading = document.createElement("div");
        heading.className = "crc-group-heading";
        heading.textContent = grp;
        section.appendChild(heading);

        groups[grp].forEach(function (algo) {
          var result = computeCRC(data, algo);
          var card = document.createElement("div");
          card.className = "crc-result-card";

          var nameEl = document.createElement("div");
          nameEl.className = "crc-result-name";

          var nameText = document.createElement("span");
          nameText.textContent = algo.name;
          nameEl.appendChild(nameText);

          if (algo.note) {
            var noteEl = document.createElement("span");
            noteEl.className = "crc-result-note";
            noteEl.textContent = algo.note;
            nameEl.appendChild(noteEl);
          }

          var valueRow = document.createElement("div");
          valueRow.className = "crc-result-values";

          var hexVal = document.createElement("code");
          hexVal.className = "crc-result-hex";
          hexVal.textContent = toHex(result, algo.width);

          var decVal = document.createElement("span");
          decVal.className = "crc-result-dec";
          decVal.textContent = "Dec: " + result;

          valueRow.appendChild(hexVal);
          valueRow.appendChild(decVal);

          // Show params
          var params = document.createElement("div");
          params.className = "crc-result-params";
          params.textContent =
            "Poly: " +
            toHex(algo.poly, algo.width) +
            " | Init: " +
            toHex(algo.init, algo.width) +
            " | RefIn: " +
            algo.refIn +
            " | RefOut: " +
            algo.refOut +
            " | XorOut: " +
            toHex(algo.xorOut, algo.width);

          card.appendChild(nameEl);
          card.appendChild(valueRow);
          card.appendChild(params);

          // Copy button
          var copyBtn = document.createElement("button");
          copyBtn.type = "button";
          copyBtn.className = "crc-copy-btn";
          copyBtn.textContent = "Copy";
          copyBtn.addEventListener("click", function () {
            navigator.clipboard
              .writeText(toHex(result, algo.width))
              .then(function () {
                copyBtn.textContent = "Copied!";
                setTimeout(function () {
                  copyBtn.textContent = "Copy";
                }, 1200);
              });
          });
          card.appendChild(copyBtn);

          section.appendChild(card);
        });

        resultsEl.appendChild(section);
      });
    }

    // Presets
    presetBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        presetBtns.forEach(function (b) {
          b.classList.remove("crc-preset-active");
        });
        btn.classList.add("crc-preset-active");
        activePreset = btn.getAttribute("data-preset");
        calculate();
      });
    });

    dataInput.addEventListener("input", calculate);
    inputType.addEventListener("change", calculate);

    calculate();
  })();
</script>

<style>
  .crc-calculator {
    margin: 1.5rem 0;
    overflow: hidden;
    background: var(--color-bg-subtle);
    border: var(--border-1);
    border-radius: var(--radius-md);
  }

  .crc-title {
    padding: 1rem 1.25rem;
    font-size: 1.1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
    background: var(--color-bg-secondary);
    border-bottom: var(--border-1);
  }

  .crc-layout {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
  }

  .crc-input-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .crc-field-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .crc-field {
    flex: 1;
    min-width: 120px;
  }

  .crc-label {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.8rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .crc-input,
  .crc-select {
    width: 100%;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s;
  }

  .crc-input:focus,
  .crc-select:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  /* Presets */
  .crc-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    align-items: center;
  }

  .crc-presets-label {
    margin-right: 0.25rem;
    font-size: 0.75rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
  }

  .crc-preset-btn {
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    cursor: pointer;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: all 0.15s;
  }

  .crc-preset-btn:hover {
    color: var(--color-text);
  }

  .crc-preset-active {
    color: var(--color-primary);
    background: var(--color-bg);
    border-color: var(--color-primary);
  }

  /* Results */
  .crc-results :global(.crc-no-data) {
    padding: 1rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  .crc-results :global(.crc-result-group) {
    margin-bottom: 1rem;
  }

  .crc-results :global(.crc-group-heading) {
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    font-weight: var(--fw-bold);
    color: var(--color-text-heading);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .crc-results :global(.crc-result-card) {
    position: relative;
    padding: 0.75rem;
    margin-bottom: 0.375rem;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-sm);
  }

  .crc-results :global(.crc-result-name) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    margin-bottom: 0.25rem;
  }

  .crc-results :global(.crc-result-name > span:first-child) {
    font-size: 0.85rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .crc-results :global(.crc-result-note) {
    font-size: 0.7rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .crc-results :global(.crc-result-values) {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 0.25rem;
  }

  .crc-results :global(.crc-result-hex) {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: var(--fw-bold);
    color: var(--color-primary);
  }

  .crc-results :global(.crc-result-dec) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .crc-results :global(.crc-result-params) {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    word-break: break-all;
  }

  .crc-results :global(.crc-copy-btn) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.2rem 0.5rem;
    font-size: 0.65rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    cursor: pointer;
    background: var(--color-bg);
    border: var(--border-1);
    border-radius: var(--radius-sm);
    transition: all 0.15s;
  }

  .crc-results :global(.crc-copy-btn:hover) {
    color: var(--color-text);
    border-color: var(--color-primary);
  }

  @media (width <= 480px) {
    .crc-field-row {
      flex-direction: column;
    }
  }
</style>
