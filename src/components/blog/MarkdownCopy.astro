---
/**
 * MarkdownCopy — "copy this post as markdown", for feeding it to an LLM.
 *
 * ── Why a link and not a button ───────────────────────────────────────────
 * It renders as a real `<a href="…md">`, and script upgrades it into a copy
 * control. With JavaScript off — or before the handler binds — clicking it
 * opens the markdown, which is a worse experience but a working one. A bare
 * `<button>` would simply do nothing, and this site's stated baseline is that
 * the page works without client JS.
 *
 * ── Why it fetches instead of embedding ───────────────────────────────────
 * The markdown twin of a post runs 20–55 KB. Inlining it in a `data-` attribute
 * to save one request would double the weight of every article for a control
 * most readers never touch. The file is already built, already cached for 30
 * days, and `connect-src 'self'` already allows the fetch, so the click pays
 * for itself and the page pays nothing.
 *
 * What lands on the clipboard is the file verbatim, header included: the URL,
 * dates and Wikidata topics at the top are exactly the provenance a model needs
 * when the text arrives pasted into a chat with no other context.
 */
import { getLangFromUrl, useTranslations } from "@i18n/utils";

interface Props {
  /** Root-relative path of this post's markdown twin. */
  href: string;
}

const { href } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
---

<a
  class="md-copy"
  href={href}
  data-astro-prefetch="false"
  data-md-copy
  data-label-idle={t("pages.blogPost.copyMarkdown")}
  data-label-copied={t("ui.copied")}
  data-label-failed={t("components.copyButton.failedToCopy")}
>
  <span
    class="i-mdi:language-markdown-outline md-copy__icon"
    aria-hidden="true"
  ></span>
  <span class="md-copy__label">{t("pages.blogPost.copyMarkdown")}</span>
</a>
<span
  class="sr-only"
  role="status"
  aria-live="polite"
  data-md-copy-status
></span>

<style>
  .md-copy {
    display: inline-flex;
    gap: 0.35em;
    align-items: center;
    color: var(--color-text-muted);
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: 0;
  }

  .md-copy:hover,
  .md-copy:focus-visible {
    color: var(--color-accent);
  }

  .md-copy:focus-visible {
    /* The transparent outline is not decoration: Windows High Contrast Mode
       discards box-shadow and forces outlines, so a focus ring built only from
       a shadow leaves the control with no visible focus at all there. Keeping
       both costs nothing in a normal render and is the only indicator in HCM. */
    outline: 2px solid transparent;
    outline-offset: 2px;
    box-shadow: var(--focus-ring);
  }

  .md-copy__icon {
    width: 1.1em;
    height: 1.1em;
  }
</style>

<script>
  (() => {
    const COPIED_MS = 1600;
    /** Timer of the last copy, so a second click does not cut its own message
        short: without this the first timeout fires mid-confirmation and the
        live region is cleared before a screen reader has read it. */
    let resetTimer: ReturnType<typeof globalThis.setTimeout> | undefined;

    /**
     * Upgrades the markdown link into a copy control.
     *
     * Delegated from the document so it survives Astro's View Transitions,
     * which swap the article node out from under any element-bound listener.
     */
    const onClick = (event: MouseEvent) => {
      const link = (event.target as Element | null)?.closest?.(
        "a[data-md-copy]",
      ) as HTMLAnchorElement | null;
      if (!link) return;

      // Let the browser do its normal thing for "open in new tab" and friends,
      // where the reader has asked for the file rather than the clipboard.
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }
      if (!navigator.clipboard) return; // no clipboard: the href still works

      event.preventDefault();

      const label = link.querySelector<HTMLElement>(".md-copy__label");
      const status = document.querySelector<HTMLElement>(
        "[data-md-copy-status]",
      );
      const idle = link.dataset.labelIdle ?? "";
      const done = link.dataset.labelCopied ?? "";
      const failed = link.dataset.labelFailed ?? "";

      const settle = (message: string) => {
        if (label) label.textContent = message;
        if (status) status.textContent = message;
        if (resetTimer !== undefined) globalThis.clearTimeout(resetTimer);
        resetTimer = globalThis.setTimeout(() => {
          if (label) label.textContent = idle;
          if (status) status.textContent = "";
        }, COPIED_MS);
      };

      fetch(link.href)
        .then((response) => {
          if (!response.ok) throw new Error(String(response.status));
          return response.text();
        })
        .then((text) => navigator.clipboard.writeText(text))
        .then(() => settle(done))
        .catch(() => settle(failed));
    };

    document.addEventListener("click", onClick);
  })();
</script>
