---
/**
 * AuthorCard — end-of-post author byline/bio block.
 *
 * Surfaces the author's identity and credentials at the point of consumption so
 * both readers and AI entity-extractors can bind the post to the credentialed
 * Person entity (links to CV, Publications, GitHub, Google Scholar). The visible
 * links mirror the `#person` `sameAs` graph emitted in the page <head>.
 */
import mehomeImg from "@assets/mehome.webp";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "@i18n/utils";
import type { SiteConfig } from "@src/types";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const siteEntry = await getEntry("site_config", "site");
const siteData = (siteEntry?.data || {}) as SiteConfig;
const author = siteData.author;

const githubUrl = siteData.social_links?.find((l) => l.name === "GitHub")?.url;
const scholarUrl = siteData.person?.sameAs?.find((u) =>
  u.includes("scholar.google"),
);
// ORCID is in the JSON-LD `sameAs` on every page but was not a visible link
// anywhere on a post. It is the strongest machine-verifiable credential the
// author has (14 works, resolvable identifier), and this card is where a
// reader decides whether to trust the article.
// Hostname match, not a substring: `includes("orcid.org")` would also accept
// `https://example.com/?ref=orcid.org` (CodeQL
// js/incomplete-url-substring-sanitization). Same idiom as `isOrcidUrl` in
// BaseHead.astro, which documents the identical trap.
const orcidUrl = siteData.person?.sameAs?.find((u) => {
  try {
    const { hostname } = new URL(u);
    return hostname === "orcid.org" || hostname === "www.orcid.org";
  } catch {
    return false;
  }
});

const headingId = `author-${crypto.getRandomValues(new Uint32Array(1))[0]}`;
const externalRel = "external noopener noreferrer";
// The three off-site chips (GitHub / Scholar / ORCID) sit in the same row as
// two same-tab internal ones, so each announces the new tab (WCAG 3.2.5) and
// carries the `external-link` ↗ affordance for sighted users. The label leads
// with the visible brand name: `aria-label` replaces the accessible name, and
// dropping the visible text would break WCAG 2.5.3 Label in Name (level A).
---

<aside
  class="author-card"
  aria-labelledby={headingId}
>
  <Image
    src={mehomeImg}
    alt={t("pages.blogPost.authorAvatarAlt", { author })}
    class="author-card__avatar"
    width={72}
    height={72}
    densities={[1, 2]}
    quality={85}
    loading="lazy"
  />
  <div class="author-card__body">
    <p class="author-card__eyebrow">{t("pages.blogPost.aboutAuthor")}</p>
    <p
      id={headingId}
      class="author-card__name"
    >
      <span class="author-card__fullname">{author}</span>
      <span class="author-card__role">{t("pages.blogPost.authorRole")}</span>
    </p>
    <p class="author-card__bio">{t("pages.blogPost.authorBio")}</p>
    <nav
      class="author-card__links"
      aria-label={t("pages.blogPost.aboutAuthor")}
    >
      <a href={translatePath("/cv/")}>{t("pages.blogPost.authorViewCv")}</a>
      <a href={translatePath("/publications/")}>{t("nav.publications")}</a>
      {
        githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel={externalRel}
            class="external-link"
            aria-label={t("aria.opensNewTab", { text: "GitHub" })}
          >
            GitHub
          </a>
        )
      }
      {
        scholarUrl && (
          <a
            href={scholarUrl}
            target="_blank"
            rel={externalRel}
            class="external-link"
            aria-label={t("aria.opensNewTab", { text: "Google Scholar" })}
          >
            Google Scholar
          </a>
        )
      }
      {
        orcidUrl && (
          <a
            href={orcidUrl}
            target="_blank"
            rel={externalRel}
            class="external-link"
            aria-label={t("aria.opensNewTab", { text: "ORCID" })}
          >
            ORCID
          </a>
        )
      }
    </nav>
    <p class="author-card__disclosure">
      {t("pages.blogPost.aiDisclosure")}{" "}
      <a href={`${translatePath("/about/")}#editorial`}>
        {t("pages.blogPost.editorialPolicyLink")}
      </a>
    </p>
  </div>
</aside>

<style>
  .author-card {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    padding: var(--space-md-lg);
    margin-block-start: var(--space-lg);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-lg);
  }

  .author-card__avatar {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .author-card__body {
    min-width: 0;
  }

  .author-card__eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .author-card__name {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: baseline;
    margin: var(--space-xs) 0 0;
  }

  .author-card__fullname {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    color: var(--color-text-heading);
  }

  .author-card__role {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .author-card__bio {
    margin: var(--space-sm) 0 var(--space-md);
    font-size: var(--text-base);
    color: var(--color-text);
  }

  .author-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .author-card__links a {
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    text-decoration: none;
  }

  .author-card__links a:hover,
  .author-card__links a:focus-visible {
    text-decoration: underline;
  }

  .author-card__disclosure {
    margin: var(--space-md) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .author-card__disclosure a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .author-card__disclosure a:hover,
  .author-card__disclosure a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
