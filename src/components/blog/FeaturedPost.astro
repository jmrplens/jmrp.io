---
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import { getReadingTime } from "@utils/blog";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const displayDate = post.data.publishedDate;
const readingTime = getReadingTime(post);
const tags = (post.data.tags ?? []).slice(0, 3);

/** Compact "YYYY·MM·DD" date used in the meta row. */
const dotDate = (d: Date): string =>
  `${d.getFullYear()}·${String(d.getMonth() + 1).padStart(2, "0")}·${String(
    d.getDate(),
  ).padStart(2, "0")}`;

const haystack = [
  post.data.title,
  post.data.description,
  ...(post.data.tags ?? []),
]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
---

<a
  class="featured-post"
  href={translatePath(`/blog/${post.data.slug}/`)}
  aria-label={t("aria.readArticle", { title: post.data.title })}
  data-post
  data-featured
  data-tags={(post.data.tags ?? []).map((tag) => tag.toLowerCase()).join(" ")}
  data-search={haystack}
>
  <div class="featured-post__media">
    {
      post.data.coverImage && (
        <Image
          src={post.data.coverImage}
          alt={post.data.title}
          format="webp"
          class="featured-post__image"
          width={640}
          height={400}
          widths={[480, 640, 960]}
          sizes="(max-width: 860px) 100vw, 50vw"
          quality={60}
          loading="eager"
          fetchpriority="high"
        />
      )
    }
  </div>
  <div class="featured-post__body">
    <div class="featured-post__meta-top">
      <span class="featured-post__badge">{t("pages.blog.featured")}</span>
      {tags.length > 0 && <span>{tags.join(" · ")}</span>}
    </div>
    <h2 class="featured-post__title">{post.data.title}</h2>
    <p class="featured-post__desc">{post.data.description}</p>
    <div class="featured-post__meta">
      <time datetime={displayDate.toISOString()}>{dotDate(displayDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime} {t("pages.blog.minRead")}</span>
    </div>
  </div>
</a>

<style>
  .featured-post {
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  .featured-post:hover {
    border-color: var(--accent-line);
    box-shadow: var(--sh-card);
  }

  .featured-post__media {
    min-height: 260px;
    background: var(--color-bg-subtle);
    border-right: 1px solid var(--color-border);
  }

  .featured-post__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-post__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-lg) var(--space-lg-xl);
  }

  .featured-post__meta-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75em;
    align-items: center;
    margin-bottom: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .featured-post__badge {
    padding: 4px 9px;
    color: var(--color-accent);
    background: var(--accent-dim);
    border-radius: var(--radius-sm);
  }

  .featured-post__title {
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
    font-weight: var(--fw-medium);
    line-height: 1.12;
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
  }

  .featured-post__desc {
    margin: 0 0 var(--space-md-lg);
    font-size: 0.975rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .featured-post__meta {
    display: flex;
    gap: 1em;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .featured-post:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (width <= 760px) {
    .featured-post {
      grid-template-columns: 1fr;
    }

    .featured-post__media {
      min-height: 200px;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>
