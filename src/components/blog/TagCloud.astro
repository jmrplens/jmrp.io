---
import { getCollection } from "astro:content";
import { getUniqueTags } from "@utils/blog";

const posts = (await getCollection("posts")).filter((post) => !post.data.draft);
const tags = getUniqueTags(posts);
---

<div class="tag-cloud">
  <h3>Topics</h3>
  <div class="tags">
    {tags.map(({ tag, count }) => (
      <a href={`/blog/tags/${encodeURIComponent(tag)}`} class="tag">
        <span class="hash">#</span>{tag} <span class="count">{count}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .tag-cloud {
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: 16px;
    padding: 1.5rem;
  }
  
  h3 {
      margin-top: 0;
      margin-bottom: 1rem;
      font-size: 1.1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-muted);
      font-weight: 600;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: var(--color-bg-subtle);
    padding: 0.4rem 0.8rem;
    border-radius: 99px; /* Pill shape */
    font-size: 0.9rem;
    color: var(--color-text-body);
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .tag:hover {
    background: var(--color-bg-tertiary);
    color: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }
  
  .hash {
      color: var(--color-primary);
      opacity: 0.7;
  }
  
  .count {
      font-size: 0.75rem;
      background: rgba(0,0,0,0.05);
      padding: 0.1rem 0.4rem;
      border-radius: 99px;
      margin-left: 0.2rem;
  }
  
  /* Dark mode adjustment for count background if needed */
  :global(.dark) .count {
      background: rgba(255,255,255,0.1);
  }

  @media (max-width: 900px) {
    .tag-cloud {
      background: var(--color-bg);
      border: none;
      border-radius: 0;
      padding: 0;
      margin: 0 -1rem;
      width: calc(100% + 2rem);
      position: relative;
    }
    
    /* Fade effect to indicate scroll - even wider */
    .tag-cloud::after {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 80px;
      background: linear-gradient(to right, transparent, var(--color-bg));
      pointer-events: none;
      z-index: 10;
    }
    
    h3 {
        display: none;
    }

    .tags {
      display: grid;
      grid-template-rows: repeat(2, auto);
      grid-auto-flow: column;
      gap: 0.4rem 0.6rem;
      
      overflow-x: auto;
      padding: 0.5rem 1rem;
      padding-right: 5rem; /* Increased padding to accommodate wider fade */
      
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    
    .tags::-webkit-scrollbar {
        display: none;
    }

    .tag {
        white-space: nowrap;
        padding: 0.35rem 0.8rem;
        font-size: 0.8rem;
        width: max-content;
    }
  }
</style>
