---
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import { getPostsForLocale, getUniqueTags } from "@utils/blog";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const entries = await getPostsForLocale(locale);
const posts = entries.map((e) => e.post);
const tags = getUniqueTags(posts);
---

<nav
  class="tag-filter"
  aria-label={t("pages.blog.topicsTitle")}
  data-tag-filter
>
  <a
    href={translatePath("/blog/")}
    class="tag-pill is-active"
    data-tag=""
  >
    {t("pages.blog.allPosts")} · {posts.length}
  </a>
  {
    tags.map(({ tag }) => (
      <a
        href={translatePath(`/blog/tags/${encodeURIComponent(tag)}/`)}
        class="tag-pill"
        data-tag={tag}
      >
        {tag}
      </a>
    ))
  }
</nav>

<style>
  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .tag-pill {
    padding: 7px 15px;
    color: var(--color-text);
    text-transform: lowercase;
    white-space: nowrap;
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    transition:
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .tag-pill:hover {
    color: var(--color-text-heading);
    border-color: var(--color-accent);
  }

  .tag-pill.is-active {
    font-weight: var(--fw-medium);
    color: var(--color-on-primary);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .tag-pill:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
