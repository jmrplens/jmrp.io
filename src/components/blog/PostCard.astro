---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "auto" | "low";
}

const { post, loading = "lazy", fetchpriority = "auto" } = Astro.props;
---

<article class="post-card">
  {
    post.data.coverImage && (
      <div class="image-container">
        <Image
          src={post.data.coverImage}
          alt={post.data.title}
          format="webp"
          class="card-image"
          width={400}
          height={225}
          widths={[360, 480, 640, 720, 960, 1200]}
          sizes="(max-width: 640px) 100vw, 400px"
          quality={60}
          loading={loading}
          fetchpriority={fetchpriority}
        />
      </div>
    )
  }
  <div class="card-content">
    <div class="post-meta">
      <time datetime={post.data.publishedDate.toISOString()}>
        {
          post.data.publishedDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
          })
        }
      </time>
      {
        post.data.tags && (
          <div class="tags">
            {post.data.tags.slice(0, 3).map((tag) => (
              <a
                href={`/blog/tags/${encodeURIComponent(tag)}`}
                class="tag"
                aria-label={`View all posts tagged with ${tag}`}
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
    <h2>
      <a
        href={`/blog/${post.id}/`}
        class="main-link"
      >
        {post.data.title}
      </a>
    </h2>
    <p>{post.data.description}</p>
  </div>
  <div class="card-footer">
    <span class="read-more">Read article &rarr;</span>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: 16px;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .post-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 12px 24px -10px rgb(0 0 0 / 15%);
    transform: translateY(-4px);
  }

  /* Image Card Styles */
  .image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .post-card:hover .card-image {
    transform: scale(1.05);
  }

  /* Standard Card Styles */
  .card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 2rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .tags {
    position: relative;
    z-index: 2; /* Ensure tags are clickable above the card link */
    display: flex;
    gap: 0.5rem;
    min-height: 1.5em; /* Stabilize for CLS */
  }

  .tag {
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-body);
    text-decoration: none;
    background: var(--color-bg-subtle);
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }

  .tag:hover {
    color: var(--color-primary);
    background: var(--color-bg-tertiary);
  }

  .post-card h2 {
    min-height: 2.6em; /* Reserve 2 lines roughly */
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .main-link {
    color: var(--color-text-heading);
    text-decoration: none;
  }

  .main-link::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
  }

  .post-card p {
    /* Webkit line clamp for text truncation */
    display: -webkit-box;

    /* Layout and sizing */
    min-height: 4.8rem; /* Reserve space for 3 lines to prevent CLS */
    overflow: hidden;
    -webkit-line-clamp: 3;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-body);
    -webkit-box-orient: vertical;
  }

  .card-footer {
    display: flex; /* Ensure alignment */
    align-items: center;
    min-height: 4.5rem; /* Stabilize for CLS */
    padding: 1.5rem 2rem;
    background: var(--color-bg-subtle);
    border-top: var(--border-1);
  }

  .read-more {
    font-size: 0.9rem;
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
  }

  /* Keyboard focus styles for main-link */
  .main-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Ensure focus ring is visible above the overlay */
  .main-link:focus-visible::after {
    z-index: 0; /* Lower than focus ring which is on the link itself */
  }

  /* Keyboard focus styles for tag links */
  .tag:focus-visible {
    color: var(--color-primary);
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    background: var(--color-bg-tertiary);
  }
</style>
