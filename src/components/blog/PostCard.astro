---
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import { formatDateDot, getReadingTime } from "@utils/blog";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  /** 1-based position in the listing, shown as a mono "NN" index. */
  index: number;
}

const { post, index } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const displayDate = post.data.publishedDate;
const readingTime = getReadingTime(post);
const tags = (post.data.tags ?? []).slice(0, 2);

// Search-filter haystack (lowercased title + description + tags).
const haystack = [
  post.data.title,
  post.data.description,
  ...(post.data.tags ?? []),
]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
---

<article
  class="post-card"
  data-post
  data-tags={(post.data.tags ?? []).map((tag) => tag.toLowerCase()).join(" ")}
  data-search={haystack}
>
  <a
    class="post-card__link"
    href={translatePath(`/blog/${post.data.slug}/`)}
  >
    {
      post.data.coverImage && (
        <div class="post-card__cover">
          <Image
            class="post-card__cover-img"
            src={post.data.coverImage}
            alt=""
            role="presentation"
            width={640}
            height={360}
            widths={[320, 480, 640]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 380px"
            loading="lazy"
          />
        </div>
      )
    }
    <div class="post-card__body">
      <div class="post-card__top">
        <span class="post-card__tags">{tags.join(" · ")}</span>
        <span
          class="post-card__index"
          aria-hidden="true"
        >
          {String(index).padStart(2, "0")}
        </span>
      </div>
      <h2 class="post-card__title">{post.data.title}</h2>
      <p class="post-card__desc">{post.data.description}</p>
      <div class="post-card__meta">
        <time datetime={displayDate.toISOString()}>
          {formatDateDot(displayDate)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{readingTime} {t("pages.blog.minRead")}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    display: flex;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .post-card:hover {
    border-color: var(--accent-line);
    box-shadow: var(--sh-card);
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card {
      transition: border-color var(--dur-2) var(--ease-out);
    }

    .post-card:hover {
      transform: none;
    }
  }

  .post-card__link {
    display: flex;
    flex: 1;
    flex-direction: column;
    color: var(--color-text);
    text-decoration: none;
  }

  .post-card__cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
  }

  .post-card__cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .post-card:hover .post-card__cover-img {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card__cover-img {
      transition: none;
    }

    .post-card:hover .post-card__cover-img {
      transform: none;
    }
  }

  .post-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-md-lg);
  }

  .post-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
  }

  .post-card__tags {
    color: var(--color-accent);
    text-transform: lowercase;
  }

  .post-card__index {
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .post-card__title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--fw-medium);
    line-height: 1.2;
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .post-card__desc {
    flex: 1;
    margin: 0 0 var(--space-md-lg);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text);
  }

  .post-card__meta {
    display: flex;
    gap: 0.75em;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-text-muted);
  }

  .post-card__link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>
