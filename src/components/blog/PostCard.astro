---
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import { getReadingTime } from "@utils/blog";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  /** 1-based position in the listing, shown as a mono "NN" index. */
  index: number;
}

const { post, index } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const displayDate = post.data.publishedDate;
const readingTime = getReadingTime(post);
const tags = (post.data.tags ?? []).slice(0, 2);

/** Compact "YYYY·MM·DD" date used in the Lab card meta row. */
const dotDate = (d: Date): string =>
  `${d.getFullYear()}·${String(d.getMonth() + 1).padStart(2, "0")}·${String(
    d.getDate(),
  ).padStart(2, "0")}`;

// Search-filter haystack (lowercased title + description + tags).
const haystack = [
  post.data.title,
  post.data.description,
  ...(post.data.tags ?? []),
]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
---

<article
  class="post-card"
  data-post
  data-tags={(post.data.tags ?? []).map((tag) => tag.toLowerCase()).join(" ")}
  data-search={haystack}
>
  <a
    class="post-card__link"
    href={translatePath(`/blog/${post.data.slug}/`)}
    aria-label={t("aria.readArticle", { title: post.data.title })}
  >
    <div class="post-card__top">
      <span class="post-card__tags">{tags.join(" · ")}</span>
      <span
        class="post-card__index"
        aria-hidden="true"
      >
        {String(index).padStart(2, "0")}
      </span>
    </div>
    <h2 class="post-card__title">{post.data.title}</h2>
    <p class="post-card__desc">{post.data.description}</p>
    <div class="post-card__meta">
      <time datetime={displayDate.toISOString()}>{dotDate(displayDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime} {t("pages.blog.minRead")}</span>
    </div>
  </a>
</article>

<style>
  .post-card {
    display: flex;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .post-card:hover {
    border-color: var(--accent-line);
    box-shadow: var(--sh-card);
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card {
      transition: border-color var(--dur-2) var(--ease-out);
    }

    .post-card:hover {
      transform: none;
    }
  }

  .post-card__link {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-md-lg);
    color: var(--color-text);
    text-decoration: none;
  }

  .post-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .post-card__tags {
    color: var(--color-accent);
    text-transform: lowercase;
  }

  .post-card__index {
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .post-card__title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: var(--fw-medium);
    line-height: 1.2;
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .post-card__desc {
    flex: 1;
    margin: 0 0 var(--space-md-lg);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-text);
  }

  .post-card__meta {
    display: flex;
    gap: 0.75em;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .post-card__link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>
