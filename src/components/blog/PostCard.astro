---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "auto" | "low";
}

const { post, loading = "lazy", fetchpriority = "auto" } = Astro.props;
---

<article class="post-card">
  {
    post.data.coverImage && (
      <div class="image-container">
        <Image
          src={post.data.coverImage}
          alt={post.data.title}
          format="webp"
          class="card-image"
          width={400}
          height={225}
          widths={[360, 480, 640, 720, 960, 1200]}
          sizes="(max-width: 640px) 100vw, 400px"
          quality={60}
          loading={loading}
          fetchpriority={fetchpriority}
        />
      </div>
    )
  }
  <div class="card-content">
    <div class="post-meta">
      <time datetime={post.data.publishedDate.toISOString()}>
        {
          post.data.publishedDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
          })
        }
      </time>
      {
        post.data.tags && (
          <div class="tags">
            {post.data.tags.slice(0, 3).map((tag) => (
              <a
                href={`/blog/tags/${encodeURIComponent(tag)}/`}
                class="tag"
                aria-label={`View all posts tagged with ${tag}`}
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
    <h2>
      <a
        href={`/blog/${post.id}/`}
        class="main-link"
      >
        {post.data.title}
      </a>
    </h2>
    <p>{post.data.description}</p>
  </div>
  <div class="card-footer">
    <span class="read-more">Read article &rarr;</span>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: 16px;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .post-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 12px 24px -10px rgb(0 0 0 / 15%);
    transform: translateY(-4px);
  }

  /* Image Card Styles */

  /* Height is supplied by the flex parent's default align-items: stretch */
  .image-container {
    position: relative;
    width: 100%;
    min-height: 120px; /* Prevent collapse when content is minimal */
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .post-card:hover .card-image {
    transform: scale(1.05);
  }

  /* Standard Card Styles */
  .card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1.5rem 0.75rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .tags {
    position: relative;
    z-index: 2; /* Ensure tags are clickable above the card link */
    display: flex;
    gap: 0.5rem;
    min-height: 1.25rem; /* Stabilize for CLS (approx 20px) */
  }

  .tag {
    padding: 0.15rem 0.4rem;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-text-body);
    text-decoration: none;
    background: var(--color-bg-subtle);
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }

  .tag:hover {
    color: var(--color-primary);
    background: var(--color-bg-tertiary);
  }

  .post-card h2 {
    display: -webkit-box;
    min-height: auto; /* Remove fixed height constraint */
    margin-bottom: 0.25rem;
    overflow: hidden;
    -webkit-line-clamp: 3;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: break-word;
    -webkit-box-orient: vertical;
  }

  .main-link {
    color: var(--color-text-heading);
    text-decoration: none;
  }

  .main-link::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
  }

  .post-card p {
    /* Webkit line clamp for text truncation */
    display: -webkit-box;

    /* Layout and sizing */
    min-height: auto; /* Remove fixed height constraint */
    overflow: hidden;
    -webkit-line-clamp: 2; /* Show only 2 lines instead of 3 */
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text-body);
    -webkit-box-orient: vertical;
  }

  .card-footer {
    display: flex; /* Ensure alignment */
    align-items: center;
    min-height: auto; /* Remove fixed height constraint */
    padding: 0.75rem 1.5rem;
    background: var(--color-bg-subtle);
    border-top: var(--border-1);
  }

  .read-more {
    font-size: 0.85rem;
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
  }

  @media (width <= 640px) {
    .post-card {
      flex-direction: row; /* Horizontal layout on mobile */
      height: auto; /* Allow growing */
      max-height: none; /* Remove height constraint */
    }

    .image-container {
      flex-shrink: 0;
      width: 130px; /* Fixed width for image */
      height: auto; /* Let flex stretch handle vertical sizing */
      aspect-ratio: unset; /* Override default aspect ratio */
    }

    .card-image {
      height: 100%; /* Stretch to cover container height */
    }

    .card-content {
      padding: 0.75rem 1rem;
    }

    .post-card h2 {
      -webkit-line-clamp: 3;

      /* Show full title */
      font-size: 1.1rem;
    }

    .post-card p {
      /* Show description, capped at ~4 lines */
      display: -webkit-box;
      -webkit-line-clamp: 4;
      font-size: 0.85rem;
      -webkit-box-orient: vertical;
    }

    /* Keep footer visible for accessibility and interaction */
    .card-footer {
      display: none; /* Hidden visually to save space in horizontal layout */
    }

    /* Make main link focusable and labelled correctly */
    .main-link {
      outline-offset: 2px;
    }

    .post-meta {
      margin-bottom: 0.25rem;
    }

    /* Hide tags to save space, but content remains in DOM for readers if needed (or reconsider showing 1) */
    .tags {
      display: none;
    }
  }

  /* Keyboard focus styles for main-link */
  .main-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Ensure focus ring is visible above the overlay */
  .main-link:focus-visible::after {
    z-index: 0; /* Lower than focus ring which is on the link itself */
  }

  /* Keyboard focus styles for tag links */
  .tag:focus-visible {
    color: var(--color-primary);
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    background: var(--color-bg-tertiary);
  }
</style>
