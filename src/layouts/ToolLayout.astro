---
/**
 * ToolLayout component.
 * Shared layout for all /tools/* pages.
 * Provides consistent structure: breadcrumb, header, tool container,
 * and info section — plus the SoftwareApplication JSON-LD schema.
 *
 * Slots:
 *   - default: The tool component (rendered inside `.tool-container`)
 *   - info: Content inside the `<section class="tool-info">` card
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";

interface Props {
  /** Page <title> and visible <h1>. */
  title: string;
  /** Meta description for SEO. */
  description: string;
  /** Short subtitle shown below the h1. Defaults to `description`. */
  subtitle?: string;
  /** UnoCSS icon class for the header badge, e.g. `i-mdi:regex`. */
  icon: string;
  /** URL slug used for the canonical URL, e.g. `regex-tester`. */
  slug: string;
  /** Optional extra schema fields merged into the generated SoftwareApplication schema. */
  extraSchema?: Record<string, unknown>;
}

const { title, description, subtitle, icon, slug, extraSchema } = Astro.props;

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: title,
  description,
  url: new URL(`/tools/${slug}/`, getSiteUrl()).toString(),
  applicationCategory: "WebApplication",
  operatingSystem: "Web Browser",
  offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
  ...extraSchema,
};
---

<BaseLayout
  title={title}
  description={description}
  schema={toolSchema}
>
  <div class="tool-page">
    <div class="content-wrapper">
      <nav
        class="breadcrumb"
        aria-label="Breadcrumb"
      >
        <a href="/tools/">Tools</a>
        <span
          class="i-mdi:chevron-right"
          aria-hidden="true"
        ></span>
        <span aria-current="page">{title}</span>
      </nav>

      <header class="page-header">
        <div class="header-icon">
          <span
            class={icon}
            aria-hidden="true"
          ></span>
        </div>
        <div class="header-content">
          <h1>{title}</h1>
          <p class="subtitle">{subtitle ?? description}</p>
        </div>
      </header>

      <div class="tool-container">
        <slot />
      </div>

      {
        Astro.slots.has("info") && (
          <section class="tool-info">
            <slot name="info" />
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .tool-page {
    min-height: calc(100vh - var(--header-height, 4rem) - 4rem);
    padding: var(--space-xl) 0;
  }

  .content-wrapper {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--max-width-container);
    padding: 0 var(--space-lg);
    margin: 0 auto;
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin-bottom: var(--space-lg);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .breadcrumb span[class*="i-"] {
    width: 1rem;
    height: 1rem;
  }

  /* Page header */
  .page-header {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    margin-bottom: var(--space-xl);
  }

  .header-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background: linear-gradient(
      135deg,
      var(--color-success, #10b981),
      var(--color-success-dark, #059669)
    );
    border-radius: var(--radius-lg);
  }

  .header-icon span {
    width: 2rem;
    height: 2rem;
    color: var(--header-icon-color, #fff);
  }

  .header-content {
    flex: 1;
    min-width: 0;
  }

  .page-header h1 {
    margin-bottom: var(--space-xs);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* Tool container (full width) */
  .tool-container {
    margin-bottom: var(--space-xl);
  }

  /* Info section (full width) */
  .tool-info {
    padding: var(--space-lg);
    background: var(--color-bg-secondary);
    border: var(--border-1);
    border-radius: var(--radius-lg);
  }

  /* Typography inside tool-info */
  .tool-info :global(h2) {
    margin-bottom: var(--space-md);
    font-size: 1.25rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info :global(h3) {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    font-size: 1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info :global(h4) {
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
    font-size: 0.95rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
  }

  .tool-info :global(p) {
    margin-bottom: var(--space-md);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .tool-info :global(ul),
  .tool-info :global(ol) {
    padding-left: 1.25rem;
    margin: 0;
  }

  .tool-info :global(li) {
    margin-bottom: var(--space-sm);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .tool-info :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tool-info :global(a:hover) {
    text-decoration: none;
  }

  .tool-info :global(code) {
    padding: 0.125rem 0.375rem;
    font-size: 0.85rem;
    background: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
  }

  /* Responsive */
  @media (width <= 640px) {
    .page-header {
      flex-direction: column;
      text-align: center;
    }

    .page-header h1 {
      font-size: 1.5rem;
    }

    .subtitle {
      font-size: 0.9rem;
    }

    .tool-info {
      padding: var(--space-md);
    }
  }
</style>
