---
/**
 * ToolLayout component.
 * Shared layout for all /tools/* pages.
 * Provides consistent structure: breadcrumb, header, tool container,
 * and info section — plus the SoftwareApplication JSON-LD schema.
 *
 * Slots:
 *   - default: The tool component (rendered inside `.tool-container`)
 *   - info: Content inside the `<section class="tool-info">` card
 */
import FAQ from "@components/ui/FAQ.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteUrl } from "@utils/site";
import type { FAQPage, SoftwareApplication } from "schema-dts";

interface Props {
  /** Page <title> and visible <h1>. */
  title: string;
  /** Meta description for SEO. */
  description: string;
  /** Short subtitle shown below the h1. Defaults to `description`. */
  subtitle?: string;
  /** UnoCSS icon class for the header badge, e.g. `i-mdi:regex`. */
  icon: string;
  /** URL slug used for the canonical URL, e.g. `regex-tester`. */
  slug: string;
  /** Optional extra schema fields merged into the generated SoftwareApplication schema. */
  extraSchema?: Record<string, unknown>;
  /** FAQ pairs — rendered as an accessible section + emitted as FAQPage JSON-LD. */
  faq?: { question: string; answer: string }[];
  /** Feature bullets — emitted as SoftwareApplication `featureList`. */
  features?: string[];
  /** Publication date — emitted as SoftwareApplication `datePublished`. */
  publishedDate?: Date;
  /** Last-updated date — emitted as `dateModified` (falls back to publishedDate). */
  updatedDate?: Date;
}

const {
  title,
  description,
  subtitle,
  icon,
  slug,
  extraSchema,
  faq,
  features,
  publishedDate,
  updatedDate,
} = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const toolUrl = new URL(`/tools/${slug}/`, getSiteUrl()).href;
// `@context` is intentionally omitted: this node is merged into the page-level
// JSON-LD `@graph`, which already declares the context.
const baseToolSchema = {
  "@type": "SoftwareApplication",
  "@id": `${toolUrl}#software`,
  name: title,
  description,
  url: toolUrl,
  applicationCategory: "WebApplication",
  operatingSystem: "Web Browser",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  isAccessibleForFree: true,
  author: { "@id": new URL("#person", getSiteUrl()).href },
  creator: { "@id": new URL("#person", getSiteUrl()).href },
  inLanguage: locale,
  ...(features && features.length > 0 && { featureList: features }),
  ...(publishedDate && {
    datePublished: publishedDate.toISOString(),
    dateModified: (updatedDate ?? publishedDate).toISOString(),
  }),
} satisfies SoftwareApplication;
const toolSchema = { ...baseToolSchema, ...extraSchema };

// Secondary FAQPage node (from the tool's `faq` frontmatter), merged into the graph.
const faqNode =
  faq && faq.length > 0
    ? ({
        "@type": "FAQPage",
        "@id": `${toolUrl}#faq`,
        isPartOf: { "@id": `${toolUrl}#software` },
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      } satisfies FAQPage)
    : undefined;

const pageSchema = faqNode ? [toolSchema, faqNode] : toolSchema;
---

<BaseLayout
  title={title}
  description={description}
  schema={pageSchema}
>
  <div class="tool-page">
    <div class="content-wrapper">
      <nav
        class="breadcrumb"
        aria-label={t("aria.breadcrumb")}
      >
        <a href={translatePath("/tools/")}>{t("nav.tools")}</a>
        <span
          class="i-mdi:chevron-right"
          aria-hidden="true"
        ></span>
        <span aria-current="page">{title}</span>
      </nav>

      <header class="page-header">
        <div
          class="lab-grid"
          aria-hidden="true"
        >
        </div>
        <div class="page-header__body">
          <div class="header-icon">
            <span
              class={icon}
              aria-hidden="true"
            ></span>
          </div>
          <div class="header-content">
            <p class="section-title">{t("nav.tools")}</p>
            <h1>{title}</h1>
            <p class="subtitle">{subtitle ?? description}</p>
          </div>
        </div>
      </header>

      <div class="tool-container">
        <slot />
      </div>

      {
        Astro.slots.has("info") && (
          <section class="tool-info">
            <slot name="info" />
          </section>
        )
      }

      {faq && faq.length > 0 && <FAQ items={faq} />}
    </div>
  </div>
</BaseLayout>

<style>
  .tool-page {
    min-height: calc(100vh - var(--header-height, 4rem) - 4rem);
    padding: var(--space-xl) 0;
  }

  .content-wrapper {
    width: 100%;
    max-width: var(--max-width-container);
    padding: 0 var(--space-lg);
    margin: 0 auto;
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin-bottom: var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .breadcrumb span[class*="i-"] {
    width: 1rem;
    height: 1rem;
  }

  /* Page header */
  .page-header {
    position: relative;
    margin-bottom: var(--space-xl);
    overflow: hidden;
  }

  .page-header__body {
    position: relative;
    z-index: 1;
    display: flex;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-md) 0;
  }

  .header-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-lg);
  }

  .header-icon span {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-primary);
  }

  .header-content {
    flex: 1;
    min-width: 0;
  }

  .header-content .section-title {
    margin-bottom: var(--space-xs);
  }

  .page-header h1 {
    margin-bottom: var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--fw-bold);
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* Tool container (full width) */
  .tool-container {
    margin-bottom: var(--space-xl);
  }

  /* Info section (full width) */
  .tool-info {
    padding: var(--space-lg);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-lg);
  }

  /* Typography inside tool-info */
  .tool-info :global(h2) {
    margin-bottom: var(--space-md);
    font-size: var(--text-xl);
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info :global(h3) {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    font-size: var(--text-md);
    font-weight: var(--fw-semibold);
    color: var(--color-text-heading);
  }

  .tool-info :global(h4) {
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
    font-size: var(--text-base);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
  }

  .tool-info :global(p) {
    margin-bottom: var(--space-md);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text);
  }

  .tool-info :global(ul),
  .tool-info :global(ol) {
    padding-left: 1.25rem;
    margin: 0;
  }

  .tool-info :global(li) {
    margin-bottom: var(--space-sm);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-text);
  }

  .tool-info :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tool-info :global(a:hover) {
    text-decoration: none;
  }

  .tool-info :global(code) {
    padding: 0.125rem 0.375rem;
    font-size: var(--text-sm);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
  }

  /* Responsive */
  @media (width <= 640px) {
    .page-header__body {
      flex-direction: column;
      text-align: center;
    }

    .page-header h1 {
      font-size: var(--text-2xl);
    }

    .subtitle {
      font-size: var(--text-sm);
    }

    .tool-info {
      padding: var(--space-md);
    }
  }
</style>
