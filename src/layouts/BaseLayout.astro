---
/**
 * BaseLayout component.
 * The foundational layout for all pages.
 * Includes:
 * - <BaseHead>: Metadata and global styles.
 * - <Header>: Navigation and branding.
 * - <Footer>: Copyright and social links.
 * - Theme toggle logic handling FOUC (Flash of Unstyled Content).
 */
import BaseHead from "@components/layout/BaseHead.astro";
import Footer from "@components/layout/Footer.astro";
import Header from "@components/layout/Header.astro";
import LanguageDetector from "@components/layout/LanguageDetector.astro";
import WebMCPProvider from "@components/layout/WebMCPProvider.astro";
import SRIEventListener from "@components/ui/SRIEventListener.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

interface Props {
  title: string;
  description?: string;
  type?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[]; // JSON-LD schema defaults or overrides
  image?: string;
  noIndex?: boolean;
  // Article specific
  publishDate?: Date;
  modifiedDate?: Date;
  authors?: string[];
  tags?: string[];
}

const {
  title,
  description,
  type,
  schema,
  image,
  noIndex,
  publishDate,
  modifiedDate,
  authors,
  tags,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="format-detection"
      content="telephone=no"
    />
    <BaseHead
      title={title}
      description={description}
      type={type}
      schema={schema}
      image={image}
      noIndex={noIndex}
      publishDate={publishDate}
      modifiedDate={modifiedDate}
      authors={authors}
      tags={tags}
    />
    <SRIEventListener />
    <script is:inline>
      // Nuclear Theme Managed - Persistent & Prefetch-proof
      (function () {
        const THEME_KEY = "theme";
        const getStored = () => {
          if (typeof localStorage !== "undefined") {
            const saved = localStorage.getItem(THEME_KEY);
            if (saved === "light" || saved === "dark") return saved;
          }
          return window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
        };

        const apply = (doc = document) => {
          const theme = getStored();
          const el = doc.documentElement;
          if (el.dataset.theme !== theme) {
            el.dataset.theme = theme;
            el.classList.remove("light-mode", "dark-mode");
            el.classList.add(`${theme}-mode`);
          }
        };

        // 1. Initial immediate apply
        apply();

        // 2. Global API
        window.toggleTheme = () => {
          const next = getStored() === "dark" ? "light" : "dark";
          try {
            localStorage.setItem(THEME_KEY, next);
          } catch (e) {}
          apply();
          window.dispatchEvent(
            new CustomEvent("theme-changed", { detail: { theme: next } }),
          );
        };

        // 3. Robust Transition Handling
        if (!window.themeHandlersSet) {
          // Sync new document BEFORE it's swapped
          document.addEventListener("astro:before-swap", (ev) =>
            apply(ev.newDocument),
          );
          // Re-sync after swap just in case
          document.addEventListener("astro:after-swap", () => apply());

          // 4. NUCLEAR OPTION: Mutation Observer
          // If Astro's swap logic or prefetch merges stale attributes, we force them back
          const observer = new MutationObserver(() => {
            const theme = getStored();
            if (document.documentElement.dataset.theme !== theme) apply();
          });
          observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["data-theme"],
          });

          window.themeHandlersSet = true;
        }
      })();
    </script>
  </head>

  <body>
    <a
      href="#main-content"
      class="skip-link"
      >{t("ui.skipToContent")}</a
    >
    <Header />
    <main
      id="main-content"
      tabindex="-1"
    >
      <slot />
    </main>
    <Footer />
    <LanguageDetector />
    <WebMCPProvider />

    <style is:global>
      /* Accessibility: Skip Link */
      .skip-link {
        position: absolute;
        top: -9999px;
        left: 0.5rem;
        z-index: 9999;
        padding: 0.5rem 1rem;
        font-weight: 700;
        color: #fff;
        text-decoration: none;
        background: var(--color-primary);
        border-radius: 0 0 0.5rem 0.5rem;
      }

      .skip-link:focus {
        top: 0;
      }

      /*
       * Critical Layout Fixes
       * Prevent horizontal scrollbar caused by wide content (code blocks, tables, images).
       * Using a combination of hidden, visible, and clip to balance functionality:
       * - html: hidden to prevent page-level scrollbar
       * - body: visible to ensure position:sticky works for headers
       * - main: clip to contain overflow without creating a scroll container
       */
      html {
        max-width: 100vw;
        overflow-x: hidden;
      }

      body {
        max-width: 100vw;
        overflow-x: visible; /* Required for sticky positioning to work */
      }

      main {
        display: flex;
        flex: 1;
        flex-direction: column;
        width: 100%;

        /*
         * 'clip' vs 'hidden': clip doesn't create a new scroll container,
         * which allows sticky elements inside main to work correctly.
         * It simply clips overflow content without enabling scrolling.
         */
        overflow-x: clip;
      }

      /* Prevent content blowout from wide elements */
      pre,
      code,
      .mermaid,
      table,
      img,
      video,
      iframe {
        max-width: 100%;
      }

      /* Allow horizontal scroll for code and diagrams */
      pre,
      .mermaid {
        overflow-x: auto;
      }

      .mermaid svg {
        max-width: 100% !important;
        height: auto !important;
      }
    </style>
  </body>
</html>
