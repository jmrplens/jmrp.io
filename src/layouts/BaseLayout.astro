---
/**
 * BaseLayout component.
 * The foundational layout for all pages.
 * Includes:
 * - <BaseHead>: Metadata and global styles.
 * - <Header>: Navigation and branding.
 * - <Footer>: Copyright and social links.
 * - Theme toggle logic handling FOUC (Flash of Unstyled Content).
 */
import BaseHead from "@components/layout/BaseHead.astro";
import Footer from "@components/layout/Footer.astro";
import Header from "@components/layout/Header.astro";
import SRIEventListener from "@components/ui/SRIEventListener.astro";

interface Props {
  title: string;
  description?: string;
  type?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[]; // JSON-LD schema defaults or overrides
  image?: string;
  /** Preload URL for LCP image optimization */
  preloadImage?: string;
  // Article specific
  publishDate?: Date;
  modifiedDate?: Date;
  authors?: string[];
  tags?: string[];
}

const {
  title,
  description,
  type,
  schema,
  image,
  preloadImage,
  publishDate,
  modifiedDate,
  authors,
  tags,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="format-detection"
      content="telephone=no"
    />
    {/* LCP Image Preload - must be early in head for maximum effect */}
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          fetchpriority="high"
        />
      )
    }
    <SRIEventListener />
    <BaseHead
      title={title}
      description={description}
      type={type}
      schema={schema}
      image={image}
      publishDate={publishDate}
      modifiedDate={modifiedDate}
      authors={authors}
      tags={tags}
    />
    <script is:inline>
      // Critical: Execute immediately to prevent FOUC
      (function () {
        const getTheme = () => {
          try {
            if (typeof localStorage !== "undefined") {
              const saved = localStorage.getItem("theme");
              if (saved === "light" || saved === "dark") return saved;
            }
          } catch {
            // localStorage may be blocked; ignore
          }

          // Respect system preference if available
          if (window.matchMedia("(prefers-color-scheme: light)").matches) {
            return "light";
          }
          if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            return "dark";
          }

          // Fallback if no preference is indicated or supported
          return "dark";
        };
        const theme = getTheme();
        document.documentElement.dataset.theme = theme;
        if (theme === "light") {
          document.documentElement.classList.add("light-mode");
          document.documentElement.classList.remove("dark-mode");
        } else {
          document.documentElement.classList.add("dark-mode");
          document.documentElement.classList.remove("light-mode");
        }
      })();
    </script>
  </head>

  <body>
    <a
      href="#main-content"
      class="skip-link"
      >Skip to content</a
    >
    <Header />
    <main
      id="main-content"
      tabindex="-1"
    >
      <slot />
    </main>
    <Footer />

    <style is:global>
      /* Accessibility: Skip Link */
      .skip-link {
        position: absolute;
        top: -9999px;
        left: 0.5rem;
        z-index: 9999;
        padding: 0.5rem 1rem;
        font-weight: bold;
        color: white;
        text-decoration: none;
        background: var(--color-primary);
        border-radius: 0 0 0.5rem 0.5rem;
      }

      .skip-link:focus {
        top: 0;
      }

      /*
       * Critical Layout Fixes
       * Prevent horizontal scrollbar caused by wide content (code blocks, tables, images).
       * Using a combination of hidden, visible, and clip to balance functionality:
       * - html: hidden to prevent page-level scrollbar
       * - body: visible to ensure position:sticky works for headers
       * - main: clip to contain overflow without creating a scroll container
       */
      html {
        max-width: 100vw;
        overflow-x: hidden;
      }

      body {
        max-width: 100vw;
        overflow-x: visible; /* Required for sticky positioning to work */
      }

      main {
        display: flex;
        flex: 1;
        flex-direction: column;
        width: 100%;

        /*
         * 'clip' vs 'hidden': clip doesn't create a new scroll container,
         * which allows sticky elements inside main to work correctly.
         * It simply clips overflow content without enabling scrolling.
         */
        overflow-x: clip;
      }

      /* Prevent content blowout from wide elements */
      pre,
      code,
      .mermaid,
      table,
      img,
      video,
      iframe {
        max-width: 100%;
      }

      /* Allow horizontal scroll for code and diagrams */
      pre,
      .mermaid {
        overflow-x: auto;
      }

      .mermaid svg {
        max-width: 100% !important;
        height: auto !important;
      }

      /* System preference defaults (when no theme is set) */
      @media (prefers-color-scheme: light) {
        :root:not([data-theme="dark"]) .mermaid-dark {
          display: none;
        }

        :root:not([data-theme="dark"]) .mermaid-light {
          display: block;
        }
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .mermaid-light {
          display: none;
        }

        :root:not([data-theme="light"]) .mermaid-dark {
          display: block;
        }
      }

      /* Explicit theme overrides */
      [data-theme="light"] .mermaid-dark {
        display: none;
      }

      [data-theme="light"] .mermaid-light {
        display: block;
      }

      [data-theme="dark"] .mermaid-light {
        display: none;
      }

      [data-theme="dark"] .mermaid-dark {
        display: block;
      }
    </style>
  </body>
</html>
