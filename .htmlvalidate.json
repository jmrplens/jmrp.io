{
  "extends": [
    "html-validate:recommended",
    "html-validate:document"
  ],
  "elements": ["html5"],
  "rules": {
    "no-trailing-whitespace": "off",
    "void-style": "off",
    "valid-id": [
      "error",
      {
        "relaxed": true
      }
    ],
    "require-sri": [
      "error",
      {
        "target": "crossorigin",
        "exclude": ["/scripts/cf-beacon.js"]
      }
    ],
    "element-required-content": [
      "error",
      {
        "exclude": ["span"]
      }
    ]
  }
}